{"assets":[],"contentKind":"statement","contestId":"487","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Fight the Monster"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A monster is attacking the Cyberland!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Master Yang, a braver, is going to beat the monster. Yang and the monster each have 3 attributes: hitpoints ("},{"kind":"math_inline","text":"HP"},{"kind":"text","text":"), offensive power ("},{"kind":"math_inline","text":"ATK"},{"kind":"text","text":") and defensive power ("},{"kind":"math_inline","text":"DEF"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During the battle, every second the monster's HP decrease by "},{"kind":"math_inline","text":"max(0, ATKY - DEFM)"},{"kind":"text","text":", while Yang's HP decreases by "},{"kind":"math_inline","text":"max(0, ATKM - DEFY)"},{"kind":"text","text":", where index "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" denotes Master Yang and index "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" denotes monster. Both decreases happen simultaneously Once monster's "},{"kind":"math_inline","text":"HP ≤ 0"},{"kind":"text","text":" and the same time Master Yang's "},{"kind":"math_inline","text":"HP > 0"},{"kind":"text","text":", Master Yang wins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Master Yang can buy attributes from the magic shop of Cyberland: "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" bitcoins per "},{"kind":"math_inline","text":"HP"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" bitcoins per "},{"kind":"math_inline","text":"ATK"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" bitcoins per "},{"kind":"math_inline","text":"DEF"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Master Yang wants to know the minimum number of bitcoins he can spend in order to win."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"HPY, ATKY, DEFY"},{"kind":"text","text":", separated by a space, denoting the initial "},{"kind":"math_inline","text":"HP"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ATK"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"DEF"},{"kind":"text","text":" of Master Yang."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains three integers "},{"kind":"math_inline","text":"HPM, ATKM, DEFM"},{"kind":"text","text":", separated by a space, denoting the "},{"kind":"math_inline","text":"HP"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ATK"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"DEF"},{"kind":"text","text":" of the monster."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains three integers "},{"kind":"math_inline","text":"h, a, d"},{"kind":"text","text":", separated by a space, denoting the price of "},{"kind":"math_inline","text":"1 HP"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ATK"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 DEF"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All numbers in input are "},{"children":[{"kind":"text","text":"integer"}],"kind":"container"},{"kind":"text","text":" and lie between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" inclusively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only output line should contain an integer, denoting the minimum bitcoins Master Yang should spend in order to win."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2 1\n1 100 1\n1 100 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"99\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"100 100 100\n1 1 1\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample, prices for "},{"kind":"math_inline","text":"ATK"},{"kind":"text","text":" and "},{"kind":"math_inline","te