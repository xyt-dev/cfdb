{"assets":[],"contentKind":"statement","contestId":"1514","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. AND 0, Sum Big"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Baby Badawy's first words were \"AND 0 SUM BIG\", so he decided to solve the following problem. Given two integers $$$n$$$ and $$$k$$$, count the number of arrays of length $$$n$$$ such that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" all its elements are integers between $$$0$$$ and $$$2^k-1$$$ (inclusive); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#AND"},"children":[{"kind":"text","text":"bitwise AND"}],"kind":"link"},{"kind":"text","text":" of all its elements is $$$0$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the sum of its elements is as large as possible. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Since the answer can be very large, print its remainder when divided by $$$10^9+7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\le t \\le 10$$$) — the number of test cases you need to solve."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of a line containing two integers $$$n$$$ and $$$k$$$ ($$$1 \\le n \\le 10^{5}$$$, $$$1 \\le k \\le 20$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the number of arrays satisfying the conditions. Since the answer can be very large, print its remainder when divided by $$$10^9+7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n2 2\n100000 20\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n226732710\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the $$$4$$$ arrays are:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[3,0]$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[0,3]$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1,2]$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2,1]$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1514B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1514/problem/B"}