{"assets":["/statement-assets/5cb42541c9dbb18c117539f22d58ceb0e07a8e179771cea4dc7fb7e44c9828d2.png","/statement-assets/6c66c3b452b6e7ad762fd72a7e8294f7bf458d25e26805f8e37ab2dab556ac36.png"],"contentKind":"statement","contestId":"509","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Pretty Song"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"When Sasha was studying in the seventh grade, he started listening to music a lot. In order to evaluate which songs he likes more, he introduced the notion of the song's "},{"children":[{"kind":"text","text":"prettiness"}],"kind":"container"},{"kind":"text","text":". The title of the song is a word consisting of uppercase Latin letters. The "},{"children":[{"kind":"text","text":"prettiness"}],"kind":"container"},{"kind":"text","text":" of the song is the "},{"children":[{"kind":"text","text":"prettiness"}],"kind":"container"},{"kind":"text","text":" of its title."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define the "},{"children":[{"kind":"text","text":"simple prettiness"}],"kind":"container"},{"kind":"text","text":" of a word as the ratio of the number of vowels in the word to the number of all letters in the word."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define the "},{"children":[{"kind":"text","text":"prettiness"}],"kind":"container"},{"kind":"text","text":" of a word as the sum of "},{"children":[{"kind":"text","text":"simple prettiness"}],"kind":"container"},{"kind":"text","text":" of all the substrings of the word."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, let's define the function "},{"kind":"math_inline","text":"vowel(c)"},{"kind":"text","text":" which is equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" is a vowel, and to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" otherwise. Let "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" be the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"si..j"},{"kind":"text","text":" be the substring of word "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", staring at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character and ending at the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th character ("},{"kind":"math_inline","text":"sisi + 1... sj"},{"kind":"text","text":", "},{"kind":"math_inline","text":"i ≤ j"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then the "},{"children":[{"kind":"text","text":"simple prettiness"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is defined by the formula:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5cb42541c9dbb18c117539f22d58ceb0e07a8e179771cea4dc7fb7e44c9828d2.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"prettiness"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" equals "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6c66c3b452b6e7ad762fd72a7e8294f7bf458d25e26805f8e37ab2dab556ac36.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Find the "},{"children":[{"kind":"text","text":"prettiness"}],"kind":"container"},{"kind":"text","text":" of the given song title."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We assume that the vowels are "},{"kind":"math_inline","text":"I, E, A, O, U, Y"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input contains a single string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 5·105"},{"kind":"text","text":") — the title of the song."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the "},{"children":[{"kind":"text","text":"prettiness"}],"kind":"container"},{"kind":"text","text":" of the song with the absolute or relative error of at most "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"IEAIAIO\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"28.0000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"BYOB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5.8333333\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"YISVOWEL\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"17.0500000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample all letters are vowels. The "},{"children":[{"kind":"text","text":"simple prettiness"}],"kind":"container"},{"kind":"text","text":" of each substring is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". The word of length "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" has "},{"kind":"math_inline","text":"28"},{"kind":"text","text":" substrings. So, the "},{"children":[{"kind":"text","text":"prettiness"}],"kind":"container"},{"kind":"text","text":" of the song equals to "},{"kind":"math_inline","text":"28"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"509E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/509/problem/E"}