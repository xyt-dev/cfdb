{"assets":[],"contentKind":"statement","contestId":"1422","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Minlexes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Some time ago Lesha found an entertaining string $$$s$$$ consisting of lowercase English letters. Lesha immediately developed an unique algorithm for this string and shared it with you. The algorithm is as follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Lesha chooses an arbitrary (possibly zero) number of pairs on positions $$$(i, i + 1)$$$ in such a way that the following conditions are satisfied: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" for each pair $$$(i, i + 1)$$$ the inequality $$$0 \\le i \\lt |s| - 1$$$ holds; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for each pair $$$(i, i + 1)$$$ the equality $$$s_i = s_{i + 1}$$$ holds; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" there is no index that is contained in more than one pair. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" After that Lesha removes all characters on indexes contained in these pairs and the algorithm is over. "},{"children":[{"kind":"text","text":"Lesha is interested in the lexicographically smallest strings he can obtain by applying the algorithm to the suffixes of the given string."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains the string $$$s$$$ ($$$1 \\le |s| \\le 10^5$$$) — the initial string consisting of lowercase English letters only."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In $$$|s|$$$ lines print the lengths of the answers and the answers themselves, starting with the answer for the longest suffix. The output can be large, so, when some answer is longer than $$$10$$$ characters, instead print the first $$$5$$$ characters, then \""},{"children":[{"kind":"text","text":"..."}],"kind":"container"},{"kind":"text","text":"\", then the last $$$2$$$ characters of the answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nabcdd\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3 abc\n2 bc\n1 c\n0 \n1 d\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nabbcdddeaaffdfouurtytwoo\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n18 abbcd...tw\n17 bbcdd...tw\n16 bcddd...tw\n15 cddde...tw\n14 dddea...tw\n13 ddeaa...tw\n12 deaad...tw\n11 eaadf...tw\n10 aadfortytw\n9 adfortytw\n8 dfortytw\n9 fdfortytw\n8 dfortytw\n7 fortytw\n6 ortytw\n5 rtytw\n6 urtytw\n5 rtytw\n4 tytw\n3 ytw\n2 tw\n1 w\n0 \n1 o\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first example."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The longest suffix is the whole string \""},{"children":[{"kind":"text","text":"abcdd"}],"kind":"container"},{"kind":"text","text":"\". Choosing one pair $$$(4, 5)$$$, Lesha obtains \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The next longest suffix is \""},{"children":[{"kind":"text","text":"bcdd"}],"kind":"container"},{"kind":"text","text":"\". Choosing one pair $$$(3, 4)$$$, we obtain \""},{"children":[{"kind":"text","text":"bc"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The next longest suffix is \""},{"children":[{"kind":"text","text":"cdd"}],"kind":"container"},{"kind":"text","text":"\". Choosing one pair $$$(2, 3)$$$, we obtain \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The next longest suffix is \""},{"children":[{"kind":"text","text":"dd"}],"kind":"container"},{"kind":"text","text":"\". Choosing one pair $$$(1, 2)$$$, we obtain \""},{"kind":"container"},{"kind":"text","text":"\" (an empty string). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The last suffix is the string \""},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":"\". No pair can be chosen, so the answer is \""},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second example, for the longest suffix \""},{"children":[{"kind":"text","text":"abbcdddeaaffdfouurtytwoo"}],"kind":"container"},{"kind":"text","text":"\" choose three pairs $$$(11, 12)$$$, $$$(16, 17)$$$, $$$(23, 24)$$$ and we obtain \""},{"children":[{"kind":"text","text":"abbcdddeaadfortytw"}],"kind":"container"},{"kind":"text","text":"\""}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1422E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1422/problem/E"}