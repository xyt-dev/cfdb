{"assets":[],"contentKind":"statement","contestId":"888","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Buggy Robot"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ivan has a robot which is situated on an infinite grid. Initially the robot is standing in the starting cell "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":". The robot can process commands. There are four types of commands it can perform:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":" — move from the cell "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(x, y + 1)"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":" — move from "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(x, y - 1)"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":" — move from "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(x - 1, y)"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":" — move from "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(x + 1, y)"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Ivan entered a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" commands, and the robot processed it. After this sequence the robot ended up in the starting cell "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":", but Ivan doubts that the sequence is such that after performing it correctly the robot ends up in the same cell. He thinks that some commands were ignored by robot. To acknowledge whether the robot is severely bugged, he needs to calculate the maximum possible number of commands that were performed correctly. Help Ivan to do the calculations!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the length of sequence of commands entered by Ivan ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the sequence itself — a string consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters. Each character can be "},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text