{"assets":[],"contentKind":"statement","contestId":"939","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Convenient For Everybody"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In distant future on Earth day lasts for "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" hours and that's why there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" timezones. Local times in adjacent timezones differ by one hour. For describing local time, hours numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" are used, i.e. there is no time \"0 hours\", instead of it \""},{"kind":"math_inline","text":"n"},{"kind":"text","text":" hours\" is used. When local time in the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st timezone is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" hour, local time in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th timezone is "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" hours."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some online programming contests platform wants to conduct a contest that lasts for an hour in such a way that its beginning coincides with beginning of some hour (in all time zones). The platform knows, that there are "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" people from "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th timezone who want to participate in the contest. Each person will participate if and only if the contest starts no earlier than "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" hours 00 minutes local time and ends not later than "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" hours 00 minutes local time. Values "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" are equal for all time zones. If the contest starts at "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" hours 00 minutes local time, the person won't participate in it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help platform select such an hour, that the number of people who will participate in the contest is maximum. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of hours in day."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 10 000"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the number of people in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th timezone who want to participate in the contest."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains two space-separated integers "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ s < f ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the time of the beginning of the contest (in the first timezone local time), such that the number of participants will be maximum possible. If there are many answers, output the smallest among them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 4 1\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, it's optimal to start competition at "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" hours (in first timezone). In this case, it will be "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" hour in the second timezone and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" hours in the third timezone. Only one person from the first timezone won't participate."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In second example only people from the third and the fourth timezones will participate."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"939C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/939/problem/C"}