{"assets":["/statement-assets/acd8e7b1472473835ee736c3f922d4f61b7006b3573fe1d749a782399582c04a.png"],"contentKind":"statement","contestId":"906","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Power Tower"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Priests of the Quetzalcoatl cult want to build a tower to represent a power of their god. Tower is usually made of power-charged rocks. It is built with the help of rare magic by levitating the current top of tower and adding rocks at its bottom. If top, which is built from "},{"kind":"math_inline","text":"k - 1"},{"kind":"text","text":" rocks, possesses power "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and we want to add the rock charged with power "},{"kind":"math_inline","text":"wk"},{"kind":"text","text":" then value of power of a new tower will be "},{"kind":"math_inline","text":"{wk}p"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Rocks are added from the last to the first. That is for sequence "},{"kind":"math_inline","text":"w1, ..., wm"},{"kind":"text","text":" value of power will be"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/acd8e7b1472473835ee736c3f922d4f61b7006b3573fe1d749a782399582c04a.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"After tower is built, its power may be extremely large. But still priests want to get some information about it, namely they want to know a number called cumulative power which is the true value of power taken modulo "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Priests have "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rocks numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". They ask you to calculate which value of cumulative power will the tower possess if they will build it from rocks numbered "},{"kind":"math_inline","text":"l, l + 1, ..., r"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second line of input contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"wk"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ wk ≤ 109"},{"kind":"text","text":") which is the power of rocks that priests have."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Third line of input contains single integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 105"},{"kind":"text","text":") which is amount of queries from priests to you."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"kth"},{"kind":"text","text":" of next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"lk"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"rk"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ lk ≤ rk ≤ n"},{"kind":"text","text":"). "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" integers. "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th of them must be the amount of cumulative power the tower will have if is built from rocks "},{"kind":"math_inline","text":"lk, lk + 1, ..., rk"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 1000000000\n1 2 2 3 3 3\n8\n1 1\n1 6\n2 2\n2 3\n2 4\n4 4\n4 5\n4 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n2\n4\n256\n3\n27\n597484987\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"math_inline","text":"327 = 7625597484987"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"906D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/906/problem/D"}