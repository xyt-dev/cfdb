{"assets":["/statement-assets/caf10f044b3c55b900f236f0d46c1b25057ef39664702b6a0dd8ba09fd5801ed.png","/statement-assets/dcc4cb0cedc80253c60b9b049228a5ec12473bdbaafb6ceabf0931264780b846.png","/statement-assets/c8e6969e6be8642df04d9c6948ad577d56244992a0e264dda8bb46b4133058e3.png"],"contentKind":"statement","contestId":"848","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Days of Floral Colours"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"7 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Floral Clock has been standing by the side of Mirror Lake for years. Though unable to keep time, it reminds people of the passage of time and the good old days."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the rim of the Floral Clock are "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" flowers, numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" clockwise, each of which has a colour among all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" possible ones. For each colour, there are exactly two flowers with it, the "},{"children":[{"kind":"text","text":"distance"}],"kind":"container"},{"kind":"text","text":" between which "},{"children":[{"kind":"text","text":"either is less than or equal to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", or equals "},{"kind":"math_inline","text":"n"}],"kind":"container"},{"kind":"text","text":". Additionally, if flowers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" are of the same colour, then flowers opposite to "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and opposite to "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" should be of the same colour as well — symmetry is beautiful!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, the "},{"children":[{"kind":"text","text":"distance"}],"kind":"container"},{"kind":"text","text":" between two flowers is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" plus the number of flowers on the minor arc (or semicircle) between them. Below is a possible arrangement with "},{"kind":"math_inline","text":"n = 6"},{"kind":"text","text":" that cover all possibilities."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/caf10f044b3c55b900f236f0d46c1b25057ef39664702b6a0dd8ba09fd5801ed.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" of an arrangement is defined to be the product of the lengths of flower segments separated by all opposite flowers of the same colour. In other words, in order to compute the beauty, we remove from the circle all flowers that have the same colour as flowers opposite to them. Then, the beauty is the product of lengths of all remaining segments. Note that we include segments of length "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" in this product. If there are no flowers that have the same colour as flower opposite to them, the beauty equals "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". For instance, the "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" of the above arrangement equals "},{"kind":"math_inline","text":"1 × 3 × 1 × 3 = 9"},{"kind":"text","text":" — the segments are "},{"kind":"math_inline","text":"{2}"},{"kind":"text","text":", "},{"kind":"math_inline","text":"{4, 5, 6}"},{"kind":"text","text":", "},{"kind":"math_inline","text":"{8}"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"{10, 11, 12}"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"While keeping the constraints satisfied, there may be lots of different arrangements. Find out the sum of "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" over all possible arrangements, modulo "},{"kind":"math_inline","text":"998 244 353"},{"kind":"text","text":". Two arrangements are considered different, if a pair "},{"kind":"math_inline","text":"(u, v)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ u, v ≤ 2n"},{"kind":"text","text":") exists such that flowers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" are of the same colour in one of them, but not in the other."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and only line of input contains a lonely positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 50 000"},{"kind":"text","text":") — the number of colours present on the Floral Clock."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one integer — the sum of "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" over all possible arrangements of flowers, modulo "},{"kind":"math_inline","text":"998 244 353"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"24\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1316\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3436404\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"With "},{"kind":"math_inline","text":"n = 3"},{"kind":"text","text":", the following six arrangements each have a "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"2 × 2 = 4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/dcc4cb0cedc80253c60b9b049228a5ec12473bdbaafb6ceabf0931264780b846.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"While many others, such as the left one in the figure below, have a "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". The right one is invalid, since it's asymmetric."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c8e6969e6be8642df04d9c6948ad577d56244992a0e264dda8bb46b4133058e3.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"848E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/848/problem/E"}