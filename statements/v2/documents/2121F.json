{"assets":[],"contentKind":"statement","contestId":"2121","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Yamakasi"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array of integers $$$a_1, a_2, \\ldots, a_n$$$ and two integers $$$s$$$ and $$$x$$$. Count the number of subsegments of the array whose sum of elements equals $$$s$$$ and whose maximum value equals $$$x$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, count the number of pairs $$$1 \\leq l \\leq r \\leq n$$$ such that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a_l + a_{l + 1} + \\ldots + a_r = s$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\max(a_l, a_{l + 1}, \\ldots, a_r) = x$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test consists of multiple test cases. The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 10^4$$$) — the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains three integers $$$n$$$, $$$s$$$, and $$$x$$$ ($$$1 \\leq n \\leq 2 \\cdot 10^5$$$, $$$-2 \\cdot 10^{14} \\leq s \\leq 2 \\cdot 10^{14}$$$, $$$-10^9 \\leq x \\leq 10^9$$$). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$-10^9 \\leq a_i \\leq 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ across all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the number of subsegments of the array whose sum of elements equals $$$s$$$ and whose maximum value equals $$$x$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n1 0 0\n0\n1 -2 -1\n-2\n3 -1 -1\n-1 1 -1\n6 -3 -2\n-1 -1 -1 -2 -1 -1\n8 3 2\n2 2 -1 -2 3 -1 2 2\n9 6 3\n1 2 3 1 2 3 1 2 3\n13 7 3\n0 -1 3 3 3 -2 1 2 2 3 -1 0 3\n2 -2 -1\n-2 -1\n2 -2 -1\n-1 -2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n0\n2\n0\n2\n7\n8\n0\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the suitable subsegment is $$$l = 1$$$, $$$r = 1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, the suitable subsegments are $$$l = 1$$$, $$$r = 1$$$ and $$$l = 3$$$, $$$r = 3$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth test case, the suitable subsegments are $$$l = 1$$$, $$$r = 3$$$ and $$$l = 6$$$, $$$r = 8$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the sixth test case, the suitable subsegments are those for which $$$r = l + 2$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the seventh test case, the following subsegments are suitable: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$l = 1$$$, $$$r = 7$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$l = 2$$$, $$$r = 7$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$l = 3$$$, $$$r = 6$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$l = 4$$$, $$$r = 8$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$l = 7$$$, $$$r = 11$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$l = 7$$$, $$$r = 12$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$l = 8$$$, $$$r = 10$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$l = 9$$$, $$$r = 13$$$."}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"2121F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2121/problem/F"}