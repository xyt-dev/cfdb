{"assets":[],"contentKind":"statement","contestId":"1748","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Diverse Substrings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A non-empty digit string is "},{"children":[{"kind":"text","text":"diverse"}],"kind":"container"},{"kind":"text","text":" if the number of occurrences of each character in it doesn't exceed the number of distinct characters in it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" string \""},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":"\" is diverse because "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":" appears in it $$$1$$$ time and the number of distinct characters in it is $$$1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" string \""},{"children":[{"kind":"text","text":"77"}],"kind":"container"},{"kind":"text","text":"\" is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" diverse because "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":" appears in it $$$2$$$ times and the number of distinct characters in it is $$$1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" string \""},{"children":[{"kind":"text","text":"1010"}],"kind":"container"},{"kind":"text","text":"\" is diverse because both "},{"children":[{"kind":"text"