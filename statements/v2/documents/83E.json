{"assets":[],"contentKind":"statement","contestId":"83","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Two Subsequences"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"On an IT lesson Valera studied data compression. The teacher told about a new method, which we shall now describe to you."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"{a1, a2, ..., an}"},{"kind":"text","text":" be the given sequence of lines needed to be compressed. Here and below we shall assume that all lines are "},{"children":[{"kind":"text","text":"of the same length"}],"kind":"container"},{"kind":"text","text":" and consist only of the digits "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Let's define the compression function:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"f("},{"kind":"text","text":"empty sequence"},{"kind":"math_inline","text":") = "},{"kind":"text","text":"empty string "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"f(s) = s"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"f(s1, s2) = "},{"kind":"text","text":" the smallest in length string, which has one of the prefixes equal to "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" and one of the suffixes equal to "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":". For example, "},{"kind":"math_inline","text":"f(001, 011) = 0011"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f(111, 011) = 111011"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"f(a1, a2, ..., an) = f(f(a1, a2, an - 1), an)"},{"kind":"text","text":". For example, "},{"kind":"math_inline","text":"f(000, 000, 111) = f(f(000, 000), 111) = f(000, 111) = 000111"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Valera faces a real challenge: he should divide the given sequence "},{"kind":"math_inline","text":"{a1, a2, ..., an}"},{"kind":"text","text":" into two subsequences "},{"kind":"math_inline","text":"{b1, b2, ..., bk}"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"{c1, c2, ..., cm}"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m + k = n"},{"kind":"text","text":", so that the value of "},{"kind":"math_inline","text":"S = |f(b1, b2, ..., bk)| + |f(c1, c2, ..., cm)|"},{"kind":"text","text":" took the minimum possible value. Here "},{"kind":"math_inline","text":"|p|"},{"kind":"text","text":" denotes the length of the string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that it is not allowed to change the relative order of lines in the subsequences. It is allowed to make one of the subsequences empty. Each string from the initial sequence should belong to exactly one subsequence. Elements of subsequences "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" don't have to be consecutive in the original sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", i. e. elements of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" can alternate in "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" (see samples 2 and 3)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Valera to find the minimum possible value of "},{"kind":"math_inline","text":"S"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input data contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the number of strings ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105"},{"kind":"text","text":"). Then on "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow elements of the sequence — strings whose lengths are from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"20"},{"kind":"text","text":" characters, consisting only of digits "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":"-th input line contains the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th element of the sequence. Elements of the sequence are separated only by a newline. It is guaranteed that all lines have the same length."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the minimum possible value of "},{"kind":"math_inline","text":"S"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n01\n10\n01\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n000\n111\n110\n001\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n10101\n01010\n11111\n01000\n10010\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"17\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Detailed answers to the tests:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The best option is to make one of the subsequences empty, and the second one equal to the whole given sequence. "},{"kind":"math_inline","text":"|f(01, 10, 01)| = |f(f(01, 10), 01)| = |f(010, 01)| = |0101| = 4"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The best option is: "},{"kind":"math_inline","text":"b = {000, 001}, c = {111, 110}."},{"kind":"math_inline","text":"S = |f(000, 001)| + |f(111, 110)| = |0001| + |1110| = 8"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The best option is: "},{"kind":"math_inline","text":"b = {10101, 01010, 01000}, c = {11111, 10010}."},{"kind":"math_inline","text":"S = |10101000| + |111110010| = 17"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"83E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/83/problem/E"}