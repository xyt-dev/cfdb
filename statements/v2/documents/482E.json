":"math_inline","text":"pv = u"},{"kind":"text","text":". Otherwise you must perform assignment "},{"kind":"math_inline","text":"pu = v"},{"kind":"text","text":". Note that after this query the graph continues to be a tree consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertexes."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"V"}],"kind":"container"},{"kind":"math_inline","text":"v"},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Perform assignment "},{"kind":"math_inline","text":"sv = t"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is following. Before starting performing queries and after each query you have to calculate expected value written on the lowest common ancestor of two equiprobably selected vertices "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":". Here lowest common ancestor of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" is the deepest vertex that lies on the both of the path from the root to vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and the path from the root to vertex "},{"kind":"math_inline","text":"j"},{"kind":"text","text":". Please note that the vertices "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" can be the same (in this case their lowest common ancestor coincides with them)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 5·104"},{"kind":"text","t