{"assets":[],"contentKind":"statement","contestId":"641","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Little Artem and Grasshopper"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Artem found a grasshopper. He brought it to his house and constructed a jumping area for him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The area looks like a strip of cells "},{"kind":"math_inline","text":"1 × n"},{"kind":"text","text":". Each cell contains the direction for the next jump and the length of that jump. Grasshopper starts in the first cell and follows the instructions written on the cells. Grasshopper stops immediately if it jumps out of the strip. Now Artem wants to find out if this will ever happen."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — length of the strip. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains a string of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" which consists of characters \""},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":"\" only, that provide the direction of the jump from the corresponding cell. Next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ di ≤ 109"},{"kind":"text","text":") — the length of the jump from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th cell."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"INFINITE"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if grasshopper will continue his jumps forever. Otherwise print \""},{"children":[{"kind":"text","text":"FINITE"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n><\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"FINITE\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n>><\n2 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"INFINITE"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample grasshopper starts from the first cell and jumps to the right on the next cell. When he is in the second cell he needs to jump two cells left so he will jump out of the strip."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second sample grasshopper path is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" - "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" - "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" - "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" - "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" - "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and so on. The path is infinite."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"641A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/641/problem/A"}