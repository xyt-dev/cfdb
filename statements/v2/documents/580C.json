{"assets":["/statement-assets/dd423e6ab8f0d0bd656f96773f81e155ed3c29b1e6139311de920e800a62e855.png","/statement-assets/c7115e29223e7fd49976f9346145d02481cee9c5b305669603afa8870a503298.png"],"contentKind":"statement","contestId":"580","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Kefa and Park"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Kefa decided to celebrate his first big salary by going to the restaurant. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He lives by an unusual park. The park is a rooted tree consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices with the root at vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" also contains Kefa's house. Unfortunaely for our hero, the park also contains cats. Kefa has already found out what are the vertices with cats in them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The leaf vertices of the park contain restaurants. Kefa wants to choose a restaurant where he will go, but unfortunately he is very afraid of cats, so there is no way he will go to the restaurant if the path from the restaurant to his house contains more than "},{"kind":"math_inline","text":"m"},{"children":[{"kind":"text","text":"consecutive"}],"kind":"container"},{"kind":"text","text":" vertices with cats. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to help Kefa count the number of restaurants where he can go."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ n"},{"kind":"text","text":") — the number of vertices of the tree and the maximum number of consecutive vertices with cats that is still ok for Kefa."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":", where each "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" either equals to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" (then vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has no cat), or equals to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" (then vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has a cat)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains the edges of the tree in the format \""},{"kind":"math_inline","text":"xi"},{"kind":"math_inline","text":"yi"},{"kind":"text","text":"\" (without the quotes) ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"xi ≠ yi"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" are the vertices of the tree, connected by an edge. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given set of edges specifies a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single integer — the number of distinct leaves of a tree the path to which from Kefa's home contains at most "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" consecutive vertices with cats."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n1 1 0 0\n1 2\n1 3\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 1\n1 0 1 1 0 0 0\n1 2\n1 3\n2 4\n2 5\n3 6\n3 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let us remind you that a "},{"children":[{"kind":"text","text":"tree"}],"kind":"container"},{"kind":"text","text":" is a connected graph on "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" edge. A "},{"children":[{"kind":"text","text":"rooted"}],"kind":"container"},{"kind":"text","text":" tree is a tree with a special vertex called "},{"children":[{"kind":"text","text":"root"}],"kind":"container"},{"kind":"text","text":". In a rooted tree among any two vertices connected by an edge, one vertex is a parent (the one closer to the root), and the other one is a child. A vertex is called a "},{"children":[{"kind":"text","text":"leaf"}],"kind":"container"},{"kind":"text","text":", if it has no children."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note to the first sample test: "},{"attrs":{"alt":"","src":"/statement-assets/dd423e6ab8f0d0bd656f96773f81e155ed3c29b1e6139311de920e800a62e855.png"},"kind":"image"},{"kind":"text","text":" The vertices containing cats are marked red. The restaurants are at vertices 2, 3, 4. Kefa can't go only to the restaurant located at vertex "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note to the second sample test: "},{"attrs":{"alt":"","src":"/statement-assets/c7115e29223e7fd49976f9346145d02481cee9c5b305669603afa8870a503298.png"},"kind":"image"},{"kind":"text","text":" The restaurants are located at vertices 4, 5, 6, 7. Kefa can't go to restaurants 6, 7."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"580C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/580/problem/C"}