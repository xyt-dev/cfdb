{"assets":["/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"],"contentKind":"statement","contestId":"164","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Variable, or There and Back Again"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Life is not easy for the perfectly common variable named Vasya. Wherever it goes, it is either assigned a value, or simply ignored, or is being used!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya's life goes in states of a program. In each state, Vasya can either be used (for example, to calculate the value of another variable), or be assigned a value, or ignored. Between some states are directed (oriented) transitions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"path"}],"kind":"container"},{"kind":"text","text":" is a sequence of states "},{"kind":"math_inline","text":"v1, v2, ..., vx"},{"kind":"text","text":", where for any "},{"kind":"math_inline","text":"1 ≤ i < x"},{"kind":"text","text":" exists a transition from "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"vi + 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya's value in state "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is interesting to the world, if exists path "},{"kind":"math_inline","text":"p1, p2, ..., pk"},{"kind":"text","text":" such, that "},{"kind":"math_inline","text":"pi = v"},{"kind":"text","text":" for some "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ k)"},{"kind":"text","text":", in state "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":" Vasya gets assigned a value, in state "},{"kind":"math_inline","text":"pk"},{"kind":"text","text":" Vasya is used and there is no state "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" (except for "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":") where Vasya gets assigned a value."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Vasya, find the states in which Vasya's value is interesting to the world."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":") — the numbers of states and transitions, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains space-separated "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"f1, f2, ..., fn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ fi ≤ 2"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":" described actions performed upon Vasya in state "},{"kind":"math_inline","text":"i"},{"kind":"text","text":": "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" represents ignoring, "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" — assigning a value, "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" — using."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain space-separated pairs of integers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":"), each pair represents the transition from the state number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" to the state number "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". Between two states can be any number of transitions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"r1, r2, ..., rn"},{"kind":"text","text":", separated by spaces or new lines. Number "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" should equal "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", if Vasya's value in state "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is interesting to the world and otherwise, it should equal "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". The states are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in the order, in which they are described in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n1 0 0 2\n1 2\n2 3\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n1\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n1 0 2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n0\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n2 0 1\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n0\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the program states can be used to make the only path in which the value of Vasya interests the world, 1 "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" 2 "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" 3 "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" 4; it includes all the states, so in all of them Vasya's value is interesting to the world."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second sample the only path in which Vasya's value is interesting to the world is , — 1 "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" 3; state 2 is not included there."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample we cannot make from the states any path in which the value of Vasya would be interesting to the world, so the value of Vasya is never interesting to the world."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"164A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/164/problem/A"}