{"assets":[],"contentKind":"statement","contestId":"1473","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. String LCM"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's define a multiplication operation between a string $$$a$$$ and a positive integer $$$x$$$: $$$a \\cdot x$$$ is the string that is a result of writing $$$x$$$ copies of $$$a$$$ one after another. For example, \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\" $$$\\cdot~2~=$$$ \""},{"children":[{"kind":"text","text":"abcabc"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" $$$\\cdot~5~=$$$ \""},{"children":[{"kind":"text","text":"aaaaa"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string $$$a$$$ is divisible by another string $$$b$$$ if there exists an integer $$$x$$$ such that $$$b \\cdot x = a$$$. For example, \""},{"children":[{"kind":"text","text":"abababab"}],"kind":"container"},{"kind":"text","text":"\" is divisible by \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", but is not divisible by \""},{"children":[{"kind":"text","text":"ababab"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"LCM of two strings $$$s$$$ and $$$t$$$ (defined 