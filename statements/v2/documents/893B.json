{"assets":[],"contentKind":"statement","contestId":"893","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Beautiful Divisors"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recently Luba learned about a special kind of numbers that she calls "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" numbers. The number is called "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" iff its binary representation consists of "},{"kind":"math_inline","text":"k + 1"},{"kind":"text","text":" consecutive ones, and then "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" consecutive zeroes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some examples of beautiful numbers: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"12"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"110"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1102"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"610"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"11110002"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"12010"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1111100002"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"49610"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"More formally, the number is beautiful iff there exists some positive integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" such that the number is equal to "},{"kind":"math_inline","text":"(2k - 1) * (2k - 1)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Luba has got an integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", and she wants to find its greatest beautiful divisor. Help her to find it!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of input contains one number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number Luba has got."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one number — the greatest beautiful divisor of Luba's number. It is obvious that the answer always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"l