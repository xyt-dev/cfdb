{"assets":[],"contentKind":"statement","contestId":"1542","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Priority Queue"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a sequence $$$A$$$, where its elements are either in the form "},{"children":[{"kind":"text","text":"+ x"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":", where $$$x$$$ is an integer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For such a sequence $$$S$$$ where its elements are either in the form "},{"children":[{"kind":"text","text":"+ x"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":", define $$$f(S)$$$ as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" iterate through $$$S$$$'s elements from the first one to the last one, and maintain a multiset $$$T$$$ as you iterate through it. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for each element, if it's in the form "},{"children":[{"kind":"text","text":"+ x"}],"kind":"container"},{"kind":"text","text":", add $$$x$$$ to $$$T$$$; otherwise, erase the smallest element from $$$T$$$ (if $$$T$$$ is empty, do nothing). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" after iterating through all $$$S$$$'s elements, compute the sum of all elements in $$$T$$$. $$$f(S)$$$ is defined as the sum. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The sequence $$$b$$$ is a subsequence of the sequence $$$a$$$ if $$$b$$$ can be derived from $$$a$$$ by removing zero or more elements without changing the order of the remaining elements. For all $$$A$$$'s subsequences $$$B$$$, compute the sum of $$$f(B)$$$, modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$n$$$ ($$$1\\leq n\\leq 500$$$) — the length of $$$A$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n$$$ lines begins with an operator "},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":". If the operator is "},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":", then it's followed by an integer $$$x$$$ ($$$1\\le x \\lt 998\\,244\\,353$$$). The $$$i$$$-th line of those $$$n$$$ lines describes the $$$i$$$-th element in $$$A$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer, which is the answer to the problem, modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n-\n+ 1\n+ 2\n-\n"}],"kind":"section"},{"attrs