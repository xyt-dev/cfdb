{"assets":[],"contentKind":"statement","contestId":"1814","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Coins"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In Berland, there are two types of coins, having denominations of $$$2$$$ and $$$k$$$ burles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine whether it is possible to represent $$$n$$$ burles in coins, i. e. whether there exist non-negative integers $$$x$$$ and $$$y$$$ such that $$$2 \\cdot x + k \\cdot y = n$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\le k \\le n \\le 10^{18}$$$; $$$k \\ne 2$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" if it is possible to represent $$$n$$$ burles in coins; otherwise, print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":". You may prin