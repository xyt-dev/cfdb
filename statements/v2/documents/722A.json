{"assets":[],"contentKind":"statement","contestId":"722","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Broken Clock"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a broken clock. You know, that it is supposed to show time in 12- or 24-hours "},{"children":[{"kind":"text","text":"HH:MM"}],"kind":"container"},{"kind":"text","text":" format. In 12-hours format hours change from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"12"},{"kind":"text","text":", while in 24-hours it changes from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"23"},{"kind":"text","text":". In both formats minutes change from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"59"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a time in format "},{"children":[{"kind":"text","text":"HH:MM"}],"kind":"container"},{"kind":"text","text":" that is currently displayed on the broken clock. Your goal is to change minimum number of digits in order to make clocks display the correct time in the given format."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if "},{"children":[{"kind":"text","text":"00:99"}],"kind":"container"},{"kind":"text","text":" is displayed, it is enough to replace the second "},{"children":[{"kind":"text","text":"9"}],"kind":"container"},{"kind":"text","text":" with "},{"children":[{"kind":"text","text":"3"}],"kind":"container"},{"kind":"text","text":" in order to get "},{"children":[{"kind":"text","text":"00:39"}],"kind":"container"},{"kind":"text","text":" that is a correct time in 24-hours format. However, to make "},{"children":[{"kind":"text","text":"00:99"}],"kind":"container"},{"kind":"text","text":" correct in 12-hours format, one has to change at least two digits. Additionally to the first change one can replace the second "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" with "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" and obtain "},{"children":[{"kind":"text","text":"01:39"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer "},{"kind":"math_inline","text":"12"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"24"},{"kind":"text","text":", that denote 12-hours or 24-hours format respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the time in format "},{"children":[{"kind":"text","text":"HH:MM"}],"kind":"container"},{"kind":"text","text":", that is currently displayed on the clock. First two characters stand for the hours, while next two show the minutes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the output should contain the time in format "},{"children":[{"kind":"text","text":"HH:MM"}],"kind":"container"},{"kind":"text","text":" that is a correct time in the given format. It should differ from the original in as few positions as possible. If there are many optimal solutions you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"24\n17:30\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"17:30\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"12\n17:30\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"07:30\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"24\n99:99\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"09:09\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"722A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/722/problem/A"}