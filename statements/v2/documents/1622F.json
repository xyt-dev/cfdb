{"assets":[],"contentKind":"statement","contestId":"1622","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Quadratic Set"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's call a set of positive integers $$$a_1, a_2, \\dots, a_k$$$ "},{"children":[{"kind":"text","text":"quadratic"}],"kind":"container"},{"kind":"text","text":" if the product of the factorials of its elements is a square of an integer, i. e. $$$\\prod\\limits_{i=1}^{k} a_i! = m^2$$$, for some integer $$$m$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a positive integer $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find a "},{"children":[{"kind":"text","text":"quadratic"}],"kind":"container"},{"kind":"text","text":" subset of a set $$$1, 2, \\dots, n$$$ of maximum size. If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line contains a single integer $$$n$$$ ($$$1 \\le n \\le 10^6$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, print a single integer — the size of the maximum subset. In the second line, prin