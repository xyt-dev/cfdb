{"assets":[],"contentKind":"statement","contestId":"1866","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Ambitious Kid"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Chaneka, Pak Chanek's child, is an ambitious kid, so Pak Chanek gives her the following problem to test her ambition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given an array of integers $$$[A_1, A_2, A_3, \\ldots, A_N]$$$. In one operation, Chaneka can choose one element, then increase or decrease the element's value by $$$1$$$. Chaneka can do that operation multiple times, even for different elements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of operations that must be done to make it such that $$$A_1 \\times A_2 \\times A_3 \\times \\ldots \\times A_N = 0$$$?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$N$$$ ($$$1 \\leq N \\leq 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$N$$$ integers $$$A_1, A_2, A_3, \\ldots, A_N$$$ ($$$-10^5 \\leq A_i \\leq 10^5$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"An integer representing the minimum number of operations that must be done to make it such that $$$A_1 \\times A_2 \\times A_3 \\times \\ldots \\times A_N = 0$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2 -6 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n-3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n0 -1 0 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, initially, $$$A_1\\times A_2\\times A_3=2\\times(-6)\\times5=-60$$$. Chaneka can do the following sequence of operations:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Decrease the value of $$$A_1$$$ by $$$1$$$. Then, $$$A_1\\times A_2\\times A_3=1\\times(-6)\\times5=-30$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Decrease the value of $$$A_1$$$ by $$$1$$$. Then, $$$A_1\\times A_2\\times A_3=0\\times(-6)\\times5=0$$$ "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the third example, Chaneka does not have to do any operations, because from the start, it already holds that $$$A_1\\times A_2\\times A_3\\times A_4\\times A_5=0\\times(-1)\\times0\\times1\\times0=0$$$"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1866A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1866/problem/A"}