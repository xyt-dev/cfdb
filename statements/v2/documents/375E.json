{"assets":[],"contentKind":"statement","contestId":"375","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Red and Black Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a weighted tree, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. Each vertex is either painted black or is painted red. A red and black tree is called "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":", if for any its vertex we can find a black vertex at distance at most "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The distance between two nodes is the shortest path between them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have a red and black tree. Your task is to make it beautiful in the minimum number of color swap operations. In one color swap operation, you can choose two vertices of different colors and paint each of them the other color. In other words, if you choose a red vertex "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and a black vertex "},{"kind":"math_inline","text":"q"},{"kind":"text","text":", then in one operation you are allowed to paint "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" black and paint "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" red."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print the minimum number of required actions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"(2 ≤ n ≤ 500; 1 ≤ x ≤ 109)"},{"kind":"text","text":". The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, each of them is either a zero or one. If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number equals 1, then vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" of the tree is black, otherwise vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is red. Next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain the tree edges. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th line contains integers "},{"kind":"math_inline","text":"uj vj wj"},{"kind":"math_inline","text":"(1 ≤ uj, vj ≤ n; uj ≠ vj; 1 ≤ wj ≤ 109)"},{"kind":"text","text":" which means that the tree has an edge of weight "},{"kind":"math_inline","text":"wj"},{"kind":"text","text":" between vertices "},{"kind":"math_inline","text":"vj"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"uj"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Assume that the tree vertices are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum number of required swap operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it is impossible to get a beautiful tree at any number of operations, print -1."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 0 0\n1 2 2\n2 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n0 1 0 0\n1 2 2\n2 3 2\n3 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"375E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/375/problem/E"}