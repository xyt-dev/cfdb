{"assets":[],"contentKind":"statement","contestId":"235","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Cyclical Quest"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Some days ago, WJMZBMR learned how to answer the query \"how many times does a string "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" occur in a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"\" quickly by preprocessing the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". But now he wants to make it harder."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So he wants to ask \"how many consecutive substrings of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" are cyclical isomorphic to a given string "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"\". You are given string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" strings "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", for each string "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" find, how many consecutive substrings of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" are cyclical isomorphic to "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two strings are called "},{"children":[{"kind":"text","text":"cyclical isomorphic"}],"kind":"container"},{"kind":"text","text":" if one can rotate one string to get the other one. 'Rotate' here means 'to take some consecutive chars (maybe none) from the beginning of a string and put them back at the end of the string in the same order'. For example, string \""},{"children":[{"kind":"text","text":"abcde"}],"kind":"container"},{"kind":"text","text":"\" can be rotated to string \""},{"children":[{"kind":"text","text":"deabc"}],"kind":"container"},{"kind":"text","text":"\". We can take characters \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\" from the beginning and put them at the end of \""},{"children":[{"kind":"text","text":"de"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a non-empty string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". The length of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is not greater than "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" characters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of queries. Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains the string "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" — the string for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query. The total length of "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" is less than or equal to "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" characters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem, strings only consist of lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" print a single integer that shows how many consecutive substrings of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" are cyclical isomorphic to "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". Print the answers to the queries in the order they are given in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"baabaabaaa\n5\na\nba\nbaa\naabaa\naaba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n5\n7\n3\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"aabbaa\n3\naa\naabb\nabba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n3\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"235C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/235/problem/C"}