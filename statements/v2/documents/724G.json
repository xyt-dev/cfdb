{"assets":[],"contentKind":"statement","contestId":"724","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Xor-matic Number of the Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an undirected graph, constisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges. Each edge of the graph has some non-negative integer written on it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a triple "},{"kind":"math_inline","text":"(u, v, s)"},{"children":[{"kind":"text","text":"interesting"}],"kind":"container"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"1 ≤ u < v ≤ n"},{"kind":"text","text":" and there is a path ("},{"children":[{"kind":"text","text":"possibly non-simple"}],"kind":"container"},{"kind":"text","text":", i.e. it can visit the same vertices and edges multiple times) between vertices "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" such that xor of all numbers written on the edges of this path is equal to "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"When we compute the value s for some path, each edge is counted in xor as many times, as it appear on this path."}],"kind":"container"},{"kind":"text","text":" It's not hard to prove that there are finite number of such triples."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Calculate the sum over modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":" of the values of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" over all "},{"children":[{"kind":"text","text":"interesting"}],"kind":"container"},{"kind":"text","text":" triples."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ m ≤ 200 000"},{"kind":"text","text":") — numbers of vertices and edges in the given graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The follow "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain three integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ ti ≤ 1018"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ui ≠ vi"},{"kind":"text","text":") — vertices connected by the edge and integer written on it. It is guaranteed that graph doesn't contain self-loops and multiple edges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the single integer, equal to the described sum over modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n1 2 1\n1 3 2\n2 3 3\n3 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n1 2 1\n2 3 2\n3 4 4\n4 1 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"90\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 6\n1 2 2\n2 3 1\n2 4 4\n4 5 5\n4 6 3\n7 8 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"62\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the are "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" interesting triples: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"(1, 2, 1)"}],"kind":"list_item"},{"children":[{"kind":"math