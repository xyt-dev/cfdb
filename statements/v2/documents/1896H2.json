{"assets":[],"contentKind":"statement","contestId":"1896","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H2. Cyclic Hamming (Hard Version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is the hard version of the problem. The only difference between the two versions is the constraint on $$$k$$$. You can make hacks only if all versions of the problem are solved."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this statement, all strings are $$$0$$$-indexed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For two strings $$$a$$$, $$$b$$$ of the same length $$$p$$$, we define the following definitions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The hamming distance between $$$a$$$ and $$$b$$$, denoted as $$$h(a, b)$$$, is defined as the number of positions $$$i$$$ such that $$$0 \\le i \\lt p$$$ and $$$a_i \\ne b_i$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b$$$ is a cyclic shift of $$$a$$$ if there exists some $$$0 \\leq k \\lt p$$$ such that $$$b_{(i+k) \\bmod p} = a_i$$$ for all $$$0 \\le i \\lt p$$$. Here $$$x \\bmod y$$$ denotes the remainder from dividing $$$x$$$ by $$$y$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given two binary strings $$$s$$$ and $$$t$$$ of length $$$2^{k+1}$$$ each. Both strings may contain missing characters (denoted by the character '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"'). Your task is to count the number of ways to replace the missing characters in both strings with the characters '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Each string $$$s$$$ and $$$t$$$ contains exactly $$$2^k$$$ occurrences of each character '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$h(s, c) \\ge 2^k$$$ for all strings $$$c$$$ that is a cyclic shift of $$$t$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"As the result can be very large, you should print the value modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer $$$k$$$ ($$$1 \\le k \\le 12$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains string $$$s$$$ of size $$$2^{k+1}$$$, consisting of the characters '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line of the input contains string $$$t$$$ of size $$$2^{k+1}$$$, consisting of the characters '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that both strings $$$s$$$ and $$$t$$$ contains no more than $$$2^k$$$ character '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the answer to the problem modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n0011\n0101\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n0011\n0110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"s