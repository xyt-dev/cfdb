kind":"text","text":"In the first example, we can check that the condition $$$h(s, c) \\ge 2^k$$$ for all cyclic shift $$$c$$$ of $$$t$$$ is satisfied. In particular: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" for $$$c = \\mathtt{0101}$$$, $$$h(s, c) = h(\\mathtt{0110}, \\mathtt{0101}) = 2 \\ge 2^1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for $$$c = \\mathtt{1010}$$$, $$$h(s, c) = h(\\mathtt{0110}, \\mathtt{1010}) = 2 \\ge 2^1$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second example, there exists a cycle shift $$$c$$$ of $$$t$$$ such that $$$h(s, c) \\lt 2^k$$$ (in particular, $$$c = \\mathtt{0011}$$$, and $$$h(s, c) = h(\\mathtt{0011}, \\mathtt{0011}) = 0$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, there are $$$2$$$ possible ways to recover the missing characters: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$s = \\mathtt{0101}$$$, $$$t = \\mathtt{0110}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s = \\mathtt{0011}$$$, $$$t = \\mathtt{0101}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the fourth example, there are $$$3$$$ possible ways to recover the missing characters: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$s = \\mathtt{00011110}$$$, $$$t = \\mathtt{01010101}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s = \\mathtt{00011011}$$$, $$$t = \\mathtt{01010101}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s = \\mathtt{00001111}$$$, $$$t = \\mathtt{01010101}$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"H2","problemCode":"1896H2","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1896/problem/H2"}