{"assets":[],"contentKind":"statement","contestId":"1547","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Alphabetical Strings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A string $$$s$$$ of length $$$n$$$ ($$$1 \\le n \\le 26$$$) is called "},{"children":[{"kind":"text","text":"alphabetical"}],"kind":"container"},{"kind":"text","text":" if it can be obtained using the following algorithm:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" first, write an empty string to $$$s$$$ (i.e. perform the assignment $$$s$$$ "},{"children":[{"kind":"text","text":":= \"\""}],"kind":"container"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" then perform the next step $$$n$$$ times; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" at the $$$i$$$-th step take $$$i$$$-th lowercase letter of the Latin alphabet and write it either to the left of the string $$$s$$$ or to the right of the string $$$s$$$ (i.e. perform the assignment $$$s$$$ "},{"children":[{"kind":"text","text":":="}],"kind":"container"},{"kind":"text","text":" $$$c+s$$$ or $$$s$$$ "},{"children":[{"kind":"text","text":":="}],"kind":"container"},{"kind":"text","text":" $$$s+c$$$, where $$$c$$$ is the $$$i$$$-th letter of the Latin alphabet). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In other words, iterate over the $$$n$$$ first letters of the Latin alphabet starting from '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and etc. Each time we prepend a letter to the left of the string $$$s$$$ or append a letter to the right of the string $$$s$$$. Strings that can be obtained in that way are alphabetical."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the following strings are alphabetical: \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"bac"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"ihfcbadeg"}],"kind":"container"},{"kind":"text","text":"\". The following strings "},{"children":[{"kind":"text","text":"are not"}],"kind":"container"},{"kind":"text","text":" alphabetical: \""},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ca"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"acb"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"xyz"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"ddcba"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"From the given string, determine if it is alphabetical."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. Then $$$t$$$ test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case is written on a separate line that contains one string $$$s$$$. String $$$s$$$ consists of lowercase letters of the Latin alphabet and has a length between $$$1$$$ and $$$26$$$, inclusive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output $$$t$$$ lines, each of them must contain the answer to the corresponding test case. Output "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" if the given string $$$s$$$ is alphabetical and "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" in any case (for example, strings "},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" will be recognized as a positive answer)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n11\na\nba\nab\nbac\nihfcbadeg\nz\naa\nca\nacb\nxyz\nddcba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nYES\nYES\nYES\nYES\nNO\nNO\nNO\nNO\nNO\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The example contains test cases from the main part of the condition."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1547B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1547/problem/B"}