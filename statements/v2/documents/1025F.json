{"assets":["/statement-assets/7823ccd145ba0fd12c36cc183d0ce8c6834a210990403908dbd374727a189082.png","/statement-assets/6853c3f94c159f7739304378db5d429db7157689a0ecdccb01310a9eacfc07dc.png"],"contentKind":"statement","contestId":"1025","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Disjoint Triangles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A point "},{"children":[{"kind":"text","text":"belongs"}],"kind":"container"},{"kind":"text","text":" to a triangle if it lies inside the triangle or on one of its sides. Two triangles are "},{"children":[{"kind":"text","text":"disjoint"}],"kind":"container"},{"kind":"text","text":" if there is no point on the plane that belongs to both triangles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given $$$n$$$ points on the plane. No two points coincide and no three points are collinear."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the number of different ways to choose two disjoint triangles with vertices in the given points. Two ways which differ only in order of triangles or in order of vertices inside triangles are considered equal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer $$$n$$$ ($$$6 \\le n \\le 2000$$$) – the number of points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n$$$ lines contains two integers $$$x_i$$$ and $$$y_i$$$ ($$$|x_i|, |y_i| \\le 10^9$$$) – the coordinates of a point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"No two points coincide and no three points are collinear."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer – the number of ways to choose two disjoint triangles."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 1\n2 2\n4 6\n4 5\n7 2\n5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n0 -1000000000\n-5 -5\n5 -5\n-5 0\n5 0\n-2 2\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"21\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example there are six pairs of disjoint triangles, they are shown on the picture below."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/7823ccd145ba0fd12c36cc183d0ce8c6834a210990403908dbd374727a189082.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"All other pairs of triangles are not disjoint, for example the following pair:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6853c3f94c159f7739304378db5d429db7157689a0ecdccb01310a9eacfc07dc.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1025F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1025/problem/F"}