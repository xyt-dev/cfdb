{"assets":[],"contentKind":"statement","contestId":"1977","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Binary Colouring"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a positive integer $$$x$$$. Find any array of integers $$$a_0, a_1, \\ldots, a_{n-1}$$$ for which the following holds: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1 \\le n \\le 32$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_i$$$ is $$$1$$$, $$$0$$$, or $$$-1$$$ for all $$$0 \\le i \\le n - 1$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$x = \\displaystyle{\\sum_{i=0}^{n - 1}{a_i \\cdot 2^i}}$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There does not exist an index $$$0 \\le i \\le n - 2$$$ such that both $$$a_{i} \\neq 0$$$ and $$$a_{i + 1} \\neq 0$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It can be proven that under the constraints of the problem, a valid array always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line of input contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a single positive integer $$$x$$$ ($$$1 \\le x \\lt 2^{30}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output two lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the first line, output an integer $$$n$$$ ($$$1 \\le n \\le 32$$$) — the length of the array $$$a_0, a_1, \\ldots, a_{n-1}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the second line, output the array $$$a_0, a_1, \\ldots, a_{n-1}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple valid arrays, you can output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n1\n14\n24\n15\n27\n11\n19\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n1\n5\n0 -1 0 0 1\n6\n0 0 0 -1 0 1\n5\n-1 0 0 0 1\n6\n-1 0 -1 0 0 1\n5\n-1 0 -1 0 1\n5\n-1 0 1 0 1"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, one valid array is $$$[1]$$$, since $$$(1) \\cdot 2^0 = 1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, one possible valid array is $$$[0,-1,0,0,1]$$$, since $$$(0) \\cdot 2^0 + (-1) \\cdot 2^1 + (0) \\cdot 2^2 + (0) \\cdot 2^3 + (1) \\cdot 2^4 = -2 + 16 = 14$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1977B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1977/problem/B"}