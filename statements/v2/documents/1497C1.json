{"assets":[],"contentKind":"statement","contestId":"1497","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C1. k-LCM (easy version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"It is the easy version of the problem. The only difference is that in this version $$$k = 3$$$."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a positive integer $$$n$$$. Find $$$k$$$ positive integers $$$a_1, a_2, \\ldots, a_k$$$, such that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a_1 + a_2 + \\ldots + a_k = n$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$LCM(a_1, a_2, \\ldots, a_k) \\le \\frac{n}{2}$$$ "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Here $$$LCM$$$ is the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Least_common_multiple"},"children":[{"kind":"text","text":"least common multiple"}],"kind":"link"},{"kind":"text","text":" of numbers $$$a_1, a_2, \\ldots, a_k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can show that for given constraints the answer always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ $$$(1 \\le t \\le 10^4)$$$  — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains two integers $$$n$$$, $$$k$$$ ($$$3 \\le n \\le 10^9$$$, $$$k = 3$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print $$$k$$$ positive integers $$$a_1, a_2, \\ldots, a_k$$$, for which all conditions are satisfied."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n3 3\n8 3\n14 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 1 1\n4 2 2\n2 6 6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C1","problemCode":"1497C1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1497/problem/C1"}