{"assets":[],"contentKind":"statement","contestId":"859","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Ordering T-Shirts"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"It's another Start[c]up, and that means there are T-shirts to order. In order to make sure T-shirts are shipped as soon as possible, we've decided that this year we're going to order all of the necessary T-shirts before the actual competition. The top "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" contestants are going to be awarded T-shirts, but we obviously don't know which contestants that will be. The plan is to get the T-Shirt sizes of all contestants before the actual competition, and then order enough T-shirts so that no matter who is in the top "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" we'll have T-shirts available in order to award them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In order to get the T-shirt sizes of the contestants, we will send out a survey. The survey will allow contestants to either specify a single desired T-shirt size, or two adjacent T-shirt sizes. If a contestant specifies two sizes, it means that they can be awarded either size."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As you can probably tell, this plan could require ordering a lot of unnecessary T-shirts. We'd like your help to determine the minimum number of T-shirts we'll need to order to ensure that we'll be able to award T-shirts no matter the outcome of the competition."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Input will begin with two integers "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ N ≤ 2·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ C"},{"kind":"text","text":"), the number of T-shirt sizes and number of T-shirts to be awarded, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Following this is a line with "},{"kind":"math_inline","text":"2·N - 1"},{"kind":"text","text":" integers, "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"s2·N - 1"},{"kind":"math_inline","text":"(0 ≤ si ≤ 108)"},{"kind":"text","text":". For odd "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" indicates the number of contestants desiring T-shirt size "},{"kind":"math_inline","text":"((i + 1) / 2)"},{"kind":"text","text":". For even "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" indicates the number of contestants okay receiving either of T-shirt sizes "},{"kind":"math_inline","text":"(i / 2)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(i / 2 + 1)"},{"kind":"text","text":". "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" will not exceed the total number of contestants."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of T-shirts we need to buy."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 200\n100 250 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"200\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 160\n88 69 62 29 58 52 44\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"314\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, we can buy "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" of each size."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"859F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/859/problem/F"}