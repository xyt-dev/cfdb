{"assets":["/statement-assets/e32b3a727f990ba88307ac100937e9bed7a65d8af55fdb872329f6e45dab82c5.png","/statement-assets/362cf86df988cde32d7d6c40b05612778a34d234376540864fe763096b49ce48.png"],"contentKind":"statement","contestId":"811","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Vladik and Entertaining Flags"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In his spare time Vladik estimates beauty of the flags."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Every flag could be represented as the matrix "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" which consists of positive integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define the beauty of the flag as number of components in its matrix. We call component a set of cells with same numbers and between any pair of cells from that set there exists a path through adjacent cells from same component. Here is the example of the partitioning some flag matrix into components:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e32b3a727f990ba88307ac100937e9bed7a65d8af55fdb872329f6e45dab82c5.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"But this time he decided to change something in the process. Now he wants to estimate not the entire flag, but some segment. Segment of flag can be described as a submatrix of the flag matrix with opposite corners at "},{"kind":"math_inline","text":"(1, l)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(n, r)"},{"kind":"text","text":", where conditions "},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ m"},{"kind":"text","text":" are satisfied."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Vladik to calculate the beauty for some segments of the given flag."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains three space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m, q ≤ 105"},{"kind":"text","text":") — dimensions of flag matrix and number of segments respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space-separated integers — description of flag matrix. All elements of flag matrix is positive integers not exceeding "},{"kind":"math_inline","text":"106"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains two space-separated integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ m"},{"kind":"text","text":") — borders of segment which beauty Vladik wants to know."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each segment print the result on the corresponding line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5 4\n1 1 1 1 1\n1 2 2 3 3\n1 1 1 2 5\n4 4 5 5 5\n1 5\n2 5\n1 2\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n7\n3\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Partitioning on components for every segment from first test case:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/362cf86df988cde32d7d6c40b05612778a34d234376540864fe763096b49ce48.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"811E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/811/problem/E"}