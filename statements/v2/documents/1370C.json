{"assets":[],"contentKind":"statement","contestId":"1370","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Number Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ashishgup and FastestFinger play a game. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"They start with a number $$$n$$$ and play in turns. In each turn, a player can make "},{"children":[{"kind":"text","text":"any one"}],"kind":"container"},{"kind":"text","text":" of the following moves:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Divide $$$n$$$ by any of its odd divisors greater than $$$1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Subtract $$$1$$$ from $$$n$$$ if $$$n$$$ is greater than $$$1$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Divisors of a number include the number itself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The player who is "},{"children":[{"kind":"text","text":"unable to make a move"}],"kind":"container"},{"kind":"text","text":" loses the game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ashishgup moves first. Determine the winner of the game if both of them play optimally."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 100$$$)  — the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a single integer  — $$$n$$$ ($$$1 \\leq n \\leq 10^9$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print \""},{"children":[{"kind":"text","text":"Ashishgup"}],"kind":"container"},{"kind":"text","text":"\" if he wins, and \""},{"children":[{"kind":"text","text":"FastestFinger"}],"kind":"container"},{"kind":"text","text":"\" otherwise (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n1\n2\n3\n4\n5\n6\n12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nFastestFinger\nAshishgup\nAshishgup\nFastestFinger\nAshishgup\nFastestFinger\nAshishgup\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, $$$n = 1$$$, Ashishgup cannot make a move. He loses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, $$$n = 2$$$, Ashishgup subtracts $$$1$$$ on the first move. Now $$$n = 1$$$, FastestFinger cannot make a move, so he loses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, $$$n = 3$$$, Ashishgup divides by $$$3$$$ on the first move. Now $$$n = 1$$$, FastestFinger cannot make a move, so he loses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the last test case, $$$n = 12$$$, Ashishgup divides it by $$$3$$$. Now $$$n = 4$$$, FastestFinger is forced to subtract $$$1$$$, and Ashishgup gets $$$3$$$, so he wins by dividing it by $$$3$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1370C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1370/problem/C"}