{"assets":[],"contentKind":"statement","contestId":"545","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Paths and Trees"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little girl Susie accidentally found her elder brother's notebook. She has many things to do, more important than solving problems, but she found this problem too interesting, so she wanted to know its solution and decided to ask you about it. So, the problem statement is as follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's assume that we are given a "},{"children":[{"kind":"text","text":"connected"}],"kind":"container"},{"kind":"text","text":" weighted undirected graph "},{"kind":"math_inline","text":"G = (V, E)"},{"kind":"text","text":" (here "},{"kind":"math_inline","text":"V"},{"kind":"text","text":" is the set of vertices, "},{"kind":"math_inline","text":"E"},{"kind":"text","text":" is the set of edges). The shortest-path tree from vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" is such graph "},{"kind":"math_inline","text":"G1 = (V, E1)"},{"kind":"text","text":" that is a tree with the set of edges "},{"kind":"math_inline","text":"E1"},{"kind":"text","text":" that is the subset of the set of edges of the initial graph "},{"kind":"math_inline","text":"E"},{"kind":"text","text":", and the lengths of the shortest paths from "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" to any vertex to "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" and to "},{"kind":"math_inline","text":"G1"},{"kind":"text","text":" are the same. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a "},{"children":[{"kind":"text","text":"connected"}],"kind":"container"},{"kind":"text","text":" weighted undirected graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" and vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":". Your task is to find the shortest-path tree of the given graph from vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", the total weight of whose edges is minimum possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two numbers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 3·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ m ≤ 3·105"},{"kind":"text","text":") — the number of vertices and edges of the graph, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain three integers each, representing an edge — "},{"kind":"math_inline","text":"ui, vi, wi"},{"kind":"text","text":" — the numbers of vertices connected by an edge and the weight of the edge ("},{"kind":"math_inline","text":"ui ≠ vi, 1 ≤ wi ≤ 109"},{"kind":"text","text":"). It is guaranteed that graph is connected and that "},{"children":[{"kind":"text","text":"there is no more than one edge between any pair of vertices"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line of the input contains integer "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ u ≤ n"},{"kind":"text","text":") — the number of the start vertex."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the minimum total weight of the edges of the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next line print the indices of the edges that are included in the tree, separated by spaces. The edges are numbered starting from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" in the order they follow in the input. You may print the numbers of the edges in any order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2 1\n2 3 1\n1 3 2\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n1 2 1\n2 3 1\n3 4 1\n4 1 2\n4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 3 4 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample there are two possible shortest path trees:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" with edges "},{"kind":"math_inline","text":"1 – 3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2 – 3"},{"kind":"text","text":" (the total weight is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" with edges "},{"kind":"math_inline","text":"1 – 2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2 – 3"},{"kind":"text","text":" (the total weight is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"); "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"And, for example, a tree with edges "},{"kind":"math_inline","text":"1 – 2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 – 3"},{"kind":"text","text":" won't be a shortest path tree for vertex "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", because the distance from vertex "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" in this tree equals "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", and in the original graph it is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"545E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/545/problem/E"}