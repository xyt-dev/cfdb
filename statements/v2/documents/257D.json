{"assets":[],"contentKind":"statement","contestId":"257","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Sum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya has found a piece of paper with an array written on it. The array consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". Vasya noticed that the following condition holds for the array "},{"kind":"math_inline","text":"ai ≤ ai + 1 ≤ 2·ai"},{"kind":"text","text":" for any positive integer "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"i < n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya wants to add either a \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" or a \""},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"\" before each number of array. Thus, Vasya will get an expression consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" summands. The value of the resulting expression is the sum of all its elements. The task is to add signs \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"\" before each number so that the value of expression "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" meets the limits "},{"kind":"math_inline","text":"0 ≤ s ≤ a1"},{"kind":"text","text":". Print a sequence of signs \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"\", satisfying the given limits. It is guaranteed that the solution for the problem exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the size of the array. The second line contains space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 109"},{"kind":"text","text":") — the original array. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the condition "},{"kind":"math_inline","text":"ai ≤ ai + 1 ≤ 2·ai"},{"kind":"text","text":" fulfills for any positive integer "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"i < n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print the sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"\", where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character is the sign that is placed in front of number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". The value of the resulting expression "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" must fit into the limits "},{"kind":"math_inline","text":"0 ≤ s ≤ a1"},{"kind":"text","text":". If there are multiple solutions, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"+++-"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"++-"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"257D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/257/problem/D"}