{"assets":[],"contentKind":"statement","contestId":"768","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Oath of the Night's Watch"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"\"Night gathers, and now my watch begins. It shall not end until my death. I shall take no wife, hold no lands, father no children. I shall wear no crowns and win no glory. I shall live and die at my post. I am the sword in the darkness. I am the watcher on the walls. I am the shield that guards the realms of men. I pledge my life and honor to the Night's Watch, for this night and all the nights to come.\""}],"kind":"container"},{"kind":"text","text":" — The Night's Watch oath."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"With that begins the watch of Jon Snow. He is assigned the task to support the stewards."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This time he has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" stewards with him whom he has to provide support. Each steward has his own strength. Jon Snow likes to support a steward only if there exists at least one steward who has strength strictly less than him and at least one steward who has strength strictly greater than him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Can you find how many stewards will Jon support?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line consists of a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of stewards with Jon Snow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second line consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 109"},{"kind":"text","text":") representing the values assigned to the stewards."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer representing the number of stewards which Jon will feed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Jon Snow cannot support steward with strength "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" because there is no steward with strength less than "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and he cannot support steward with strength "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" because there is no steward with strength greater than "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, Jon Snow can support steward with strength "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" because there are stewards with strength less than "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and greater than "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"768A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/768/problem/A"}