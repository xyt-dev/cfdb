{"assets":[],"contentKind":"statement","contestId":"2227","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Koshary"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Yousef is at the coordinates $$$(0, 0)$$$ and wants to reach a plate of Koshary at $$$(x, y)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To get there, Yousef takes long steps. From any point $$$(a, b)$$$, a long step moves him to: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$(a + 2, b)$$$ or $$$(a, b + 2)$$$ "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"However, Yousef is allowed to take "},{"children":[{"kind":"text","text":"at most one"}],"kind":"container"},{"kind":"text","text":" short step during his entire journey. A short step moves him to: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$(a + 1, b)$$$ or $$$(a, b + 1)$$$ "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Can Yousef reach the exact coordinates $$$(x, y)$$$ of the Koshary plate?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\le t \\le 100$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case contains two integers $$$x$$$ and $$$y$$$ ($$$1 \\le x, y \\le 10$$$) — the coordinates of the Koshary plate."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if Yousef can reach the Koshary plate and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output the answer in any case (upper or lower). For example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be recognized as positive responses."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 1\n1 2\n4 6\n5 9\n7 2\n10 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\nYES\nYES\nNO\nYES\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, it is impossible to reach $$$(1, 1)$$$ using the mentioned steps."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, an optimal sequence of steps would be: $$$$$$(0, 0) \\xrightarrow{\\texttt{long}} (0, 2) \\xrightarrow{\\texttt{short}} (1, 2)$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, an optimal sequence of steps would be: $$$$$$(0, 0) \\xrightarrow{\\texttt{long}} (0, 2) \\xrightarrow{\\texttt{long}} (2, 2) \\xrightarrow{\\texttt{long}} (2, 4) \\xrightarrow{\\texttt{long}} (4, 4) \\xrightarrow{\\texttt{long}} (4, 6)$$$$$$"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2227A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2227/problem/A"}