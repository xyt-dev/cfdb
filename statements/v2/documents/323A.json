{"assets":[],"contentKind":"statement","contestId":"323","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Black-and-White Cube"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"0.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a cube of size "},{"kind":"math_inline","text":"k × k × k"},{"kind":"text","text":", which consists of unit cubes. Two unit cubes are considered neighbouring, if they have common face."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to paint each of "},{"kind":"math_inline","text":"k3"},{"kind":"text","text":" unit cubes one of two colours (black or white), so that the following conditions must be satisfied:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" each white cube has exactly 2 neighbouring cubes of white color; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" each black cube has exactly 2 neighbouring cubes of black color. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ k ≤ 100)"},{"kind":"text","text":", which is size of the cube."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print -1 if there is no solution. Otherwise, print the required painting of the cube consequently by layers. Print a "},{"kind":"math_inline","text":"k × k"},{"kind":"text","text":" matrix in the first "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines, showing how the first layer of the cube should be painted. In the following "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines print a "},{"kind":"math_inline","text":"k × k"},{"kind":"text","text":" matrix — the way the second layer should be painted. And so on to the last "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th layer. Note that orientation of the cube in the space does not matter."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mark a white unit cube with symbol \""},{"children":[{"kind":"text","text":"w"}],"kind":"container"},{"kind":"text","text":"\" and a black one with \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\". Use the format of output data, given in the test samples. You may print extra empty lines, they will be ignored."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"bb\nww\n\nbb\nww\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"323A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/323/problem/A"}