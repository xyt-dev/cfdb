{"assets":[],"contentKind":"statement","contestId":"598","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Igor In the Museum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Igor is in the museum and he wants to see as many pictures as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Museum can be represented as a rectangular field of "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" cells. Each cell is either empty or impassable. Empty cells are marked with '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"', impassable cells are marked with '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"'. Every two adjacent cells of different types (one empty and one impassable) are divided by a wall containing one picture."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At the beginning Igor is in some empty cell. At every moment he can move to any empty cell that share a side with the current one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For several starting positions you should calculate the maximum number of pictures that Igor can see. Igor is able to see the picture only if he is in the cell adjacent to the wall with this picture. Igor have a lot of time, so he will examine every picture he can see."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n, m ≤ 1000, 1 ≤ k ≤ min(n·m, 100 000)"},{"kind":"text","text":") — the museum dimensions and the number of starting positions to process."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" symbols '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"' — the description of the museum. It is guaranteed that all border cells are impassable, so Igor can't go out from the museum."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the last "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ n, 1 ≤ y ≤ m"},{"kind":"text","text":") — the row and the column of one of Igor's starting positions respectively. Rows are numbered from top to bottom, columns — from left to right. It is guaranteed that all starting positions are empty cells."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers — the maximum number of pictures, that Igor can see if he starts in corresponding position."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6 3\n******\n*..*.*\n******\n*....*\n******\n2 2\n2 5\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n4\n10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4 1\n****\n*..*\n*.**\n****\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"598D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/598/problem/D"}