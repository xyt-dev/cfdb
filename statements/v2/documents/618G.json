{"assets":["/statement-assets/b5e9736d2dd3bc4de89c52f79e5a51858fed52acfbeef8d1bb2f2615357b8fab.png","/statement-assets/0991932f83f53a150a62a22ae764b99b0d90efae013e3b21b0531d847659bb77.png","/statement-assets/9ca07664d7bed771f2d053313648f5b2c151f77f7cf8334ec44105cd4821138c.png"],"contentKind":"statement","contestId":"618","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Combining Slimes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Your friend recently gave you some slimes for your birthday. You have a very large amount of slimes with value "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", and you decide to invent a game using these slimes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You initialize a row with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" empty spaces. You also choose a number "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" to be used in the game. Then, you will perform the following steps while the last space is empty. "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" With probability "},{"attrs":{"alt":"","src":"/statement-assets/b5e9736d2dd3bc4de89c52f79e5a51858fed52acfbeef8d1bb2f2615357b8fab.png"},"kind":"image"},{"kind":"text","text":", you will choose a slime with value "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", and with probability "},{"attrs":{"alt":"","src":"/statement-assets/0991932f83f53a150a62a22ae764b99b0d90efae013e3b21b0531d847659bb77.png"},"kind":"image"},{"kind":"text","text":", you will choose a slime with value "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". You place the chosen slime on the last space of the board. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" You will push the slime to the left as far as possible. If it encounters another slime, and they have the same value "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", you will merge the slimes together to create a single slime with value "},{"kind":"math_inline","text":"v + 1"},{"kind":"text","text":". This continues on until the slime reaches the end of the board, or encounters a slime with a different value than itself. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You have played the game a few times, but have gotten bored of it. You are now wondering, what is the expected sum of all values of the slimes on the board after you finish the game."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input will contain two integers "},{"kind":"math_inline","text":"n, p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 109, 1 ≤ p < 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the expected sum of all slimes on the board after the game finishes. Your answer will be considered correct if its absolute or relative error does not exceed "},{"kind":"math_inline","text":"10 - 4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Namely, let's assume that your answer is "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and the answer of the jury is "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The checker program will consider your answer correct, if "},{"attrs":{"alt":"","src":"/statement-assets/9ca07664d7bed771f2d053313648f5b2c151f77f7cf8334ec44105cd4821138c.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 500000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3.562500000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"64.999983360007620\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"100 123456789\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"269.825611298854770\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, we have a board with two squares, and there is a "},{"kind":"math_inline","text":"0.5"},{"kind":"text","text":" probability of a "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" appearing and a "},{"kind":"math_inline","text":"0.5"},{"kind":"text","text":" probability of a "},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":" appearing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Our final board states can be "},{"children":[{"kind":"text","text":"1 2"}],"kind":"container"},{"kind":"text","text":" with probability "},{"kind":"math_inline","text":"0.25"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"2 1"}],"kind":"container"},{"kind":"text","text":" with probability "},{"kind":"math_inline","text":"0.375"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"3 2"}],"kind":"container"},{"kind":"text","text":" with probability "},{"kind":"math_inline","text":"0.1875"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"3 1"}],"kind":"container"},{"kind":"text","text":" with probability "},{"kind":"math_inline","text":"0.1875"},{"kind":"text","text":". The expected value is thus "},{"kind":"math_inline","text":"(1 + 2)·0.25 + (2 + 1)·0.375 + (3 + 2)·0.1875 + (3 + 1)·0.1875 = 3.5625"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"618G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/618/problem/G"}