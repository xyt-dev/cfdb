{"assets":[],"contentKind":"statement","contestId":"976","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Well played!"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recently Max has got himself into popular CCG \"BrainStone\". As \"BrainStone\" is a pretty intellectual game, Max has to solve numerous hard problems during the gameplay. Here is one of them:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Max owns "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" creatures, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them can be described with two numbers — its health "},{"kind":"math_inline","text":"hpi"},{"kind":"text","text":" and its damage "},{"kind":"math_inline","text":"dmgi"},{"kind":"text","text":". Max also has two types of spells in stock:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Doubles health of the creature ("},{"kind":"math_inline","text":"hpi"},{"kind":"text","text":" := "},{"kind":"math_inline","text":"hpi·2"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Assigns value of "},{"children":[{"kind":"text","text":"health"}],"kind":"container"},{"kind":"text","text":" of the creature to its "},{"children":[{"kind":"text","text":"damage"}],"kind":"container"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"dmgi"},{"kind":"text","text":" := "},{"kind":"math_inline","text":"hpi"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Spell of first type can be used no more than "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" times in total, of the second type — no more than "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" times in total. Spell can be used on a certain creature multiple times. Spells can be used in arbitrary order. It isn't necessary to use all the spells."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Max is really busy preparing for his final exams, so he asks you to determine what is the maximal total damage of all creatures he can achieve if he uses spells in most optimal way."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ a ≤ 20"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ b ≤ 2·105"},{"kind":"text","text":") — the number of creatures, spells of the first type and spells of the second type, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain two number "},{"kind":"math_inline","text":"hpi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"dmgi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ hpi, dmgi ≤ 109"},{"kind":"text","text":") — description of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th creature."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print single integer — maximum total damage creatures can deal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 1\n10 15\n6 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"27\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 0 3\n10 8\n7 11\n5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"26\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Max should use the spell of the first type on the second creature, then the spell of the second type on the same creature. Then total damage will be equal to "},{"kind":"math_inline","text":"15 + 6·2 = 27"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example Max should use the spell of the second type on the first creature, then the spell of the second type on the third creature. Total damage will be equal to "},{"kind":"ma