{"assets":[],"contentKind":"statement","contestId":"832","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Petya and Exam"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"It's hard times now. Today Petya needs to score 100 points on Informatics exam. The tasks seem easy to Petya, but he thinks he lacks time to finish them all, so he asks you to help with one.."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is a glob pattern in the statements (a string consisting of lowercase English letters, characters \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\"). It is known that character \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\" occurs "},{"children":[{"kind":"text","text":"no more than once"}],"kind":"container"},{"kind":"text","text":" in the pattern."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" query strings are given, it is required to determine for each of them if the pattern matches it or not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Everything seemed easy to Petya, but then he discovered that "},{"children":[{"kind":"text","text":"the special pattern characters differ from their usual meaning"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A pattern matches a string if it is possible to replace each character \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\" with one "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" lowercase English letter, and the character \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\" (if there is one) with any, including empty, string of "},{"children":[{"kind":"text","text":"bad"}],"kind":"container"},{"kind":"text","text":" lowercase English letters, so that the resulting string is the same as the given string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The good letters are given to Petya. All the others are bad."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a string with length from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"26"},{"kind":"text","text":" consisting of distinct lowercase English letters. These letters are good letters, all the others are bad."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the pattern — a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of lowercase English letters, characters \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 105"},{"kind":"text","text":"). It is guaranteed that character \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\" occurs in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" no more than once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of query strings."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, each of them contains single non-empty string consisting of lowercase English letters — a query string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the total length of all query strings is not greater than "},{"kind":"math_inline","text":"105"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines: in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if the pattern matches the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query string, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can choose the case (lower or upper) for each letter arbitrary."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ab\na?a\n2\naaa\naab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nNO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abc\na?a?a*\n4\nabacaba\nabaca\napapa\naaaaax\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\nYES\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example we can replace \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\" with good letters \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\", so we can see that the answer for the first query is \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\", and the answer for the second query is \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\", because we can't match the third letter."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Explanation of the second example. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The first query: \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\", because character \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\" can be replaced with a string of bad letters only, but the only way to match the query string is to replace it with the string \""},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":"\", in which both letters are good. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The second query: \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\", because characters \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\" can be replaced with corresponding good letters, and character \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\" can be replaced with empty string, and the strings will coincide. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The third query: \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\", because characters \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\" can't be replaced with bad letters. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The fourth query: \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\", because characters \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\" can be replaced with good letters \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", and character \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\" can be replaced with a string of bad letters \""},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"832B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/832/problem/B"}