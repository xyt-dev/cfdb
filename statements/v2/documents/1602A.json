{"assets":[],"contentKind":"statement","contestId":"1602","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Two Subsequences"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$. You need to find two non-empty strings $$$a$$$ and $$$b$$$ such that the following conditions are satisfied:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Strings $$$a$$$ and $$$b$$$ are both "},{"children":[{"kind":"text","text":"subsequences"}],"kind":"container"},{"kind":"text","text":" of $$$s$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For each index $$$i$$$, character $$$s_i$$$ of string $$$s$$$ must belong to "},{"children":[{"kind":"text","text":"exactly one"}],"kind":"container"},{"kind":"text","text":" of strings $$$a$$$ or $$$b$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" String $$$a$$$ is "},{"children":[{"kind":"text","text":"lexicographically"}],"kind":"container"},{"kind":"text","text":" minimum possible; string $$$b$$$ may be any possible string. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Given string $$$s$$$, print any valid $$$a$$$ and $$$b$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Reminder:"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string $$$a$$$ ($$$b$$$) is a "},{"children":[{"kind":"text","text":"subsequence"}],"kind":"container"},{"kind":"text","text":" of a string $$$s$$$ if $$$a$$$ ($$$b$$$) can be obtained from $$$s$$$ by deletion of several (possibly, zero) elements. For example, \""},{"children":[{"kind":"text","text":"dores"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"cf"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"for"}],"kind":"container"},{"kind":"text","text":"\" are subsequences of \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\", while \""},{"children":[{"kind":"text","text":"decor"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"fork"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string $$$x$$$ is "},{"children":[{"kind":"text","text":"lexicographically smaller"}],"kind":"container"},{"kind":"text","text":" than a string $$$y$$$ if and only if one of the following holds:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$x$$$ is a prefix of $$$y$$$, but $$$x \\ne y$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the first position where $$$x$$$ and $$$y$$$ differ, the string $$$x$$$ has a letter that appears earlier in the alphabet than the corresponding letter in $$$y$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 1000$$$). Description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first and only line of each test case contains one string $$$s$$$ ($$$2 \\le |s| \\le 100$$$ where $$$|s|$$$ means the length of $$$s$$$). String $$$s$$$ consists of lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the strings $$$a$$$ and $$$b$$$ that satisfy the given conditions. If there are multiple answers, print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\nfc\naaaa\nthebrightboiler\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nc f\na aaa\nb therightboiler\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, there are only two choices: either $$$a =$$$ "},{"children":[{"kind":"text","text":"f"}],"kind":"container"},{"kind":"text","text":" and $$$b = $$$ "},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":" or $$$a = $$$ "},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":" and $$$b = $$$ "},{"children":[{"kind":"text","text":"f"}],"kind":"container"},{"kind":"text","text":". And $$$a = $$$"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":" is lexicographically smaller than $$$a = $$$ "},{"children":[{"kind":"text","text":"f"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, "},{"children":[{"kind":"text",