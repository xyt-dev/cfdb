{"assets":[],"contentKind":"statement","contestId":"1605","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Dominant Character"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ashish has a string $$$s$$$ of length $$$n$$$ containing only characters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He wants to find the length of the smallest substring, which satisfies the following conditions: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Length of the substring is "},{"children":[{"kind":"text","text":"at least"}],"kind":"container"},{"kind":"text","text":" $$$2$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' occurs strictly more times in this substring than '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' occurs strictly more times in this substring than '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"' "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Ashish is busy planning his next Codeforces round. Help him solve the problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string $$$a$$$ is a substring of a string $$$b$$$ if $$$a$$$ can be obtained from $$$b$$$ by deletion of several (possibly, zero or all) characters from the beginning and several (possibly, zero or all) characters from the end."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ $$$(1 \\le t \\le 10^{5})$$$  — the number of test cases. The description of test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ $$$(2 \\le n \\le 10^{6})$$$  — the length of the string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$s$$$ consisting only of characters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$10^{6}$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the length of the smallest substring which satisfies the given conditions or print $$$-1$$$ if there is no such substring."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2\naa\n5\ncbabb\n8\ncacabccc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n-1\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first test case. In the substring \""},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"\", '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' occurs twice, while '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"' occur zero times. Since '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' occurs strictly more times than '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"', the substring \""},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"\" satisfies the condition and the answer is $$$2$$$. The substring \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" also satisfies this condition, however its length is not at least $$$2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, it can be shown that in none of the substrings of \""},{"children":[{"kind":"text","text":"cbabb"}],"kind":"container"},{"kind":"text","text":"\" does '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' occur strictly more times than '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"' each."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, \""},{"children":[{"kind":"text","text":"c"},{"children":[{"kind":"text","text":"aca"}],"kind":"container"},{"kind":"text","text":"bccc"}],"kind":"container"},{"kind":"text","text":"\", the length of the smallest substring that satisfies the conditions is $$$3$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1605C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1605/problem/C"}