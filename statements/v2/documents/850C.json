{"assets":["/statement-assets/cb1018eec050249b8f307305bc1875154a62fdac48fe1ce0dead6c3e6c9627c9.png"],"contentKind":"statement","contestId":"850","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Arpa and a game with Mojtaba"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mojtaba and Arpa are playing a game. They have a list of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers in the game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In a player's turn, he chooses a number "},{"kind":"math_inline","text":"pk"},{"kind":"text","text":" (where "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is a prime number and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is a positive integer) such that "},{"kind":"math_inline","text":"pk"},{"kind":"text","text":" divides at least one number in the list. For each number in the list divisible by "},{"kind":"math_inline","text":"pk"},{"kind":"text","text":", call it "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", the player will delete "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and add "},{"attrs":{"alt":"","src":"/statement-assets/cb1018eec050249b8f307305bc1875154a62fdac48fe1ce0dead6c3e6c9627c9.png"},"kind":"image"},{"kind":"text","text":" to the list. The player who can not make a valid choice of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" loses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mojtaba starts the game and the players alternatively make moves. Determine which one of players will be the winner if both players play optimally."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of elements in the list."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — the elements of the list."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If Mojtaba wins, print \""},{"children":[{"kind":"text","text":"Mojtaba"}],"kind":"container"},{"kind":"text","text":"\", otherwise print \""},{"children":[{"kind":"text","text":"Arpa"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print each letter in any case (upper or lower)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs"