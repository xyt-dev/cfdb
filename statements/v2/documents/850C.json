,{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample test, if Mojtaba chooses "},{"kind":"math_inline","text":"p = 17"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":", then Arpa chooses "},{"kind":"math_inline","text":"p = 17"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":" and wins, if Mojtaba chooses "},{"kind":"math_inline","text":"p = 17"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":", then Arpa chooses "},{"kind":"math_inline","text":"p = 17"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":" and wins."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"850C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/850/problem/C"}