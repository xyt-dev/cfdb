{"assets":[],"contentKind":"statement","contestId":"347","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Difference Row"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You want to arrange "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" in some order in a row. Let's define the value of an arrangement as the sum of differences between all pairs of adjacent integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, let's denote some arrangement as a sequence of integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":", where sequence "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is a permutation of sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". The value of such an arrangement is "},{"kind":"math_inline","text":"(x1 - x2) + (x2 - x3) + ... + (xn - 1 - xn)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the largest possible value of an arrangement. Then, output the lexicographically smallest sequence "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" that corresponds to an arrangement of the largest possible value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|ai| ≤ 1000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the required sequence "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":". Sequence "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" should be the lexicographically smallest permutation of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" that corresponds to an arrangement of the largest possible value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n100 -100 50 0 -50\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"100 -50 0 50 -100 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the sample test case, the value of the output arrangement is "},{"kind":"math_inline","text":"(100 - ( - 50)) + (( - 50) - 0) + (0 - 50) + (50 - ( - 100)) = 200"},{"kind":"text","text":". No other arrangement has a larger value, and among all arrangements with the value of "},{"kind":"math_inline","text":"200"},{"kind":"text","text":", the output arrangement is the lexicographically smallest one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sequence "},{"kind":"math_inline","text":"x1, x2, ... , xp"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"lexicographically smaller"}],"kind":"container"},{"kind":"text","text":" than sequence "},{"kind":"math_inline","text":"y1, y2, ... , yp"},{"kind":"text","text":" if there exists an integer "},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"(0 ≤ r < p)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"x1 = y1, x2 = y2, ... , xr = yr"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"xr + 1 < yr + 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"347A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/347/problem/A"}