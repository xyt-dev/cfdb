{"assets":[],"contentKind":"statement","contestId":"2125","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Segments Covering"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a linear strip divided into $$$m$$$ cells, numbered from $$$1$$$ to $$$m$$$ from left to right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given $$$n$$$ segments. Each segment is defined by four numbers: $$$l$$$, $$$r$$$, $$$p$$$ and $$$q$$$ — the segment covers cells from $$$l$$$ to $$$r$$$ inclusively and exists with probability $$$\\frac{p}{q}$$$ (independently)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to calculate the probability that each cell is covered by "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" one segment."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\le n, m \\le 2 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$n$$$ lines follow. The $$$i$$$-th of them contains four integers $$$l_i$$$, $$$r_i$$$, $$$p_i$$$ and $$$q_i$$$ ($$$1 \\le l_i \\le r_i \\le m$$$; $$$1 \\le p_i \\lt q_i \\lt 998244353$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the probability that each cell is covered by exactly one segment, taken modulo $$$998244353$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, the probability can be expressed as an irreducible fraction $$$\\frac{x}{y}$$$. You have to print the value of $$$x \\cdot y^{-1} \\bmod 998244353$$$, where $$$y^{-1}$$$ is an integer such that $$$y \\cdot y^{-1} \\bmod 998244353 = 1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 3\n1 2 1 3\n3 3 1 2\n1 3 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n610038216\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 3\n1 2 1 2\n2 3 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8 5\n1 3 1 2\n1 5 1 6\n1 4 4 5\n5 5 1 7\n4 5 1 2\n4 5 2 5\n3 3 2 7\n1 2 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n94391813\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the probability is equal to $$$\\frac{5}{18}$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"2125D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2125/problem/D"}