{"assets":[],"contentKind":"statement","contestId":"814","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. An abandoned sentiment from past"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A few years ago, Hitagi encountered a giant crab, who stole the whole of her body weight. Ever since, she tried to avoid contact with others, for fear that this secret might be noticed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To get rid of the oddity and recover her weight, a special integer sequence is needed. Hitagi's sequence has been broken for a long time, but now Kaiki provides an opportunity."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Hitagi's sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" has a length of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Lost elements in it are denoted by zeros. Kaiki provides another sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", whose length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" equals the number of lost elements in "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" (i.e. the number of zeros). Hitagi is to replace each zero in "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" with an element from "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" so that "},{"children":[{"kind":"text","text":"each element in "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" should be used exactly once"}],"kind":"container"},{"kind":"text","text":". Hitagi knows, however, that, "},{"children":[{"kind":"text","text":"apart from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", no integer occurs in "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" more than once in total."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the resulting sequence is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" an increasing sequence, then it has the power to recover Hitagi from the oddity. You are to determine whether this is possible, or Kaiki's sequence is just another fake. In other words, you should detect whether it is possible to replace each zero in "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" with an integer from "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" so that each integer from "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is used exactly once, and the resulting sequence is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" increasing."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two space-separated positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":") — the lengths of sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 200"},{"kind":"text","text":") — Hitagi's broken sequence with exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" zero elements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"b1, b2, ..., bk"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ 200"},{"kind":"text","text":") — the elements to fill into Hitagi's sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Input guarantees that apart from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", no integer occurs in "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" more than once in total."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" if it's possible to replace zeros in "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" with elements in "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and make the resulting sequence not increasing, and \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n11 0 0 14\n5 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 1\n2 3 0 8 9 10\n5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n8 94 0 4\n89\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 7\n0 0 0 0 0 0 0\n1 2 3 4 5 6 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"11, 0, 0, 14"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Two of the elements are lost, and the candidates in "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There are two possible resulting sequences: "},{"kind":"math_inline","text":"11, 5, 4, 14"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"11, 4, 5, 14"},{"kind":"text","text":", both of which fulfill the requirements. Thus the answer is \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second sample, the only possible resulting sequence is "},{"kind":"math_inline","text":"2, 3, 5, 8, 9, 10"},{"kind":"text","text":", which is an increasing sequence and therefore invalid."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"814A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/814/problem/A"}