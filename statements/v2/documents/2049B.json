{"assets":[],"contentKind":"statement","contestId":"2049","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. pspspsps"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Cats are attracted to pspspsps, but Evirir, being a dignified dragon, is only attracted to pspspsps with oddly specific requirements..."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a string $$$s = s_1s_2\\ldots s_n$$$ of length $$$n$$$ consisting of characters "},{"children":[{"kind":"text","text":"p"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" (dot), determine whether a permutation$$$^{\\text{∗}}$$$ $$$p$$$ of length $$$n$$$ exists, such that for all integers $$$i$$$ ($$$1 \\le i \\le n$$$): "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If $$$s_i$$$ is "},{"children":[{"kind":"text","text":"p"}],"kind":"container"},{"kind":"text","text":", then $$$[p_1, p_2, \\ldots, p_i]$$$ forms a permutation (of length $$$i$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If $$$s_i$$$ is "},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":", then $$$[p_i, p_{i+1}, \\ldots, p_{n}]$$$ forms a permutation (of length $$$n-i+1$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If $$$s_i$$$ is "},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":", then there is no additional restriction. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$A permutation of length $$$n$$$ is an array consisting of $$$n$$$ distinct integers from $$$1$$$ to $$$n$$$ in arbitrary order. For example, $$$[2,3,1,5,4]$$$ is a permutation, but $$$[1,2,2]$$$ is not a permutation ($$$2$$$ appears twice in the array), and $$$[1,3,4]$$$ is also not a permutation ($$$n=3$$$ but there is $$$4$$$ in the array). "}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 500$$$), the length of $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$s$$$ of length $$$n$$$ that consists of the characters "},{"children":[{"kind":"text","text":"p"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$5000$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" on a line. Output "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" if there is such a permutation and "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output the answer in any case (upper or lower). For example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be recognized as positive responses."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n4\ns.sp\n6\npss..s\n5\nppppp\n2\nsp\n4\n.sp.\n8\npsss....\n1\n.\n8\npspspsps\n20\n....................\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\nYES\nYES\nNO\nNO\nYES\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first test case, one permutation that works is $$$p = [3, 4, 1, 2]$$$. The restrictions are as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$s_1 =$$$ "},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":": $$$[p_1, p_2, p_3, p_4] = [3, 4, 1, 2]$$$ forms a permutation. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s_2 =$$$ "},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":": No additional restriction. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s_3 =$$$ "},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":": $$$[p_3, p_4] = [1, 2]$$$ forms a permutation. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s_4 =$$$ "},{"children":[{"kind":"text","text":"p"}],"kind":"container"},{"kind":"text","text":": $$$[p_1, p_2, p_3, p_4] = [3, 4, 1, 2]$$$ forms a permutation. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For the second test case, it can be proven that there is no permutation that satisfies all restrictions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the third test case, one permutation that satisfies the constraints is $$$p = [1, 2, 3, 4, 5]$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"2049B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2049/problem/B"}