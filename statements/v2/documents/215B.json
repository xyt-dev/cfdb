{"assets":["/statement-assets/a43a1842509131a4c548b7006c4268741dc77f2be306a49b4354aee5fd0dabd5.png"],"contentKind":"statement","contestId":"215","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Olympic Medal"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The World Programming Olympics Medal is a metal disk, consisting of two parts: the first part is a ring with outer radius of "},{"kind":"math_inline","text":"r1"},{"kind":"text","text":" cm, inner radius of "},{"kind":"math_inline","text":"r2"},{"kind":"text","text":" cm, "},{"kind":"math_inline","text":"(0 < r2 < r1)"},{"kind":"text","text":" made of metal with density "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":" g/cm"},{"kind":"math_inline","text":"3"},{"kind":"text","text":". The second part is an inner disk with radius "},{"kind":"math_inline","text":"r2"},{"kind":"text","text":" cm, it is made of metal with density "},{"kind":"math_inline","text":"p2"},{"kind":"text","text":" g/cm"},{"kind":"math_inline","text":"3"},{"kind":"text","text":". The disk is nested inside the ring."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Olympic jury decided that "},{"kind":"math_inline","text":"r1"},{"kind":"text","text":" will take one of possible values of "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":". It is up to jury to decide which particular value "},{"kind":"math_inline","text":"r1"},{"kind":"text","text":" will take. Similarly, the Olympic jury decided that "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":" will take one of possible value of "},{"kind":"math_inline","text":"y1, y2, ..., ym"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"p2"},{"kind":"text","text":" will take a value from list "},{"kind":"math_inline","text":"z1, z2, ..., zk"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"According to most ancient traditions the ratio between the outer ring mass "},{"kind":"math_inline","text":"mout"},{"kind":"text","text":" and the inner disk mass "},{"kind":"math_inline","text":"min"},{"kind":"text","text":" must equal "},{"attrs":{"alt":"","src":"/statement-assets/a43a1842509131a4c548b7006c4268741dc77f2be306a49b4354aee5fd0dabd5.png"},"kind":"image"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"A, B"},{"kind":"text","text":" are constants taken from ancient books. Now, to start making medals, the jury needs to take values for "},{"kind":"math_inline","text":"r1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p2"},{"kind":"text","text":" and calculate the suitable value of "},{"kind":"math_inline","text":"r2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The jury wants to choose the value that would maximize radius "},{"kind":"math_inline","text":"r2"},{"kind":"text","text":". Help the jury find the sought value of "},{"kind":"math_inline","text":"r2"},{"kind":"text","text":". Value "},{"kind":"math_inline","text":"r2"},{"kind":"text","text":" doesn't have to be an integer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Medal has a uniform thickness throughout the area, the thickness of the inner disk is the same as the thickness of the outer ring."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and a sequence of integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":". The second input line contains an integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and a sequence of integers "},{"kind":"math_inline","text":"y1, y2, ..., ym"},{"kind":"text","text":". The third input line contains an integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and a sequence of integers "},{"kind":"math_inline","text":"z1, z2, ..., zk"},{"kind":"text","text":". The last line contains two integers "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All numbers given in the input are positive and do not exceed 5000. Each of the three sequences contains distinct numbers. The numbers in the lines are separated by spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single real number — the sought value "},{"kind":"math_inline","text":"r2"},{"kind":"text","text":" with absolute or relative error of at most "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":". It is guaranteed that the solution that meets the problem requirements exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 2 3\n1 2\n3 3 2 1\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2.683281573000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 3 6 4\n2 1 2\n3 10 6 8\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2.267786838055\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the jury should choose the following values: "},{"kind":"math_inline","text":"r1 = 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p1 = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p2 = 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"215B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/215/problem/B"}