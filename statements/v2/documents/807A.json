{"assets":[],"contentKind":"statement","contestId":"807","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Is it rated?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Is it rated?"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here it is. The Ultimate Question of Competitive Programming, Codeforces, and Everything. And you are here to answer it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Another Codeforces round has been conducted. No two participants have the same number of points. For each participant, from the top to the bottom of the standings, their rating before and after the round is known."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's known that if at least one participant's rating has changed, then the round was rated for sure."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's also known that if the round was rated and a participant with lower rating took a better place in the standings than a participant with higher rating, then at least one round participant's rating has changed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem, you should not make any other assumptions about the rating system."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine if the current round is rated, unrated, or it's impossible to determine whether it is rated of not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 1000"},{"kind":"text","text":") — the number of round participants."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ 4126"},{"kind":"text","text":") — the rating of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th participant before and after the round, respectively. The participants are listed in order from the top to the bottom of the standings."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the round is rated for sure, print \""},{"children":[{"kind":"text","text":"rated"}],"kind":"container"},{"kind":"text","text":"\". If the round is unrated for sure, print \""},{"children":[{"kind":"text","text":"unrated"}],"kind":"container"},{"kind":"text","text":"\". If it's impossible to determine whether the round is rated or not, print \""},{"children":[{"kind":"text","text":"maybe"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n3060 3060\n2194 2194\n2876 2903\n2624 2624\n3007 2991\n2884 2884\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"rated\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1500 1500\n1300 1300\n1200 1200\n1400 1400\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"unrated\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n3123 3123\n2777 2777\n2246 2246\n2246 2246\n1699 1699\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"maybe\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the ratings of the participants in the third and fifth places have changed, therefore, the round was rated."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, no one's rating has changed, but the participant in the second place has lower rating than the participant in the fourth place. Therefore, if the round was rated, someone's rating would've changed for sure."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, no one's rating has changed, and the participants took places in non-increasing order of their rating. Therefore, it's impossible to determine whether the round is rated or not."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"807A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/807/problem/A"}