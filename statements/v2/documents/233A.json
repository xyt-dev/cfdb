{"assets":[],"contentKind":"statement","contestId":"233","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Perfect Permutation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"permutation"}],"kind":"container"},{"kind":"text","text":" is a sequence of integers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct positive integers, each of them doesn't exceed "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Let's denote the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th element of permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":". We'll call number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" the size of permutation "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nickolas adores permutations. He likes some permutations more than the others. He calls such permutations perfect. A "},{"children":[{"kind":"text","text":"perfect"}],"kind":"container"},{"kind":"text","text":" permutation is such permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" that for any "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ n)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the permutation size) the following equations hold "},{"kind":"math_inline","text":"ppi = i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"pi ≠ i"},{"kind":"text","text":". Nickolas asks you to print any perfect permutation of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" for the given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the permutation size."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If a perfect permutation of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" doesn't exist, print a single integer -1. Otherwise print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" — permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", that is perfect. Separate printed numbers by whitespaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"}