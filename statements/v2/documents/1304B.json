{"assets":[],"contentKind":"statement","contestId":"1304","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Longest Palindrome"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Returning back to problem solving, Gildong is now studying about palindromes. He learned that a "},{"children":[{"kind":"text","text":"palindrome"}],"kind":"container"},{"kind":"text","text":" is a string that is the same as its reverse. For example, strings \""},{"children":[{"kind":"text","text":"pop"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"noon"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"kkkkkk"}],"kind":"container"},{"kind":"text","text":"\" are palindromes, while strings \""},{"children":[{"kind":"text","text":"moon"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"tv"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"abab"}],"kind":"container"},{"kind":"text","text":"\" are not. "},{"children":[{"kind":"text","text":"An empty string is also a palindrome."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Gildong loves this concept so much, so he wants to play with it. He has $$$n$$$ "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" strings of equal length $$$m$$$. He wants to discard some of the strings (possibly none or all) and reorder the remaining strings so that the concatenation becomes a palindrome. He also wants the palindrome to be as long as possible. Please help him find one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\le n \\le 100$$$, $$$1 \\le m \\le 50$$$) — the number of strings and the length of each string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$n$$$ lines contain a string of length $$$m$$$ each, consisting of lowercase Latin letters only. All strings are "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, print the length of the longest palindrome string you made."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line, print that palindrome. If there are multiple answers, print any one of them. If the palindrome is empty, print an empty line or don't print this line at all."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 3\ntab\none\nbat\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n6\ntabbat\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 2\noo\nox\nxo\nxx\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n6\noxxxxo\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 5\nhello\ncodef\norces\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n9 4\nabab\nbaba\nabcd\nbcde\ncdef\ndefg\nwxyz\nzyxw\nijji\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n20\nababwxyzijjizyxwbaba\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, \""},{"children":[{"kind":"text","text":"battab"}],"kind":"container"},{"kind":"text","text":"\" is also a valid answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, there can be 4 different valid answers including the sample output. We are not going to provide any hints for what the others are."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, the empty string is the only valid palindrome string."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1304B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1304/problem/B"}