{"assets":[],"contentKind":"statement","contestId":"370","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Berland Bingo"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Lately, a national version of a bingo game has become very popular in Berland. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" players playing the game, each player has a card with numbers. The numbers on each card are distinct, but distinct cards can have equal numbers. The card of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th player contains "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":" numbers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During the game the host takes numbered balls one by one from a bag. He reads the number aloud in a high and clear voice and then puts the ball away. All participants cross out the number if it occurs on their cards. The person who crosses out all numbers from his card first, wins. If multiple people cross out all numbers from their cards at the same time, there are no winners in the game. At the beginning of the game the bag contains 100 balls numbered 1 through 100, the numbers of all balls are distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the cards for each player. Write a program that determines whether a player can win the game at the most favorable for him scenario or not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of the players. Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each line describes a player's card. The line that describes a card starts from integer "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ mi ≤ 100"},{"kind":"text","text":") that shows how many numbers the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th player's card has. Then follows a sequence of integers "},{"kind":"math_inline","text":"ai, 1, ai, 2, ..., ai, mi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, k ≤ 100"},{"kind":"text","text":") — the numbers on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th player's card. The numbers in the lines are separated by single spaces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all the numbers on each card are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line must contain word \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th player can win, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1\n3 2 4 1\n2 10 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nNO\nYES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"370B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/370/problem/B"}