{"assets":[],"contentKind":"statement","contestId":"514","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Watto and Mechanism"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Watto, the owner of a spare parts store, has recently got an order for the mechanism that can process strings in a certain way. Initially the memory of the mechanism is filled with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" strings. Then the mechanism should be able to process queries of the following type: \"Given string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", determine if the memory of the mechanism contains string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" that consists of the same number of characters as "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and differs from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" in exactly one position\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Watto has already compiled the mechanism, all that's left is to write a program for it and check it on the data consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" initial lines and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries. He decided to entrust this job to you."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two non-negative numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ n ≤ 3·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ m ≤ 3·105"},{"kind":"text","text":") — the number of the initial strings and the number of queries, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" non-empty strings that are uploaded to the memory of the mechanism."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next follow "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" non-empty strings that are the queries to the mechanism."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The total length of lines in the input doesn't exceed "},{"kind":"math_inline","text":"6·105"},{"kind":"text","text":". Each line consists "},{"children":[{"kind":"text","text":"only"}],"kind":"container"},{"kind":"text","text":" of letters "},{"children":[{"kind":"text","text":"'a'"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"'b'"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"'c'"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query print on a single line \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if the memory of the mechanism contains the required string, otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\naaaaa\nacacaca\naabaa\nccacacc\ncaaac\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nNO\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"514C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/514/problem/C"}