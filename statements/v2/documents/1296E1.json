{"assets":[],"contentKind":"statement","contestId":"1296","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E1. String Coloring (easy version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is an easy version of the problem. The actual problems are different, but the easy version is almost a subtask of the hard version. Note that the constraints and the output format are different"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string $$$s$$$ consisting of $$$n$$$ lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to color "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" its characters "},{"children":[{"kind":"text","text":"one of the two colors"}],"kind":"container"},{"kind":"text","text":" (each character to exactly one color, the same letters can be colored the same or different colors, i.e. you can choose exactly one color for each index in $$$s$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After coloring, you can swap "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" two neighboring characters of the string that are colored "},{"children":[{"kind":"text","text":"different"}],"kind":"container"},{"kind":"text","text":" colors. You can perform such an operation arbitrary (possibly, zero) number of times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The goal is to make the string sorted, i.e. all characters should be in alphabetical order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to say if it is possible to color the given string so that after coloring it can become sorted by "},{"children":[{"kind":"text","text":"some"}],"kind":"container"},{"kind":"text","text":" sequence of swaps. Note that you have to restore only coloring, not the sequence of swaps."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$n$$$ ($$$1 \\le n \\le 200$$$) — the length of $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains the string $$$s$$$ consisting of exactly $$$n$$$ lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is impossible to color the given string so that after coloring it can become sorted by "},{"children":[{"kind":"text","text":"some"}],"kind":"container"},{"kind":"text","text":" sequence of swaps, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in the first line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" in the first line and "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" correct coloring in the second line (the coloring is the string consisting of $$$n$$$ characters, the $$$i$$$-th character should be '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' if the $$$i$$$-th character is colored the first color and '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' otherwise)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n9\nabacbecfd\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n001010101\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8\naaabbcbb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n01011011\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\nabcdedc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\nabcde\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n00000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E1","problemCode":"1296E1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1296/problem/E1"}