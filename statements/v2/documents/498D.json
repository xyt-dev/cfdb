{"assets":[],"contentKind":"statement","contestId":"498","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Traffic Jams in the Land"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Some country consists of "},{"kind":"math_inline","text":"(n + 1)"},{"kind":"text","text":" cities, located along a straight highway. Let's number the cities with consecutive integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n + 1"},{"kind":"text","text":" in the order they occur along the highway. Thus, the cities are connected by "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" segments of the highway, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th segment connects cities number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":". Every segment of the highway is associated with a positive integer "},{"kind":"math_inline","text":"ai > 1"},{"kind":"text","text":" — the period of traffic jams appearance on it. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In order to get from city "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"x < y"},{"kind":"text","text":"), some drivers use the following tactics. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially the driver is in city "},{"kind":"math_inline","text":"x"},{