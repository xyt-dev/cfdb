{"assets":[],"contentKind":"statement","contestId":"1189","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Keanu Reeves"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After playing Neo in the legendary \""},{"children":[{"kind":"text","text":"Matrix"}],"kind":"container"},{"kind":"text","text":"\" trilogy, Keanu Reeves started doubting himself: maybe we really live in virtual reality? To find if this is true, he needs to solve the following problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a string consisting of only zeroes and ones "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if it contains "},{"children":[{"kind":"text","text":"different"}],"kind":"container"},{"kind":"text","text":" numbers of zeroes and ones. For example, "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"101"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"0000"}],"kind":"container"},{"kind":"text","text":" are good, while "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1001"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"111000"}],"kind":"container"},{"kind":"text","text":" are not good."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We are given a string $$$s$$$ of length $$$n$$$ consisting of only zeroes and ones. We need to cut $$$s$$$ into "},{"children":[{"kind":"text","text":"minimal possible"}],"kind":"container"},{"kind":"text","text":" number of substrings $$$s_1, s_2, \\ldots, s_k$$$ such that "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" of them are good. More formally, we have to find "},{"children":[{"kind":"text","text":"minimal"}],"kind":"container"},{"kind":"text","text":" by number of strings sequence of good strings $$$s_1, s_2, \\ldots, s_k$$$ such that their concatenation (joining) equals $$$s$$$, i.e. $$$s_1 + s_2 + \\dots + s_k = s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, cuttings "},{"children":[{"kind":"text","text":"110010"}],"kind":"container"},{"kind":"text","text":" into "},{"children":[{"kind":"text","text":"110"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"010"}],"kind":"container"},{"kind":"text","text":" or into "},{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"0010"}],"kind":"container"},{"kind":"text","text":" are valid, as "},{"children":[{"kind":"text","text":"110"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"010"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"0010"}],"kind":"container"},{"kind":"text","text":" are all good, and we can't cut "},{"children":[{"kind":"text","text":"110010"}],"kind":"container"},{"kind":"text","text":" to the smaller number of substrings as "},{"children":[{"kind":"text","text":"110010"}],"kind":"container"},{"kind":"text","text":" isn't good itself. At the same time, cutting of "},{"children":[{"kind":"text","text":"110010"}],"kind":"container"},{"kind":"text","text":" into "},{"children":[{"kind":"text","text":"1100"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" isn't valid as both strings aren't good. Also, cutting of "},{"children":[{"kind":"text","text":"110010"}],"kind":"container"},{"kind":"text","text":" into "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"0010"}],"kind":"container"},{"kind":"text","text":" isn't valid, as it isn't minimal, even though all $$$3$$$ strings are good."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Can you help Keanu? We can show that the solution always exists. If there are multiple optimal answers, print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer $$$n$$$ ($$$1\\le n \\le 100$$$) — the length of the string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string $$$s$$$ of length $$$n$$$ consisting only from zeros and ones."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, output a single integer $$$k$$$ ($$$1\\le k$$$) — a "},{"children":[{"kind":"text","text":"minimal"}],"kind":"container"},{"kind":"text","text":" number of strings you have cut $$$s$$$ into."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line, output $$$k$$$ strings $$$s_1, s_2, \\ldots, s_k$$$ separated with spaces. The length of each string has to be positive. Their concatenation has to be equal to $$$s$$$ and all of them have to be good."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n1 0"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n100011\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n100 011\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the string "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" wasn't cut at all. As it is good, the condition is satisfied."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" both are good. As "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" isn't good, the answer is indeed minimal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, "},{"children":[{"kind":"text","text":"100"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"011"}],"kind":"container"},{"kind":"text","text":" both are good. As "},{"children":[{"kind":"text","text":"100011"}],"kind":"container"},{"kind":"text","text":" isn't good, the answer is indeed minimal."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1189A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1189/problem/A"}