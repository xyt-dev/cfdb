{"assets":["/statement-assets/63c3e469febe4b0e6c8295bd7dc943107eb858bd00c1c8c53ab43e494c3743d3.png","/statement-assets/a42986ad25229576bc0eaee97f6f51f0acf1ce6b73450885666c171c9ef204d2.png","/statement-assets/04f079a0aecd9448fc3075ab2b19915013b0367f82239b8c8f3b974db83eaed4.png","/statement-assets/e21c8db42ecc96f5c3627112a1b1d403cf33ccb0bf15ec4f95b64941582ca78b.png","/statement-assets/62d28d5b06fd84210d2d1b1152ffe184cfbaad0c775682a384f6750126d7d7e1.png","/statement-assets/e7e529d90db5fa3f10f6939ff01c73968b010a20a732a17b9a0eadbec259c229.png","/statement-assets/f836d2d7b04af3ca1abf0d3d371e5ecebef14dd73ba0640838f011533a3f5e20.png"],"contentKind":"statement","contestId":"165","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Burning Midnight Oil"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day a highly important task was commissioned to Vasya — writing a program in a night. The program consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines of code. Vasya is already exhausted, so he works like that: first he writes "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" lines of code, drinks a cup of tea, then he writes as much as "},{"attrs":{"alt":"","src":"/statement-assets/63c3e469febe4b0e6c8295bd7dc943107eb858bd00c1c8c53ab43e494c3743d3.png"},"kind":"image"},{"kind":"text","text":" lines, drinks another cup of tea, then he writes "},{"attrs":{"alt":"","src":"/statement-assets/a42986ad25229576bc0eaee97f6f51f0acf1ce6b73450885666c171c9ef204d2.png"},"kind":"image"},{"kind":"text","text":" lines and so on: "},{"attrs":{"alt":"","src":"/statement-assets/04f079a0aecd9448fc3075ab2b19915013b0367f82239b8c8f3b974db83eaed4.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/e21c8db42ecc96f5c3627112a1b1d403cf33ccb0bf15ec4f95b64941582ca78b.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/62d28d5b06fd84210d2d1b1152ffe184cfbaad0c775682a384f6750126d7d7e1.png"},"kind":"image"},{"kind":"text","text":", ..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The expression "},{"attrs":{"alt":"","src":"/statement-assets/e7e529d90db5fa3f10f6939ff01c73968b010a20a732a17b9a0eadbec259c229.png"},"kind":"image"},{"kind":"text","text":" is regarded as the integral part from dividing number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" by number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The moment the current value "},{"attrs":{"alt":"","src":"/statement-assets/f836d2d7b04af3ca1abf0d3d371e5ecebef14dd73ba0640838f011533a3f5e20.png"},"kind":"image"},{"kind":"text","text":" equals 0, Vasya immediately falls asleep and he wakes up only in the morning, when the program should already be finished."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya is wondering, what minimum allowable value "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" can take to let him write "},{"children":[{"kind":"text","text":"not less"}],"kind":"container"},{"kind":"text","text":" than "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines of code before he falls asleep."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", separated by spaces — the size of the program in lines and the productivity reduction coefficient, "},{"kind":"math_inline","text":"1 ≤ n ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ k ≤ 10"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer — the minimum value of "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" that lets Vasya write the program in one night."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"59 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"54\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the answer is "},{"kind":"math_inline","text":"v = 4"},{"kind":"text","text":". Vasya writes the code in the following portions: first "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" lines, then "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", and then Vasya falls asleep. Thus, he manages to write "},{"kind":"math_inline","text":"4 + 2 + 1 = 7"},{"kind":"text","text":" lines in a night and complete the task."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the answer is "},{"kind":"math_inline","text":"v = 54"},{"kind":"text","text":". Vasya writes the code in the following portions: "},{"kind":"math_inline","text":"54"},{"kind":"text","text":", "},{"kind":"math_inline","text":"6"},{"kind":"text","text":". The total sum is "},{"kind":"math_inline","text":"54 + 6 = 60"},{"kind":"text","text":", that's even more than "},{"kind":"math_inline","text":"n = 59"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"165B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/165/problem/B"}