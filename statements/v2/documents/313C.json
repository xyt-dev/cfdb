{"assets":[],"contentKind":"statement","contestId":"313","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Ilya and Matrix"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ilya is a very good-natured lion. He likes maths. Of all mathematical objects, his favourite one is matrices. Now he's faced a complicated matrix problem he needs to solve."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He's got a square "},{"kind":"math_inline","text":"2n × 2n"},{"kind":"text","text":"-sized matrix and "},{"kind":"math_inline","text":"4n"},{"kind":"text","text":" integers. You need to arrange all these numbers in the matrix (put each number in a single individual cell) so that the "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" of the resulting matrix with numbers is maximum."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" of a "},{"kind":"math_inline","text":"2n × 2n"},{"kind":"text","text":"-sized matrix is an integer, obtained by the following algorithm:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Find the maximum element in the matrix. Let's denote it as "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"n = 0"},{"kind":"text","text":", then the beauty of the matrix equals "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Otherwise, a matrix can be split into 4 non-intersecting "},{"kind":"math_inline","text":"2n - 1 × 2n - 1"},{"kind":"text","text":"-sized submatrices, then the beauty of the matrix equals the sum of number "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and other four beauties of the described submatrices. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"As you can see, the algorithm is recursive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Ilya, solve the problem and print the resulting maximum beauty of the matrix."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"4n"},{"kind":"math_inline","text":"(1 ≤ 4n ≤ 2·106)"},{"kind":"text","text":". The next line contains "},{"kind":"math_inline","text":"4n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 109)"},{"kind":"text","text":" — the numbers you need to arrange in the "},{"kind":"math_inline","text":"2n × 2n"},{"kind":"text","text":"-sized matrix."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On a single line print the maximum value of the beauty of the described matrix."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n13\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the second sample. You need to arrange the numbers in the matrix as follows:"}],"kind":"paragraph"},{"kind":"code_block","text":"\n1 2\n3 4\n"},{"children":[{"kind":"text","text":"Then the beauty of the matrix will equal: 4 + 1 + 2 + 3 + 4 = 14."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"313C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/313/problem/C"}