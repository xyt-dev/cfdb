{"assets":["/statement-assets/d0ca1eb461e2a61fb2b1e7ce6d04293ebaf8f3f2f74a4c1c8cb1bcaa22c42703.png","/statement-assets/234b6a83639be86fb042a5f20c634173ed3bdbbba88aeb3923832c9634c44732.png"],"contentKind":"statement","contestId":"527","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Playing with Paper"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day Vasya was sitting on a not so interesting Maths lesson and making an origami from a rectangular "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" mm "},{"kind":"math_inline","text":" × "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" mm sheet of paper ("},{"kind":"math_inline","text":"a > b"},{"kind":"text","text":"). Usually the first step in making an origami is making a square piece of paper from the rectangular sheet by folding the sheet along the bisector of the right angle, and cutting the excess part."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d0ca1eb461e2a61fb2b1e7ce6d04293ebaf8f3f2f74a4c1c8cb1bcaa22c42703.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"After making a paper ship from the square piece, Vasya looked on the remaining "},{"kind":"math_inline","text":"(a - b)"},{"kind":"text","text":" mm "},{"kind":"math_inline","text":" × "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" mm strip of paper. He got the idea to use this strip of paper in the same way to make an origami, and then use the remainder (if it exists) and so on. At the moment when he is left with a square piece of paper, he will make the last ship from it and stop."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Can you determine how many ships Vasya will make during the lesson?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ b < a ≤ 1012"},{"kind":"text","text":") — the sizes of the original sheet of paper."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of ships that Vasya will make."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1000000000000 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1000000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Pictures to the first and second sample test."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/234b6a83639be86fb042a5f20c634173ed3bdbbba88aeb3923832c9634c44732.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"527A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/527/problem/A"}