{"assets":[],"contentKind":"statement","contestId":"534","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Covered Path"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The on-board computer on Polycarp's car measured that the car speed at the beginning of some section of the path equals "},{"kind":"math_inline","text":"v1"},{"kind":"text","text":" meters per second, and in the end it is "},{"kind":"math_inline","text":"v2"},{"kind":"text","text":" meters per second. We know that this section of the route took exactly "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" seconds to pass."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Assuming that at each of the seconds the speed is constant, and between seconds the speed can change at most by "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" meters per second in absolute value (i.e., the difference in the speed of any two adjacent seconds does not exceed "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" in absolute value), find the maximum possible length of the path section in meters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"v1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v1, v2 ≤ 100"},{"kind":"text","text":") — the speeds in meters per second at the beginning of the segment and at the end of the segment, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains two integers "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ t ≤ 100"},{"kind":"text","text":") — the time when the car moves along the segment in seconds, "},{"kind":"math_inline","text":"d"},{"children":[{"kind":"math_inline","text":"(0 ≤ d ≤ 10)"}],"kind":"container"},{"kind":"text","text":" — the maximum value of the speed change between adjacent seconds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there is a way to complete the segment so that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the speed in the first second equals "},{"kind":"math_inline","text":"v1"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the speed in the last second equals "},{"kind":"math_inline","text":"v2"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the absolute value of difference of speeds between any two adjacent seconds doesn't exceed "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum possible length of the path segment in meters. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6\n4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"26"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 10\n10 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"100"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the sequence of speeds of Polycarpus' car can look as follows: 5, 7, 8, 6. Thus, the total path is "},{"kind":"math_inline","text":"5 + 7 + 8 + 6 = 26"},{"kind":"text","text":" meters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, as "},{"kind":"math_inline","text":"d = 0"},{"kind":"text","text":", the car covers the whole segment at constant speed "},{"kind":"math_inline","text":"v = 10"},{"kind":"text","text":". In "},{"kind":"math_inline","text":"t = 10"},{"kind":"text","text":" seconds it covers the distance of 100 meters."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"534B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/534/problem/B"}