{"assets":[],"contentKind":"statement","contestId":"238","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Boring Partition"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"This problem is the most boring one you've ever seen. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a sequence of integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" and a non-negative integer "},{"kind":"math_inline","text":"h"},{"kind":"text","text":", our goal is to partition the sequence into two subsequences (not necessarily consist of continuous elements). Each element of the original sequence should be contained in exactly one of the result subsequences. Note, that one of the result subsequences can be empty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define function "},{"kind":"math_inline","text":"f(ai, aj)"},{"kind":"text","text":" on pairs of distinct elements (that is "},{"kind":"math_inline","text":"i ≠ j"},{"kind":"text","text":") in the original sequence. If "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"aj"},{"kind":"text","text":" are in the same subsequence in the current partition then "},{"kind":"math_inline","text":"f(ai, aj) = ai + aj"},{"kind":"text","text":" otherwise "},{"kind":"math_inline","text":"f(ai, aj) = ai + aj + h"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider all possible values of the function "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" for some partition. We'll call the "},{"children":[{"kind":"text","text":"goodness"}],"kind":"container"},{"kind":"text","text":" of this partiotion the difference between the maximum value of function "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" and the minimum value of function "},{"kind":"math_inline","text":"f"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find a partition of the given sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" that have the minimal possible goodness among all possible partitions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"h"},{"kind":"math_inline","text":"(2 ≤ n ≤ 105, 0 ≤ h ≤ 108)"},{"kind":"text","text":". In the second line there is a list of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers representing "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(0 ≤ ai ≤ 108)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of output should contain the required minimum goodness. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line describes the optimal partition. You should print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" whitespace-separated integers in the second line. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th integer is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" if "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is in the first subsequence otherwise it should be "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several possible correct answers you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1 2 2 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 10\n0 1 0 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 2 2 2 2 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the values of "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" are as follows: "},{"kind":"math_inline","text":"f(1, 2) = 1 + 2 + 2 = 5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f(1, 3) = 1 + 3 + 2 = 6"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"f(2, 3) = 2 + 3 = 5"},{"kind":"text","text":". So the difference between maximum and minimum values of "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the value of "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" is large, so it's better for one of the sub-sequences to be empty."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"238B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/238/problem/B"}