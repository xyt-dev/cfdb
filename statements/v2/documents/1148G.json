{"assets":[],"contentKind":"statement","contestId":"1148","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Gold Experience"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider an undirected graph $$$G$$$ with $$$n$$$ vertices. There is a value $$$a_i$$$ in each vertex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two vertices $$$i$$$ and $$$j$$$ are connected with an edge if and only if $$$gcd(a_i, a_j) \\gt 1$$$, where $$$gcd(x, y)$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Greatest_common_divisor"},"children":[{"kind":"text","text":"greatest common divisor (GCD)"}],"kind":"link"},{"kind":"text","text":" of integers $$$x$$$ and $$$y$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider a set of vertices. Let's call a vertex in this set "},{"children":[{"kind":"text","text":"fair"}],"kind":"container"},{"kind":"text","text":" if it is connected with an edge with all other vertices in this set."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to find a set of $$$k$$$ vertices (where $$$k$$$ is a given integer, $$$2 \\cdot k \\le n$$$) where all vertices are fair or all vertices are not fair. One can show that such a set always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers $$$n$$$ and $$$k$$$ ($$$6 \\leq 2 \\cdot k \\leq n \\leq 10^5$$$) — the number of vertices and parameter $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$2 \\le a_i \\le 10^7$$$) — the values in the vertices."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print exactly $$$k$$$ distinct integers — the indices of the vertices in the chosen set in any order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6 3\n6 15 10 8 14 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 3 6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8 4\n11 15 10 6 21 15 10 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 2 3 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10 5\n3003 17017 3230 49742 546 41990 17765 570 21945 36465\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4 6 9 10 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, set $$$\\{2, 4, 5\\}$$$ is an example of set where no vertices are "},{"children":[{"kind":"text","text":"fair"}],"kind":"container"},{"kind":"text","text":". The vertex $$$2$$$ does not share an edge with vertex $$$4$$$ since $$$gcd(15, 8) = 1$$$. The vertex $$$4$$$ does not share an edge with vertex $$$2$$$. The vertex $$$5$$$ does not share an edge with vertex $$$2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, set $$$\\{8, 5, 6, 4\\}$$$ is an example of a set where all vertices are "},{"children":[{"kind":"text","text":"fair"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1148G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1148/problem/G"}