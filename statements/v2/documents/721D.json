{"assets":["/statement-assets/3e21a42693c4661c9c0f3b43a2a8621751bfa309b0e64248bfd52542567bcb7c.png","/statement-assets/d4e065f934bdd7371d5e61834d1c17283b632323ce33902e10d618848a0968db.png","/statement-assets/afa9c8badb963eec975e0490e271c4a2e172063f164ef5c22f1ad614fee53810.png"],"contentKind":"statement","contestId":"721","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Maxim and Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recently Maxim has found an array of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, needed by no one. He immediately come up with idea of changing it: he invented positive integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and decided to add or subtract it from arbitrary array elements. Formally, by applying single operation Maxim chooses integer "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") and replaces the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th element of array "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" either with "},{"kind":"math_inline","text":"ai + x"},{"kind":"text","text":" or with "},{"kind":"math_inline","text":"ai - x"},{"kind":"text","text":". Please note that the operation may be applied more than once to the same position."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Maxim is a curious minimalis, thus he wants to know what is the minimum value that the product of all array elements (i.e. "},{"attrs":{"alt":"","src":"/statement-assets/3e21a42693c4661c9c0f3b43a2a8621751bfa309b0e64248bfd52542567bcb7c.png"},"kind":"image"},{"kind":"text","text":") can reach, if Maxim would apply no more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" operations to it. Please help him in that."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n, k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, k ≤ 200 000, 1 ≤ x ≤ 109"},{"kind":"text","text":") — the number of elements in the array, the maximum number of operations and the number invented by Maxim, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/d4e065f934bdd7371d5e61834d1c17283b632323ce33902e10d618848a0968db.png"},"kind":"image"},{"kind":"text","text":") — the elements of the array found by Maxim."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" in the only line — the array elements after applying no more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" operations to the array. In particular, "},{"attrs":{"alt":"","src":"/statement-assets/afa9c8badb963eec975e0490e271c4a2e172063f164ef5c22f1ad614fee53810.png"},"kind":"image"},{"kind":"text","text":" should stay true for every "},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":", but the product of all array elements should be "},{"children":[{"kind":"text","text":"minimum possible"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3 1\n5 4 3 5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5 4 3 5 -1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3 1\n5 4 3 5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5 4 0 5 5 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3 1\n5 4 4 5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5 1 4 5 5 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 7\n5 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5 11 -5 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"721D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/721/problem/D"}