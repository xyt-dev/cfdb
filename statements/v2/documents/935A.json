{"assets":[],"contentKind":"statement","contestId":"935","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Fafa and his Company"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Fafa owns a company that works on huge projects. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" employees in Fafa's company. Whenever the company has a new project to start working on, Fafa has to divide the tasks of this project among all the employees."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Fafa finds doing this every time is very tiring for him. So, he decided to choose the best "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" employees in his company as team leaders. Whenever there is a new project, Fafa will divide the tasks among only the team leaders and each team leader will be responsible of some positive number of employees to give them the tasks. To make this process fair for the team leaders, each one of them should be responsible for the same number of employees. Moreover, every employee, who is not a team leader, has to be under the responsibility of exactly one team leader, and no team leader is responsible for another team leader."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the number of employees "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", find in how many ways Fafa could choose the number of team leaders "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" in such a way that it is possible to divide employees between them evenly."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of a single line containing a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":") — the number of employees in Fafa's company."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer representing the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second sample Fafa has 3 ways:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" choose only "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" employee as a team leader with "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" employees under his responsibility. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" choose "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" employees as team leaders with "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" employees under the responsibility of each of them. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" choose "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" employees as team leaders with "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" employee under the responsibility of each of them. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"935A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/935/problem/A"}