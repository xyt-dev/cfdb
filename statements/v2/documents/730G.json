{"assets":[],"contentKind":"statement","contestId":"730","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Car Repair Shop"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp starts his own business. Tomorrow will be the first working day of his car repair shop. For now the car repair shop is very small and only one car can be repaired at a given time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp is good at marketing, so he has already collected "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" requests from clients. The requests are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in order they came."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th request is characterized by two values: "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" — the day when a client wants to start the repair of his car, "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" — duration (in days) to repair the car. The days are enumerated from 1, the first day is tomorrow, the second day is the day after tomorrow and so on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp is making schedule by processing requests in the order from the first to the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th request. He schedules the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th request as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If the car repair shop is idle for "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" days starting from "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"si, si + 1, ..., si + di - 1"},{"kind":"text","text":"), then these days are used to repair a car of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th client. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Otherwise, Polycarp finds the first day "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" (from 1 and further) that there are "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" subsequent days when no repair is scheduled starting from "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". In other words he chooses the smallest positive "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" that all days "},{"kind":"math_inline","text":"x, x + 1, ..., x + di - 1"},{"kind":"text","text":" are not scheduled for repair of any car. So, the car of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th client will be repaired in the range "},{"kind":"math_inline","text":"[x, x + di - 1]"},{"kind":"text","text":". It is possible that the day "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" when repair is scheduled to start will be less than "},{"kind":"math_inline","text":"si"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" requests, you are asked to help Polycarp schedule all of them according to the rules above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200"},{"kind":"text","text":") — the number of requests from clients."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain requests, one request per line. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th request is given as the pair of integers "},{"kind":"math_inline","text":"si, di"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ si ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ di ≤ 5·106"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" is the preferred time to start repairing the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th car, "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" is the number of days to repair the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th car."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The requests should be processed in the order they are given in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line should contain two integers — the start day to repair the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th car and the finish day to repair the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th car."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n9 2\n7 3\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9 10\n1 3\n4 7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1000000000 1000000\n1000000000 1000000\n100000000 1000000\n1000000000 1000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1000000000 1000999999\n1 1000000\n100000000 100999999\n1000001 2000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"730G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/730/problem/G"}