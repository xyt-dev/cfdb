{"assets":[],"contentKind":"statement","contestId":"60","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Savior"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Misha decided to help Pasha and Akim be friends again. He had a cunning plan — to destroy all the laughy mushrooms. He knows that the laughy mushrooms can easily burst when they laugh. Mushrooms grow on the lawns. There are "},{"kind":"math_inline","text":"a[t]"},{"kind":"text","text":" mushrooms on the "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"-th lawn."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Misha knows that the lawns where the mushrooms grow have a unique ability. A lawn (say, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":") can transfer laugh to other lawn (say, "},{"kind":"math_inline","text":"j"},{"kind":"text","text":") if there exists an integer (say, "},{"kind":"math_inline","text":"b"},{"kind":"text","text":") such, that some permutation of numbers "},{"kind":"math_inline","text":"a[i], a[j]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is a "},{"children":[{"kind":"text","text":"beautiful triple"}],"kind":"container"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"i ≠ j"},{"kind":"text","text":"). A beautiful triple is such three pairwise coprime numbers "},{"kind":"math_inline","text":"x, y, z"},{"kind":"text","text":", which satisfy the following condition: "},{"kind":"math_inline","text":"x2 + y2 = z2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Misha wants to know on which minimal number of lawns he should laugh for all the laughy mushrooms to burst."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":") which is the number of lawns. The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" which are the number of mushrooms on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-lawn ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 107"},{"kind":"text","text":"). All the numbers are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the minimal number of lawns on which Misha should laugh for all the mushrooms to burst."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"60D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/60/problem/D"}