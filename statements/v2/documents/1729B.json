{"assets":[],"contentKind":"statement","contestId":"1729","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Decode String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp has a string $$$s$$$ consisting of lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He encodes it using the following algorithm."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He goes through the letters of the string $$$s$$$ from left to right and for each letter Polycarp considers its number in the alphabet:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if the letter number is single-digit number (less than $$$10$$$), then just writes it out; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if the letter number is a two-digit number (greater than or equal to $$$10$$$), then it writes it out and adds the number "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" after. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, if the string $$$s$$$ is "},{"children":[{"kind":"text","text":"code"}],"kind":"container"},{"kind":"text","text":", then Polycarp will encode this string as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"' — is the $$$3$$$-rd letter of the alphabet. Consequently, Polycarp adds "},{"children":[{"kind":"text","text":"3"}],"kind":"container"},{"kind":"text","text":" to the code (the code becomes equal to "},{"children":[{"kind":"text","text":"3"}],"kind":"container"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"' — is the $$$15$$$-th letter of the alphabet. Consequently, Polycarp adds "},{"children":[{"kind":"text","text":"15"}],"kind":"container"},{"kind":"text","text":" to the code and also "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" (the code becomes "},{"children":[{"kind":"text","text":"3150"}],"kind":"container"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":"' — is the $$$4$$$-th letter of the alphabet. Consequently, Polycarp adds "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" to the code (the code becomes "},{"children":[{"kind":"text","text":"31504"}],"kind":"container"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"' — is the $$$5$$$-th letter of the alphabet. Therefore, Polycarp adds "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":" to the code (the code becomes "},{"children":[{"kind":"text","text":"315045"}],"kind":"container"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Thus, code of string "},{"children":[{"kind":"text","text":"code"}],"kind":"container"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"315045"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string $$$t$$$ resulting from encoding the string $$$s$$$. Your task is to decode it (get the original string $$$s$$$ by $$$t$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer $$$q$$$ ($$$1 \\le q \\le 10^4$$$) — the number of test cases in the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The descriptions of the test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of description of each test case contains one integer $$$n$$$ ($$$1 \\le n \\le 50$$$) — the length of the given code."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the description of each test case contains a string $$$t$$$ of length $$$n$$$ — the given code. It is guaranteed that there exists such a string of lowercase Latin letters, as a result of encoding which the string $$$t$$$ is obtained."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case output the required string $$$s$$$ — the string that gives string $$$t$$$ as the result of encoding. It is guaranteed that such a string always exists. It can be shown that such a string is always unique."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n6\n315045\n4\n1100\n7\n1213121\n6\n120120\n18\n315045615018035190\n7\n1111110\n7\n1111100\n5\n11111\n4\n2606\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\ncode\naj\nabacaba\nll\ncodeforces\naaaak\naaaaj\naaaaa\nzf\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test case is explained above."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the answer is "},{"children":[{"kind":"text","text":"aj"}],"kind":"container"},{"kind":"text","text":". Indeed, the number of the letter "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" is equal to $$$1$$$, so "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" will be appended to the code. The number of the letter "},{"children":[{"kind":"text","text":"j"}],"kind":"container"},{"kind":"text","text":" is $$$10$$$, so "},{"children":[{"kind":"text","text":"100"}],"kind":"container"},{"kind":"text","text":" will be appended to the code. The resulting code is "},{"children":[{"kind":"text","text":"1100"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are no zeros in the third test case, which means that the numbers of all letters are less than $$$10$$$ and are encoded as one digit. The original string is "},{"children":[{"kind":"text","text":"abacaba"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, the string $$$s$$$ is equal to "},{"children":[{"kind":"text","text":"ll"}],"kind":"container"},{"kind":"text","text":". The letter "},{"children":[{"kind":"text","text":"l"}],"kind":"container"},{"kind":"text","text":" has the number $$$12$$$ and is encoded as "},{"children":[{"kind":"text","text":"120"}],"kind":"container"},{"kind":"text","text":". So "},{"children":[{"kind":"text","text":"ll"}],"kind":"container"},{"kind":"text","text":" is indeed "},{"children":[{"kind":"text","text":"120120"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1729B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1729/problem/B"}