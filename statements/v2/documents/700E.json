{"assets":[],"contentKind":"statement","contestId":"700","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Cool Slogans"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bomboslav set up a branding agency and now helps companies to create new logos and advertising slogans. In term of this problems, "},{"children":[{"kind":"text","text":"slogan"}],"kind":"container"},{"kind":"text","text":" of the company should be a non-empty substring of its name. For example, if the company name is \""},{"children":[{"kind":"text","text":"hornsandhoofs"}],"kind":"container"},{"kind":"text","text":"\", then substrings \""},{"children":[{"kind":"text","text":"sand"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"hor"}],"kind":"container"},{"kind":"text","text":"\" could be its slogans, while strings \""},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"hornss"}],"kind":"container"},{"kind":"text","text":"\" can not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sometimes the company performs rebranding and changes its slogan. Slogan "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is considered to be "},{"children":[{"kind":"text","text":"cooler"}],"kind":"container"},{"kind":"text","text":" than slogan "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" if "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" appears in "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" as a substring "},{"children":[{"kind":"text","text":"at least twice"}],"kind":"container"},{"kind":"text","text":" (this occurrences are allowed to overlap). For example, slogan "},{"kind":"math_inline","text":"A = "},{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"abacaba"}],"kind":"container"},{"kind":"text","text":"\" is cooler than slogan "},{"kind":"math_inline","text":"B = "},{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":"\", slogan "},{"kind":"math_inline","text":"A = "},{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"abcbcbe"}],"kind":"container"},{"kind":"text","text":"\" is cooler than slogan "},{"kind":"math_inline","text":"B = "},{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"bcb"}],"kind":"container"},{"kind":"text","text":"\", but slogan "},{"kind":"math_inline","text":"A = "},{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"aaaaaa"}],"kind":"container"},{"kind":"text","text":"\" is not cooler than slogan "},{"kind":"math_inline","text":"B = "},{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the company name "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" and your task is to help Bomboslav determine the length of the longest sequence of slogans "},{"kind":"math_inline","text":"s1, s2, ..., sk"},{"kind":"text","text":", such that any slogan in the sequence is cooler than the previous one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000"},{"kind":"text","text":") — the length of the company name that asks Bomboslav to help. The second line contains the string "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", that consists of lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maximum possible length of the sequence of slogans of the company named "},{"kind":"math_inline","text":"w"},{"kind":"text","text":", such that any slogan in the sequence (except the first one) is cooler than the previous"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nabc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nddddd\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11\nabracadabra\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"700E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/700/problem/E"}