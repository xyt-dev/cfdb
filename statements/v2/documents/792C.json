{"assets":[],"contentKind":"statement","contestId":"792","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Divide by Three"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A positive integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is written on a blackboard. It consists of not more than "},{"kind":"math_inline","text":"105"},{"kind":"text","text":" digits. You have to transform it into a "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" number by erasing some of the digits, and you want to erase as few digits as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The number is called beautiful if it consists of at least one digit, doesn't have leading zeroes and is a multiple of "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". For example, "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"99"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"10110"}],"kind":"container"},{"kind":"text","text":" are beautiful numbers, and "},{"children":[{"kind":"text","text":"00"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"03"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"122"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Write a program which for the given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" will find a beautiful number such that "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" can be transformed into this number by erasing as few digits as possible. You can erase an arbitraty set of digits. For example, they don't have to go one after another in the number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it's impossible to obtain a beautiful number, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — a positive integer number without leading zeroes ("},{"kind":"math_inline","text":"1 ≤ n < 10100000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one number — any beautiful number obtained by erasing as few as possible digits. If there is no answer, print "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1033\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"33\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example it is enough to erase only the first digit to obtain a multiple of "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". But if we erase the first digit, then we obtain a number with a leading zero. So the minimum number of digits to be erased is two."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"792C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/792/problem/C"}