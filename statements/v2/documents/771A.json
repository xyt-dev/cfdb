{"assets":["/statement-assets/d52fa9c8e4815f105026ae5d584708430fe34cc39a3919d7d950879cadc1723f.png","/statement-assets/69af957e838a6cfbb7e337199ed0ce9b1125b2198d6251885e06d443c290d830.png"],"contentKind":"statement","contestId":"771","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Bear and Friendship Condition"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bear Limak examines a social network. Its main functionality is that two members can become friends (then they can talk with each other and share funny pictures)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" members, numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" pairs of members are friends. Of course, a member can't be a friend with themselves."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"children":[{"kind":"text","text":"A-B"}],"kind":"container"},{"kind":"text","text":" denote that members "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" are friends. Limak thinks that a network is "},{"children":[{"kind":"text","text":"reasonable"}],"kind":"container"},{"kind":"text","text":" if and only if the following condition is satisfied: For every three "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" members ("},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"Y"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"Z"}],"kind":"container"},{"kind":"text","text":"), if "},{"children":[{"kind":"text","text":"X-Y"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"Y-Z"}],"kind":"container"},{"kind":"text","text":" then also "},{"children":[{"kind":"text","text":"X-Z"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example: if Alan and Bob are friends, and Bob and Ciri are friends, then Alan and Ciri should be friends as well."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Can you help Limak and check if the network is reasonable? Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" accordingly, without the quotes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contain two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 150 000"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/d52fa9c8e4815f105026ae5d584708430fe34cc39a3919d7d950879cadc1723f.png"},"kind":"image"},{"kind":"text","text":") — the number of members and the number of pairs of members that are friends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two distinct integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n, ai ≠ bi"},{"kind":"text","text":"). Members "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" are friends with each other. No pair of members will appear more than once in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the given network is reasonable, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" in a single line (without the quotes). Otherwise, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" in a single line (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n1 3\n3 4\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n3 1\n2 3\n3 4\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 4\n4 3\n5 10\n8 9\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The drawings below show the situation in the first sample (on the left) and in the second sample (on the right). Each edge represents two members that are friends. The answer is \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" in the second sample because members "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":" are friends and members "},{"kind":"math_inline","text":"(3, 4)"},{"kind":"text","text":" are friends, while members "},{"kind":"math_inline","text":"(2, 4)"},{"kind":"text","text":" are not."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/69af957e838a6cfbb7e337199ed0ce9b1125b2198d6251885e06d443c290d830.png"},"kind":"image"}],"kind"