{"assets":["/statement-assets/d14167467547289f1ebb178b016847ae28ae269fa9f12cb5295cf9f9e7a9f063.png"],"contentKind":"statement","contestId":"1575","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Another Sorting Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Andi and Budi were given an assignment to tidy up their bookshelf of $$$n$$$ books. Each book is represented by the book title — a string $$$s_i$$$ numbered from $$$1$$$ to $$$n$$$, each with length $$$m$$$. Andi really wants to sort the book lexicographically ascending, while Budi wants to sort it lexicographically descending."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Settling their fight, they decided to combine their idea and sort it "},{"children":[{"kind":"text","text":"asc-desc-endingly"}],"kind":"container"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"the odd-indexed characters will be compared ascendingly"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"the even-indexed characters will be compared descendingly"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string $$$a$$$ occurs before a string $$$b$$$ in "},{"children":[{"kind":"text","text":"asc-desc-ending"}],"kind":"container"},{"kind":"text","text":" order if and only if in the first position where $$$a$$$ and $$$b$$$ differ, the following holds:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if it is an odd position, the string $$$a$$$ has a letter that appears earlier in the alphabet than the corresponding letter in $$$b$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if it is an even position, the string $$$a$$$ has a letter that appears later in the alphabet than the corresponding letter in $$$b$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\leq n \\cdot m \\leq 10^6$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the next $$$n$$$ lines contains a string $$$s_i$$$ consisting of $$$m$$$ uppercase Latin letters — the book title. The strings are pairwise distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output $$$n$$$ integers — the indices of the strings after they are sorted "},{"children":[{"kind":"text","text":"asc-desc-endingly"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 2\nAA\nAB\nBB\nBA\nAZ\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5 2 1 3 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The following illustrates the first example."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d14167467547289f1ebb178b016847ae28ae269fa9f12cb5295cf9f9e7a9f063.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1575A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1575/problem/A"}