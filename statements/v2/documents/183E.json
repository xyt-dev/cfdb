{"assets":["/statement-assets/c0d56623cba83d6f1aefd4c1b7deee80464f7a33342864827df185e6e82a9119.png"],"contentKind":"statement","contestId":"183","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Candy Shop"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The prestigious Codeforces kindergarten consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" kids, numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Each of them are given allowance in rubles by their parents."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Today, they are going to the most famous candy shop in the town. The shop sells candies in packages: for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", inclusive, it sells a package containing exactly "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" candies. A candy costs one ruble, so a package containing "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" candies costs "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" rubles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The kids will purchase candies in turns, starting from kid 1. In a single turn, kid "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" will purchase one candy package. Due to the highly competitive nature of Codeforces kindergarten, during a turn, the number of candies contained in the package purchased by the kid will always be strictly greater than the number of candies contained in the package purchased by the kid in the preceding turn (an exception is in the first turn: the first kid may purchase any package). Then, the turn proceeds to kid "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":", or to kid "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" if it was kid "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"'s turn. This process can be ended at any time, but at the end of the purchase process, all the kids "},{"children":[{"kind":"text","text":"must have the same number of candy packages"}],"kind":"container"},{"kind":"text","text":". Of course, the amount spent by each kid on the candies cannot exceed their allowance."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You work at the candy shop and would like to prepare the candies for the kids. Print the maximum number of candies that can be sold by the candy shop to the kids. If the kids cannot purchase any candy (due to insufficient allowance), print "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(2 ≤ n ≤ 2·105, 2 ≤ m ≤ 5·106, n ≤ m"},{"kind":"text","text":"), denoting the number of kids and the maximum number of candies in a package sold by the candy shop, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, each line will contain a single positive integer not exceeding "},{"attrs":{"alt":"","src":"/statement-assets/c0d56623cba83d6f1aefd4c1b7deee80464f7a33342864827df185e6e82a9119.png"},"kind":"image"},{"kind":"text","text":" denoting the allowance of a kid in rubles. The allowances are given in order from kid "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to kid "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specificator to read or write 64-bit integers in C++. It is recommended to use "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams (also you may use "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specificator)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer denoting the maximum number of candies that can be sold by the candy shop."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 5\n5\n10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 8\n8\n16\n13\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"32\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 5000000\n12500002500000\n12500002500000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12500002500000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first example, one of the scenarios that will result in "},{"kind":"math_inline","text":"13"},{"kind":"text","text":" purchased candies is as follows. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Turn 1. Kid 1 purchases 1 candy. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Turn 2. Kid 2 purchases 3 candies. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Turn 3. Kid 1 purchases 4 candies. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Turn 4. Kid 2 purchases 5 candies. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"183E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/183/problem/E"}