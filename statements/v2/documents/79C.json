{"assets":[],"contentKind":"statement","contestId":"79","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Beaver"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After Fox Ciel got off a bus, she found that the bus she was on was a wrong bus and she lost her way in a strange town. However, she fortunately met her friend Beaver Taro and asked which way to go to her castle. Taro's response to her was a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", and she tried to remember the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" correctly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, Ciel feels "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" strings "},{"kind":"math_inline","text":"b1, b2, ... , bn"},{"kind":"text","text":" are really boring, and unfortunately she dislikes to remember a string that contains a boring substring. To make the thing worse, what she can remember is only the contiguous substring of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the longest contiguous substring of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" that does not contain any boring string, so that she can remember the longest part of Taro's response."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line there is a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". The length of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" will be between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"105"},{"kind":"text","text":", inclusive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line there is a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10"},{"kind":"text","text":"). Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, there is a string "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":"). Each length of "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" will be between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"10"},{"kind":"text","text":", inclusive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each character of the given strings will be either a English alphabet (both lowercase and uppercase) or a underscore ("},{"children":[{"kind":"text","text":"'_'"}],"kind":"container"},{"kind":"text","text":") or a digit. Assume that these strings are case-sensitive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output in the first line two space-separated integers "},{"kind":"math_inline","text":"len"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"pos"},{"kind":"text","text":": the length of the longest contiguous substring of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" that does not contain any "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", and the first position of the substring (0-indexed). The position "},{"kind":"math_inline","text":"pos"},{"kind":"text","text":" must be between "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"|s| - len"},{"kind":"text","text":" inclusive, where "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":" is the length of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several solutions, output any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"Go_straight_along_this_street\n5\nstr\nlong\ntree\nbiginteger\nellipse\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"IhaveNoIdea\n9\nI\nh\na\nv\ne\nN\no\nI\nd\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"unagioisii\n2\nioi\nunagi\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the solution is "},{"children":[{"kind":"text","text":"traight_alon"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the solution is an empty string, so the output can be «"},{"children":[{"kind":"text","text":"0 0"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"0 1"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"0 2"}],"kind":"container"},{"kind":"text","text":"», and so on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, the solution is either "},{"children":[{"kind":"text","text":"nagio"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"oisii"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"79C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/79/problem/C"}