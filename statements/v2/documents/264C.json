{"assets":[],"contentKind":"statement","contestId":"264","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Choosing Balls"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" balls. They are arranged in a row. Each ball has a color (for convenience an integer) and an integer value. The color of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ball is "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" and the value of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ball is "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Squirrel Liss chooses some balls and makes a new sequence without changing the relative order of the balls. She wants to maximize the value of this sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The value of the sequence is defined as the sum of following values for each ball (where "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are given constants):"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If the ball is not in the beginning of the sequence and the color of the ball is same as previous ball's color, add (the value of the ball) "},{"kind":"math_inline","text":" × "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Otherwise, add (the value of the ball) "},{"kind":"math_inline","text":" × "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries. Each query contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". For each query find the maximal value of the sequence she can make when "},{"kind":"math_inline","text":"a = ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b = bi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the new sequence can be "},{"children":[{"kind":"text","text":"empty"}],"kind":"container"},{"kind":"text","text":", and the value of an empty sequence is defined as zero."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105; 1 ≤ q ≤ 500"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"v1, v2, ..., vn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|vi| ≤ 105"},{"kind":"text","text":"). The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain the values of the constants "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" for queries. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|ai|, |bi| ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In each line integers are separated by single spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query, output a line containing an integer — the answer to the query. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains the answer to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query in the input order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not write the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3\n1 -2 3 4 0 -1\n1 2 1 2 1 1\n5 1\n-2 1\n1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20\n9\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n-3 6 -1 2\n1 2 3 1\n1 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, to achieve the maximal value:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" In the first query, you should select 1st, 3rd, and 4th ball. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" In the second query, you should select 3rd, 4th, 5th and 6th ball. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" In the third query, you should select 2nd and 4th ball. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that there may be other ways to achieve the maximal value."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"264C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/264/problem/C"}