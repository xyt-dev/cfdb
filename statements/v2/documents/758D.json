{"assets":[],"contentKind":"statement","contestId":"758","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Ability To Convert"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Alexander is learning how to convert numbers from the decimal system to any other, however, he doesn't know English letters, so he writes any number only as a decimal number, it means that instead of the letter "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" he will write the number "},{"kind":"math_inline","text":"10"},{"kind":"text","text":". Thus, by converting the number "},{"kind":"math_inline","text":"475"},{"kind":"text","text":" from decimal to hexadecimal system, he gets "},{"kind":"math_inline","text":"11311"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"475 = 1·162 + 13·161 + 11·160"},{"kind":"text","text":"). Alexander lived calmly until he tried to convert the number back to the decimal number system."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Alexander remembers that he worked with little numbers so he asks to find the minimum decimal number so that by converting it to the system with the base "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" he will get the number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 109"},{"kind":"text","text":"). The second line contains the integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ k < 1060"},{"kind":"text","text":"), it is guaranteed that the number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" contains no more than "},{"kind":"math_inline","text":"60"},{"kind":"text","text":" symbols. All digits in the second line are strictly less than "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Alexander guarantees that the answer exists and does not exceed "},{"kind":"math_inline","text":"1018"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" doesn't contain leading zeros."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ x ≤ 1018"},{"kind":"text","text":") — the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"13\n12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12"}],"kind":"section"}],"kind"