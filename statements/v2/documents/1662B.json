{"assets":[],"contentKind":"statement","contestId":"1662","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Toys"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vittorio has three favorite toys: a teddy bear, an owl, and a raccoon. Each of them has a name. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vittorio takes several sheets of paper and writes a letter on each side of every sheet so that it is possible to spell any of the three names by arranging some of the sheets in a row (sheets can be reordered and flipped as needed). The three names do not have to be spelled at the same time, it is sufficient that it is possible to spell each of them using all the available sheets (and the same sheet can be used to spell different names)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the minimum number of sheets required. In addition, produce a list of sheets with minimum cardinality which can be used to spell the three names (if there are multiple answers, print any)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a string $$$t$$$ consisting of uppercase letters of the English alphabet ($$$1\\le |t| \\le 1000$$$) — the name of the teddy bear."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string $$$o$$$ consisting of uppercase letters of the English alphabet ($$$1\\le |o| \\le 1000$$$) — the name of the owl."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a string $$$r$$$ consisting of uppercase letters of the English alphabet ($$$1\\le |r| \\le 1000$$$) — the name of the raccoon."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The values $$$|t|$$$, $$$|o|$$$, $$$|r|$$$ denote the length of the three names $$$t$$$, $$$o$$$, $$$r$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the output contains a single integer $$$m$$$ — the minimum number of sheets required."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$m$$$ lines follow: the $$$j$$$-th of these lines contains a string of two uppercase letters of the English alphabet — the letters appearing on the two sides of the $$$j$$$-th sheet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that you can print the sheets and the two letters of each sheet in any order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nAA\nGA\nMA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\nAG\nAM\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nTEDDY\nHEDWIG\nRACCOON\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n8\nAT\nCH\nCY\nDG\nDO\nER\nIN\nOW\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nBDC\nCAA\nCE\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nAD\nAE\nBB\nCC\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"first sample"}],"kind":"container"},{"kind":"text","text":", the solution uses two sheets: the first sheet has "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" on one side and "},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":" on the other side; the second sheet has "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" on one side and "},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":" on the other side."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The name "},{"children":[{"kind":"text","text":"AA"}],"kind":"container"},{"kind":"text","text":" can be spelled using the "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" side of both sheets. The name "},{"children":[{"kind":"text","text":"GA"}],"kind":"container"},{"kind":"text","text":" can be spelled using the "},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":" side of the first sheet and the "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" side of the second sheet. Finally, the name "},{"children":[{"kind":"text","text":"MA"}],"kind":"container"},{"kind":"text","text":" can be spelled using the "},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":" side of the second sheet and the "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" side of the first sheet."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1662B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1662/problem/B"}