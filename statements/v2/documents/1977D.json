{"assets":[],"contentKind":"statement","contestId":"1977","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. XORificator"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a binary (consisting only of "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"s and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"s) $$$n \\times m$$$ matrix. You are also given a XORificator, using which you can invert all the values in a chosen row (i.e. replace "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" with "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" with "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A column in the matrix is considered "},{"children":[{"kind":"text","text":"special"}],"kind":"container"},{"kind":"text","text":" if it contains exactly one "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". Your task is to find the maximum number of columns that can be made "},{"children":[{"kind":"text","text":"special"}],"kind":"container"},{"kind":"text","text":" at the same time, and the set of rows the XORificator should be used on to achieve that."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line of input contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\leq n, m \\leq 3 \\cdot 10^5$$$, $$$n \\cdot m \\leq 3 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following $$$n$$$ lines of the test case contains a binary string of length $$$m$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n \\cdot m$$$ over all test cases does not exceed $$$3 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output two lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first line, output the maximum number of "},{"children":[{"kind":"text","text":"special"}],"kind":"container"},{"kind":"text","text":" columns that is possible to get simultaneously."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line, output a binary string of length $$$n$$$, where the $$$i$$$-th character is "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", if you don't use the XORificator on the $$$i$$$-th row, and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", if you use the XORificator on the $$$i$$$-th row."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple valid XORificator configurations that achieve the optimal answer, you can output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n3 4\n1010\n0110\n0100\n1 1\n1\n1 1\n0\n2 5\n00101\n10110\n3 3\n101\n111\n000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n010\n1\n0\n1\n1\n3\n00\n2\n010\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, you can use the XORificator on the second row to make the columns $$$2$$$, $$$3$$$, and $$$4$$$ "},{"children":[{"kind":"text","text":"special"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the only column is already "},{"children":[{"kind":"text","text":"special"}],"kind":"container"},{"kind":"text","text":", so you don't need to use the XORificator."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1977D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1977/problem/D"}