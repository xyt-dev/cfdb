{"assets":[],"contentKind":"statement","contestId":"520","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Pluses everywhere"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya is sitting on an extremely boring math class. To have fun, he took a piece of paper and wrote out "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers on a single line. After that, Vasya began to write out different ways to put pluses (\""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\") in the line between certain digits in the line so that the result was a correct arithmetic expression; formally, no two pluses in such a partition can stand together (between any two adjacent pluses there must be at least one digit), and no plus can stand at the beginning or the end of a line. For example, in the string "},{"children":[{"kind":"text","text":"100500"}],"kind":"container"},{"kind":"text","text":", ways "},{"children":[{"kind":"text","text":"100500"}],"kind":"container"},{"kind":"text","text":" (add no pluses), "},{"children":[{"kind":"text","text":"1+00+500"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"10050+0"}],"kind":"container"},{"kind":"text","text":" are correct, and ways "},{"children":[{"kind":"text","text":"100++500"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"+1+0+0+5+0+0"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"100500+"}],"kind":"container"},{"kind":"text","text":" are incorrect."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The lesson was long, and Vasya has written all the correct ways to place exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" pluses in a string of digits. At this point, he got caught having fun by a teacher and he was given the task to calculate the sum of all the resulting arithmetic expressions by the end of the lesson (when calculating the value of an expression the leading zeros should be ignored). As the answer can be large, Vasya is allowed to get only its remainder modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":". Help him!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ k < n ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" digits."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the answer to the problem modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n108\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"27"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n108\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the result equals "},{"kind":"math_inline","text":"(1 + 08) + (10 + 8) = 27"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the result equals "},{"kind":"math_inline","text":"1 + 0 + 8 = 9"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"520E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/520/problem/E"}