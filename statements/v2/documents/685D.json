{"assets":[],"contentKind":"statement","contestId":"685","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Kay and Eternity"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Snow Queen told Kay to form a word \"eternity\" using pieces of ice. Kay is eager to deal with the task, because he will then become free, and Snow Queen will give him all the world and a pair of skates."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Behind the palace of the Snow Queen there is an infinite field consisting of cells. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pieces of ice spread over the field, each piece occupying exactly one cell and no two pieces occupying the same cell. To estimate the difficulty of the task Kay looks at some squares of size "},{"kind":"math_inline","text":"k × k"},{"kind":"text","text":" cells, with corners located at the corners of the cells and sides parallel to coordinate axis and counts the number of pieces of the ice inside them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This method gives an estimation of the difficulty of some part of the field. However, Kay also wants to estimate the total difficulty, so he came up with the following criteria: for each "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ n"},{"kind":"text","text":") he wants to count the number of squares of size "},{"kind":"math_inline","text":"k × k"},{"kind":"text","text":", such that there are exactly "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" pieces of the ice inside."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, help Kay estimate the difficulty of the task given by the Snow Queen."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 300"},{"kind":"text","text":") — the number of pieces of the ice and the value "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", respectively. Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ xi, yi ≤ 109"},{"kind":"text","text":") — coordinates of the cell containing "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th piece of the ice. It's guaranteed, that no two pieces of the ice occupy the same cell."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers: the number of squares of size "},{"kind":"math_inline","text":"k × k"},{"kind":"text","text":" containing exactly "},{"kind":"math_inline","text":"1, 2, ..., n"},{"kind":"text","text":" pieces of the ice."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n4 5\n4 6\n5 5\n5 6\n7 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10 8 1 4 0 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"685D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/685/problem/D"}