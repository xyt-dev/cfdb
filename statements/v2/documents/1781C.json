{"assets":[],"contentKind":"statement","contestId":"1781","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Equal Frequencies"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's call a string "},{"children":[{"kind":"text","text":"balanced"}],"kind":"container"},{"kind":"text","text":" if all characters that are present in it appear the same number of times. For example, \""},{"children":[{"kind":"text","text":"coder"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"appall"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"ttttttt"}],"kind":"container"},{"kind":"text","text":"\" are balanced, while \""},{"children":[{"kind":"text","text":"wowwow"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string $$$s$$$ of length $$$n$$$ consisting of lowercase English letters. Find a balanced string $$$t$$$ of the same length $$$n$$$ consisting of lowercase English letters that is different from the string $$$s$$$ in as few positions as possible. In other words, the number of indices $$$i$$$ such that $$$s_i \\ne t_i$$$ should be as small as possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two lines. The first line contains a single integer $$$n$$$ ($$$1 \\le n \\le 10^5$$$) — the length of the string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string $$$s$$$ of length $$$n$$$ consisting of lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the smallest number of positions where string $$$s$$$ and a balanced string $$$t$$$ can differ, followed by such a string $$$t$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, print any. It can be shown that at least one balanced string always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n5\nhello\n10\ncodeforces\n5\neevee\n6\nappall\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\nhelno\n2\ncodefofced\n1\neeeee\n0\nappall\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the given string \""},{"children":[{"kind":"text","text":"hello"}],"kind":"container"},{"kind":"text","text":"\" is not balanced: letters '"},{"children":[{"kind":"text","text":"h"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"', and '"},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"' appear in it once, while letter '"},{"children":[{"kind":"text","text":"l"}],"kind":"container"},{"kind":"text","text":"' appears twice. On the other hand, string \""},{"children":[{"kind":"text","text":"helno"}],"kind":"container"},{"kind":"text","text":"\" is balanced: five distinct letters are present in it, and each of them appears exactly once. Strings \""},{"children":[{"kind":"text","text":"hello"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"helno"}],"kind":"container"},{"kind":"text","text":"\" differ in just one position: the fourth character. Other solutions are possible too."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, string \""},{"children":[{"kind":"text","text":"codefofced"}],"kind":"container"},{"kind":"text","text":"\" is balanced since only letters '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"', and '"},{"children":[{"kind":"text","text":"f"}],"kind":"container"},{"kind":"text","text":"' are present in it, and each of them appears exactly twice."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, string \""},{"children":[{"kind":"text","text":"eeeee"}],"kind":"container"},{"kind":"text","text":"\" is balanced since only letter '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"' is present in it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, the given string \""},{"children":[{"kind":"text","text":"appall"}],"kind":"container"},{"kind":"text","text":"\" is already balanced."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1781C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1781/problem/C"}