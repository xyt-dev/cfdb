{"assets":[],"contentKind":"statement","contestId":"161","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Discounts"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day Polycarpus stopped by a supermarket on his way home. It turns out that the supermarket is having a special offer for stools. The offer is as follows: if a customer's shopping cart contains at least one stool, the customer gets a "},{"kind":"math_inline","text":"50%"},{"kind":"text","text":" discount on the cheapest item in the cart (that is, it becomes two times cheaper). If there are several items with the same minimum price, the discount is available for only one of them!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus has "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" carts, and he wants to buy up all stools and pencils from the supermarket. Help him distribute the stools and the pencils among the shopping carts, so that the items' total price (including the discounts) is the least possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus must use all "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" carts to purchase the items, no shopping cart can remain empty. Each shopping cart can contain an arbitrary number of stools and/or pencils."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 103"},{"kind":"text","text":") — the number of items in the supermarket and the number of carts, correspondingly. Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines describe the items as \""},{"kind":"math_inline","text":"ci"},{"kind":"math_inline","text":"ti"},{"kind":"text","text":"\" (without the quotes), where "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci ≤ 109"},{"kind":"text","text":") is an integer denoting the price of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th item, "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 2"},{"kind":"text","text":") is an integer representing the type of item "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1"},{"kind":"text","text":" for a stool and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" for a pencil). The numbers in the lines are separated by single spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single real number "},{"children":[{"kind":"text","text":"with exactly one "}],"kind":"container"},{"kind":"text","text":" decimal place — the minimum total price of the items, including the discounts."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the following "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines print the descriptions of the items in the carts. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print the description of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th cart as \""},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"b1"},{"kind":"math_inline","text":"b2"},{"kind":"math_inline","text":"..."},{"kind":"math_inline","text":"bt"},{"kind":"text","text":"\" (without the quotes), where "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is the number of items in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th cart, and the sequence "},{"kind":"math_inline","text":"b1, b2, ..., bt"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bj ≤ n"},{"kind":"text","text":") gives the indices of items to put in this cart in the optimal distribution. All indices of items in all carts should be pairwise different, each item must belong to exactly one cart. You can print the items in carts and the carts themselves in any order. The items are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in the order in which they are specified in the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple optimal distributions, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n2 1\n3 2\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5.5\n2 1 2\n1 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n4 1\n1 2\n2 2\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8.0\n1 1\n2 4 2\n1 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case the first cart should contain the 1st and 2nd items, and the second cart should contain the 3rd item. This way each cart has a stool and each cart has a "},{"kind":"math_inline","text":"50%"},{"kind":"text","text":" discount for the cheapest item. The total price of all items will be: "},{"kind":"math_inline","text":"2·0.5 + (3 + 3·0.5) = 1 + 4.5 = 5.5"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"161B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/161/problem/B"}