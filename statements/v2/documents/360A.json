{"assets":["/statement-assets/2fbb3cfb7772dda3d57f3edfcb175d8237ddf0411a5181756dc2bff8d718bb3e.png"],"contentKind":"statement","contestId":"360","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Levko and Array Recovery"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Levko loves array "},{"kind":"math_inline","text":"a1, a2, ... , an"},{"kind":"text","text":", consisting of integers, very much. That is why Levko is playing with array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", performing all sorts of operations with it. Each operation Levko performs is of one of two types:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Increase all elements from "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"di"},{"kind":"text","text":". In other words, perform assignments "},{"kind":"math_inline","text":"aj = aj + di"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" that meet the inequation "},{"kind":"math_inline","text":"li ≤ j ≤ ri"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Find the maximum of elements from "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":". That is, calculate the value "},{"attrs":{"alt":"","src":"/statement-assets/2fbb3cfb7772dda3d57f3edfcb175d8237ddf0411a5181756dc2bff8d718bb3e.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Sadly, Levko has recently lost his array. Fortunately, Levko has records of all operations he has performed on array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". Help Levko, given the operation records, find at least one suitable array. The results of all operations for the given array must coincide with the record results. Levko clearly remembers that all numbers in his array didn't exceed "},{"kind":"math_inline","text":"109"},{"kind":"text","text":" in their absolute value, so he asks you to find such an array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 5000"},{"kind":"text","text":") — the size of the array and the number of operations in Levko's records, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines describe the operations, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line describes the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th operation. The first integer in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line is integer "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 2"},{"kind":"text","text":") that describes the operation type. If "},{"kind":"math_inline","text":"ti = 1"},{"kind":"text","text":", then it is followed by three integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":" - 104 ≤ di ≤ 104"},{"kind":"text","text":") — the description of the operation of the first type. If "},{"kind":"math_inline","text":"ti = 2"},{"kind":"text","text":", then it is followed by three integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":" - 5·107 ≤ mi ≤ 5·107"},{"kind":"text","text":") — the description of the operation of the second type."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The operations are given in the order Levko performed them on his array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if the solution exists and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the solution exists, then on the second line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ... , an"},{"kind":"math_inline","text":"(|ai| ≤ 109)"},{"kind":"text","text":" — the recovered array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n1 2 3 1\n2 1 2 8\n2 3 4 7\n1 1 3 3\n2 3 4 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n4 7 4 7"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n1 2 3 1\n2 1 2 8\n2 3 4 7\n1 1 3 3\n2 3 4 13\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"360A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/360/problem/A"}