{"assets":["/statement-assets/10d619b0515d9a8b865a0c6158c99e5a5c01e40c8f3e72c21b93e64799816ecb.png","/statement-assets/6d85f1f5e23237ddf91d9af9550d5d8bca1c391d670a9e313ed3abaa28de38a6.png"],"contentKind":"statement","contestId":"887","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Little Brother"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Masha's little brother draw two points on a sheet of paper. After that, he draws some circles and gave the sheet to his sister. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Masha has just returned from geometry lesson so she instantly noticed some interesting facts about brother's drawing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At first, the line going through two points, that brother drew, doesn't intersect or touch any circle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, no two circles intersect or touch, and there is no pair of circles such that one circle is located inside another."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Moreover, for each circle, Masha drew a square of the minimal area with sides parallel axis such that this circle is located inside the square and noticed that there is no two squares intersect or touch and there is no pair of squares such that one square is located inside other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Masha wants to draw circle of minimal possible radius such that it goes through two points that brother drew and doesn't intersect any other circle, but other circles can touch Masha's circle and can be located inside it."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"It's guaranteed, that answer won't exceed "},{"kind":"math_inline","text":"1012"},{"kind":"text","text":". It should be held for hacks as well."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains four integers "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 105 ≤ x1, y1, x2, y2 ≤ 105"},{"kind":"text","text":") — coordinates of points that brother drew. First point has coordinates ("},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":") and second point has coordinates ("},{"kind":"math_inline","text":"x2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":"). These two points are different."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of circles that brother drew."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains descriptions of circles. Each line contains three integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 105 ≤ xi, yi ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ri ≤ 105"},{"kind":"text","text":") describing circle with center ("},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":") and radius "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output smallest real number, that it's possible to draw a circle with such radius through given points in such a way that it doesn't intersect other circles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The output is considered correct if it has a relative or absolute error of at most "},{"kind":"math_inline","text":"10 - 4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4 7 13\n3\n3 0 1\n12 4 2\n-4 14 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5.1478150705"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"-2 3 10 -10\n2\n7 0 3\n-5 -5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9.1481831923"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/10d619b0515d9a8b865a0c6158c99e5a5c01e40c8f3e72c21b93e64799816ecb.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/6d85f1f5e23237ddf91d9af9550d5d8bca1c391d670a9e313ed3abaa28de38a6.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"887E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/887/problem/E"}