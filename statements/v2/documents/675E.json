{"assets":[],"contentKind":"statement","contestId":"675","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Trains and Statistic"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya commutes by train every day. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" train stations in the city, and at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th station it's possible to buy only tickets to stations from "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" inclusive. No tickets are sold at the last station."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"ρi, j"},{"kind":"text","text":" be the minimum number of tickets one needs to buy in order to get from stations "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to station "},{"kind":"math_inline","text":"j"},{"kind":"text","text":". As Vasya is fond of different useless statistic he asks you to compute the sum of all values "},{"kind":"math_inline","text":"ρi, j"},{"kind":"text","text":" among all pairs "},{"kind":"math_inline","text":"1 ≤ i < j ≤ n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of stations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" integer "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"i + 1 ≤ ai ≤ n"},{"kind":"text","text":"), the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them means that at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th station one may buy tickets to each station from "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" inclusive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the sum of "},{"kind":"math_inline","text":"ρi, j"},{"kind":"text","text":" among all pairs of "},{"kind":"math_inline","text":"1 ≤ i < j ≤ n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n4 4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2 3 5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"17\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample it's possible to get from any station to any other (with greater index) using only one ticket. The total number of pairs is "},{"kind":"math_inline","text":"6"},{"kind":"text","text":", so the answer is also "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the second sample: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"ρ1, 2 = 1"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ρ1, 3 = 2"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ρ1, 4 = 3"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ρ1, 5 = 3"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ρ2, 3 = 1"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ρ2, 4 = 2"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ρ2, 5 = 2"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ρ3, 4 = 1"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ρ3, 5 = 1"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ρ4, 5 = 1"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Thus the answer equals "},{"kind":"math_inline","text":"1 + 2 + 3 + 3 + 1 + 2 + 2 + 1 + 1 + 1 = 17"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"675E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/675/problem/E"}