{"assets":[],"contentKind":"statement","contestId":"150","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Freezing with Style"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"7 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"This winter is so... well, you've got the idea :-) The Nvodsk road system can be represented as "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" junctions connected with "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" bidirectional roads so that there is a path between any two junctions. The organizers of some event want to choose a place to accommodate the participants (junction "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"), and the place to set up the contests (junction "},{"kind":"math_inline","text":"u"},{"kind":"text","text":"). Besides, at the one hand, they want the participants to walk about the city and see the neighbourhood (that's why the distance between "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" should be no less than "},{"kind":"math_inline","text":"l"},{"kind":"text","text":"). On the other hand, they don't want the participants to freeze (so the distance between "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" should be no more than "},{"kind":"math_inline","text":"r"},{"kind":"text","text":"). Besides, for every street we know its beauty — some integer from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"109"},{"kind":"text","text":". Your task is to choose the path that fits in the length limits and has the largest average beauty. We shall define the average beauty as a median of sequence of the beauties of all roads along the path."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can put it more formally like that: let there be a path with the length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Let "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" be a non-decreasing sequence that contains exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" elements. Each number occurs there exactly the number of times a road with such beauty occurs along on path. We will represent the path median as number "},{"kind":"math_inline","text":"a⌊k / 2⌋"},{"kind":"text","text":", assuming that "},{"children":[{"kind":"text","text":"indexation starting from zero"}],"kind":"container"},{"kind":"text","text":" is used. "},{"kind":"math_inline","text":"⌊x⌋"},{"kind":"text","text":" — is number "},{"kind":"math_inline","text":"х"},{"kind":"text","text":", rounded down to the nearest integer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if "},{"kind":"math_inline","text":"a = {0, 5, 12}"},{"kind":"text","text":", then the median equals to "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", and if "},{"kind":"math_inline","text":"a = {0, 5, 7, 12}"},{"kind":"text","text":", then the median is number "},{"kind":"math_inline","text":"7"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there will be at least one path with the suitable quantity of roads."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r < n ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain descriptions of roads of the Nvodsk, each line contains three integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ ci ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":") — junctions "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" are connected with a street whose beauty equals "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two integers — numbers of the junctions, where to accommodate the participants and set up the contests, correspondingly. If there are multiple optimal variants, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3 4\n1 2 1\n2 3 1\n3 4 1\n4 5 1\n5 6 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3 4\n1 2 1\n2 3 1\n3 4 1\n4 5 2\n5 6 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1 4\n1 2 1\n1 3 4\n3 4 7\n3 5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 3 6\n1 2 9\n2 3 7\n3 4 7\n4 5 8\n5 8 2\n3 6 3\n2 7 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample all roads have the same beauty. That means that all paths of the positive length have the same median. Thus, any path with length from "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", inclusive will be valid for us."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the city looks like that: 1 - 2 - 3 - 4 - 5 - 6. Two last roads are more valuable and we should choose any path that contains both of them and has the suitable length. It is either the path between "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" or the path between "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"150E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/150/problem/E"}