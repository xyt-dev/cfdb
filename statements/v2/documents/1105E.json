{"assets":[],"contentKind":"statement","contestId":"1105","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Helping Hiasat "}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Hiasat registered a new account in NeckoForces and when his friends found out about that, each one of them asked to use his name as Hiasat's handle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Luckily for Hiasat, he can change his handle in some points in time. Also he knows the exact moments friends will visit his profile page. Formally, you are given a sequence of events of two types:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1$$$ — Hiasat can change his handle. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$2$$$ $$$s$$$ — friend $$$s$$$ visits Hiasat's profile. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The friend $$$s$$$ will be happy, if each time he visits Hiasat's profile his handle would be $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Hiasat asks you to help him, find the maximum possible number of happy friends he can get."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\le n \\le 10^5, 1 \\le m \\le 40$$$) — the number of events and the number of friends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$n$$$ lines follow, each denoting an event of one of two types: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1$$$ — Hiasat can change his handle. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$2$$$ $$$s$$$ — friend $$$s$$$ ($$$1 \\le |s| \\le 40$$$) visits Hiasat's profile. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It's guaranteed, that each friend's name consists only of lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed, that the first event is always of the first type and each friend will visit Hiasat's profile at least once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maximum number of happy friends."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 3\n1\n2 motarack\n2 mike\n1\n2 light\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 3\n1\n2 alice\n2 bob\n2 tanyaromanova\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the best way is to change the handle to the \""},{"children":[{"kind":"text","text":"motarack"}],"kind":"container"},{"kind":"text","text":"\" in the first event and to the \""},{"children":[{"kind":"text","text":"light"}],"kind":"container"},{"kind":"text","text":"\" in the fourth event. This way, \""},{"children":[{"kind":"text","text":"motarack"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"light"}],"kind":"container"},{"kind":"text","text":"\" will be happy, but \""},{"children":[{"kind":"text","text":"mike"}],"kind":"container"},{"kind":"text","text":"\" will not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, you can choose either \""},{"children":[{"kind":"text","text":"alice"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"bob"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"tanyaromanova"}],"kind":"container"},{"kind":"text","text":"\" and only that friend will be happy."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1105E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1105/problem/E"}