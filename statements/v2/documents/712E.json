{"assets":["/statement-assets/237e87c1337ecaa4577d64095ef448f75b7d482119acc4376a3df4a406de0c7b.png","/statement-assets/8fb03b37f83f82eec40a6c0ea595efa01894de67a674f2885e6dd68dfc951ee8.png"],"contentKind":"statement","contestId":"712","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Memory and Casinos"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" casinos lined in a row. If Memory plays at casino "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", he has probability "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" to win and move to the casino on the right ("},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":") or exit the row (if "},{"kind":"math_inline","text":"i = n"},{"kind":"text","text":"), and a probability "},{"kind":"math_inline","text":"1 - pi"},{"kind":"text","text":" to lose and move to the casino on the left ("},{"kind":"math_inline","text":"i - 1"},{"kind":"text","text":") or also exit the row (if "},{"kind":"math_inline","text":"i = 1"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We say that Memory "},{"children":[{"kind":"text","text":"dominates"}],"kind":"container"},{"kind":"text","text":" on the interval "},{"kind":"math_inline","text":"i... j"},{"kind":"text","text":" if he completes a walk such that,"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" He starts on casino "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" He never looses in casino "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" He finishes his walk by winning in casino "},{"kind":"math_inline","text":"j"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that Memory can still walk left of the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st casino and right of the casino "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and that always finishes the process."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Memory has some requests, in one of the following forms:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"a"},{"kind":"math_inline","text":"b"},{"kind":"text","text":": Set "},{"attrs":{"alt":"","src":"/statement-assets/237e87c1337ecaa4577d64095ef448f75b7d482119acc4376a3df4a406de0c7b.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"l"},{"kind":"math_inline","text":"r"},{"kind":"text","text":": Print the probability that Memory will "},{"children":[{"kind":"text","text":"dominate"}],"kind":"container"},{"kind":"text","text":" on the interval "},{"kind":"math_inline","text":"l... r"},{"kind":"text","text":", i.e. compute the probability that Memory will first leave the segment "},{"kind":"math_inline","text":"l... r"},{"kind":"text","text":" after winning at casino "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", if she starts in casino "},{"kind":"math_inline","text":"l"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is guaranteed that at any moment of time "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is a "},{"children":[{"kind":"text","text":"non-decreasing sequence"}],"kind":"container"},{"kind":"text","text":", i.e. "},{"kind":"math_inline","text":"pi ≤ pi + 1"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please help Memory by answering all his requests!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":"("},{"kind":"math_inline","text":"1 ≤ n, q ≤ 100 000"},{"kind":"text","text":"),  — number of casinos and number of requests respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each contain integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai < bi ≤ 109"},{"kind":"text","text":")  — "},{"attrs":{"alt":"","src":"/statement-assets/8fb03b37f83f82eec40a6c0ea595efa01894de67a674f2885e6dd68dfc951ee8.png"},"kind":"image"},{"kind":"text","text":" is the probability "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" of winning in casino "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines each contain queries of one of the types specified above ("},{"kind":"math_inline","text":"1 ≤ a < b ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that there will be at least one query of type "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", i.e. the output will be non-empty. Additionally, it is guaranteed that "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" forms a non-decreasing sequence at all times."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a real number for every request of type "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" — the probability that boy will \"dominate\" on that interval. Your answer will be considered correct if its absolute error does not exceed "},{"kind":"math_inline","text":"10 - 4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Namely: let's assume that one of your answers is "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and the corresponding answer of the jury is "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The checker program will consider your answer correct if "},{"kind":"math_inline","text":"|a - b| ≤ 10 - 4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 13\n1 3\n1 2\n2 3\n2 1 1\n2 1 2\n2 1 3\n2 2 2\n2 2 3\n2 3 3\n1 2 2 3\n2 1 1\n2 1 2\n2 1 3\n2 2 2\n2 2 3\n2 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.3333333333\n0.2000000000\n0.1666666667\n0.5000000000\n0.4000000000\n0.6666666667\n0.3333333333\n0.2500000000\n0.2222222222\n0.6666666667\n0.5714285714\n0.6666666667\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"712E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/712/problem/E"}