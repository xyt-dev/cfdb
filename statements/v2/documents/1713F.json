{"assets":[],"contentKind":"statement","contestId":"1713","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Lost Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"children":[{"kind":"text","text":"My orzlers, we can optimize this problem from $$$O(S^3)$$$ to $$$O\\left(T^\\frac{5}{9}\\right)$$$!"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"— Spyofgame, founder of Orzlim religion"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"A long time ago, Spyofgame invented the famous array $$$a$$$ ($$$1$$$-indexed) of length $$$n$$$ that contains information about the world and life. After that, he decided to convert it into the matrix $$$b$$$ ($$$0$$$-indexed) of size $$$(n + 1) \\times (n + 1)$$$ which contains information about the world, life and beyond."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Spyofgame converted $$$a$$$ into $$$b$$$ with the following rules."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$b_{i,0} = 0$$$ if $$$0 \\leq i \\leq n$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b_{0,i} = a_{i}$$$ if $$$1 \\leq i \\leq n$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b_{i,j} = b_{i,j-1} \\oplus b_{i-1,j}$$$ if $$$1 \\leq i, j \\leq n$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Here $$$\\oplus$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise XOR operation"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Today, archaeologists have discovered the famous matrix $$$b$$$. However, many elements of the matrix has been lost. They only know the values of $$$b_{i,n}$$$ for $$$1 \\leq i \\leq n$$$ (note that these are some elements of the last "},{"children":[{"kind":"text","text":"column"}],"kind":"container"},{"kind":"text","text":", not the last "},{"children":[{"kind":"text","text":"row"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The archaeologists want to know what a possible array of $$$a$$$ is. Can you help them reconstruct any array that could be $$$a$$$?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$1 \\leq n \\leq 5 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$b_{1,n}, b_{2,n}, \\ldots, b_{n,n}$$$ ($$$0 \\leq b_{i,n} \\lt 2^{30}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If some array $$$a$$$ is consistent with the information, print a line containing $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$. If there are multiple solutions, output any."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If such an array does not exist, output $$$-1$$$ instead."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n0 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 2 3 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n199633\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n199633 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n346484077 532933626 858787727 369947090 299437981 416813461 865836801 141384800 157794568 691345607\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n725081944 922153789 481174947 427448285 516570428 509717938 855104873 280317429 281091129 1050390365 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"If we let $$$a = [1,2,3]$$$, then $$$b$$$ will be:"}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\bf{0}$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\bf{1}$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\bf{2}$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\bf{3}$$$"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\bf{0}$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$1$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$3$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$0$$$"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\bf{0}$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$1$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$2$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$2$$$"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\bf{0}$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$1$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$3$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$1$$$"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"}],"kind":"container"},{"children":[{"kind":"text","text":"The values of $$$b_{1,n}, b_{2,n}, \\ldots, b_{n,n}$$$ generated are $$$[0,2,1]$$$ which is consistent with what the archaeologists have discovered."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1713F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1713/problem/F"}