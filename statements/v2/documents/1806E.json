{"assets":[],"contentKind":"statement","contestId":"1806","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Tree Master"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a tree with $$$n$$$ weighted vertices labeled from $$$1$$$ to $$$n$$$ rooted at vertex $$$1$$$. The parent of vertex $$$i$$$ is $$$p_i$$$ and the weight of vertex $$$i$$$ is $$$a_i$$$. For convenience, define $$$p_1=0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For two vertices $$$x$$$ and $$$y$$$ "},{"children":[{"kind":"text","text":"of the same depth$$$^\\dagger$$$"}],"kind":"container"},{"kind":"text","text":", define $$$f(x,y)$$$ as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Initialize $$$\\mathrm{ans}=0$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" While both $$$x$$$ and $$$y$$$ are not $$$0$$$: "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\mathrm{ans}\\leftarrow \\mathrm{ans}+a_x\\cdot a_y$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$x\\leftarrow p_x$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$y\\leftarrow p_y$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":" $$$f(x,y)$$$ is the value of $$$\\mathrm{ans}$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":"You will process $$$q$$$ queries. In the $$$i$$$-th query, you are given two integers $$$x_i$$$ and $$$y_i$$$ and you need to calculate $$$f(x_i,y_i)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$^\\dagger$$$ The depth of vertex $$$v$$$ is the number of edges on the unique simple path from the root of the tree to vertex $$$v$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$q$$$ ($$$2 \\le n \\le 10^5$$$; $$$1 \\le q \\le 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\le a_i \\le 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains $$$n-1$$$ integers $$$p_2, \\ldots, p_n$$$ ($$$1 \\le p_i \\lt i$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$q$$$ lines contains two integers $$$x_i$$$ and $$$y_i$$$ ($$$1\\le x_i,y_i\\le n$$$). It is guaranteed that $$$x_i$$$ and $$$y_i$$$ are of the same depth."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output $$$q$$$ lines, the $$$i$$$-th line contains a single integer, the value of $$$f(x_i,y_i)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6 2\n1 5 2 3 1 1\n1 2 3 3 2\n4 5\n6 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n33\n27\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n14 8\n3 2 5 3 1 4 2 2 2 5 5 5 2 4\n1 2 3 1 1 4 7 3 3 1 5 3 8\n4 4\n4 10\n13 10\n3 12\n13 9\n3 12\n9 10\n11 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n47\n53\n48\n36\n42\n36\n48\n14\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first example:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first query, the answer is $$$a_4\\cdot a_5+a_3\\cdot a_3+a_2\\cdot a_2+a_1\\cdot a_1=3+4+25+1=33$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second query, the answer is $$$a_6\\cdot a_6+a_2\\cdot a_2+a_1\\cdot a_1=1+25+1=27$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1806E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1806/problem/E"}