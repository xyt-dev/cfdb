{"assets":[],"contentKind":"statement","contestId":"576","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Flights for Regular Customers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In the country there are exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities numbered with positive integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". In each city there is an airport is located."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, there is the only one airline, which makes "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" flights. Unfortunately, to use them, you need to be a regular customer of this company, namely, you have the opportunity to enjoy flight "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from city "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" only if you have already made at least "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" flights before that."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please note that flight "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" flies exactly from city "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". It can not be used to fly from city "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". An interesting fact is that there may possibly be recreational flights with a beautiful view of the sky, which begin and end in the same city."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to get from city "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Unfortunately, you've never traveled by plane before. What minimum number of flights you have to perform in order to get to city "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the same flight can be used multiple times."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 150"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 150"},{"kind":"text","text":") — the number of cities in the country and the number of flights the company provides."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ di ≤ 109"},{"kind":"text","text":"), representing flight number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from city "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", accessible to only the clients who have made at least "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" flights. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"Impossible"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if it is impossible to get from city "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" using the airways."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But if there is at least one way, print a single integer — the minimum number of flights you need to make to get to the destination point."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 2 0\n2 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n1 2 100500\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Impossible\n"}],"kind":"section"}