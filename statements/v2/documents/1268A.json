{"assets":[],"contentKind":"statement","contestId":"1268","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Long Beautiful Integer"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an integer $$$x$$$ of $$$n$$$ digits $$$a_1, a_2, \\ldots, a_n$$$, which make up its decimal notation in order from left to right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, you are given a positive integer $$$k \\lt n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call integer $$$b_1, b_2, \\ldots, b_m$$$ "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if $$$b_i = b_{i+k}$$$ for each $$$i$$$, such that $$$1 \\leq i \\leq m - k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to find the smallest "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" integer $$$y$$$, such that $$$y \\geq x$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers $$$n, k$$$ ($$$2 \\leq n \\leq 200\\,000, 1 \\leq k \\lt n$$$): the number of digits in $$$x$$$ and $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line of input contains $$$n$$$ digits $$$a_1, a_2, \\ldots, a_n$$$ ($$$a_1 \\neq 0$$$, $$$0 \\leq a_i \\leq 9$$$): digits of $$$x$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print one integer $$$m$$$: the number of digits in $$$y$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next line print $$$m$$$ digits $$$b_1, b_2, \\ldots, b_m$$$ ($$$b_1 \\neq 0$$$, $$$0 \\leq b_i \\leq 9$$$): digits of $$$y$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 2\n353\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n353\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 2\n1234\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1313\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1268A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1268/problem/A"}