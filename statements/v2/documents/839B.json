{"assets":["/statement-assets/a87a487cc6826ef6edf5e0df5adb4bd4affb3e213783015e5a5327a6cf6f7cd4.png","/statement-assets/8c2ab440ee9673ab1accfe773e47580ef1bae836a9c8e62355fbf6fb78ed8957.png"],"contentKind":"statement","contestId":"839","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Game of the Rows"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Daenerys Targaryen has an army consisting of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" groups of soldiers, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th group contains "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" soldiers. She wants to bring her army to the other side of the sea to get the Iron Throne. She has recently bought an airplane to carry her army through the sea. The airplane has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows, each of them has "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" seats. We call two seats neighbor, if they are in the same row and in seats "},{"kind":"math_inline","text":"{1, 2}"},{"kind":"text","text":", "},{"kind":"math_inline","text":"{3, 4}"},{"kind":"text","text":", "},{"kind":"math_inline","text":"{4, 5}"},{"kind":"text","text":", "},{"kind":"math_inline","text":"{5, 6}"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"{7, 8}"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a87a487cc6826ef6edf5e0df5adb4bd4affb3e213783015e5a5327a6cf6f7cd4.png"},"kind":"image"},{"children":[{"kind":"text","text":"A row in the airplane"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Daenerys Targaryen wants to place her army in the plane so that there are no two soldiers from different groups sitting on neighboring seats."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine if there is a possible arranging of her army in the airplane such that the condition above is satisfied."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 100"},{"kind":"text","text":") — the number of rows and the number of groups of soldiers, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, a3, ..., ak"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 10000"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" denotes the number of soldiers in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th group."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that "},{"kind":"math_inline","text":"a1 + a2 + ... + ak ≤ 8·n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If we can place the soldiers in the airplane print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes). Otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can choose the case (lower or upper) for each letter arbitrary."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n5 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n7 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 4\n2 2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Daenerys can place the soldiers like in the figure below:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/8c2ab440ee9673ab1accfe773e47580ef1bae836a9c8e62355fbf6fb78ed8957.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second sample, there is no way to place the soldiers in the plane since the second group soldier will always have a seat neighboring to someone from the first group."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example Daenerys can place the first group on seats "},{"kind":"math_inline","text":"(1, 2, 7, 8)"},{"kind":"text","text":", and the second group an all the remaining seats."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example she can place the first two groups on seats "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(7, 8)"},{"kind":"text","text":", the third group on seats "},{"kind":"math_inline","text":"(3)"},{"kind":"text","text":", and the fourth group on seats "},{"kind":"math_inline","text":"(5, 6)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"839B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/839/problem/B"}