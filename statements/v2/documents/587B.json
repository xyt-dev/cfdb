{"assets":["/statement-assets/5410d03098f99ea031a963fc3c51f63e2abf9aee0bbaacff4313c57382e4abac.png","/statement-assets/3b248207996d9eb8886e42ca833c697611eac4154303a2438e1d93953a9cb73e.png","/statement-assets/0128900074521d9f8719102d7a401de03be72f3cd675e158aa7ccfc6a818f657.png","/statement-assets/77a5733ea702f79348418a6102ccd269fbb0f3a334f808ec67ac46fc8a6618bc.png","/statement-assets/50c2569d4f0bd5ff93bd84566cb1a7a2228967b20042170cd925c52070fa89f8.png","/statement-assets/1c675dd6e50147d94afa09b1f159d2b25a58f696f1bfdfa2fd110a43b5bf0520.png","/statement-assets/981ef1dba57fbd00d4a44d4f99e3da484f6bffe1ced448c5d9aabac9c9da0720.png","/statement-assets/f955d19414e4962f1ce8d01a959ed0edd382b80e9f277a695fdf404b748e5033.png","/statement-assets/8c8fbf089a8269afc5c395c8bc5d6a3ffa27e0d10dfcab2872e3f7c05247e7d2.png","/statement-assets/99dec43363f6751571420bc10461cb6f87ebe88850a4b87c5ff944f407deb1e5.png","/statement-assets/1e69f7b753e4a0bb6afd0b35b4cb8b6a848b7d6d8851e88c5ddf5e80979e7f64.png","/statement-assets/6dddb93a11c9e52e00a99923249e8a34268f96b0563bf2358acb618a98598c56.png","/statement-assets/25ebc5a63529f6114b8a78ad4459712c79233904ccc16f40fd19df7885d5293a.png"],"contentKind":"statement","contestId":"587","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Duff in Beach"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"While Duff was resting in the beach, she accidentally found a strange array "},{"kind":"math_inline","text":"b0, b1, ..., bl - 1"},{"kind":"text","text":" consisting of "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" positive integers. This array was strange because it was extremely long, but there was another (maybe shorter) array, "},{"kind":"math_inline","text":"a0, ..., an - 1"},{"kind":"text","text":" that "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" can be build from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" with formula: "},{"kind":"math_inline","text":"bi = ai mod n"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"a mod b"},{"kind":"text","text":" denoted the remainder of dividing "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5410d03098f99ea031a963fc3c51f63e2abf9aee0bbaacff4313c57382e4abac.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Duff is so curious, she wants to know the number of subsequences of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" like "},{"kind":"math_inline","text":"bi1, bi2, ..., bix"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ i1 < i2 < ... < ix < l"},{"kind":"text","text":"), such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1 ≤ x ≤ k"}],"kind":"list_item"},{"children":[{"kind":"text","text":" For each "},{"kind":"math_inline","text":"1 ≤ j ≤ x - 1"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/3b248207996d9eb8886e42ca833c697611eac4154303a2438e1d93953a9cb73e.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"kind":"text","text":" For each "},{"kind":"math_inline","text":"1 ≤ j ≤ x - 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bij ≤ bij + 1"},{"kind":"text","text":". i.e this subsequence is non-decreasing. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Since this number can be very large, she want to know it modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Duff is not a programmer, and Malek is unavailable at the moment. So she asked for your help. Please tell her this number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains three integers, "},{"kind":"math_inline","text":"n, l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n × k ≤ 106"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 ≤ l ≤ 1018"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space separated integers, "},{"kind":"math_inline","text":"a0, a1, ..., an - 1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":" for each "},{"kind":"math_inline","text":"0 ≤ i ≤ n - 1"},{"kind":"text","text":"). "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the answer modulo "},{"kind":"math_inline","text":"1 000 000 007"},{"kind":"text","text":" in one line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5 3\n5 9 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 10 3\n1 2 3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"25\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case, "},{"attrs":{"alt":"","src":"/statement-assets/0128900074521d9f8719102d7a401de03be72f3cd675e158aa7ccfc6a818f657.png"},"kind":"image"},{"kind":"text","text":". So all such sequences are: "},{"attrs":{"alt":"","src":"/statement-assets/77a5733ea702f79348418a6102ccd269fbb0f3a334f808ec67ac46fc8a6618bc.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/50c2569d4f0bd5ff93bd84566cb1a7a2228967b20042170cd925c52070fa89f8.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/1c675dd6e50147d94afa09b1f159d2b25a58f696f1bfdfa2fd110a43b5bf0520.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/981ef1dba57fbd00d4a44d4f99e3da484f6bffe1ced448c5d9aabac9c9da0720.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/f955d19414e4962f1ce8d01a959ed0edd382b80e9f277a695fdf404b748e5033.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/8c8fbf089a8269afc5c395c8bc5d6a3ffa27e0d10dfcab2872e3f7c05247e7d2.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/99dec43363f6751571420bc10461cb6f87ebe88850a4b87c5ff944f407deb1e5.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/1e69f7b753e4a0bb6afd0b35b4cb8b6a848b7d6d8851e88c5ddf5e80979e7f64.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/6dddb93a11c9e52e00a99923249e8a34268f96b0563bf2358acb618a98598c56.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/statement-assets/25ebc5a63529f6114b8a78ad4459712c79233904ccc16f40fd19df7885d5293a.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"587B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/587/problem/B"}