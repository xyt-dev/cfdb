{"assets":["/statement-assets/a370992429bf2752756073fdb7a1e8708a69e88001f67b20ea0407cad4b95c46.jpg"],"contentKind":"statement","contestId":"60","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Where Are My Flakes?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"attrs":{"alt":"","src":"/statement-assets/a370992429bf2752756073fdb7a1e8708a69e88001f67b20ea0407cad4b95c46.jpg"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"One morning the Cereal Guy found out that all his cereal flakes were gone. He found a note instead of them. It turned out that his smart roommate hid the flakes in one of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" boxes. The boxes stand in one row, they are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from the left to the right. The roommate left hints like \"Hidden to the left of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th box\" (\""},{"children":[{"kind":"text","text":"To the left of "},{"kind":"math_inline","text":"i"}],"kind":"container"},{"kind":"text","text":"\"), \"Hidden to the right of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th box\" (\""},{"children":[{"kind":"text","text":"To the right of "},{"kind":"math_inline","text":"i"}],"kind":"container"},{"kind":"text","text":"\"). Such hints mean that there are no flakes in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th box as well. The Cereal Guy wants to know the minimal number of boxes he necessarily needs to check to find the flakes considering all the hints. Or he wants to find out that the hints are contradictory and the roommate lied to him, that is, no box has the flakes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000, 0 ≤ m ≤ 1000"},{"kind":"text","text":") which represent the number of boxes and the number of hints correspondingly. Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain hints like \""},{"children":[{"kind":"text","text":"To the left of "},{"kind":"math_inline","text":"i"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"To the right of "},{"kind":"math_inline","text":"i"}],"kind":"container"},{"kind":"text","text":"\", where "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is integer ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":"). The hints may coincide."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The answer should contain exactly one integer — the number of boxes that should necessarily be checked or \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\" if the hints are contradictory."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\nTo the left of 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\nTo the right of 1\nTo the right of 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\nTo the left of 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\nTo the left of 2\nTo the right of 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"60A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/60/problem/A"}