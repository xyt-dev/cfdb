{"assets":[],"contentKind":"statement","contestId":"508","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Anya and Ghosts"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Anya loves to watch horror movies. In the best traditions of horror, she will be visited by "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ghosts tonight. Anya has lots of candles prepared for the visits, each candle can produce light for exactly "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" seconds. It takes the girl one second to light one candle. More formally, Anya can spend one second to light one candle, then this candle burns for exactly "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" seconds and then goes out and can no longer be used."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each of the "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ghosts Anya knows the time at which it comes: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th visit will happen "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" seconds after midnight, all "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":"'s are distinct. Each visit lasts exactly one second."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of candles Anya should use so that during each visit, at least "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" candles are burning? Anya can start to light a candle at any time that is integer number of seconds from midnight, possibly, at the time before midnight. "},{"children":[{"kind":"text","text":"That means, she can start to light a candle integer number of seconds before midnight or integer number of seconds after a midnight, or in other words in any integer moment of time."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m, t, r ≤ 300"},{"kind":"text","text":"), representing the number of ghosts to visit Anya, the duration of a candle's burning and the minimum number of candles that should burn during each visit. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space-separated numbers "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ wi ≤ 300"},{"kind":"text","text":"), the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them repesents at what second after the midnight the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ghost will come. All "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":"'s are distinct, they follow in the strictly increasing order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is possible to make at least "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" candles burn during each visit, then print the minimum number of candles that Anya needs to light for that."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If that is impossible, print "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 8 3\n10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 10 1\n5 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 3\n10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Anya can start lighting a candle in the same second with ghost visit. But this candle isn't counted as burning at this visit."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It takes exactly one second to light up a candle and only after that second this candle is considered burning; it means that if Anya starts lighting candle at moment x, candle is buring from second x + 1 to second x + t inclusively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample test three candles are enough. For example, Anya can start lighting them at the "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-rd, "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"-th and "},{"kind":"math_inline","text":"7"},{"kind":"text","text":"-th seconds after the midnight."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test one candle is enough. For example, Anya can start lighting it one second before the midnight."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample test the answer is "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":", since during each second at most one candle can burn but Anya needs three candles to light up the room at the moment when the ghost comes."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"508C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/508/problem/C"}