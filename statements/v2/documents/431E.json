{"assets":[],"contentKind":"statement","contestId":"431","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Chemistry Experiment"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day two students, Grisha and Diana, found themselves in the university chemistry lab. In the lab the students found "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" test tubes with mercury numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and decided to conduct an experiment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The experiment consists of "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" steps. On each step, one of the following actions occurs:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Diana pours all the contents from tube number "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and then pours there exactly "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" liters of mercury. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Let's consider all the ways to add "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" liters of water into the tubes; for each way let's count the volume "},{"children":[{"kind":"text","text":"of liquid"}],"kind":"container"},{"kind":"text","text":" (water and mercury) in the tube "},{"children":[{"kind":"text","text":"with water"}],"kind":"container"},{"kind":"text","text":" with maximum amount of liquid; finally let's find the minimum among counted maximums. That is the number the students want to count. At that, the students don't actually pour the mercury. They perform calculations without changing the contents of the tubes. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Unfortunately, the calculations proved to be too complex and the students asked you to help them. Help them conduct the described experiment."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, q ≤ 105"},{"kind":"text","text":") — the number of tubes ans the number of experiment steps. The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers: "},{"kind":"math_inline","text":"h1, h2, ..., hn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ hi ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" is the volume of mercury in the "},{"kind":"math_inline","text":"і"},{"kind":"text","text":"-th tube at the beginning of the experiment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain the game actions in the following format:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" A line of form \""},{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"pi"},{"kind":"math_inline","text":"xi"},{"kind":"text","text":"\" means an action of the first type ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n; 0 ≤ xi ≤ 109"},{"kind":"text","text":"). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A line of form \""},{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"vi"},{"kind":"text","text":"\" means an action of the second type ("},{"kind":"math_inline","text":"1 ≤ vi ≤ 1015"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is guaranteed that there is at least one action of the second type. It is guaranteed that all numbers that describe the experiment are integers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each action of the second type print the calculated value. The answer will be considered correct if its relative or absolute error doesn't exceed "},{"kind":"math_inline","text":"10 - 4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2 0\n2 2\n1 2 1\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.50000\n1.66667\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n1 3 0 1\n2 3\n2 1\n1 3 2\n2 3\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.66667\n1.00000\n2.33333\n2.66667\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"431E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/431/problem/E"}