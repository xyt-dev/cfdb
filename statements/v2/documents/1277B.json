{"assets":[],"contentKind":"statement","contestId":"1277","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Make Them Odd"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are $$$n$$$ positive integers $$$a_1, a_2, \\dots, a_n$$$. For the one move you can choose any even value $$$c$$$ and divide by two "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" elements that equal $$$c$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if $$$a=[6,8,12,6,3,12]$$$ and you choose $$$c=6$$$, and $$$a$$$ is transformed into $$$a=[3,8,12,3,3,12]$$$ after the move."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to find the minimal number of moves for transforming $$$a$$$ to an array of only odd integers (each element shouldn't be divisible by $$$2$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases in the input. Then $$$t$$$ test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of a test case contains $$$n$$$ ($$$1 \\le n \\le 2\\cdot10^5$$$) — the number of integers in the sequence $$$a$$$. The second line contains positive integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of $$$n$$$ for all test cases in the input doesn't exceed $$$2\\cdot10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For $$$t$$$ test cases print the answers in the order of test cases in the input. The answer for the test case is the minimal number of moves needed to make "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" numbers in the test case odd (i.e. not divisible by $$$2$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n6\n40 6 40 3 20 1\n1\n1024\n4\n2 4 8 16\n3\n3 1 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n10\n4\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case of the example, the optimal sequence of moves can be as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" before making moves $$$a=[40, 6, 40, 3, 20, 1]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" choose $$$c=6$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" now $$$a=[40, 3, 40, 3, 20, 1]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" choose $$$c=40$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" now $$$a=[20, 3, 20, 3, 20, 1]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" choose $$$c=20$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" now $$$a=[10, 3, 10, 3, 10, 1]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" choose $$$c=10$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" now $$$a=[5, 3, 5, 3, 5, 1]$$$ — all numbers are odd. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Thus, all numbers became odd after $$$4$$$ moves. In $$$3$$$ or fewer moves, you cannot make them all odd."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1277B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1277/problem/B"}