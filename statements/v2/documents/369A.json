{"assets":[],"contentKind":"statement","contestId":"369","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Valera and Plates"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Valera is a lazy student. He has "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" clean bowls and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" clean plates. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valera has made an eating plan for the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days. As Valera is lazy, he will eat exactly one dish per day. At that, in order to eat a dish, he needs exactly one "},{"children":[{"kind":"text","text":"clean"}],"kind":"container"},{"kind":"text","text":" plate or bowl. We know that Valera can cook only two types of dishes. He can eat dishes of the first type from bowls and dishes of the second type from either bowls or plates. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When Valera finishes eating, he leaves a dirty plate/bowl behind. His life philosophy doesn't let him eat from dirty kitchenware. So sometimes he needs to wash his plate/bowl "},{"children":[{"kind":"text","text":"before eating"}],"kind":"container"},{"kind":"text","text":". Find the minimum number of times Valera will need to wash a plate/bowl, if he acts optimally."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m, k ≤ 1000"},{"kind":"text","text":") — the number of the planned days, the number of clean bowls and the number of clean plates."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 2"},{"kind":"text","text":"). If "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" equals one, then on day "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" Valera will eat a first type dish. If "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" equals two, then on day "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" Valera will eat a second type dish. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum number of times Valera will need to wash a plate/bowl."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 1\n1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 1\n1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 2\n2 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 2 2\n1 2 1 2 1 2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Valera will wash a bowl only on the third day, so the answer is one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, Valera will have the first type of the dish during all four days, and since there are only three bowls, he will wash a bowl exactly once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, Valera will have the second type of dish for all three days, and as they can be eaten from either a plate or a bowl, he will never need to wash a plate/bowl."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"369A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/369/problem/A"}