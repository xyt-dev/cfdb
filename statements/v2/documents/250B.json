{"assets":[],"contentKind":"statement","contestId":"250","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Restoring IPv6"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"An IPv6-address is a 128-bit number. For convenience, this number is recorded in blocks of 16 bits in hexadecimal record, the blocks are separated by colons — 8 blocks in total, each block has four hexadecimal digits. Here is an example of the correct record of a IPv6 address: \""},{"children":[{"kind":"text","text":"0124:5678:90ab:cdef:0124:5678:90ab:cdef"}],"kind":"container"},{"kind":"text","text":"\". We'll call such format of recording an IPv6-address "},{"children":[{"kind":"text","text":"full"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Besides the full record of an IPv6 address there is a "},{"children":[{"kind":"text","text":"short"}],"kind":"container"},{"kind":"text","text":" record format. The record of an IPv6 address can be shortened by removing one or more leading zeroes at the beginning of each block. However, each block should contain at least one digit in the short format. For example, the leading zeroes can be removed like that: \""},{"children":[{"kind":"text","text":"a56f:00d3:0000:0124:0001:f19a:1000:0000"}],"kind":"container"},{"kind":"text","text":"\" "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"a56f:d3:0:0124:01:f19a:1000:00"}],"kind":"container"},{"kind":"text","text":"\". There are more ways to shorten zeroes in this IPv6 address."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some IPv6 addresses contain long sequences of zeroes. Continuous sequences of 16-bit zero blocks can be shortened to \""},{"children":[{"kind":"text","text":"::"}],"kind":"container"},{"kind":"text","text":"\". A sequence can consist of one or several "},{"children":[{"kind":"text","text":"consecutive blocks"}],"kind":"container"},{"kind":"text","text":", with all 16 bits equal to 0. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can see examples of zero block shortenings below:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"a56f:00d3:0000:0124:0001:0000:0000:0000"}],"kind":"container"},{"kind":"text","text":"\" "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"a56f:00d3:0000:0124:0001::"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"a56f:0000:0000:0124:0001:0000:1234:0ff0"}],"kind":"container"},{"kind":"text","text":"\" "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"a56f::0124:0001:0000:1234:0ff0"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"a56f:0000:0000:0000:0001:0000:1234:0ff0"}],"kind":"container"},{"kind":"text","text":"\" "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"a56f:0000::0000:0001:0000:1234:0ff0"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"a56f:00d3:0000:0124:0001:0000:0000:0000"}],"kind":"container"},{"kind":"text","text":"\" "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"a56f:00d3:0000:0124:0001::0000"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"0000:0000:0000:0000:0000:0000:0000:0000"}],"kind":"container"},{"kind":"text","text":"\" "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"::"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is not allowed to shorten zero blocks in the address more than once. This means that the short record can't contain the sequence of characters \""},{"children":[{"kind":"text","text":"::"}],"kind":"container"},{"kind":"text","text":"\" more than once. Otherwise, it will sometimes be impossible to determine the number of zero blocks, each represented by a double colon."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The format of the record of the IPv6 address after removing the leading zeroes and shortening the zero blocks is called "},{"children":[{"kind":"text","text":"short"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You've got several short records of IPv6 addresses. Restore their full record."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the number of records to restore ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains a string — the short IPv6 addresses. Each string only consists of string characters \""},{"children":[{"kind":"text","text":"0123456789abcdef:"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that each short address is obtained by the way that is described in the statement from some full IPv6 address."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each short IPv6 address from the input print its full record on a separate line. Print the full records for the short IPv6 addresses in the order, in which the short records follow in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\na56f:d3:0:0124:01:f19a:1000:00\na56f:00d3:0000:0124:0001::\na56f::0124:0001:0000:1234:0ff0\na56f:0000::0000:0001:0000:1234:0ff0\n::\n0ea::4d:f4:6:0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"a56f:00d3:0000:0124:0001:f19a:1000:0000\na56f:00d3:0000:0124:0001:0000:0000:0000\na56f:0000:0000:0124:0001:0000:1234:0ff0\na56f:0000:0000:0000:0001:0000:1234:0ff0\n0000:0000:0000:0000:0000:0000:0000:0000\n00ea:0000:0000:0000:004d:00f4:0006:0000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"250B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/250/problem/B"}