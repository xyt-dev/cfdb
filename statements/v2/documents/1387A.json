{"assets":[],"contentKind":"statement","contestId":"1387","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an undirected graph where each edge has one of two colors: black or red."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to assign a real number to each node so that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" for each black edge the sum of values at its endpoints is $$$1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for each red edge the sum of values at its endpoints is $$$2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the sum of the absolute values of all assigned numbers is the smallest possible. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Otherwise, if it is not possible, report that there is no feasible assignment of the numbers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$N$$$ ($$$1 \\leq N \\leq 100\\,000$$$) and $$$M$$$ ($$$0 \\leq M \\leq 200\\,000$$$): the number of nodes and the number of edges, respectively. The nodes are numbered by consecutive integers: $$$1, 2, \\ldots, N$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$M$$$ lines describe the edges. Each line contains three integers $$$a$$$, $$$b$$$ and $$$c$$$ denoting that there is an edge between nodes $$$a$$$ and $$$b$$$ ($$$1 \\leq a, b \\leq N$$$) with color $$$c$$$ ($$$1$$$ denotes black, $$$2$$$ denotes red)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is a solution, the first line should contain the word \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" and the second line should contain $$$N$$$ space-separated numbers. For each $$$i$$$ ($$$1 \\le i \\le N$$$), the $$$i$$$-th number should be the number assigned to the node $$$i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Output should be such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the sum of the numbers at the endpoints of each edge differs from the precise value by less than $$$10^{-6}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the sum of the absolute values of all assigned numbers differs from the smallest possible by less than $$$10^{-6}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there are several valid solutions, output any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is no solution, the only line should contain the word \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom","title":"Scoring"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Scoring"}],"kind":"heading"},{"children":[{"kind":"text","text":"Subtasks: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" (5 points) $$$N \\leq 5$$$, $$$M \\leq 14$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" (12 points) $$$N \\leq 100$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" (17 points) $$$N \\leq 1000$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" (24 points) $$$N \\leq 10\\,000$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" (42 points) No further constraints "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 4\n1 2 1\n2 3 2\n1 3 2\n3 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n0.5 0.5 1.5 -0.5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 1\n1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n0.3 0.7"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 2\n1 2 2\n2 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n0 2 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 4\n1 2 2\n2 2 1\n2 1 1\n1 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Note that in the second example the solution is not unique."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1387A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1387/problem/A"}