{"assets":["/statement-assets/37fc21636e03b2e71f8c1c10c0b403daf441bcd5bd87ee8064a8faa540f56928.png","/statement-assets/84b61fe316e6688027141368944fbd6f3c4e0cd963170e8484c6f542f8b4e73e.png","/statement-assets/edadb500115271e49ab79cf442b61364f518912057d6b05aa3e212260617ea42.png","/statement-assets/ac122ee455e1f8af32007ac3946d375c6a893e26985a6d25bf8c29c8ba45d01d.png"],"contentKind":"statement","contestId":"916","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Jamie and Binary Sequence (changed after round)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Jamie is preparing a Codeforces round. He has got an idea for a problem, but does not know how to solve it. Help him write a solution to the following problem:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers such that the sum of two to the power of each number equals to the number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and the largest integer in the answer is as small as possible. As there may be multiple answers, you are asked to output the lexicographically largest one. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To be more clear, consider all integer sequence with length "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(a1, a2, ..., ak)"},{"kind":"text","text":" with "},{"attrs":{"alt":"","src":"/statement-assets/37fc21636e03b2e71f8c1c10c0b403daf441bcd5bd87ee8064a8faa540f56928.png"},"kind":"image"},{"kind":"text","text":". Give a value "},{"attrs":{"alt":"","src":"/statement-assets/84b61fe316e6688027141368944fbd6f3c4e0cd963170e8484c6f542f8b4e73e.png"},"kind":"image"},{"kind":"text","text":" to each sequence. Among all sequence(s) that have the minimum "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" value, output the one that is the lexicographically largest."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For definitions of powers and lexicographical order see notes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line consists of two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1018, 1 ≤ k ≤ 105)"},{"kind":"text","text":" — the required sum and the length of the sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in a single line if there does not exist such sequence. Otherwise, output \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in the first line, and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" numbers separated by space in the second line — the required sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the integers in the answer sequence fit the range "},{"kind":"math_inline","text":"[ - 1018, 1018]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"23 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n3 3 2 1 0 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"13 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n-1 -1 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Sample 1:"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"23 + 23 + 22 + 21 + 20 = 8 + 8 + 4 + 2 + 1 = 23"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Answers like "},{"kind":"math_inline","text":"(3, 3, 2, 0, 1)"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"(0, 1, 2, 3, 3)"},{"kind":"text","text":" are not lexicographically largest."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Answers like "},{"kind":"math_inline","text":"(4, 1, 1, 1, 0)"},{"kind":"text","text":" do not have the minimum "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" value."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Sample 2:"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It can be shown there does not exist a sequence with length 2."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Sample 3:"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/edadb500115271e49ab79cf442b61364f518912057d6b05aa3e212260617ea42.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Powers of 2:"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"x > 0"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"2x = 2·2·2·...·2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":" times)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"x = 0"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"2x = 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"x < 0"},{"kind":"text","text":", then "},{"attrs":{"alt":"","src":"/statement-assets/ac122ee455e1f8af32007ac3946d375c6a893e26985a6d25bf8c29c8ba45d01d.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Lexicographical order:"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given two different sequences of the same length, "},{"kind":"math_inline","text":"(a1, a2, ... , ak)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(b1, b2, ... , bk)"},{"kind":"text","text":", the first one is smaller than the second one for the lexicographical order, if and only if "},{"kind":"math_inline","text":"ai < bi"},{"kind":"text","text":", for the first "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" differ."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"916B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/916/problem/B"}