{"assets":[],"contentKind":"statement","contestId":"774","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"I. Composing Of String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Stepan has a set of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" strings. Also, he has a favorite string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Stepan wants to do the following. He will take some strings of his set and write them down one after another. It is possible that he will take some strings more than once, and will not take some of them at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine the minimum number of strings in the set which Stepan needs to take and write so that the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" appears as a subsequence in the resulting written down string. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, in the string \""},{"children":[{"kind":"text","text":"abcd"}],"kind":"container"},{"kind":"text","text":"\" strings \""},{"children":[{"kind":"text","text":"ad"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"acd"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abcd"}],"kind":"container"},{"kind":"text","text":"\" appear as subsequences, and strings \""},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abdc"}],"kind":"container"},{"kind":"text","text":"\" don't appear as subsequences. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50"},{"kind":"text","text":") — the number of strings in Stepan's set."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" non-empty strings consisting of lowercase letters of the English alphabet. The length of each of these strings does not exceed "},{"kind":"math_inline","text":"50"},{"kind":"text","text":" symbols. It is possible that some strings from Stepan's set are the same."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains the non-empty string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of lowercase letters of the English alphabet — Stepan's favorite string. The length of this string doesn't exceed "},{"kind":"math_inline","text":"2500"},{"kind":"text","text":" symbols."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of strings which Stepan should take from the set and write them down one after another so that the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" appears as a subsequence in the resulting written down string. Each string from the set should be counted as many times as Stepan takes it from the set. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the answer doesn't exsist, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\na\naa\na\naaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nab\naab\naa\nbb\nbaaab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\naaa\nbbb\naaacbbb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test, Stepan can take, for example, the third and the second strings from the set, write them down, and get exactly his favorite string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example Stepan can take, for example, the second, the third and again the second strings from the set and write them down. Then he will get a string \""},{"children":[{"kind":"text","text":"aabaaaab"}],"kind":"container"},{"kind":"text","text":"\", in which his favorite string \""},{"children":[{"kind":"text","text":"baaab"}],"kind":"container"},{"kind":"text","text":"\" is a subsequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test Stepan can not get his favorite string, because it contains the letter \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\", which is not presented in any of the strings in the set."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"I","problemCode":"774I","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/774/problem/I"}