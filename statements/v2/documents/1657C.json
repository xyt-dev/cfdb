{"assets":[],"contentKind":"statement","contestId":"1657","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Bracket Sequence Deletion"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a bracket sequence consisting of $$$n$$$ characters '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' and/or "},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"'. You perform several operations with it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During one operation, you choose the "},{"children":[{"kind":"text","text":"shortest"}],"kind":"container"},{"kind":"text","text":" prefix of this string (some amount of first characters of the string) that is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" and remove it from the string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The prefix is considered "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if one of the following two conditions is satisfied:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" this prefix is a regular bracket sequence; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" this prefix is a palindrome of length "},{"children":[{"kind":"text","text":"at least two"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A bracket sequence is called regular if it is possible to obtain a correct arithmetic expression by inserting characters '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' into this sequence. For example, sequences "},{"children":[{"kind":"text","text":"(())()"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"(()(()))"}],"kind":"container"},{"kind":"text","text":" are regular, while "},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"(()"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"(()))("}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The bracket sequence is called palindrome if it reads the same back and forth. For example, the bracket sequences "},{"children":[{"kind":"text","text":"))"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"(("}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":")(()"}],"kind":"container"},{"kind":"text","text":" are palindromes, while bracket sequences "},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"))("}],"kind":"container"},{"kind":"text","text":" are not palindromes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You stop performing the operations when it's not possible to find a "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" prefix. Your task is to find the number of operations you will perform on the given string and the number of remaining characters in the string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to answer $$$t$$$ independent test cases."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. The next $$$2t$$$ lines describe test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of the test case contains one integer $$$n$$$ ($$$1 \\le n \\le 5 \\cdot 10^5$$$) — the length of the bracket sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the test case contains $$$n$$$ characters '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' and/or '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"' — the bracket sequence itself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases do not exceed $$$5 \\cdot 10^5$$$ ($$$\\sum n \\le 5 \\cdot 10^5$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print two integers $$$c$$$ and $$$r$$$ — the number of operations you will perform on the given bracket sequence and the number of characters that remain in the string after performing all operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n2\n()\n3\n())\n4\n((((\n5\n)((()\n6\n)((()(\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 0\n1 1\n2 0\n1 0\n1 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1657C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1657/problem/C"}