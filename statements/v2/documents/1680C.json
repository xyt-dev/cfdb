{"assets":[],"contentKind":"statement","contestId":"1680","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Binary String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ consisting of characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to remove several (possibly zero) characters from the beginning of the string, and then several (possibly zero) characters from the end of the string. "},{"children":[{"kind":"text","text":"The string may become empty after the removals"}],"kind":"container"},{"kind":"text","text":". The cost of the removal is the "},{"children":[{"kind":"text","text":"maximum"}],"kind":"container"},{"kind":"text","text":" of the following two values:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the number of characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" left in the string; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the number of characters "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" removed from the string. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"What is the "},{"children":[{"kind":"text","text":"minimum"}],"kind":"container"},{"kind":"text","text":" cost of removal you can achieve?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of one line containing the string $$$s$$$ ($$$1 \\le |s| \\le 2 \\cdot 10^5$$$), consisting of characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The total length of strings $$$s$$$ in all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer — the minimum cost of removal you can achieve."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n101110110\n1001001001001\n0000111111\n00000\n1111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n3\n0\n0\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the test cases of the example:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" in the first test case, it's possible to remove two characters from the beginning and one character from the end. Only one "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" is deleted, only one "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" remains, so the cost is $$$1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the second test case, it's possible to remove three characters from the beginning and six characters from the end. Two characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" remain, three characters "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" are deleted, so the cost is $$$3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the third test case, it's optimal to remove four characters from the beginning; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the fourth test case, it's optimal to remove the whole string; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the fifth test case, it's optimal to leave the string as it is. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1680C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1680/problem/C"}