[{"kind":"text","text":"techno"}],"kind":"container"},{"kind":"text","text":"\" the process is: \""},{"children":[{"kind":"text","text":"t"}],"kind":"container"},{"kind":"text","text":"\" $$$\\to$$$ \""},{"children":[{"kind":"text","text":"te"}],"kind":"container"},{"kind":"text","text":"\" $$$\\to$$$ \""},{"children":[{"kind":"text","text":"cte"}],"kind":"container"},{"kind":"text","text":"\" $$$\\to$$$ \""},{"children":[{"kind":"text","text":"cteh"}],"kind":"container"},{"kind":"text","text":"\" $$$\\to$$$ \""},{"children":[{"kind":"text","text":"ncteh"}],"kind":"container"},{"kind":"text","text":"\" $$$\\to$$$ \""},{"children":[{"kind":"text","text":"ncteho"}],"kind":"container"},{"kind":"text","text":"\". So the encrypted $$$s$$$=\""},{"children":[{"kind":"text","text":"techno"}],"kind":"container"},{"kind":"text","text":"\" is \""},{"children":[{"kind":"text","text":"ncteho"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given string $$$t$$$ — the result of encryption of some string $$$s$$$. Your task is to decrypt it, i.e. find the string $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains $$$t$$$ — the result of encryption of some string $$$s$$$. It contains only lowercase Latin letters. The length of $$$t$$$ is between $$$1$$$ and $$$50$$$, inclusive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print such string $$$s$$$ that after encryption it equals $$$t$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"a