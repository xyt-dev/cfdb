{"assets":["/statement-assets/a531516e3ed499d28e18d4ebed3cba4abd50960eed9a077e19408454a92eacd9.png"],"contentKind":"statement","contestId":"2165","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Rainbow Branch"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a tree with $$$n$$$ vertices, you need to assign a color to each edge. Define the "},{"children":[{"kind":"text","text":"inconvenience"}],"kind":"container"},{"kind":"text","text":" of an assignment as the maximum number of colors on the path between any two vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to assign "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" $$$k$$$ different colors (each color must appear at least once) to the edges while minimizing the "},{"children":[{"kind":"text","text":"inconvenience"}],"kind":"container"},{"kind":"text","text":" of the assignment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please calculate the minimum "},{"children":[{"kind":"text","text":"inconvenience"}],"kind":"container"},{"kind":"text","text":" for all $$$k=1,2,\\ldots,n-1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of the input contains one positive integer $$$n$$$ ($$$3\\le n\\le3\\cdot10^5$$$) — the number of vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n-1$$$ lines each contain two positive integers $$$u_i,v_i$$$ ($$$1\\le u_i,v_i\\le n$$$) — indicating that there is an edge between vertices $$$u_i$$$ and $$$v_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the edges in the input form a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$3\\cdot10^5$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single line containing $$$n-1$$$ integers. The $$$i$$$-th integer represents the minimum "},{"children":[{"kind":"text","text":"inconvenience"}],"kind":"container"},{"kind":"text","text":" for $$$k=i$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n6\n3 4\n6 1\n3 2\n3 1\n4 5\n8\n8 6\n7 4\n8 5\n2 7\n3 2\n5 2\n1 2\n3\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 2 2 3 4 \n1 2 2 2 3 4 5 \n1 2 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, possible solutions for $$$k=1,2,\\ldots,n-1$$$ are as follows:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a531516e3ed499d28e18d4ebed3cba4abd50960eed9a077e19408454a92eacd9.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"2165E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2165/problem/E"}