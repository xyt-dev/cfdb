{"assets":["/statement-assets/d375ad89d54165b420f4297eaa39132d4ce96adbc6a5c2fff2eb728db6f9056e.png"],"contentKind":"statement","contestId":"703","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Mishka and Divisors"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After playing with her beautiful array, Mishka decided to learn some math. After learning how to multiply, divide and what is divisibility, she is now interested in solving the following problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and array "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. You are to find "},{"children":[{"kind":"text","text":"non-empty"}],"kind":"container"},{"kind":"text","text":" subsequence of array elements such that the product of its elements is divisible by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and it contains minimum possible number of elements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, you are to find a sequence of indices "},{"kind":"math_inline","text":"1 ≤ i1 < i2 < ... < im ≤ n"},{"kind":"text","text":" such that "},{"attrs":{"alt":"","src":"/statement-assets/d375ad89d54165b420f4297eaa39132d4ce96adbc6a5c2fff2eb728db6f9056e.png"},"kind":"image"},{"kind":"text","text":" is divisible by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" while "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is minimum possible among all such variants."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are more than one such subsequences, you should choose one among them, such that sum of its elements is "},{"children":[{"kind":"text","text":"minimum possible"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mishka quickly solved this problem. Will you do so?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 1012"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 1012"},{"kind":"text","text":") — array elements."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print single positive integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" in the first line — the number of elements in desired sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" distinct integers — the sequence of indices of given array elements, which should be taken into the desired sequence. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are more than one such subsequence (e.g. subsequence of minimum possible number of elements and with minimum possible sum of elements), you can print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are no such subsequences, print "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":" in the only line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 60\n2 4 6 5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n4 3 1 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"703E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/703/problem/E"}