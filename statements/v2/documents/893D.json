{"assets":[],"contentKind":"statement","contestId":"893","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Credit Card"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recenlty Luba got a credit card and started to use it. Let's consider "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" consecutive days Luba uses the card."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"She starts with "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" money on her account."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"evening"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day a transaction "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" occurs. If "},{"kind":"math_inline","text":"ai > 0"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" bourles are deposited to Luba's account. If "},{"kind":"math_inline","text":"ai < 0"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" bourles are withdrawn. And if "},{"kind":"math_inline","text":"ai = 0"},{"kind":"text","text":", then the amount of money on Luba's account is checked."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"morning"}],"kind":"container"},{"kind":"text","text":" of any of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days Luba can go to the bank and deposit any "},{"children":[{"kind":"text","text":"positive"}],"kind":"container"},{"kind":"text","text":" integer amount of burles to her account. But there is a limitation: the amount of money on the account can never exceed "},{"kind":"math_inline","text":"d"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"It can happen that the amount of money goes greater than "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" by some transaction in the evening. In this case answer will be «-1»."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Luba must not exceed this limit, and also she wants that "},{"children":[{"kind":"text","text":"every day her account is checked"}],"kind":"container"},{"kind":"text","text":" (the days when "},{"kind":"math_inline","text":"ai = 0"},{"kind":"text","text":") the amount of money on her account is non-negative. It takes a lot of time to go to the bank, so Luba wants to know the minimum number of days she needs to deposit some money to her account (if it is possible to meet all the requirements). Help her!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ d ≤ 109"},{"kind":"text","text":") —the number of days and the money limitation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"a1, a2, ... an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 104 ≤ ai ≤ 104"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" represents the transaction in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if Luba cannot deposit the money to her account in such a way that the requirements are met. Otherwise print the minimum number of days Luba has to deposit money."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 10\n-1 5 0 -5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n-10 0 20\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 10\n-5 0 10 -11 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"893D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/893/problem/D"}