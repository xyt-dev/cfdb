{"assets":[],"contentKind":"statement","contestId":"478","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Table Decorations"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" red, "},{"kind":"math_inline","text":"g"},{"kind":"text","text":" green and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" blue balloons. To decorate a single table for the banquet you need exactly three balloons. Three balloons attached to some table shouldn't have the same color. What maximum number "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" of tables can be decorated if we know number of balloons of each color?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to write a program that for given values "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", "},{"kind":"math_inline","text":"g"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" will find the maximum number "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" of tables, that can be decorated in the required manner."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains three integers "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", "},{"kind":"math_inline","text":"g"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ r, g, b ≤ 2·109"},{"kind":"text","text":") — the number of red, green and blue baloons respectively. The numbers are separated by exactly one space."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — the maximum number of tables that can be decorated in the required manner."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample you can decorate the tables with the following balloon sets: \""},{"children":[{"kind":"text","text":"rgg"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"gbb"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"brr"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"rrg"}],"kind":"container"},{"kind":"text","text":"\", where \""},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"g"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\" represent the red, green and blue balls, respectively."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"478C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/478/problem/C"}