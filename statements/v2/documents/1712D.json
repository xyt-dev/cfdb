{"assets":["/statement-assets/d1d3fa0be849076b9c5454e1d16edd4fba63ca0f98e822fabf172b12715e8b7a.png"],"contentKind":"statement","contestId":"1712","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Empty Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"children":[{"kind":"text","text":" — Do you have a wish?"}],"kind":"container"}],"kind":"container"}],"kind":"container"},{"children":[{"children":[{"children":[{"kind":"text","text":" — I want people to stop gifting each other arrays."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"O_o and Another Young Boy"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"An array of $$$n$$$ "},{"children":[{"kind":"text","text":"positive"}],"kind":"container"},{"kind":"text","text":" integers $$$a_1,a_2,\\ldots,a_n$$$ fell down on you from the skies, along with a positive integer $$$k \\le n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can apply the following operation at most $$$k$$$ times: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose an index $$$1 \\le i \\le n$$$ and an integer $$$1 \\le x \\le 10^9$$$. Then do $$$a_i := x$$$ (assign $$$x$$$ to $$$a_i$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Then build a "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Complete_graph"},"children":[{"kind":"text","text":"complete"}],"kind":"link"},{"kind":"text","text":" undirected "},{"children":[{"kind":"text","text":"weighted"}],"kind":"container"},{"kind":"text","text":" graph with $$$n$$$ vertices numbered with integers from $$$1$$$ to $$$n$$$, where edge $$$(l, r)$$$ ($$$1 \\le l \\lt r \\le n$$$) has weight $$$\\min(a_{l},a_{l+1},\\ldots,a_{r})$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to find the maximum possible "},{"children":[{"kind":"text","text":"diameter"}],"kind":"container"},{"kind":"text","text":" of the resulting graph after performing at most $$$k$$$ operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"diameter"}],"kind":"container"},{"kind":"text","text":" of a graph is equal to $$$\\max\\limits_{1 \\le u \\lt v \\le n}{\\operatorname{d}(u, v)}$$$, where $$$\\operatorname{d}(u, v)$$$ is the length of the shortest path between vertex $$$u$$$ and vertex $$$v$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). Description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$k$$$ ($$$2 \\le n \\le 10^5$$$, $$$1 \\le k \\le n$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ "},{"children":[{"kind":"text","text":"positive"}],"kind":"container"},{"kind":"text","text":" integers $$$a_1,a_2,\\ldots,a_n$$$ ($$$1 \\le a_i \\le 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print one integer — the maximum possible diameter of the graph after performing at most $$$k$$$ operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n3 1\n2 4 1\n3 2\n1 9 84\n3 1\n10 2 6\n3 2\n179 17 1000000000\n2 1\n5 9\n2 2\n4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n168\n10\n1000000000\n9\n1000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, one of the optimal arrays is $$$[2,4,5]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The graph built on this array: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d1d3fa0be849076b9c5454e1d16edd4fba63ca0f98e822fabf172b12715e8b7a.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"$$$\\operatorname{d}(1, 2) = \\operatorname{d}(1, 3) = 2$$$ and $$$\\operatorname{d}(2, 3) = 4$$$, so the "},{"children":[{"kind":"text","text":"diameter"}],"kind":"container"},{"kind":"text","text":" is equal to $$$\\max(2,2,4) = 4$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1712D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1712/problem/D"}