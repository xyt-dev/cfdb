{"assets":[],"contentKind":"statement","contestId":"339","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Xenia and Ringroad"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Xenia lives in a city that has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" houses built along the main ringroad. The ringroad houses are numbered 1 through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in the clockwise order. The ringroad traffic is one way and also is clockwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Xenia has recently moved into the ringroad house number 1. As a result, she's got "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" things to do. In order to complete the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th task, she needs to be in the house number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and complete all tasks with numbers less than "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". Initially, Xenia is in the house number 1, find the minimum time she needs to complete all her tasks if moving from a house to a neighboring one along the ringroad takes one unit of time."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(2 ≤ n ≤ 105, 1 ≤ m ≤ 105)"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., am"},{"kind":"math_inline","text":"(1 ≤ ai ≤ n)"},{"kind":"text","text":". Note that Xenia can have multiple consecutive tasks in one house."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the time Xenia needs to complete all tasks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n3 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n2 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test example the sequence of Xenia's moves along the ringroad looks as follows: "},{"kind":"math_inline","text":"1 → 2 → 3 → 4 → 1 → 2 → 3"},{"kind":"text","text":". This is optimal sequence. So, she needs 6 time units."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"339B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/339/problem/B"}