{"assets":[],"contentKind":"statement","contestId":"254","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Anagram"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"input_channel"},"children":[{"children":[{"kind":"text","text":"input"}],"kind":"container"},{"kind":"text","text":"input.txt"}],"kind":"container"},{"attrs":{"role":"output_channel"},"children":[{"children":[{"kind":"text","text":"output"}],"kind":"container"},{"kind":"text","text":"output.txt"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"String "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is an "},{"children":[{"kind":"text","text":"anagram"}],"kind":"container"},{"kind":"text","text":" of string "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", if we can rearrange the letters in string "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and get exact string "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". For example, strings \""},{"children":[{"kind":"text","text":"DOG"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"GOD"}],"kind":"container"},{"kind":"text","text":"\" are anagrams, so are strings \""},{"children":[{"kind":"text","text":"BABA"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"AABB"}],"kind":"container"},{"kind":"text","text":"\", but strings \""},{"children":[{"kind":"text","text":"ABBAC"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"CAABA"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given two strings "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" of the same length, consisting of uppercase English letters. You need to get the anagram of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" from string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". You are permitted to perform the replacing operation: every operation is replacing some character from the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" by any other character. Get the anagram of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in the least number of replacing operations. If you can get multiple anagrams of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in the least number of operations, get the lexicographically minimal one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The lexicographic order of strings is the familiar to us \"dictionary\" order. Formally, the string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is lexicographically smaller than string "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" of the same length, if "},{"kind":"math_inline","text":"p1 = q1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p2 = q2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"pk - 1 = qk - 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"pk < qk"},{"kind":"text","text":" for some "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":"). Here characters in the strings are numbered from 1. The characters of the strings are compared in the alphabetic order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of two lines. The first line contains string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", the second line contains string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". The strings have the same length (from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"105"},{"kind":"text","text":" characters) and consist of uppercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" — the minimum number of replacement operations, needed to get an anagram of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" from string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". In the second line print the lexicographically minimum anagram that could be obtained in "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ABA\nCBA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\nABC\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"CDBABC\nADCABD\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\nADBADC\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The second sample has eight anagrams of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", that can be obtained from string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" by replacing exactly two letters: \""},{"children":[{"kind":"text","text":"ADBADC"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ADDABC"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"CDAABD"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"CDBAAD"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"CDBADA"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"CDDABA"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"DDAABC"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"DDBAAC"}],"kind":"container"},{"kind":"text","text":"\". These anagrams are listed in the lexicographical order. The lexicographically minimum anagram is \""},{"children":[{"kind":"text","text":"ADBADC"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"254C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/254/problem/C"}