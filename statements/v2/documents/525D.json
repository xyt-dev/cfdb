{"assets":[],"contentKind":"statement","contestId":"525","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Arthur and Walls"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Finally it is a day when Arthur has enough money for buying an apartment. He found a great option close to the center of the city with a nice price."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Plan of the apartment found by Arthur looks like a rectangle "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" consisting of squares of size "},{"kind":"math_inline","text":"1 × 1"},{"kind":"text","text":". Each of those squares contains either a wall (such square is denoted by a symbol \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\" on the plan) or a free space (such square is denoted on the plan by a symbol \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Room in an apartment is a maximal connected area consisting of free squares. Squares are considered adjacent if they share a common side."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The old Arthur dream is to live in an apartment where all rooms are rectangles. He asks you to calculate minimum number of walls you need to remove in order to achieve this goal. After removing a wall from a square it becomes a free square. While removing the walls it is possible that some rooms unite into a single one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n, m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 2000"},{"kind":"text","text":") denoting the size of the Arthur apartments."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each contain "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" symbols — the plan of the apartment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the cell is denoted by a symbol \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\" then it contains a wall."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the cell is denoted by a symbol \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" then it this cell is free from walls and also this cell is contained in some of the rooms."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows each consisting of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" symbols that show how the Arthur apartment plan should look like after deleting the minimum number of walls in order to make each room (maximum connected area free from walls) be a rectangle. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several possible answers, output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"a