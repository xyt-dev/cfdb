{"assets":[],"contentKind":"statement","contestId":"673","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Bear and Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bear Limak likes watching sports on TV. He is going to watch a game today. The game lasts "},{"kind":"math_inline","text":"90"},{"kind":"text","text":" minutes and there are no breaks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each minute can be either interesting or boring. If "},{"kind":"math_inline","text":"15"},{"kind":"text","text":" consecutive minutes are boring then Limak immediately turns TV off."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You know that there will be "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" interesting minutes "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":". Your task is to calculate for how many minutes Limak will watch the game."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 90"},{"kind":"text","text":") — the number of interesting minutes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t1 < t2 < ... tn ≤ 90"},{"kind":"text","text":"), given in the increasing order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of minutes Limak will watch the game."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n7 20 88\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"35\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n16 20 30 40 50 60 70 80 90\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"15\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n15 20 30 40 50 60 70 80 90\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"90\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, minutes "},{"kind":"math_inline","text":"21, 22, ..., 35"},{"kind":"text","text":" are all boring and thus Limak will turn TV off immediately after the "},{"kind":"math_inline","text":"35"},{"kind":"text","text":"-th minute. So, he would watch the game for "},{"kind":"math_inline","text":"35"},{"kind":"text","text":" minutes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the first "},{"kind":"math_inline","text":"15"},{"kind":"text","text":" minutes are boring."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, there are no consecutive "},{"kind":"math_inline","text":"15"},{"kind":"text","text":" boring minutes. So, Limak will watch the whole game."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"673A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/673/problem/A"}