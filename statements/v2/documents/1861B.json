 = 6$$$; after this operation, $$$a$$$ is "},{"children":[{"kind":"text","text":"000111"}],"kind":"container"},{"kind":"text","text":", $$$b$$$ is "},{"children":[{"kind":"text","text":"010111"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" choose the string $$$b$$$, $$$l = 1$$$, $$$r = 3$$$; after this operation, $$$a$$$ is "},{"children":[{"kind":"text","text":"000111"}],"kind":"container"},{"kind":"text","text":", $$$b$$$ is "},{"children":[{"kind":"text","text":"000111"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the fourth and fifth test cases, it's impossible to make the given strings equal."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1861B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1861/problem/B"}