{"assets":[],"contentKind":"statement","contestId":"1861","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Two Binary Strings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two strings $$$a$$$ and $$$b$$$ of equal length, consisting of only characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"; both strings start with character "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and end with character "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can perform the following operation any number of times (possibly zero): "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" choose one of the strings and two "},{"children":[{"kind":"text","text":"equal"}],"kind":"container"},{"kind":"text","text":" characters in it; then turn all characters between them into those characters. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Formally, you choose one of these two strings (let the chosen string be $$$s$$$), then pick two integers $$$l$$$ and $$$r$$$ such that $$$1 \\le l \\lt r \\le |s|$$$ and $$$s_l = s_r$$$, then replace every character $$$s_i$$$ such that $$$l \\lt i \\lt r$$$ with $$$s_l$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if the chosen string is "},{"children":[{"kind":"text","text":"010101"}],"kind":"container"},{"kind":"text","text":", you can transform it into one of the following strings by applying one operation:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"000101"}],"kind":"container"},{"kind":"text","text":" if you choose $$$l = 1$$$ and $$$r = 3$$$; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"000001"}],"kind":"container"},{"kind":"text","text":" if you choose $$$l = 1$$$ and $$$r = 5$$$; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"010001"}],"kind":"container"},{"kind":"text","text":" if you choose $$$l = 3$$$ and $$$r = 5$$$; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"010111"}],"kind":"container"},{"kind":"text","text":" if you choose $$$l = 4$$$ and $$$r = 6$$$; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"011111"}],"kind":"container"},{"kind":"text","text":" if you choose $$$l = 2$$$ and $$$r = 6$$$; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"011101"}],"kind":"container"},{"kind":"text","text":" if you choose $$$l = 2$$$ and $$$r = 4$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You have to determine if it's possible to make the given strings equal by applying this operation any number of times."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 2000$$$)  — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two lines: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the first line contains the string $$$a$$$ ($$$2 \\le |a| \\le 5000$$$), consisting of only characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the second line contains the string $$$b$$$ ($$$2 \\le |b| \\le 5000$$$), consisting of only characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Additional constraints on the input: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" in each test case, $$$|a| = |b|$$$ (the strings have equal length); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in each test case, both strings start with "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and end with "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the total length of all strings $$$a$$$ in all test cases does not exceed $$$5000$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" if it is possible to make the strings equal. Otherwise, print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":". You can print each letter in any register."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"ch