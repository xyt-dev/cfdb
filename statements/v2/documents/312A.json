{"assets":[],"contentKind":"statement","contestId":"312","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Whose sentence is it?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day, liouzhou_101 got a chat record of Freda and Rainbow. Out of curiosity, he wanted to know which sentences were said by Freda, and which were said by Rainbow. According to his experience, he thought that Freda always said \""},{"children":[{"kind":"text","text":"lala."}],"kind":"container"},{"kind":"text","text":"\" at the end of her sentences, while Rainbow always said \""},{"children":[{"kind":"text","text":"miao."}],"kind":"container"},{"kind":"text","text":"\" at the beginning of his sentences. For each sentence in the chat record, help liouzhou_101 find whose sentence it is. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10"},{"kind":"text","text":"), number of sentences in the chat record. Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains a sentence. A sentence is a string that contains only Latin letters ("},{"children":[{"kind":"text","text":"A-Z"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a-z"}],"kind":"container"},{"kind":"text","text":"), underline ("},{"children":[{"kind":"text","text":"_"}],"kind":"container"},{"kind":"text","text":"), comma ("},{"children":[{"kind":"text","text":","}],"kind":"container"},{"kind":"text","text":"), point ("},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":") and space ("},{"kind":"container"},{"kind":"text","text":"). Its length doesn’t exceed 100."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each sentence, output \""},{"children":[{"kind":"text","text":"Freda's"}],"kind":"container"},{"kind":"text","text":"\" if the sentence was said by Freda, \""},{"children":[{"kind":"text","text":"Rainbow's"}],"kind":"container"},{"kind":"text","text":"\" if the sentence was said by Rainbow, or \""},{"children":[{"kind":"text","text":"OMG>.< I don't know!"}],"kind":"container"},{"kind":"text","text":"\" if liouzhou_101 can’t recognize whose sentence it is. He can’t recognize a sentence if it begins with \""},{"children":[{"kind":"text","text":"miao."}],"kind":"container"},{"kind":"text","text":"\" and ends with \""},{"children":[{"kind":"text","text":"lala."}],"kind":"container"},{"kind":"text","text":"\", or satisfies neither of the conditions. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nI will go to play with you lala.\nwow, welcome.\nmiao.lala.\nmiao.\nmiao .\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Freda's\nOMG>.< I don't know!\nOMG>.< I don't know!\nRainbow's\nOMG>.< I don't know!\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"312A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/312/problem/A"}