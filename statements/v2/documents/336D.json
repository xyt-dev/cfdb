{"assets":[],"contentKind":"statement","contestId":"336","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Vasily the Bear and Beautiful Strings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasily the Bear loves "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" strings. String "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if it meets the following criteria: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" String "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" only consists of characters "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", at that character "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" must occur in string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" times, and character "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" must occur exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" times. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" We can obtain character "},{"kind":"math_inline","text":"g"},{"kind":"text","text":" from string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" with some (possibly, zero) number of modifications. The character "},{"kind":"math_inline","text":"g"},{"kind":"text","text":" equals either zero or one. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"modification"}],"kind":"container"},{"kind":"text","text":" of string with length at least two is the following operation: we replace two last characters from the string by exactly one other character. This character equals one if it replaces two zeros, otherwise it equals zero. For example, one modification transforms string \"01010\" into string \"0100\", two modifications transform it to \"011\". It is forbidden to modify a string with length less than two."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the Bear, count the number of "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" strings. As the number of beautiful strings can be rather large, print the remainder after dividing the number by "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three space-separated integers "},{"kind":"math_inline","text":"n, m, g"},{"kind":"math_inline","text":"(0 ≤ n, m ≤ 105, n + m ≥ 1, 0 ≤ g ≤ 1)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the answer to the problem modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the beautiful strings are: \"01\", \"10\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the beautiful strings are: \"0011\", \"1001\", \"1010\", \"1100\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample there are no beautiful strings."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"336D","schem