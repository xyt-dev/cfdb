{"assets":["/statement-assets/072acff6c0d4a701a13fdabf4aa1808f040dc77e990401d30666c6fe18bca12c.png"],"contentKind":"statement","contestId":"126","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. E-reader Display"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After years of hard work scientists invented an absolutely new e-reader display. The new display has a larger resolution, consumes less energy and its production is cheaper. And besides, one can bend it. The only inconvenience is highly unusual management. For that very reason the developers decided to leave the e-readers' software to programmers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The display is represented by "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" square of pixels, each of which can be either black or white. The display rows are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" upside down, the columns are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from the left to the right. The display can perform commands like \""},{"kind":"math_inline","text":"x, y"},{"kind":"text","text":"\". When a traditional display fulfills such command, it simply inverts a color of "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is the row number and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is the column number. But in our new display every pixel that belongs to at least one of the segments "},{"kind":"math_inline","text":"(x, x) - (x, y)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(y, y) - (x, y)"},{"kind":"text","text":" (both ends of both segments are included) inverts a color."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if initially a display "},{"kind":"math_inline","text":"5 × 5"},{"kind":"text","text":" in size is absolutely white, then the sequence of commands "},{"kind":"math_inline","text":"(1, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 5)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(5, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 3)"},{"kind":"text","text":" leads to the following changes:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/072acff6c0d4a701a13fdabf4aa1808f040dc77e990401d30666c6fe18bca12c.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"You are an e-reader software programmer and you should calculate minimal number of commands needed to display the picture. You can regard all display pixels as initially white."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters each: the description of the picture that needs to be shown. \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" represents the white color and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" represents the black color. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" — the least number of commands needed to display the picture."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n01110\n10010\n10001\n10011\n11110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"126C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/126/problem/C"}