{"assets":[],"contentKind":"statement","contestId":"653","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Move by Prime"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pussycat Sonya has an array consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers. There are "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" possible subsequences of the array. For each subsequence she counts the minimum number of operations to make all its elements equal. Each operation must be one of two:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose some element of the subsequence and multiply it by some prime number. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Choose some element of the subsequence and divide it by some prime number. The chosen element must be divisible by the chosen prime number. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"What is the sum of minimum number of operations for all "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" possible subsequences? Find and print this sum modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 300 000"},{"kind":"text","text":") — the size of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 300 000"},{"kind":"text","text":") — elements of the array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the sum of minimum number of operation for all possible subsequences of the given array modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n60 60 40\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"24\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, there are "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" possible subsequences: "},{"kind":"math_inline","text":"(60, 60, 40)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(60, 60)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(60, 40)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(60, 40)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(60)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(60)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(40)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"()"},{"kind":"text","text":" (empty subsequence)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a subsequence "},{"kind":"math_inline","text":"(60, 60, 40)"},{"kind":"text","text":" we can make all elements equal by two operations — divide "},{"kind":"math_inline","text":"40"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to get "},{"kind":"math_inline","text":"20"},{"kind":"text","text":", and then multiply "},{"kind":"math_inline","text":"20"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" to get "},{"kind":"math_inline","text":"60"},{"kind":"text","text":". It's impossible to achieve the goal using less operations and thus we add "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are two subsequences equal to "},{"kind":"math_inline","text":"(60, 40)"},{"kind":"text","text":" and for each of them the also need to make at least "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In each of other subsequences all numbers are already equal, so we need "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" operations for each of them. The sum is equal to "},{"kind":"math_inline","text":"2 + 2 + 2 = 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"653G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/653/problem/G"}