{"assets":[],"contentKind":"statement","contestId":"164","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Ancient Berland Hieroglyphs"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarpus enjoys studying Berland hieroglyphs. Once Polycarp got hold of two ancient Berland pictures, on each of which was drawn a circle of hieroglyphs. We know that no hieroglyph occurs twice in either the first or the second circle (but in can occur once in each of them)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus wants to save these pictures on his laptop, but the problem is, laptops do not allow to write hieroglyphs circles. So Polycarp had to break each circle and write down all of its hieroglyphs in a clockwise order in one line. A line obtained from the first circle will be called "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and the line obtained from the second one will be called "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are quite many ways to break hieroglyphic circles, so Polycarpus chooses the method, that makes the length of the largest substring of string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", which occurs as a subsequence in string "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", maximum."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Polycarpus — find the maximum possible length of the desired substring (subsequence) if the first and the second circles are broken optimally."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"length"}],"kind":"container"},{"kind":"text","text":" of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is the number of characters in it. If we denote the length of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":", we can write the string as "},{"kind":"math_inline","text":"s = s1s2... s|s|"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a non-empty string "},{"kind":"math_inline","text":"x = s[a... b] = sasa + 1... sb"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a ≤ b ≤ |s|"},{"kind":"text","text":"). For example, \""},{"children":[{"kind":"text","text":"code"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"force"}],"kind":"container"},{"kind":"text","text":"\" are substrings of \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\", while \""},{"children":[{"kind":"text","text":"coders"}],"kind":"container"},{"kind":"text","text":"\" is not. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"subsequence"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a non-empty string "},{"kind":"math_inline","text":"y = s[p1p2... p|y|] = sp1sp2... sp|y|"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ p1 < p2 < ... < p|y| ≤ |s|"},{"kind":"text","text":"). For example, \""},{"children":[{"kind":"text","text":"coders"}],"kind":"container"},{"kind":"text","text":"\" is a subsequence of \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"la"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"lb"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ la, lb ≤ 1000000"},{"kind":"text","text":") — the number of hieroglyphs in the first and second circles, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Below, due to difficulties with encoding of Berland hieroglyphs, they are given as integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"106"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"la"},{"kind":"text","text":" integers — the hieroglyphs in the first picture, in the clockwise order, starting with one of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"lb"},{"kind":"text","text":" integers — the hieroglyphs in the second picture, in the clockwise order, starting with one of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the first circle doesn't contain a hieroglyph, which occurs twice. The second circle also has this property."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the maximum length of the common substring and subsequence. If at any way of breaking the circles it does not exist, print "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n1 2 3 4 5\n1 3 5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 6\n1 3 5 2\n1 2 3 4 5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2 3\n3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test Polycarpus picks a string that consists of hieroglyphs 5 and 1, and in the second sample — from hieroglyphs 1, 3 and 5."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"164B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/164/problem/B"}