{"assets":[],"contentKind":"statement","contestId":"675","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Money Transfers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" banks in the city where Vasya lives, they are located in a circle, such that any two banks are neighbouring if their indices differ by no more than "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Also, bank "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and bank "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" are neighbours if "},{"kind":"math_inline","text":"n > 1"},{"kind":"text","text":". No bank is a neighbour of itself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya has an account in each bank. Its balance may be negative, meaning Vasya owes some money to this bank."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is only one type of operations available: transfer some amount of money from any bank to account in any "},{"children":[{"kind":"text","text":"neighbouring"}],"kind":"container"},{"kind":"text","text":" bank. There are no restrictions on the size of the sum being transferred or balance requirements to perform this operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya doesn't like to deal with large numbers, so he asks you to determine the minimum number of operations required to change the balance of each bank account to zero. It's guaranteed, that this is possible to achieve, that is, the total balance of Vasya in all banks is equal to zero."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of banks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ ai ≤ 109"},{"kind":"text","text":"), the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them is equal to the initial balance of the account in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th bank. It's guaranteed that the sum of all "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of operations required to change balance in each bank to zero."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n5 0 -5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n-1 0 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 3 -6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Vasya may transfer "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" from the first bank to the third."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, Vasya may first transfer "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" from the third bank to the second, and then "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" from the second to the first."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, the following sequence provides the optimal answer: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" transfer "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" from the first bank to the second bank; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" transfer "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" from the second bank to the third; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" transfer "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" from the third bank to the fourth. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"675C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/675/problem/C"}