{"assets":[],"contentKind":"statement","contestId":"1411","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Grime Zoo"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Currently, XXOC's rap is a string consisting of zeroes, ones, and question marks. Unfortunately, haters gonna hate. They will write $$$x$$$ angry comments for every occurrence of "},{"children":[{"kind":"text","text":"subsequence"}],"kind":"container"},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" and $$$y$$$ angry comments for every occurrence of "},{"children":[{"kind":"text","text":"subsequence"}],"kind":"container"},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":". You should replace all the question marks with "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" in such a way that the number of angry comments would be as small as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"String $$$b$$$ is a subsequence of string $$$a$$$, if it can be obtained by removing some characters from $$$a$$$. Two occurrences of a subsequence are considered distinct if sets of positions of remaining characters are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains string $$$s$$$ — XXOC's rap ($$$1 \\le |s| \\leq 10^5$$$). The second line contains two integers $$$x$$$ and $$$y$$$ — the number of angry comments XXOC will recieve for every occurrence of "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" accordingly ($$$0 \\leq x, y \\leq 10^6$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the minimum number of angry comments."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n0?1\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n?????\n13 37\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n?10?\n239 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n28\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n01101001\n5 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n96\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example one of the optimum ways to replace is "},{"children":[{"kind":"text","text":"001"}],"kind":"container"},{"kind":"text","text":". Then there will be $$$2$$$ subsequences "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" and $$$0$$$ subsequences "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":". Total number of angry comments will be equal to $$$2 \\cdot 2 + 0 \\cdot 3 = 4$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example one of the optimum ways to replace is "},{"children":[{"kind":"text","text":"11111"}],"kind":"container"},{"kind":"text","text":". Then there will be $$$0$$$ subsequences "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" and $$$0$$$ subsequences "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":". Total number of angry comments will be equal to $$$0 \\cdot 13 + 0 \\cdot 37 = 0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example one of the optimum ways to replace is "},{"children":[{"kind":"text","text":"1100"}],"kind":"container"},{"kind":"text","text":". Then there will be $$$0$$$ subsequences "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" and $$$4$$$ subsequences "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":". Total number of angry comments will be equal to $$$0 \\cdot 239 + 4 \\cdot 7 = 28$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example one of the optimum ways to replace is "},{"children":[{"kind":"text","text":"01101001"}],"kind":"container"},{"kind":"text","text":". Then there will be $$$8$$$ subsequences "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" and $$$8$$$ subsequences "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":". Total number of angry comments will be equal to $$$8 \\cdot 5 + 8 \\cdot 7 = 96$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1411D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1411/problem/D"}