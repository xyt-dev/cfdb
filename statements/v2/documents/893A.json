{"assets":[],"contentKind":"statement","contestId":"893","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Chess For Three"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Alex, Bob and Carl will soon participate in a team chess tournament. Since they are all in the same team, they have decided to practise really hard before the tournament. But it's a bit difficult for them because chess is a game for two players, not three."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So they play with each other according to following rules:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Alex and Bob play the first game, and Carl is spectating; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" When the game ends, the one who lost the game becomes the spectator in the next game, and the one who was spectating plays against the winner. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Alex, Bob and Carl play in such a way that there are no draws."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Today they have played "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" games, and for each of these games they remember who was the winner. They decided to make up a log of games describing who won each game. But now they doubt if the information in the log is correct, and they want to know if the situation described in the log they made up was possible (that is, no game is won by someone who is spectating if Alex, Bob and Carl play according to the rules). Help them to check it!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of games Alex, Bob and Carl played."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, describing the game log. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains one integer "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 3"},{"kind":"text","text":") which is equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" if Alex won "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th game, to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" if Bob won "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th game and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" if Carl won "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th game."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" if the situation described in the log was possible. Otherwise print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1\n1\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the possible situation is:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Alex wins, Carl starts playing instead of Bob; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Alex wins, Bob replaces Carl; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Bob wins. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The situation in the second example is impossible because Bob loses the first game, so he cannot win the second one."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"893A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/893/problem/A"}