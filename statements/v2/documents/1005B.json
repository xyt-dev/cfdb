{"assets":[],"contentKind":"statement","contestId":"1005","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Delete from the Left"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two strings $$$s$$$ and $$$t$$$. In a single move, you can choose any of two strings and delete the first (that is, the leftmost) character. After a move, the length of the string decreases by $$$1$$$. You can't choose a string if it is empty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" by applying a move to the string \""},{"children":[{"kind":"text","text":"where"}],"kind":"container"},{"kind":"text","text":"\", the result is the string \""},{"children":[{"kind":"text","text":"here"}],"kind":"container"},{"kind":"text","text":"\", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" by applying a move to the string \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", the result is an empty string \"\". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are required to make two given strings equal using the fewest number of moves. It is possible that, in the end, both strings will be equal to the empty string, and so, are equal to each other. In this case, the answer is obviously the sum of the lengths of the initial strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Write a program that finds the minimum number of moves to make two given strings $$$s$$$ and $$$t$$$ equal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains $$$s$$$. In the second line of the input contains $$$t$$$. Both strings consist only of lowercase Latin letters. The number of letters in each string is between 1 and $$$2\\cdot10^5$$$, inclusive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the fewest number of moves required. It is possible that, in the end, both strings will be equal to the empty string, and so, are equal to each other. In this case, the answer is obviously the sum of the lengths of the given strings."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"test\nwest\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"codeforces\nyes\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"test\nyes\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"b\nab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, you should apply the move once to the first string and apply the move once to the second string. As a result, both strings will be equal to \""},{"children":[{"kind":"text","text":"est"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, the move should be applied to the string \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\" $$$8$$$ times. As a result, the string becomes \""},{"children":[{"children":[{"kind":"text","text":"codeforc"}],"kind":"container"},{"kind":"text","text":"es"}],"kind":"container"},{"kind":"text","text":"\" $$$\\to$$$ \""},{"children":[{"kind":"text","text":"es"}],"kind":"container"},{"kind":"text","text":"\". The move should be applied to the string \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\" once. The result is the same string \""},{"children":[{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":"es"}],"kind":"container"},{"kind":"text","text":"\" $$$\\to$$$ \""},{"children":[{"kind":"text","text":"es"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, you can make the strings equal only by completely deleting them. That is, in the end, both strings will be empty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example, the first character of the second string should be deleted."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1005B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1005/problem/B"}