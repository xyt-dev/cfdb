{"assets":[],"contentKind":"statement","contestId":"317","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Ants"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"It has been noted that if some ants are put in the junctions of the graphene integer lattice then they will act in the following fashion: every minute at each junction ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":") containing at least four ants a group of four ants will be formed, and these four ants will scatter to the neighbouring junctions ("},{"kind":"math_inline","text":"x + 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"), ("},{"kind":"math_inline","text":"x - 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"), ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y + 1"},{"kind":"text","text":"), ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y - 1"},{"kind":"text","text":") — one ant in each direction. No other ant movements will happen. Ants never interfere with each other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Scientists have put a colony of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ants into the junction (0, 0) and now they wish to know how many ants will there be at some given junctions, when the movement of the ants stops."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First input line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ n ≤ 30000"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 50000"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the number of ants in the colony and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is the number of queries. Each of the next "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines contains coordinates of a query junction: integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ xi, yi ≤ 109"},{"kind":"text","text":"). Queries may coincide."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there will be a certain moment of time when no possible movements can happen (in other words, the process will eventually end)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" integers, one per line — the number of ants at the corresponding junctions when the movement of the ants stops."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n0 1\n0 0\n0 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n1\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 5\n0 -2\n0 -1\n0 0\n0 1\n0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n1\n2\n1\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the colony consists of the one ant, so nothing happens at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the colony consists of 6 ants. At the first minute 4 ants scatter from (0, 0) to the neighbouring junctions. After that the process stops."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"317B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/317/problem/B"}