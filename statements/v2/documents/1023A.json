{"assets":[],"contentKind":"statement","contestId":"1023","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Single Wildcard Pattern Matching"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two strings $$$s$$$ and $$$t$$$. The string $$$s$$$ consists of lowercase Latin letters and "},{"children":[{"kind":"text","text":"at most one"}],"kind":"container"},{"kind":"text","text":" wildcard character '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"', the string $$$t$$$ consists only of lowercase Latin letters. The length of the string $$$s$$$ equals $$$n$$$, the length of the string $$$t$$$ equals $$$m$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The wildcard character '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"' in the string $$$s$$$ (if any) can be replaced with an arbitrary sequence (possibly empty) of lowercase Latin letters. No other character of $$$s$$$ can be replaced with anything. If it is possible to replace a wildcard character '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"' in $$$s$$$ to obtain a string $$$t$$$, then the string $$$t$$$ matches the pattern $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if $$$s=$$$\""},{"children":[{"kind":"text","text":"aba*aba"}],"kind":"container"},{"kind":"text","text":"\" then the following strings match it \""},{"ch