{"assets":["/statement-assets/069080f9966462754b1b018c31c28a47cb0f74ac62ab78ff46d325d3ca1cc040.png","/statement-assets/2b777dca830b072d4de6b69131c4613be07a1bd83be95687ff540647e7e095be.png"],"contentKind":"statement","contestId":"300","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Coach"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A programming coach has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students to teach. We know that "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is divisible by "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". Let's assume that all students are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", inclusive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Before the university programming championship the coach wants to split all students into groups of three. For some pairs of students we know that they want to be on the same team. Besides, if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th student wants to be on the same team with the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th one, then the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th student wants to be on the same team with the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th one. The coach wants the teams to show good results, so he wants the following condition to hold: if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th student wants to be on the same team with the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th, then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th and the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th students must be on the same team. Also, it is obvious that each student must be on exactly one team."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the coach and divide the teams the way he wants."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(3 ≤ n ≤ 48"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/069080f9966462754b1b018c31c28a47cb0f74ac62ab78ff46d325d3ca1cc040.png"},"kind":"image"},{"kind":"text","text":". Then follow "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines, each contains a pair of integers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"math_inline","text":"(1 ≤ ai < bi ≤ n)"},{"kind":"text","text":" — the pair "},{"kind":"math_inline","text":"ai, bi"},{"kind":"text","text":" means that students with numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" want to be on the same team."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is divisible by "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". It is guaranteed that each pair "},{"kind":"math_inline","text":"ai, bi"},{"kind":"text","text":" occurs in the input at most once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the required division into teams doesn't exist, print number "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". Otherwise, print "},{"attrs":{"alt":"","src":"/statement-assets/2b777dca830b072d4de6b69131c4613be07a1bd83be95687ff540647e7e095be.png"},"kind":"image"},{"kind":"text","text":" lines. In each line print three integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"zi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi, zi ≤ n"},{"kind":"text","text":") — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th team. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 2 1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 4\n1 2\n2 3\n3 4\n5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2\n2 3\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 2 1 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"300B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/300/problem/B"}