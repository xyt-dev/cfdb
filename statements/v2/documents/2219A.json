{"assets":["/statement-assets/0d52cc2a0b7721068e1159e39113d04eca811d61eafa7d60becca53d8691ce1d.png","/statement-assets/6836262d6a6f66d41301224e1581cee268cf2b084fd595b0ad7d1151539b2cd1.png"],"contentKind":"statement","contestId":"2219","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Grid L"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Roger has $$$p$$$ unit-length segments and $$$q$$$ L-shaped pieces, each formed by joining two unit-length segments at a right angle."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0d52cc2a0b7721068e1159e39113d04eca811d61eafa7d60becca53d8691ce1d.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"He wants to use all of these pieces, with no piece left unused, to form a grid of dimensions $$$n \\times m$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given $$$p$$$ and $$$q$$$, determine whether there exist positive integers $$$n$$$ and $$$m$$$ such that an $$$n \\times m$$$ grid can be formed using exactly $$$p$$$ unit-length segments and $$$q$$$ L-shaped pieces, possibly rotating them, and provide any valid $$$n$$$ and $$$m$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 100$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$p$$$ and $$$q$$$ ($$$1 \\le p, q \\le 10^8$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print any valid $$$n$$$ and $$$m$$$ such that it's possible to construct $$$n \\times m$$$ using all pieces. If there are no such $$$n$$$ and $$$m$$$, print $$$-1$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n1 2\n1 3\n5 1\n2 5\n2 10\n100000000 100000000\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n1 2\n1 2\n2 2\n2 4\n-1\n-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here are the constructions for examples 2, 3, and 4. We use a different color for different L-shaped pieces, black for all unit-length segments."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6836262d6a6f66d41301224e1581cee268cf2b084fd595b0ad7d1151539b2cd1.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2219A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2219/problem/A"}