{"assets":[],"contentKind":"statement","contestId":"243","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Matrix"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's consider an "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" square matrix, consisting of digits one and zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We'll consider a matrix "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":", if it meets the following condition: in each row of the matrix all ones go in one group. That is, each row of the matrix looks like that "},{"kind":"math_inline","text":"00...0011...1100...00"},{"kind":"text","text":" (or simply consists of zeroes if it has no ones)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given matrix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":", consisting of zeroes and ones. Your task is to determine whether you can get a good matrix "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" from it by rearranging the columns or not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 500"},{"kind":"text","text":") — the size of matrix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" following lines contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" — matrix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". Note that the characters are written without separators."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" in the first line, if you can rearrange the matrix columns so as to get a good matrix "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". In the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines print the good matrix "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". If there are multiple answers, you are allowed to print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it is impossible to get a good matrix, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n100010\n110110\n011001\n010010\n000100\n011001\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n011000\n111100\n000111\n001100\n100000\n000111\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n110\n101\n011\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"243E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/243/problem/E"}