{"assets":[],"contentKind":"statement","contestId":"920","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Tanks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya sometimes has to water his field. To water the field, Petya needs a tank with exactly "},{"kind":"math_inline","text":"V"},{"kind":"text","text":" ml of water."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya has got "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" tanks, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them initially containing "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ml of water. The tanks are really large, any of them can contain any amount of water (no matter how large this amount is)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also Petya has got a scoop that can contain up to "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" ml of water (initially the scoop is empty). This scoop can be used to get some water from some tank, and after that pour it all into some tank (it is impossible to get water from multiple tanks without pouring it, or leave some water in the scoop when pouring it). When Petya tries to get some water from a tank, he gets "},{"kind":"math_inline","text":"min(v, K)"},{"kind":"text","text":" water, where "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is the current volume of water in the tank."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Is it possible to obtain a tank with exactly "},{"kind":"math_inline","text":"V"},{"kind":"text","text":" ml of water using these operations? If it is possible, print a sequence of operations that allows to do it. If there are multiple ways to obtain needed amount of water in some tank, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"N"},{"kind":"math_inline","text":"(2 ≤ N ≤ 5000)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"K"},{"kind":"math_inline","text":"(1 ≤ K ≤ 5000)"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"V"},{"kind":"math_inline","text":"(0 ≤ V ≤ 109)"},{"kind":"text","text":" — the number of tanks, the maximum volume of water the scoop can contain, and the required amount of water in some tank, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"(0 ≤ ai ≤ 105)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is initial volume of water in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th tank."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is impossible to obtain a tank with exactly "},{"kind":"math_inline","text":"V"},{"kind":"text","text":" ml of water, print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" in the first line, and beginning from the second line, print the sequence of operations in the following format: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each line has to contain "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" numbers denoting a compressed operation: \""},{"kind":"math_inline","text":"cnt"},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"y"},{"kind":"text","text":"\" "},{"kind":"math_inline","text":"(1 ≤ cnt ≤ 109, 1 ≤ x, y ≤ N)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is the index of the tank where we get water, "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is the index of the tank where we pour water, and "},{"kind":"math_inline","text":"cnt"},{"kind":"text","text":" is the number of times we transfer water from tank "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to tank "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The number of these lines "},{"children":[{"kind":"text","text":"must not exceed "},{"kind":"math_inline","text":"N + 5"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 5\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1 2 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 4\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 0\n1 3 5 7 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n2 2 1\n3 3 1\n4 4 1\n5 5 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"920D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/920/problem/D"}