{"assets":[],"contentKind":"statement","contestId":"413","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Maze 2D"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The last product of the R2 company in the 2D games' field is a new revolutionary algorithm of searching for the shortest path in a "},{"kind":"math_inline","text":"2 × n"},{"kind":"text","text":" maze."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Imagine a maze that looks like a "},{"kind":"math_inline","text":"2 × n"},{"kind":"text","text":" rectangle, divided into unit squares. Each unit square is either an empty cell or an obstacle. In one unit of time, a person can move from an empty cell of the maze to any side-adjacent empty cell. The shortest path problem is formulated as follows. Given two free maze cells, you need to determine the minimum time required to go from one cell to the other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, the developed algorithm works well for only one request for finding the shortest path, in practice such requests occur quite often. You, as the chief R2 programmer, are commissioned to optimize the algorithm to find the shortest path. Write a program that will effectively respond to multiple requests to find the shortest path in a "},{"kind":"math_inline","text":"2 × n"},{"kind":"text","text":" maze."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n ≤ 2·105; 1 ≤ m ≤ 2·105)"},{"kind":"text","text":" — the width of the maze and the number of queries, correspondingly. Next two lines contain the maze. Each line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters, each character equals either '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' (empty cell), or '"},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"' (obstacle)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ui"},{"kind":"math_inline","text":"(1 ≤ vi, ui ≤ 2n)"},{"kind":"text","text":" — the description of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th request. Numbers "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" mean that you need to print the value of the shortest path from the cell of the maze number "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" to the cell number "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":". We assume that the cells of the first line of the maze are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", from left to right, and the cells of the second line are numbered from "},{"kind":"math_inline","text":"n + 1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" from left to right. It is guaranteed that both given cells are empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print the answer to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th request — either the size of the shortest path or -1, if we can't reach the second cell from the first one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 7\n.X..\n...X\n5 1\n1 3\n7 7\n1 4\n6 1\n4 7\n5 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n4\n0\n5\n2\n2\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 3\nX...X..X..\n..X...X..X\n11 7\n7 18\n18 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n-1\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"413E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/413/problem/E"}