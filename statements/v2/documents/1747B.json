{"assets":[],"contentKind":"statement","contestId":"1747","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. BAN BAN"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an integer $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define $$$s(n)$$$ as the string \""},{"children":[{"kind":"text","text":"BAN"}],"kind":"container"},{"kind":"text","text":"\" concatenated $$$n$$$ times. For example, $$$s(1)$$$ = \""},{"children":[{"kind":"text","text":"BAN"}],"kind":"container"},{"kind":"text","text":"\", $$$s(3)$$$ = \""},{"children":[{"kind":"text","text":"BANBANBAN"}],"kind":"container"},{"kind":"text","text":"\". Note that the length of the string $$$s(n)$$$ is equal to $$$3n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider $$$s(n)$$$. You can perform the following operation on $$$s(n)$$$ any number of times (possibly zero):"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Select any two distinct indices $$$i$$$ and $$$j$$$ $$$(1 \\leq i, j \\leq 3n, i \\ne j)$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then, swap $$$s(n)_i$$$ and $$$s(n)_j$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You want the string \""},{"children":[{"kind":"text","text":"BAN"}],"kind":"container"},{"kind":"text","text":"\" to "},{"children":[{"kind":"text","text":"not appear"}],"kind":"container"},{"kind":"text","text":" in $$$s(n)$$$ as a "},{"children":[{"kind":"text","text":"subsequence"}],"kind":"container"},{"kind":"text","text":". What's the smallest number of operations you have to do to achieve this? Also, find one such shortest sequence of operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string $$$a$$$ is a subsequence of a string $$$b$$$ if $$$a$$$ can be obtained from $$$b$$$ by deletion of several (possibly, zero or all) characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of multiple test cases. The first line contains a single integer $$$t$$$ $$$(1 \\leq t \\leq 100)$$$  — the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a single integer $$$n$$$ $$$(1 \\leq n \\leq 100)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, in the first line output $$$m$$$ ($$$0 \\le m \\le 10^5$$$) — the minimum number of operations required. It's guaranteed that the objective is always achievable in at most $$$10^5$$$ operations under the constraints of the problem. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then, output $$$m$$$ lines. The $$$k$$$-th of these lines should contain two integers $$$i_k$$$, $$$j_k$$$ $$$(1\\leq i_k, j_k \\leq 3n, i_k \\ne j_k)$$$ denoting that you want to swap characters at indices $$$i_k$$$ and $$$j_k$$$ at the $$$k$$$-th operation. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After all $$$m$$$ operations, \""},{"children":[{"kind":"text","text":"BAN"}],"kind":"container"},{"kind":"text","text":"\" must not appear in $$$s(n)$$$ as a subsequence. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple possible answers, output any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n1\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n1 2\n1\n2 6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"first testcase"}],"kind":"container"},{"kind":"text","text":", $$$s(1) = $$$ \""},{"children":[{"kind":"text","text":"BAN"}],"kind":"container"},{"kind":"text","text":"\", we can swap $$$s(1)_1$$$ and $$$s(1)_2$$$, converting $$$s(1)$$$ to \""},{"children":[{"kind":"text","text":"ABN"}],"kind":"container"},{"kind":"text","text":"\", which does not contain \""},{"children":[{"kind":"text","text":"BAN"}],"kind":"container"},{"kind":"text","text":"\" as a subsequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"second testcase"}],"kind":"container"},{"kind":"text","text":", $$$s(2) = $$$ \""},{"children":[{"kind":"text","text":"BANBAN"}],"kind":"container"},{"kind":"text","text":"\", we can swap $$$s(2)_2$$$ and $$$s(2)_6$$$, converting $$$s(2)$$$ to \""},{"children":[{"kind":"text","text":"BNNBAA"}],"kind":"container"},{"kind":"text","text":"\", which does not contain \""},{"children":[{"kind":"text","text":"BAN"}],"kind":"container"},{"kind":"text","text":"\" as a subsequence."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1747B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1747/problem/B"}