{"assets":[],"contentKind":"statement","contestId":"911","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Two Cakes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"It's New Year's Eve soon, so Ivan decided it's high time he started setting the table. Ivan has bought two cakes and cut them into pieces: the first cake has been cut into "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" pieces, and the second one — into "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" pieces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ivan knows that there will be "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people at the celebration (including himself), so Ivan has set "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" plates for the cakes. Now he is thinking about how to distribute the cakes between the plates. Ivan wants to do it in such a way that all following conditions are met:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Each piece of each cake is put on some plate; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Each plate contains at least one piece of cake; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" No plate contains pieces of both cakes. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"To make his guests happy, Ivan wants to distribute the cakes in such a way that the minimum number of pieces on the plate is maximized. Formally, Ivan wants to know the maximum possible number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" such that he can distribute the cakes according to the aforementioned conditions, and each plate will contain at least "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" pieces of cake."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Ivan to calculate this number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ n ≤ a + b"},{"kind":"text","text":") — the number of plates, the number of pieces of the first cake, and the number of pieces of the second cake, respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum possible number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" such that Ivan can distribute the cake in such a way that each plate will contain at least "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" pieces of cake."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 7 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example there is only one way to distribute cakes to plates, all of them will have "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" cake on it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example you can have two plates with "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" pieces of the first cake and two plates both with "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" pieces of the second cake. Minimal number of pieces is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"911B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/911/problem/B"}