{"assets":[],"contentKind":"statement","contestId":"407","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. k-d-sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"We'll call a sequence of integers a good "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-"},{"kind":"math_inline","text":"d"},{"kind":"text","text":" sequence if we can add to it at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" numbers in such a way that after the sorting the sequence will be an arithmetic progression with difference "},{"kind":"math_inline","text":"d"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You got hold of some sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. Your task is to find its longest contiguous subsegment, such that it is a good "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-"},{"kind":"math_inline","text":"d"},{"kind":"text","text":" sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three space-separated integers "},{"kind":"math_inline","text":"n, k, d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105; 0 ≤ k ≤ 2·105; 0 ≤ d ≤ 109"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers: "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ ai ≤ 109"},{"kind":"text","text":") — the actual sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two space-separated integers "},{"kind":"math_inline","text":"l, r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":") show that sequence "},{"kind":"math_inline","text":"al, al + 1, ..., ar"},{"kind":"text","text":" is the longest subsegment that is a good "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-"},{"kind":"math_inline","text":"d"},{"kind":"text","text":" sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple optimal answers, print the one with the minimum value of "},{"kind":"math_inline","text":"l"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 1 2\n4 3 2 8 6 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test sample the answer is the subsegment consisting of numbers 2, 8, 6 — after adding number 4 and sorting it becomes sequence 2, 4, 6, 8 — the arithmetic progression with difference 2."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"407E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/407/problem/E"}