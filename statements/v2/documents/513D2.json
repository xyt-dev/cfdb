{"assets":[],"contentKind":"statement","contestId":"513","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D2. Constrained Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You need to find a binary tree of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" that satisfies a given set of "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" constraints. Suppose that the nodes of the unknown binary tree are labeled using a "},{"children":[{"kind":"text","text":"pre-order"}],"kind":"container"},{"kind":"text","text":" traversal starting with "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". For the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th constraint you are given two labels, "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" and a direction, left or right. In case of left direction, "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is an element of the subtree rooted at "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"'s left child. Similarly in the case of right direction "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is an element of the subtree rooted at "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"'s right child."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":". The next "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" lines contain 2 integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":") and either \""},{"children":[{"kind":"text","text":"LEFT"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"RIGHT"}],"kind":"container"},{"kind":"text","text":"\" denoting whether "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is in the subtree rooted at "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"'s left child or in the subtree rooted at "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"'s right child."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"The problem consists of multiple subproblems. The subproblems have different constraints on the input. You will get some score for the correct submission of the subproblem. The description of the subproblems follows."}],"kind":"container"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" In subproblem D1 ("},{"kind":"math_inline","text":"9"},{"kind":"text","text":" points), the constraints "},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ c ≤ 50"},{"kind":"text","text":" will hold. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" In subproblem D2 ("},{"kind":"math_inline","text":"8"},{"kind":"text","text":" points), the constraints "},{"kind":"math_inline","text":"1 ≤ n ≤ 1000000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ c ≤ 100000"},{"kind":"text","text":" will hold. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output will be on a single line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Any binary tree that satisfies the constraints will be accepted. The tree's nodes should be printed out as "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space separated labels representing an "},{"children":[{"kind":"text","text":"in-order"}],"kind":"container"},{"kind":"text","text":" traversal, using the "},{"children":[{"kind":"text","text":"pre-order"}],"kind":"container"},{"kind":"text","text":" numbers as labels of vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are no trees that satisfy the constraints, print \""},{"children":[{"kind":"text","text":"IMPOSSIBLE"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 2 LEFT\n1 3 RIGHT\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 2 RIGHT\n1 3 LEFT\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"IMPOSSIBLE\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first sample test. We need to find a tree with 3 nodes that satisfies the following two constraints. The node labeled 2 with pre-order traversal should be in the left subtree of the node labeled 1 with pre-order traversal; the node labeled 3 with pre-order traversal should be in the right subtree of the node labeled 1. There is only one tree with three nodes that satisfies these constraints and its in-order traversal is "},{"kind":"math_inline","text":"(2, 1, 3)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Pre-order"}],"kind":"container"},{"kind":"text","text":" is the \"root – left subtree – right subtree\" order. "},{"children":[{"kind":"text","text":"In-order"}],"kind":"container"},{"kind":"text","text":" is the \"left subtree – root – right subtree\" order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For other information regarding "},{"children":[{"kind":"text","text":"in-order"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"pre-order"}],"kind":"container"},{"kind":"text","text":", see "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Tree_traversal"},"children":[{"kind":"text","text":"http://en.wikipedia.org/wiki/Tree_traversal"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D2","problemCode":"513D2","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/513/problem/D2"}