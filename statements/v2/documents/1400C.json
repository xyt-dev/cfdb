"kind":"text","text":" (formally, if $$$i + x \\le n$$$ and $$$w_{i+x} = $$$ "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", then $$$s_i = $$$ "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if both of the aforementioned conditions are false, then $$$s_i$$$ is "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given the integer $$$x$$$ and the resulting string $$$s$$$. Reconstruct the original string $$$w$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two lines. The first line contains the resulting string $$$s$$$ ($$$2 \\le |s| \\le 10^5$$$, each character of $$$s$$$ is either "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"). The second line contains one integer $$$x$$$ ($$$1 \\le x \\le |s| - 1$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The total length of all strings $$$s$$$ in the input does not exceed $$$10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the answer on a separate line as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if no string $$$w$$$ can produce the string $$$s$$$ at the end of the process, print $$$-1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" otherwise, print the binary string $$$w$$$ consisting of $$$|s|$$$ characters. If there are multiple answers, print any of them. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n101110\n2\n01\n1\n110\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n111011\n10\n-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1400C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1400/problem/C"}