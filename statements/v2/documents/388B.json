{"assets":[],"contentKind":"statement","contestId":"388","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Fox and Minimal path"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Fox Ciel wants to write a task for a programming contest. The task is: \"You are given a simple undirected graph with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertexes. Each its edge has unit length. You should calculate the number of shortest paths between vertex 1 and vertex 2.\""}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Same with some writers, she wants to make an example with some certain output: for example, her birthday or the number of her boyfriend. Can you help her to make a test case with answer equal exactly to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"You should output a graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertexes ("},{"kind":"math_inline","text":"2 ≤ n ≤ 1000"},{"kind":"text","text":"). There must be exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" shortest paths between vertex 1 and vertex 2 of the graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line must contain an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Then adjacency matrix "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" columns must follow. Each element of the matrix must be '"},{"children":[{"kind":"text","text":"N"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"Y"}],"kind":"container"},{"kind":"text","text":"'. If "},{"kind":"math_inline","text":"Gij"},{"kind":"text","text":" is '"},{"children":[{"kind":"text","text":"Y"}],"kind":"container"},{"kind":"text","text":"', then graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" has a edge connecting vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and vertex "},{"kind":"math_inline","text":"j"},{"kind":"text","text":". Consider the graph vertexes are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The graph must be undirected and simple: "},{"kind":"math_inline","text":"Gii"},{"kind":"text","text":" = '"},{"children":[{"kind":"text","text":"N"}],"kind":"container"},{"kind":"text","text":"' and "},{"kind":"math_inline","text":"Gij = Gji"},{"kind":"text","text":" must hold. And there must be at least one path between vertex 1 and vertex 2. It's guaranteed that the answer exists. If there multiple correct answers, you can output any of them. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\nNNYY\nNNYY\nYYNN\nYYNN"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\nNNYYYNNN\nNNNNNYYY\nYNNNNYYY\nYNNNNYYY\nYNNNNYYY\nNYYYYNNN\nNYYYYNNN\nNYYYYNNN"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\nNY\nYN"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In first example, there are 2 shortest paths: 1-3-2 and 1-4-2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In second example, there are 9 shortest paths: 1-3-6-2, 1-3-7-2, 1-3-8-2, 1-4-6-2, 1-4-7-2, 1-4-8-2, 1-5-6-2, 1-5-7-2, 1-5-8-2."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"388B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/388/problem/B"}