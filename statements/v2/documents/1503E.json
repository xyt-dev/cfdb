{"assets":["/statement-assets/a5fb9049e5ad84d7ede35e88edf8e4e2014730064a431594fd542bb5a03a2265.png","/statement-assets/17eb277b46b2040bab76027a0ed613de32f156e0703c2b06ba49ff8ac449b906.png","/statement-assets/8288c54a5c938e3bcd81dc792249a04a79f1fdc89b3bc3ea1f9fdd86ae3bdd6e.png"],"contentKind":"statement","contestId":"1503","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. 2-Coloring"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a grid with $$$n$$$ rows and $$$m$$$ columns. Every cell of the grid should be colored either blue or yellow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A coloring of the grid is called stupid if every row has exactly one segment of blue cells and every column has exactly one segment of yellow cells."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In other words, every row must have at least one blue cell, and all blue cells in a row must be consecutive. Similarly, every column must have at least one yellow cell, and all yellow cells in a column must be consecutive."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a5fb9049e5ad84d7ede35e88edf8e4e2014730064a431594fd542bb5a03a2265.png"},"kind":"image"},{"kind":"text","text":" An example of a stupid coloring. "}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/17eb277b46b2040bab76027a0ed613de32f156e0703c2b06ba49ff8ac449b906.png"},"kind":"image"},{"kind":"text","text":" Examples of clever colorings. The first coloring is missing a blue cell in the second row, and the second coloring has two yellow segments in the second column. "}],"kind":"container"},{"children":[{"kind":"text","text":"How many stupid colorings of the grid are there? Two colorings are considered different if there is some cell that is colored differently."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains two integers $$$n$$$, $$$m$$$ ($$$1\\le n, m\\le 2021$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the number of stupid colorings modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n294\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2020 2021\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n50657649\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, these are the only two stupid $$$2\\times 2$$$ colorings."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/8288c54a5c938e3bcd81dc792249a04a79f1fdc89b3bc3ea1f9fdd86ae3bdd6e.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1503E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1503/problem/E"}