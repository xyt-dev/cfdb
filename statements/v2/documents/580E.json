{"assets":[],"contentKind":"statement","contestId":"580","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Kefa and Watch"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day Kefa the parrot was walking down the street as he was on the way home from the restaurant when he saw something glittering by the road. As he came nearer he understood that it was a watch. He decided to take it to the pawnbroker to earn some money. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The pawnbroker said that each watch contains a serial number represented by a string of digits from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"9"},{"kind":"text","text":", and the more quality checks this number passes, the higher is the value of the watch. The check is defined by three positive integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". The watches pass a check if a substring of the serial number from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" has period "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". Sometimes the pawnbroker gets distracted and Kefa changes in some substring of the serial number all digits to "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" in order to increase profit from the watch. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The seller has a lot of things to do to begin with and with Kefa messing about, he gave you a task: to write a program that determines the value of the watch."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us remind you that number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is called a period of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ |s|"},{"kind":"text","text":"), if "},{"kind":"math_inline","text":"si  =  si + x"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from 1 to "},{"kind":"math_inline","text":"|s|  -  x"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m + k ≤ 105"},{"kind":"text","text":") — the length of the serial number, the number of change made by Kefa and the number of quality checks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a serial number consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" digits."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"m + k"},{"kind":"text","text":" lines follow, containing either checks or changes. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The changes are given as 1 "},{"kind":"math_inline","text":"l"},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"c"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ c ≤ 9"},{"kind":"text","text":"). That means that Kefa changed all the digits from the "},{"kind":"math_inline","text":"l"},{"kind":"text","text":"-th to the "},{"kind":"math_inline","text":"r"},{"kind":"text","text":"-th to be "},{"kind":"math_inline","text":"c"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The checks are given as 2 "},{"kind":"math_inline","text":"l"},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ d ≤ r - l + 1"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each check on a single line print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if the watch passed it, otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 2\n112\n2 2 3 1\n1 1 3 8\n2 1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\nYES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2 3\n334934\n2 2 5 2\n1 4 4 3\n2 1 6 3\n1 2 3 8\n2 3 6 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test two checks will be made. In the first one substring \"12\" is checked on whether or not it has period 1, so the answer is \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\". In the second one substring \"88\", is checked on whether or not it has period 1, and it has this period, so the answer is \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second statement test three checks will be made. The first check processes substring \"3493\", which doesn't have period 2. Before the second check the string looks as \"334334\", so the answer to it is \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\". And finally, the third check processes substring \"8334\", which does not have period 1."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"580E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/580/problem/E"}