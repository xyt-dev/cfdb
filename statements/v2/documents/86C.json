{"assets":["/statement-assets/b6f241169a15c07b7f11254aaa4e05bddbc4cdc2c9a418e41934b7f2dd87acc6.png","/statement-assets/34baa1c1973aab54ee01c8a6cf1174afb6cc388b9b6615c2b38636048e3f5424.png"],"contentKind":"statement","contestId":"86","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Genetic engineering"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"\"Multidimensional spaces are completely out of style these days, unlike genetics problems\" — thought physicist Woll and changed his subject of study to bioinformatics. Analysing results of sequencing he faced the following problem concerning DNA sequences. We will further think of a DNA sequence as an arbitrary string of uppercase letters \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\" (of course, this is a simplified interpretation)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" be a long DNA sequence and "},{"kind":"math_inline","text":"s1, s2, ..., sm"},{"kind":"text","text":" — collection of short DNA sequences. Let us say that the collection "},{"children":[{"kind":"text","text":"filters"}],"kind":"container"},{"kind":"math_inline","text":"w"},{"kind":"text","text":" iff "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" can be covered with the sequences from the collection. Certainly, substrings corresponding to the different positions of the string may intersect or even cover each other. More formally: denote by "},{"kind":"math_inline","text":"|w|"},{"kind":"text","text":" the length of "},{"kind":"math_inline","text":"w"},{"kind":"text","text":", let symbols of "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" be numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"|w|"},{"kind":"text","text":". Then for each position "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" there exist pair of indices "},{"kind":"math_inline","text":"l, r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ i ≤ r ≤ |w|"},{"kind":"text","text":") such that the substring "},{"kind":"math_inline","text":"w[l ... r]"},{"kind":"text","text":" equals one of the elements "},{"kind":"math_inline","text":"s1, s2, ..., sm"},{"kind":"text","text":" of the collection."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Woll wants to calculate the number of DNA sequences of a given length filtered by a given collection, but he doesn't know how to deal with it. Help him! Your task is to find the number of different DNA sequences of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" filtered by the collection "},{"kind":"math_inline","text":"{si}"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Answer may appear very large, so output it modulo "},{"kind":"math_inline","text":"1000000009"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains two integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000, 1 ≤ m ≤ 10"},{"kind":"text","text":") — the length of the string and the number of sequences in the collection correspondently. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the collection sequences "},{"kind":"math_inline","text":"si"},{"kind":"text","text":", one per line. Each "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" is a nonempty string of length not greater than "},{"kind":"math_inline","text":"10"},{"kind":"text","text":". All the strings consist of uppercase letters \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\". The collection may contain identical strings."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output should contain a single integer — the number of strings filtered by the collection modulo "},{"kind":"math_inline","text":"1000000009"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 9"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\nA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2\nCAT\nTACT\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, a string has to be filtered by \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\". Clearly, there is only one such string: \""},{"children":[{"kind":"text","text":"AA"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, there exist exactly two different strings satisfying the condition (see the pictures below)."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b6f241169a15c07b7f11254aaa4e05bddbc4cdc2c9a418e41934b7f2dd87acc6.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/34baa1c1973aab54ee01c8a6cf1174afb6cc388b9b6615c2b38636048e3f5424.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"86C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/86/problem/C"}