{"assets":["/statement-assets/11cea8f39c2bf8b395ac6cdbe9b38a75197afcd88ba0876da6346dae8dbb8d29.png"],"contentKind":"statement","contestId":"446","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. DZY Loves Bridges"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"DZY owns "},{"kind":"math_inline","text":"2m"},{"kind":"text","text":" islands near his home, numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"2m"},{"kind":"text","text":". He loves building bridges to connect the islands. Every bridge he builds takes one day's time to walk across."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"DZY has a strange rule of building the bridges. For every pair of islands "},{"kind":"math_inline","text":"u, v (u ≠ v)"},{"kind":"text","text":", he has built "},{"kind":"math_inline","text":"2k"},{"kind":"text","text":" different bridges connecting them, where "},{"attrs":{"alt":"","src":"/statement-assets/11cea8f39c2bf8b395ac6cdbe9b38a75197afcd88ba0876da6346dae8dbb8d29.png"},"kind":"image"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"a|b"},{"kind":"text","text":" means "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is divisible by "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"). These bridges are bidirectional."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, DZY has built some bridges connecting his home with the islands. Specifically, there are "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" different bridges from his home to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th island. These are one-way bridges, so after he leaves his home he will never come back."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"DZY decides to go to the islands for sightseeing. At first he is at home. He chooses and walks across one of the bridges connecting with his home, and arrives at some island. After that, he will spend "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" day(s) on the islands. Each day, he can choose to stay and rest, or to walk to another island across the bridge. It is allowed to stay at an island for more than one day. It's also allowed to cross one bridge more than once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Suppose that right after the "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"-th day DZY stands at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th island. Let "},{"kind":"math_inline","text":"ans[i]"},{"kind":"text","text":" be the number of ways for DZY to reach the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th island after "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"-th day. Your task is to calculate "},{"kind":"math_inline","text":"ans[i]"},{"kind":"text","text":" for each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"1051131"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"To avoid huge input, we use the following way to generate the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". You are given the first "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" elements of array: "},{"kind":"math_inline","text":"a1, a2, ..., as"},{"kind":"text","text":". All the other elements should be calculated by formula: "},{"kind":"math_inline","text":"ai = (101·ai - s + 10007) mod 1051131"},{"kind":"math_inline","text":"(s < i ≤ 2m)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"m, t, s"},{"kind":"math_inline","text":"(1 ≤ m ≤ 25; 1 ≤ t ≤ 1018; 1 ≤ s ≤ min(2m, 105))"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., as (1 ≤ ai ≤ 106)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"To avoid huge output, you only need to output xor-sum of all the answers for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"1051131"},{"kind":"math_inline","text":"(1 ≤ i ≤ 2m)"},{"kind":"text","text":", i.e. "},{"kind":"math_inline","text":"(ans[1] mod 1051131) xor (ans[2] mod 1051131) xor... xor (ans[n] mod 1051131)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 4\n1 1 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5 6\n389094 705719 547193 653800 947499 17024\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"556970\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, "},{"kind":"math_inline","text":"ans = [6, 7, 6, 6]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If he wants to be at island 1 after one day, he has 6 different ways:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" home —> 1 -(stay)-> 1 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" home —> 2 —> 1 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" home —> 3 —> 1 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" home —> 3 —> 1 (note that there are two different bridges between 1 and 3) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" home —> 4 —> 1 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" home —> 4 —> 1 (note that there are two different bridges from home to 4) "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second sample, "},{"kind":"math_inline","text":"(a1, a2, a3, a4, a5, a6, a7, a8) = (389094, 705719, 547193, 653800, 947499, 17024, 416654, 861849)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ans = [235771, 712729, 433182, 745954, 139255, 935785, 620229, 644335]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"446E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/446/problem/E"}