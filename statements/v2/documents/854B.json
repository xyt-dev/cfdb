{"assets":[],"contentKind":"statement","contestId":"854","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Maxim Buys an Apartment"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Maxim wants to buy an apartment in a new house at Line Avenue of Metropolis. The house has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" apartments that are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and are arranged in a row. Two apartments are adjacent if their indices differ by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Some of the apartments can already be inhabited, others are available for sale."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Maxim often visits his neighbors, so apartment is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" for him if it is available for sale and there is at least one already inhabited apartment adjacent to it. Maxim knows that there are exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" already inhabited apartments, but he doesn't know their indices yet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find out what could be the minimum possible and the maximum possible number of apartments that are good for Maxim."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains two integers: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum possible and the maximum possible number of apartments good for Maxim."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the sample test, the number of good apartments could be minimum possible if, for example, apartments with indices "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" were inhabited. In this case only apartment "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" is good. The maximum possible number could be, for example, if apartments with indices "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" were inhabited. In this case all other apartments: "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" are good."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"854B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/854/problem/B"}