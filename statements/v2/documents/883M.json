{"assets":["/statement-assets/e3cf9510c31738f0b52039f53de5a94c94c81f59051c099653ceafbd58902abc.png"],"contentKind":"statement","contestId":"883","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"M. Quadcopter Competition"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp takes part in a quadcopter competition. According to the rules a flying robot should:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" start the race from some point of a field, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" go around the flag, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" close cycle returning back to the starting point. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Polycarp knows the coordinates of the starting point ("},{"kind":"math_inline","text":"x1, y1"},{"kind":"text","text":") and the coordinates of the point where the flag is situated ("},{"kind":"math_inline","text":"x2, y2"},{"kind":"text","text":"). Polycarp’s quadcopter can fly only parallel to the sides of the field each tick changing exactly one coordinate by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". It means that in one tick the quadcopter can fly from the point ("},{"kind":"math_inline","text":"x, y"},{"kind":"text","text":") to any of four points: ("},{"kind":"math_inline","text":"x - 1, y"},{"kind":"text","text":"), ("},{"kind":"math_inline","text":"x + 1, y"},{"kind":"text","text":"), ("},{"kind":"math_inline","text":"x, y - 1"},{"kind":"text","text":") or ("},{"kind":"math_inline","text":"x, y + 1"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus the quadcopter path is a closed cycle starting and finishing in ("},{"kind":"math_inline","text":"x1, y1"},{"kind":"text","text":") and containing the point ("},{"kind":"math_inline","text":"x2, y2"},{"kind":"text","text":") strictly inside."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e3cf9510c31738f0b52039f53de5a94c94c81f59051c099653ceafbd58902abc.png"},"kind":"image"},{"children":[{"kind":"text","text":"The picture corresponds to the first example: the starting (and finishing) point is in ("},{"kind":"math_inline","text":"1, 5"},{"kind":"text","text":") and the flag is in ("},{"kind":"math_inline","text":"5, 2"},{"kind":"text","text":")."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"What is the minimal length of the quadcopter path?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integer numbers "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 100 ≤ x1, y1 ≤ 100"},{"kind":"text","text":") — coordinates of the quadcopter starting (and finishing) point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains two integer numbers "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 100 ≤ x2, y2 ≤ 100"},{"kind":"text","text":") — coordinates of the flag."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the quadcopter starting point and the flag do not coincide."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the length of minimal path of the quadcopter to surround the flag and return back."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 5\n5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"18\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 1\n0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"M","problemCode":"883M","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/883/problem/M"}