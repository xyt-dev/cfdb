{"assets":[],"contentKind":"statement","contestId":"172","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Phone Code"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarpus has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" friends in Tarasov city. Polycarpus knows phone numbers of all his friends: they are strings "},{"kind":"math_inline","text":"s1, s2, ..., sn"},{"kind":"text","text":". All these strings consist only of digits and have the same length. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Once Polycarpus needed to figure out Tarasov city phone code. He assumed that the phone code of the city is the longest common prefix of all phone numbers of his friends. In other words, it is the longest string "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" which is a prefix (the beginning) of each "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":"). Help Polycarpus determine the length of the city phone code. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 3·104"},{"kind":"text","text":") — the number of Polycarpus's friends. The following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain strings "},{"kind":"math_inline","text":"s1, s2, ..., sn"},{"kind":"text","text":" — the phone numbers of Polycarpus's friends. It is guaranteed that all strings consist only of digits and have the same length from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"20"},{"kind":"text","text":", inclusive. It is also guaranteed that all strings are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of digits in the city phone code."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n00209\n00219\n00999\n00909\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n77012345678999999999\n77012345678901234567\n77012345678998765432\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"prefix"}],"kind":"container"},{"kind":"text","text":" of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is a string that is obtained by deleting zero or more digits from the end of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". For example, string \""},{"children":[{"kind":"text","text":"00209"}],"kind":"container"},{"kind":"text","text":"\" has 6 prefixes: \"\" (an empty prefix), \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"00"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"002"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"0020"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"00209"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample the city phone code is string \""},{"children":[{"kind":"text","text":"00"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the city phone code is an empty string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample the city phone code is string \""},{"children":[{"kind":"text","text":"770123456789"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"172A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/172/problem/A"}