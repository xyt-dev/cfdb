{"assets":[],"contentKind":"statement","contestId":"283","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Coin Troubles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In the Isle of Guernsey there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different types of coins. For each "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ n)"},{"kind":"text","text":", coin of type "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is worth "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" cents. It is possible that "},{"kind":"math_inline","text":"ai = aj"},{"kind":"text","text":" for some "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"math_inline","text":"(i ≠ j)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Bessie has some set of these coins totaling "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" cents. She tells Jessie "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" pairs of integers. For each "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ q)"},{"kind":"text","text":", the pair "},{"kind":"math_inline","text":"bi, ci"},{"kind":"text","text":" tells Jessie that Bessie has a strictly greater number of coins of type "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" than coins of type "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":". It is known that all "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" are distinct and all "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" are distinct. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Jessie find the number of possible combinations of coins Bessie could have. Two combinations are considered different if there is some "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ n)"},{"kind":"text","text":", such that the number of coins Bessie has of type "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is different in the two combinations. Since the answer can be very large, output it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are no possible combinations of coins totaling "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" cents that satisfy Bessie's conditions, output 0."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three space-separated integers, "},{"kind":"math_inline","text":"n, q"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"(1 ≤ n ≤ 300; 0 ≤ q ≤ n; 1 ≤ t ≤ 105)"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space separated integers, "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 105)"},{"kind":"text","text":". The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines each contain two distinct space-separated integers, "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci"},{"kind":"math_inline","text":"(1 ≤ bi, ci ≤ n; bi ≠ ci)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that all "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" are distinct and all "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single integer, the number of valid coin combinations that Bessie could have, modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 17\n3 1 2 5\n4 2\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 6\n3 1 1\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 10\n1 2 3\n1 2\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample, the following 3 combinations give a total of 17 cents and satisfy the given conditions: "},{"kind":"math_inline","text":"{0 of type 1, 1 of type 2, 3 of type 3, 2 of type 4}, {0, 0, 6, 1}, {2, 0, 3, 1}"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"No other combinations exist. Note that even though 4 occurs in both "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci, "},{"kind":"text","text":" the problem conditions are still satisfied because all "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" are distinct and all "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" are distinct."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"283C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/283/problem/C"}