{"assets":[],"contentKind":"statement","contestId":"1899","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Game with Integers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vanya and Vova are playing a game. Players are given an integer $$$n$$$. On their turn, the player can add $$$1$$$ to the current integer or subtract $$$1$$$. The players take turns; Vanya starts. If "},{"children":[{"kind":"text","text":"after"}],"kind":"container"},{"kind":"text","text":" Vanya's move the integer is divisible by $$$3$$$, then he wins. If $$$10$$$ moves have passed and Vanya has not won, then Vova wins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Write a program that, based on the integer $$$n$$$, determines who will win if both players play optimally."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the integer $$$t$$$ ($$$1 \\leq t \\leq 100$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The single line of each test case contains the integer $$$n$$$ ($$$1 \\leq n \\leq 1000$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print \""},{"children":[{"kind":"text","text":"First"}],"kind":"container"},{"kind":"text","text":"\" without quotes if Vanya wins, and \""},{"children":[{"kind":"text","text":"Second"}],"kind":"container"},{"kind":"text","text":"\" without quotes if Vova wins."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1\n3\n5\n100\n999\n1000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nFirst\nSecond\nFirst\nFirst\nSecond\nFirst\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1899A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1899/problem/A"}