{"assets":[],"contentKind":"statement","contestId":"572","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Order Book"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In this task you need to process a set of stock exchange orders and use them to create "},{"children":[{"kind":"text","text":"order book"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An "},{"children":[{"kind":"text","text":"order"}],"kind":"container"},{"kind":"text","text":" is an instruction of some participant to buy or sell stocks on stock exchange. The order number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has price "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":", direction "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" — buy or sell, and integer "},{"kind":"math_inline","text":"qi"},{"kind":"text","text":". This means that the participant is ready to buy or sell "},{"kind":"math_inline","text":"qi"},{"kind":"text","text":" stocks at price "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" for one stock. A value "},{"kind":"math_inline","text":"qi"},{"kind":"text","text":" is also known as a "},{"children":[{"kind":"text","text":"volume"}],"kind":"container"},{"kind":"text","text":" of an order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All orders with the same price "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and direction "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" are merged into one "},{"children":[{"kind":"text","text":"aggregated"}],"kind":"container"},{"kind":"text","text":" order with price "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and direction "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". The volume of such order is a sum of volumes of the initial orders."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An order book is a list of aggregated orders, the first part of which contains sell orders sorted by price in descending order, the second contains buy orders also sorted by price in descending order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An order book of depth "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" contains "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" best aggregated orders for each direction. A buy order is better if it has higher price and a sell order is better if it has lower price. If there are less than "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" aggregated orders for some direction then all of them will be in the final order book."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" stock exhange orders. Your task is to print order book of depth "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" for these orders."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input starts with two positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000, 1 ≤ s ≤ 50"},{"kind":"text","text":"), the number of orders and the book depth."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains a letter "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" (either '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":"'), an integer "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ pi ≤ 105"},{"kind":"text","text":") and an integer "},{"kind":"math_inline","text":"qi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ qi ≤ 104"},{"kind":"text","text":") — direction, price and volume respectively. The letter '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' means buy, '"},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":"' means sell. The price of any sell order is higher than the price of any buy order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print no more than "},{"kind":"math_inline","text":"2s"},{"kind":"text","text":" lines with aggregated orders from order book of depth "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". The output format for orders should be the same as in input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2\nB 10 3\nS 50 2\nS 40 1\nS 50 6\nB 20 4\nB 25 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"S 50 8\nS 40 1\nB 25 10\nB 20 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Denote "},{"children":[{"kind":"text","text":"(x, y)"}],"kind":"container"},{"kind":"text","text":" an order with price "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and volume "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". There are 3 aggregated buy orders (10, 3), (20, 4), (25, 10) and two sell orders (50, 8), (40, 1) in the sample."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to print no more than two best orders for each direction, so you shouldn't print the order (10 3) having the worst price among buy orders."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"572B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/572/problem/B"}