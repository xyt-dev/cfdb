{"assets":[],"contentKind":"statement","contestId":"865","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Hex Dyslexia"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Copying large hexadecimal (base 16) strings by hand can be error prone, but that doesn't stop people from doing it. You've discovered a bug in the code that was likely caused by someone making a mistake when copying such a string. You suspect that whoever copied the string did not change any of the digits in the string, nor the length of the string, but may have permuted the digits arbitrarily. For example, if the original string was "},{"kind":"math_inline","text":"0abc"},{"kind":"text","text":" they may have changed it to "},{"kind":"math_inline","text":"a0cb"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"0bca"},{"kind":"text","text":", but not "},{"kind":"math_inline","text":"abc"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"0abb"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately you don't have access to the original string nor the copied string, but you do know the length of the strings and their numerical absolute difference. You will be given this difference as a hexadecimal string "},{"kind":"math_inline","text":"S"},{"kind":"text","text":", which has been zero-extended to be equal in length to the original and copied strings. Determine the smallest possible numerical value of the original string."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Input will contain a hexadecimal string "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" consisting only of digits "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" and lowercase English letters from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"f"},{"kind":"text","text":", with length at most "},{"kind":"math_inline","text":"14"},{"kind":"text","text":". At least one of the characters is non-zero."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is not possible, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print the lowercase hexadecimal string corresponding to the smallest possible numerical value, including any necessary leading zeros for the length to be correct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"f1e\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0f1e\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"00f1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"12d2c\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"00314\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The numerical value of a hexadecimal string is computed by multiplying each digit by successive powers of "},{"kind":"math_inline","text":"16"},{"kind":"text","text":", starting with the rightmost digit, which is multiplied by "},{"kind":"math_inline","text":"160"},{"kind":"text","text":". Hexadecimal digits representing values greater than "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" are represented by letters: "},{"kind":"math_inline","text":"a = 10, b = 11, c = 12, d = 13, e = 14, f = 15"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the numerical value of "},{"kind":"math_inline","text":"0f1e"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"0·163 + 15·162 + 1·161 + 14·160 = 3870"},{"kind":"text","text":", the numerical value of "},{"kind":"math_inline","text":"00f1"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"0·163 + 0·162 + 15·161 + 1·160 = 241"},{"kind":"text","text":", and the numerical value of "},{"kind":"math_inline","text":"100f"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"1·163 + 0·162 + 0·161 + 15·160 = 4111"},{"kind":"text","text":". Since "},{"kind":"math_inline","text":"3870 + 241 = 4111"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"00f1"},{"kind":"text","text":" is a permutation of "},{"kind":"math_inline","text":"100f"},{"kind":"text","text":", "},{"kind":"math_inline","text":"00f1"},{"kind":"text","text":" is a valid answer to the second test case."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"865E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/865/problem/E"}