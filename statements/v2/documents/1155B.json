{"assets":[],"contentKind":"statement","contestId":"1155","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Game with Telephone Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A telephone number is a sequence of "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" $$$11$$$ digits such that its first digit is "},{"children":[{"kind":"text","text":"8"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya and Petya are playing a game. Initially they have a string $$$s$$$ of length $$$n$$$ ($$$n$$$ is odd) consisting of digits. Vasya makes the first move, then players alternate turns. In one move the player "},{"children":[{"kind":"text","text":"must"}],"kind":"container"},{"kind":"text","text":" choose a character and erase it from the current string. For example, if the current string "},{"children":[{"kind":"text","text":"1121"}],"kind":"container"},{"kind":"text","text":", after the player's move it may be "},{"children":[{"kind":"text","text":"112"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"111"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"121"}],"kind":"container"},{"kind":"text","text":". The game ends when the length of string $$$s$$$ becomes "},{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":". If the resulting string is a telephone number, Vasya wins, otherwise Petya wins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to determine if Vasya has a winning strategy (that is, if Vasya can win the game no matter which characters Petya chooses during his moves)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$13 \\le n \\lt 10^5$$$, $$$n$$$ is odd) — the length of string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string $$$s$$$ ($$$|s| = n$$$) consisting only of decimal digits."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If Vasya has a strategy that guarantees him victory, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n13\n8380011223344\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n15\n807345619350641\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Vasya needs to erase the second character. Then Petya cannot erase a character from the remaining string "},{"children":[{"kind":"text","text":"880011223344"}],"kind":"container"},{"kind":"text","text":" so that it does not become a telephone number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example after Vasya's turn Petya can erase one character character "},{"children":[{"kind":"text","text":"8"}],"kind":"container"},{"kind":"text","text":". The resulting string can't be a telephone number, because there is no digit "},{"children":[{"kind":"text","text":"8"}],"kind":"container"},{"kind":"text","text":" at all."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1155B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1155/problem/B"}