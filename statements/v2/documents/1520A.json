{"assets":[],"contentKind":"statement","contestId":"1520","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Do Not Be Distracted!"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp has $$$26$$$ tasks. Each task is designated by a capital letter of the Latin alphabet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The teacher asked Polycarp to solve tasks in the following way: if Polycarp began to solve some task, then he must solve it to the end, without being distracted by another task. After switching to another task, Polycarp cannot return to the previous task."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp can only solve one task during the day. Every day he wrote down what task he solved. Now the teacher wants to know if Polycarp followed his advice."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if Polycarp solved tasks in the following order: \""},{"children":[{"kind":"text","text":"DDBBCCCBBEZ"}],"kind":"container"},{"kind":"text","text":"\", then the teacher will see that on the third day Polycarp began to solve the task '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"', then on the fifth day he got distracted and began to solve the task '"},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"', on the eighth day Polycarp returned to the task '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"'. Other examples of when the teacher is suspicious: \""},{"children":[{"kind":"text","text":"BAB"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"AABBCCDDEEBZZ"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"AAAAZAAAAA"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If Polycarp solved the tasks as follows: \""},{"children":[{"kind":"text","text":"FFGZZZY"}],"kind":"container"},{"kind":"text","text":"\", then the teacher cannot have any suspicions. Please note that Polycarp is not obligated to solve all tasks. Other examples of when the teacher doesn't have any suspicious: \""},{"children":[{"kind":"text","text":"BA"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"AFFFCC"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"YYYYY"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Polycarp find out if his teacher might be suspicious."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\le t \\le 1000$$$). Then $$$t$$$ test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains one integer $$$n$$$ ($$$1 \\le n \\le 50$$$) — the number of days during which Polycarp solved tasks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string of length $$$n$$$, consisting of uppercase Latin letters, which is the order in which Polycarp solved the tasks."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case output: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\", if the teacher "},{"children":[{"kind":"text","text":"cannot be suspicious"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\", otherwise. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You may print every letter in any case you want (so, for example, the strings "},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" are all recognized as positive answer)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n3\nABA\n11\nDDBBCCCBBEZ\n7\nFFGZZZY\n1\nZ\n2\nAB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\nNO\nYES\nYES\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1520A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1520/problem/A"}