{"assets":[],"contentKind":"statement","contestId":"1132","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Regular Bracket Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A string is called "},{"children":[{"kind":"text","text":"bracket sequence"}],"kind":"container"},{"kind":"text","text":" if it does not contain any characters other than \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\". A bracket sequence is called "},{"children":[{"kind":"text","text":"regular"}],"kind":"container"},{"kind":"text","text":" if it it is possible to obtain correct arithmetic expression by inserting characters \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" into this sequence. For example, \"\", \""},{"children":[{"kind":"text","text":"(())"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"()()"}],"kind":"container"},{"kind":"text","text":"\" are regular bracket sequences; \""},{"children":[{"kind":"text","text":"))"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")(("}],"kind":"container"},{"kind":"text","text":"\" are bracket sequences (but not regular ones), and \""},{"children":[{"kind":"text","text":"(a)"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(1)+(1)"}],"kind":"container"},{"kind":"text","text":"\" are not bracket sequences at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have a number of strings; each string is a bracket sequence of length $$$2$$$. So, overall you have $$$cnt_1$$$ strings \""},{"children":[{"kind":"text","text":"(("}],"kind":"container"},{"kind":"text","text":"\", $$$cnt_2$$$ strings \""},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":"\", $$$cnt_3$$$ strings \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\" and $$$cnt_4$$$ strings \""},{"children":[{"kind":"text","text":"))"}],"kind":"container"},{"kind":"text","text":"\". You want to write all these strings in some order, one after another; after that, you will get a long bracket sequence of length $$$2(cnt_1 + cnt_2 + cnt_3 + cnt_4)$$$. You wonder: is it possible to choose some order of the strings you have such that you will get a regular bracket sequence? "},{"children":[{"kind":"text","text":"Note that you may not remove any characters or strings, and you may not add anything either"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of four lines, $$$i$$$-th of them contains one integer $$$cnt_i$$$ ($$$0 \\le cnt_i \\le 10^9$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer: $$$1$$$ if it is possible to form a regular bracket sequence by choosing the correct order of the given strings, $$$0$$$ otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1\n4\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n0\n0\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n3\n4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example it is possible to construct a string \""},{"children":[{"kind":"text","text":"(())()(()((()()()())))"}],"kind":"container"},{"kind":"text","text":"\", which is a regular bracket sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example it is possible to construct a string \"\", which is a regular bracket sequence."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1132A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1132/problem/A"}