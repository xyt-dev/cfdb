{"assets":[],"contentKind":"statement","contestId":"746","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Numbers Exchange"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Eugeny has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cards, each of them has exactly one integer written on it. Eugeny wants to exchange some cards with Nikolay so that the number of even integers on his cards would equal the number of odd integers, and that all these numbers would be "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nikolay has "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" cards, distinct numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" are written on them, one per card. It means that Nikolay has exactly one card with number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", exactly one card with number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and so on. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A single exchange is a process in which Eugeny gives one card to Nikolay and takes another one from those Nikolay has. Your task is to find the minimum number of card exchanges and determine which cards Eugeny should exchange."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 109"},{"kind":"text","text":") — the number of cards Eugeny has and the number of cards Nikolay has. It is guaranteed that "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is even."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — the numbers on Eugeny's cards."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no answer, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, in the first line print the minimum number of exchanges. In the second line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers — Eugeny's cards after all the exchanges with Nikolay. The order of cards should coincide with the card's order in the input data. If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th card wasn't exchanged then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number should coincide with the number from the input data. Otherwise, it is considered that this card was exchanged, and the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number should be equal to the number on the card it was exchanged to."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, it is allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2\n5 6 7 9 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n5 6 7 9 4 2 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 6\n7 7 7 7 8 8 8 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n7 2 4 6 8 1 3 5 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n4 2 1 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"746E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/746/problem/E"}