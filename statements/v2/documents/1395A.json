{"assets":[],"contentKind":"statement","contestId":"1395","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Boboniu Likes to Color Balls"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Boboniu gives you"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$r$$$ red balls, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$g$$$ green balls, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b$$$ blue balls, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$w$$$ white balls. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"He allows you to do the following operation as many times as you want: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Pick a red ball, a green ball, and a blue ball and then change their color to white. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You should answer if it's possible to arrange all the balls into a "},{"children":[{"kind":"text","text":"palindrome"}],"kind":"container"},{"kind":"text","text":" after several (possibly zero) number of described operations. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$T$$$ ($$$1\\le T\\le 100$$$) denoting the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each of the next $$$T$$$ cases, the first line contains four integers $$$r$$$, $$$g$$$, $$$b$$$ and $$$w$$$ ($$$0\\le r,g,b,w\\le 10^9$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print \"Yes\" if it's possible to arrange all the balls into a palindrome after doing several (possibly zero) number of described operations. Otherwise, print \"No\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n0 1 1 1\n8 1 9 3\n0 0 0 0\n1000000000 1000000000 1000000000 1000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNo\nYes\nYes\nYes\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, you're not able to do any operation and you can never arrange three balls of distinct colors into a palindrome."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, after doing one operation, changing $$$(8,1,9,3)$$$ to $$$(7,0,8,6)$$$, one of those possible palindromes may be \"rrrwwwbbbbrbbbbwwwrrr\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"palindrome"}],"kind":"container"},{"kind":"text","text":" is a word, phrase, or sequence that reads the same backwards as forwards. For example, \"rggbwbggr\", \"b\", \"gg\" are palindromes while \"rgbb\", \"gbbgr\" are not. Notice that an "},{"children":[{"kind":"text","text":"empty"}],"kind":"container"},{"kind":"text","text":" word, phrase, or sequence is palindrome."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1395A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1395/problem/A"}