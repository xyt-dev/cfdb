{"assets":["/statement-assets/cbe5e8a6ff3f4451f6ef4e9d22ecb908c41dbfb5d2758a4d88f3f22173c2dae1.png","/statement-assets/69ae83813d4ad45b7ed011b22c875581759cc1d8e8aaebe011d14476fb3f991e.png","/statement-assets/fda48f0976f8f573cd6dae0b308eb8cd9d886caf03303850d136e067719de427.png"],"contentKind":"statement","contestId":"547","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Mike and Foam"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mike is a bartender at Rico's bar. At Rico's, they put beer glasses in a special shelf. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" kinds of beer at Rico's numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th kind of beer has "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" milliliters of foam on it."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/cbe5e8a6ff3f4451f6ef4e9d22ecb908c41dbfb5d2758a4d88f3f22173c2dae1.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Maxim is Mike's boss. Today he told Mike to perform "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries. Initially the shelf is empty. In each request, Maxim gives him a number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". If beer number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is already in the shelf, then Mike should remove it from the shelf, otherwise he should put it in the shelf."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After each query, Mike should tell him the score of the shelf. Bears are geeks. So they think that the score of a shelf is the number of pairs "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" of glasses in the shelf such that "},{"kind":"math_inline","text":"i < j"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/statement-assets/69ae83813d4ad45b7ed011b22c875581759cc1d8e8aaebe011d14476fb3f991e.png"},"kind":"image"},{"kind":"text","text":" where "},{"attrs":{"alt":"","src":"/statement-assets/fda48f0976f8f573cd6dae0b308eb8cd9d886caf03303850d136e067719de427.png"},"kind":"image"},{"kind":"text","text":" is the greatest common divisor of numbers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mike is tired. So he asked you to help him in performing these requests."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, q ≤ 2 × 105"},{"kind":"text","text":"), the number of different kinds of beer and number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space separated integers, "},{"kind":"math_inline","text":"a1, a2, ... , an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 5 × 105"},{"kind":"text","text":"), the height of foam in top of each kind of beer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain the queries. Each query consists of a single integer integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ n"},{"kind":"text","text":"), the index of a beer that should be added or removed from the shelf."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query, print the answer for that query in one line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6\n1 2 3 4 6\n1\n2\n3\n4\n5\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n1\n3\n5\n6\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"547C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/547/problem/C"}