{"assets":[],"contentKind":"statement","contestId":"217","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Alien DNA"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Professor Bajtocy is conducting experiments on alien DNA. He has discovered that it is subject to repetitive mutations — each mutation happens in the same way: some continuous subsequence of the alien DNA becomes active, copies itself, the copy gets mangled and inserts itself right after the original subsequence. The mangled copy of the activated continuous subsequence is formed by first joining all the elements at the even positions in that subsequence, and then joining all the elements at the odd ones at the end. That is, if the activated subsequence consists of 11 elements and represented as "},{"kind":"math_inline","text":"s1s2... s11"},{"kind":"text","text":", its mangled copy is "},{"kind":"math_inline","text":"s2s4s6s8s10s1s3s5s7s9s11"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if the original sequence was \""},{"children":[{"kind":"text","text":"ACTGG"}],"kind":"container"},{"kind":"text","text":"\" and the mutation happened on the segment "},{"kind":"math_inline","text":"[2, 4]"},{"kind":"text","text":" (that is the activated subsequence is \""},{"children":[{"kind":"text","text":"CTG"}],"kind":"container"},{"kind":"text","text":"\"), the mutated DNA is: \""},{"children":[{"kind":"text","text":"ACTG"},{"children":[{"kind":"text","text":"TCG"}],"kind":"container"},{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"\". The mangled copy of the activated subsequence is marked with bold font."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Professor Bajtocy has written down the original DNA sequence and the mutations that sequentially happened to it, and he now asks you to recover the first "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" elements of the DNA sequence after all the mutations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains the original DNA sequence, consisting only of letters \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"\" and not exceeding "},{"kind":"math_inline","text":"3·106"},{"kind":"text","text":" in length. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 3·106"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ n ≤ 5000"},{"kind":"text","text":") — the number of mutations. The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines describe the mutations in chronological order — each mutation is described by two numbers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ 109"},{"kind":"text","text":"), meaning that the continuous subsequence "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":" has become active and cloned itself, joining itself with the mangled copy. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the input data is correct, that is, no mutation acts on non-existing elements of the DNA sequence, and the resulting DNA sequence has at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" elements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Assume that the DNA elements are indexed starting from 1 and that the notation "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":" meaning the continuous subsequence of DNA sequence that consists of "},{"kind":"math_inline","text":"r - l + 1"},{"kind":"text","text":" elements starting at the "},{"kind":"math_inline","text":"l"},{"kind":"text","text":"-th DNA sequence element and ending at the "},{"kind":"math_inline","text":"r"},{"kind":"text","text":"-th DNA sequence element."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single line, containing the first "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" letters of the mutated DNA sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"GAGA\n4\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"GAGA\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ACGTACGT\n16\n2\n1 2\n2 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"ACCAGTACCGACATCG\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second example, after the first mutation the sequence is \""},{"children":[{"kind":"text","text":"ACCAGTACGT"}],"kind":"container"},{"kind":"text","text":"\". After the second mutation it's \""},{"children":[{"kind":"text","text":"ACCAGTACCGACATCGT"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"217E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/217/problem/E"}