{"assets":["/statement-assets/511c785383e87651ab69c3378339f8ecdb1b9f8db9823fac4b3442620f249533.png","/statement-assets/610ef40276564906d24dab20195db59fb5672890d899aa1193286d0d7cb66d9c.png","/statement-assets/0e9148cac3040808b3445e46f67c19c46de9b2ccc75f527ea83c3ac7232af845.png"],"contentKind":"statement","contestId":"1647","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Madoka and the Elegant Gift"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Madoka's father just reached $$$1$$$ million subscribers on Mathub! So the website decided to send him a personalized award — The Mathhub's Bit Button! "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Bit Button is a rectangular table with $$$n$$$ rows and $$$m$$$ columns with $$$0$$$ or $$$1$$$ in each cell. After exploring the table Madoka found out that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" A subrectangle $$$A$$$ is contained in a subrectangle $$$B$$$ if there's no cell contained in $$$A$$$ but not contained in $$$B$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" Two subrectangles intersect if there is a cell contained in both of them."}],"kind":"list_item"},{"children":[{"kind":"text","text":" A subrectangle is called "},{"children":[{"kind":"text","text":"black"}],"kind":"container"},{"kind":"text","text":" if there's no cell with value $$$0$$$ inside it."}],"kind":"list_item"},{"children":[{"kind":"text","text":" A subrectangle is called "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":" if it's "},{"children":[{"kind":"text","text":"black"}],"kind":"container"},{"kind":"text","text":" and it's not contained in another "},{"children":[{"kind":"text","text":"black"}],"kind":"container"},{"kind":"text","text":" subrectangle."}],"kind":"list_item"},{"children":[{"kind":"text","text":" The table is called "},{"children":[{"kind":"text","text":"elegant"}],"kind":"container"},{"kind":"text","text":" if there are no two "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":" intersecting subrectangles."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, in the first illustration the red subrectangle is nice, but in the second one it's not, because it's contained in the purple subrectangle."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/511c785383e87651ab69c3378339f8ecdb1b9f8db9823fac4b3442620f249533.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Help Madoka to determine whether the table is elegant."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 200$$$) — the number of test cases. Description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two positive integers $$$n, m$$$ ($$$1 \\le n, m \\le 100$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n$$$ lines contain strings of length $$$m$$$ consisting of zeros and ones — the description of the table."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of the values of $$$n$$$ and the sum of the values of $$$m$$$ for all test cases do not exceed $$$777$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if its table is elegant or print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may print each letter in any case (for example, \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\" will all be recognized as positive answer)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n3 3\n100\n011\n011\n3 3\n110\n111\n110\n1 5\n01111\n4 5\n11111\n01010\n01000\n01000\n3 2\n11\n00\n11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\nYES\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second test case the table is not elegant, because the red and the purple subrectangles are nice and intersect. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/610ef40276564906d24dab20195db59fb5672890d899aa1193286d0d7cb66d9c.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the fourth test case the table is not elegant, because the red and the purple subrectangles are nice and intersect. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0e9148cac3040808b3445e46f67c19c46de9b2ccc75f527ea83c3ac7232af845.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1647B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1647/problem/B"}