hildren":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single line containing the value of ultimate weirdness of the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 6 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first sample."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"f(1,  1)"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"f(2,  2)"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"f(3,  3)"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"f(1,  2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f(1,  3)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"f(2,  3)"},{"kind":"text","text":" are equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"kind":