{"assets":["/statement-assets/73cdf6663e83ff847380a0b0e090996473f098238d92f9c1f6ed867f3852b175.png"],"contentKind":"statement","contestId":"671","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Ultimate Weirdness of an Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Yasin has an array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" containing "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. Yasin is a 5 year old, so he loves ultimate weird things."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Yasin denotes "},{"children":[{"kind":"text","text":"weirdness"}],"kind":"container"},{"kind":"text","text":" of an array as maximum "},{"kind":"math_inline","text":"gcd(ai,  aj)"},{"kind":"text","text":" value among all "},{"kind":"math_inline","text":"1 ≤ i < j ≤ n"},{"kind":"text","text":". For "},{"kind":"math_inline","text":"n ≤ 1"},{"kind":"text","text":" weirdness is equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"gcd(x,  y)"},{"kind":"text","text":" is the greatest common divisor of integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He also defines the "},{"children":[{"kind":"text","text":"ultimate weirdness"}],"kind":"container"},{"kind":"text","text":" of an array. Ultimate weirdness is "},{"attrs":{"alt":"","src":"/statement-assets/73cdf6663e83ff8473