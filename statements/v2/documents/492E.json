{"assets":["/statement-assets/9012ac78dffab743744adf07c1188d658f4b118416b94b6f35fc77c84d5b81fe.png","/statement-assets/d7f0910a12aed52e6c285801f2a693ff7cd6eefdfb84dae51c9039456259ceaf.png","/statement-assets/fda48f0976f8f573cd6dae0b308eb8cd9d886caf03303850d136e067719de427.png"],"contentKind":"statement","contestId":"492","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Vanya and Field"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vanya decided to walk in the field of size "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" cells. The field contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" apple trees, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th apple tree is at the cell with coordinates "},{"kind":"math_inline","text":"(xi, yi)"},{"kind":"text","text":". Vanya moves towards vector "},{"kind":"math_inline","text":"(dx, dy)"},{"kind":"text","text":". That means that if Vanya is now at the cell "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":", then in a second he will be at cell "},{"attrs":{"alt":"","src":"/statement-assets/9012ac78dffab743744adf07c1188d658f4b118416b94b6f35fc77c84d5b81fe.png"},"kind":"image"},{"kind":"text","text":". The following condition is satisfied for the vector: "},{"attrs":{"alt":"","src":"/statement-assets/d7f0910a12aed52e6c285801f2a693ff7cd6eefdfb84dae51c9039456259ceaf.png"},"kind":"image"},{"kind":"text","text":", where "},{"attrs":{"alt":"","src":"/statement-assets/fda48f0976f8f573cd6dae0b308eb8cd9d886caf03303850d136e067719de427.png"},"kind":"image"},{"kind":"text","text":" is the largest integer that divides both "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Vanya ends his path when he reaches the square he has already visited. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vanya wonders, from what square of the field he should start his path to see as many apple trees as possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n, m, dx, dy"},{"kind":"text","text":"("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ dx, dy ≤ n"},{"kind":"text","text":") — the size of the field, the number of apple trees and the vector of Vanya's movement. Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain integers "},{"kind":"math_inline","text":"xi, yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ xi, yi ≤ n - 1"},{"kind":"text","text":") — the coordinates of apples. One cell may contain multiple apple trees."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two space-separated numbers — the coordinates of the cell from which you should start your path. "},{"children":[{"kind":"text","text":"If there are several answers you are allowed to print any of them"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5 2 3\n0 0\n1 2\n1 3\n2 4\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 1 1\n0 0\n0 1\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Vanya's path will look like: "},{"kind":"math_inline","text":"(1, 3) - (3, 1) - (0, 4) - (2, 2) - (4, 0) - (1, 3)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample: "},{"kind":"math_inline","text":"(0, 0) - (1, 1) - (0, 0)"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"492E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/492/problem/E"}