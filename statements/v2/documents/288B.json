{"assets":[],"contentKind":"statement","contestId":"288","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Polo the Penguin and Houses "}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little penguin Polo loves his home village. The village has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" houses, indexed by integers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Each house has a plaque containing an integer, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th house has a plaque containing integer "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Little penguin Polo loves walking around this village. The walk looks like that. First he stands by a house number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". Then he goes to the house whose number is written on the plaque of house "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" (that is, to house "},{"kind":"math_inline","text":"px"},{"kind":"text","text":"), then he goes to the house whose number is written on the plaque of house "},{"kind":"math_inline","text":"px"},{"kind":"text","text":" (that is, to house "},{"kind":"math_inline","text":"ppx"},{"kind":"text","text":"), and so on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We know that:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" When the penguin starts walking from any house indexed from 1 to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", inclusive, he can walk to house number 1. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" When the penguin starts walking from any house indexed from "},{"kind":"math_inline","text":"k + 1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", inclusive, he definitely cannot walk to house number 1. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" When the penguin starts walking from house number 1, he can get back to house number 1 after some non-zero number of walks from a house to a house. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You need to find the number of ways you may write the numbers on the houses' plaques so as to fulfill the three above described conditions. Print the remainder after dividing this number by "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000, 1 ≤ k ≤ min(8, n)"},{"kind":"text","text":") — the number of the houses and the number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" from the statement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print a single integer — the answer to the problem modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"54\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1728\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"288B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/288/problem/B"}