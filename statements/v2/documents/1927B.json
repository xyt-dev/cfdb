{"assets":[],"contentKind":"statement","contestId":"1927","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Following the String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp lost the string $$$s$$$ of length $$$n$$$ consisting of lowercase Latin letters, but he still has its "},{"children":[{"kind":"text","text":"trace"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"trace"}],"kind":"container"},{"kind":"text","text":" of the string $$$s$$$ is an array $$$a$$$ of $$$n$$$ integers, where $$$a_i$$$ is the number of such indices $$$j$$$ ($$$j \\lt i$$$) that $$$s_i=s_j$$$. For example, the "},{"children":[{"kind":"text","text":"trace"}],"kind":"container"},{"kind":"text","text":" of the string "},{"children":[{"kind":"text","text":"abracadabra"}],"kind":"container"},{"kind":"text","text":" is the array [$$$0, 0, 0, 1, 0, 2, 0, 3, 1, 1, 4$$$]."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a "},{"children":[{"kind":"text","text":"trace"}],"kind":"container"},{"kind":"text","text":" of a string, find "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" string $$$s$$$ from which it could have been obtained. The string $$$s$$$ should consist only of lowercase Latin letters "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"-"},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. Then the descriptions of the test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the length of the lost string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$0 \\le a_i \\lt n$$$) — the "},{"children":[{"kind":"text","text":"trace"}],"kind":"container"},{"kind":"text","text":" of the string. It is guaranteed that for the given "},{"children":[{"kind":"text","text":"trace"}],"kind":"container"},{"kind":"text","text":", there exists a suitable string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a string $$$s$$$ that corresponds to the given "},{"children":[{"kind":"text","text":"trace"}],"kind":"container"},{"kind":"text","text":". If there are multiple such strings $$$s$$$, then output any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The string $$$s$$$ should consist of lowercase Latin letters "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"-"},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that for each test case, a valid answer exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n11\n0 0 0 1 0 2 0 3 1 1 4\n10\n0 0 0 0 0 1 0 1 1 0\n1\n0\n8\n0 1 2 3 4 5 6 7\n8\n0 0 0 0 0 0 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nabracadabra\ncodeforces\na\naaaaaaaa\ndijkstra\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1927B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1927/problem/B"}