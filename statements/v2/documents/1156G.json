{"assets":[],"contentKind":"statement","contestId":"1156","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Optimizer"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's analyze a program written on some strange programming language. The variables in this language have names consisting of $$$1$$$ to $$$4$$$ characters, and each character is a lowercase or an uppercase Latin letter, or a digit. There is an extra constraint that the first character should not be a digit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are four types of operations in the program, each denoted by one of the characters: "},{"children":[{"kind":"text","text":"$"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"&"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each line of the program has one of the following formats: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"<lvalue>=<rvalue>"}],"kind":"container"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"<lvalue>"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"<rvalue>"}],"kind":"container"},{"kind":"text","text":" are valid variable names; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"<lvalue>=<arg1><op><arg2>"}],"kind":"container"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"<lvalue>"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"<arg1>"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"<arg2>"}],"kind":"container"},{"kind":"text","text":" are valid variable names, and <op> is an operation character. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The program is executed line-by-line, and the result of execution is stored in a variable having the name "},{"children":[{"kind":"text","text":"res"}],"kind":"container"},{"kind":"text","text":". If "},{"children":[{"kind":"text","text":"res"}],"kind":"container"},{"kind":"text","text":" is never assigned in the program, then the result will be equal to the value of "},{"children":[{"kind":"text","text":"res"}],"kind":"container"},{"kind":"text","text":" before running the program."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two programs are called equivalent if no matter which operations do characters "},{"children":[{"kind":"text","text":"$"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"&"}],"kind":"container"},{"kind":"text","text":" denote (but, obviously, performing the same operation on the same arguments gives the same result) and which values do variables have before execution of program, the value of "},{"children":[{"kind":"text","text":"res"}],"kind":"container"},{"kind":"text","text":" after running the first program is equal to the value of "},{"children":[{"kind":"text","text":"res"}],"kind":"container"},{"kind":"text","text":" after running the second program (the programs are executed independently)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a program consisting of $$$n$$$ lines. Your task is to write a program consisting of minimum possible number of lines that is equivalent to the program you are given."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$1 \\le n \\le 1000$$$) — the number of lines in the program."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$n$$$ lines follow — the program itself. Each line corresponds to the format described in the statement and has no extra whitespaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print $$$k$$$ — the minimum number of lines in the equivalent program."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then print $$$k$$$ lines without any whitespaces — an equivalent program having exactly $$$k$$$ lines, in the same format it is described in the statement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nc=aa#bb\nd12=c\nres=c^d12\ntmp=aa$c\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\naaaa=aa#bb\nres=aaaa^aaaa\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\nmax=aaaa$bbbb\nmin=bbbb^aaaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1156G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1156/problem/G"}