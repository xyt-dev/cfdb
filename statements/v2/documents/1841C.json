{"assets":[],"contentKind":"statement","contestId":"1841","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Ranom Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"No, not \"random\" numbers."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ranom digits are denoted by uppercase Latin letters from "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"E"}],"kind":"container"},{"kind":"text","text":". Moreover, the value of the letter "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" is $$$1$$$, "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" is $$$10$$$, "},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":" is $$$100$$$, "},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":" is $$$1000$$$, "},{"children":[{"kind":"text","text":"E"}],"kind":"container"},{"kind":"text","text":" is $$$10000$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A Ranom number is a sequence of Ranom digits. The value of the Ranom number is calculated as follows: the values of all digits are summed up, but some digits are taken with negative signs: a digit is taken with negative sign if there is a digit with a "},{"children":[{"kind":"text","text":"strictly greater"}],"kind":"container"},{"kind":"text","text":" value to the right of it (not necessarily immediately after it); otherwise, that digit is taken with a positive sign."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the value of the Ranom number "},{"children":[{"kind":"text","text":"DAAABDCA"}],"kind":"container"},{"kind":"text","text":" is $$$1000 - 1 - 1 - 1 - 10 + 1000 + 100 + 1 = 2088$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a Ranom number. You can change no more than one digit in it. Calculate the maximum possible value of the resulting number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a string $$$s$$$ ($$$1 \\le |s| \\le 2 \\cdot 10^5$$$) consisting of uppercase Latin letters from "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"E"}],"kind":"container"},{"kind":"text","text":" — the Ranom number you are given."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of the string lengths over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single integer — the maximum possible value of the number, if you can change no more than one digit in it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nDAAABDCA\nAB\nABCDEEDCBA\nDDDDAAADDABECD\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n11088\n10010\n31000\n15886\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, you can get "},{"children":[{"kind":"text","text":"EAAABDCA"}],"kind":"container"},{"kind":"text","text":" with the value $$$10000-1-1-1-10+1000+100+1=11088$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, you can get "},{"children":[{"kind":"text","text":"EB"}],"kind":"container"},{"kind":"text","text":" with the value $$$10000+10=10010$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1841C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1841/problem/C"}