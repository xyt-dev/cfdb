{"assets":[],"contentKind":"statement","contestId":"156","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Cipher"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sherlock Holmes found a mysterious correspondence of two VIPs and made up his mind to read it. But there is a problem! The correspondence turned out to be encrypted. The detective tried really hard to decipher the correspondence, but he couldn't understand anything. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At last, after some thought, he thought of something. Let's say there is a word "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":" lowercase Latin letters. Then for one "},{"children":[{"kind":"text","text":"operation"}],"kind":"container"},{"kind":"text","text":" you can choose a certain position "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ p < |s|"},{"kind":"text","text":") and perform one of the following actions: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" either replace letter "},{"kind":"math_inline","text":"sp"},{"kind":"text","text":" with the one that alphabetically "},{"children":[{"kind":"text","text":"follows"}],"kind":"container"},{"kind":"text","text":" it and replace letter "},{"kind":"math_inline","text":"sp + 1"},{"kind":"text","text":" with the one that alphabetically "},{"children":[{"kind":"text","text":"precedes"}],"kind":"container"},{"kind":"text","text":" it; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" or replace letter "},{"kind":"math_inline","text":"sp"},{"kind":"text","text":" with the one that alphabetically "},{"children":[{"kind":"text","text":"precedes"}],"kind":"container"},{"kind":"text","text":" it and replace letter "},{"kind":"math_inline","text":"sp + 1"},{"kind":"text","text":" with the one that alphabetically "},{"children":[{"kind":"text","text":"follows"}],"kind":"container"},{"kind":"text","text":" it. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let us note that letter \""},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"\" doesn't have a defined following letter and letter \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" doesn't have a defined preceding letter. That's why the corresponding changes are not acceptable. If the operation requires performing at least one unacceptable change, then such operation cannot be performed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two words "},{"children":[{"kind":"text","text":"coincide in their meaning"}],"kind":"container"},{"kind":"text","text":" iff one of them can be transformed into the other one as a result of zero or more operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sherlock Holmes needs to learn to quickly determine the following for each word: how many words can exist that coincide in their meaning with the given word, but differs from the given word in at least one character? Count this number for him modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input data contains several tests. The first line contains the only integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 104"},{"kind":"text","text":") — the number of tests."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines contain the words, one per line. Each word consists of lowercase Latin letters and has length from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"100"},{"kind":"text","text":", inclusive. Lengths of words can differ."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each word you should print the number of different "},{"children":[{"kind":"text","text":"other"}],"kind":"container"},{"kind":"text","text":" words that coincide with it in their meaning — not from the words listed in the input data, but from all possible words. As the sought number can be very large, print its value modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\nab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\naaaaaaaaaaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\nya\nklmbfxzb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"24\n320092793\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Some explanations about the "},{"children":[{"kind":"text","text":"operation"}],"kind":"container"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Note that for each letter, we can clearly define the letter that follows it. Letter \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\" alphabetically follows letter \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", letter \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\" follows letter \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\", ..., \""},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"\" follows letter \""},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Preceding letters are defined in the similar manner: letter \""},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":"\" precedes letter \""},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"\", ..., \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" precedes letter \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Note that the operation never changes a word's length. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the first sample you can obtain the only other word \""},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":"\". In the second sample you cannot obtain any other word, so the correct answer is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the third sample. One operation can transform word \""},{"children":[{"kind":"text","text":"klmbfxzb"}],"kind":"container"},{"kind":"text","text":"\" into word \""},{"children":[{"kind":"text","text":"klmcexzb"}],"kind":"container"},{"kind":"text","text":"\": we should choose "},{"kind":"math_inline","text":"p = 4"},{"kind":"text","text":", and replace the fourth letter with the following one (\""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\" "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\"), and the fifth one — with the preceding one (\""},{"children":[{"kind":"text","text":"f"}],"kind":"container"},{"kind":"text","text":"\" "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"\"). Also, we can obtain many other words from this one. An operation can transform word \""},{"children":[{"kind":"text","text":"ya"}],"kind":"container"},{"kind":"text","text":"\" only into one other word \""},{"children":[{"kind":"text","text":"xb"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Word \""},{"children":[{"kind":"text","text":"ya"}],"kind":"container"},{"kind":"text","text":"\" coincides in its meaning with words \""},{"children":[{"kind":"text","text":"xb"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"wc"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"vd"}],"kind":"container"},{"kind":"text","text":"\", ..., \""},{"children":[{"kind":"text","text":"ay"}],"kind":"container"},{"kind":"text","text":"\" (overall there are "},{"kind":"math_inline","text":"24"},{"kind":"text","text":" other words). The word \""},{"children":[{"kind":"text","text":"klmbfxzb"}],"kind":"container"},{"kind":"text","text":" has many more variants — there are "},{"kind":"math_inline","text":"3320092814"},{"kind":"text","text":" other words that coincide with in the meaning. So the answer for the first word equals "},{"kind":"math_inline","text":"24"},{"kind":"text","text":" and for the second one equals "},{"kind":"math_inline","text":"320092793"},{"kind":"text","text":" — the number "},{"kind":"math_inline","text":"3320092814"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"109 + 7"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"156C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/156/problem/C"}