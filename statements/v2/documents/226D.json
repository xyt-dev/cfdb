{"assets":[],"contentKind":"statement","contestId":"226","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. The table"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Harry Potter has a difficult homework. Given a rectangular table, consisting of "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" cells. Each cell of the table contains the integer. Harry knows how to use two spells: the first spell change the sign of the integers in the selected row, the second — in the selected column. Harry's task is to make non-negative the sum of the numbers in each row and each column using these spells."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Alone, the boy can not cope. Help the young magician!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n,  m ≤ 100)"},{"kind":"text","text":" — the number of rows and the number of columns. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, each contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th integer in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line is "},{"kind":"math_inline","text":"ai, j"},{"kind":"math_inline","text":"(|ai, j| ≤ 100)"},{"kind":"text","text":", the number in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column of the table."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The rows of the table numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The columns of the table numbered from 1 to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" — the number of required applications of the first spell. Next print "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" space-separated integers — the row numbers, you want to apply a spell. These row numbers must be distinct!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print the number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" — the number of required applications of the second spell. Next print "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" space-separated integers — the column numbers, you want to apply a spell. These column numbers must be distinct!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several solutions are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n-1\n-1\n-1\n-1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 1 2 3 4 \n0 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4\n-1 -1 -1 2\n1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1 \n1 4 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"226D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/226/problem/D"}