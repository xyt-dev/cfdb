{"assets":[],"contentKind":"statement","contestId":"1204","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Natasha, Sasha and the Prefix Sums"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Natasha's favourite numbers are $$$n$$$ and $$$1$$$, and Sasha's favourite numbers are $$$m$$$ and $$$-1$$$. One day Natasha and Sasha met and wrote down every possible array of length $$$n+m$$$ such that some $$$n$$$ of its elements are equal to $$$1$$$ and another $$$m$$$ elements are equal to $$$-1$$$. For each such array they counted its maximal prefix sum, probably an empty one which is equal to $$$0$$$ (in another words, if every nonempty prefix sum is less to zero, then it is considered equal to zero). Formally, denote as $$$f(a)$$$ the maximal prefix sum of an array $$$a_{1, \\ldots ,l}$$$ of length $$$l \\geq 0$$$. Then: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$f(a) = \\max (0, \\smash{\\displaystyle\\max_{1 \\leq i \\leq l}} \\sum_{j=1}^{i} a_j )$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now they want to count the sum of maximal prefix sums for each such an array and they are asking you to help. As this sum can be very large, output it modulo $$$998\\: 244\\: 853$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains two integers $$$n$$$ and $$$m$$$ ($$$0 \\le n,m \\le 2\\,000$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the answer to the problem modulo $$$998\\: 244\\: 853$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2000 2000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"674532367\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the only possible array is "},{"children":[{"kind":"text","text":"[-1,-1]"}],"kind":"container"},{"kind":"text","text":", its maximal prefix sum is equal to $$$0$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the only possible array is "},{"children":[{"kind":"text","text":"[1,1]"}],"kind":"container"},{"kind":"text","text":", its maximal prefix sum is equal to $$$2$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are $$$6$$$ possible arrays in the third example:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"[1,1,-1,-1]"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"f([1,1,-1,-1]) = 2"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"[1,-1,1,-1]"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"f([1,-1,1,-1]) = 1"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"[1,-1,-1,1]"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"f([1,-1,-1,1]) = 1"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"[-1,1,1,-1]"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"f([-1,1,1,-1]) = 1"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"[-1,1,-1,1]"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"f([-1,1,-1,1]) = 0"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"[-1,-1,1,1]"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"f([-1,-1,1,1]) = 0"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So the answer for the third example is $$$2+1+1+1+0+0 = 5$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1204E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1204/problem/E"}