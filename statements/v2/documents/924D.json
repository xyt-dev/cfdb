{"assets":[],"contentKind":"statement","contestId":"924","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Contact ATC"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Arkady the air traffic controller is now working with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" planes in the air. All planes move along a straight coordinate axis with Arkady's station being at point "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" on it. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th plane, small enough to be represented by a point, currently has a coordinate of "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and is moving with speed "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":". It's guaranteed that "},{"kind":"math_inline","text":"xi·vi < 0"},{"kind":"text","text":", i.e., all planes are moving towards the station."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Occasionally, the planes are affected by winds. With a wind of speed "},{"kind":"math_inline","text":"vwind"},{"kind":"text","text":" (not necessarily positive or integral), the speed of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th plane becomes "},{"kind":"math_inline","text":"vi + vwind"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"According to weather report, the current wind has a steady speed falling inside the range "},{"kind":"math_inline","text":"[ - w, w]"},{"kind":"text","text":" (inclusive), but the exact value cannot be measured accurately since this value is rather small — smaller than the absolute value of speed of any plane."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each plane should contact Arkady at the exact moment it passes above his station. And you are to help Arkady count the number of pairs of planes "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"i < j"},{"kind":"text","text":") there are such that there is a possible value of wind speed, under which planes "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" contact Arkady at the same moment. This value needn't be the same across different pairs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The wind speed is the same for all planes. You may assume that the wind has a steady speed and lasts arbitrarily long."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ w < 105"},{"kind":"text","text":") — the number of planes and the maximum wind speed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |xi| ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"w + 1 ≤ |vi| ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"xi·vi < 0"},{"kind":"text","text":") — the initial position and speed of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th plane."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Planes are pairwise distinct, that is, no pair of "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"i < j"},{"kind":"text","text":") exists such that both "},{"kind":"math_inline","text":"xi = xj"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi = vj"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the number of unordered pairs of planes that can contact Arkady at the same moment."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1\n-3 2\n-3 3\n-1 2\n1 -3\n3 -5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 1\n-3 2\n-2 2\n-1 2\n1 -2\n2 -2\n3 -2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the following "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" pairs of planes satisfy the requirements: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"math_inline","text":"(2, 5)"}],"kind":"container"},{"kind":"text","text":" passes the station at time "},{"kind":"math_inline","text":"3 / 4"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"vwind = 1"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"math_inline","text":"(3, 4)"}],"kind":"container"},{"kind":"text","text":" passes the station at time "},{"kind":"math_inline","text":"2 / 5"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"vwind = 1 / 2"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"math_inline","text":"(3, 5)"}],"kind":"container"},{"kind":"text","text":" passes the station at time "},{"kind":"math_inline","text":"4 / 7"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"vwind =  - 1 / 4"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second example, each of the "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" planes with negative coordinates can form a valid pair with each of the other "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", totaling "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" pairs."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"924D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/924/problem/D"}