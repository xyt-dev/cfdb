{"assets":[],"contentKind":"statement","contestId":"299","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Ksusha the Squirrel"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ksusha the Squirrel is standing at the beginning of a straight road, divided into "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sectors. The sectors are numbered 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", from left to right. Initially, Ksusha stands in sector 1. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ksusha wants to walk to the end of the road, that is, get to sector "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Unfortunately, there are some rocks on the road. We know that Ksusha hates rocks, so she doesn't want to stand in sectors that have rocks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ksusha the squirrel keeps fit. She can jump from sector "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to any of the sectors "},{"kind":"math_inline","text":"i + 1, i + 2, ..., i + k"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Ksusha! Given the road description, say if she can reach the end of the road (note, she cannot stand on a rock)?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(2 ≤ n ≤ 3·105, 1 ≤ k ≤ 3·105)"},{"kind":"text","text":". The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters — the description of the road: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character equals \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\", if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th sector contains no rocks. Otherwise, it equals \""},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the first and the last characters equal \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) if Ksusha can reach the end of the road, otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"k