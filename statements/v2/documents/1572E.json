{"assets":["/statement-assets/f5cf8b8ab978aea1f5d8fe17de633edad7dc7a8dde9d28990d148292ec3646c3.png","/statement-assets/d4d49b32984e62399f1c2937bc00e785aae04bc4f5bc3a963c40f0ffc2e8db20.png"],"contentKind":"statement","contestId":"1572","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Polygon"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a strictly convex polygon with $$$n$$$ vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You will make $$$k$$$ cuts that meet the following conditions: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" each cut is a segment that connects two different nonadjacent vertices; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" two cuts can intersect only at vertices of the polygon. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is to maximize the area of the smallest region that will be formed by the polygon and those $$$k$$$ cuts."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$, $$$k$$$ ($$$3 \\le n \\le 200$$$, $$$0 \\le k \\le n-3$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following $$$n$$$ lines describe vertices of the polygon in anticlockwise direction. The $$$i$$$-th line contains two integers $$$x_i$$$, $$$y_i$$$ ($$$|x_i|, |y_i| \\le 10^8$$$) — the coordinates of the $$$i$$$-th vertex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the polygon is convex and that no two adjacent sides are parallel."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer: the maximum possible area of the smallest region after making $$$k$$$ cuts "},{"children":[{"kind":"text","text":"multiplied by"}],"kind":"container"},{"kind":"text","text":" $$$2$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8 4\n-2 -4\n2 -2\n4 2\n1 5\n0 5\n-4 4\n-5 0\n-5 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n11\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6 3\n2 -2\n2 -1\n1 2\n0 2\n-2 1\n-1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, it's optimal to make cuts between the following pairs of vertices: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$(-2, -4)$$$ and $$$(4, 2)$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(-2, -4)$$$ and $$$(1, 5)$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(-5, -1)$$$ and $$$(1, 5)$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(-5, 0)$$$ and $$$(0, 5)$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f5cf8b8ab978aea1f5d8fe17de633edad7dc7a8dde9d28990d148292ec3646c3.png"},"kind":"image"},{"kind":"text","text":" Points $$$(-5, -1)$$$, $$$(1, 5)$$$, $$$(0, 5)$$$, $$$(-5, 0)$$$ determine the smallest region with double area of $$$11$$$. "}],"kind":"container"},{"children":[{"kind":"text","text":"In the second example, it's optimal to make cuts between the following pairs of vertices: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$(2, -1)$$$ and $$$(0, 2)$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(2, -1)$$$ and $$$(1, 0)$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(-1, 0)$$$ and $$$(0, 2)$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d4d49b32984e62399f1c2937bc00e785aae04bc4f5bc3a963c40f0ffc2e8db20.png"},"kind":"image"},{"kind":"text","text":" Points $$$(2, -2)$$$, $$$(2, -1)$$$, $$$(-1, 0)$$$ determine one of the smallest regions with double area of $$$3$$$. "}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1572E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1572/problem/E"}