{"assets":[],"contentKind":"statement","contestId":"633","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. A Trivial Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mr. Santa asks all the great programmers of the world to solve a trivial problem. He gives them an integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and asks for the number of positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", such that the factorial of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ends with exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" zeroes. Are you among those great programmers who can solve this problem?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of input contains an integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 100 000"},{"kind":"text","text":") — the required number of trailing zeroes in factorial."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"First print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of values of "},{"kind":"math_in