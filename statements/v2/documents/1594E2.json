{"assets":["/statement-assets/4265b71af3bca5f2f89dc2135cf21df6d522e9bb3b20ac3b8684b9a4ce458cd0.png","/statement-assets/96f02196d50733f26173209cd72dc28a4478682bae22adc69739bdc6f0864cd7.png","/statement-assets/0c746e2353721e14dcb2d7a7f4003f1c762204d006699ef7b236e4caf53f1050.png"],"contentKind":"statement","contestId":"1594","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E2. Rubik's Cube Coloring (hard version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"It is the hard version of the problem. The difference is that in this version, there are nodes with already chosen colors."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Theofanis is starving, and he wants to eat his favorite food, sheftalia. However, he should first finish his homework. Can you help him with this problem?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have a "},{"children":[{"kind":"text","text":"perfect"}],"kind":"container"},{"kind":"text","text":" binary tree of $$$2^k - 1$$$ nodes — a binary tree where all vertices $$$i$$$ from $$$1$$$ to $$$2^{k - 1} - 1$$$ have exactly two children: vertices $$$2i$$$ and $$$2i + 1$$$. Vertices from $$$2^{k - 1}$$$ to $$$2^k - 1$$$ don't have any children. You want to color its vertices with the $$$6$$$ Rubik's cube colors (White, Green, Red, Blue, Orange and Yellow)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a coloring "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" when all edges connect nodes with colors that are "},{"children":[{"kind":"text","text":"neighboring"}],"kind":"container"},{"kind":"text","text":" sides in the Rubik's cube."}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/4265b71af3bca5f2f89dc2135cf21df6d522e9bb3b20ac3b8684b9a4ce458cd0.png"},"kind":"image"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/96f02196d50733f26173209cd72dc28a4478682bae22adc69739bdc6f0864cd7.png"},"kind":"image"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"},{"children":[{"kind":"text","text":"A picture of Rubik's cube and its 2D map."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"More formally: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" a white node can "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" be neighboring with white and yellow nodes; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" a yellow node can "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" be neighboring with white and yellow nodes; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" a green node can "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" be neighboring with green and blue nodes; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" a blue node can "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" be neighboring with green and blue nodes; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" a red node can "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" be neighboring with red and orange nodes; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" an orange node can "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" be neighboring with red and orange nodes; "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"However, there are $$$n$$$ special nodes in the tree, colors of which are already chosen."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You want to calculate the number of the good colorings of the binary tree. Two colorings are considered different if at least one node is colored with a different color."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer may be too large, so output the answer modulo $$$10^9+7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the integers $$$k$$$ ($$$1 \\le k \\le 60$$$) — the number of levels in the perfect binary tree you need to color."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the integer $$$n$$$ ($$$1 \\le n \\le \\min(2^k - 1, 2000)$$$) — the number of nodes, colors of which are already chosen."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n$$$ lines contains integer $$$v$$$ ($$$1 \\le v \\le 2^k - 1$$$) and string $$$s$$$ — the index of the node and the color of the node ($$$s$$$ is one of the "},{"children":[{"kind":"text","text":"white"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"yellow"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"green"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"blue"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"red"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"orange"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that each node $$$v$$$ appears in the input at most once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the number of the different colorings modulo $$$10^9+7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2\n5 orange\n2 white\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1024\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n2\n1 white\n2 white\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n3\n1 blue\n4 red\n5 orange\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n328925088\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the picture below, you can see one of the correct colorings of the first test example."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0c746e2353721e14dcb2d7a7f4003f1c762204d006699ef7b236e4caf53f1050.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E2","problemCode":"1594E2","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1594/problem/E2"}