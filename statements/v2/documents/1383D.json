{"assets":[],"contentKind":"statement","contestId":"1383","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Rearrange"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Koa the Koala has a matrix $$$A$$$ of $$$n$$$ rows and $$$m$$$ columns. Elements of this matrix are distinct integers from $$$1$$$ to $$$n \\cdot m$$$ (each number from $$$1$$$ to $$$n \\cdot m$$$ appears exactly once in the matrix)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For any matrix $$$M$$$ of $$$n$$$ rows and $$$m$$$ columns let's define the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The $$$i$$$-th row of $$$M$$$ is defined as $$$R_i(M) = [ M_{i1}, M_{i2}, \\ldots, M_{im} ]$$$ for all $$$i$$$ ($$$1 \\le i \\le n$$$). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The $$$j$$$-th column of $$$M$$$ is defined as $$$C_j(M) = [ M_{1j}, M_{2j}, \\ldots, M_{nj} ]$$$ for all $$$j$$$ ($$$1 \\le j \\le m$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Koa defines $$$S(A) = (X, Y)$$$ as the spectrum of $$$A$$$, where $$$X$$$ is the set of the maximum values in rows of $$$A$$$ and $$$Y$$$ is the set of the maximum values in columns of $$$A$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$X = \\{ \\max(R_1(A)), \\max(R_2(A)), \\ldots, \\max(R_n(A)) \\}$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$Y = \\{ \\max(C_1(A)), \\max(C_2(A)), \\ldots, \\max(C_m(A)) \\}$$$"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Koa asks you to find some matrix $$$A'$$$ of $$$n$$$ rows and $$$m$$$ columns, such that each number from $$$1$$$ to $$$n \\cdot m$$$ appears exactly once in the matrix, and the following conditions hold:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$S(A') = S(A)$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$R_i(A')$$$ is bitonic for all $$$i$$$ ($$$1 \\le i \\le n$$$) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$C_j(A')$$$ is bitonic for all $$$j$$$ ($$$1 \\le j \\le m$$$) "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" An array $$$t$$$ ($$$t_1, t_2, \\ldots, t_k$$$) is called bitonic if it first increases and then decreases."},{"children":[{"kind":"text","text":" More formally: $$$t$$$ is bitonic if there exists some position $$$p$$$ ($$$1 \\le p \\le k$$$) such that: $$$t_1 \\lt t_2 \\lt \\ldots \\lt t_p \\gt t_{p+1} \\gt \\ldots \\gt t_k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Koa to find such matrix or to determine that it doesn't exist."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\le n, m \\le 250$$$)  — the number of rows and columns of $$$A$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the ollowing $$$n$$$ lines contains $$$m$$$ integers. The $$$j$$$-th integer in the $$$i$$$-th line denotes element $$$A_{ij}$$$ ($$$1 \\le A_{ij} \\le n \\cdot m$$$) of matrix $$$A$$$. It is guaranteed that every number from $$$1$$$ to $$$n \\cdot m$$$ appears exactly once among elements of the matrix."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If such matrix doesn't exist, print $$$-1$$$ on a single line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, the output must consist of $$$n$$$ lines, each one consisting of $$$m$$$ space separated integers  — a description of $$$A'$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$j$$$-th number in the $$$i$$$-th line represents the element $$$A'_{ij}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Every integer from $$$1$$$ to $$$n \\cdot m$$$ should appear exactly once in $$$A'$$$, every row and column in $$$A'$$$ must be bitonic and $$$S(A) = S(A')$$$ must hold."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are many answers print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 3\n3 5 6\n1 7 9\n4 8 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n9 5 1\n7 8 2\n3 6 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 2\n4 1\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4 1\n3 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 4\n12 10 8 6\n3 4 5 7\n2 11 9 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n12 8 6 1\n10 11 9 2\n3 4 5 7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's analyze the first sample:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For matrix $$$A$$$ we have:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Rows: "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$R_1(A) = [3, 5, 6]; \\max(R_1(A)) = 6$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$R_2(A) = [1, 7, 9]; \\max(R_2(A)) = 9$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$R_3(A) = [4, 8, 2]; \\max(R_3(A)) = 8$$$ "}],"kind":"list_item"}],"kind":"list"},{"kind":"paragraph"},{"children":[{"kind":"text","text":" Columns: "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$C_1(A) = [3, 1, 4]; \\max(C_1(A)) = 4$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$C_2(A) = [5, 7, 8]; \\max(C_2(A)) = 8$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$C_3(A) = [6, 9, 2]; \\max(C_3(A)) = 9$$$ "}],"kind":"list_item"}],"kind":"list"},{"kind":"paragraph"},{"children":[{"kind":"text","text":" $$$X = \\{ \\max(R_1(A)), \\max(R_2(A)), \\max(R_3(A)) \\} = \\{ 6, 9, 8 \\}$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$Y = \\{ \\max(C_1(A)), \\max(C_2(A)), \\max(C_3(A)) \\} = \\{ 4, 8, 9 \\}$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" So $$$S(A) = (X, Y) = (\\{ 6, 9, 8 \\}, \\{ 4, 8, 9 \\})$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":"For matrix $$$A'$$$ we have:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Rows: "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$R_1(A') = [9, 5, 1]; \\max(R_1(A')) = 9$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$R_2(A') = [7, 8, 2]; \\max(R_2(A')) = 8$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$R_3(A') = [3, 6, 4]; \\max(R_3(A')) = 6$$$ "}],"kind":"list_item"}],"kind":"list"},{"kind":"paragraph"},{"children":[{"kind":"text","text":" Columns: "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$C_1(A') = [9, 7, 3]; \\max(C_1(A')) = 9$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$C_2(A') = [5, 8, 6]; \\max(C_2(A')) = 8$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$C_3(A') = [1, 2, 4]; \\max(C_3(A')) = 4$$$ "}],"kind":"list_item"}],"kind":"list"},{"kind":"paragraph"},{"children":[{"kind":"text","text":" Note that each of this arrays are bitonic. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$X = \\{ \\max(R_1(A')), \\max(R_2(A')), \\max(R_3(A')) \\} = \\{ 9, 8, 6 \\}$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$Y = \\{ \\max(C_1(A')), \\max(C_2(A')), \\max(C_3(A')) \\} = \\{ 9, 8, 4 \\}$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" So $$$S(A') = (X, Y) = (\\{ 9, 8, 6 \\}, \\{ 9, 8, 4 \\})$$$ "}],"kind":"list_item"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1383D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1383/problem/D"}