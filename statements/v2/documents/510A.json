{"assets":[],"contentKind":"statement","contestId":"510","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Fox And Snake"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Fox Ciel starts to learn programming. The first task is drawing a fox! However, that turns out to be too hard for a beginner, so she decides to draw a snake instead."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A snake is a pattern on a "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" table. Denote "},{"kind":"math_inline","text":"c"},{"kind":"text","text":"-th cell of "},{"kind":"math_inline","text":"r"},{"kind":"text","text":"-th row as "},{"kind":"math_inline","text":"(r, c)"},{"kind":"text","text":". The tail of the snake is located at "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":", then it's body extends to "},{"kind":"math_inline","text":"(1, m)"},{"kind":"text","text":", then goes down "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" rows to "},{"kind":"math_inline","text":"(3, m)"},{"kind":"text","text":", then goes left to "},{"kind":"math_inline","text":"(3, 1)"},{"kind":"text","text":" and so on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to draw this snake for Fox Ciel: the empty cells should be represented as dot characters ('"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"') and the