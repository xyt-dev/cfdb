{"assets":["/statement-assets/f0ca67b5f5b325a60b0f33c8c2823bc98a1894b2243a77949d361a70a8fd3091.png"],"contentKind":"statement","contestId":"385","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Bear and Prime Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recently, the bear started studying data structures and faced the following problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a sequence of integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries, each of them is characterized by two integers "},{"kind":"math_inline","text":"li, ri"},{"kind":"text","text":". Let's introduce "},{"kind":"math_inline","text":"f(p)"},{"kind":"text","text":" to represent the number of such indexes "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"xk"},{"kind":"text","text":" is divisible by "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". The answer to the query "},{"kind":"math_inline","text":"li, ri"},{"kind":"text","text":" is the sum: "},{"attrs":{"alt":"","src":"/statement-assets/f0ca67b5f5b325a60b0f33c8c2823bc98a1894b2243a77949d361a70a8fd3091.png"},"kind":"image"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"S(li, ri)"},{"kind":"text","text":" is a set of prime numbers from segment "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":" (both borders are included in the segment)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the bear cope with the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 106)"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"math_inline","text":"(2 ≤ xi ≤ 107)"},{"kind":"text","text":". The numbers are not necessarily distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains integer "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ m ≤ 50000)"},{"kind":"text","text":". Each of the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains a pair of space-separated integers, "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"math_inline","text":"(2 ≤ li ≤ ri ≤ 2·109)"},{"kind":"text","text":" — the numbers that characterize the current query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers — the answers to the queries on the order the queries appear in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n5 5 7 10 14 15\n3\n2 11\n3 12\n4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n7\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n2 3 5 7 11 4 8\n2\n8 10\n2 123\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first sample. Overall, the first sample has 3 queries."}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The first query "},{"kind":"math_inline","text":"l = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r = 11"},{"kind":"text","text":" comes. You need to count "},{"kind":"math_inline","text":"f(2) + f(3) + f(5) + f(7) + f(11) = 2 + 1 + 4 + 2 + 0 = 9"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The second query comes "},{"kind":"math_inline","text":"l = 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r = 12"},{"kind":"text","text":". You need to count "},{"kind":"math_inline","text":"f(3) + f(5) + f(7) + f(11) = 1 + 4 + 2 + 0 = 7"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The third query comes "},{"kind":"math_inline","text":"l = 4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r = 4"},{"kind":"text","text":". As this interval has no prime numbers, then the sum equals 0. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"385C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/385/problem/C"}