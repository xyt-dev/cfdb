{"assets":[],"contentKind":"statement","contestId":"839","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Winter is here"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Winter is here at the North and the White Walkers are close. John Snow has an army consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" soldiers. While the rest of the world is fighting for the Iron Throne, he is going to get ready for the attack of the White Walkers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He has created a method to know how strong his army is. Let the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th soldier’s strength be "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". For some "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" he calls "},{"kind":"math_inline","text":"i1, i2, ..., ik"},{"kind":"text","text":" a clan if "},{"kind":"math_inline","text":"i1 < i2 < i3 < ... < ik"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"gcd(ai1, ai2, ..., aik) > 1"},{"kind":"text","text":" . He calls the strength of that clan "},{"kind":"math_inline","text":"k·gcd(ai1, ai2, ..., aik)"},{"kind":"text","text":". Then he defines the strength of his army by the sum of strengths of all possible clans."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the strength of his army. As the number may be very large, you have to print it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Greatest common divisor (gcd) of a sequence of integers is the maximum possible integer so that each element of the sequence is divisible by it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200000"},{"kind":"text","text":") — the size of the army."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 1000000"},{"kind":"text","text":") — denoting the strengths of his soldiers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the strength of John Snow's army modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 3 4 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"39\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the clans are "},{"kind":"math_inline","text":"{1}, {2}, {1, 2}"},{"kind":"text","text":" so the answer will be "},{"kind":"math_inline","text":"1·3 + 1·3 + 2·3 = 12"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"839D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/839/problem/D"}