{"assets":[],"contentKind":"statement","contestId":"145","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Lucky Number 2"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Petya loves lucky numbers very much. Everybody knows that lucky numbers are positive integers whose decimal record contains only the lucky digits "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":". For example, numbers "},{"children":[{"kind":"text","text":"47"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"744"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" are lucky and "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"17"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"467"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya loves long lucky numbers very much. He is interested in the "},{"children":[{"kind":"text","text":"minimum"}],"kind":"container"},{"kind":"text","text":" lucky number "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" that meets some condition. Let "},{"kind":"math_inline","text":"c