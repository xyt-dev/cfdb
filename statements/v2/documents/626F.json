,{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the third sample, the total imbalance must be "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", so each student must work individually."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"626F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/626/problem/F"}