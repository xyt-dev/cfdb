{"assets":["/statement-assets/1987ef0a6f237c49826ac92c70c50365c7495e2ffb0bf7a844b4cf29d80ade78.png","/statement-assets/bce914c1a874f53af211e082ee706e95d886abb2873c6627fdc8bd32100bc84b.png","/statement-assets/6a1559363b38756b53c8bd0660c97752c900b15fb47a3d73367185f6c26a9075.png"],"contentKind":"statement","contestId":"451","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Game With Sticks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After winning gold and silver in IOI 2014, Akshat and Malvika want to have some fun. Now they are playing a game on a grid made of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" horizontal and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" vertical sticks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An "},{"children":[{"kind":"text","text":"intersection point"}],"kind":"container"},{"kind":"text","text":" is any point on the grid which is formed by the intersection of one horizontal stick and one vertical stick."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the grid shown below, "},{"kind":"math_inline","text":"n = 3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m = 3"},{"kind":"text","text":". There are "},{"kind":"math_inline","text":"n + m = 6"},{"kind":"text","text":" sticks in total (horizontal sticks are shown in red and vertical sticks are shown in green). There are "},{"kind":"math_inline","text":"n·m = 9"},{"kind":"text","text":" intersection points, numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"9"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1987ef0a6f237c49826ac92c70c50365c7495e2ffb0bf7a844b4cf29d80ade78.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The rules of the game are very simple. The players move in turns. Akshat won gold, so he makes the first move. During his/her move, a player must choose any remaining intersection point and remove from the grid all sticks which pass through this point. A player will lose the game if he/she cannot make a move (i.e. there are no intersection points remaining on the grid at his/her move)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Assume that both players play optimally. Who will win the game?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two space-separated integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single line containing \""},{"children":[{"kind":"text","text":"Akshat"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"Malvika"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), depending on the winner of the game."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Malvika\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Malvika\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Akshat\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Explanation of the first sample:"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The grid has four intersection points, numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/bce914c1a874f53af211e082ee706e95d886abb2873c6627fdc8bd32100bc84b.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"If Akshat chooses intersection point "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", then he will remove two sticks ("},{"kind":"math_inline","text":"1 - 2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 - 3"},{"kind":"text","text":"). The resulting grid will look like this."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6a1559363b38756b53c8bd0660c97752c900b15fb47a3d73367185f6c26a9075.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Now there is only one remaining intersection point (i.e. "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"). Malvika must choose it and remove both remaining sticks. After her move the grid will be empty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the empty grid, Akshat cannot make any move, hence he will lose."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since all "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" intersection points of the grid are equivalent, Akshat will lose no matter which one he picks."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"451A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/451/problem/A"}