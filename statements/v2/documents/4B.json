{"assets":[],"contentKind":"statement","contestId":"4","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Before an Exam"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"0.5 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Tomorrow Peter has a Biology exam. He does not like this subject much, but "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" days ago he learnt that he would have to take this exam. Peter's strict parents made him prepare for the exam immediately, for this purpose he has to study not less than "},{"kind":"math_inline","text":"minTimei"},{"kind":"text","text":" and not more than "},{"kind":"math_inline","text":"maxTimei"},{"kind":"text","text":" hours per each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day. Moreover, they warned Peter that a day before the exam they would check how he has followed their instructions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, today is the day when Peter's parents ask him to show the timetable of his preparatory studies. But the boy has counted only the sum of hours "},{"kind":"math_inline","text":"sumTime"},{"kind":"text","text":" spent him on preparation, and now he wants to know if he can show his parents a timetable "},{"kind":"math_inline","text":"sсhedule"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" numbers, where each number "},{"kind":"math_inline","text":"sсhedulei"},{"kind":"text","text":" stands for the time in hours spent by Peter each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day on biology studies, and satisfying the limitations imposed by his parents, and at the same time the sum total of all "},{"kind":"math_inline","text":"schedulei"},{"kind":"text","text":" should equal to "},{"kind":"math_inline","text":"sumTime"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains two integer numbers "},{"kind":"math_inline","text":"d, sumTime"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ d ≤ 30, 0 ≤ sumTime ≤ 240"},{"kind":"text","text":") — the amount of days, during which Peter studied, and the total amount of hours, spent on preparation. Each of the following "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" lines contains two integer numbers "},{"kind":"math_inline","text":"minTimei, maxTimei"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ minTimei ≤ maxTimei ≤ 8"},{"kind":"text","text":"), separated by a space — minimum and maximum amount of hours that Peter could spent in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":", and in the second line print "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" numbers (separated by a space), each of the numbers — amount of hours, spent by Peter on preparation in the corresponding day, if he followed his parents' instructions; or print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" in the unique line. If there are many solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 48\n5 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 5\n0 1\n3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1 4 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"4B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/4/problem/B"}