{"assets":["/statement-assets/660240d6b68f274842cc4634571c86408fb9a328b3899bec73769bdd62555000.png"],"contentKind":"statement","contestId":"815","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Karen and Neighborhood"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"It's been long after the events of the previous problems, and Karen has now moved on from student life and is looking to relocate to a new neighborhood."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/660240d6b68f274842cc4634571c86408fb9a328b3899bec73769bdd62555000.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The neighborhood consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" houses in a straight line, labelled "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right, all an equal distance apart."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Everyone in this neighborhood loves peace and quiet. Because of this, whenever a new person moves into the neighborhood, he or she always chooses the house whose minimum distance to any occupied house is maximized. If there are multiple houses with the maximum possible minimum distance, he or she chooses the leftmost one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the first person to arrive always moves into house "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Karen is the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th person to enter this neighborhood. If everyone, including herself, follows this rule, which house will she move into?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and only line of input contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 1018"},{"kind":"text","text":"), describing the number of houses in the neighborhood, and that Karen was the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th person to move in, respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer on a line by itself, the label of the house Karen will move into."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"39 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, there are "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" houses in the neighborhood, and Karen is the fourth person to move in:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The first person moves into house "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The second person moves into house "},{"kind":"math_inline","text":"6"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The third person moves into house "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The fourth person moves into house "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second test case, there are "},{"kind":"math_inline","text":"39"},{"kind":"text","text":" houses in the neighborhood, and Karen is the third person to move in:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The first person moves into house "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The second person moves into house "},{"kind":"math_inline","text":"39"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The third person moves into house "},{"kind":"math_inline","text":"20"}