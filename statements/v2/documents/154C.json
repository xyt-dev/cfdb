{"assets":[],"contentKind":"statement","contestId":"154","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Double Profiles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have been offered a job in a company developing a large social network. Your first task is connected with searching profiles that most probably belong to the same user."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The social network contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" registered profiles, numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Some pairs there are friends (the \"friendship\" relationship is mutual, that is, if "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is friends with "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" is also friends with "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"). Let's say that profiles "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"i ≠ j"},{"kind":"text","text":") are "},{"children":[{"kind":"text","text":"doubles"}],"kind":"container"},{"kind":"text","text":", if for any profile "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"k ≠ i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k ≠ j"},{"kind":"text","text":") one of the two statements is true: either "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is friends with "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", or "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" isn't friends with either of them. Also, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" can be friends or not be friends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to count the number of different unordered pairs ("},{"kind":"math_inline","text":"i, j"},{"kind":"text","text":"), such that the profiles "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" are doubles. Note that the pairs are unordered, that is, pairs ("},{"kind":"math_inline","text":"a, b"},{"kind":"text","text":") and ("},{"kind":"math_inline","text":"b, a"},{"kind":"text","text":") are considered identical."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ m ≤ 106"},{"kind":"text","text":"), — the number of profiles and the number of pairs of friends, correspondingly. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains descriptions of pairs of friends in the format \""},{"kind":"math_inline","text":"v u"},{"kind":"text","text":"\", where "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v, u ≤ n, v ≠ u"},{"kind":"text","text":") are numbers of profiles that are friends with each other. It is guaranteed that each unordered pair of friends occurs no more than once and no profile is friends with itself."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the single integer — the number of unordered pairs of profiles that are doubles. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specificator to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specificator."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2\n2 3\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first and second sample any two profiles are doubles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample the doubles are pairs of profiles "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(2, 4)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"154C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/154/problem/C"}