{"assets":["/statement-assets/4dc57ff0c2a589e2263a281a20816bba8a24b5ccc73aa8e635bd0a490f26eb13.png"],"contentKind":"statement","contestId":"526","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Om Nom and Necklace"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day Om Nom found a thread with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" beads of different colors. He decided to cut the first several beads from this thread to make a bead necklace and present it to his girlfriend Om Nelly."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/4dc57ff0c2a589e2263a281a20816bba8a24b5ccc73aa8e635bd0a490f26eb13.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Om Nom knows that his girlfriend loves beautiful patterns. That's why he wants the beads on the necklace to form a "},{"children":[{"kind":"text","text":"regular"}],"kind":"container"},{"kind":"text","text":" pattern. A sequence of beads "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"regular"}],"kind":"container"},{"kind":"text","text":" if it can be represented as "},{"kind":"math_inline","text":"S = A + B + A + B + A + ... + A + B + A"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" are some bead sequences, \""},{"kind":"math_inline","text":" + "},{"kind":"text","text":"\" is the concatenation of sequences, there are exactly "},{"kind":"math_inline","text":"2k + 1"},{"kind":"text","text":" summands in this sum, among which there are "},{"kind":"math_inline","text":"k + 1"},{"kind":"text","text":" \""},{"kind":"math_inline","text":"A"},{"kind":"text","text":"\" summands and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" \""},{"kind":"math_inline","text":"B"},{"kind":"text","text":"\" summands that follow in alternating order. Om Nelly knows that her friend is an eager mathematician, so she doesn't mind if "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" is an empty sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Om Nom determine in which ways he can cut off the first several beads from the found thread (at least one; probably, all) so that they form a "},{"children":[{"kind":"text","text":"regular pattern"}],"kind":"container"},{"kind":"text","text":". When Om Nom cuts off the beads, he doesn't change their order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, k ≤ 1 000 000"},{"kind":"text","text":") — the number of beads on the thread that Om Nom found and number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" from the definition of the regular sequence above."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase Latin letters that represent the colors of the beads. Each color corresponds to a single letter."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a string consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" zeroes and ones. Position "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") must contain either number one if the first "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" beads on the thread form a regular sequence, or a zero otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 2\nbcabcab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0000011"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"21 2\nababaababaababaababaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"000110000111111000011"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test a regular sequence is both a sequence of the first 6 beads (we can take "},{"kind":"math_inline","text":"A = "},{"kind":"text","text":"\"\", "},{"kind":"math_inline","text":"B = "},{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"bca"}],"kind":"container"},{"kind":"text","text":"\"), and a sequence of the first 7 beads (we can take "},{"kind":"math_inline","text":"A = "},{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\", "},{"kind":"math_inline","text":"B = "},{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"ca"}],"kind":"container"},{"kind":"text","text":"\")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test, for example, a sequence of the first 13 beads is regular, if we take "},{"kind":"math_inline","text":"A = "},{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\", "},{"kind":"math_inline","text":"B = "},{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"526D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/526/problem/D"}