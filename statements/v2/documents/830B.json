{"assets":[],"contentKind":"statement","contestId":"830","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Cards Sorting"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasily has a deck of cards consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cards. There is an integer on each of the cards, this integer is between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"100 000"},{"kind":"text","text":", inclusive. It is possible that some cards have the same integers on them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasily decided to sort the cards. To do this, he repeatedly takes the top card from the deck, and if the number on it equals the minimum number written on the cards in the deck, then he places the card away. Otherwise, he puts it under the deck and takes the next card from the top, and so on. The process ends as soon as there are no cards in the deck. You can assume that Vasily always knows the minimum number written on some card in the remaining deck, but doesn't know where this card (or these cards) is."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are to determine the total number of times Vasily takes the top card from the deck."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of cards in the deck."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 100 000"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the number written on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th from top card in the deck."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the total number of times Vasily takes the top card from the deck."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n6 3 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n1000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n3 3 3 3 3 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Vasily at first looks at the card with number "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" on it, puts it under the deck, then on the card with number "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", puts it under the deck, and then on the card with number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". He places away the card with "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", because the number written on it is the minimum among the remaining cards. After that the cards from top to bottom are "},{"kind":"math_inline","text":"[2, 6, 3]"},{"kind":"text","text":". Then Vasily looks at the top card with number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and puts it away. After that the cards from top to bottom are "},{"kind":"math_inline","text":"[6, 3]"},{"kind":"text","text":". Then Vasily looks at card "},{"kind":"math_inline","text":"6"},{"kind":"text","text":", puts it under the deck, then at card "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and puts it away. Then there is only one card with number "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" on it, and Vasily looks at it and puts it away. Thus, in total Vasily looks at "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" cards."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"830B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/830/problem/B"}