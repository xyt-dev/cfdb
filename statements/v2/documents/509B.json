{"assets":[],"contentKind":"statement","contestId":"509","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Painting Pebbles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" piles of pebbles on the table, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th pile contains "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" pebbles. Your task is to paint each pebble using one of the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" given colors so that for each color "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" and any two piles "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" the difference between the number of pebbles of color "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" in pile "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and number of pebbles of color "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" in pile "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" is at most one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In other words, let's say that "},{"kind":"math_inline","text":"bi, c"},{"kind":"text","text":" is the number of pebbles of color "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th pile. Then for any "},{"kind":"math_inline","text":"1 ≤ c ≤ k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ i, j ≤ n"},{"kind":"text","text":" the following condition must be satisfied "},{"kind":"math_inline","text":"|bi, c - bj, c| ≤ 1"},{"kind":"text","text":". It isn't necessary to use all "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" colors: if color "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" hasn't been used in pile "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"bi, c"},{"kind":"text","text":" is considered to be zero."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, k ≤ 100"},{"kind":"text","text":"), separated by a space — the number of piles and the number of colors respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 100"},{"kind":"text","text":") denoting number of pebbles in each of the piles."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no way to paint the pebbles satisfying the given condition, output \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) ."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise in the first line output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes). Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines should follow, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should contain "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" space-separated integers. "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th ("},{"kind":"math_inline","text":"1 ≤ j ≤ ai"},{"kind":"text","text":") of these integers should be equal to the color of the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th pebble in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th pile. "},{"children":[{"kind":"text","text":"If there are several possible answers, you may output any of them."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n1 2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1\n1 4\n1 2 4\n1 2 3 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n3 2 4 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n3 2 4 3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1 2 3\n1 3\n1 2 3 4\n1 3 4\n1 1 2 3 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"509B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/509/problem/B"}