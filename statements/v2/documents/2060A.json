{"assets":[],"contentKind":"statement","contestId":"2060","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Fibonacciness"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is an array of $$$5$$$ integers. Initially, you only know $$$a_1,a_2,a_4,a_5$$$. You may set $$$a_3$$$ to any positive integer, negative integer, or zero. The "},{"children":[{"kind":"text","text":"Fibonacciness"}],"kind":"container"},{"kind":"text","text":" of the array is the number of integers $$$i$$$ ($$$1 \\leq i \\leq 3$$$) such that $$$a_{i+2}=a_i+a_{i+1}$$$. Find the maximum "},{"children":[{"kind":"text","text":"Fibonacciness"}],"kind":"container"},{"kind":"text","text":" over all integer values of $$$a_3$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\leq t \\leq 500$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains four integers $$$a_1, a_2, a_4, a_5$$$ ($$$1 \\leq a_i \\leq 100$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the maximum "},{"children":[{"kind":"text","text":"Fibonacciness"}],"kind":"container"},{"kind":"text","text":" on a new line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 1 3 5\n1 3 2 1\n8 10 28 100\n100 1 100 1\n1 100 1 100\n100 100 100 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2\n2\n1\n1\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, we can set $$$a_3$$$ to $$$2$$$ to achieve the maximal "},{"children":[{"kind":"text","text":"Fibonacciness"}],"kind":"container"},{"kind":"text","text":" of $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, it can be shown that $$$2$$$ is the maximum "},{"children":[{"kind":"text","text":"Fibonacciness"}],"kind":"container"},{"kind":"text","text":" that can be achieved. This can be done by setting $$$a_3$$$ to $$$18$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2060A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2060/problem/A"}