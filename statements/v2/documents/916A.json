{"assets":[],"contentKind":"statement","contestId":"916","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Jamie and Alarm Snooze"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Jamie loves sleeping. One day, he decides that he needs to wake up at exactly "},{"kind":"math_inline","text":"hh: mm"},{"kind":"text","text":". However, he hates waking up, so he wants to make waking up less painful by setting the alarm at a "},{"children":[{"kind":"text","text":"lucky"}],"kind":"container"},{"kind":"text","text":" time. He will then press the snooze button every "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" minutes until "},{"kind":"math_inline","text":"hh: mm"},{"kind":"text","text":" is reached, and only then he will wake up. He wants to know what is the smallest number of times he needs to press the snooze button."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A time is considered "},{"children":[{"kind":"text","text":"lucky"}],"kind":"container"},{"kind":"text","text":" if it contains a digit '"},{"kind":"math_inline","text":"7"},{"kind":"text","text":"'. For example, "},{"kind":"math_inline","text":"13: 07"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"17: 27"},{"kind":"text","text":" are "},{"children":[{"kind":"text","text":"lucky"}],"kind":"container"},{"kind":"text","text":", while "},{"kind":"math_inline","text":"00: 48"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"21: 34"},{"kind":"text","text":" are not "},{"children":[{"kind":"text","text":"lucky"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that it is not necessary that the time set for the alarm and the wake-up time are on the same day. It is guaranteed that there is a "},{"children":[{"kind":"text","text":"lucky"}],"kind":"container"},{"kind":"text","text":" time Jamie can set so that he can wake at "},{"kind":"math_inline","text":"hh: mm"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, find the smallest possible non-negative integer "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" such that the time representation of the time "},{"kind":"math_inline","text":"x·y"},{"kind":"text","text":" minutes before "},{"kind":"math_inline","text":"hh: mm"},{"kind":"text","text":" contains the digit '"},{"kind":"math_inline","text":"7"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Jamie uses 24-hours clock, so after "},{"kind":"math_inline","text":"23: 59"},{"kind":"text","text":" comes "},{"kind":"math_inline","text":"00: 00"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ 60"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains two two-digit integers, "},{"kind":"math_inline","text":"hh"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"mm"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"00 ≤ hh ≤ 23, 00 ≤ mm ≤ 59"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of times he needs to press the button."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n11 23\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n01 07\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Jamie needs to wake up at 11:23. So, he can set his alarm at 11:17. He would press the snooze button when the alarm rings at 11:17 and at 11:20."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, Jamie can set his alarm at exactly at 01:07 which is "},{"children":[{"kind":"text","text":"lucky"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"916A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/916/problem/A"}