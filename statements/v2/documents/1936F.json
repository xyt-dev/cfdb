{"assets":["/statement-assets/09f062459fa8444cac9fb9f7c5a0b92299bbdd663bd7aa6dc5cbeecb59291297.png","/statement-assets/38fe5c07df905177f47a610326e5329347fa2817763431827c6275cc659b0908.png"],"contentKind":"statement","contestId":"1936","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Grand Finale: Circles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given $$$n$$$ circles on the plane. The $$$i$$$-th of these circles is given by a tuple of integers $$$(x_i, y_i, r_i)$$$, where $$$(x_i, y_i)$$$ are the coordinates of its center, and $$$r_i$$$ is the radius of the circle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please find a circle $$$C$$$ which meets the following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$C$$$ is contained inside all $$$n$$$ circles given in the input. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Among all circles $$$C$$$ that meet the first condition, the radius of the circle is maximum. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let the largest suitable circle have the radius of $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your output $$$C$$$, described as $$$(x,y,r)$$$, will be accepted if it meets the following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" For each $$$i$$$, $$$\\sqrt{(x_i-x)^2+(y_i-y)^2}+ r \\le r_i+\\max(a,1)\\cdot 10^{-7}$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The absolute or relative error of $$$r$$$ does not exceed $$$10^{-7}$$$. Formally, your answer is accepted if and only if $$$\\frac{\\left|r - a\\right|}{\\max(1, a)} \\le 10^{-7}$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$1 \\le n \\le 10^5$$$) — the number of circles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the following $$$n$$$ lines contains three integers $$$x_i$$$, $$$y_i$$$, $$$r_i$$$ ($$$-10^6 \\le x_i,y_i \\le 10^6$$$, $$$1 \\le r_i \\le 2 \\cdot 10^6$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there is a circle with a radius of at least $$$10^{-6}$$$ which is contained inside all $$$n$$$ circles."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output three real values, $$$x$$$, $$$y$$$, and $$$r$$$ — the coordinates of the center and the radius of the circle."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 1 3\n-1 1 3\n1 -1 2\n-1 -1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0.0000000000000000 -0.7637626158259733 0.9724747683480533\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n41580 -23621 95642\n-41580 -23621 95642\n0 47821 95642\n0 0 109750\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0.0000000000000000 0.0000000000000000 47821.0000000000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A two-dimensional plot depicting the first test case is given below. The output circle $$$C$$$ is dashed with blue lines."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/09f062459fa8444cac9fb9f7c5a0b92299bbdd663bd7aa6dc5cbeecb59291297.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"A two-dimensional plot depicting the second test case is given below. The output circle $$$C$$$ is dashed with blue lines."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/38fe5c07df905177f47a610326e5329347fa2817763431827c6275cc659b0908.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1936F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1936/problem/F"}