{"assets":[],"contentKind":"statement","contestId":"1211","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Teams"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are $$$n$$$ table bowling players, the rating of the $$$i$$$-th player equals $$$r_i$$$. Compose a maximum number of teams in a such way that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" each player belongs to at most one team; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" each team contains exactly $$$a+b$$$ players; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" each team contains a group of $$$a$$$ players with the same rating and a group of $$$b$$$ players with another same rating, which must be $$$k$$$ times larger than the rating of the players in the first group. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, if $$$n=12$$$, $$$r=[1, 1, 2, 2, 2, 2, 2, 3, 3, 4, 6, 6]$$$, $$$a=1$$$, $$$b=2$$$, $$$k=2$$$, you can compose two teams with ratings $$$[1, 2, 2]$$$ and one team with ratings $$$[3, 6, 6]$$$. So, the maximum number of teams is $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the maximum number of teams by given $$$n, r_1 \\dots r_n, a, b$$$ and $$$k$$$ to compose in respect to the given requirements."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains four integers $$$n$$$, $$$a$$$, $$$b$$$ and $$$k$$$ ($$$1 \\le n,a,b \\le 3\\cdot10^5$$$, $$$2 \\le k \\le 1000$$$). The second line contains the sequence of player's ratings — integers $$$r_1, r_2, \\dots, r_n$$$ ($$$1 \\le r_i \\le 10^6$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print only one integer — the maximum number of teams that can be composed from $$$n$$$ given players."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n12 1 2 2\n1 1 2 2 2 2 2 3 3 4 6 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n14 1 1 3\n3 3 1 1 9 9 2 3 6 6 3 18 3 18\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1 2 3 10\n1000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1211D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1211/problem/D"}