{"assets":["/statement-assets/5dd28c222cdc3e86aa09d3836f4c026086cfdf08782e8f92a1e75d5b1fb6560a.png","/statement-assets/dc97d0a92435e8b2d68ea092e18da5b754277441d089561422eeac40d7225930.png"],"contentKind":"statement","contestId":"1800","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Symmetree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Kid was gifted a tree of $$$n$$$ vertices with the root in the vertex $$$1$$$. Since he really like "},{"children":[{"kind":"text","text":"symmetrical"}],"kind":"container"},{"kind":"text","text":" objects, Kid wants to find out if this tree is "},{"children":[{"kind":"text","text":"symmetrical"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5dd28c222cdc3e86aa09d3836f4c026086cfdf08782e8f92a1e75d5b1fb6560a.png"},"kind":"image"},{"children":[{"kind":"text","text":"For example, the trees in the picture above are "},{"children":[{"kind":"text","text":"symmetrical"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"container"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/dc97d0a92435e8b2d68ea092e18da5b754277441d089561422eeac40d7225930.png"},"kind":"image"},{"children":[{"kind":"text","text":"And the trees in this picture are not "},{"children":[{"kind":"text","text":"symmetrical"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Formally, a tree is "},{"children":[{"kind":"text","text":"symmetrical"}],"kind":"container"},{"kind":"text","text":" if there exists an order of children such that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The subtree of the leftmost child of the root is a mirror image of the subtree of the rightmost child; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the subtree of the second-left child of the root is a mirror image of the subtree of the second-right child of the root; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" ... "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if the number of children of the root is odd, then the subtree of the middle child should be "},{"children":[{"kind":"text","text":"symmetrical"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input data contains single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases in the test."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each case contains an integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the number of vertices in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following $$$n-1$$$ lines contain two integers each $$$u$$$ and $$$v$$$ ($$$1 \\le u, v \\le n$$$, $$$u \\neq v$$$) — indices of vertices connected by an edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output $$$t$$$ strings, each of which is the answer to the corresponding test case. As an answer, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if this tree is "},{"children":[{"kind":"text","text":"symmetrical"}],"kind":"container"},{"kind":"text","text":", and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output the answer in any case (for example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be recognized as a positive answer)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n6\n1 5\n1 6\n1 2\n2 3\n2 4\n7\n1 5\n1 3\n3 6\n1 4\n4 7\n4 2\n9\n1 2\n2 4\n2 3\n3 5\n1 7\n7 6\n7 8\n8 9\n10\n2 9\n9 10\n2 3\n6 7\n4 3\n1 2\n3 8\n2 5\n6 5\n10\n3 2\n8 10\n9 7\n4 2\n8 2\n2 1\n4 5\n6 5\n5 7\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\nYES\nNO\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1800G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1800/problem/G"}