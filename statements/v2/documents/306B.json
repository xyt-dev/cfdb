{"assets":[],"contentKind":"statement","contestId":"306","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Optimizer"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A process RAM is a sequence of bytes that are indexed from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Polycarpus's program contains such instructions as \""},{"children":[{"kind":"text","text":"memset"}],"kind":"container"},{"kind":"text","text":"\", that is, the operations of filling memory cells on a segment with some value. The details are: the code only contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" instructions that look like \""},{"children":[{"kind":"text","text":"set13 a_i l_i"}],"kind":"container"},{"kind":"text","text":"\". Instruction "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" fills a continuous memory segment of length "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", starting from cell number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", (that it cells with numbers "},{"kind":"math_inline","text":"ai, ai + 1, ..., ai + li - 1"},{"kind":"text","text":") with values 13."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In Polycarpus's code, the optimizer's task is to remove the maximum number of instructions from his code in such a way that the remaining instructions set value 13 in all the memory bytes that got this value from the code before the optimization. Also, the value 13 should be set only in the memory bytes that got this value from the code before the optimization. Your task is to implement the optimizer for such program."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·106, 1 ≤ m ≤ 2·105"},{"kind":"text","text":") — the number of bytes (memory cells) and the number of instructions in Polycarpus's code. Then "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follow, each line contains a pair of integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ n, 1 ≤ li ≤ n - ai + 1"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print in the first line the sought maximum number of instructions that can be removed from the code. In the second line print the numbers of the instructions. The instructions are numbered from 1 to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" in the order they appeared in the input. If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 4\n3 3\n3 1\n4 1\n9 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 3 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"306B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/306/problem/B"}