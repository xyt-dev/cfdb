{"assets":[],"contentKind":"statement","contestId":"2128","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E1. Submedians (Easy Version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is the easy version of the problem. The only difference is that in this version, you are asked to find a subarray only for the maximum "},{"children":[{"kind":"text","text":"submedian"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"You can make hacks only if both versions of the problem are solved."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An integer $$$v$$$ is a "},{"children":[{"kind":"text","text":"median"}],"kind":"container"},{"kind":"text","text":" of an array $$$b$$$ of length $$$m$$$ if and only if: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$v$$$ is greater than or equal to at least $$$\\lceil \\frac{m}{2} \\rceil$$$ elements of the array, and "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$v$$$ is less than or equal to at least $$$\\lceil \\frac{m}{2} \\rceil$$$ elements of the array. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" For instance: "},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the only "},{"children":[{"kind":"text","text":"median"}],"kind":"container"},{"kind":"text","text":" of $$$[9, 3, 7]$$$ is $$$7$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the "},{"children":[{"kind":"text","text":"medians"}],"kind":"container"},{"kind":"text","text":" of $$$[5, 3, 7, 9]$$$ are $$$5$$$, $$$6$$$, and $$$7$$$, and "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the only "},{"children":[{"kind":"text","text":"median"}],"kind":"container"},{"kind":"text","text":" of $$$[2, 2, 2]$$$ is $$$2$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You're given an integer $$$k$$$ and an array $$$a_1, \\ldots, a_n$$$ of integers between $$$1$$$ and $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An integer $$$v$$$ from $$$1$$$ to $$$n$$$ is said to be a "},{"children":[{"kind":"text","text":"submedian"}],"kind":"container"},{"kind":"text","text":" if there exists at least one pair of indices $$$(l, r)$$$ such that "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1 \\leq l \\leq r \\leq n$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$r - l + 1 \\geq k$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$v$$$ is a "},{"children":[{"kind":"text","text":"median"}],"kind":"container"},{"kind":"text","text":" of the subarray $$$[a_l, \\ldots, a_r]$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It can be proven that there always exists at least one "},{"children":[{"kind":"text","text":"submedian"}],"kind":"container"},{"kind":"text","text":". Find the maximum "},{"children":[{"kind":"text","text":"submedian"}],"kind":"container"},{"kind":"text","text":" $$$v_\\max$$$ and any corresponding pair of indices $$$(l, r)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 50\\,000$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\leq k \\leq n \\leq 300\\,000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\leq a_i \\leq n$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases doesn't exceed $$$300\\,000$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output three integers $$$v_\\max$$$, $$$l$$$, and $$$r$$$ — the maximum "},{"children":[{"kind":"text","text":"submedian"}],"kind":"container"},{"kind":"text","text":" $$$v_\\max$$$ and the bounds of a subarray of length at least $$$k$$$ ($$$r - l + 1 \\geq k$$$) such that $$$v_\\max$$$ is one of its "},{"children":[{"kind":"text","text":"medians"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are many solutions, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n4 3\n4 1 2 4\n5 2\n1 2 3 2 1\n5 3\n1 2 3 2 1\n5 3\n1 1 2 5 3\n1 1\n1\n2 1\n2 1\n4 1\n1 2 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4 1 4\n3 3 4\n2 2 4\n3 3 5\n1 1 1\n2 1 2\n3 4 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the subarrays of length at least $$$k = 3$$$ are "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$(l = 1, r = 3)$$$: $$$[4, 1, 2]$$$ whose only "},{"children":[{"kind":"text","text":"median"}],"kind":"container"},{"kind":"text","text":" is $$$2$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(l = 2, r = 4)$$$: $$$[1, 2, 4]$$$ whose only "},{"children":[{"kind":"text","text":"median"}],"kind":"container"},{"kind":"text","text":" is $$$2$$$, and "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(l = 1, r = 4)$$$: $$$[4, 1, 2, 4]$$$ whose "},{"children":[{"kind":"text","text":"medians"}],"kind":"container"},{"kind":"text","text":" are $$$2$$$, $$$3$$$, and $$$4$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second test case, one possible output is $$$(l = 3, r = 4)$$$ whose "},{"children":[{"kind":"text","text":"medians"}],"kind":"container"},{"kind":"text","text":" are $$$2$$$ and $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that it can be proven that no subarray of length at least $$$2$$$ admits $$$4$$$ or $$$5$$$ as a "},{"children":[{"kind":"text","text":"median"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E1","problemCode":"2128E1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2128/problem/E1"}