{"assets":[],"contentKind":"statement","contestId":"1036","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Classy Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's call some positive integer "},{"children":[{"kind":"text","text":"classy"}],"kind":"container"},{"kind":"text","text":" if its decimal representation contains no more than $$$3$$$ non-zero digits. For example, numbers $$$4$$$, $$$200000$$$, $$$10203$$$ are "},{"children":[{"kind":"text","text":"classy"}],"kind":"container"},{"kind":"text","text":" and numbers $$$4231$$$, $$$102306$$$, $$$7277420000$$$ are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a segment $$$[L; R]$$$. Count the number of "},{"children":[{"kind":"text","text":"classy"}],"kind":"container"},{"kind":"text","text":" integers $$$x$$$ such that $$$L \\le x \\le R$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each testcase contains several segments, for each of them you are required to solve the problem separately."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$T$$$ ($$$1 \\le T \\le 10^4$$$) — the number of segments in a testcase."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$T$$$ lines contains two integers $$$L_i$$$ and $$$R_i$$$ ($$$1 \\le L_i \\le R_i \\le 10^{18}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$T$$$ lines — the $$$i$$$-th line should contain the number of "},{"children":[{"kind":"text","text":"classy"}],"kind":"container"},{"kind":"text","text":" integers on a segment $$$[L_i; R_i]$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1000\n1024 1024\n65536 65536\n999999 1000001\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1000\n1\n0\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1036C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1036/problem/C"}