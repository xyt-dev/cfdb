{"assets":[],"contentKind":"statement","contestId":"417","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Crash"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"During the \"Russian Code Cup\" programming competition, the testing system stores all sent solutions for each participant. We know that many participants use random numbers in their programs and are often sent several solutions with the same source code to check."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each participant is identified by some unique positive integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", and each sent solution "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is characterized by two numbers: "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" — the number of different solutions that are sent before the first solution identical to "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of the participant, who is the author of the solution. Consequently, all identical solutions have the same "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is known that the data in the testing system are stored in the chronological order, that is, if the testing system has a solution with number "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"(x > 0)"},{"kind":"text","text":" of the participant with number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", then the testing system has a solution with number "},{"kind":"math_inline","text":"x - 1"},{"kind":"text","text":" of the same participant stored somewhere before."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During the competition the checking system crashed, but then the data of the submissions of all participants have been restored. Now the jury wants to verify that the recovered data is in chronological order. Help the jury to do so."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of solutions. Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers separated by space "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ x ≤ 105"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"1 ≤ k ≤ 105"},{"kind":"text","text":") — the number of previous unique solutions and the identifier of the participant."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line of the output should contain «"},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"» if the data is in chronological order, and «"},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"» otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n0 1\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 1\n1 2\n1 1\n0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 1\n1 1\n0 1\n0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"417B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/417/problem/B"}