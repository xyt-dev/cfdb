{"assets":["/statement-assets/b1ae29f7e765554a0c00f0ca80377835354e42ff5e135e6af6b4500aab7ab22b.png","/statement-assets/8d94f046650afe1b6b9e727b73a4bc0f40e81744d2fda30cc2829d83a33ae3c1.png"],"contentKind":"statement","contestId":"615","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Hexagons"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ayrat is looking for the perfect code. He decided to start his search from an infinite field tiled by hexagons. For convenience the coordinate system is introduced, take a look at the picture to see how the coordinates of hexagon are defined: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b1ae29f7e765554a0c00f0ca80377835354e42ff5e135e6af6b4500aab7ab22b.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/8d94f046650afe1b6b9e727b73a4bc0f40e81744d2fda30cc2829d83a33ae3c1.png"},"kind":"image"},{"kind":"text","text":" Ayrat is searching through the field. He started at point "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":" and is moving along the spiral (see second picture). Sometimes he forgets where he is now. Help Ayrat determine his location after "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" moves."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ n ≤ 1018"},{"kind":"text","text":") — the number of Ayrat's moves."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" — current coordinates of Ayrat coordinates."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-2 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"615E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/615/problem/E"}