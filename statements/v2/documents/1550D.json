{"assets":[],"contentKind":"statement","contestId":"1550","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Excellent Arrays"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's call an integer array $$$a_1, a_2, \\dots, a_n$$$ "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if $$$a_i \\neq i$$$ for each $$$i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$F(a)$$$ be the number of pairs $$$(i, j)$$$ ($$$1 \\le i \\lt j \\le n$$$) such that $$$a_i + a_j = i + j$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's say that an array $$$a_1, a_2, \\dots, a_n$$$ is "},{"children":[{"kind":"text","text":"excellent"}],"kind":"container"},{"kind":"text","text":" if: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a$$$ is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$l \\le a_i \\le r$$$ for each $$$i$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$F(a)$$$ is the maximum possible among all "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" arrays of size $$$n$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Given $$$n$$$, $$$l$$$ and $$$r$$$, calculate the number of "},{"children":[{"kind":"text","text":"excellent"}],"kind":"container"},{"kind":"text","text":" arrays modulo $$$10^9 + 7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first and only line of each test case contains three integers $$$n$$$, $$$l$$$, and $$$r$$$ ($$$2 \\le n \\le 2 \\cdot 10^5$$$; $$$-10^9 \\le l \\le 1$$$; $$$n \\le r \\le 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the sum of $$$n$$$ doesn't exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the number of excellent arrays modulo $$$10^9 + 7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n3 0 3\n4 -3 5\n42 -33 55\n69 -42 146\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n10\n143922563\n698570404\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, it can be proven that the maximum $$$F(a)$$$ among all "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text",