{"assets":[],"contentKind":"statement","contestId":"785","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Anton and Classes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Anton likes to play chess. Also he likes to do programming. No wonder that he decided to attend chess classes and programming classes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Anton has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" variants when he will attend chess classes, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th variant is given by a period of time "},{"kind":"math_inline","text":"(l1, i, r1, i)"},{"kind":"text","text":". Also he has "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" variants when he will attend programming classes, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th variant is given by a period of time "},{"kind":"math_inline","text":"(l2, i, r2, i)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Anton needs to choose "},{"children":[{"kind":"text","text":"exactly one"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" possible periods of time when he will attend chess classes and "},{"children":[{"kind":"text","text":"exactly one"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" possible periods of time when he will attend programming classes. He wants to have a rest between classes, so from all the possible pairs of the periods he wants to choose the one where the distance between the periods is maximal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The distance between periods "},{"kind":"math_inline","text":"(l1, r1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(l2, r2)"},{"kind":"text","text":" is the minimal possible distance between a point in the first period and a point in the second period, that is the minimal possible "},{"kind":"math_inline","text":"|i - j|"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"l1 ≤ i ≤ r1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"l2 ≤ j ≤ r2"},{"kind":"text","text":". In particular, when the periods intersect, the distance between them is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Anton wants to know how much time his rest between the classes will last in the best case. Help Anton and find this number!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 200 000)"},{"kind":"text","text":" — the number of time periods when Anton can attend chess classes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines of the input contains two integers "},{"kind":"math_inline","text":"l1, i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r1, i"},{"kind":"math_inline","text":"(1 ≤ l1, i ≤ r1, i ≤ 109)"},{"kind":"text","text":" — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th variant of a period of time when Anton can attend chess classes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following line of the input contains a single integer "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ m ≤ 200 000)"},{"kind":"text","text":" — the number of time periods when Anton can attend programming classes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines of the input contains two integers "},{"kind":"math_inline","text":"l2, i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r2, i"},{"kind":"math_inline","text":"(1 ≤ l2, i ≤ r2, i ≤ 109)"},{"kind":"text","text":" — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th variant of a period of time when Anton can attend programming classes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one integer — the maximal possible distance between time periods."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 5\n2 6\n2 3\n2\n2 4\n6 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 5\n2 6\n3 7\n2\n2 4\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Anton can attend chess classes in the period "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":" and attend programming classes in the period "},{"kind":"math_inline","text":"(6, 8)"},{"kind":"text","text":". It's not hard to see that in this case the distance between the periods will be equal to "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample if he chooses any pair of periods, they will intersect. So the answer is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"785B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/785/problem/B"}