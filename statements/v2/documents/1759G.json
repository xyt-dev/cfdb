{"assets":[],"contentKind":"statement","contestId":"1759","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Restore the Permutation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A sequence of $$$n$$$ numbers is called "},{"children":[{"kind":"text","text":"permutation"}],"kind":"container"},{"kind":"text","text":" if it contains all numbers from $$$1$$$ to $$$n$$$ exactly once. For example, the sequences [$$$3, 1, 4, 2$$$], [$$$1$$$] and [$$$2,1$$$] are permutations, but [$$$1,2,1$$$], [$$$0,1$$$] and [$$$1,3,4$$$] — are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a permutation $$$p$$$ of even length $$$n$$$ you can make an array $$$b$$$ of length $$$\\frac{n}{2}$$$ such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$b_i = \\max(p_{2i - 1}, p_{2i})$$$ for $$$1 \\le i \\le \\frac{n}{2}$$$ "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, if $$$p$$$ = [$$$2, 4, 3, 1, 5, 6$$$], then: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$b_1 = \\max(p_1, p_2) = \\max(2, 4) = 4$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b_2 = \\max(p_3, p_4) = \\max(3,1)=3$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b_3 = \\max(p_5, p_6) = \\max(5,6) = 6$$$ "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" As a result, we made $$$b$$$ = $$$[4, 3, 6]$$$."},{"children":[{"kind":"text","text":"For a given array $$$b$$$, find the "},{"children":[{"kind":"text","text":"lexicographically minimal"}],"kind":"container"},{"kind":"text","text":" permutation $$$p$$$ such that you can make the given array $$$b$$$ from it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If $$$b$$$ = [$$$4,3,6$$$], then the lexicographically minimal permutation from which it can be made is $$$p$$$ = [$$$1,4,2,3,5,6$$$], since: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$b_1 = \\max(p_1, p_2) = \\max(1, 4) = 4$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b_2 = \\max(p_3, p_4) = \\max(2, 3) = 3$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b_3 = \\max(p_5, p_6) = \\max(5, 6) = 6$$$ "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A permutation $$$x_1, x_2, \\dots, x_n$$$ is lexicographically smaller than a permutation $$$y_1, y_2 \\dots, y_n$$$ if and only if there exists such $$$i$$$ ($$$1 \\le i \\le n$$$) that $$$x_1=y_1, x_2=y_2, \\dots, x_{i-1}=y_{i-1}$$$ and $$$x_i \\lt y_i$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input data contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains one even integer $$$n$$$ ($$$2 \\le n \\le 2 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains exactly $$$\\frac{n}{2}$$$ integers $$$b_i$$$ ($$$1 \\le b_i \\le n$$$) — elements of array $$$b$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ values over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print on a separate line: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" lexicographically minimal permutation $$$p$$$ such that you can make an array $$$b$$$ from it; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" or a number "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if the permutation you are looking for does not exist. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n6\n4 3 6\n4\n2 4\n8\n8 7 2 3\n6\n6 4 2\n4\n4 4\n8\n8 7 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 4 2 3 5 6 \n1 2 3 4 \n-1\n5 6 3 4 1 2 \n-1\n1 8 6 7 2 4 3 5 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test case is parsed in the problem statement."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1759G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1759/problem/G"}