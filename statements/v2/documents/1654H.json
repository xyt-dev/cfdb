{"assets":[],"contentKind":"statement","contestId":"1654","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Three Minimums"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"8 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Given a list of distinct values, we denote with "},{"children":[{"kind":"text","text":"first minimum"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"second minimum"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"third minimum"}],"kind":"container"},{"kind":"text","text":" the three smallest values (in increasing order)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A permutation $$$p_1, p_2, \\dots, p_n$$$ is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if the following statement holds for all pairs $$$(l,r)$$$ with $$$1\\le l \\lt l+2 \\le r\\le n$$$. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If $$$\\{p_l, p_r\\}$$$ are (not necessarily in this order) the first and second minimum of $$$p_l, p_{l+1}, \\dots, p_r$$$ then the third minimum of $$$p_l, p_{l+1},\\dots, p_r$$$ is either $$$p_{l+1}$$$ or $$$p_{r-1}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given an integer $$$n$$$ and a string $$$s$$$ of length $$$m$$$ consisting of characters \""},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Count the number of "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" permutations $$$p_1, p_2,\\dots, p_n$$$ such that, for all $$$1\\le i\\le m$$$, "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$p_i \\lt p_{i+1}$$$ if $$$s_i =$$$ \""},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$p_i \\gt p_{i+1}$$$ if $$$s_i =$$$ \""},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" As the result can be very large, you should print it modulo $$$998\\,244\\,353$$$."}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$m$$$ ($$$2 \\le n \\le 2 \\cdot 10^5$$$, $$$1 \\leq m \\leq \\min(100, n-1)$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string $$$s$$$ of length $$$m$$$, consisting of characters \""},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer: the number of good permutations satisfying the constraints described in the statement, modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 3\n>>>\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 1\n<\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n56\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6 5\n<<><>\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n23\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10 5\n><<><\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n83154\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1008 20\n<><<>>><<<<<>>>>>>>>\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n284142857\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test, there are $$$5$$$ good permutations satisfying the constraints given by the string $$$s$$$: $$$[4, 3, 2, 1, 5]$$$, $$$[5, 3, 2, 1, 4]$$$, $$$[5, 4, 2, 1, 3]$$$, $$$[5, 4, 3, 1, 2]$$$, $$$[5, 4, 3, 2, 1]$$$. Each of them "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" is good; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" satisfies $$$p_1 \\gt p_2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" satisfies $$$p_2 \\gt p_3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" satisfies $$$p_3 \\gt p_4$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second test, there are $$$60$$$ permutations such that $$$p_1 \\lt p_2$$$. Only $$$56$$$ of them are good: the permutations $$$[1, 4, 3, 5, 2]$$$, $$$[1, 5, 3, 4, 2]$$$, $$$[2, 4, 3, 5, 1]$$$, $$$[2, 5, 3, 4, 1]$$$ are not good because the required condition doesn't hold for $$$(l, r)$$$ = $$$(1, 5)$$$. For example, for the permutation $$$[2, 4, 3, 5, 1]$$$, "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the first minimum and the second minimum are $$$p_5$$$ and $$$p_1$$$, respectively (so they are $$$\\{p_l, p_r\\}$$$ up to reordering); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the third minimum is $$$p_3$$$ (neither $$$p_{l+1}$$$ nor $$$p_{r-1}$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the third test, there are $$$23$$$ good permutations satisfying the constraints given by the string $$$s$$$: $$$[1, 2, 4, 3, 6, 5]$$$, $$$[1, 2, 5, 3, 6, 4]$$$, $$$[1, 2, 6, 3, 5, 4]$$$, $$$[1, 3, 4, 2, 6, 5]$$$, $$$[1, 3, 5, 2, 6, 4]$$$, $$$[1, 3, 6, 2, 5, 4]$$$, $$$[1, 4, 5, 2, 6, 3]$$$, $$$[1, 4, 6, 2, 5, 3]$$$, $$$[1, 5, 6, 2, 4, 3]$$$, $$$[2, 3, 4, 1, 6, 5]$$$, $$$[2, 3, 5, 1, 6, 4]$$$, $$$[2, 3, 6, 1, 5, 4]$$$, $$$[2, 4, 5, 1, 6, 3]$$$, $$$[2, 4, 6, 1, 5, 3]$$$, $$$[2, 5, 6, 1, 4, 3]$$$, $$$[3, 4, 5, 1, 6, 2]$$$, $$$[3, 4, 5, 2, 6, 1]$$$, $$$[3, 4, 6, 1, 5, 2]$$$, $$$[3, 4, 6, 2, 5, 1]$$$, $$$[3, 5, 6, 1, 4, 2]$$$, $$$[3, 5, 6, 2, 4, 1]$$$, $$$[4, 5, 6, 1, 3, 2]$$$, $$$[4, 5, 6, 2, 3, 1]$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"1654H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1654/problem/H"}