{"assets":[],"contentKind":"statement","contestId":"845","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Chess Tourney"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Berland annual chess tournament is coming!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Organizers have gathered "},{"kind":"math_inline","text":"2·n"},{"kind":"text","text":" chess players who should be divided into two teams with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people each. The first team is sponsored by BerOil and the second team is sponsored by BerMobile. Obviously, organizers should guarantee the win for the team of BerOil."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus, organizers should divide all "},{"kind":"math_inline","text":"2·n"},{"kind":"text","text":" players into two teams with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people each in such a way that the first team always wins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Every chess player has its rating "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":". It is known that chess player with the greater rating always wins the player with the lower rating. If their ratings are equal then any of the players can win."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After teams assignment there will come a drawing to form "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pairs of opponents: in each p