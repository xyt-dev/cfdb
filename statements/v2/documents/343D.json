{"assets":[],"contentKind":"statement","contestId":"343","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Water Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mad scientist Mike has constructed a rooted tree, which consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. Each vertex is a reservoir which can be either empty or filled with water."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The vertices of the tree are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" with the root at vertex 1. For each vertex, the reservoirs of its children are located below the reservoir of this vertex, and the vertex is connected with each of the children by a pipe through which water can flow downwards."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mike wants to do the following operations with the tree: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Fill vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" with water. Then "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and all its children are filled with water. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Empty vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". Then "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and all its ancestors are emptied. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Determine whether vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is filled with water at the moment. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" Initially all vertices of the tree are empty."},{"children":[{"kind":"text","text":"Mike has already compiled a full list of operations that he wants to perform in order. Before experimenting with the tree Mike decided to run the list through a simulation. Help Mike determine what results will he get after performing all the operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 500000"},{"kind":"text","text":") — the number of vertices in the tree. Each of the following "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains two space-separated numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":") — the edges of the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains a number "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 500000"},{"kind":"text","text":") — the number of operations to perform. Each of the following "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains two space-separated numbers "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci ≤ 3"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ vi ≤ n"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" is the operation type (according to the numbering given in the statement), and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" is the vertex on which the operation is performed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given graph is a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each type 3 operation print 1 on a separate line if the vertex is full, and 0 if the vertex is empty. Print the answers to queries in the order in which the queries are given in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2\n5 1\n2 3\n4 2\n12\n1 1\n2 3\n3 1\n3 2\n3 3\n3 4\n1 2\n2 4\n3 1\n3 3\n3 4\n3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n0\n0\n1\n0\n1\n0\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"343D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/343/problem/D"}