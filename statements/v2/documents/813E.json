{"assets":[],"contentKind":"statement","contestId":"813","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Army Creation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As you might remember from our previous rounds, Vova really likes computer games. Now he is playing a strategy game known as Rage of Empires."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the game Vova can hire "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different warriors; "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th warrior has the type "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". Vova wants to create a "},{"children":[{"kind":"text","text":"balanced"}],"kind":"container"},{"kind":"text","text":" army hiring some subset of warriors. An army is called "},{"children":[{"kind":"text","text":"balanced"}],"kind":"container"},{"kind":"text","text":" if for each type of warrior present in the game there are not more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" warriors of this type in the army. Of course, Vova wants his army to be as large as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To make things more complicated, Vova has to consider "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" different plans of creating his army. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th plan allows him to hire only warriors whose numbers are not less than "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and not greater than "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Vova to determine the largest size of a "},{"children":[{"kind":"text","text":"balanced"}],"kind":"container"},{"kind":"text","text":" army for each plan."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Be aware that the plans are given in a modified way. See input section for details."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, k ≤ 100000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ... "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 100000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains one integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 100000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines follow. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th line contains two numbers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" which represent "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th plan ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to keep track of the answer to the last plan (let's call it "},{"kind":"math_inline","text":"last"},{"kind":"text","text":"). In the beginning "},{"kind":"math_inline","text":"last = 0"},{"kind":"text","text":". Then to restore values of "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th plan, you have to do the following:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"li = ((xi + last) mod n) + 1"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ri = ((yi + last) mod n) + 1"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"li > ri"},{"kind":"text","text":", swap "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" numbers. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th number must be equal to the maximum size of a "},{"children":[{"kind":"text","text":"balanced"}],"kind":"container"},{"kind":"text","text":" army when considering "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th plan."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2\n1 1 1 2 2 2\n5\n1 6\n4 3\n1 1\n2 6\n2 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n4\n1\n3\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the real plans are: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"1 2"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1 6"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"6 6"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2 4"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"4 6"}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"813E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/813/problem/E"}