{"assets":[],"contentKind":"statement","contestId":"1063","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. String Journey"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"We call a sequence of strings "},{"kind":"math_inline","text":"t1, ..., tk"},{"kind":"text","text":" a "},{"children":[{"kind":"text","text":"journey"}],"kind":"container"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", if for each "},{"kind":"math_inline","text":"i > 1"},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" is a substring of "},{"kind":"math_inline","text":"ti - 1"},{"kind":"text","text":" and length of "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" is strictly less than length of "},{"kind":"math_inline","text":"ti - 1"},{"kind":"text","text":". For example, "},{"kind":"math_inline","text":"{ab, b}"},{"kind":"text","text":" is a journey, but "},{"kind":"math_inline","text":"{ab, c}"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"{a, a}"},{"kind":"text","text":" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Define a "},{"children":[{"kind":"text","text":"journey on string"}],"kind":"container"},{"kind":"math_inline","text":"s"},{"kind":"text","text":" as journey "},{"kind":"math_inline","text":"t1, ..., tk"},{"kind":"text","text":", such that all its parts can be nested inside "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" in such a way that th