{"assets":[],"contentKind":"statement","contestId":"718","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Matvey's Birthday"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Today is Matvey's birthday. He never knows what to ask as a present so friends gave him a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". This string consists of only first eight English letters: '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"', "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", '"},{"children":[{"kind":"text","text":"h"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First question that comes to mind is: who might ever need some string? Matvey is a special boy so he instantly found what to do with this string. He used it to build an undirected graph where vertices correspond to position in the string and there is an edge between distinct positions "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ n"},{"kind":"text","text":") if "},{"children":[{"kind":"text","text":"at least one"}],"kind":"container"},{"kind":"text","text":" of the following conditions hold: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are neighbouring, i.e. "},{"kind":"math_inline","text":"|a - b| = 1"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Positions "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" contain equal characters, i.e. "},{"kind":"math_inline","text":"sa = sb"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Then Matvey decided to find the diameter of this graph. Diameter is a maximum distance (length of the shortest path) among all pairs of vertices. Also, Matvey wants to find the number of pairs of vertices such that the distance between them is equal to the diameter of the graph. As he is very cool and experienced programmer he managed to solve this problem very fast. Will you do the same?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100 000"},{"kind":"text","text":") — the length of the string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" itself. It's guaranteed that "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consists of only first eight letters of English alphabet."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two integers — the diameter of the graph and the number of pairs of positions with the distance equal to the diameter."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nabc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\naaabaaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the second sample. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The maximum distance is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". It's obtained for pairs "},{"kind":"math_inline","text":"(1, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(4, 6)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(4, 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"718E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/718/problem/E"}