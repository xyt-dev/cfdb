{"assets":[],"contentKind":"statement","contestId":"258","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Little Elephant and LCM"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Little Elephant loves the LCM (least common multiple) operation of a non-empty set of positive integers. The result of the LCM operation of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"x1, x2, ..., xk"},{"kind":"text","text":" is the minimum positive integer that is divisible by each of numbers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's assume that there is a sequence of integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":". Let's denote their LCMs as "},{"kind":"math_inline","text":"lcm(b1, b2, ..., bn)"},{"kind":"text","text":" and the maximum of them as "},{"kind":"math_inline","text":"max(b1, b2, ..., bn)"},{"kind":"text","text":". The Little Elephant considers a sequence "},{"kind":"math_inline","text":"b"},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"lcm(b1, b2, ..., bn) = max(b1, b2, ..., bn)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Little Elephant has a sequence of integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". Help him find the number of good sequences of integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":", such that for all "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ n)"},{"kind":"text","text":" the following condition fulfills: "},{"kind":"math_inline","text":"1 ≤ bi ≤ ai"},{"kind":"text","text":". As the answer can be rather large, print the remainder from dividing it by "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single positive integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":" — the number of integers in the sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 105)"},{"kind":"text","text":" — sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the single line print a single integer — the answer to the problem modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 4 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"15\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n6 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"258C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/258/problem/C"}