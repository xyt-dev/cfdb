{"assets":["/statement-assets/d68fa5f9b47fcf53c820c1c6559d693fc500c1efefa0dde50855715554495ac4.png"],"contentKind":"statement","contestId":"1337","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Kana and Dragon Quest game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Kana was just an ordinary high school girl before a talent scout discovered her. Then, she became an idol. But different from the stereotype, she is also a gameholic. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One day Kana gets interested in a new adventure game called "},{"children":[{"kind":"text","text":"Dragon Quest"}],"kind":"container"},{"kind":"text","text":". In this game, her quest is to beat a dragon."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d68fa5f9b47fcf53c820c1c6559d693fc500c1efefa0dde50855715554495ac4.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The dragon has a "},{"children":[{"kind":"text","text":"hit point"}],"kind":"container"},{"kind":"text","text":" of $$$x$$$ initially. When its "},{"children":[{"kind":"text","text":"hit point"}],"kind":"container"},{"kind":"text","text":" goes to $$$0$$$ or under $$$0$$$, it will be defeated. In order to defeat the dragon, Kana can cast the two following types of spells. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"Void Absorption"}],"kind":"container"},{"children":[{"kind":"text","text":"Assume that the dragon's current "},{"children":[{"kind":"text","text":"hit point"}],"kind":"container"},{"kind":"text","text":" is $$$h$$$, after "},{"children":[{"kind":"text","text":"casting"}],"kind":"container"},{"kind":"text","text":" this spell its "},{"children":[{"kind":"text","text":"hit point"}],"kind":"container"},{"kind":"text","text":" will become $$$\\left\\lfloor \\frac{h}{2} \\right\\rfloor + 10$$$. Here $$$\\left\\lfloor \\frac{h}{2} \\right\\rfloor$$$ denotes $$$h$$$ divided by two, rounded down."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Lightning Strike"}],"kind":"container"},{"children":[{"kind":"text","text":"This spell will decrease the dragon's "},{"children":[{"kind":"text","text":"hit point"}],"kind":"container"},{"kind":"text","text":" by $$$10$$$. Assume that the dragon's current "},{"children":[{"kind":"text","text":"hit point"}],"kind":"container"},{"kind":"text","text":" is $$$h$$$, after "},{"children":[{"kind":"text","text":"casting"}],"kind":"container"},{"kind":"text","text":" this spell its "},{"children":[{"kind":"text","text":"hit point"}],"kind":"container"},{"kind":"text","text":" will be lowered to $$$h-10$$$."}],"kind":"paragraph"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Due to some reasons Kana can only "},{"children":[{"kind":"text","text":"cast"}],"kind":"container"},{"children":[{"kind":"text","text":"no more than"}],"kind":"container"},{"kind":"text","text":" $$$n$$$ "},{"children":[{"kind":"text","text":"Void Absorptions"}],"kind":"container"},{"kind":"text","text":" and $$$m$$$ "},{"children":[{"kind":"text","text":"Lightning Strikes"}],"kind":"container"},{"kind":"text","text":". She can cast the spells in any order and "},{"children":[{"kind":"text","text":"doesn't have to"}],"kind":"container"},{"kind":"text","text":" cast all the spells. Kana isn't good at math, so you are going to help her to find out whether it is possible to defeat the dragon."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 1000$$$)  — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$t$$$ lines describe test cases. For each test case the only line contains three integers $$$x$$$, $$$n$$$, $$$m$$$ ($$$1\\le x \\le 10^5$$$, $$$0\\le n,m\\le30$$$)  — the dragon's intitial "},{"children":[{"kind":"text","text":"hit point"}],"kind":"container"},{"kind":"text","text":", the maximum number of "},{"children":[{"kind":"text","text":"Void Absorptions"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"Lightning Strikes"}],"kind":"container"},{"kind":"text","text":" Kana can "},{"children":[{"kind":"text","text":"cast"}],"kind":"container"},{"kind":"text","text":" respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is possible to defeat the dragon, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes). Otherwise, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print each letter in any case (upper or lower)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n100 3 4\n189 3 4\n64 2 3\n63 2 3\n30 27 7\n10 9 1\n69117 21 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\nNO\nYES\nYES\nYES\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"One possible casting sequence of the first test case is shown below:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"Void Absorption"}],"kind":"container"},{"kind":"text","text":" $$$\\left\\lfloor \\frac{100}{2} \\right\\rfloor + 10=60$$$."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Lightning Strike"}],"kind":"container"},{"kind":"text","text":" $$$60-10=50$$$."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Void Absorption"}],"kind":"container"},{"kind":"text","text":" $$$\\left\\lfloor \\frac{50}{2} \\right\\rfloor + 10=35$$$."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Void Absorption"}],"kind":"container"},{"kind":"text","text":" $$$\\left\\lfloor \\frac{35}{2} \\right\\rfloor + 10=27$$$."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Lightning Strike"}],"kind":"container"},{"kind":"text","text":" $$$27-10=17$$$."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Lightning Strike"}],"kind":"container"},{"kind":"text","text":" $$$17-10=7$$$."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Lightning Strike"}],"kind":"container"},{"kind":"text","text":" $$$7-10=-3$$$."}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1337B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1337/problem/B"}