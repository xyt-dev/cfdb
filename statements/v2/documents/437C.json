 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then, remove part "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", cost of the action is "},{"kind":"math_inline","text":"10"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Next, remove part "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", cost of the action is "},{"kind":"math_inline","text":"10"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" At last, remove part "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", cost of the action is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So the total energy the child paid is "},{"kind":"math_inline","text":"20 + 10 + 10 + 0 = 40"},{"kind":"text","text":", which is the minimum."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the child will spend "},{"kind":"math_inline","text":"400"},{"kind":"text","text":" no matter in what order he will remove the parts."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"437C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/437/problem/C"}