{"assets":[],"contentKind":"statement","contestId":"437","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. The Child and Toy"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"On Children's Day, the child got a toy from Delayyy as a present. However, the child is so naughty that he can't wait to destroy the toy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The toy consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" parts and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ropes. Each rope links two parts, but every pair of parts is linked by at most one rope. To split the toy, the child must remove all its parts. The child can remove a single part at a time, and each remove consume an energy. Let's define an energy value of part "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":". The child spend "},{"kind":"math_inline","text":"vf1 + vf2 + ... + vfk"},{"kind":"text","text":" energy for removing part "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"f1, f2, ..., fk"},{"kind":"text","text":" are the parts that are directly connected to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th and haven't been removed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the child to find out, what is the minimum total energy he should spend to remove all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" parts."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"0 ≤ m ≤ 2000"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"v1, v2, ..., vn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ vi ≤ 105"},{"kind":"text","text":"). Then followed "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines, each line contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":", representing a rope from part "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" to part "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ n; xi ≠ yi"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider all the parts are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the minimum total energy the child should spend to remove all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" parts of the toy."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs"