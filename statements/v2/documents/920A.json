{"assets":["/statement-assets/0d4009f16ed4cde88357f7943e47d6e5f42cf75d73e828b2295b07394de9050d.png","/statement-assets/d8bcb65b4de8e3df2e5dc4abedad7309b6b902f7d4a4d12c40b732b8f712ce81.png","/statement-assets/32dc705f01ad009790f779d90108e0ff9c3b320bb383d92dd74c4c39c504511b.png"],"contentKind":"statement","contestId":"920","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Water The Garden"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"It is winter now, and Max decided it's about time he watered the garden."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The garden can be represented as "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" consecutive garden beds, numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" beds contain water taps ("},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th tap is located in the bed "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":"), which, if turned on, start delivering water to neighbouring beds. If the tap on the bed "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" is turned on, then after one second has passed, the bed "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" will be watered; after two seconds have passed, the beds from the segment "},{"kind":"math_inline","text":"[xi - 1, xi + 1]"},{"kind":"text","text":" will be watered (if they exist); after "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" seconds have passed "},{"children":[{"kind":"text","text":"("},{"kind":"math_inline","text":"j"},{"kind":"text","text":" is an integer number)"}],"kind":"container"},{"kind":"text","text":", the beds from the segment "},{"kind":"math_inline","text":"[xi - (j - 1), xi + (j - 1)]"},{"kind":"text","text":" will be watered (if they exist). "},{"children":[{"kind":"text","text":"Nothing changes during the seconds, so, for example, we can't say that the segment "},{"kind":"math_inline","text":"[xi - 2.5, xi + 2.5]"},{"kind":"text","text":" will be watered after "},{"kind":"math_inline","text":"2.5"},{"kind":"text","text":" seconds have passed; only the segment "},{"kind":"math_inline","text":"[xi - 2, xi + 2]"},{"kind":"text","text":" will be watered at that moment."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0d4009f16ed4cde88357f7943e47d6e5f42cf75d73e828b2295b07394de9050d.png"},"kind":"image"},{"kind":"text","text":" The garden from test "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". White colour denotes a garden bed without a tap, red colour — a garden bed with a tap. "}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d8bcb65b4de8e3df2e5dc4abedad7309b6b902f7d4a4d12c40b732b8f712ce81.png"},"kind":"image"},{"kind":"text","text":" The garden from test "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" after "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" seconds have passed after turning on the tap. White colour denotes an unwatered garden bed, blue colour — a watered bed. "}],"kind":"container"},{"children":[{"kind":"text","text":"Max wants to "},{"children":[{"kind":"text","text":"turn on all the water taps at the same moment"}],"kind":"container"},{"kind":"text","text":", and now he wonders, what is the minimum number of seconds that have to pass after he turns on some taps until the whole garden is watered. Help him to find the answer!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — the number of test cases to solve ("},{"kind":"math_inline","text":"1 ≤ t ≤ 200"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" test cases follow. The first line of each test case contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":") — the number of garden beds and water taps, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ n"},{"kind":"text","text":") — the location of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th water tap. It is guaranteed that for each "},{"attrs":{"alt":"","src":"/statement-assets/32dc705f01ad009790f779d90108e0ff9c3b320bb383d92dd74c4c39c504511b.png"},"kind":"image"},{"kind":"text","text":" condition "},{"kind":"math_inline","text":"xi - 1 < xi"},{"kind":"text","text":" holds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" over all test cases doesn't exceed "},{"kind":"math_inline","text":"200"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note that in hacks you have to set "},{"kind":"math_inline","text":"t = 1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print one integer — the minimum number of seconds that have to pass after Max turns on some of the water taps, until the whole garden is watered."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n5 1\n3\n3 3\n1 2 3\n4 1\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first example consists of "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" tests:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" There are "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" garden beds, and a water tap in the bed "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". If we turn it on, then after "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" second passes, only bed "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" will be watered; after "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" seconds pass, beds "},{"kind":"math_inline","text":"[1, 3]"},{"kind":"text","text":" will be watered, and after "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" seconds pass, everything will be watered. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There are "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" garden beds, and there is a water tap in each one. If we turn all of them on, then everything will be watered after "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" second passes. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There are "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" garden beds, and only one tap in the bed "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". It will take "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" seconds to water, for example, bed "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"920A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/920/problem/A"}