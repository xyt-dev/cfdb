ext","text":"Your program has to support two operations: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Paint all cells in row "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" in color "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Paint all cells in column "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" in color "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If during some operation "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" there is a cell that have already been painted, the color of this cell also changes to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your program has to print the resulting table after "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" operation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤  n,  m  ≤ 5000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n·m ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 100 000"},{"kind":"text","text":") — the dimensions of the sheet and the number of operations, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contains the description of exactly one query: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1 ri ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ri ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":"), means that row "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" is painted in color "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2 ci ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci ≤ m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":"), means that column "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" is painted in color "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines containing "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers each — the resulting table after all operations are applied."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 3\n1 1 3\n2 2 1\n1 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 1 3 \n2 2 2 \n0 1 0 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children"