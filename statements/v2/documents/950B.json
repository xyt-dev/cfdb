{"assets":[],"contentKind":"statement","contestId":"950","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Intercepted Message"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Hacker Zhorik wants to decipher two secret messages he intercepted yesterday. Yeah message is a sequence of encrypted blocks, each of them consists of several bytes of information."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Zhorik knows that each of the messages is an archive containing one or more files. Zhorik knows how each of these archives was transferred through the network: if an archive consists of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" files of sizes "},{"kind":"math_inline","text":"l1, l2, ..., lk"},{"kind":"text","text":" bytes, then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th file is split to one or more blocks "},{"kind":"math_inline","text":"bi, 1, bi, 2, ..., bi, mi"},{"kind":"text","text":" (here the total length of the blocks "},{"kind":"math_inline","text":"bi, 1 + bi, 2 + ... + bi, mi"},{"kind":"text","text":" is equal to the length of the file "},{"kind":"math_inline","text":"li"},{"kind":"text","text":"), and after that all blocks are transferred through the network, maintaining the order of files in the archive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Zhorik thinks that the two messages contain the same archive, because their total lengths are equal. However, each file can be split in blocks in different ways in the two messages."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the lengths of blocks in each of the two messages. Help Zhorik to determine what is the maximum number of files could be in the archive, if the Zhorik's assumption is correct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":") — the number of blocks in the first and in the second messages."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ 106"},{"kind":"text","text":") — the length of the blocks that form the first message."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"y1, y2, ..., ym"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ yi ≤ 106"},{"kind":"text","text":") — the length of the blocks that form the second message."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that "},{"kind":"math_inline","text":"x1 + ... + xn = y1 + ... + ym"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"Also, it is guaranteed that "},{"kind":"math_inline","text":"x1 + ... + xn ≤ 106"},{"kind":"text","text":"."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum number of files the intercepted array could consist of."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 6\n2 5 3 1 11 4 4\n7 8 2 4 1 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 10 100\n1 100 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 4\n4\n1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the maximum number of files in the archive is 3. For example, it is possible that in the archive are three files of sizes "},{"kind":"math_inline","text":"2 + 5 = 7"},{"kind":"text","text":", "},{"kind":"math_inline","text":"15 = 3 + 1 + 11 = 8 + 2 + 4 + 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4 + 4 = 8"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example it is possible that the archive contains two files of sizes "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"110 = 10 + 100 = 100 + 10"},{"kind":"text","text":". Note that the order of files is kept while transferring archives through the network, so we can't say that there are three files of sizes "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"100"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example the only possibility is that the archive contains a single file of size "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"950B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/950/problem/B"}