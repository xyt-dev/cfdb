{"assets":[],"contentKind":"statement","contestId":"908","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. New Year and Counting Cards"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Your friend has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cards."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You know that each card has a lowercase English letter on one side and a digit on the other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Currently, your friend has laid out the cards on a table so only one side of each card is visible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You would like to know if the following statement is true for cards that your friend owns: \"If a card has a vowel on one side, then it has an even digit on the other side.\" More specifically, a vowel is one of '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"i"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"u"}],"kind":"container"},{"kind":"text","text":"', and even digit is one of '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"6"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"8"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if a card has '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' on one side, and '"},{"children":[{"kind":"text","text":"6"}],"kind":"container"},{"kind":"text","text":"' on the other side, then this statement is true for it. Also, the statement is true, for example, for a card with '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":"', and for a card with '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"3"}],"kind":"container"},{"kind":"text","text":"' (since the letter is not a vowel). The statement is false, for example, for card with '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":"'. You are interested if the statement is true for all cards. In particular, if no card has a vowel, the statement is true."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To determine this, you can flip over some cards to reveal the other side. You would like to know what is the minimum number of cards you need to flip in the worst case in order to verify that the statement is true."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and only line of input will contain a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 50"},{"kind":"text","text":"), denoting the sides of the cards that you can see on the table currently. Each character of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is either a lowercase English letter or a digit."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer, the minimum number of cards you must turn over to verify your claim."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ee\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"z\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0ay1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, we must turn over both cards. Note that even though both cards have the same letter, they could possibly have different numbers on the other side."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, we don't need to turn over any cards. The statement is vacuously true, since you know your friend has no cards with a vowel on them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, we need to flip the second and fourth cards."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"908A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/908/problem/A"}