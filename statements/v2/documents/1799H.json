{"assets":[],"contentKind":"statement","contestId":"1799","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Tree Cutting"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a tree with $$$n$$$ vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A hero $$$k$$$ times do the following operation:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose some edge. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Remove it. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Take one of the two remaining parts and delete it. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Write the number of vertices in the remaining part. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given an initial tree and the a sequence of written numbers. Find the number of ways to make operations such that the written numbers are equal to the given numbers. Due to the answer can be big, find it by modulo $$$998\\,244\\,353$$$. Two ways are considered different, if on some operation edge or remaining part are selected differently."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$2 \\leq n \\leq 5000$$$) — the number of vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n-1$$$ lines contains two integers $$$s$$$, $$$f$$$ ($$$1 \\leq s, f \\leq n$$$, $$$s \\neq f$$$) — description of edge $$$(s, f)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains a single integer $$$k$$$ ($$$1 \\leq k \\leq \\min{(6, n - 1)}$$$) — the number of operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains $$$k$$$ integers $$$s_1, s_2, \\ldots, s_k$$$ ($$$n \\gt s_1 \\gt s_2 \\gt \\ldots \\gt s_k \\geq 1$$$) — written numbers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the answer to the problem by modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 2\n2 3\n2\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n2 1\n3 2\n4 1\n5 3\n6 4\n7 4\n2\n4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},