{"assets":[],"contentKind":"statement","contestId":"235","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Graph Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In computer science, there is a method called \"Divide And Conquer By Node\" to solve some hard problems about paths on a tree. Let's desribe how this method works by function:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"solve(t)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is a tree): "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Chose a node "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" (it's common to chose weight-center) in tree "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Let's call this step \"Line A\". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Deal with all paths that pass "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then delete "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" from tree "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After that "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" becomes some subtrees. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Apply "},{"kind":"math_inline","text":"solve"},{"kind":"text","text":" on each subtree. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"This ends when "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" has only one node because after deleting it, there's nothing. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, WJMZBMR has mistakenly believed that it's ok to chose any node in \"Line A\". So he'll chose a node at random. To make the situation worse, he thinks a \"tree\" should have the same number of edges and nodes! So this procedure becomes like that."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define the variable "},{"kind":"math_inline","text":"totalCost"},{"kind":"text","text":". Initially the value of "},{"kind":"math_inline","text":"totalCost"},{"kind":"text","text":" equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". So, "},{"kind":"math_inline","text":"solve(t)"},{"kind":"text","text":" (now "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is a graph): "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"totalCost = totalCost + (size of t)"},{"kind":"text","text":". The operation \""},{"children":[{"kind":"text","text":"="}],"kind":"container"},{"kind":"text","text":"\" means assignment. "},{"kind":"math_inline","text":"(Size of t)"},{"kind":"text","text":" means the number of nodes in "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Choose a node "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" in graph "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" at random (uniformly among all nodes of "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then delete "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" from graph "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After that "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" becomes some connected components. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Apply "},{"kind":"math_inline","text":"solve"},{"kind":"text","text":" on each component. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"He'll apply "},{"kind":"math_inline","text":"solve"},{"kind":"text","text":" on a connected graph with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" edges. He thinks it will work quickly, but it's very slow. So he wants to know the expectation of "},{"kind":"math_inline","text":"totalCost"},{"kind":"text","text":" of this procedure. Can you help him?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 3000"},{"kind":"text","text":") — the number of nodes and edges in the graph. Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two space-separated integers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"math_inline","text":"(0 ≤ ai, bi ≤ n - 1)"},{"kind":"text","text":" indicating an edge between nodes "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider that the graph nodes are numbered from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(n - 1)"},{"kind":"text","text":". It's guaranteed that there are no self-loops, no multiple edges in that graph. It's guaranteed that the graph is connected."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single real number — the expectation of "},{"kind":"math_inline","text":"totalCost"},{"kind":"text","text":". Your answer will be considered correct if its absolute or relative error does not exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n3 4\n2 3\n2 4\n0 4\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13.166666666666666\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n0 1\n1 2\n0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6.000000000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 1\n1 2\n2 0\n3 0\n4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13.166666666666666\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the second example. No matter what we choose first, the "},{"kind":"math_inline","text":"totalCost"},{"kind":"text","text":" will always be "},{"kind":"math_inline","text":"3 + 2 + 1 = 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"235D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/235/problem/D"}