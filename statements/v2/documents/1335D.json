{"assets":["/statement-assets/76c6b6b451c77e78f09f62114500753f8cc5e5c6d4d4b6606e6ddd85ff952acd.png"],"contentKind":"statement","contestId":"1335","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Anti-Sudoku"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a correct solution to a Sudoku puzzle. If you don't know what Sudoku is, you can read about it "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Sudoku"},"children":[{"kind":"text","text":"here"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The picture below shows a correct Sudoku solution:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/76c6b6b451c77e78f09f62114500753f8cc5e5c6d4d4b6606e6ddd85ff952acd.png"},"kind":"image"},{"children":[{"kind":"text","text":"Blocks are bordered in bold black."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Your task is to change "},{"children":[{"kind":"text","text":"at most"}],"kind":"container"},{"kind":"text","text":" $$$9$$$ elements of this field (i. e., choose some $$$1 \\le i, j \\le 9$$$ and change the number at the position $$$(i, j)$$$ to any other number in the range $$$[1; 9]$$$) to make it "},{"children":[{"kind":"text","text":"anti-sudoku"}],"kind":"container"},{"kind":"text","text":". The "},{"children":[{"kind":"text","text":"anti-sudoku"}],"kind":"container"},{"kind":"text","text":" is the $$$9 \\times 9$$$ field, in which:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Any number in this field is in the range $$$[1; 9]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Each row contains at least two equal elements; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Each column contains at least two equal elements; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Each $$$3 \\times 3$$$ block (you can read what a block is following the link above) contains at least two equal elements. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is guaranteed that a solution exists."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to answer $$$t$$$ independent test cases."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. Then $$$t$$$ test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of $$$9$$$ lines; each line consists of $$$9$$$ characters from $$$1$$$ to $$$9$$$ without any whitespaces — the correct solution of the Sudoku puzzle."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the answer — the initial field with "},{"children":[{"kind":"text","text":"at most"}],"kind":"container"},{"kind":"text","text":" $$$9$$$ changed elements so that the obtained field is "},{"children":[{"kind":"text","text":"anti-sudoku"}],"kind":"container"},{"kind":"text","text":". If there are several solutions, you can print any. It is guaranteed that the answer exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n154873296\n386592714\n729641835\n863725149\n975314628\n412968357\n631457982\n598236471\n247189563\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n154873396\n336592714\n729645835\n863725145\n979314628\n412958357\n631457992\n998236471\n247789563\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1335D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1335/problem/D"}