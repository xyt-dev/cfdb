{"assets":[],"contentKind":"statement","contestId":"595","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Pasha and Phone"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pasha has recently bought a new phone "},{"children":[{"kind":"text","text":"jPager"}],"kind":"container"},{"kind":"text","text":" and started adding his friends' phone numbers there. Each phone number consists of exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" digits."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also Pasha has a number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and two sequences of length "},{"kind":"math_inline","text":"n / k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is divisible by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":") "},{"kind":"math_inline","text":"a1, a2, ..., an / k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b1, b2, ..., bn / k"},{"kind":"text","text":". Let's split the phone number into blocks of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". The first block will be formed by digits from the phone number that are on positions "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":",..., "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", the second block will be formed by digits from the phone number that are on positions "},{"kind":"math_inline","text":"k + 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k + 2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"2·k"},{"kind":"text","text":" and so on. Pasha considers a phone number "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":", if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th block doesn't start from the digit "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" and is divisible by "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" if represented as an integer. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To represent the block of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" as an integer, let's write it out as a sequence "},{"kind":"math_inline","text":"c1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c2"},{"kind":"text","text":",...,"},{"kind":"math_inline","text":"ck"},{"kind":"text","text":". Then the integer is calculated as the result of the expression "},{"kind":"math_inline","text":"c1·10k - 1 + c2·10k - 2 + ... + ck"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pasha asks you to calculate the number of "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" phone numbers of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", for the given "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". As this number can be too big, print it modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ min(n, 9)"},{"kind":"text","text":") — the length of all phone numbers and the length of each block, respectively. It is guaranteed that "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is divisible by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains "},{"kind":"math_inline","text":"n / k"},{"kind":"text","text":" space-separated positive integers — sequence "},{"kind":"math_inline","text":"a1, a2, ..., an / k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai < 10k"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line of the input contains "},{"kind":"math_inline","text":"n / k"},{"kind":"text","text":" space-separated positive integers — sequence "},{"kind":"math_inline","text":"b1, b2, ..., bn / k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ bi ≤ 9"},{"kind":"text","text":"). "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of good phone numbers of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"I