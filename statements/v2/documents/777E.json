{"assets":[],"contentKind":"statement","contestId":"777","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Hanoi Factory"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Of course you have heard the famous task about Hanoi Towers, but did you know that there is a special factory producing the rings for this wonderful game? Once upon a time, the ruler of the ancient Egypt ordered the workers of Hanoi Factory to create as high tower as possible. They were not ready to serve such a strange order so they had to create this new tower using already produced rings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rings in factory's stock. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ring has inner radius "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", outer radius "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" and height "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":". The goal is to select some subset of rings and arrange them such that the following conditions are satisfied:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Outer radiuses form a non-increasing sequence, i.e. one can put the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th ring on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ring only if "},{"kind":"math_inline","text":"bj ≤ bi"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Rings should not fall one into the the other. That means one can place ring "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" on the ring "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" only if "},{"kind":"math_inline","text":"bj > ai"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The total height of all rings used should be maximum possible. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of rings in factory's stock."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains three integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi, hi ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi > ai"},{"kind":"text","text":") — inner radius, outer radius and the height of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ring respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the maximum height of the tower that can be obtained."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 5 1\n2 6 2\n3 7 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 1\n1 3 3\n4 6 2\n5 7 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the optimal solution is to take all the rings and put them on each other in order "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, one can put the ring "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" on the ring "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and get the tower of height "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", or put the ring "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" on the ring "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and get the tower of height "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"777E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/777/problem/E"}