{"assets":["/statement-assets/06f886cbcb5eb9dee4acab5ba93c9b173b3f30fc6ed1a13e7e53bf190cb49cf2.png","/statement-assets/efe61da13b2bec4bf370d85ec97dcd127f1c83b46d535d8981479a0fb9f6fdfb.png"],"contentKind":"statement","contestId":"1797","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Li Hua and Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Li Hua has a tree of $$$n$$$ vertices and $$$n-1$$$ edges. The root of the tree is vertex $$$1$$$. Each vertex $$$i$$$ has importance $$$a_i$$$. Denote the "},{"children":[{"kind":"text","text":"size"}],"kind":"container"},{"kind":"text","text":" of a subtree as the number of vertices in it, and the "},{"children":[{"kind":"text","text":"importance"}],"kind":"container"},{"kind":"text","text":" as the sum of the importance of vertices in it. Denote the "},{"children":[{"kind":"text","text":"heavy son"}],"kind":"container"},{"kind":"text","text":" of a non-leaf vertex as the son with the "},{"children":[{"kind":"text","text":"largest"}],"kind":"container"},{"kind":"text","text":" subtree "},{"children":[{"kind":"text","text":"size"}],"kind":"container"},{"kind":"text","text":". If multiple of them exist, the "},{"children":[{"kind":"text","text":"heavy son"}],"kind":"container"},{"kind":"text","text":" is the one with the "},{"children":[{"kind":"text","text":"minimum"}],"kind":"container"},{"kind":"text","text":" index."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Li Hua wants to perform $$$m$$$ operations:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \"1 $$$x$$$\" ($$$1\\leq x \\leq n$$$) — calculate the "},{"children":[{"kind":"text","text":"importance"}],"kind":"container"},{"kind":"text","text":" of the subtree whose root is $$$x$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \"2 $$$x$$$\" ($$$2\\leq x \\leq n$$$) — rotate the "},{"children":[{"kind":"text","text":"heavy son"}],"kind":"container"},{"kind":"text","text":" of $$$x$$$ up. Formally, denote $$$son_x$$$ as the "},{"children":[{"kind":"text","text":"heavy son"}],"kind":"container"},{"kind":"text","text":" of $$$x$$$, $$$fa_x$$$ as the father of $$$x$$$. He wants to remove the edge between $$$x$$$ and $$$fa_x$$$ and connect an edge between $$$son_x$$$ and $$$fa_x$$$. It is guaranteed that $$$x$$$ is not root, but "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" guaranteed that $$$x$$$ is not a leaf. If $$$x$$$ is a leaf, please ignore the operation. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Suppose you were Li Hua, please solve this problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains 2 integers $$$n,m$$$ ($$$2\\le n\\le 10^{5},1\\le m\\le 10^{5}$$$) — the number of vertices in the tree and the number of operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_{1},a_{2},\\ldots ,a_{n}$$$ ($$$-10^{9}\\le a_{i}\\le 10^{9}$$$) — the importance of each vertex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$n-1$$$ lines contain the edges of the tree. The $$$i$$$-th line contains two integers $$$u_i$$$ and $$$v_i$$$ ($$$1\\le u_i,v_i\\le n$$$, $$$u_i\\ne v_i$$$) — the corresponding edge. The given edges form a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$m$$$ lines contain operations — one operation per line. The $$$j$$$-th operation contains two integers $$$t_{j},x_{j}$$$ ($$$t_{j}\\in \\{1,2\\}$$$, $$$1 \\leq x_{j} \\leq n$$$, $$$x_{j}\\neq 1$$$ if $$$t_j = 2$$$) — the $$$j$$$-th operation. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query \"1 $$$x$$$\", output the answer in an independent line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7 4\n1 1 1 1 1 1 1\n1 2\n1 3\n2 4\n2 5\n3 6\n6 7\n1 6\n2 3\n1 6\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n3\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10 14\n-160016413 -90133231 -671446275 -314847579 -910548234 121155052 -359359950 83112406 -704889624 145489303\n1 6\n1 10\n10 8\n1 4\n3 4\n2 7\n2 5\n3 2\n9 8\n1 4\n2 2\n2 4\n1 4\n1 10\n2 10\n1 9\n1 6\n2 8\n2 10\n1 5\n1 8\n1 1\n2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-2346335269\n-314847579\n-476287915\n-704889624\n121155052\n-1360041415\n228601709\n-2861484545\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The initial tree is shown in the following picture:"}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/06f886cbcb5eb9dee4acab5ba93c9b173b3f30fc6ed1a13e7e53bf190cb49cf2.png"},"kind":"image"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"}],"kind":"container"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"importance"}],"kind":"container"},{"kind":"text","text":" of the subtree of $$$6$$$ is $$$a_6+a_7=2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After rotating the "},{"children":[{"kind":"text","text":"heavy son"}],"kind":"container"},{"kind":"text","text":" of $$$3$$$ (which is $$$6$$$) up, the tree is shown in the following picture:"}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/efe61da13b2bec4bf370d85ec97dcd127f1c83b46d535d8981479a0fb9f6fdfb.png"},"kind":"image"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"}],"kind":"container"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"importance"}],"kind":"container"},{"kind":"text","text":" of the subtree of $$$6$$$ is $$$a_6+a_3+a_7=3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"importance"}],"kind":"container"},{"kind":"text","text":" of the subtree of $$$2$$$ is $$$a_2+a_4+a_5=3$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1797D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1797/problem/D"}