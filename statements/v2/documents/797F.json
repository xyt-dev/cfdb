{"assets":[],"contentKind":"statement","contestId":"797","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Mice and Holes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day Masha came home and noticed "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" mice in the corridor of her flat. Of course, she shouted loudly, so scared mice started to run to the holes in the corridor."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The corridor can be represeted as a numeric axis with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" mice and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" holes on it. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th mouse is at the coordinate "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"th hole — at coordinate "},{"kind":"math_inline","text":"pj"},{"kind":"text","text":". "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"th hole has enough room for "},{"kind":"math_inline","text":"cj"},{"kind":"text","text":" mice, so not more than "},{"kind":"math_inline","text":"cj"},{"kind":"text","text":" mice can enter this hole."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum sum of distances that mice have to go through so that they all can hide in the holes? If "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th mouse goes to the hole "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", then its distance is "},{"kind":"math_inline","text":"|xi - pj|"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print the minimum sum of distances."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 5000"},{"kind":"text","text":") — the number of mice and the number of holes, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ xi ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" is the coordinate of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th mouse."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain pairs of integer numbers "},{"kind":"math_inline","text":"pj, cj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ pj ≤ 109, 1 ≤ cj ≤ 5000"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"pj"},{"kind":"text","text":" is the coordinate of "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"th hole, and "},{"kind":"math_inline","text":"cj"},{"kind":"text","text":" is the maximum number of mice that can hide in the hole "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer number — the minimum sum of distances. If there is no solution, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" instead."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n6 2 8 9\n3 6\n2 1\n3 6\n4 7\n4 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 2\n10 20 30 40 50 45 35\n-1000000000 10\n1000000000 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7000000130\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"797F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/797/problem/F"}