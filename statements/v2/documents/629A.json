{"assets":[],"contentKind":"statement","contestId":"629","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Far Relative’s Birthday Cake"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Door's family is going celebrate Famil Doors's birthday party. They love Famil Door so they are planning to make his birthday cake weird!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The cake is a "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" square consisting of equal squares with side length "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Each square is either empty or consists of a single chocolate. They bought the cake and randomly started to put the chocolates on the cake. The value of Famil Door's happiness will be equal to the number of pairs of cells with chocolates that are in the same row or in the same column of the cake. Famil Doors's family is wondering what is the amount of happiness of Famil going to be?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, note that any pair can be counted no more than once, as two different cells can't share both the same row and the same column."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line of the input, you are given a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the length of the side of the cake."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each containing "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters. Empty cells are denoted with '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"', while cells that contain chocolates are denoted by '"},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the value of Famil Door's happiness, i.e. the number of pairs of chocolate pieces that share the same row or the same column."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n.CC\nC..\nC.C\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nCC..\nC..C\n.CC.\n.CC.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"If we number rows from top to bottom and columns from left to right, then, pieces that share the same row in the first sample are: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(1, 3)"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"(3, 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(3, 3)"}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" Pieces that share the same column are: "},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(3, 1)"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(3, 3)"}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"629A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/629/problem/A"}