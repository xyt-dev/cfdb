{"assets":["/statement-assets/5917375e2a0b6710d4e4fc7c9403f56ff28eb1c7a83b732e9af8d39f57050947.png"],"contentKind":"statement","contestId":"485","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Factory"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One industrial factory is reforming working plan. The director suggested to set a mythical detail production norm. If at the beginning of the day there were "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" details in the factory storage, then by the end of the day the factory has to produce "},{"attrs":{"alt":"","src":"/statement-assets/5917375e2a0b6710d4e4fc7c9403f56ff28eb1c7a83b732e9af8d39f57050947.png"},"kind":"image"},{"kind":"text","text":" (remainder after dividing "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"m"},{"kind":"text","text":") more details. Unfortunately, no customer has ever bought any mythical detail, so all the details produced stay on the factory. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The board of directors are worried that the production by the given plan may eventually stop (that means that there will be а moment when the current number of details on the factory is divisible by "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the number of details "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" on the first day and number "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" check if the production stops at some moment."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, m ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if the production will eventually stop, otherwise print \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"485A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/485/problem/A"}