{"assets":[],"contentKind":"statement","contestId":"277","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Learning Languages"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The \"BerCorp\" company has got "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" employees. These employees can use "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" approved official languages for the formal correspondence. The languages are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". For each employee we have the list of languages, which he knows. This list could be empty, i. e. an employee may know no official languages. But the employees are willing to learn any number of official languages, as long as the company pays their lessons. A study course in one language for one employee costs "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" berdollar."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the minimum sum of money the company needs to spend so as any employee could correspond to any other one (their correspondence can be indirect, i. e. other employees can help out translating)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n, m ≤ 100"},{"kind":"text","text":") — the number of employees and the number of languages."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow — each employee's language list. At the beginning of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line is integer "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ki ≤ m"},{"kind":"text","text":") — the number of languages the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th employee knows. Next, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" integers — "},{"kind":"math_inline","text":"aij"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ aij ≤ m"},{"kind":"text","text":") — the identifiers of languages the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th employee knows. It is guaranteed that all the identifiers in one list are distinct. Note that an employee may know zero languages."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The numbers in the lines are separated by single spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum amount of money to pay so that in the end every employee could write a letter to every other one (other employees can help out translating)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs