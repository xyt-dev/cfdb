{"assets":[],"contentKind":"statement","contestId":"1822","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G2. Magic Triples (Hard Version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is the hard version of the problem. The only difference is that in this version, $$$a_i \\le 10^9$$$."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a given sequence of $$$n$$$ integers $$$a$$$, a triple $$$(i, j, k)$$$ is called "},{"children":[{"kind":"text","text":"magic"}],"kind":"container"},{"kind":"text","text":" if: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1 \\le i, j, k \\le n$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$i$$$, $$$j$$$, $$$k$$$ are pairwise distinct. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" there exists a positive integer $$$b$$$ such that $$$a_i \\cdot b = a_j$$$ and $$$a_j \\cdot b = a_k$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Kolya received a sequence of integers $$$a$$$ as a gift and now wants to count the number of "},{"children":[{"kind":"text","text":"magic"}],"kind":"container"},{"kind":"text","text":" triples for it. Help him with this task!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that there are no constraints on the order of integers $$$i$$$, $$$j$$$ and $$$k$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of the test case contains a single integer $$$n$$$ ($$$3 \\le n \\le 2 \\cdot 10^5$$$) — the length of the sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the test contains $$$n$$$ integers $$$a_1, a_2, a_3, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$) — the elements of the sequence $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the number of "},{"children":[{"kind":"text","text":"magic"}],"kind":"container"},{"kind":"text","text":" triples for the sequence $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n5\n1 7 7 2 7\n3\n6 2 18\n9\n1 2 3 4 5 6 7 8 9\n4\n1000 993 986 179\n7\n1 10 100 1000 10000 100000 1000000\n8\n1 1 2 2 4 4 8 8\n9\n1 1 1 2 2 2 4 4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1\n3\n0\n9\n16\n45\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, there are $$$6$$$ "},{"children":[{"kind":"text","text":"magic"}],"kind":"container"},{"kind":"text","text":" triples for the sequence $$$a$$$ — $$$(2, 3, 5)$$$, $$$(2, 5, 3)$$$, $$$(3, 2, 5)$$$, $$$(3, 5, 2)$$$, $$$(5, 2, 3)$$$, $$$(5, 3, 2)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, there is a single "},{"children":[{"kind":"text","text":"magic"}],"kind":"container"},{"kind":"text","text":" triple for the sequence $$$a$$$ — $$$(2, 1, 3)$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G2","problemCode":"1822G2","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1822/problem/G2"}