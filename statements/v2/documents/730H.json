{"assets":[],"contentKind":"statement","contestId":"730","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Delete Them"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp is a beginner programmer. He is studying how to use a command line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp faced the following problem. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" files in a directory and he needs to delete some of them. Polycarp wants to run a single delete command with filename pattern as an argument. All the files to be deleted should match the pattern and all other files shouldn't match the pattern."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp doesn't know about an asterisk '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"', the only special character he knows is a question mark '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"' which matches any single character. All other characters in the pattern match themselves only."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, a pattern matches a filename if and only if they have equal lengths and all characters in the corresponding positions are equal except when the character in the pattern is '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"', in which case the corresponding filename character does not matter."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the filename pattern \""},{"children":[{"kind":"text","text":"a?ba?"}],"kind":"container"},{"kind":"text","text":"\":"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" matches filenames \""},{"children":[{"kind":"text","text":"aabaa"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abba."}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"a.ba9"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"a.ba."}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" does not match filenames \""},{"children":[{"kind":"text","text":"aaba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abaab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"aabaaa"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"aabaa."}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Polycarp find a pattern which matches files to be deleted and only them or report if there is no such pattern."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ n ≤ 100"},{"kind":"text","text":") — the total number of files and the number of files to be deleted."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain filenames, single filename per line. All filenames are non-empty strings containing only lowercase English letters, digits and dots ('"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"'). The length of each filename doesn't exceed 100. It is guaranteed that all filenames are distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line of the input contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" distinct integer numbers in ascending order "},{"kind":"math_inline","text":"a1, a2, ..., am"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ n"},{"kind":"text","text":") — indices of files to be deleted. All files are indexed from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in order of their appearance in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the required pattern exists, print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" in the first line of the output. The second line should contain the required pattern. If there are multiple solutions, print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the required pattern doesn't exist, print the only line containing \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\nab\nac\ncd\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\na?\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\ntest\ntezt\ntest.\n.est\ntes.\n1 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n?es?\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\na\nb\nc\ndd\n1 2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3\n.svn\n.git\n....\n...\n..\n.\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n.???\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"730H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/730/problem/H"}