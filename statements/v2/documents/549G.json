{"assets":[],"contentKind":"statement","contestId":"549","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Happy Line"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Do you like summer? Residents of Berland do. They especially love eating ice cream in the hot summer. So this summer day a large queue of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" Berland residents lined up in front of the ice cream stall. We know that each of them has a certain amount of berland dollars with them. The residents of Berland are nice people, so each person agrees to swap places with the person right behind him for just 1 dollar. More formally, if person "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" stands just behind person "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", then person "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" can pay person "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" 1 dollar, then "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" get swapped. Of course, if person "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" has zero dollars, he can not swap places with person "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Residents of Berland are strange people. In particular, they get upset when there is someone with a "},{"children":[{"kind":"text","text":"strictly smaller"}],"kind":"container"},{"kind":"text","text":" sum of money in the line in front of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Can you help the residents of Berland form such order in the line so that they were all "},{"children":[{"kind":"text","text":"happy"}],"kind":"container"},{"kind":"text","text":"? A "},{"children":[{"kind":"text","text":"happy"}],"kind":"container"},{"kind":"text","text":" resident is the one who stands first in the line or the one in front of who another resident stands with "},{"children":[{"kind":"text","text":"not less"}],"kind":"container"},{"kind":"text","text":" number of dollars. Note that the people of Berland are people of honor and they agree to swap places only in the manner described above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000"},{"kind":"text","text":") — the number of residents who stand in the line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the number of Berland dollars of a man standing on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th position in the line. The positions are numbered starting from the "},{"children":[{"kind":"text","text":"end"}],"kind":"container"},{"kind":"text","text":" of the line. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is impossible to make all the residents happy, print "},{"children":[{"kind":"text","text":"\":(\""}],"kind":"container"},{"kind":"text","text":" without the quotes. Otherwise, print in the single line "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them must be equal to the number of money of the person on position "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" in the new line. If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n11 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9 10 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n10 9 7 10 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":":(\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n12 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 4 10 "}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample two residents should swap places, after that the first resident has 10 dollars and he is at the head of the line and the second resident will have 9 coins and he will be at the end of the line. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample it is impossible to achieve the desired result."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample the first person can swap with the second one, then they will have the following numbers of dollars: "},{"kind":"math_inline","text":"4 11 3"},{"kind":"text","text":", then the second person (in the new line) swaps with the third one, and the resulting numbers of dollars will equal to: "},{"kind":"math_inline","text":"4 4 10"},{"kind":"text","text":". In this line everybody will be happy."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"549G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/549/problem/G"}