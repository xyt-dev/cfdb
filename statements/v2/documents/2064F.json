{"assets":[],"contentKind":"statement","contestId":"2064","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. We Be Summing"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array $$$a$$$ of length $$$n$$$ and an integer $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Call a non-empty array $$$b$$$ of length $$$m$$$ "},{"children":[{"kind":"text","text":"epic"}],"kind":"container"},{"kind":"text","text":" if there exists an integer $$$i$$$ where $$$1 \\le i \\lt m$$$ and $$$\\min(b_1,\\ldots,b_i) + \\max(b_{i + 1},\\ldots,b_m) = k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Count the number of "},{"children":[{"kind":"text","text":"epic"}],"kind":"container"},{"kind":"text","text":" subarrays$$$^{\\text{∗}}$$$ of $$$a$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$An array $$$a$$$ is a subarray of an array $$$b$$$ if $$$a$$$ can be obtained from $$$b$$$ by the deletion of several (possibly, zero or all) elements from the beginning and several (possibly, zero or all) elements from the end. "}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of testcases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each testcase contains integers $$$n$$$ and $$$k$$$ ($$$2 \\le n \\le 2 \\cdot 10^5$$$; $$$n \\lt k \\lt 2 \\cdot n$$$) — the length of the array $$$a$$$ and $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each testcase contains $$$n$$$ integers $$$a_1,a_2,\\ldots,a_n$$$ ($$$1 \\le a_i \\le n$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of $$$n$$$ across all testcases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase, output the number of epic contiguous subarrays of $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n5 7\n1 2 3 4 5\n7 13\n6 6 6 6 7 7 7\n6 9\n4 5 6 6 5 1\n5 9\n5 5 4 5 5\n5 6\n3 3 3 3 3\n6 8\n4 5 4 5 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n12\n3\n8\n10\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"These are all the epic subarrays in the first testcase: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[2, 3, 4, 5]$$$, because $$$\\min(2, 3) + \\max(4, 5) = 2 + 5 = 7$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[3, 4]$$$, because $$$\\min(3) + \\max(4) = 3 + 4 = 7$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second test case, every subarray that contains at least one $$$6$$$ and at least one $$$7$$$ is epic."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"2064F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2064/problem/F"}