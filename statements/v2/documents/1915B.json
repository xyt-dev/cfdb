{"assets":[],"contentKind":"statement","contestId":"1915","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Not Quite Latin Square"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"Latin square"}],"kind":"container"},{"kind":"text","text":" is a $$$3 \\times 3$$$ grid made up of the letters $$$\\texttt{A}$$$, $$$\\texttt{B}$$$, and $$$\\texttt{C}$$$ such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" in each row, the letters $$$\\texttt{A}$$$, $$$\\texttt{B}$$$, and $$$\\texttt{C}$$$ each appear once, and "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in each column, the letters $$$\\texttt{A}$$$, $$$\\texttt{B}$$$, and $$$\\texttt{C}$$$ each appear once. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" For example, one possible Latin square is shown below. $$$$$$\\begin{bmatrix} \\texttt{A} & \\texttt{B} & \\texttt{C} \\\\ \\texttt{C} & \\texttt{A} & \\texttt{B} \\\\ \\texttt{B} & \\texttt{C} & \\texttt{A} \\\\ \\end{bmatrix}$$$$$$"},{"children":[{"kind":"text","text":"You are given a Latin square, but one of the letters was replaced with a question mark $$$\\texttt{?}$$$. Find the letter that was replaced."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer $$$t$$