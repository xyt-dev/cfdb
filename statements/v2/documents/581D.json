{"assets":[],"contentKind":"statement","contestId":"581","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Three Logos"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Three companies decided to order a billboard with pictures of their logos. A billboard is a big "},{"children":[{"kind":"text","text":"square"}],"kind":"container"},{"kind":"text","text":" board. A logo of each company is a rectangle of a non-zero area. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Advertisers will put up the ad only if it is possible to place all three logos on the billboard so that they do not overlap and the billboard has no empty space left. When you put a logo on the billboard, you should rotate it so that the sides were parallel to the sides of the billboard."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine if it is possible to put the logos of all the three companies on some square billboard without breaking any of the described rules."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains six positive integers "},{"kind":"math_inline","text":"x1, y1, x2, y2, x3, y3"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x1, y1, x2, y2, x3, y3 ≤ 100"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" determine the length and width of the logo of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th company respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is impossible to place all the three logos on a square shield, print a single integer \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it is possible, print in the first line the length of a side of square "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", where you can place all the three logos. Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines should contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" uppercase English letters \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"\". The sets of the same letters should form solid rectangles, provided that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the sizes of the rectangle composed from letters \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\" should be equal to the sizes of the logo of the first company, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the sizes of the rectangle composed from letters \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\" should be equal to the sizes of the logo of the second company, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the sizes of the rectangle composed from letters \""},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"\" should be equal to the sizes of the logo of the third company, "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that the logos of the companies can be rotated for printing on the billboard. The billboard mustn't have any empty space. If a square billboard can be filled with the logos in multiple ways, you are allowed to print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"See the samples to better understand the statement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1 2 5 5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\nAAAAA\nBBBBB\nBBBBB\nCCCCC\nCCCCC\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4 2 6 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\nBBBBBB\nBBBBBB\nAAAACC\nAAAACC\nAAAACC\nAAAACC\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"581D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/581/problem/D"}