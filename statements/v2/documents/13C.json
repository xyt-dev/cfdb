{"assets":[],"contentKind":"statement","contestId":"13","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Petya likes to play very much. And most of all he likes to play the following game:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He is given a sequence of "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" integer numbers. At each step it is allowed to increase the value of any number by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" or to decrease it by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". The goal of the game is to make the sequence non-decreasing with the smallest number of steps. Petya is not good at math, so he asks for your help."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is called non-decreasing if "},{"kind":"math_inline","text":"a1 ≤ a2 ≤ ... ≤ aN"},{"kind":"text","text":" holds, where "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" is the length of the sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains single integer "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ N ≤ 5000"},{"kind":"text","text":") — the length of the initial sequence. The following "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" lines contain one integer each — elements of the sequence. These numbers do not exceed "},{"kind":"math_inline","text":"109"},{"kind":"text","text":" by absolute value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one integer — minimum number of steps required to achieve the goal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n3 2 -1 2 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2 1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"13C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/13/problem/C"}