{"assets":[],"contentKind":"statement","contestId":"342","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Xenia and Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Xenia the programmer has a tree consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes. We will consider the tree nodes indexed from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". We will also consider the first node to be initially painted red, and the other nodes — to be painted blue."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"distance"}],"kind":"container"},{"kind":"text","text":" between two tree nodes "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" is the number of edges in the shortest path between "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Xenia needs to learn how to quickly execute queries of two types:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" paint a specified blue node in red; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" calculate which red node is the closest to the given one and print the shortest distance to the closest red node. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is to write a program which will execute the described queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(2 ≤ n ≤ 105, 1 ≤ m ≤ 105)"},{"kind":"text","text":" — the number of nodes in the tree and the number of queries. Next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain the tree edges, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains a pair of integers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"math_inline","text":"(1 ≤ ai, bi ≤ n, ai ≠ bi)"},{"kind":"text","text":" — an edge of the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain queries. Each query is specified as a pair of integers "},{"kind":"math_inline","text":"ti, vi"},{"kind":"math_inline","text":"(1 ≤ ti ≤ 2, 1 ≤ vi ≤ n)"},{"kind":"text","text":". If "},{"kind":"math_inline","text":"ti = 1"},{"kind":"text","text":", then as a reply to the query we need to paint a blue node "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" in red. If "},{"kind":"math_inline","text":"ti = 2"},{"kind":"text","text":", then we should reply to the query by printing the shortest distance from some red node to node "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given graph is a tree and that all queries are correct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each second type query print the reply in a single line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n1 2\n2 3\n2 4\n4 5\n2 1\n2 5\n1 2\n2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n3\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"342E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/342/problem/E"}