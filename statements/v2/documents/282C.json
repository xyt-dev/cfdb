{"assets":[],"contentKind":"statement","contestId":"282","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. XOR and OR"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Bitlandians are quite weird people. They do everything differently. They have a different alphabet so they have a different definition for a string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A Bitlandish string is a string made only of characters \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"BitHaval (the mayor of Bitland) loves to play with Bitlandish strings. He takes some Bitlandish string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and applies several (possibly zero) operations to it. In one operation the mayor may take any two adjacent characters of a string, define one of them as "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and the other one as "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". Then he calculates two values "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":": "},{"kind":"math_inline","text":"p = x xor y"},{"kind":"text","text":", "},{"kind":"math_inline","text":"q = x or y"},{"kind":"text","text":". Then he replaces one of the two taken characters by "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and the other one by "},{"kind":"math_inline","text":"q"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"xor"},{"kind":"text","text":" operation means the bitwise excluding OR operation. The "},{"kind":"math_inline","text":"or"},{"kind":"text","text":" operation is the bitwise OR operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So for example one operation can transform string "},{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":" to string "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" or to string "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":". String "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" cannot be transformed into any other string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You've got two Bitlandish strings "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Your task is to check if it is possible for BitHaval to transform string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to string "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" in several (possibly zero) described operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains Bitlandish string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", the second line contains Bitlandish string "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The strings can have different lengths."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given strings only consist of characters \"0\" and \"1\". The strings are not empty, their length doesn't exceed "},{"kind":"math_inline","text":"106"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" can be transformed into "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\". Please do not print the quotes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11\n10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n01\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"000\n101\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"282C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/282/problem/C"}