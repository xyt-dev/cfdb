{"assets":[],"contentKind":"statement","contestId":"566","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Max and Min"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Two kittens, Max and Min, play with a pair of non-negative integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". As you can guess from their names, kitten Max loves to maximize and kitten Min loves to minimize. As part of this game Min wants to make sure that both numbers, "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" became negative at the same time, and kitten Max tries to prevent him from doing so."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each kitten has a set of pairs of integers available to it. Kitten Max has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pairs of non-negative integers "},{"kind":"math_inline","text":"(ai, bi)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":"), and kitten Min has "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" pairs of non-negative integers "},{"kind":"math_inline","text":"(cj, dj)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j ≤ m"},{"kind":"text","text":"). As kitten Max makes a move, it can take any available pair "},{"kind":"math_inline","text":"(ai, bi)"},{"kind":"text","text":" and add "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", and kitten Min can take any available pair "},{"kind":"math_inline","text":"(cj, dj)"},{"kind":"text","text":" and subtract "},{"kind":"math_inline","text":"cj"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"dj"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". Each kitten can use each pair multiple times during distinct moves."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Max moves first. Kitten Min is winning if at some moment both numbers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are negative "},{"children":[{"kind":"text","text":"simultaneously"}],"kind":"container"},{"kind":"text","text":". Otherwise, the winner of the game is kitten Max. Determine which kitten wins if both of them play optimally."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100 000"},{"kind":"text","text":") — the number of pairs of numbers available to Max and Min, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x, y ≤ 109"},{"kind":"text","text":") — the initial values of numbers with which the kittens are playing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the pairs of numbers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ 109"},{"kind":"text","text":") — the pairs available to Max."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain pairs of numbers "},{"kind":"math_inline","text":"cj, dj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ cj, dj ≤ 109"},{"kind":"text","text":") — the pairs available to Min."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print «"},{"children":[{"kind":"text","text":"Max"}],"kind":"container"},{"kind":"text","text":"» (without the quotes), if kitten Max wins, or \""},{"children":[{"kind":"text","text":"Min"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if kitten Min wins."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n42 43\n2 3\n3 2\n3 10\n10 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Min\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n1 1\n3 4\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Max\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test from the statement Min can respond to move "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":" by move "},{"kind":"math_inline","text":"(3, 10)"},{"kind":"text","text":", and to move "},{"kind":"math_inline","text":"(3, 2)"},{"kind":"text","text":" by move "},{"kind":"math_inline","text":"(10, 3)"},{"kind":"text","text":". Thus, for each pair of Max and Min's moves the values of both numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" will strictly decrease, ergo, Min will win sooner or later."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test after each pair of Max and Min's moves both numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" only increase, thus none of them will become negative."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"566G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/566/problem/G"}