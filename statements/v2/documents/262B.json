{"assets":[],"contentKind":"statement","contestId":"262","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Roma and Changing Signs"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Roma works in a company that sells TVs. Now he has to prepare a report for the last year."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Roma has got a list of the company's incomes. The list is a sequence that consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. The total income of the company is the sum of all integers in sequence. Roma decided to perform exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" changes of signs of several numbers in the sequence. He can also change the sign of a number one, two or more times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The operation of changing a number's sign is the operation of multiplying this number by -"},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Roma perform the changes so as to make the total income of the company (the sum of numbers in the resulting sequence) maximum. Note that Roma should perform "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"math_inline","text":"k"},{"kind":"text","text":" changes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n, k ≤ 105)"},{"kind":"text","text":", showing, how many numbers are in the sequence and how many swaps are to be made."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a "},{"children":[{"kind":"text","text":"non-decreasing"}],"kind":"container"},{"kind":"text","text":" sequence, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"(|ai| ≤ 104)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The numbers in the lines are separated by single spaces. Please note that the given sequence is sorted in non-decreasing order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the single line print the answer to the problem — the maximum total income that we can obtain after exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" changes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n-1 -1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n-1 -1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample we can get sequence "},{"children":[{"kind":"text","text":"[1, 1, 1]"}],"kind":"container"},{"kind":"text","text":", thus the total income equals "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test, the optimal strategy is to get sequence "},{"children":[{"kind":"text","text":"[-1, 1, 1]"}],"kind":"container"},{"kind":"text","text":", thus the total income equals "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"262B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/262/problem/B"}