{"assets":[],"contentKind":"statement","contestId":"208","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Blood Cousins"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarpus got hold of a family relationship tree. The tree describes family relationships of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people, numbered 1 through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Each person in the tree has no more than one parent."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call person "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" a 1-ancestor of person "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is the parent of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call person "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" a "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-ancestor "},{"kind":"math_inline","text":"(k > 1)"},{"kind":"text","text":" of person "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", if person "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" has a 1-ancestor, and "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is a "},{"kind":"math_inline","text":"(k - 1)"},{"kind":"text","text":"-ancestor of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"'s 1-ancestor. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Family relationships don't form cycles in the found tree. In other words, there is no person who is his own ancestor, directly or indirectly (that is, who is an "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-ancestor for himself, for some "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x > 0"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Let's call two people "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"math_inline","text":"(x ≠ y)"},{"kind":"math_inline","text":"p"},{"kind":"text","text":"-th cousins "},{"kind":"math_inline","text":"(p > 0)"},{"kind":"text","text":", if there is person "},{"kind":"math_inline","text":"z"},{"kind":"text","text":", who is a "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"-ancestor of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and a "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"-ancestor of "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus wonders how many counsins and what kinds of them everybody has. He took a piece of paper and wrote "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" pairs of integers "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":". Help him to calculate the number of "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":"-th cousins that person "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" has, for each pair "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":" — the number of people in the tree. The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"r1, r2, ..., rn"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ri"},{"kind":"math_inline","text":"(1 ≤ ri ≤ n)"},{"kind":"text","text":" is the number of person "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"'s parent or "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", if person "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has no parent. It is guaranteed that family relationships don't form cycles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a single number "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ m ≤ 105)"},{"kind":"text","text":" — the number of family relationship queries Polycarus has. Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain pairs of space-separated integers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains numbers "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"pi"},{"kind":"math_inline","text":"(1 ≤ vi, pi ≤ n)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space-separated integers — the answers to Polycarpus' queries. Print the answers to the queries in the order, in which the queries occur in the input."}],"kind":"para