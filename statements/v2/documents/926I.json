{"assets":[],"contentKind":"statement","contestId":"926","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"I. A Vital Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp has a strict daily schedule. He has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" alarms set for each day, and the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th alarm rings each day at the same time during exactly one minute."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the longest time segment when Polycarp can sleep, i. e. no alarm rings in that period. It is possible that Polycarp begins to sleep in one day, and wakes up in another."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of alarms."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains a description of one alarm. Each description has a format \""},{"children":[{"kind":"text","text":"hh:mm"}],"kind":"container"},{"kind":"text","text":"\", where "},{"kind":"math_inline","text":"hh"},{"kind":"text","text":" is the hour when the alarm rings, and "},{"kind":"math_inline","text":"mm"},{"kind":"text","text":" is the minute of that hour when the alarm rings. The number of hours is between "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"23"},{"kind":"text","text":", and the number of minutes is between "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"59"},{"kind":"text","text":". All alarm times are distinct. The order of the alarms is arbitrary."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each alarm starts ringing in the beginning of the corresponding minute and rings for exactly one minute (i. e. stops ringing in the beginning of the next minute). Polycarp can start sleeping instantly when no alarm is ringing, and he wakes up at the moment when some alarm starts ringing."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a line in format \""},{"children":[{"kind":"text","text":"hh:mm"}],"kind":"container"},{"kind":"text","text":"\", denoting the maximum time Polycarp can sleep continuously. "},{"kind":"math_inline","text":"hh"},{"kind":"text","text":" denotes the number of hours, and "},{"kind":"math_inline","text":"mm"},{"kind":"text","text":" denotes the number of minutes. The number of minutes should be between "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"59"},{"kind":"text","text":". Look through examples to understand the format better."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n05:43\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"23:59\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n22:00\n03:21\n16:03\n09:59\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"06:37\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example there is only one alarm which rings during one minute of a day, and then rings again on the next day, "},{"kind":"math_inline","text":"23"},{"kind":"text","text":" hours and "},{"kind":"math_inline","text":"59"},{"kind":"text","text":" minutes later. Polycarp can sleep all this time."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"I","problemCode":"926I","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/926/problem/I"}