{"assets":[],"contentKind":"statement","contestId":"2131","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Sea, You & copriMe"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"Umi is given an array $$$a$$$ of length $$$n$$$, whose elements are integers between $$$1$$$ and $$$m$$$. She loves coprime integers and wants to find four "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" indices $$$p, q, r, s$$$ ($$$1 \\le p, q, r, s \\le n$$$), such that $$$\\gcd(a_p, a_q) = 1$$$ and $$$\\gcd(a_r, a_s) = 1$$$$$$^{\\text{∗}}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, you may output any one of them."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$$$$\\gcd(x, y)$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Greatest_common_divisor"},"children":[{"kind":"text","text":"greatest common divisor (GCD)"}],"kind":"link"},{"kind":"text","text":" of integers $$$x$$$ and $$$y$$$. "}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$m$$$ ($$$4 \\le n \\le 2 \\cdot 10^5, 1 \\le m \\le 10^6$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le m$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$, and that the sum of $$$m$$$ over all test cases does not exceed $$$10^6$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If no such set of four distinct indices exists, output one integer $$$0$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Otherwise, output four "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" integers $$$p, q, r, s$$$ ($$$1 \\le p, q, r, s \\le n$$$) that satisfy the condition. If there are multiple solutions, output any one of them. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n4 15\n4 7 9 15\n4 10\n1 2 4 8\n5 15\n6 10 11 12 15\n5 15\n6 10 11 14 15\n6 10000\n30 238 627 1001 1495 7429\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 3 2 4\n0\n0\n3 1 4 5\n1 4 2 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, $$$\\gcd(a_1, a_3) = \\gcd(4, 9) = 1$$$, $$$\\gcd(a_2, a_4) = \\gcd(7, 15) = 1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, it can be shown that no such quadruple exists."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"2131H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2131/problem/H"}