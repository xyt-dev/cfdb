{"assets":[],"contentKind":"statement","contestId":"954","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. String Typing"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase Latin letters. You have to type this string using your keyboard."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially, you have an empty string. Until you type the whole string, you may perform the following operation:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" add a character to the end of the string. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Besides, "},{"children":[{"kind":"text","text":"at most once"}],"kind":"container"},{"kind":"text","text":" you may perform one additional operation: copy the string and append it to itself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if you have to type string "},{"children":[{"kind":"text","text":"abcabca"}],"kind":"container"},{"kind":"text","text":", you can type it in "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" operations if you type all the characters one by one. However, you can type it in "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" operations if you type the string "},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":" first and then copy it and type the last character."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If you have to type string "},{"children":[{"kind":"text","text":"aaaaaaaaa"}],"kind":"container"},{"kind":"text","text":", the best option is to type "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" characters one by one, then copy the string, and then type the remaining character."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print the minimum number of operations you need to type the given string."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input containing only one integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the length of the string you have to type. The second line containing the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer number — the minimum number of operations you need to type the given string."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\nabcabca\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\nabcdefgh\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test described in the problem statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test you can only type all the characters one by one."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"954B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/954/problem/B"}