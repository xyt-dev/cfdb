{"assets":[],"contentKind":"statement","contestId":"1202","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. You Are Given Some Letters..."}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given $$$a$$$ uppercase Latin letters 'A' and $$$b$$$ letters 'B'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The period of the string is the smallest such positive integer $$$k$$$ that $$$s_i = s_{i~mod~k}$$$ ($$$0$$$-indexed) for each $$$i$$$. Note that this implies that $$$k$$$ won't always divide $$$a+b = |s|$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the period of string \"ABAABAA\" is $$$3$$$, the period of \"AAAA\" is $$$1$$$, and the period of \"AABBB\" is $$$5$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the number of different periods over all possible strings with $$$a$$$ letters 'A' and $$$b$$$ letters 'B'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$a$$$ and $$$b$$$ ($$$1 \\le a, b \\le 10^9$$$) — the number of letters 'A' and 'B', respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the num