{"assets":[],"contentKind":"statement","contestId":"812","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Sagheer and Apple Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sagheer is playing a game with his best friend Soliman. He brought a tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and rooted at node "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th node has "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" apples. This tree has a special property: the lengths of all paths from the root to any leaf have the same parity (i.e. all paths have even length or all paths have odd length)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sagheer and Soliman will take turns to play. Soliman will make the first move. The player who can't make a move loses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In each move, the current player will pick a single node, take a non-empty subset of apples from it and do one of the following two things:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" eat the apples, if the node is a leaf. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" move the apples to one of the children, if the node is non-leaf. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Before Soliman comes to start playing, Sagheer will make "},{"children":[{"kind":"text","text":"exactly one change"}],"kind":"container"},{"kind":"text","text":" to the tree. He will pick two different nodes "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and swap the apples of "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" with the apples of "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Can you help Sagheer count the number of ways to make the swap (i.e. to choose "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":") after which he will win the game if both players play optimally? "},{"kind":"math_inline","text":"(u, v)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(v, u)"},{"kind":"text","text":" are considered to be the same pair."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line will contain one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105)"},{"kind":"text","text":" — the number of nodes in the apple tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line will contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 107"},{"kind":"text","text":") — the number of apples on each node of the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line will contain "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"p2, p3, ..., pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":") — the parent of each node of the tree. Node "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has parent "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" (for "},{"kind":"math_inline","text":"2 ≤ i ≤ n"},{"kind":"text","text":"). Node "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is the root of the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the input describes a valid tree, and the lengths of all paths from the root to any leaf will have the same parity."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On a single line, print the number of different pairs of nodes "},{"kind":"math_inline","text":"(u, v)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"u ≠ v"},{"kind":"text","text":" such that if they start playing after swapping the apples of both nodes, Sagheer will win the game. "},{"kind":"math_inline","text":"(u, v)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(v, u)"},{"kind":"text","text":" are considered to be the same pair."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 2 3\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n7 2 2 5 4 3 1 1\n1 1 1 4 4 5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Sagheer can only win if he swapped node "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" with node "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". In this case, both leaves will have "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" apples. If Soliman makes a move in a leaf node, Sagheer can make the same move in the other leaf. If Soliman moved some apples from a root to a leaf, Sagheer will eat those moved apples. Eventually, Soliman will not find a move."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, There is no swap that will make Sagheer win the game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that Sagheer must make the swap even if he can win with the initial tree."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"812E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/812/problem/E"}