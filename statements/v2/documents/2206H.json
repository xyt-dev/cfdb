{"assets":[],"contentKind":"statement","contestId":"2206","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Reflect Sort"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a sequence of $$$n$$$ integers $$$(a_1, a_2, \\ldots, a_n)$$$, the initial values of which are given to you. You may apply the following operation to the sequence any number of times (possibly zero): "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Choose an index $$$i$$$ ($$$1 \\le i \\le n$$$). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Choose a set $$$S$$$ to be either the prefix $$$\\{1,2,\\ldots,i-1\\}$$$ or the suffix $$$\\{i+1,i+2,\\ldots,n\\}$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For every $$$j \\in S$$$, replace $$$a_j$$$ with $$$2a_i - a_j$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your goal is to make the sequence "},{"children":[{"kind":"text","text":"non-decreasing"}],"kind":"container"},{"kind":"text","text":" and all elements "},{"children":[{"kind":"text","text":"positive"}],"kind":"container"},{"kind":"text","text":", while minimizing $$$a_n$$$, using the operation above any number of times. That is, $$$1 \\le a_1 \\le a_2 \\le \\ldots \\le a_n$$$ must hold in the resulting sequence. What is the minimum possible value of $$$a_n$$$ in the resulting sequence?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer $$$n$$$ ($$$2 \\le n \\le 100\\,000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers representing the initial values of $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the minimum possible value of $$$a_n$$$ in the resulting sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n6 3 5 5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2 1 100000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n100002\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Explanation for the sample input/output #1"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can do the following sequence of operations."}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Choose $$$i = 1$$$ and $$$S$$$ as the suffix $$$\\{2, 3, 4, 5\\}$$$: $$$(6, 3, 5, 5, 2) \\to (6, 9, 7, 7, 10)$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Choose $$$i = 3$$$ and $$$S$$$ as the prefix $$$\\{1, 2\\}$$$: $$$(6, 9, 7, 7, 10) \\to (8, 5, 7, 7, 10)$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Choose $$$i = 2$$$ and $$$S$$$ as the prefix $$$\\{1\\}$$$: $$$(8, 5, 7, 7, 10) \\to (2, 5, 7, 7, 10)$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"After these operations, the sequence is non-decreasing and all elements are positive. It can be shown that $$$a_5=10$$$ is the minimum possible value."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Explanation for the sample input/output #2"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The minimum possible value of $$$a_3$$$ is $$$100002$$$, which can be attained by the following operations."}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Choose $$$i = 2$$$ and $$$S$$$ as the suffix $$$\\{3\\}$$$: $$$(2, 1, 100000) \\to (2, 1, -99998)$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Choose $$$i = 1$$$ and $$$S$$$ as the suffix $$$\\{2, 3\\}$$$: $$$(2, 1, -99998) \\to (2, 3, 100002)$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that the sequence may contain non-positive values during operations."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"2206H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2206/problem/H"}