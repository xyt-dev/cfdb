{"assets":[],"contentKind":"statement","contestId":"665","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Shopping"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ayush is a cashier at the shopping center. Recently his department has started a ''"},{"children":[{"kind":"text","text":"click and collect"}],"kind":"container"},{"kind":"text","text":"\" service which allows users to shop online. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The store contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" items. "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" customers have already used the above service. Each user paid for "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" items. Let "},{"kind":"math_inline","text":"aij"},{"kind":"text","text":" denote the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th item in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th person's order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Due to the space limitations all the items are arranged in one single row. When Ayush receives the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th order he will find one by one all the items "},{"kind":"math_inline","text":"aij"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j ≤ m"},{"kind":"text","text":") in the row. Let "},{"kind":"math_inline","text":"pos(x)"},{"kind":"text","text":" denote the position of the item "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" in the row at the moment of its collection. Then Ayush takes time equal to "},{"kind":"math_inline","text":"pos(ai1) + pos(ai2) + ... + pos(aim)"},{"kind":"text","text":" for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th customer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When Ayush accesses the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-th element he keeps a new stock in the front of the row and takes away the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-th element. Thus the values are updating."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to calculate the total time it takes for Ayush to process all the orders."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can assume that the market has endless stock."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, k ≤ 100, 1 ≤ m ≤ k"},{"kind":"text","text":") — the number of users, the number of items each user wants to buy and the total number of items at the market."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"pl"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pl ≤ k"},{"kind":"text","text":") denoting the initial positions of the items in the store. The items are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"aij"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ aij ≤ k"},{"kind":"text","text":") — the order of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th person."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — the total time needed for Ayush to process all the orders."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 5\n3 4 1 2 5\n1 5\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Customer "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" wants the items "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"pos(1) = 3"},{"kind":"text","text":", so the new positions are: "},{"kind":"math_inline","text":"[1, 3, 4, 2, 5]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"pos(5) = 5"},{"kind":"text","text":", so the new positions are: "},{"kind":"math_inline","text":"[5, 1, 3, 4, 2]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time taken for the first customer is "},{"kind":"math_inline","text":"3 + 5 = 8"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Customer "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" wants the items "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"pos(3) = 3"},{"kind":"text","text":", so the new positions are: "},{"kind":"math_inline","text":"[3, 5, 1, 4, 2]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"pos(1) = 3"},{"kind":"text","text":", so the new positions are: "},{"kind":"math_inline","text":"[1, 3, 5, 4, 2]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Time taken for the second customer is "},{"kind":"math_inline","text":"3 + 3 = 6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Total time is "},{"kind":"math_inline","text":"8 + 6 = 14"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally "},{"kind":"math_inline","text":"pos(x)"},{"kind":"text","text":" is the index of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" in the current row."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"665B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/665/problem/B"}