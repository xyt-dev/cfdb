{"assets":[],"contentKind":"statement","contestId":"928","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Chat"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are times you recall a good old friend and everything you've come through together. Luckily there are social networks — they store all your message history making it easy to know what you argued over 10 years ago."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formal, your message history is a sequence of messages ordered by time sent numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the total number of messages in the chat."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each message might contain a link to an earlier message which it is a reply to. When opening a message "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" or getting a link to it, the dialogue is shown in such a way that "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" previous messages, message "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" next messages are visible (with respect to message "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"). In case there are less than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" messages somewhere, they are yet all shown."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Digging deep into your message history, you always read all visible messages and then go by the link in the current message "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" (if there is one) and continue reading in the same manner."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the number of messages you'll read if your start from message number "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Calculate these numbers independently. If you start with message "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", the initial configuration is "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" itself, "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" previous and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" next messages. Messages read multiple times are considered as one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ n"},{"kind":"text","text":") — the total amount of messages and the number of previous and next messages visible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line features a sequence of integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai < i"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" denotes the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th message link destination or zero, if there's no link from "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". All messages are listed in chronological order. It's guaranteed that the link from message "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" goes to message with number strictly less than "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers with "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th denoting the number of distinct messages you can read starting from message "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and traversing the links while possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 0\n0 1 1 2 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 2 3 3 3 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 1\n0 1 0 3 4 5 2 3 7 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 3 3 4 5 6 6 6 8 2 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 2 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider "},{"kind":"math_inline","text":"i = 6"},{"kind":"text","text":" in sample case one. You will read message "},{"kind":"math_inline","text":"6"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and then there will be no link to go."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample case "},{"kind":"math_inline","text":"i = 6"},{"kind":"text","text":" gives you messages "},{"kind":"math_inline","text":"5, 6, 7"},{"kind":"text","text":" since "},{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"4, 5, 6"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"2, 3, 4"},{"kind":"text","text":" and then the link sequence breaks. The number of distinct messages here is equal to "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"928B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/928/problem/B"}