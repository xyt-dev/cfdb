{"assets":[],"contentKind":"statement","contestId":"2178","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. First or Second"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"There are $$$n$$$ children standing in a line, where the "},{"children":[{"kind":"text","text":"niceness"}],"kind":"container"},{"kind":"text","text":" of the $$$i$$$-th child is $$$a_i$$$. Santa is deciding which children belong on the nice list and which belong on the naughty list."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An integer $$$X$$$ is initially set to $$$0$$$. Santa will perform the following operation "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" $$$n-1$$$ times:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose the first or second child in line and remove them from the line. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Let $$$w$$$ be the "},{"children":[{"kind":"text","text":"niceness"}],"kind":"container"},{"kind":"text","text":" of the chosen child. "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the first child was chosen, add them to the nice list and add $$$w$$$ to $$$X$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the second child was chosen, add them to the naughty list and subtract $$$w$$$ from $$$X$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that after all operations, exactly one child remains unassigned to a list."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the maximum possible value of $$$X$$$ that Santa can obtain after all $$$n-1$$$ operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$2\\le n\\le 2\\cdot 10^5$$$) — the number of children."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1,a_2,\\ldots,a_n$$$ ($$$-10^9\\le a_i\\le 10^9$$$) — the "},{"children":[{"kind":"text","text":"niceness"}],"kind":"container"},{"kind":"text","text":" of each child."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2\\cdot 10 ^ 5$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single integer — the maximum possible value of $$$X$$$ that Santa can obtain after all $$$n-1$$$ operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n2\n2 -3\n4\n1 4 3 4\n4\n-4 2 3 -6\n5\