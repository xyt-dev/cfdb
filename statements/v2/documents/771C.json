{"assets":["/statement-assets/94d661c1ccae5f6ef585ace3fd9326af1c03a712eb094ed9d10805626b5760e6.png","/statement-assets/ebc32e64957cea1ad2f67ed2c768afabba954222a847ae695b104a585c675f98.png"],"contentKind":"statement","contestId":"771","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Bear and Tree Jumps"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A tree is an undirected connected graph without cycles. The distance between two vertices is the number of edges in a simple path between them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak is a little polar bear. He lives in a tree that consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices, numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak recently learned how to jump. He can jump from a vertex to any vertex within distance at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a pair of vertices "},{"kind":"math_inline","text":"(s, t)"},{"kind":"text","text":" we define "},{"kind":"math_inline","text":"f(s, t)"},{"kind":"text","text":" as the minimum number of jumps Limak needs to get from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Your task is to find the sum of "},{"kind":"math_inline","text":"f(s, t)"},{"kind":"text","text":" over all pairs of vertices "},{"kind":"math_inline","text":"(s, t)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"s < t"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 200 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 5"},{"kind":"text","text":") — the number of vertices in the tree and the maximum allowed jump distance respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines describe edges in the tree. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of those lines contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":") — the indices on vertices connected with "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the given edges form a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer, denoting the sum of "},{"kind":"math_inline","text":"f(s, t)"},{"kind":"text","text":" over all pairs of vertices "},{"kind":"math_inline","text":"(s, t)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"s < t"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2\n1 2\n1 3\n2 4\n2 5\n4 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"13 3\n1 2\n3 2\n4 2\n5 2\n3 6\n10 6\n6 7\n6 13\n5 8\n5 9\n9 11\n11 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"114\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n2 1\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the given tree has "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" vertices and it's displayed on the drawing below. Limak can jump to any vertex within distance at most "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". For example, from the vertex "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" he can jump to any of vertices: "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" (well, he can also jump to the vertex "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" itself)."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/94d661c1ccae5f6ef585ace3fd9326af1c03a712eb094ed9d10805626b5760e6.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"There are "},{"attrs":{"alt":"","src":"/statement-assets/ebc32e64957cea1ad2f67ed2c768afabba954222a847ae695b104a585c675f98.png"},"kind":"image"},{"kind":"text","text":" pairs of vertices "},{"kind":"math_inline","text":"(s, t)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"s < t"},{"kind":"text","text":". For "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" of those pairs Limak would need two jumps: "},{"kind":"math_inline","text":"(1, 6), (3, 4), (3, 5), (3, 6), (5, 6)"},{"kind":"text","text":". For other "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" pairs one jump is enough. So, the answer is "},{"kind":"math_inline","text":"5·2 + 10·1 = 20"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, Limak can jump between every two vertices directly. There are "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" pairs of vertices "},{"kind":"math_inline","text":"(s < t)"},{"kind":"text","text":", so the answer is "},{"kind":"math_inline","text":"3·1 = 3"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"771C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/771/problem/C"}