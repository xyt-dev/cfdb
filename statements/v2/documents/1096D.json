{"assets":[],"contentKind":"statement","contestId":"1096","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Easy Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya is preparing a contest, and now he has written a statement for an easy problem. The statement is a string of length $$$n$$$ consisting of lowercase Latin latters. Vasya thinks that the statement can be considered hard if it contains a subsequence "},{"children":[{"kind":"text","text":"hard"}],"kind":"container"},{"kind":"text","text":"; otherwise the statement is easy. For example, "},{"children":[{"kind":"text","text":"hard"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"hzazrzd"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"haaaaard"}],"kind":"container"},{"kind":"text","text":" can be considered hard statements, while "},{"children":[{"kind":"text","text":"har"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"hart"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"drah"}],"kind":"container"},{"kind":"text","text":" are easy statements. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya doesn't want the statement to be hard. He may remove some characters from the statement in order to make it easy. But, of course, some parts of the statement can be crucial to understanding. Initially the "},{"children":[{"kind":"text","text":"ambiguity"}],"kind":"container"},{"kind":"text","text":" of the statement is $$$0$$$, and removing $$$i$$$-th character increases the "},{"children":[{"kind":"text","text":"ambiguity"}],"kind":"container"},{"kind":"text","text":" by $$$a_i$$$ (the index of each character is considered as it was in the original statement, so, for example, if you delete character "},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":" from "},{"children":[{"kind":"text","text":"hard"}],"kind":"container"},{"kind":"text","text":", and then character "},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":", the index of "},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":" is still $$$4$$$ even though you delete it from the string "},{"children":[{"kind":"text","text":"had"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya wants to calculate the minimum "},{"children":[{"kind":"text","text":"ambiguity"}],"kind":"container"},{"kind":"text","text":" of the statement, if he removes some characters (possibly zero) so that the statement is easy. Help him to do it!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Recall that subsequence is a sequence that can be derived from another sequence by deleting some elements without changing the order of the remaining elements."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$1 \\le n \\le 10^5$$$) — the length of the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains one string $$$s$$$ of length $$$n$$$, consisting of lowercase Latin letters — the statement written by Vasya."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 998244353$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print minimum possible "},{"children":[{"kind":"text","text":"ambiguity"}],"kind":"container"},{"kind":"text","text":" of the statement after Vasya deletes some (possibly zero) characters so the resulting statement is easy."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\nhhardh\n3 2 9 11 7 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8\nhhzarwde\n3 2 6 9 4 8 7 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\nhhaarr\n1 2 3 4 5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, first two characters are removed so the result is "},{"children":[{"kind":"text","text":"ardh"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, $$$5$$$-th character is removed so the result is "},{"children":[{"kind":"text","text":"hhzawde"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example there's no need to remove anything."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1096D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1096/problem/D"}