{"assets":[],"contentKind":"statement","contestId":"1612","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. X-Magic Pair"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a pair of integers $$$(a, b)$$$ and an integer $$$x$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can change the pair in two different ways: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" set (assign) $$$a := |a - b|$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" set (assign) $$$b := |a - b|$$$, "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" where $$$|a - b|$$$ is the absolute difference between $$$a$$$ and $$$b$$$."},{"children":[{"kind":"text","text":"The pair $$$(a, b)$$$ is called $$$x$$$-magic if $$$x$$$ is obtainable either as $$$a$$$ or as $$$b$$$ using only the given operations (i.e. the pair $$$(a, b)$$$ is $$$x$$$-magic if $$$a = x$$$ or $$$b = x$$$ after some number of operations applied). You can apply the operations any number of times (even zero)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find out if the pair $$$(a, b)$$$ is $$$x$$$-magic or not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to answer $$$t$$$ independent test cases."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. The next $$$t$$$ lines describe test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of the test case contains three integers $$$a$$$, $$$b$$$ and $$$x$$$ ($$$1 \\le a, b, x \\le 10^{18}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the $$$i$$$-th test case, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" if the corresponding pair $$$(a, b)$$$ is $$$x$$$-magic and "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n6 9 3\n15 38 7\n18 8 8\n30 30 30\n40 50 90\n24 28 20\n365 216 52\n537037812705867558 338887693834423551 3199921013340\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nYES\nYES\nYES\nNO\nYES\nYES\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1612D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1612/problem/D"}