{"assets":[],"contentKind":"statement","contestId":"1327","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Sum of Odd Integers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two integers $$$n$$$ and $$$k$$$. Your task is to find if $$$n$$$ can be represented as a sum of $$$k$$$ "},{"children":[{"kind":"text","text":"distinct positive odd"}],"kind":"container"},{"kind":"text","text":" (not divisible by $$$2$$$) integers or not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to answer $$$t$$$ independent test cases."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$t$$$ ($$$1 \\le t \\le 10^5$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$t$$$ lines describe test cases. The only line of the test case contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\le n, k \\le 10^7$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the answer — \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if $$$n$$$ can be represented as a sum of $$$k$$$ "},{"children":[{"kind":"text","text":"distinct positive odd"}],"kind":"container"},{"kind":"text","text":" (not divisible by $$$2$$$) integers and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n3 1\n4 2\n10 3\n10 2\n16 4\n16 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nYES\nNO\nYES\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, you can represent $$$3$$$ as $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the only way to represent $$$4$$$ is $$$1+3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, you cannot represent $$$10$$$ as the sum of three distinct positive odd integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, you can represent $$$10$$$ as $$$3+7$$$, for example."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth test case, you can represent $$$16$$$ as $$$1+3+5+7$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the sixth test case, you cannot represent $$$16$$$ as the sum of five distinct positive odd integers."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1327A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1327/problem/A"}