{"assets":[],"contentKind":"statement","contestId":"820","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Mister B and Boring Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sometimes Mister B has free evenings when he doesn't know what to do. Fortunately, Mister B found a new game, where the player can play against aliens."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All characters in this game are lowercase English letters. There are two players: Mister B and his competitor."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially the players have a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of the first "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" English letters in alphabetical order (for example, if "},{"kind":"math_inline","text":"a = 5"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" equals to \""},{"children":[{"kind":"text","text":"abcde"}],"kind":"container"},{"kind":"text","text":"\")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The players take turns appending letters to string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Mister B moves first."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mister B must append exactly "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" letters on each his move. He can arbitrary choose these letters. His opponent adds exactly "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" letters on each move."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mister B quickly understood that his opponent was just a computer that used a simple algorithm. The computer on each turn considers the suffix of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and generates a string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" such that all letters in the string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" are distinct and don't appear in the considered suffix. From multiple variants of "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lexicographically minimal is chosen (if "},{"kind":"math_inline","text":"a = 4"},{"kind":"text","text":" and the suffix is \""},{"children":[{"kind":"text","text":"bfdd"}],"kind":"container"},{"kind":"text","text":"\", the computer chooses string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" equal to \""},{"children":[{"kind":"text","text":"aceg"}],"kind":"container"},{"kind":"text","text":"\"). After that the chosen string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is appended to the end of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mister B soon found the game boring and came up with the following question: what can be the minimum possible number of different letters in string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" on the segment between positions "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", inclusive. Letters of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" are numerated starting from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First and only line contains four space-separated integers: "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ 12"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ 109"},{"kind":"text","text":") — the numbers of letters each player appends and the bounds of the segment."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the minimum possible number of different letters in the segment from position "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to position "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", inclusive, in string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 1 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 2 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 7 4 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test one of optimal strategies generate string "},{"kind":"math_inline","text":"s = "},{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"abababab..."}],"kind":"container"},{"kind":"text","text":"\", that's why answer is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test string "},{"kind":"math_inline","text":"s = "},{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"abcdbcaefg..."}],"kind":"container"},{"kind":"text","text":"\" can be obtained, chosen segment will look like \""},{"children":[{"kind":"text","text":"bcdbc"}],"kind":"container"},{"kind":"text","text":"\", that's why answer is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample test string "},{"kind":"math_inline","text":"s = "},{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"abczzzacad..."}],"kind":"container"},{"kind":"text","text":"\" can be obtained, chosen, segment will look like \""},{"children":[{"kind":"text","text":"zzz"}],"kind":"container"},{"kind":"text","text":"\", that's why answer is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"820C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/820/problem/C"}