{"assets":[],"contentKind":"statement","contestId":"749","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Leaving Auction"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people taking part in auction today. The rules of auction are classical. There were "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" bids made, though it's not guaranteed they were from different people. It might happen that some people made no bids at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each bid is define by two integers "},{"kind":"math_inline","text":"(ai, bi)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the index of the person, who made this bid and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is its size. Bids are given in chronological order, meaning "},{"kind":"math_inline","text":"bi < bi + 1"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i < n"},{"kind":"text","text":". Moreover, participant never makes two bids in a row (no one updates his own bid), i.e. "},{"kind":"math_inline","text":"ai ≠ ai + 1"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i < n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now you are curious with the following question: who (and which bid) will win the auction if some participants were absent? Consider that if someone was absent, all his bids are just removed and no new bids are added."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note, that if during this imaginary exclusion of some participants it happens that some of the remaining participants makes a bid twice (or more times) in a row, only first of these bids is counted. For better understanding take a look at the samples."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have several questions in your mind, compute the answer for each of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000"},{"kind":"text","text":") — the number of participants and bids."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ n, 1 ≤ bi ≤ 109, bi < bi + 1"},{"kind":"text","text":") — the number of participant who made the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th bid and the size of this bid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains an integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 200 000"},{"kind":"text","text":") — the number of question you have in mind."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains an integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":"), followed by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"lj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ lj ≤ n"},{"kind":"text","text":") — the number of people who are not coming in this question and their indices. It is guarenteed that "},{"kind":"math_inline","text":"lj"},{"kind":"text","text":" values are different for a single question."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the sum of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" over all question won't exceed "},{"kind":"math_inline","text":"200 000"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each question print two integer — the index of the winner and the size of the winning bid. If there is no winner (there are no remaining bids at all), print two zeroes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 10\n2 100\n3 1000\n1 10000\n2 100000\n3 1000000\n3\n1 3\n2 2 3\n2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 100000\n1 10\n3 1000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 10\n2 100\n1 1000\n2\n2 1 2\n2 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 0\n1 10\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first sample: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" In the first question participant number "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" is absent so the sequence of bids looks as follows: "},{"attrs":{"ordered":true},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"10"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"100"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"10 000"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"100 000"}],"kind":"list_item"},{"kind":"text","text":" Participant number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" wins with the bid "},{"kind":"math_inline","text":"100 000"},{"kind":"text","text":"."},{"children":[{"kind":"text","text":" In the second question participants "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" are absent, so the sequence of bids looks: "},{"attrs":{"ordered":true},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"10"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"10 000"}],"kind":"list_item"},{"kind":"text","text":" The winner is, of course, participant number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" but the winning bid is "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" instead of "},{"kind":"math_inline","text":"10 000"},{"kind":"text","text":" as no one will ever increase his own bid (in this problem). "},{"children":[{"kind":"text","text":" In the third question participants "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" are absent and the sequence is: "},{"attrs":{"ordered":true},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"3"},{"kind":"math_inline","text":"1 000"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"3"},{"kind":"math_inline","text":"1 000 000"}],"kind":"list_item"},{"kind":"text","text":" The winner is participant "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" with the bid "},{"kind":"math_inline","text":"1 000"},{"kind":"text","text":". "}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"749D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/749/problem/D"}