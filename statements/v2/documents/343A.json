{"assets":["/statement-assets/cc48d212212291316eeee05902fa988099ad5209767d1b9abde3d9adc5d3c685.png","/statement-assets/5ea6a8ca8ffba1713b1ac01338e7e7fa7fd81c7d0d0f2d6fdd82d554f0a0f00a.png","/statement-assets/01a25c5b17e0bb44513cb526cd863ff7cc7bfcbfe2f688057fc260236a1ad773.png","/statement-assets/9de62411d0616dde9480f9706c964e6b18ee205f4865e925930dece742230ed0.png"],"contentKind":"statement","contestId":"343","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Rational Resistance"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mad scientist Mike is building a time machine in his spare time. To finish the work, he needs a resistor with a certain resistance value."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, all Mike has is lots of identical resistors with unit resistance "},{"kind":"math_inline","text":"R0 = 1"},{"kind":"text","text":". Elements with other resistance can be constructed from these resistors. In this problem, we will consider the following as elements: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" one resistor; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" an element and "},{"children":[{"kind":"text","text":"one"}],"kind":"container"},{"kind":"text","text":" resistor plugged in sequence; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" an element and "},{"children":[{"kind":"text","text":"one"}],"kind":"container"},{"kind":"text","text":" resistor plugged in parallel. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/cc48d212212291316eeee05902fa988099ad5209767d1b9abde3d9adc5d3c685.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"With the consecutive connection the resistance of the new element equals "},{"kind":"math_inline","text":"R = Re + R0"},{"kind":"text","text":". With the parallel connection the resistance of the new element equals "},{"attrs":{"alt":"","src":"/statement-assets/5ea6a8ca8ffba1713b1ac01338e7e7fa7fd81c7d0d0f2d6fdd82d554f0a0f00a.png"},"kind":"image"},{"kind":"text","text":". In this case "},{"kind":"math_inline","text":"Re"},{"kind":"text","text":" equals the resistance of the element being connected."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mike needs to assemble an element with a resistance equal to the fraction "},{"attrs":{"alt":"","src":"/statement-assets/01a25c5b17e0bb44513cb526cd863ff7cc7bfcbfe2f688057fc260236a1ad773.png"},"kind":"image"},{"kind":"text","text":". Determine the smallest possible number of resistors he needs to make such an element."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single input line contains two space-separated integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ 1018"},{"kind":"text","text":"). It is guaranteed that the fraction "},{"attrs":{"alt":"","src":"/statement-assets/01a25c5b17e0bb44513cb526cd863ff7cc7bfcbfe2f688057fc260236a1ad773.png"},"kind":"image"},{"kind":"text","text":" is irreducible. It is guaranteed that a solution always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the answer to the problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is recommended to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"199 200\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"200\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, one resistor is enough."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample one can connect the resistors in parallel, take the resulting element and connect it to a third resistor consecutively. Then, we get an element with resistance "},{"attrs":{"alt":"","src":"/statement-assets/9de62411d0616dde9480f9706c964e6b18ee205f4865e925930dece742230ed0.png"},"kind":"image"},{"kind":"text","text":". We cannot make this element using two resistors."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"343A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/343/problem/A"}