{"assets":[],"contentKind":"statement","contestId":"843","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Sorting by Subsequences"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" consisting of "},{"children":[{"kind":"text","text":"different"}],"kind":"container"},{"kind":"text","text":" integers. It is required to split this sequence into the "},{"children":[{"kind":"text","text":"maximum"}],"kind":"container"},{"kind":"text","text":" number of subsequences such that after sorting integers in each of them in increasing order, the total sequence also will be sorted in increasing order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sorting integers in a subsequence is a process such that the numbers included in a subsequence are ordered in increasing order, and the numbers which are not included in a subsequence don't change their places."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Every element of the sequence must appear in exactly one subsequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input data contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the length of the sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of input data contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ ai ≤ 109"},{"kind":"text","text":") — the elements of the sequence. It is guaranteed that all elements of the sequence are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the maximum number of subsequences "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", which the original sequence can be split into while fulfilling the requirements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines print the description of subsequences in the following format: the number of elements in subsequence "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 < ci ≤ n"},{"kind":"text","text":"), then "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"l1, l2, ..., lci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ lj ≤ n"},{"kind":"text","text":") — indices of these elements in the original sequence. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Indices could be printed in any order. Every index from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" must appear in output "},{"children":[{"kind":"text","text":"exactly once"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several possible answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n3 2 1 6 5 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 1 3\n1 2\n2 4 6\n1 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n83 -75 -49 11 37 62\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n6 1 2 3 4 5 6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample output:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After sorting the first subsequence we will get sequence "},{"kind":"math_inline","text":"1 2 3 6 5 4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sorting the second subsequence changes nothing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After sorting the third subsequence we will get sequence "},{"kind":"math_inline","text":"1 2 3 4 5 6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sorting the last subsequence changes nothing."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"843A","sche