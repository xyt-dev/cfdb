{"assets":["/statement-assets/f14350a70e90e3d9c72fad113967c27cb09a3848dee2e82fa7a147d428783f80.png"],"contentKind":"statement","contestId":"160","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Edges in MST"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a connected weighted undirected graph without any loops and multiple edges. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us remind you that a graph's "},{"children":[{"kind":"text","text":"spanning tree"}],"kind":"container"},{"kind":"text","text":" is defined as an acyclic connected subgraph of the given graph that includes all of the graph's vertexes. The "},{"children":[{"kind":"text","text":"weight"}],"kind":"container"},{"kind":"text","text":" of a tree is defined as the sum of weights of the edges that the given tree contains. The "},{"children":[{"kind":"text","text":"minimum spanning tree"}],"kind":"container"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"MST"}],"kind":"container"},{"kind":"text","text":") of a graph is defined as the graph's spanning tree having the minimum possible weight. For any connected graph obviously exists the minimum spanning tree, but in the general case, a graph's minimum spanning tree is not unique."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine the following for each edge of the given graph: whether it is either included in "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" MST, or included "},{"children":[{"kind":"text","text":"at least in one"}],"kind":"container"},{"kind":"text","text":" MST, or "},{"children":[{"kind":"text","text":"not included in any"}],"kind":"container"},{"kind":"text","text":" MST."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/f14350a70e90e3d9c72fad113967c27cb09a3848dee2e82fa7a147d428783f80.png"},"kind":"image"},{"kind":"text","text":") — the number of the graph's vertexes and edges, correspondingly. Then follow "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines, each of them contains three integers — the description of the graph's edges as \""},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"bi"},{"kind":"math_inline","text":"wi"},{"kind":"text","text":"\" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n, 1 ≤ wi ≤ 106, ai ≠ bi"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" are the numbers of vertexes connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge, "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" is the edge's weight. It is guaranteed that the graph is connected and doesn't contain loops or multiple edges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines — the answers for all edges. If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge is included in any MST, print \""},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":"\"; if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge is included at least in one MST, print \""},{"children":[{"kind":"text","text":"at least one"}],"kind":"container"},{"kind":"text","text":"\"; if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge isn't included in any MST, print \""},{"children":[{"kind":"text","text":"none"}],"kind":"container"},{"kind":"text","text":"\". Print the answers for the edges in the order in which the edges are specified in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n1 2 101\n1 3 100\n2 3 2\n2 4 2\n3 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"none\nany\nat least one\nat least one\nany\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2 1\n2 3 1\n1 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"any\nany\nnone\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2 1\n2 3 1\n1 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"at least one\nat least one\nat least one\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second sample the MST is unique for the given graph: it contains two first edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample any two edges form the MST for the given graph. That means that each edge is included at least in one MST."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"160D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/160/problem/D"}