{"assets":[],"contentKind":"statement","contestId":"1512","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Corrupted Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a number $$$n$$$ and an array $$$b_1, b_2, \\ldots, b_{n+2}$$$, obtained according to the following algorithm: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" some array $$$a_1, a_2, \\ldots, a_n$$$ was guessed; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" array $$$a$$$ was written to array $$$b$$$, i.e. $$$b_i = a_i$$$ ($$$1 \\le i \\le n$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The $$$(n+1)$$$-th element of the array $$$b$$$ is the sum of the numbers in the array $$$a$$$, i.e. $$$b_{n+1} = a_1+a_2+\\ldots+a_n$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The $$$(n+2)$$$-th element of the array $$$b$$$ was written some number $$$x$$$ ($$$1 \\le x \\le 10^9$$$), i.e. $$$b_{n+2} = x$$$; The "}],"kind":"list_item"},{"children":[{"kind":"text","text":" array $$$b$$$ was shuffled. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, the array $$$b=[2, 3, 7, 12 ,2]$$$ it could be obtained in the following ways: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a=[2, 2, 3]$$$ and $$$x=12$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a=[3, 2, 7]$$$ and $$$x=2$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For the given array $$$b$$$, find any array $$$a$$$ that could have been guessed initially."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$). Then $$$t$$$ test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second row of each test case contains $$$n+2$$$ integers $$$b_1, b_2, \\ldots, b_{n+2}$$$ ($$$1 \\le b_i \\le 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\", if the array $$$b$$$ could not be obtained from any array $$$a$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$, otherwise. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there are several arrays of $$$a$$$, you can output any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind"