{"assets":[],"contentKind":"statement","contestId":"981","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Bookshelves"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mr Keks is a typical white-collar in Byteland."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He has a bookshelf in his office with some books on it, each book has an integer positive price."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mr Keks defines the value of a shelf as the sum of books prices on it. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Miraculously, Mr Keks was promoted and now he is moving into a new office."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He learned that in the new office he will have not a single bookshelf, but exactly $$$k$$$ bookshelves. He decided that the beauty of the $$$k$$$ shelves is the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#AND"},"children":[{"kind":"text","text":"bitwise AND"}],"kind":"link"},{"kind":"text","text":" of the values of all the shelves."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He also decided that he won't spend time on reordering the books, so he will place several first books on the first shelf, several next books on the next shelf and so on. Of course, he will place at least one book on each shelf. This way he will put all his books on $$$k$$$ shelves in such a way that the beauty of the shelves is as large as possible. Compute this maximum possible beauty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\leq k \\leq n \\leq 50$$$) — the number of books and the number of shelves in the new office."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\ldots a_n$$$, ($$$0 \\lt a_i \\lt 2^{50}$$$) — the prices of the books in the order they stand on the old shelf."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum possible beauty of $$$k$$$ shelves in the new office."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 4\n9 14 28 1 7 13 15 29 2 31\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"24\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 3\n3 14 15 92 65 35 89\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"64\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example you can split the books as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$(9 + 14 + 28 + 1 + 7) \\& (13 + 15) \\& (29 + 2) \\& (31) = 24.$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example you can split the books as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$(3 + 14 + 15 + 92) \\& (65) \\& (35 + 89) = 64.$$$$$$"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"981D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/981/problem/D"}