{"assets":[],"contentKind":"statement","contestId":"2225","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. A Number Between Two Others"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two integers $$$x$$$ and $$$y$$$ such that $$$y \\gt x$$$ and $$$y \\bmod x = 0$$$ (that is, $$$y$$$ is divisible by $$$x$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine whether there exists an integer $$$z$$$ such that"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$z$$$ lies between $$$x$$$ and $$$y$$$ (that is, $$$x \\lt z \\lt y$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$z$$$ is divisible by $$$x$$$ (that is, $$$z \\bmod x = 0$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$y$$$ is not divisible by $$$z$$$ (that is, $$$y \\bmod z \\ne 0$$$). "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of a single line containing two integers $$$x$$$ and $$$y$$$ ($$$1 \\le x \\lt y \\le 10^{18}$$$; $$$y \\bmod x = 0$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the answer as follows: if the required number $$$z$$$ exists, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"; otherwise, print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":". You may print each letter in any case."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 2\n1 3\n1234567890 12345678900\n2 8\n7 84\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\nYES\nYES\nYES\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second test case of the example, you can use $$$z = 2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case of the example, you can use $$$z = 7407407340$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2225A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2225/problem/A"}