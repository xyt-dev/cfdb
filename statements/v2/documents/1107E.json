{"assets":[],"contentKind":"statement","contestId":"1107","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Vasya and Binary String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya has a string $$$s$$$ of length $$$n$$$ consisting only of digits "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". Also he has an array $$$a$$$ of length $$$n$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya performs the following operation until the string becomes empty: choose some "},{"children":[{"kind":"text","text":"consecutive"}],"kind":"container"},{"kind":"text","text":" substring of "},{"children":[{"kind":"text","text":"equal characters"}],"kind":"container"},{"kind":"text","text":", erase it from the string and glue together the remaining parts (any of them can be empty). For example, if he erases substring "},{"children":[{"kind":"text","text":"111"}],"kind":"container"},{"kind":"text","text":" from string "},{"children":[{"kind":"text","text":"1"},{"children":[{"kind":"text","text":"111"}],"kind":"container"},{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" he will get the string "},{"children":[{"kind":"text","text":"110"}],"kind":"container"},{"kind":"text","text":". Vasya gets $$$a_x$$$ points for erasing substring of length $$$x$$$."}],"kind":"paragraph"},{"children":[{"kind