{"assets":["/statement-assets/1d21b63b696ee21102146d35c95afe4a90fa8e7464ce4ca9ac8c8116bd6ea351.png"],"contentKind":"statement","contestId":"275","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Convex Shape"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" grid. Initially all the cells of the grid are colored white. Lenny has painted some of the cells (at least one) black. We call a painted grid "},{"children":[{"kind":"text","text":"convex"}],"kind":"container"},{"kind":"text","text":" if one can walk from "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" black cell to "},{"children":[{"kind":"text","text":"any another"}],"kind":"container"},{"kind":"text","text":" black cell using a path of side-adjacent black cells changing his direction at most once during the path. In the figure below, the left grid is convex while the right one is not convex, because there exist two cells which need more than one time to change direction in their path."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1d21b63b696ee21102146d35c95afe4a90fa8e7464ce4ca9ac8c8116bd6ea351.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"You're given a painted grid in the input. Tell Lenny if the grid is convex or not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 50)"},{"kind":"text","text":" — the size of the grid. Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"\". Character \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\" denotes a black cell of the grid and \""},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"\" denotes a white cell of the grid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the grid has at least one black cell."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the only line of the output print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if the grid is convex, otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\". Do not print quotes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\nWWBW\nBWWW\nWWWB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\nB\nB\nW\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"275B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/275/problem/B"}