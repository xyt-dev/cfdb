{"assets":[],"contentKind":"statement","contestId":"770","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Draw Brackets!"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A sequence of square brackets is regular if by inserting symbols \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" into it, you can get a regular mathematical expression from it. For example, sequences \""},{"children":[{"kind":"text","text":"[[]][]"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"[]"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"[[][[]]]"}],"kind":"container"},{"kind":"text","text":"\" — are regular, at the same time \""},{"children":[{"kind":"text","text":"]["}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"[[]"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"[[]]]["}],"kind":"container"},{"kind":"text","text":"\" — are irregular. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Draw the given sequence using a minimalistic pseudographics in the strip of the lowest possible height — use symbols '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"|"}],"kind":"container"},{"kind":"text","text":"'. For example, the sequence \""},{"children":[{"kind":"text","text":"[[][]][]"}],"kind":"container"},{"kind":"text","text":"\" should be represented as: "}],"kind":"paragraph"},{"kind":"code_block","text":"\n+-        -++- -+    \n|+- -++- -+||   |\n||   ||   |||   |\n|+- -++- -+||   |\n+-        -++- -+\n"},{"children":[{"kind":"text","text":"Each bracket should be represented with the hepl of one or more symbols '"},{"children":[{"kind":"text","text":"|"}],"kind":"container"},{"kind":"text","text":"' (the vertical part) and symbols '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"' as on the example which is given above."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Brackets should be drawn without spaces one by one, only dividing pairs of consecutive pairwise brackets with a single-space bar (so that the two brackets do not visually merge into one symbol). The image should have the minimum possible height. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The enclosed bracket is always smaller than the surrounding bracket, but each bracket separately strives to maximize the height of the image. So the pair of final brackets in the example above occupies the entire height of the image."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Study carefully the examples below, they adequately explain the condition of the problem. Pay attention that in this problem the answer (the image) is unique. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an even integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100"},{"kind":"text","text":") — the length of the sequence of brackets."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the sequence of brackets — these are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" symbols \""},{"children":[{"kind":"text","text":"["}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"]"}],"kind":"container"},{"kind":"text","text":"\". It is guaranteed that the given sequence of brackets is regular. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the drawn bracket sequence in the format which is given in the condition. Don't print extra (unnecessary) spaces. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n[[][]][]\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"+-        -++- -+\n|+- -++- -+||   |\n||   ||   |||   |\n|+- -++- -+||   |\n+-        -++- -+\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n[[[]]]\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"+-     -+\n|+-   -+|\n||+- -+||\n|||   |||\n||+- -+||\n|+-   -+|\n+-     -+\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n[[][]]\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"+-        -+\n|+- -++- -+|\n||   ||   ||\n|+- -++- -+|\n+-        -+\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n[]\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"+- -+\n|   |\n+- -+\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n[][]\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"+- -++- -+\n|   ||   |\n+- -++- -+\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"770D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/770/problem/D"}