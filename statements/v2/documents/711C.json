{"assets":[],"contentKind":"statement","contestId":"711","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Coloring Trees"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"ZS the Coder and Chris the Baboon has arrived at Udayland! They walked in the park where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" trees grow. They decided to be naughty and color the trees in the park. The trees are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially, tree "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has color "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":". ZS the Coder and Chris the Baboon recognizes only "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" different colors, so "},{"kind":"math_inline","text":"0 ≤ ci ≤ m"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ci = 0"},{"kind":"text","text":" means that tree "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"uncolored"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"ZS the Coder and Chris the Baboon decides to color only the uncolored trees, i.e. the trees with "},{"kind":"math_inline","text":"ci = 0"},{"kind":"text","text":". They can color each of them them in any of the "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" colors from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Coloring the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th tree with color "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" requires exactly "},{"kind":"math_inline","text":"pi, j"},{"kind":"text","text":" litres of paint."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The two friends define the "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" of a coloring of the trees as the "},{"children":[{"kind":"text","text":"minimum"}],"kind":"container"},{"kind":"text","text":" number of contiguous groups (each group contains some subsegment of trees) you can split all the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" trees into so that each group contains trees of the same color. For example, if the colors of the trees from left to right are "},{"kind":"math_inline","text":"2, 1, 1, 1, 3, 2, 2, 3, 1, 3"},{"kind":"text","text":", the beauty of the coloring is "},{"kind":"math_inline","text":"7"},{"kind":"text","text":", since we can partition the trees into "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" contiguous groups of the same color : "},{"kind":"math_inline","text":"{2}, {1, 1, 1}, {3}, {2, 2}, {3}, {1}, {3}"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"ZS the Coder and Chris the Baboon wants to color all uncolored trees so that the beauty of the coloring is "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"math_inline","text":"k"},{"kind":"text","text":". They need your help to determine the minimum amount of paint (in litres) needed to finish the job."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please note that the friends can't color the trees that are already colored."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 100"},{"kind":"text","text":") — the number of trees, number of colors and beauty of the resulting coloring respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ci ≤ m"},{"kind":"text","text":"), the initial colors of the trees. "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" equals to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" if the tree number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is uncolored, otherwise the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th tree has color "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow. Each of them contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th number on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them line denotes "},{"kind":"math_inline","text":"pi, j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi, j ≤ 109"},{"kind":"text","text":") — the amount of litres the friends need to color "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th tree with color "},{"kind":"math_inline","text":"j"},{"kind":"text","text":". "},{"kind":"math_inline","text":"pi, j"},{"kind":"text","text":"'s are specified even for the initially colored trees, but such trees still can't be colored."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer, the minimum amount of paint needed to color the trees. If there are no valid tree colorings of beauty "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", print "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 2\n0 0 0\n1 2\n3 4\n5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 2\n2 1 2\n1 3\n2 4\n3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 2\n2 0 0\n1 3\n2 4\n3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 3\n2 1 2\n1 3\n2 4\n3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case, coloring the trees with colors "},{"kind":"math_inline","text":"2, 1, 1"},{"kind":"text","text":" minimizes the amount of paint used, which equals to "},{"kind":"math_inline","text":"2 + 3 + 5 = 10"},{"kind":"text","text":". Note that "},{"kind":"math_inline","text":"1, 1, 1"},{"kind":"text","text":" would not be valid because the beauty of such coloring equals to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"{1, 1, 1}"},{"kind":"text","text":" is a way to group the trees into a single group of the same color)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample case, all the trees are colored, but the beauty of the coloring is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", so there is no valid coloring, and the answer is "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the last sample case, all the trees are colored and the beauty of the coloring matches "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", so no paint is used and the answer is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"711C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/711/problem/C"}