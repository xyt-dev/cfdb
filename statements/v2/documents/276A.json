{"assets":[],"contentKind":"statement","contestId":"276","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Lunch Rush"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Having written another programming contest, three Rabbits decided to grab some lunch. The coach gave the team exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" time units for the lunch break."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Rabbits have a list of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" restaurants to lunch in: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th restaurant is characterized by two integers "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":". Value "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" shows the time the Rabbits need to lunch in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th restaurant. If time "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" exceeds the time "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" that the coach has given for the lunch break, then the Rabbits' joy from lunching in this restaurant will equal "},{"kind":"math_inline","text":"fi - (ti - k)"},{"kind":"text","text":". Otherwise, the Rabbits get exactly "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":" units of joy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the value of the maximum joy the Rabbits can get from the lunch, depending on the restaurant. The Rabbits must choose "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" one restaurant to lunch in. Note that the joy value isn't necessarily a positive value. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers — "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 104"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 109"},{"kind":"text","text":") — the number of restaurants in the Rabbits' list and the time the coach has given them to lunch, correspondingly. Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two space-separated integers — "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ fi ≤ 109"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 109"},{"kind":"text","text":") — the characteristics of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th restaurant."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print a single integer — the maximum joy value that the Rabbits will get from the lunch. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 5\n3 3\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 6\n5 8\n3 6\n2 3\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 5\n1 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"276A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/276/problem/A"}