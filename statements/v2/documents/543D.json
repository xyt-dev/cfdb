{"assets":[],"contentKind":"statement","contestId":"543","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Road Improvement"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The country has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities and "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" bidirectional roads, it is possible to get from every city to any other one if you move only along the roads. The cities are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" inclusive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the roads are initially bad, but the government wants to improve the state of some roads. We will assume that the citizens are happy about road improvement if the path from the capital located in city "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to any other city contains at most one bad road."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is — for every possible "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" determine the number of ways of improving the quality of some roads in order to meet the citizens' condition. As those values can be rather large, you need to print each value modulo "},{"kind":"math_inline","text":"1 000 000 007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],