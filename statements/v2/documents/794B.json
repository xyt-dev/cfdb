{"assets":["/statement-assets/8f6cc4913e23a5024b854849f59cb25f25afd5c9c9370e3d469433a774aa3adc.png","/statement-assets/af572790d886b5de9e6a69678560f5b9ffb802b8d91d49716b2f7199c5afce2c.png"],"contentKind":"statement","contestId":"794","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Cutting Carrot"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Igor the analyst has adopted "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" little bunnies. As we all know, bunnies love carrots. Thus, Igor has bought a carrot to be shared between his bunnies. Igor wants to treat all the bunnies equally, and thus he wants to cut the carrot into "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pieces of equal area. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, the carrot can be viewed as an isosceles triangle with base length equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and height equal to "},{"kind":"math_inline","text":"h"},{"kind":"text","text":". Igor wants to make "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" cuts "},{"children":[{"kind":"text","text":"parallel to the base"}],"kind":"container"},{"kind":"text","text":" to cut the carrot into "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pieces. He wants to make sure that all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pieces have the same area. Can you help Igor determine where to cut the carrot so that each piece have equal area?"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/8f6cc4913e23a5024b854849f59cb25f25afd5c9c9370e3d469433a774aa3adc.png"},"kind":"image"},{"children":[{"kind":"text","text":"Illustration to the first example."}],"kind":"container"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and only line of input contains two space-separated integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ h ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The output should contain "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" real numbers "},{"kind":"math_inline","text":"x1, x2, ..., xn - 1"},{"kind":"text","text":". The number "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" denotes that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th cut must be made "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" units away from the apex of the carrot. In addition, "},{"kind":"math_inline","text":"0 < x1 < x2 < ... < xn - 1 < h"},{"kind":"text","text":" must hold. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your output will be considered correct if absolute or relative error of every number in your output doesn't exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, let your answer be "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and the jury's answer be "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Your answer is considered correct if "},{"attrs":{"alt":"","src":"/statement-assets/af572790d886b5de9e6a69678560f5b9ffb802b8d91d49716b2f7199c5afce2c.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.154700538379 1.632993161855\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 100000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"70710.678118654752\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Definition of isosceles triangle: "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Isosceles_triangle"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Isosceles_triangle"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"794B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/794/problem/B"}