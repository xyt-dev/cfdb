{"assets":[],"contentKind":"statement","contestId":"724","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Goods transportation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities located along the one-way road. Cities are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in the direction of the road."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th city had produced "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" units of goods. No more than "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" units of goods can be sold in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th city."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each pair of cities "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" such that "},{"children":[{"kind":"math_inline","text":"1 ≤ i < j ≤ n"}],"kind":"container"},{"kind":"text","text":" you can "},{"children":[{"kind":"text","text":"no more than once"}],"kind":"container"},{"kind":"text","text":" transport "},{"children":[{"kind":"text","text":"no more than"}],"kind":"container"},{"kind":"math_inline","text":"c"},{"kind":"text","text":" units of goods from the city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to the city "},{"kind":"math_inline","text":"j"},{"kind":"text","text":". Note that goods can only be transported from a city with a lesser index to the city with a larger index. "},{"children":[{"kind":"text","text":"You can transport goods between cities in any order."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the maximum number of produced goods that can be sold in total in all the cities after a sequence of transportations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ c ≤ 109"},{"kind":"text","text":") — the number of cities and the maximum amount of goods for a single transportation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ pi ≤ 109"},{"kind":"text","text":") — the number of units of goods that were produced in each city."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line of input contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ si ≤ 109"},{"kind":"text","text":") — the number of units of goods that can be sold in each city."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"c