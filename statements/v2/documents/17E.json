{"assets":[],"contentKind":"statement","contestId":"17","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Palisection"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"128 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In an English class Nick had nothing to do at all, and remembered about wonderful strings called "},{"children":[{"kind":"text","text":"palindromes"}],"kind":"container"},{"kind":"text","text":". We should remind you that a string is called a palindrome if it can be read the same way both from left to right and from right to left. Here are examples of such strings: «"},{"children":[{"kind":"text","text":"eye"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"pop"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"level"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"deed"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"racecar"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"rotor"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"madam"}],"kind":"container"},{"kind":"text","text":"». "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nick started to look carefully for all palindromes in the text that they were reading in the class. For each occurrence of each palindrome in the text he wrote a pair — the position of the beginning and the position of the ending of this occurrence in the text. Nick called each occurrence of each palindrome he found in the text "},{"children":[{"kind":"text","text":"subpalindrome"}],"kind":"container"},{"kind":"text","text":". When he found all the subpalindromes, he decided to find out how many different pairs among these subpalindromes cross. Two subpalindromes cross if they cover common positions in the text. No palindrome can cross itself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's look at the actions, performed by Nick, by the example of text «"},{"children":[{"kind":"text","text":"babb"}],"kind":"container"},{"kind":"text","text":"». At first he wrote out all subpalindromes:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"• «"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"» — "},{"kind":"math_inline","text":"1..1"}],"kind":"container"},{"children":[{"kind":"text","text":"• «"},{"children":[{"kind":"text","text":"bab"}],"kind":"container"},{"kind":"text","text":"» — "},{"kind":"math_inline","text":"1..3"}],"kind":"container"},{"children":[{"kind":"text","text":"• «"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"» — "},{"kind":"math_inline","text":"2..2"}],"kind":"container"},{"children":[{"kind":"text","text":"• «"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"» — "},{"kind":"math_inline","text":"3..3"}],"kind":"container"},{"children":[{"kind":"text","text":"• «"},{"children":[{"kind":"text","text":"bb"}],"kind":"container"},{"kind":"text","text":"» — "},{"kind":"math_inline","text":"3..4"}],"kind":"container"},{"children":[{"kind":"text","text":"• «"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"» — "},{"kind":"math_inline","text":"4..4"}],"kind":"container"},{"children":[{"kind":"text","text":"Then Nick counted the amount of different pairs among these subpalindromes that cross. These pairs were six:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"1."}],"kind":"container"},{"kind":"math_inline","text":"1..1"},{"kind":"text","text":" cross with "},{"kind":"math_inline","text":"1..3"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"2."}],"kind":"container"},{"kind":"math_inline","text":"1..3"},{"kind":"text","text":" cross with "},{"kind":"math_inline","text":"2..2"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"3."}],"kind":"container"},{"kind":"math_inline","text":"1..3"},{"kind":"text","text":" cross with "},{"kind":"math_inline","text":"3..3"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"4."}],"kind":"container"},{"kind":"math_inline","text":"1..3"},{"kind":"text","text":" cross with "},{"kind":"math_inline","text":"3..4"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"5."}],"kind":"container"},{"kind":"math_inline","text":"3..3"},{"kind":"text","text":" cross with "},{"kind":"math_inline","text":"3..4"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"6."}],"kind":"container"},{"kind":"math_inline","text":"3..4"},{"kind":"text","text":" cross with "},{"kind":"math_inline","text":"4..4"}],"kind":"container"},{"children":[{"kind":"text","text":"Since it's very exhausting to perform all the described actions manually, Nick asked you to help him and write a program that can find out the amount of different subpalindrome pairs that cross. Two subpalindrome pairs are regarded as different if one of the pairs contains a subpalindrome that the other does not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·106"},{"kind":"text","text":") — length of the text. The following line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lower-case Latin letters (from "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line output the amount of different pairs of two subpalindromes that cross each other. Output the answer modulo "},{"kind":"math_inline","text":"51123987"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nbabb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\naa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"17E","schema":2,"sourceKind":"html","sourceUrl":"https://