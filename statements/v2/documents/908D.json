uences that form '"},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"'. Determine the expected number of times '"},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"' is a subsequence in the resulting sequence. It can be shown that this can be represented by "},{"kind":"math_inline","text":"P / Q"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"P"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Q"},{"kind":"text","text":" are coprime integers, and "},{"attrs":{"alt":"","src":"/statement-assets/6f500418ddb4f4e3d7f21929678a73cef78644c09460199339f270e9648fcd6c.png"},"kind":"image"},{"kind":"text","text":". Print the value of "},{"attrs":{"alt":"","src":"/statement-assets/7cff519664f05e40d62386ecb5db8d1c50bb9480590cad207da0fe8e4dc90d59.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line will contain three integers integer "},{"kind":"math_inline","text":"k, pa, pb"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 1 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ pa, pb ≤ 1 000 000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer, the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"370000006\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first sample, we will keep appending to our sequence until we get the subsequence '"},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"' at least once. For instance, we get the sequence '"},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"' with probability 1/4, '"},{"children":[{"kind":"text","text":"bbab"}],"kind":"container"},{"kind":"text","text":"' with probability 1/16, and '"},{"children":[{"kind":"text","text":"aab"}],"kind":"container"},{"kind":"text","text":"' with probability 1/8. Note, it's impossible for us to end with a sequence like '"},{"children":[{"kind":"text","text":"aabab"}],"kind":"container"},{"kind":"text","text":"', since we would have stopped our algorithm once we had the prefix '"},{"children":[{"kind":"text","text":"aab"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The expected amount of times that '"},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"' will occur across all valid sequences is 2. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second sample, the answer is equal to "},{"attrs":{"alt":"","src":"/statement-assets/28f95163163932960541dd5f62cfc00b7e6f7dd9a9dbf41672c83b340cbf24dd.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"908D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/908/problem/D"}