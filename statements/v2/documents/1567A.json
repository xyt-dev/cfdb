{"assets":["/statement-assets/43d19941845f2ec534ff1e68251c9f3802c85020be195ace67eabd092c8452fc.png","/statement-assets/5eb2a6a8e49ace1d17b0f1ff12acb66db2a9becf425e53af1ae5e79a3665609e.png","/statement-assets/782efceda7bce5d65d5fedf84867508b325fa27e2ca121d9bdb0824d23167212.png","/statement-assets/3985b62bb76a259536fd357e91532de0fc4b29edc3fbbcf0edbaf5a0ff5d3157.png"],"contentKind":"statement","contestId":"1567","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Domino Disaster"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Alice has a grid with $$$2$$$ rows and $$$n$$$ columns. She fully covers the grid using $$$n$$$ dominoes of size $$$1 \\times 2$$$ — Alice may place them vertically or horizontally, and each cell should be covered by exactly one domino."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, she decided to show one row of the grid to Bob. Help Bob and figure out what the other row of the grid looks like!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of multiple test cases. The first line contains an integer $$$t$$$ ($$$1 \\leq t \\leq 5000$$$) — the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains an integer $$$n$$$ ($$$1 \\leq n \\leq 100$$$) — the width of the grid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$s$$$ consisting of $$$n$$$ characters, each of which is either "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":", or "},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":", representing the left, right, top, or bottom half of a domino, respectively (see notes for better understanding). This string represents one of the rows of the grid. "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Additional constraint on the input:"}],"kind":"container"},{"kind":"text","text":" each input corresponds to at least one valid tiling."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output one string — the other row of the grid, using the same format as the input string. If there are multiple answers, print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1\nU\n2\nLR\n5\nLRDLR\n6\nUUUUUU\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nD\nLR\nLRULR\nDDDDDD\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, Alice shows Bob the "},{"children":[{"kind":"text","text":"top"}],"kind":"container"},{"kind":"text","text":" row, the whole grid may look like: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/43d19941845f2ec534ff1e68251c9f3802c85020be195ace67eabd092c8452fc.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second test case, Alice shows Bob the "},{"children":[{"kind":"text","text":"bottom"}],"kind":"container"},{"kind":"text","text":" row, the whole grid may look like: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5eb2a6a8e49ace1d17b0f1ff12acb66db2a9becf425e53af1ae5e79a3665609e.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the third test case, Alice shows Bob the "},{"children":[{"kind":"text","text":"bottom"}],"kind":"container"},{"kind":"text","text":" row, the whole grid may look like: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/782efceda7bce5d65d5fedf84867508b325fa27e2ca121d9bdb0824d23167212.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the fourth test case, Alice shows Bob the "},{"children":[{"kind":"text","text":"top"}],"kind":"container"},{"kind":"text","text":" row, the whole grid may look like: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/3985b62bb76a259536fd357e91532de0fc4b29edc3fbbcf0edbaf5a0ff5d3157.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1567A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1567/problem/A"}