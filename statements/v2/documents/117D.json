xt","text":", "},{"kind":"math_inline","text":"F(a) = F(odd) + F(even)"},{"kind":"text","text":", where operation \""},{"kind":"math_inline","text":" + "},{"kind":"text","text":"\" stands for the arrays' concatenation (joining together) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if "},{"kind":"math_inline","text":"n = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"F(a) = a"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" be an array consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers "},{"kind":"math_inline","text":"1, 2, 3, ..., n"},{"kind":"text","text":". Then "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is the result of applying the transformation to the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" (so "},{"kind":"math_inline","text":"b = F(a)"},{"kind":"text","text":"). You are given "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries "},{"kind":"math_inline","text":"(l, r, u, v)"},{"kind":"text","text":". Your task is to find for each query the sum of numbers "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"l ≤ i ≤ r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u ≤ bi ≤ v"},{"kind":"text","text":". You should print the query results modulo "},{"kind":"math_inline","text":"mod"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"mod"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1018, 1 ≤ m ≤ 105, 1 ≤ mod ≤ 109"},{"kind":"text","text":"). Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines describe the queries. Each query is defined by four integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ u ≤ v ≤ 1018"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specificator to read or write 64-bit integers in C++. Use "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specificator."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines each containing an integer — remainder modulo "},{"kind":"math_inline","text":"mod"},{"kind":"text","text":" of the query result."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5 10000\n2 3 4 5\n2 4 1 3\n1 2 2 4\n2 3 3 5\n1 3 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n5\n3\n3\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 5 10000\n1 2 2 2\n1 1 4 5\n1 1 2 5\n1 1 1 3\n1 2 5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n0\n0\n1\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's consider the first example. First let's construct an array "},{"kind":"math_inline","text":"b = F(a) = F([1, 2, 3, 4])"},{"kind":"text","text":". "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Step 1. "},{"kind":"math_inline","text":"F([1, 2, 3, 4]) = F([1, 3]) + F([2, 4])"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Step 2. "},{"kind":"math_inline","text":"F([1, 3]) = F([1]) + F([3]) = [1] + [3] = [1, 3]"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Step 3. "},{"kind":"math_inline","text":"F([2, 4]) = F([2]) + F([4]) = [2] + [4] = [2, 4]"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Step 4. "},{"kind":"math_inline","text":"b = F([1, 2, 3, 4]) = F([1, 3]) + F([2, 4]) = [1, 3] + [2, 4] = [1, 3, 2, 4]"}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" Thus "},{"kind":"math_inline","text":"b = [1, 3, 2, 4]"},{"kind":"text","text":". Let's consider the first query "},{"kind":"math_inline","text":"l = 2, r = 3, u = 4, v = 5"},{"kind":"text","text":". The second and third positions in the array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" do not have numbers in the range "},{"kind":"math_inline","text":"[4, 5]"},{"kind":"text","text":", so the sum obviously equals zero. Let's consider the second query "},{"kind":"math_inline","text":"l = 2, r = 4, u = 1, v = 3"},{"kind":"text","text":". The second and third positions have two numbers that belong to the range "},{"kind":"math_inline","text":"[1, 3]"},{"kind":"text","text":", their sum equals 5."}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"117D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/117/problem/D"}