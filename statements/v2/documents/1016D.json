{"assets":[],"contentKind":"statement","contestId":"1016","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Vasya And The Matrix"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Now Vasya is taking an exam in mathematics. In order to get a good mark, Vasya needs to guess the matrix that the teacher has constructed!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya knows that the matrix consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" columns. For each row, he knows the xor (bitwise excluding or) of the elements in this row. The sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" denotes the xor of elements in rows with indices "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", respectively. Similarly, for each column, he knows the xor of the elements in this column. The sequence "},{"kind":"math_inline","text":"b1, b2, ..., bm"},{"kind":"text","text":" denotes the xor of elements in columns with indices "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Vasya! Find a matrix satisfying the given constraints or tell him that there is no suitable matrix."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m (2 ≤ n, m ≤ 100)"},{"kind":"text","text":" — the dimensions of the matrix."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers "},{"kind":"math_inline","text":"a1, a2, ..., an (0 ≤ ai ≤ 109)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the xor of all elements in row "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" numbers "},{"kind":"math_inline","text":"b1, b2, ..., bm (0 ≤ bi ≤ 109)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is the xor of all elements in column "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no matrix satisfying the given constraints in the first line, output \"NO\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, on the first line output \"YES\", and then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" numbers in each "},{"kind":"math_inline","text":"ci1, ci2, ... , cim (0 ≤ cij ≤ 2·109)"},{"kind":"text","text":" — the description of the matrix."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several suitable matrices, it is allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n2 9\n5 3 13\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n3 4 5\n6 7 8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 7 6\n2 15 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1016D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1016/problem/D"}