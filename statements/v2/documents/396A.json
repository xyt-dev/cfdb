{"assets":["/statement-assets/b2765cfc916c2a075bc338af5171014f5d169711381a79f13c17aa0e1a0406dc.png","/statement-assets/ecc2f80dc19578e5eb5f89847344f0251c05e5660151c8e8db686f6ed5f09b5d.png"],"contentKind":"statement","contestId":"396","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. On Number of Decompositions into Multipliers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" as a product of integers "},{"kind":"math_inline","text":"a1, a2, ... an"},{"attrs":{"alt":"","src":"/statement-assets/b2765cfc916c2a075bc338af5171014f5d169711381a79f13c17aa0e1a0406dc.png"},"kind":"image"},{"kind":"text","text":". Your task is to find the number of distinct decompositions of number "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" into the product of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ordered positive integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Decomposition into "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" products, given in the input, must also be considered in the answer. As the answer can be very large, print it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 500"},{"kind":"text","text":"). The second line contains space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print a single number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of distinct decompositions of number "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ordered multipliers modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n5 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second sample, the get a decomposition of number 2, you need any one number out of three to equal 2, and the rest to equal 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, the possible ways of decomposing into ordered multipliers are [7,5], [5,7], [1,35], [35,1]."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A decomposition of positive integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ordered multipliers is a cortege of positive integers "},{"kind":"math_inline","text":"b = {b1, b2, ... bn}"},{"kind":"text","text":" such that "},{"attrs":{"alt":"","src":"/statement-assets/ecc2f80dc19578e5eb5f89847344f0251c05e5660151c8e8db686f6ed5f09b5d.png"},"kind":"image"},{"kind":"text","text":". Two decompositions "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" are considered different, if there exists index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"bi ≠ ci"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"396A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/396/problem/A"}