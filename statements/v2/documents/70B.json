{"assets":[],"contentKind":"statement","contestId":"70","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Text Messaging"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Fangy the little walrus, as all the modern walruses, loves to communicate via text messaging. One day he faced the following problem: When he sends large texts, they are split into parts each containing "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters (which is the size of one text message). Thus, whole sentences and words get split!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Fangy did not like it, so he faced the task of breaking the text into minimal messages on his own so that no sentence were broken into pieces when it is sent and the number of text messages to be sent would be minimal. If two consecutive sentences are in different messages, the space between them can be ignored (Fangy does not write this space)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The little walrus's text looks in the following manner: "}],"kind":"paragraph"},{"kind":"code_block","text":"TEXT ::= SENTENCE | SENTENCE SPACE TEXT\nSENTENCE ::= WORD SPACE SENTENCE | WORD END\nEND ::= {'.', '?', '!'}\nWORD ::= LETTER | LETTER WORD\nLETTER ::= {'a'..'z', 'A'..'Z'}\nSPACE ::= ' '\n"},{"children":[{"kind":"text","text":"SPACE stands for the symbol of a space."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, how many messages did Fangy send?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", which is the size of one message ("},{"kind":"math_inline","text":"2 ≤ n ≤ 255"},{"kind":"text","text":"). The second line contains the text. The length of the text does not exceed "},{"kind":"math_inline","text":"104"},{"kind":"text","text":" characters. It is guaranteed that the text satisfies the above described format. Specifically, this implies that the text is not empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first and only line print the number of text messages Fangy will need. If it is impossible to split the text, print \""},{"children":[{"kind":"text","text":"Impossible"}],"kind":"container"},{"kind":"text","text":"\" without the quotes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"25\nHello. I am a little walrus.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\nHow are you?\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Impossible\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"19\nHello! Do you like fish? Why?\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's take a look at the third sample. The text will be split into three messages: \""},{"children":[{"kind":"text","text":"Hello!"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Do you like fish?"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"Why?"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"70B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/70/problem/B"}