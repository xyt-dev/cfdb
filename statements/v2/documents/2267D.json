{"assets":[],"contentKind":"statement","contestId":"2267","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Backrooms Hill"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"Among the people from the city "},{"children":[{"kind":"text","text":"GR"}],"kind":"container"},{"kind":"text","text":", there is a legend about a hill that leads to the backstage. An array $$$b$$$ consisting of $$$m$$$ integers is called a "},{"children":[{"kind":"text","text":"hill"}],"kind":"container"},{"kind":"text","text":" if there exists an index $$$k$$$ ($$$1\\le k\\le m$$$) such that the following conditions hold:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The first $$$k$$$ elements are strictly increasing. Formally, for all $$$i$$$ ($$$1\\le i\\lt k$$$), $$$b_i\\lt b_{i+1}$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The last $$$m-k+1$$$ elements are strictly decreasing. Formally, for all $$$i$$$ ($$$k\\le i\\lt m$$$), $$$b_i\\gt b_{i+1}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given an array $$$a$$$ consisting of $$$n$$$ "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" integers. You may perform the following operation any number of times:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose any index $$$i$$$ ($$$1\\le i\\le n-2$$$). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Swap $$$a_i$$$ and $$$a_{i+2}$$$ in the array. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is to determine whether it is possible to turn array $$$a$$$ into a "},{"children":[{"kind":"text","text":"hill"}],"kind":"container"},{"kind":"text","text":" by performing the operation any number of times."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains an integer $$$n$$$ ($$$1\\le n\\le 2\\cdot 10^5$$$) — the length of array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1\\le a_i\\le n$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2\\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if it is possible to make array $$$a$$$ a "},{"children":[{"kind":"text","text":"hill"}],"kind":"container"},{"kind":"text","text":". Otherwise, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may print each letter in any case (lowercase or uppercase). For example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be accepted as positive answers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n3\n2 1 3\n4\n1 2 3 4\n6\n5 3 4 6 2 1\n6\n1 5 2 3 6 4\n7\n1 2 3 4 7 5 6\n5\n5 4 1 3 2\n6\n4 1 3 2 6 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\nYES\nYES\nNO\nNO\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, it is impossible to turn array $$$a$$$ into a "},{"children":[{"kind":"text","text":"hill"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, array $$$a$$$ is already a "},{"children":[{"kind":"text","text":"hill"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, you can perform the operations as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"c