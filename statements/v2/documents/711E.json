{"assets":["/statement-assets/fab6021d8688c21c29de59e7bcf23bca35440066a140a3ec2144341561133383.png","/statement-assets/7c4a956d06a802a7ada9fbb11cfec60f85c8170ab8ba861ece6cd3460f99aca7.png","/statement-assets/9f49bad3f2d1cd6e186770f994d62446d3184faddf1fa21db219beba3d75a10d.png"],"contentKind":"statement","contestId":"711","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. ZS and The Birthday Paradox"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"ZS the Coder has recently found an interesting concept called the Birthday Paradox. It states that given a random set of "},{"kind":"math_inline","text":"23"},{"kind":"text","text":" people, there is around "},{"kind":"math_inline","text":"50%"},{"kind":"text","text":" chance that some two of them share the same birthday. ZS the Coder finds this very interesting, and decides to test this with the inhabitants of Udayland."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In Udayland, there are "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" days in a year. ZS the Coder wants to interview "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" people from Udayland, each of them has birthday in one of "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" days (each day with equal probability). He is interested in the probability of at least two of them have the birthday at the same day. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"ZS the Coder knows that the answer can be written as an irreducible fraction "},{"attrs":{"alt":"","src":"/statement-assets/fab6021d8688c21c29de59e7bcf23bca35440066a140a3ec2144341561133383.png"},"kind":"image"},{"kind":"text","text":". He wants to find the values of "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" (he does not like to deal with floating point numbers). Can you help him?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and only line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n ≤ 1018, 2 ≤ k ≤ 1018)"},{"kind":"text","text":", meaning that there are "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" days in a year and that ZS the Coder wants to interview exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" people."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the probability of at least two "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" people having the same birthday in "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" days long year equals "},{"attrs":{"alt":"","src":"/statement-assets/fab6021d8688c21c29de59e7bcf23bca35440066a140a3ec2144341561133383.png"},"kind":"image"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"A ≥ 0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"B ≥ 1"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/7c4a956d06a802a7ada9fbb11cfec60f85c8170ab8ba861ece6cd3460f99aca7.png"},"kind":"image"},{"kind":"text","text":"), print the "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" in a single line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since these numbers may be too large, print them modulo "},{"kind":"math_inline","text":"106 + 3"},{"kind":"text","text":". Note that "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" must be coprime "},{"children":[{"kind":"text","text":"before"}],"kind":"container"},{"kind":"text","text":" their remainders modulo "},{"kind":"math_inline","text":"106 + 3"},{"kind":"text","text":" are taken."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 8"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"23 128"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case, there are "},{"kind":"math_inline","text":"23 = 8"},{"kind":"text","text":" days in Udayland. The probability that "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" people have the same birthday among "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" people is clearly "},{"attrs":{"alt":"","src":"/statement-assets/9f49bad3f2d1cd6e186770f994d62446d3184faddf1fa21db219beba3d75a10d.png"},"kind":"image"},{"kind":"text","text":", so "},{"kind":"math_inline","text":"A = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"B = 8"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample case, there are only "},{"kind":"math_inline","text":"21 = 2"},{"kind":"text","text":" days in Udayland, but there are "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" people, so it is guaranteed that two of them have the same birthday. Thus, the probability is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"A = B = 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"711E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/711/problem/E"}