{"assets":[],"contentKind":"statement","contestId":"1983","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. array-value"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have an array of non-negative integers $$$a_1, a_2, \\ldots, a_n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The value of a sub-array of length $$$\\ge 2$$$, $$$a[l, r] = [a_l, a_{l+1}, \\ldots, a_r]$$$ is the minimum value of $$$a_i \\oplus a_j$$$ such that $$$l \\le i \\lt j \\le r$$$, where $$$\\oplus$$$ is the xor (exclusive-or) operator."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to find the $$$k$$$-th smallest value over all sub-arrays of length $$$\\ge 2$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains multiple test cases $$$t$$$ ($$$1 \\le t \\le 2 \\cdot 10^4$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains integer numbers $$$n$$$ and $$$k$$$ ($$$2 \\le n \\le 10^5$$$, $$$1 \\le k \\le \\frac{n\\cdot(n-1)}{2}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains $$$n$$$ non-negative integer numbers $$$a_1, a_2, \\ldots, a_n$$$ ($$$0 \\le a_i \\le 10^9$$$) — the array itself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the $$$k$$$-th smallest value obtained over all subarrays of length at least $$$2$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n5 2\n1 2 3 4 5\n2 1\n4 3\n4 6\n1 2 4 8\n5 9\n1 2 3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n7\n12\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first testcase, we have subarrays with their smallest exclusive-or pair as:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$[1,2]: 3$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$[2,3]: 1$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$[3,4]: 7$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$[4,5]: 1$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$[1,2,3]: 1$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$[2,3,4]: 1$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$[3,4,5]: 1$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$[1,2,3,4]: 1$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$[2,3,4,5]: 1$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$[1,2,3,4,5]: 1$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sorted order would be: $$$1, 1, 1, 1, 1, 1, 1, 1, 3, 7$$$. Therefore, the second smallest element would be $$$1$$$. "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1983F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1983/problem/F"}