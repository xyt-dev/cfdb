{"assets":[],"contentKind":"statement","contestId":"500","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. New Year Transportation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"New Year is coming in Line World! In this world, there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cells numbered by integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", as a "},{"kind":"math_inline","text":"1 × n"},{"kind":"text","text":" board. People live in cells. However, it was hard to move between distinct cells, because of the difficulty of escaping the cell. People wanted to meet people who live in other cells."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, user tncks0121 has made a transportation system to move between these cells, to celebrate the New Year. First, he thought of "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"a1, a2, ..., an - 1"},{"kind":"text","text":". For every integer "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"1 ≤ i ≤ n - 1"},{"kind":"text","text":" the condition "},{"kind":"math_inline","text":"1 ≤ ai ≤ n - i"},{"kind":"text","text":" holds. Next, he made "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" portals, numbered by integers from 1 to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ("},{"kind":"math_inline","text":"1 ≤ i ≤ n - 1"},{"kind":"text","text":") portal connects cell "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and cell "},{"kind":"math_inline","text":"(i + ai)"},{"kind":"text","text":", and one can travel from cell "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to cell "},{"kind":"math_inline","text":"(i + ai)"},{"kind":"text","text":" using the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th portal. Unfortunately, one cannot use the portal backwards, which means one cannot move from cell "},{"kind":"math_inline","text":"(i + ai)"},{"kind":"text","text":" to cell "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" using the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th portal. It is easy to see that because of condition "},{"kind":"math_inline","text":"1 ≤ ai ≤ n - i"},{"kind":"text","text":" one can't leave the Line World using portals."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Currently, I am standing at cell "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", and I want to go to cell "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". However, I don't know whether it is possible to go there. Please determine whether I can go to cell "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" by only using the construted transportation system."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 3 × 104"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ t ≤ n"},{"kind":"text","text":") — the number of cells, and the index of the cell which I want to go to."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an - 1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ n - i"},{"kind":"text","text":"). It is guaranteed, that using the given transportation system, one cannot leave the Line World."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If I can go to cell "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" using the transportation system, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\". Otherwise, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 4\n1 2 1 2 1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 5\n1 2 1 2 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the visited cells are: "},{"kind":"math_inline","text":"1, 2, 4"},{"kind":"text","text":"; so we can successfully visit the cell "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the possible cells to visit are: "},{"kind":"math_inline","text":"1, 2, 4, 6, 7, 8"},{"kind":"text","text":"; so we can't visit the cell "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", which we want to visit."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"500A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/500/problem/A"}