{"assets":["/statement-assets/809e81eef12beceb8904d6ce1cd96c6caceb7affa867f87376d0d2b09dad9be3.png"],"contentKind":"statement","contestId":"611","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. New Year and Domino"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"They say \""},{"children":[{"kind":"text","text":"years are like dominoes, tumbling one after the other"}],"kind":"container"},{"kind":"text","text":"\". But would a year fit into a grid? I don't think so."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak is a little polar bear who loves to play. He has recently got a rectangular grid with "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" columns. Each cell is a square, either empty (denoted by '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"') or forbidden (denoted by '"},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"'). Rows are numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" from top to bottom. Columns are numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" from left to right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, Limak has a single domino. He wants to put it somewhere in a grid. A domino will occupy exactly two adjacent cells, located either in one row or in one column. Both adjacent cells must be empty and must be inside a grid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak needs more fun and thus he is going to consider some queries. In each query he chooses some rectangle and wonders, how many way are there to put a single domino inside of the chosen rectangle?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ h, w ≤ 500"},{"kind":"text","text":") – the number of rows and the number of columns, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" lines describe a grid. Each line contains a string of the length "},{"kind":"math_inline","text":"w"},{"kind":"text","text":". Each character is either '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"' — denoting an empty or forbidden cell, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains a single integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 100 000"},{"kind":"text","text":") — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains four integers "},{"kind":"math_inline","text":"r1i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c1i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r2i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c2i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ r1i ≤ r2i ≤ h, 1 ≤ c1i ≤ c2i ≤ w"},{"kind":"text","text":") — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query. Numbers "},{"kind":"math_inline","text":"r1i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c1i"},{"kind":"text","text":" denote the row and the column (respectively) of the upper left cell of the rectangle. Numbers "},{"kind":"math_inline","text":"r2i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c2i"},{"kind":"text","text":" denote the row and the column (respectively) of the bottom right cell of the rectangle."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" integers, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th should be equal to the number of ways to put a single domino inside the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th rectangle."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 8\n....#..#\n.#......\n##.#....\n##..#.##\n........\n4\n1 1 2 3\n4 1 4 1\n1 2 4 5\n2 5 5 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n0\n10\n15\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 39\n.......................................\n.###..###..#..###.....###..###..#..###.\n...#..#.#..#..#.........#..#.#..#..#...\n.###..#.#..#..###.....###..#.#..#..###.\n.#....#.#..#....#.....#....#.#..#..#.#.\n.###..###..#..###.....###..###..#..###.\n.......................................\n6\n1 1 3 20\n2 10 6 30\n2 10 7 30\n2 2 7 7\n1 7 7 7\n1 8 7 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"53\n89\n120\n23\n0\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A red frame below corresponds to the first query of the first sample. A domino can be placed in 4 possible ways."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/809e81eef12beceb8904d6ce1cd96c6caceb7affa867f87376d0d2b09dad9be3.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"611C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/611/problem/C"}