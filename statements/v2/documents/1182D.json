{"assets":["/statement-assets/186c37fda4a4c385825d357476a966e4cde7fca693f3929e09d6b7135051d1e8.png","/statement-assets/b6f8d8effe0c71e15d5ac2594bb398cb35ff1f2c676700ec3598044ed127e6c5.png"],"contentKind":"statement","contestId":"1182","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Complete Mirror"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have given tree consist of $$$n$$$ vertices. Select a vertex as root vertex that satisfies the condition below."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" For all vertices $$$v_{1}$$$ and $$$v_{2}$$$, if $$$distance$$$($$$root$$$, $$$v_{1}$$$) $$$= distance$$$($$$root$$$, $$$v_{2})$$$ then $$$degree$$$($$$v_{1}$$$) $$$= degree$$$($$$v_{2}$$$), where $$$degree$$$ means the number of vertices connected to that vertex, and $$$distance$$$ means the number of edges between two vertices. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Determine and find if there is such root vertex in the tree. If there are multiple answers, find any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$1 \\le n \\le 10^{5}$$$) — the number of vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n-1$$$ lines contains two integers $$$v_{i}$$$ and $$$u_{i}$$$ ($$$1 \\le v_{i} \\lt u_{i} \\le n$$$) — it means there is an edge exist between $$$v_{i}$$$ and $$$u_{i}$$$. It is guaranteed that the graph forms tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is such root vertex exists, print any of them. Otherwise, print $$$-1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n1 2\n2 3\n3 4\n4 5\n3 6\n6 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 3\n2 3\n3 4\n4 5\n4 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"This is the picture for the first example. $$$1$$$, $$$5$$$, $$$7$$$ also can be a valid answer."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/186c37fda4a4c385825d357476a966e4cde7fca693f3929e09d6b7135051d1e8.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"This is the picture for the second example. You can see that it's impossible to find such root vertex."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b6f8d8effe0c71e15d5ac2594bb398cb35ff1f2c676700ec3598044ed127e6c5.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1182D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1182/problem/D"}