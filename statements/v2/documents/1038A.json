{"assets":[],"contentKind":"statement","contestId":"1038","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Equality"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ of length $$$n$$$, which consists only of the first $$$k$$$ letters of the Latin alphabet. All letters in string $$$s$$$ are uppercase."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"subsequence"}],"kind":"container"},{"kind":"text","text":" of string $$$s$$$ is a string that can be derived from $$$s$$$ by deleting some of its symbols without changing the order of the remaining symbols. For example, \""},{"children":[{"kind":"text","text":"ADE"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"BD"}],"kind":"container"},{"kind":"text","text":"\" are subsequences of \""},{"children":[{"kind":"text","text":"ABCDE"}],"kind":"container"},{"kind":"text","text":"\", but \""},{"children":[{"kind":"text","text":"DEA"}],"kind":"container"},{"kind":"text","text":"\" is not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A subsequence of $$$s$$$ called "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if the number of occurences of each of the first $$$k$$$ letters of the alphabet is the same."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the length of the longest good subsequence of $$$s$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integers $$$n$$$ ($$$1\\le n \\le 10^5$$$) and $$$k$$$ ($$$1 \\le k \\le 26$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains the string $$$s$$$ of length $$$n$$$. String $$$s$$$ only contains uppercase letters from '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"' to the $$$k$$$-th letter of Latin alphabet."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer — the length of the longest good subsequence of string $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9 3\nACAABCCAB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9 4\nABCABCABC\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, \""},{"children":[{"kind":"text","text":"ACBCAB"}],"kind":"container"},{"kind":"text","text":"\" (\""},{"children":[{"children":[{"kind":"text","text":"AC"}],"kind":"container"},{"kind":"text","text":"AA"},{"children":[{"kind":"text","text":"BC"}],"kind":"container"},{"kind":"text","text":"C"},{"children":[{"kind":"text","text":"AB"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":"\") is one of the subsequences that has the same frequency of '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"'. Subsequence \""},{"children":[{"kind":"text","text":"CAB"}],"kind":"container"},{"kind":"text","text":"\" also has the same frequency of these letters, but doesn't have the maximum possible length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, none of the subsequences can have '"},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"', hence the answer is $$$0$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1038A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1038/problem/A"}