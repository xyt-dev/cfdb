ath_inline","text":"i"},{"kind":"text","text":"-th t-shirt."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following line contains sequence of integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ 3"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" equals to the back color of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th t-shirt."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains single integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 200 000"},{"kind":"text","text":") — the number of buyers. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following line contains sequence "},{"kind":"math_inline","text":"c1, c2, ..., cm"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ cj ≤ 3"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"cj"},{"kind":"text","text":" equals to the favorite color of the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th buyer. The buyers will come to the shop in the order they are given in the input. Each buyer is served only after the previous one is served."}],"kind":"paragraph"},{"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print to the first line "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers — the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th integer should be equal to the price of the t-shirt which the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th buyer will buy. If the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th buyer won't buy anything, print "},{"children":[{"kind":"text","text":"-1"}],"kind":