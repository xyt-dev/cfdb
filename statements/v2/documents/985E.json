{"assets":[],"contentKind":"statement","contestId":"985","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Pencils and Boxes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mishka received a gift of multicolored pencils for his birthday! Unfortunately he lives in a monochrome world, where everything is of the same color and only saturation differs. This pack can be represented as a sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers — saturation of the color of each pencil. Now Mishka wants to put all the mess in the pack in order. He has an infinite number of empty boxes to do this. He would like to fill some boxes in such a way that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Each pencil belongs to "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" one box; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Each non-empty box has at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" pencils in it; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If pencils "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" belong to the same box, then "},{"kind":"math_inline","text":"|ai - aj| ≤ d"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"|x|"},{"kind":"text","text":" means absolute value of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". Note that the opposite is optional, there can be pencils "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"|ai - aj| ≤ d"},{"kind":"text","text":" and they belong to different boxes. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Mishka to determine if it's possible to distribute all the pencils into boxes. Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if there exists such a distribution. Otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 5·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ d ≤ 109"},{"kind":"text","text":") — the number of pencils, minimal size of any non-empty box and maximal difference in saturation between any pair of pencils in the same box, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — saturation of color of each pencil."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if it's possible to distribute all the pencils into boxes and satisfy all the conditions. Otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3 10\n7 2 7 7 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2 3\n4 5 3 13 4 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 5\n10 16 22\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example it is possible to distribute pencils into "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" boxes with "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" pencils in each with any distribution. And you also can put all the pencils into the same box, difference of any pair in it won't exceed "},{"kind":"math_inline","text":"10"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example you can split pencils of saturations "},{"kind":"math_inline","text":"[4, 5, 3, 4]"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" boxes of size "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and put the remaining ones into another box."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"985E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/985/problem/E"}