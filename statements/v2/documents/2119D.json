{"assets":[],"contentKind":"statement","contestId":"2119","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Token Removing"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"children":[{"attrs":{"href":"https://www.youtube.com/watch?v=xv7hJ32xK94"},"children":[{"kind":"text","text":"r-906 & Hatsune Miku - All I Can See Is You"}],"kind":"link"}],"kind":"container"}],"kind":"container"},{"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Define a sequence of integers $$$a$$$ "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" if and only if $$$\\forall 1 \\le i \\le n, 0 \\le a_i \\le i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Define the "},{"children":[{"kind":"text","text":"weight"}],"kind":"container"},{"kind":"text","text":" $$$f(a)$$$ of a "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" sequence $$$a$$$ of length $$$n$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Initially, a token is placed at each integer point in the closed segment $$$[1, n]$$$ on the number axis. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Perform $$$n$$$ operations in sequence. During the $$$i$$$-th operation, if $$$a_i \\ne 0$$$, remove a token in the closed segment $$$[a_i, i]$$$ that has not been removed; otherwise, do nothing. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$f(a)$$$ is the number of ways to remove tokens. Two ways are considered different if there exists a $$$t$$$ such that the positions of the tokens removed by the two ways are different at the $$$t$$$-th operation. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, $$$f([0, 2, 1]) = 2$$$, because we can remove tokens on $$$2, 1$$$ or $$$2, 3$$$ in sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"JT gives you two integers $$$n, m$$$ and asks you to find the sum of the "},{"children":[{"kind":"text","text":"weight"}],"kind":"container"},{"kind":"text","text":"s over all $$$(n + 1)!$$$ "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" sequences of length $$$n$$$. Since the answer may be too large, print it modulo $$$m$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 1000$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\le n \\le 5000, 10^8 \\le m \\le 1.01 \\cdot 10^9$$$) — the length of "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" sequences, and the modulus."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n^2$$$ over all test cases does not exceed $$$2.5 \\cdot 10^7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output an integer — the sum of the "},{"children":[{"kind":"text","text":"weight"}],"kind":"container"},{"kind":"text","text":"s over all $$$(n + 1)!$$$ "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" sequences of length $$$n$$$, modulo $$$m$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 1000000007\n2 1000000007\n3 1000000007\n4 1000000007\n5 1000000007\n114 514191981\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n7\n37\n273\n2672\n393775292\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" sequences are $$$[0]$$$ and $$$[1]$$$, and the answer is $$$f([0]) + f([1]) = 1 + 1 = 2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" sequences are $$$[0, 0], [0, 1], [0, 2], [1, 0], [1, 1], [1, 2]$$$. The "},{"children":[{"kind":"text","text":"weight"}],"kind":"container"},{"kind":"text","text":" of $$$[0, 1]$$$ is $$$2$$$, and the others are $$$1$$$, so the answer is $$$5 \\cdot 1 + 1 \\cdot 2 = 7$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"2119D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2119/problem/D"}