{"assets":[],"contentKind":"statement","contestId":"460","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Roland and Rose"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Roland loves growing flowers. He has recently grown a beautiful rose at point "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":" of the Cartesian coordinate system. The rose is so beautiful that Roland is afraid that the evil forces can try and steal it. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To protect the rose, Roland wants to build "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" watch towers. Let's assume that a tower is a point on the plane at the distance of at most "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" from the rose. Besides, Roland assumes that the towers should be built at points with integer coordinates and the sum of squares of distances between all pairs of towers must be as large as possible. Note, that Roland may build several towers at the same point, also he may build some of them at point "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Roland build the towers at the integer points so that the sum of squares of distances between all towers is maximum possible. Note that the distance in this problem is defined as the Euclidian distance between points."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"(2 ≤ n ≤ 8; 1 ≤ r ≤ 30)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print an integer — the maximum possible sum of squared distances. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines print two integers, "},{"kind":"math_inline","text":"xi, yi"},{"kind":"text","text":" — the coordinates of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th tower. Each tower must be inside or on the border of the circle with radius "},{"kind":"math_inline","text":"r"},{"kind":"text","text":". Note that there may be several towers located at the same point of the plane, also some towers can be located at point "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple valid optimal arrangements, choose any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"16\n0 1\n0 1\n0 -1\n0 -1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"312\n0 6\n5 -3\n-5 -3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"460E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/460/problem/E"}