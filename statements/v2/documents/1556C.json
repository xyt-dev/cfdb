{"assets":["/statement-assets/191996738601f2dee614c37cce86b2776578be85a298f4b92bfb96e5e56db1f1.png"],"contentKind":"statement","contestId":"1556","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Compressed Bracket Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"attrs":{"alt":"","src":"/statement-assets/191996738601f2dee614c37cce86b2776578be85a298f4b92bfb96e5e56db1f1.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"William has a favorite bracket sequence. Since his favorite sequence is quite big he provided it to you as a sequence of positive integers $$$c_1, c_2, \\dots, c_n$$$ where $$$c_i$$$ is the number of consecutive brackets \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" if $$$i$$$ is an odd number or the number of consecutive brackets \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\" if $$$i$$$ is an even number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example for a bracket sequence \""},{"children":[{"kind":"text","text":"((())()))"}],"kind":"container"},{"kind":"text","text":"\" a corresponding sequence of numbers is $$$[3, 2, 1, 3]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to find the total number of continuous subsequences (subsegments) $$$[l, r]$$$ ($$$l \\le r$$$) of the original bracket sequence, which are regular bracket sequences."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A bracket sequence is called regular if it is possible to obtain correct arithmetic expression by inserting characters \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" into this sequence. For example, sequences \""},{"children":[{"kind":"text","text":"(())()"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(()(()))"}],"kind":"container"},{"kind":"text","text":"\" are regular, while \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"(()"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(()))("}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ $$$(1 \\le n \\le 1000)$$$, the size of the compressed sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence of integers $$$c_1, c_2, \\dots, c_n$$$ $$$(1 \\le c_i \\le 10^9)$$$, the compressed sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the total number of subsegments of the original bracket sequence, which are regular bracket sequences."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It can be proved that the answer fits in the signed 64-bit integer data type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n4 1 2 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 3 2 1 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 1 1 1 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example a sequence "},{"children":[{"kind":"text","text":"(((()(()))("}],"kind":"container"},{"kind":"text","text":" is described. This bracket sequence contains $$$5$$$ subsegments which form regular bracket sequences:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Subsequence from the $$$3$$$rd to $$$10$$$th character: "},{"children":[{"kind":"text","text":"(()(()))"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Subsequence from the $$$4$$$th to $$$5$$$th character: "},{"children":[{"kind":"text","text":"()"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Subsequence from the $$$4$$$th to $$$9$$$th character: "},{"children":[{"kind":"text","text":"()(())"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Subsequence from the $$$6$$$th to $$$9$$$th character: "},{"children":[{"kind":"text","text":"(())"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Subsequence from the $$$7$$$th to $$$8$$$th character: "},{"children":[{"kind":"text","text":"()"}],"kind":"container"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second example a sequence "},{"children":[{"kind":"text","text":"()))(()(())))"}],"kind":"container"},{"kind":"text","text":" is described."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example a sequence "},{"children":[{"kind":"text","text":"()()(())"}],"kind":"container"},{"kind":"text","text":" is described."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1556C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1556/problem/C"}