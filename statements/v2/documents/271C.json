{"assets":[],"contentKind":"statement","contestId":"271","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Secret"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Greatest Secret Ever consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" words, indexed by positive integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The secret needs dividing between "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" Keepers (let's index them by positive integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"), the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th Keeper gets a "},{"children":[{"kind":"text","text":"non-empty"}],"kind":"container"},{"kind":"text","text":" set of words with numbers from the set "},{"kind":"math_inline","text":"Ui = (ui, 1, ui, 2, ..., ui, |Ui|)"},{"kind":"text","text":". Here and below we'll presuppose that the set elements are written in the increasing order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We'll say that the "},{"children":[{"kind":"text","text":"secret is safe"}],"kind":"container"},{"kind":"text","text":" if the following conditions are hold:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" for any two indexes "},{"kind":"math_inline","text":"i, j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i < j ≤ k"},{"kind":"text","text":") the intersection of sets "},{"kind":"math_inline","text":"Ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Uj"},{"kind":"text","text":" is an empty set; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the union of sets "},{"kind":"math_inline","text":"U1, U2, ..., Uk"},{"kind":"text","text":" is set "},{"kind":"math_inline","text":"(1, 2, ..., n)"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in each set "},{"kind":"math_inline","text":"Ui"},{"kind":"text","text":", its elements "},{"kind":"math_inline","text":"ui, 1, ui, 2, ..., ui, |Ui|"},{"children":[{"kind":"text","text":"do not form"}],"kind":"container"},{"kind":"text","text":" an arithmetic progression (in particular, "},{"kind":"math_inline","text":"|Ui| ≥ 3"},{"kind":"text","text":" should hold). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let us remind you that the elements of set "},{"kind":"math_inline","text":"(u1, u2, ..., us)"},{"kind":"text","text":" form an arithmetic progression if there is such number "},{"kind":"math_inline","text":"d"},{"kind":"text","text":", that for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i < s"},{"kind":"text","text":") fulfills "},{"kind":"math_inline","text":"ui + d = ui + 1"},{"kind":"text","text":". For example, the elements of sets "},{"kind":"math_inline","text":"(5)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 10)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(1, 5, 9)"},{"kind":"text","text":" form arithmetic progressions and the elements of sets "},{"kind":"math_inline","text":"(1, 2, 4)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(3, 6, 8)"},{"kind":"text","text":" don't."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find any partition of the set of words into subsets "},{"kind":"math_inline","text":"U1, U2, ..., Uk"},{"kind":"text","text":" so that the secret is safe. Otherwise indicate that there's no such partition."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of a single line which contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ k ≤ n ≤ 106"},{"kind":"text","text":") — the number of words in the secret and the number of the Keepers. The numbers are separated by a single space."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no way to keep the secret safe, print a single integer \"-1\" (without the quotes). Otherwise, print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them representing the number of the Keeper who's got the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th word of the secret."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 1 2 1 1 2 3 2 2 3 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"271C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/271/problem/C"}