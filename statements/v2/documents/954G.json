{"assets":[],"contentKind":"statement","contestId":"954","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Castle Defense"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Today you are going to lead a group of elven archers to defend the castle that is attacked by an army of angry orcs. Three sides of the castle are protected by impassable mountains and the remaining side is occupied by a long wall that is split into "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sections. At this moment there are exactly "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" archers located at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th section of this wall. You know that archer who stands at section "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" can shoot orcs that attack section located at distance not exceeding "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", that is all such sections "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" that "},{"kind":"math_inline","text":"|i - j| ≤ r"},{"kind":"text","text":". In particular, "},{"kind":"math_inline","text":"r = 0"},{"kind":"text","text":" means that archers are only capable of shooting at orcs who attack section "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Denote as "},{"children":[{"kind":"text","text":"defense level"}],"kind":"container"},{"kind":"text","text":" of section "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" the total number of archers who can shoot at the orcs attacking this section. "},{"children":[{"kind":"text","text":"Reliability"}],"kind":"container"},{"kind":"text","text":" of the defense plan is the minimum value of defense level of individual wall section."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is a little time left till the attack so you can't redistribute archers that are already located at the wall. However, there is a reserve of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" archers that you can distribute among wall sections in arbitrary way. You would like to achieve maximum possible reliability of the defence plan."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 500 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ r ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ 1018"},{"kind":"text","text":") — the number of sections of the wall, the maximum distance to other section archers can still shoot and the number of archers yet to be distributed along the wall. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 109"},{"kind":"text","text":") — the current number of archers at each section."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the maximum possible value of defense plan reliability, i.e. the maximum possible value of minimum defense level if we distribute "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" additional archers optimally."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 0 6\n5 4 3 4 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 0\n1 2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1 1\n2 1 2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"954G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/954/problem/G"}