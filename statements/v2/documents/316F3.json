{"assets":["/statement-assets/bf79d75b10bac1b4ed429c2da5a8b3a5083d8290ca2cae85c1330886200e138e.bmp","/statement-assets/9045f53a5670e7c4714e2ad2fcf74a840c94ca50667ab7697de6934e8a395c0e.bmp","/statement-assets/6116fcad9bcd9ca28c4b28a2417d96a1eb02bf42c13f806f74f63d096c3de7cf.bmp"],"contentKind":"statement","contestId":"316","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F3. Suns and Rays"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Smart Beaver became interested in drawing. He draws suns. However, at some point, Smart Beaver realized that simply drawing suns is boring. So he decided to design a program that will process his drawings. You are given a picture drawn by the beaver. It will have two colors: one for the background and one for the suns in the image. Your task will be to count the number of suns in the image and for each of them to count the number of rays."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sun is arbitrarily rotated ellipse with rays. Ray is a segment which connects point on boundary of the ellipse with some point outside ellipse."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/bf79d75b10bac1b4ed429c2da5a8b3a5083d8290ca2cae85c1330886200e138e.bmp"},"kind":"image"},{"children":[{"kind":"text","text":" An image where all suns are circles. "}],"kind":"container"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9045f53a5670e7c4714e2ad2fcf74a840c94ca50667ab7697de6934e8a395c0e.bmp"},"kind":"image"},{"children":[{"kind":"text","text":" An image where all suns are ellipses, their axes are parallel to the coordinate axes. "}],"kind":"container"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6116fcad9bcd9ca28c4b28a2417d96a1eb02bf42c13f806f74f63d096c3de7cf.bmp"},"kind":"image"},{"children":[{"kind":"text","text":" An image where all suns are rotated ellipses. "}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"It is guaranteed that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" No two suns have common points. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The rays’ width is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" pixels. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The lengths of the ellipsis suns’ axes will lie between "},{"kind":"math_inline","text":"40"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"200"},{"kind":"text","text":" pixels. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" No two rays intersect. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The lengths of all rays will lie between "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"30"},{"kind":"text","text":" pixels. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" — the height and width of the image ("},{"kind":"math_inline","text":"1 ≤ h, w ≤ 1600"},{"kind":"text","text":"). Next "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" lines will contain "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" space-separated integers each. They describe Smart Beaver’s picture. Each number equals either a "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" (the image background), or a "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" (the sun color)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The input limits for scoring 30 points are (subproblem F1): "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" All suns on the image are circles. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The input limits for scoring 70 points are (subproblems F1+F2): "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" All suns on the image are ellipses with axes parallel to the coordinate axes. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The input limits for scoring 100 points are (subproblems F1+F2+F3):"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" All suns on the image are ellipses, they can be arbitrarily rotated. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line must contain a single number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of suns on the beaver’s image. The second line must contain exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" space-separated integers, corresponding to the number of rays on each sun. The numbers of the second line must be "},{"children":[{"kind":"text","text":"sorted"}],"kind":"container"},{"kind":"text","text":" in the increasing order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each complexity level you are suggested a sample in the initial data. You can download the samples at "},{"children":[{"kind":"text","text":"http://www.abbyy.ru/sun.zip"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F3","problemCode":"316F3","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/316/problem/F3"}