{"assets":[],"contentKind":"statement","contestId":"1612","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Special Permutation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A permutation of length $$$n$$$ is an array $$$p=[p_1,p_2,\\dots, p_n]$$$ which contains every integer from $$$1$$$ to $$$n$$$ (inclusive) exactly once. For example, $$$p=[4, 2, 6, 5, 3, 1]$$$ is a permutation of length $$$6$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given three integers $$$n$$$, $$$a$$$ and $$$b$$$, where $$$n$$$ is an even number. Print any permutation of length $$$n$$$ that the minimum among "},{"children":[{"kind":"text","text":"all its elements of the left half"}],"kind":"container"},{"kind":"text","text":" equals $$$a$$$ and the maximum among "},{"children":[{"kind":"text","text":"all its elements of the right half"}],"kind":"container"},{"kind":"text","text":" equals $$$b$$$. Print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if no such permutation exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$t$$$ ($$$1 \\le t \\le 1000$$$), the number of test cases in the test. The following $$$t$$$ lines contain test case descriptions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case description contains three integers $$$n$$$, $$$a$$$, $$$b$$$ ($$$2 \\le n \\le 100$$$; $$$1 \\le a,b \\le n$$$; $$$a \\ne b$$$), where $$$n$$$ is an even number (i.e. $$$n \\bmod 2 = 0$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single line containing any suitable permutation. Print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" no such permutation exists. If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n6 2 5\n6 1 3\n6 4 3\n4 2 4\n10 5 3\n2 1 2\n2 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4 2 6 5 3 1\n-1\n6 4 5 1 3 2 \n3 2 4 1 \n-1\n1 2 \n2 1 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1612B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1612/problem/B"}