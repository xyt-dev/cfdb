{"assets":[],"contentKind":"statement","contestId":"683","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Chocolate Bar"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A chocolate bar has a rectangular shape and consists of "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" slices. In other words, a bar consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows with "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" slices of chocolate in each row."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each slice of chocolate is known to weigh 1 gram. Your task is to determine for each of the "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" chocolate bars whether it is possible to obtain a piece weighing "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" grams by breaking the bar several (possibly zero) times. The final piece of the chocolate bar should be whole, and breaks are made along the line of slices' section for the whole length of the current piece."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the positive integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 100"},{"kind":"text","text":") — the number of chocolate bars. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains three positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m, p ≤ 1000"},{"kind":"text","text":") — the size of the chocolate bar, and the weight of the piece which should be obtained."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The output should contain "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines and the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line must contain \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if it is possible to perform the task for "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th chocolate bar, or \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n3 3 4\n4 4 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\nNo\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"683D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/683/problem/D"}