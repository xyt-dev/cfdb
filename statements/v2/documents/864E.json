{"assets":[],"contentKind":"statement","contestId":"864","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Fire"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp is in really serious trouble — his house is on fire! It's time to save the most valuable items. Polycarp estimated that it would take "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" seconds to save "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th item. In addition, for each item, he estimated the value of "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" — the moment after which the item "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" will be completely burned and will no longer be valuable for him at all. In particular, if "},{"kind":"math_inline","text":"ti ≥ di"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th item cannot be saved."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the values "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" for each of the items, find a set of items that Polycarp can save such that the total value of this items is maximum possible. Polycarp saves the items one after another. For example, if he takes item "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" first, and then item "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", then the item "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" will be saved in "},{"kind":"math_inline","text":"ta"},{"kind":"text","text":" seconds, and the item "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" — in "},{"kind":"math_inline","text":"ta + tb"},{"kind":"text","text":" seconds after fire started."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of items in Polycarp's house."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains three integers "},{"kind":"math_inline","text":"ti, di, pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 20"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ di ≤ 2 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ pi ≤ 20"},{"kind":"text","text":") — the time needed to save the item "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", the time after which the item "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" will burn completely and the value of item "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the maximum possible total value of the set of saved items. In the second line print one integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the number of items in the desired set. In the third line print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" distinct integers — numbers of the saved items "},{"children":[{"kind":"text","text":"in the order Polycarp saves them"}],"kind":"container"},{"kind":"text","text":". Items are 1-indexed in the same order in which they appear in the input. If there are several answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 7 4\n2 6 5\n3 7 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n2\n2 3 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n5 6 1\n3 3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n1 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Polycarp will have time to save any two items, but in order to maximize the total value of the saved items, he must save the second and the third item. For example, he can firstly save the third item in "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" seconds, and then save the second item in another "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" seconds. Thus, the total value of the saved items will be "},{"kind":"math_inline","text":"6 + 5 = 11"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example Polycarp can save only the first item, since even if he immediately starts saving the second item, he can save it in "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" seconds, but this item will already be completely burned by this time."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"864E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/864/problem/E"}