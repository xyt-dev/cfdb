{"assets":["/statement-assets/1ae22f61db293cf2e07fdc3922dfc629fe50424264f74918ab55686a373077bc.png"],"contentKind":"statement","contestId":"601","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Kleofáš and the n-thlon"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Kleofáš is participating in an "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-thlon - a tournament consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different competitions in "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different disciplines (numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"). There are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" participants in the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-thlon and each of them participates in all competitions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In each of these "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" competitions, the participants are given "},{"children":[{"kind":"text","text":"ranks"}],"kind":"container"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" in such a way that no two participants are given the same rank - in other words, the ranks in each competition form a permutation of numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". The "},{"children":[{"kind":"text","text":"score"}],"kind":"container"},{"kind":"text","text":" of a participant in a competition is equal to his/her rank in it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"overall score"}],"kind":"container"},{"kind":"text","text":" of each participant is computed as the sum of that participant's scores in all competitions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"overall rank"}],"kind":"container"},{"kind":"text","text":" of each participant is equal to "},{"kind":"math_inline","text":"1 + k"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is the number of participants with "},{"children":[{"kind":"text","text":"strictly smaller"}],"kind":"container"},{"kind":"text","text":" overall score."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-thlon is over now, but the results haven't been published yet. Kleofáš still remembers his ranks in each particular competition; however, he doesn't remember anything about how well the other participants did. Therefore, Kleofáš would like to know his expected overall rank."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All competitors are equally good at each discipline, so all rankings (permutations of ranks of everyone except Kleofáš) in each competition are equiprobable."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 1000"},{"kind":"text","text":") — the number of competitions and the number of participants respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains one integer "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ m"},{"kind":"text","text":") — the rank of Kleofáš in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th competition."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single real number – the expected overall rank of Kleofáš. Your answer will be considered correct if its relative or absolute error doesn't exceed "},{"kind":"math_inline","text":"10 - 9"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Namely: let's assume that your answer is "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and the answer of the jury is "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The checker program will consider your answer correct, if "},{"attrs":{"alt":"","src":"/statement-assets/1ae22f61db293cf2e07fdc3922dfc629fe50424264f74918ab55686a373077bc.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 10\n2\n1\n2\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.0000000000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n1\n2\n3\n4\n5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2.7500000000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6\n2\n4\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.6799999999999999\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Kleofáš has overall score "},{"kind":"math_inline","text":"6"},{"kind":"text","text":". Nobody else can have overall score less than "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" (but it's possible for one other person to have overall score "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" as well), so his overall rank must be "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"601C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/601/problem/C"}