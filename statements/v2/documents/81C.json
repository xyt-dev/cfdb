{"assets":[],"contentKind":"statement","contestId":"81","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Average Score"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After the educational reform Polycarp studies only two subjects at school, Safety Studies and PE (Physical Education). During the long months of the fourth term, he received "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" marks in them. When teachers wrote a mark in the journal, they didn't write in what subject the mark was for, they just wrote the mark."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now it's time to show the journal to his strict parents. Polycarp knows that recently at the Parent Meeting the parents were told that he received "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" Safety Studies marks and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" PE marks ("},{"kind":"math_inline","text":"a + b = n"},{"kind":"text","text":"). Now Polycarp wants to write a subject's name in front of each mark so that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" there are exactly "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" Safety Studies marks, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" there are exactly "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" PE marks, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the total average score in both subjects is maximum. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"An average subject grade is the sum of all marks in it, divided by the number of them. Of course, the division is performed in real numbers without rounding up or down. Polycarp aims to maximize the "},{"kind":"math_inline","text":"x1 + x2"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":" is the average score in the first subject (Safety Studies), and "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":" is the average score in the second one (Physical Education)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the number of marks in Polycarp's Journal. The second line contains two positive integers "},{"kind":"math_inline","text":"a, b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ n - 1, a + b = n"},{"kind":"text","text":"). The third line contains a sequence of integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 5"},{"kind":"text","text":"), they are Polycarp's marks."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the sequence of integers "},{"kind":"math_inline","text":"f1, f2, ..., fn"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ fi ≤ 2"},{"kind":"text","text":") is the number of a subject to which the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th mark should be attributed. If there are several possible solutions, then print such that the sequence "},{"kind":"math_inline","text":"f1, f2, ..., fn"},{"kind":"text","text":" is the smallest lexicographically."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sequence "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" is lexicographically less than "},{"kind":"math_inline","text":"q1, q2, ..., qn"},{"kind":"text","text":" if there exists such "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j ≤ n"},{"kind":"text","text":") that "},{"kind":"math_inline","text":"pi = qi"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"1 ≤ i < j"},{"kind":"text","text":", аnd "},{"kind":"math_inline","text":"pj < qj"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n3 2\n4 4 5 4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1 2 1 2 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 2\n3 5 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1 2 2 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 5\n4 4 4 5 4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 2 2 1 2 2 "}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the average score in the first subject is equal to 4, and in the second one — to 4.5. The total average score is 8.5."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"81C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/81/problem/C"}