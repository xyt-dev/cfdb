{"assets":[],"contentKind":"statement","contestId":"985","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Team Players"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are $$$n$$$ players numbered from $$$0$$$ to $$$n-1$$$ with ranks. The $$$i$$$-th player has rank $$$i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Players can form teams: the team should consist of three players and "},{"children":[{"kind":"text","text":"no pair"}],"kind":"container"},{"kind":"text","text":" of players in the team should have a conflict. The rank of the team is calculated using the following algorithm: let $$$i$$$, $$$j$$$, $$$k$$$ be the ranks of players in the team and $$$i \\lt j \\lt k$$$, then the rank of the team is equal to $$$A \\cdot i + B \\cdot j + C \\cdot k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given information about the pairs of players who "},{"children":[{"kind":"text","text":"have"}],"kind":"container"},{"kind":"text","text":" a conflict. Calculate the total sum of ranks over all possible valid teams modulo $$$2^{64}$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers $$$n$$$ and $$$m$$$ ($$$3 \\le n \\le 2 \\cdot 10^5$$$, $$$0 \\le m \\le 2 \\cdot 10^5$$$) — the number of players and the number of conflicting pairs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains three space-separated integers $$$A$$$, $$$B$$$ and $$$C$$$ ($$$1 \\le A, B, C \\le 10^6$$$) — coefficients for team rank calculation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$m$$$ lines contains two space-separated integers $$$u_i$$$ and $$$v_i$$$ ($$$0 \\le u_i, v_i \\lt n, u_i \\neq v_i$$$) — pair of conflicting players."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that each unordered pair of players appears in the input file no more than once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print single integer — the total sum of ranks over all possible teams modulo $$$2^{64}$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 0\n2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"64\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n2 3 4\n1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"38\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 4\n1 5 3\n0 3\n3 5\n5 4\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"164\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example all $$$4$$$ teams are valid, i.e. triples: {0, 1, 2}, {0, 1, 3}, {0, 2, 3} {1, 2, 3}."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example teams are following: {0, 2, 3}, {1, 2, 3}."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example teams are following: {0, 1, 2}, {0, 1, 4}, {0, 1, 5}, {0, 2, 4}, {0, 2, 5}, {1, 2, 3}, {1, 2, 4}, {1, 2, 5}."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"985G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/985/problem/G"}