{"assets":[],"contentKind":"statement","contestId":"1257","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Divisor Set"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an integer $$$x$$$ represented as a product of $$$n$$$ its "},{"children":[{"kind":"text","text":"prime"}],"kind":"container"},{"kind":"text","text":" divisors $$$p_1 \\cdot p_2, \\cdot \\ldots \\cdot p_n$$$. Let $$$S$$$ be the set of "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" positive integer divisors of $$$x$$$ (including $$$1$$$ and $$$x$$$ itself)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We call a set of integers $$$D$$$ "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if (and only if) there is no pair $$$a \\in D$$$, $$$b \\in D$$$ such that $$$a \\ne b$$$ and $$$a$$$ divides $$$b$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find a "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" subset of $$$S$$$ with maximum possible size. Since the answer can be large, print the size of the subset modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the number of prime divisors in representation of $$$x$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$p_1, p_2, \\dots, p_n$$$ ($$$2 \\le p_i \\le 3 \\cdot 10^6$$$) — the prime factorization of $$$x$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum possible size of a "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" subset modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2999999 43 2999957\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n2 3 2 3 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, $$$x = 2999999 \\cdot 43 \\cdot 2999957$$$ and one of the maximum good subsets is $$$\\{ 43, 2999957, 2999999 \\}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, $$$x = 2 \\cdot 3 \\cdot 2 \\cdot 3 \\cdot 2 \\cdot 2 = 144$$$ and one of the maximum good subsets is $$$\\{ 9, 12, 16 \\}$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1257G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1257/problem/G"}