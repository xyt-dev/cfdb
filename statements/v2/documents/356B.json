{"assets":["/statement-assets/7b4291dfb2a51197af709f3eac2acd651c6e7d6d75be02d96aaa3e244a0c11f2.png","/statement-assets/9a1f508e09ee4ef6a01e24dcdefc84c5d1009733d689c93d734b971106e5727b.png"],"contentKind":"statement","contestId":"356","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Xenia and Hamming"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Xenia is an amateur programmer. Today on the IT lesson she learned about the Hamming distance."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Hamming distance between two strings "},{"kind":"math_inline","text":"s = s1s2... sn"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t = t1t2... tn"},{"kind":"text","text":" of equal length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is value "},{"attrs":{"alt":"","src":"/statement-assets/7b4291dfb2a51197af709f3eac2acd651c6e7d6d75be02d96aaa3e244a0c11f2.png"},"kind":"image"},{"kind":"text","text":". Record "},{"kind":"math_inline","text":"[si ≠ ti]"},{"kind":"text","text":" is the Iverson notation and represents the following: if "},{"kind":"math_inline","text":"si ≠ ti"},{"kind":"text","text":", it is one, otherwise — zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Xenia wants to calculate the Hamming distance between two long strings "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The first string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is the concatenation of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" copies of string "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", that is, "},{"attrs":{"alt":"","src":"/statement-assets/9a1f508e09ee4ef6a01e24dcdefc84c5d1009733d689c93d734b971106e5727b.png"},"kind":"image"},{"kind":"text","text":". The second string "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is the concatenation of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" copies of string "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Xenia, calculate the required Hamming distance, given "},{"kind":"math_inline","text":"n, x, m, y"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 1012)"},{"kind":"text","text":". The second line contains a non-empty string "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". The third line contains a non-empty string "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". Both strings consist of at most "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that strings "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" that you obtain from the input have the same length."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the required Hamming distance."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"100 10\na\naaaaaaaaaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\nabacaba\nabzczzz\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\nrzr\naz\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is the same as string "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and equals 100 letters "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":". As both strings are equal, the Hamming distance between them is zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case strings "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" differ in their 3-rd, 5-th, 6-th and 7-th characters. Thus, the Hamming distance equals 4."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"rzrrzr"}],"kind":"container"},{"kind":"text","text":" and string "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"azazaz"}],"kind":"container"},{"kind":"text","text":". The strings differ in all characters apart for the second one, the Hamming distance between them equals 5."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"356B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/356/problem/B"}