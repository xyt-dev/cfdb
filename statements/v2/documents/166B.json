{"assets":[],"contentKind":"statement","contestId":"166","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Polygons"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got another geometrical task. You are given two non-degenerate polygons "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" as vertex coordinates. Polygon "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is strictly convex. Polygon "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" is an arbitrary polygon without any self-intersections and self-touches. The vertices of both polygons are given in the clockwise order. For each polygon no three consecutively following vertices are located on the same straight line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to check whether polygon "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" is positioned strictly inside polygon "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". It means that any point of polygon "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" should be strictly inside polygon "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". \"Strictly\" means that the vertex of polygon "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" cannot lie on the side of the polygon "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the only integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 105"},{"kind":"text","text":") — the number of vertices of polygon "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain pairs of integers "},{"kind":"math_inline","text":"xi, yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|xi|, |yi| ≤ 109"},{"kind":"text","text":") — coordinates of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex of polygon "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". The vertices are given in the clockwise order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains a single integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ m ≤ 2·104"},{"kind":"text","text":") — the number of vertices of polygon "},{"kind":"math_inline","text":"B"},{"kind":"text","text":". Then following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain pairs of integers "},{"kind":"math_inline","text":"xj, yj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|xj|, |yj| ≤ 109"},{"kind":"text","text":") — the coordinates of the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th vertex of polygon "},{"kind":"math_inline","text":"B"},{"kind":"text","text":". The vertices are given in the clockwise order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The coordinates of the polygon's vertices are separated by a single space. It is guaranteed that polygons "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" are non-degenerate, that polygon "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is strictly convex, that polygon "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" has no self-intersections and self-touches and also for each polygon no three consecutively following vertices are located on the same straight line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print on the only line the answer to the problem — if polygon "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" is strictly inside polygon "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\", otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n-2 1\n0 3\n3 3\n4 1\n3 -2\n2 -2\n4\n0 1\n2 2\n3 1\n1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2\n4 2\n3 -3\n-2 -2\n-2 1\n4\n0 1\n1 2\n4 1\n2 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n-1 2\n2 3\n4 1\n3 -2\n0 -3\n5\n1 0\n1 1\n3 1\n5 -1\n2 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"166B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/166/problem/B"}