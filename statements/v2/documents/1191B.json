{"assets":[],"contentKind":"statement","contestId":"1191","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Tokitsukaze and Mahjong"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Tokitsukaze is playing a game derivated from Japanese mahjong. In this game, she has three tiles in her hand. Each tile she owns is a suited tile, which means it has a suit ("},{"children":[{"kind":"text","text":"manzu"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"pinzu"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"souzu"}],"kind":"container"},{"kind":"text","text":") and a number (a digit ranged from $$$1$$$ to $$$9$$$). In this problem, we use one digit and one lowercase letter, which is the first character of the suit, to represent a suited tile. All possible suited tiles are represented as "},{"children":[{"kind":"text","text":"1m"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"2m"}],"kind":"container"},{"kind":"text","text":", $$$\\ldots$$$, "},{"children":[{"kind":"text","text":"9m"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1p"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"2p"}],"kind":"container"},{"kind":"text","text":", $$$\\ldots$$$, "},{"children":[{"kind":"text","text":"9p"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1s"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"2s"}],"kind":"container"},{"kind":"text","text":", $$$\\ldots$$$, "},{"children":[{"kind":"text","text":"9s"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In order to win the game, she must have at least one "},{"children":[{"kind":"text","text":"mentsu"}],"kind":"container"},{"kind":"text","text":" (described below) in her hand, so sometimes she should draw extra suited tiles. After drawing a tile, the number of her tiles increases by one. She can draw any tiles she wants, including those already in her hand."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Do you know the minimum number of extra suited tiles she needs to draw so that she can win?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here are some useful definitions in this game:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" A "},{"children":[{"kind":"text","text":"mentsu"}],"kind":"container"},{"kind":"text","text":", also known as meld, is formed by a "},{"children":[{"kind":"text","text":"koutsu"}],"kind":"container"},{"kind":"text","text":" or a "},{"children":[{"kind":"text","text":"shuntsu"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A "},{"children":[{"kind":"text","text":"koutsu"}],"kind":"container"},{"kind":"text","text":", also known as triplet, is made of three identical tiles, such as "},{"children":[{"kind":"text","text":"[1m, 1m, 1m]"}],"kind":"container"},{"kind":"text","text":", however, "},{"children":[{"kind":"text","text":"[1m, 1p, 1s]"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"[1m, 4m, 7m]"}],"kind":"container"},{"kind":"text","text":" is NOT a "},{"children":[{"kind":"text","text":"koutsu"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A "},{"children":[{"kind":"text","text":"shuntsu"}],"kind":"container"},{"kind":"text","text":", also known as sequence, is made of three sequential numbered tiles in the same suit, such as "},{"children":[{"kind":"text","text":"[1m, 2m, 3m]"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"[5s, 7s, 6s]"}],"kind":"container"},{"kind":"text","text":", however, "},{"children":[{"kind":"text","text":"[9m, 1m, 2m]"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"[1m, 2p, 3s]"}],"kind":"container"},{"kind":"text","text":" is NOT a "},{"children":[{"kind":"text","text":"shuntsu"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Some examples: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"[2m, 3p, 2s, 4m, 1s, 2s, 4s]"}],"kind":"container"},{"kind":"text","text":" — it contains no "},{"children":[{"kind":"text","text":"koutsu"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"shuntsu"}],"kind":"container"},{"kind":"text","text":", so it includes no "},{"children":[{"kind":"text","text":"mentsu"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"[4s, 3m, 3p, 4s, 5p, 4s, 5p]"}],"kind":"container"},{"kind":"text","text":" — it contains a "},{"children":[{"kind":"text","text":"koutsu"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"[4s, 4s, 4s]"}],"kind":"container"},{"kind":"text","text":", but no "},{"children":[{"kind":"text","text":"shuntsu"}],"kind":"container"},{"kind":"text","text":", so it includes a "},{"children":[{"kind":"text","text":"mentsu"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"[5p, 5s, 9m, 4p, 1s, 7p, 7m, 6p]"}],"kind":"container"},{"kind":"text","text":" — it contains no "},{"children":[{"kind":"text","text":"koutsu"}],"kind":"container"},{"kind":"text","text":" but a "},{"children":[{"kind":"text","text":"shuntsu"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"[5p, 4p, 6p]"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"[5p, 7p, 6p]"}],"kind":"container"},{"kind":"text","text":", so it includes a "},{"children":[{"kind":"text","text":"mentsu"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that the order of tiles is unnecessary and you can assume the number of each type of suited tiles she can draw is infinite."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains "},{"children":[{"kind":"text","text":"three"}],"kind":"container"},{"kind":"text","text":" strings — the tiles in Tokitsukaze's hand. For each string, the first character is a digit ranged from $$$1$$$ to $$$9$$$ and the second character is "},{"children":[{"kind":"text","text":"m"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"p"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum number of extra suited tiles she needs to draw."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1s 2s 3s\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n9m 9m 9m\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3p 9m 2p\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, Tokitsukaze already has a "},{"children":[{"kind":"text","text":"shuntsu"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, Tokitsukaze already has a "},{"children":[{"kind":"text","text":"koutsu"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, Tokitsukaze can get a "},{"children":[{"kind":"text","text":"shuntsu"}],"kind":"container"},{"kind":"text","text":" by drawing one suited tile — "},{"children":[{"kind":"text","text":"1p"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"4p"}],"kind":"container"},{"kind":"text","text":". The resulting tiles will be "},{"children":[{"kind":"text","text":"[3p, 9m, 2p, 1p]"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"[3p, 9m, 2p, 4p]"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1191B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1191/problem/B"}