{"assets":[],"contentKind":"statement","contestId":"757","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Bash's Big Day"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bash has set out on a journey to become the greatest Pokemon master. To get his first Pokemon, he went to Professor Zulu's Lab. Since Bash is Professor Zulu's favourite student, Zulu allows him to take as many Pokemon from his lab as he pleases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But Zulu warns him that a group of "},{"kind":"math_inline","text":"k > 1"},{"kind":"text","text":" Pokemon with strengths "},{"kind":"math_inline","text":"{s1, s2, s3, ..., sk}"},{"kind":"text","text":" tend to fight among each other if "},{"kind":"math_inline","text":"gcd(s1, s2, s3, ..., sk) = 1"},{"kind":"text","text":" (see notes for "},{"kind":"math_inline","text":"gcd"},{"kind":"text","text":" definition)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Bash, being smart, does not want his Pokemon to fight among each other. However, he also wants to maximize the number of Pokemon he takes from the lab. Can you help Bash find out the maximum number of Pokemon he can take? "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note"}],"kind":"container"},{"kind":"text","text":": A Pokemon cannot fight with itself."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of two lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":"), the number of Pokemon in the lab."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space separated integers, where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them denotes "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ si ≤ 105"},{"kind":"text","text":"), the strength of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th Pokemon."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print single integer — the maximum number of Pokemons Bash can take."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2 3 4 6 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"math_inline","text":"gcd"},{"kind":"text","text":" (greatest common divisor) of positive integers set "},{"kind":"math_inline","text":"{a1, a2, ..., an}"},{"kind":"text","text":" is the maximum positive integer that divides all the integers "},{"kind":"math_inline","text":"{a1, a2, ..., an}"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample, we can take Pokemons with strengths "},{"kind":"math_inline","text":"{2, 4}"},{"kind":"text","text":" since "},{"kind":"math_inline","text":"gcd(2, 4) = 2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, we can take Pokemons with strengths "},{"kind":"math_inline","text":"{2, 4, 6}"},{"kind":"text","text":", and there is no larger group with "},{"kind":"math_inline","text":"gcd ≠ 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"757B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/757/problem/B"}