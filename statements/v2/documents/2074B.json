{"assets":[],"contentKind":"statement","contestId":"2074","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. The Third Side"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The pink soldiers have given you a sequence $$$a$$$ consisting of $$$n$$$ positive integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You must repeatedly perform the following operation "},{"children":[{"kind":"text","text":"until there is only $$$1$$$ element left"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose two "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" indices $$$i$$$ and $$$j$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then, choose a positive integer value $$$x$$$ such that there exists a "},{"children":[{"kind":"text","text":"non-degenerate triangle"}],"kind":"container"},{"kind":"text","text":"$$$^{\\text{∗}}$$$ with side lengths $$$a_i$$$, $$$a_j$$$, and $$$x$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Finally, remove two elements $$$a_i$$$ and $$$a_j$$$, and append $$$x$$$ to the end of $$$a$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Please find the maximum possible value of the only last element in the sequence $$$a$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$A triangle with side lengths $$$a$$$, $$$b$$$, $$$c$$$ is non-degenerate when $$$a+b \\gt c$$$, $$$a+c \\gt b$$$, $$$b+c \\gt a$$$."}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1,a_2,\\ldots,a_n$$$ ($$$1 \\le a_i \\le 1000$$$) — the elements of the sequence $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the maximum possible value of the only last element on a separate line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1\n10\n3\n998 244 353\n5\n1 2 3 4 5\n9\n9 9 8 2 4 4 3 5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n1593\n11\n39\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first test case, there is already only one element. The value of the only last element is $$$10$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the second test case, $$$a$$$ is initially $$$[998,244,353]$$$. The following series of operations is valid:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Erase $$$a_2=244$$$ and $$$a_3=353$$$, and append $$$596$$$ to the end of $$$a$$$. $$$a$$$ is now $$$[998,596]$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Erase $$$a_1=998$$$ and $$$a_2=596$$$, and append $$$1593$$$ to the end of $$$a$$$. $$$a$$$ is now $$$[1593]$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It can be shown that the only last element cannot be greater than $$$1593$$$. Therefore, the answer is $$$1593$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"2074B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2074/problem/B"}