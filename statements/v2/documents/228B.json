{"assets":["/statement-assets/1bd07e8776833bdc2736893472c42c6452f983916a7f86679641081b3450a95e.png"],"contentKind":"statement","contestId":"228","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Two Tables"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got two rectangular tables with sizes "},{"kind":"math_inline","text":"na × ma"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"nb × mb"},{"kind":"text","text":" cells. The tables consist of zeroes and ones. We will consider the rows and columns of both tables indexed starting from 1. Then we will define the element of the first table, located at the intersection of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column, as "},{"kind":"math_inline","text":"ai, j"},{"kind":"text","text":"; we will define the element of the second table, located at the intersection of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column, as "},{"kind":"math_inline","text":"bi, j"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We will call the pair of integers "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" a "},{"children":[{"kind":"text","text":"shift"}],"kind":"container"},{"kind":"text","text":" of the second table relative to the first one. We'll call the "},{"children":[{"kind":"text","text":"overlap factor"}],"kind":"container"},{"kind":"text","text":" of the shift "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" value:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1bd07e8776833bdc2736893472c42c6452f983916a7f86679641081b3450a95e.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"where the variables "},{"kind":"math_inline","text":"i, j"},{"kind":"text","text":" take only such values, in which the expression "},{"kind":"math_inline","text":"ai, j·bi + x, j + y"},{"kind":"text","text":" makes sense. More formally, inequalities "},{"kind":"math_inline","text":"1 ≤ i ≤ na, 1 ≤ j ≤ ma, 1 ≤ i + x ≤ nb, 1 ≤ j + y ≤ mb"},{"kind":"text","text":" must hold. If there are no values of variables "},{"kind":"math_inline","text":"i, j"},{"kind":"text","text":", that satisfy the given inequalities, the value of the sum is considered equal to 0. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the shift with the maximum overlap factor among all possible shifts."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"na, ma"},{"kind":"math_inline","text":"(1 ≤ na, ma ≤ 50)"},{"kind":"text","text":" — the number of rows and columns in the first table. Then "},{"kind":"math_inline","text":"na"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"ma"},{"kind":"text","text":" characters each — the elements of the first table. Each character is either a \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\", or a \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains two space-separated integers "},{"kind":"math_inline","text":"nb, mb"},{"kind":"math_inline","text":"(1 ≤ nb, mb ≤ 50)"},{"kind":"text","text":" — the number of rows and columns in the second table. Then follow the elements of the second table in the format, similar to the first table."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the first table has at least one number \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\". It is guaranteed that the second table has at least one number \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two space-separated integers "},{"kind":"math_inline","text":"x, y"},{"kind":"math_inline","text":"(|x|, |y| ≤ 109)"},{"kind":"text","text":" — a shift with maximum overlap factor. If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n01\n10\n00\n2 3\n001\n111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n000\n010\n000\n1 1\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1 -1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"228B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/228/problem/B"}