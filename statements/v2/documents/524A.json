{"assets":[],"contentKind":"statement","contestId":"524","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Возможно, вы знаете этих людей?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"ограничение по времени на тест"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 секунды"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"ограничение по памяти на тест"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 мегабайт"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Основой любой социальной сети является отношение дружбы между двумя пользователями в том или ином смысле. В одной известной социальной сети дружба симметрична, то есть если "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" является другом "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", то "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" также является другом "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"В этой же сети есть функция, которая демонстрирует множество людей, имеющих высокую вероятность быть знакомыми для пользователя. Эта функция работает следующим образом. Зафиксируем пользователя "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". Пусть некоторый другой человек "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", не являющийся другом "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" на текущий момент, является другом не менее, чем для "},{"kind":"math_inline","text":"k%"},{"kind":"text","text":" друзей "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". Тогда он является предполагаемым другом для "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"У каждого человека в социальной сети есть свой уникальный идентификатор — это целое число от "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" до "},{"kind":"math_inline","text":"109"},{"kind":"text","text":". Вам дан список пар пользователей, являющихся друзьями. Определите для каждого упомянутого пользователя множество его предполагаемых друзей."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Входные данные"}],"kind":"heading"},{"children":[{"kind":"text","text":"В первой строке следуют два целых числа "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" и "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ 100"},{"kind":"text","text":") — количество пар друзей и необходимый процент общих друзей для того, чтобы считаться предполагаемым другом."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"В последующих "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" строках записано по два числа "},{"kind":"math_inline","text":"ai, bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":"), обозначающих идентификаторы пользователей, являющихся друзьями. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Гарантируется, что каждая пара людей фигурирует в списке не более одного раза."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Выходные данные"}],"kind":"heading"},{"children":[{"kind":"text","text":"Для всех упомянутых людей в порядке возрастания id выведите информацию о предполагаемых друзьях. Информация должна иметь вид \""},{"kind":"math_inline","text":"id:  k id1 id2 ... idk"},{"kind":"text","text":"\", где "},{"kind":"math_inline","text":"id"},{"kind":"text","text":" — это id самого человека, "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — количество его предполагаемых друзей, а "},{"kind":"math_inline","text":"id1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"id2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"idk"},{"kind":"text","text":" — идентификаторы его предполагаемых друзей в возрастающем порядке. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Примеры"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Входные данные"}],"kind":"heading"},{"kind":"code_block","text":"5 51\n10 23\n23 42\n39 42\n10 39\n39 58\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Выходные данные"}],"kind":"heading"},{"kind":"code_block","text":"10: 1 42\n23: 1 39\n39: 1 23\n42: 1 10\n58: 2 10 42\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Входные данные"}],"kind":"heading"},{"kind":"code_block","text":"5 100\n1 2\n1 3\n1 4\n2 3\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Выходные данные"}],"kind":"heading"},{"kind":"code_block","text":"1: 0\n2: 0\n3: 1 4\n4: 1 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"524A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/524/problem/A"}