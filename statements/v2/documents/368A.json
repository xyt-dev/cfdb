{"assets":[],"contentKind":"statement","contestId":"368","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Sereja and Coat Rack"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sereja owns a restaurant for "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people. The restaurant hall has a coat rack with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" hooks. Each restaurant visitor can use a hook to hang his clothes on it. Using the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th hook costs "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" rubles. Only one person can hang clothes on one hook."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Tonight Sereja expects "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" guests in the restaurant. Naturally, each guest wants to hang his clothes on an available hook with minimum price (if there are multiple such hooks, he chooses any of them). However if the moment a guest arrives the rack has no available hooks, Sereja must pay a "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ruble fine to the guest. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Sereja find out the profit in rubles (possibly negative) that he will get tonight. You can assume that before the guests arrive, all hooks on the rack are available, all guests come at different time, nobody besides the "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" guests is visiting Sereja's restaurant tonight."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"math_inline","text":"(1 ≤ n, d ≤ 100)"},{"kind":"text","text":". The next line contains integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"an"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 100)"},{"kind":"text","text":". The third line contains integer "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ m ≤ 100)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print a single integer — the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n2 1\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n2 1\n10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test both hooks will be used, so Sereja gets "},{"kind":"math_inline","text":"1 + 2 = 3"},{"kind":"text","text":" rubles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test both hooks will be used but Sereja pays a fine "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" times, so the answer is "},{"kind":"math_inline","text":"3 - 8 =  - 5"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"368A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/368/problem/A"}