{"assets":[],"contentKind":"statement","contestId":"1822","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Making Anti-Palindromes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$, consisting of lowercase English letters. In one operation, you are allowed to swap any two characters of the string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string $$$s$$$ of length $$$n$$$ is called an "},{"children":[{"kind":"text","text":"anti-palindrome"}],"kind":"container"},{"kind":"text","text":", if $$$s[i] \\ne s[n - i + 1]$$$ for every $$$i$$$ ($$$1 \\le i \\le n$$$). For example, the strings "},{"children":[{"kind":"text","text":"\"codeforces\""}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"\"string\""}],"kind":"container"},{"kind":"text","text":" are "},{"children":[{"kind":"text","text":"anti-palindromes"}],"kind":"container"},{"kind":"text","text":", but the strings "},{"children":[{"kind":"text","text":"\"abacaba\""}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"\"abc\""}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"\"test\""}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the minimum number of operations required to make the string $$$s$$$ an "},{"children":[{"kind":"text","text":"anti-palindrome"}],"kind":"container"},{"kind":"text","text":", or output $$$-1$$$, if this is not possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two lines. The first line contains a single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the length of the string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string $$$s$$$, consisting of $$$n$$$ lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the minimum number of operations required to make the string $$$s$$$ an "},{"children":[{"kind":"text","text":"anti-palindrome"}],"kind":"container"},{"kind":"text","text":", or $$$-1$$$ if this is not possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n10\ncodeforces\n3\nabc\n10\ntaarrrataa\n10\ndcbdbdcccc\n4\nwwww\n12\ncabbaccabaac\n10\naadaaaaddc\n14\naacdaaaacadcdc\n6\nabccba\n12\ndcbcaebacccd\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n-1\n1\n1\n-1\n3\n-1\n2\n2\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the string "},{"children":[{"kind":"text","text":"\"codeforces\""}],"kind":"container"},{"kind":"text","text":" is already an "},{"children":[{"kind":"text","text":"anti-palindrome"}],"kind":"container"},{"kind":"text","text":", so the answer is $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, it can be shown that the string "},{"children":[{"kind":"text","text":"\"abc\""}],"kind":"container"},{"kind":"text","text":" cannot be transformed into an "},{"children":[{"kind":"text","text":"anti-palindrome"}],"kind":"container"},{"kind":"text","text":" by performing the allowed operations, so the answer is $$$-1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, it is enough to swap the second and the fifth characters of the string "},{"children":[{"kind":"text","text":"\"taarrrataa\""}],"kind":"container"},{"kind":"text","text":", and the new string "},{"children":[{"kind":"text","text":"\"trararataa\""}],"kind":"container"},{"kind":"text","text":" will be an "},{"children":[{"kind":"text","text":"anti-palindrome"}],"kind":"container"},{"kind":"text","text":", so the answer is $$$1$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1822E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1822/problem/E"}