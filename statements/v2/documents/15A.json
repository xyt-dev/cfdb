{"assets":[],"contentKind":"statement","contestId":"15","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Cottage Village"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A new cottage village called «Flatville» is being built in Flatland. By now they have already built in «Flatville» "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" square houses with the centres on the "},{"kind":"math_inline","text":"Оx"},{"kind":"text","text":"-axis. The houses' sides are parallel to the coordinate axes. It's known that no two houses overlap, but they can touch each other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The architect bureau, where Peter works, was commissioned to build a new house in «Flatville». The customer wants his future house to be on the "},{"kind":"math_inline","text":"Оx"},{"kind":"text","text":"-axis, to be square in shape, have a side "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", and touch at least one of the already built houses. For sure, its sides should be parallel to the coordinate axes, its centre should be on the "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":"-axis and it shouldn't overlap any of the houses in the village."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Peter was given a list of all the houses in «Flatville». Would you help him find the amount of possible positions of the new house?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input data contains numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, t ≤ 1000"},{"kind":"text","text":"). Then there follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each of them contains two space-separated integer numbers: "},{"kind":"math_inline","text":"xi"},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" — "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-coordinate of the centre of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th house, and "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" — length of its side ("},{"kind":"math_inline","text":" - 1000 ≤ xi ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ai ≤ 1000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the amount of possible positions of the new house."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n0 4\n6 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n0 4\n5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n0 4\n5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"It is possible for the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-coordinate of the new house to have non-integer value."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"15A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/15/problem/A"}