{"assets":[],"contentKind":"statement","contestId":"598","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Queries on a String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and should process "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries. Each query is described by two 1-based indices "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and integer "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":". It means that you should cyclically shift the substring "},{"kind":"math_inline","text":"s[li... ri]"},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" times. The queries should be processed one after another in the order they are given."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One operation of a cyclic shift (rotation) is equivalent to moving the last character to the position of the first character and shifting all other characters one position to the right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"abacaba"}],"kind":"container"},{"kind":"text","text":" and the query is "},{"kind":"math_inline","text":"l1 = 3, r1 = 6, k1 = 1"},{"kind":"text","text":" then the answer is "},{"children":[{"kind":"text","text":"abbacaa"}],"kind":"container"},{"kind":"text","text":". If after that we would process the query "},{"kind":"math_inline","text":"l2 = 1, r2 = 4, k2 = 2"},{"kind":"text","text":" then we would get the string "},{"children":[{"kind":"text","text":"baabcaa"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 10 000"},{"kind":"text","text":") in its initial state, where "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":" stands for the length of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". It contains only lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second line contains a single integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 300"},{"kind":"text","text":") — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains three integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ |s|, 1 ≤ ki ≤ 1 000 000"},{"kind":"text","text":") — the description of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the resulting string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" after processing all "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abacaba\n2\n3 6 1\n1 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"baabcaa\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The sample is described in problem statement."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"598B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/598/problem/B"}