{"assets":[],"contentKind":"statement","contestId":"174","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Problem About Equation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A group of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" merry programmers celebrate Robert Floyd's birthday. Polucarpus has got an honourable task of pouring Ber-Cola to everybody. Pouring the same amount of Ber-Cola to everybody is really important. In other words, the drink's volume in each of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" mugs must be the same."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus has already began the process and he partially emptied the Ber-Cola bottle. Now the first mug has "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":" milliliters of the drink, the second one has "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":" milliliters and so on. The bottle has "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" milliliters left and Polycarpus plans to pour them into the mugs so that the main equation was fulfilled."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Write a program that would determine what volume of the drink Polycarpus needs to add into each mug to ensure that the following two conditions were fulfilled simultaneously: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" there were "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" milliliters poured in total. That is, the bottle need to be emptied; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" after the process is over, the volumes of the drink in the mugs should be equal. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a pair of integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100, 1 ≤ b ≤ 100"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the total number of friends in the group and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is the current volume of drink in the bottle. The second line contains a sequence of integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 100"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the current volume of drink in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th mug."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if there is no solution. Otherwise, print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" float numbers "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" is the volume of the drink to add in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th mug. Print the numbers with no less than 6 digits after the decimal point, print each "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" on a single line. Polycarpus proved that if a solution exists then it is unique."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Russian locale is installed by default on the testing computer. Make sure that your solution use the point to separate the integer part of a real number from the decimal, not a comma."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 50\n1 2 3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12.000000\n11.000000\n10.000000\n9.000000\n8.000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n1 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"174A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/174/problem/A"}