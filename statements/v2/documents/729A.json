{"assets":[],"contentKind":"statement","contestId":"729","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Interview with Oleg"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp has interviewed Oleg and has written the interview down without punctuation marks and spaces to save time. Thus, the interview is now a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is a filler word "},{"children":[{"kind":"text","text":"ogo"}],"kind":"container"},{"kind":"text","text":" in Oleg's speech. All words that can be obtained from "},{"children":[{"kind":"text","text":"ogo"}],"kind":"container"},{"kind":"text","text":" by adding "},{"children":[{"kind":"text","text":"go"}],"kind":"container"},{"kind":"text","text":" several times to the end of it are also considered to be fillers. For example, the words "},{"children":[{"kind":"text","text":"ogo"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"ogogo"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"ogogogo"}],"kind":"container"},{"kind":"text","text":" are fillers, but the words "},{"children":[{"kind":"text","text":"go"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"og"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"ogog"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"ogogog"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"oggo"}],"kind":"container"},{"kind":"text","text":" are not fillers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fillers have maximal size, for example, for "},{"children":[{"kind":"text","text":"ogogoo"}],"kind":"container"},{"kind":"text","text":" speech we can't consider "},{"children":[{"kind":"text","text":"ogo"}],"kind":"container"},{"kind":"text","text":" a filler and "},{"children":[{"kind":"text","text":"goo"}],"kind":"container"},{"kind":"text","text":" as a normal phrase. We should consider "},{"children":[{"kind":"text","text":"ogogo"}],"kind":"container"},{"kind":"text","text":" as a filler here."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To print the interview, Polycarp has to replace each of the fillers with three asterisks. Note that a filler word is replaced with exactly three asterisks regardless of its length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp has dealt with this problem in no time. Can you do the same? The clock is ticking!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the length of the interview."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", consisting of lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the interview text after the replacement of each of the fillers with \""},{"children":[{"kind":"text","text":"***"}],"kind":"container"},{"kind":"text","text":"\". It is allowed for the substring \""},{"children":[{"kind":"text","text":"***"}],"kind":"container"},{"kind":"text","text":"\" to have several consecutive occurences."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\naogogob\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"a***b\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"13\nogogmgogogogo\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"***gmg***\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\nogoogoogo\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"*********\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first sample contains one filler word "},{"children":[{"kind":"text","text":"ogogo"}],"kind":"container"},{"kind":"text","text":", so the interview for printing is \""},{"children":[{"kind":"text","text":"a***b"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second sample contains two fillers "},{"children":[{"kind":"text","text":"ogo"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"ogogogo"}],"kind":"container"},{"kind":"text","text":". Thus, the interview is transformed to \""},{"children":[{"kind":"text","text":"***gmg***"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"729A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/729/problem/A"}