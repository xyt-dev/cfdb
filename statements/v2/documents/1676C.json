{"assets":[],"contentKind":"statement","contestId":"1676","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Most Similar Words"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given $$$n$$$ words of "},{"children":[{"kind":"text","text":"equal"}],"kind":"container"},{"kind":"text","text":" length $$$m$$$, consisting of lowercase Latin alphabet letters. The $$$i$$$-th word is denoted $$$s_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one move you can choose "},{"children":[{"kind":"text","text":"any position in any single word"}],"kind":"container"},{"kind":"text","text":" and change the letter at that position to the previous or next letter in alphabetical order. For example:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" you can change '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":"' or to '"},{"children":[{"kind":"text","text":"f"}],"kind":"container"},{"kind":"text","text":"'; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' can only be changed to '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"'; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"' can only be changed to '"},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"difference"}],"kind":"container"},{"kind":"text","text":" between two words is the "},{"children":[{"kind":"text","text":"minimum"}],"kind":"container"},{"kind":"text","text":" number of moves required to make them equal. For example, the "},{"children":[{"kind":"text","text":"difference"}],"kind":"container"},{"kind":"text","text":" between \""},{"children":[{"kind":"text","text":"best"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":"\" is $$$1 + 10 + 0 + 0 = 11$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the minimum "},{"children":[{"kind":"text","text":"difference"}],"kind":"container"},{"kind":"text","text":" of $$$s_i$$$ and $$$s_j$$$ such that $$$(i \\lt j)$$$. In other words, find the minimum "},{"children":[{"kind":"text","text":"difference"}],"kind":"container"},{"kind":"text","text":" over all possible pairs of the $$$n$$$ words."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer $$$t$$$ ($$$1 \\le t \\le 100$$$) — the number of test cases. The description of test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains $$$2$$$ integers $$$n$$$ and $$$m$$$ ($$$2 \\leq n \\leq 50$$$, $$$1 \\leq m \\leq 8$$$) — the number of strings and their length respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follows $$$n$$$ lines, the $$$i$$$-th of which containing a single string $$$s_i$$$ of length $$$m$$$, consisting of lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single integer — the minimum "},{"children":[{"kind":"text","text":"difference"}],"kind":"container"},{"kind":"text","text":" over all possible pairs of the given strings."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n2 4\nbest\ncost\n6 3\nabb\nzba\nbef\ncdu\nooo\nzzz\n2 7\naaabbbc\nbbaezfe\n3 2\nab\nab\nab\n2 8\naaaaaaaa\nzzzzzzzz\n3 1\na\nu\ny\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n11\n8\n35\n0\n200\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the second test case, one can show that the best pair is (\""},{"children":[{"kind":"text","text":"abb"}],"kind":"container"},{"kind":"text","text":"\",\""},{"children":[{"kind":"text","text":"bef"}],"kind":"container"},{"kind":"text","text":"\"), which has "},{"children":[{"kind":"text","text":"difference"}],"kind":"container"},{"kind":"text","text":" equal to $$$8$$$, which can be obtained in the following way: change the first character of the first string to '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' in one move, change the second character of the second string to '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' in $$$3$$$ moves and change the third character of the second string to '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' in $$$4$$$ moves, thus making in total $$$1 + 3 + 4 = 8$$$ moves."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the third test case, there is only one possible pair and it can be shown that the minimum amount of moves necessary to make the strings equal is $$$35$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the fourth test case, there is a pair of strings which is already equal, so the answer is $$$0$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1676C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1676/problem/C"}