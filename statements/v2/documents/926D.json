{"assets":["/statement-assets/97d866265589e274c446cbb777838830bbcf3c178894d55b54e58180532d3e2e.png"],"contentKind":"statement","contestId":"926","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Choose Place"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A classroom in a school has six rows with "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" desks in each row. Two people can use the same desk: one sitting on the left and one sitting on the right. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some places are already occupied, and some places are vacant. Petya has just entered the class and wants to occupy the most convenient place. The conveniences of the places are shown on the picture:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/97d866265589e274c446cbb777838830bbcf3c178894d55b54e58180532d3e2e.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Here, the desks in the top row are the closest to the blackboard, while the desks in the bottom row are the furthest from the blackboard."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a plan of the class, where '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"' denotes an occupied place, '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' denotes a vacant place, and the aisles are denoted by '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find any of the most convenient vacant places for Petya."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" lines. Each line describes one row of desks, starting from the closest to the blackboard. Each line is given in the following format: two characters, each is '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' — the description of the left desk in the current row; a character '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"' — the aisle; two characters, each is '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' — the description of the center desk in the current row; a character '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"' — the aisle; two characters, each is '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' — the description of the right desk in the current row. So, the length of each of the six lines is "},{"kind":"math_inline","text":"8"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there is at least one vacant place in the classroom."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the plan of the classroom after Petya takes one of the most convenient for him places. Mark this place with the letter '"},{"children":[{"kind":"text","text":"P"}],"kind":"container"},{"kind":"text","text":"'. There should be exactly one letter '"},{"children":[{"kind":"text","text":"P"}],"kind":"container"},{"kind":"text","text":"' in the plan. Petya can only take a vacant place. In all other places the output should coincide with the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"..-**-..\n..-**-..\n..-..-..\n..-..-..\n..-..-..\n..-..-..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"..-**-..\n..-**-..\n..-..-..\n..-P.-..\n..-..-..\n..-..-..\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"**-**-**\n**-**-**\n..-**-.*\n**-**-**\n..-..-..\n..-**-..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"**-**-**\n**-**-**\n..-**-.*\n**-**-**\n..-P.-..\n..-**-..\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children"