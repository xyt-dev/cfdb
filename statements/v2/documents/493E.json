{"assets":["/statement-assets/be028b24ac3f2aae57dbd1e5931b4616407ffb98ee672bf61b8e590b5c876812.png","/statement-assets/8c4e50f4024d096a913585f3e746c5da6527ed9ec29ca201f556c18fb126acef.png","/statement-assets/a8c70c85c56db197f308f993cf9ff86496fcf8268ab8c4dc358cc868bf68aa5b.png","/statement-assets/30bf7752da7648ffd201e2307daa2102e723169034a19a67e4c76503fe2523d6.png"],"contentKind":"statement","contestId":"493","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Vasya and Polynomial"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya is studying in the last class of school and soon he will take exams. He decided to study polynomials. "},{"children":[{"kind":"text","text":"Polynomial"}],"kind":"container"},{"kind":"text","text":" is a function "},{"kind":"math_inline","text":"P(x) = a0 + a1x1 + ... + anxn"},{"kind":"text","text":". Numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" are called "},{"children":[{"kind":"text","text":"coefficients"}],"kind":"container"},{"kind":"text","text":" of a polynomial, non-negative integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is called a "},{"children":[{"kind":"text","text":"degree"}],"kind":"container"},{"kind":"text","text":" of a polynomial."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya has made a bet with his friends that he can solve any problem with polynomials. They suggested him the problem: \"Determine how many polynomials "},{"kind":"math_inline","text":"P(x)"},{"kind":"text","text":" exist with "},{"children":[{"kind":"text","text":"integer non-negative"}],"kind":"container"},{"kind":"text","text":" coefficients so that "},{"attrs":{"alt":"","src":"/statement-assets/be028b24ac3f2aae57dbd1e5931b4616407ffb98ee672bf61b8e590b5c876812.png"},"kind":"image"},{"kind":"text","text":", and "},{"attrs":{"alt":"","src":"/statement-assets/8c4e50f4024d096a913585f3e746c5da6527ed9ec29ca201f556c18fb126acef.png"},"kind":"image"},{"kind":"text","text":", where "},{"attrs":{"alt":"","src":"/statement-assets/a8c70c85c56db197f308f993cf9ff86496fcf8268ab8c4dc358cc868bf68aa5b.png"},"kind":"image"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are given positive integers\"? "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya does not like losing bets, but he has no idea how to solve this task, so please help him to solve the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input contains three integer positive numbers "},{"attrs":{"alt":"","src":"/statement-assets/30bf7752da7648ffd201e2307daa2102e723169034a19a67e4c76503fe2523d6.png"},"kind":"image"},{"kind":"text","text":" no greater than "},{"kind":"math_inline","text":"1018"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is an infinite number of such polynomials, then print \""},{"children":[{"kind":"text","text":"inf"}],"kind":"container"},{"kind":"text","text":"\" "},{"children":[{"kind":"text","text":"without quotes"}],"kind":"container"},{"kind":"text","text":", otherwise print the reminder of an answer modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"493E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/493/problem/E"}