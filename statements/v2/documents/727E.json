{"assets":[],"contentKind":"statement","contestId":"727","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Games on a CD"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Several years ago Tolya had "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" computer games and at some point of time he decided to burn them to CD. After that he wrote down the names of the games one after another in a circle on the CD "},{"children":[{"kind":"text","text":"in clockwise order"}],"kind":"container"},{"kind":"text","text":". The names were distinct, the length of each name was equal to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". The names didn't overlap."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus, there is a cyclic string of length "},{"kind":"math_inline","text":"n·k"},{"kind":"text","text":" written on the CD."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Several years have passed and now Tolya can't remember which games he burned to his CD. He knows that there were "},{"kind":"math_inline","text":"g"},{"kind":"text","text":" popular games that days. All of the games he burned were among these "},{"kind":"math_inline","text":"g"},{"kind":"text","text":" games, and "},{"children":[{"kind":"text","text":"no game was burned more than once"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to restore any valid list of games Tolya could burn to the CD several years ago."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 105"},{"kind":"text","text":") — the amount of games Tolya burned to the CD, and the length of each of the names."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains one string consisting of lowercase English letters — the string Tolya wrote on the CD, split in arbitrary place. The length of the string is "},{"kind":"math_inline","text":"n·k"},{"kind":"text","text":". It is guaranteed that the length is not greater than "},{"kind":"math_inline","text":"106"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line of the input contains one positive integer "},{"kind":"math_inline","text":"g"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"n ≤ g ≤ 105"},{"kind":"text","text":") — the amount of popular games that could be written on the CD. It is guaranteed that the total length of names of all popular games is not greater than "},{"kind":"math_inline","text":"2·106"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"g"},{"kind":"text","text":" lines contains a single string — the name of some popular game. Each name consists of lowercase English letters and has length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". It is guaranteed that the names are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no answer, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print two lines. In the first line print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes). In the second line, print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers — the games which names were written on the CD. You should print games in the order they could have been written on the CD, it means, "},{"children":[{"kind":"text","text":"in clockwise order"}],"kind":"container"},{"kind":"text","text":". You can print games starting from any position. Remember, that no game was burned to the CD more than once. If there are several possible answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\nabc\n4\nb\na\nc\nd\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n2 1 3 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\naabbccdd\n4\ndd\nab\nbc\ncd\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"727E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/727/problem/E"}