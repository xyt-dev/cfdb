{"assets":["/statement-assets/27a195379b9497472d1533998a58e35ddcc67fbbcb1748a5ba9371b8160291d0.png","/statement-assets/804c39b8c1433591fe28f5ba4858e296b3038527af3657c2f20bafab21af2b84.png","/statement-assets/12c710b34494c3a9ca30a8575325a15194e743ab4eb8cdc4460284de4228b872.png","/statement-assets/a3ec69b81ad4d15b65d55f09c1ad3713afdb9e4522408c4aece9a4380ffe0583.png"],"contentKind":"statement","contestId":"1002","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E1. Bernstein-Vazirani algorithm"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a quantum oracle - an operation on "},{"kind":"math_inline","text":"N + 1"},{"kind":"text","text":" qubits which implements a function "},{"attrs":{"alt":"","src":"/statement-assets/27a195379b9497472d1533998a58e35ddcc67fbbcb1748a5ba9371b8160291d0.png"},"kind":"image"},{"kind":"text","text":". You are guaranteed that the function "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" implemented by the oracle is scalar product function (oracle from problem D1): "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/804c39b8c1433591fe28f5ba4858e296b3038527af3657c2f20bafab21af2b84.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Here "},{"attrs":{"alt":"","src":"/statement-assets/12c710b34494c3a9ca30a8575325a15194e743ab4eb8cdc4460284de4228b872.png"},"kind":"image"},{"kind":"text","text":" (an array of "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" integers, each of which can be 0 or 1). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to reconstruct the array "},{"attrs":{"alt":"","src":"/statement-assets/a3ec69b81ad4d15b65d55f09c1ad3713afdb9e4522408c4aece9a4380ffe0583.png"},"kind":"image"},{"kind":"text","text":". Your code is allowed to call the given oracle only once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to implement an operation which takes the following inputs:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" an integer "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" - the number of qubits in the oracle input ("},{"kind":"math_inline","text":"1 ≤ N ≤ 8"},{"kind":"text","text":"),"}],"kind":"list_item"},{"children":[{"kind":"text","text":" an oracle "},{"kind":"math_inline","text":"Uf"},{"kind":"text","text":", implemented as an operation with signature "},{"children":[{"kind":"text","text":"((Qubit[], Qubit) => ())"}],"kind":"container"},{"kind":"text","text":", i.e., an operation which takes as input an array of qubits and an output qubit and has no output."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The return of your operation is an array of integers of length "},{"kind":"math_inline","text":"N"},{"kind":"text","text":", each of them 0 or 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your code should have the following signature:"}],"kind":"paragraph"},{"kind":"code_block","text":"namespace Solution {\n    open Microsoft.Quantum.Primitive;\n    open Microsoft.Quantum.Canon;\n\n    operation Solve (N : Int, Uf : ((Qubit[], Qubit) => ())) : Int[]\n    {\n        body\n        {\n            // your code here\n        }\n    }\n}"}],"kind":"section"}],"kind":"document"},"index":"E1","problemCode":"1002E1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1002/problem/E1"}