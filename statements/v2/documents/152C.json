{"assets":[],"contentKind":"statement","contestId":"152","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Pocket Book"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day little Vasya found mom's pocket book. The book had "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" names of her friends and unusually enough, each name was exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" letters long. Let's number the names from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in the order in which they are written."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As mom wasn't home, Vasya decided to play with names: he chose three integers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i < j ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ m"},{"kind":"text","text":"), then he took names number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" and swapped their prefixes of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". For example, if we take names \""},{"children":[{"kind":"text","text":"CBDAD"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"AABRD"}],"kind":"container"},{"kind":"text","text":"\" and swap their prefixes with the length of "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", the result will be names \""},{"children":[{"kind":"text","text":"AABAD"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"CBDRD"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You wonder how many different names Vasya can write instead of name number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", if Vasya is allowed to perform any number of the described actions. As Vasya performs each action, he chooses numbers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" independently from the previous moves and his choice is based entirely on his will. The sought number can be very large, so you should only find it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100"},{"kind":"text","text":") — the number of names and the length of each name, correspondingly. Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain names, each name consists of exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" uppercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the single number — the number of different names that could end up in position number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" in the pocket book after the applying the procedures described above. Print the number modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\nAAB\nBAA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\nABABA\nBCGDG\nAAAAA\nYABSA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"216\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Vasya can get the following names in the position number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":": \"AAB\", \"AAA\", \"BAA\" and \"BAB\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"152C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/152/problem/C"}