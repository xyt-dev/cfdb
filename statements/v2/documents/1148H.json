{"assets":[],"contentKind":"statement","contestId":"1148","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Holy Diver "}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array which is initially empty. You need to perform $$$n$$$ operations of the given format: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \"$$$a$$$ $$$l$$$ $$$r$$$ $$$k$$$\": append $$$a$$$ to the end of the array. After that count the number of integer pairs $$$x, y$$$ such that $$$l \\leq x \\leq y \\leq r$$$ and $$$\\operatorname{mex}(a_{x}, a_{x+1}, \\ldots, a_{y}) = k$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The elements of the array are numerated from $$$1$$$ in the order they are added to the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To make this problem more tricky we don't say your real parameters of the queries. Instead your are given $$$a'$$$, $$$l'$$$, $$$r'$$$, $$$k'$$$. To get $$$a$$$, $$$l$$$, $$$r$$$, $$$k$$$ on the $$$i$$$-th operation you need to perform the following: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a := (a' + lans) \\bmod(n + 1)$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$l := (l' + lans) \\bmod{i} + 1$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$r := (r' + lans) \\bmod{i} + 1$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if $$$l \\gt r$$$ swap $$$l$$$ and $$$r$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$k := (k' + lans) \\bmod(n + 1)$$$, "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" where $$$lans$$$ is the answer to the previous operation, initially $$$lans$$$ is equal to zero. $$$i$$$ is the id of the operation, operations are numbered from $$$1$$$."},{"children":[{"kind":"text","text":"The $$$\\operatorname{mex}(S)$$$, where $$$S$$$ is a multiset of non-negative integers, is the smallest non-negative integer which does not appear in the set. For example, $$$\\operatorname{mex}(\\{2, 2, 3\\}) = 0$$$ and $$$\\operatorname{mex} (\\{0, 1, 4, 1, 6\\}) = 2$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$1 \\leq n \\leq 2 \\cdot 10^5$$$) — the length of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n$$$ lines contain the description of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of them $$$n$$$ lines contains four non-negative integers $$$a'$$$, $$$l'$$$, $$$r'$$$, $$$k'$$$ ($$$0, \\leq a', l', r', k' \\leq 10^9$$$), describing one operation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query print a single integer — the answer to this query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n0 0 0 1\n0 1 0 5\n5 2 1 0\n5 2 1 0\n2 4 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n1\n2\n6\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n2 0 0 2\n2 0 1 1\n0 0 2 0\n3 2 2 0\n0 2 3 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n0\n3\n0\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first example the decoded values of $$$a$$$, $$$l$$$, $$$r$$$, $$$k$$$ are the following:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$a_1=0,l_1=1,r_1=1,k_1=1$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$a_2=1,l_2=1,r_2=2,k_2=0$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$a_3=0,l_3=1,r_3=3,k_3=1$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$a_4=1,l_4=1,r_4=4,k_4=2$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$a_5=2,l_5=1,r_5=5,k_5=3$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second example the decoded values of $$$a$$$, $$$l$$$, $$$r$$$, $$$k$$$ are the following:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$a_1=2,l_1=1,r_1=1,k_1=2$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$a_2=2,l_2=1,r_2=2,k_2=1$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$a_3=0,l_3=1,r_3=3,k_3=0$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$a_4=0,l_4=2,r_4=2,k_4=3$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$a_5=0,l_5=3,r_5=4,k_5=0$$$"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"1148H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1148/problem/H"}