{"assets":["/statement-assets/bb5fb6b0f8004052d04cb6eeff767f98b902d304e4553a684f15602c9c3eda65.png","/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"],"contentKind":"statement","contestId":"599","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Patrick and Shopping"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Today Patrick waits for a visit from his friend Spongebob. To prepare for the visit, Patrick needs to buy some goodies in two stores located near his house. There is a "},{"kind":"math_inline","text":"d1"},{"kind":"text","text":" meter long road between his house and the first shop and a "},{"kind":"math_inline","text":"d2"},{"kind":"text","text":" meter long road between his house and the second shop. Also, there is a road of length "},{"kind":"math_inline","text":"d3"},{"kind":"text","text":" directly connecting these two shops to each other. Help Patrick calculate the minimum distance that he needs to walk in order to go to both shops and return to his house."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/bb5fb6b0f8004052d04cb6eeff767f98b902d304e4553a684f15602c9c3eda65.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Patrick always starts at his house. He should visit both shops moving only along the three existing roads and return back to his house. He doesn't mind visiting the same shop or passing the same road multiple times. The only goal is to minimize the total distance traveled."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"d1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"d2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"d3"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ d1, d2, d3 ≤ 108"},{"kind":"text","text":") — the lengths of the paths. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"d1"},{"kind":"text","text":" is the length of the path connecting Patrick's house and the first shop; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"d2"},{"kind":"text","text":" is the length of the path connecting Patrick's house and the second shop; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"d3"},{"kind":"text","text":" is the length of the path connecting both shops. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum distance that Patrick will have to walk in order to visit both shops and return to his house."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 20 30\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"60\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first sample is shown on the picture in the problem statement. One of the optimal routes is: house "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" first shop "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" second shop "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" house."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample one of the optimal routes is: house "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" first shop "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" house "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" second shop "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" house."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"599A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/599/problem/A"}