on"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n10\n0\n-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, you have to make 4 successful submissions. Your success rate will be equal to "},{"kind":"math_inline","text":"7 / 14"},{"kind":"text","text":", or "},{"kind":"math_inline","text":"1 / 2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, you have to make 2 successful and 8 unsuccessful submissions. Your success rate will be equal to "},{"kind":"math_inline","text":"9 / 24"},{"kind":"text","text":", or "},{"kind":"math_inline","text":"3 / 8"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, there is no need to make any new submissions. Your success rate is already equal to "},{"kind":"math_inline","text":"20 / 70"},{"kind":"text","text":", or "},{"kind":"math_inline","text":"2 / 7"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example, the only unsuccessful submission breaks your hopes of having the success rate equal to 1."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"773A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/773/problem/A"}