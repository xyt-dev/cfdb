{"assets":["/statement-assets/2456292d9ddd28c85ad3dd05a2b1dc3645c9bc650deca589815671db0557b8d8.png"],"contentKind":"statement","contestId":"535","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Tavas and Malekas"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Tavas is a strange creature. Usually \"zzz\" comes out of people's mouth while sleeping, but string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" comes out from Tavas' mouth instead."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/2456292d9ddd28c85ad3dd05a2b1dc3645c9bc650deca589815671db0557b8d8.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Today Tavas fell asleep in Malekas' place. While he was sleeping, Malekas did a little process on "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Malekas has a favorite string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". He determined all positions "},{"kind":"math_inline","text":"x1 < x2 < ... < xk"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" matches "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". More formally, for each "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ k"},{"kind":"text","text":") he condition "},{"kind":"math_inline","text":"sxisxi + 1... sxi + |p| - 1 = p"},{"kind":"text","text":" is fullfilled."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then Malekas wrote down one of subsequences of "},{"kind":"math_inline","text":"x1, x2, ... xk"},{"kind":"text","text":" (possibly, he didn't write anything) on a piece of paper. Here a sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is a subsequence of sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" if and only if we can turn "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" by removing some of its elements (maybe no one of them or all)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After Tavas woke up, Malekas told him everything. He couldn't remember string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", but he knew that both "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" only contains lowercase English letters and also he had the subsequence he had written on that piece of paper."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Tavas wonders, what is the number of possible values of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"? He asked SaDDas, but he wasn't smart enough to solve this. So, Tavas asked you to calculate this number for him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Answer can be very large, so Tavas wants you to print the answer modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", the length of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and the length of the subsequence Malekas wrote down ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"0 ≤ m ≤ n - |p| + 1"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |p| ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space separated integers "},{"kind":"math_inline","text":"y1, y2, ..., ym"},{"kind":"text","text":", Malekas' subsequence ("},{"kind":"math_inline","text":"1 ≤ y1 < y2 < ... < ym ≤ n - |p| + 1"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print the answer modulo "},{"kind":"math_inline","text":"1000 000 007"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2\nioi\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"26\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\nioi\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test all strings of form "},{"children":[{"kind":"text","text":"\"ioioi?\""}],"kind":"container"},{"kind":"text","text":" where the question mark replaces arbitrary English letter satisfy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here "},{"kind":"math_inline","text":"|x|"},{"kind":"text","text":" denotes the length of string x."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please note that it's possible that there is no such string (answer is 0)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"535D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/535/problem/D"}