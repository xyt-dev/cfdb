{"assets":[],"contentKind":"statement","contestId":"396","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. On Iteration of One Well-Known Function"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Of course, many of you can calculate "},{"kind":"math_inline","text":"φ(n)"},{"kind":"text","text":" — the number of positive integers that are less than or equal to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", that are coprime with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". But what if we need to calculate "},{"kind":"math_inline","text":"φ(φ(...φ(n)))"},{"kind":"text","text":", where function "},{"kind":"math_inline","text":"φ"},{"kind":"text","text":" is taken "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" times and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is given in the canonical decomposition into prime factors? "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", calculate the value of "},{"kind":"math_inline","text":"φ(φ(...φ(n)))"},{"kind":"text","text":". Print the result in the canonical decomposition into prime factors."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":") — the number of distinct prime divisors in the canonical representaion of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains a pair of space-separated integers "},{"kind":"math_inline","text":"pi, ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ pi ≤ 106; 1 ≤ ai ≤ 1017"},{"kind":"text","text":") — another prime divisor of number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and its power in the canonical representation. The sum of all "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" doesn't exceed "},{"kind":"math_inline","text":"1017"},{"kind":"text","text":". Prime divisors in the input follow in the strictly increasing order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line contains integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 1018"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, print integer "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" — the number of distinct prime divisors of number "},{"kind":"math_inline","text":"φ(φ(...φ(n)))"},{"kind":"text","text":", where function "},{"kind":"math_inline","text":"φ"},{"kind":"text","text":" is taken "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" lines must contain two space-separated integers "},{"kind":"math_inline","text":"qi, bi"},{"kind":"math_inline","text":"(bi ≥ 1)"},{"kind":"text","text":" — another prime divisor and its power in the canonical representaion of the result. Numbers "},{"kind":"math_inline","text":"qi"},{"kind":"text","text":" must go in the strictly increasing order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n7 1\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 1\n3 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n7 1\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n2 100000000000000000\n10000000000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2 90000000000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind