{"assets":[],"contentKind":"statement","contestId":"234","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Merging Two Decks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"input_channel"},"children":[{"children":[{"kind":"text","text":"input"}],"kind":"container"},{"kind":"text","text":"input.txt"}],"kind":"container"},{"attrs":{"role":"output_channel"},"children":[{"children":[{"kind":"text","text":"output"}],"kind":"container"},{"kind":"text","text":"output.txt"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are two decks of cards lying on the table in front of you, some cards in these decks lay face up, some of them lay face down. You want to merge them into one deck in which each card is face down. You're going to do it in two stages."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first stage is to merge the two decks in such a way that the relative order of the cards from the same deck doesn't change. That is, for any two different cards "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" in one deck, if card "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" lies above card "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", then after the merge card "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" must also be above card "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second stage is performed on the deck that resulted from the first stage. At this stage, the executed operation is the turning operation. In one turn you can take a few of the top cards, turn all of them, and put them back. Thus, each of the taken cards gets turned and the order of these cards is reversed. That is, the card that was on the bottom before the turn, will be on top after it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to make sure that all the cards are lying face down. Find such an order of merging cards in the first stage and the sequence of turning operations in the second stage, that make all the cards lie face down, and the number of turns is minimum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the number of cards in the first deck "},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second input line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, separated by single spaces "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(0 ≤ ai ≤ 1)"},{"kind":"text","text":". Value "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" equals 0, if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th card is lying face down, and 1, if the card is lying face up. The cards are given in the order from the topmost one to the bottommost one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third input line contains integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the number of cards in the second deck "},{"kind":"math_inline","text":"(1 ≤ m ≤ 105)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fourth input line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers, separated by single spaces "},{"kind":"math_inline","text":"b1, b2, ..., bm"},{"kind":"math_inline","text":"(0 ≤ bi ≤ 1)"},{"kind":"text","text":". Value "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" equals 0, if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th card is lying face down, and 1, if the card is lying face up. The cards are given in the order from the topmost to the bottommost."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print "},{"kind":"math_inline","text":"n + m"},{"kind":"text","text":" space-separated integers — the numbers of the cards in the order, in which they will lie after the first stage. List the cards from top to bottom. The cards from the first deck should match their indexes from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in the order from top to bottom. The cards from the second deck should match their indexes, increased by "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", that is, numbers from "},{"kind":"math_inline","text":"n + 1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n + m"},{"kind":"text","text":" in the order from top to bottom."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print a single integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" — the minimum number of turn operations you need to make all cards in the deck lie face down. In the third line print "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"c1, c2, ..., cx"},{"kind":"math_inline","text":"(1 ≤ ci ≤ n + m)"},{"kind":"text","text":", each of them represents the number of cards to take from the top of the deck to perform a turn operation. Print the operations in the order, in which they should be performed. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple optimal solutions, print any of them. It is guaranteed that the minimum number of operations doesn't exceed "},{"kind":"math_inline","text":"6·105"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 0 1\n4\n1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 4 5 6 7 2 3\n3\n5 6 7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 1 1 1 1\n5\n0 1 0 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6 1 2 3 4 5 7 8 9 10\n4\n1 7 8 9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"234H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/234/problem/H"}