{"assets":[],"contentKind":"statement","contestId":"1011","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Stages"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Natasha is going to fly to Mars. She needs to build a rocket, which consists of several stages in some order. Each of the stages is defined by a lowercase Latin letter. This way, the rocket can be described by the string — concatenation of letters, which correspond to the stages."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are $$$n$$$ stages available. The rocket must contain exactly $$$k$$$ of them. Stages in the rocket should be ordered by their weight. So, after the stage with some letter can go only stage with a letter, which is at least two positions after in the alphabet (skipping one letter in between, or even more). For example, after letter '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"' can't go letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":"', but can go letters '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"f"}],"kind":"container"},{"kind":"text","text":"', ..., '"},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the rocket to fly as far as possible, its weight should be minimal. The weight of the rocket is equal to the sum of the weights of its stages. The weight of the stage is the number of its letter in the alphabet. For example, the stage '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" 'weighs one ton,' "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":" 'weighs two tons, and' "},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"' — $$$26$$$ tons."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Build the rocket with the minimal weight or determine, that it is impossible to build a rocket at all. Each stage can be used at most once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers — $$$n$$$ and $$$k$$$ ($$$1 \\le k \\le n \\le 50$$$) – the number of available stages and the number of stages to use in the rocket."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains string $$$s$$$, which consists of exactly $$$n$$$ lowercase Latin letters. Each letter defines a new stage, which can be used to build the rocket. Each stage can be used at most once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimal total weight of the rocket or "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":", if it is impossible to build the rocket at all."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\nxyabd\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"29"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 4\nproblem\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"34"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\nab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"12 1\nabaabbaaabbb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the following rockets satisfy the condition:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"adx"}],"kind":"container"},{"kind":"text","text":"\" (weight is $$$1+4+24=29$$$);"}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"ady"}],"kind":"container"},{"kind":"text","text":"\" (weight is $$$1+4+25=30$$$);"}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"bdx"}],"kind":"container"},{"kind":"text","text":"\" (weight is $$$2+4+24=30$$$);"}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"bdy"}],"kind":"container"},{"kind":"text","text":"\" (weight is $$$2+4+25=31$$$)."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Rocket \""},{"children":[{"kind":"text","text":"adx"}],"kind":"container"},{"kind":"text","text":"\" has the minimal weight, so the answer is $$$29$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, target rocket is \""},{"children":[{"kind":"text","text":"belo"}],"kind":"container"},{"kind":"text","text":"\". Its weight is $$$2+5+12+15=34$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, $$$n=k=2$$$, so the rocket must have both stages: '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"'. This rocket doesn't satisfy the condition, because these letters are adjacent in the alphabet. Answer is "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1011A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1011/problem/A"}