{"assets":["/statement-assets/11c2021f31b3aa5411172e0b6396428ddef6fa3b5c3c915827018a5cdc8b1ee1.png"],"contentKind":"statement","contestId":"1096","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Polygon for the Angle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an angle $$$\\text{ang}$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Jury asks You to find such "},{"children":[{"kind":"text","text":"regular"}],"kind":"container"},{"kind":"text","text":" $$$n$$$-gon (regular polygon with $$$n$$$ vertices) that it has three vertices $$$a$$$, $$$b$$$ and $$$c$$$ (they can be non-consecutive) with $$$\\angle{abc} = \\text{ang}$$$ or report that there is no such $$$n$$$-gon."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/11c2021f31b3aa5411172e0b6396428ddef6fa3b5c3c915827018a5cdc8b1ee1.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"If there are several answers, print the "},{"children":[{"kind":"text","text":"minimal"}],"kind":"container"},{"kind":"text","text":" one. It is guarantied that if answer exists then it doesn't exceed $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer $$$T$$$ ($$$1 \\le T \\le 180$$$) — the number of queries. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$T$$$ lines contains one integer $$$\\text{ang}$$$ ($$$1 \\le \\text{ang} \\lt 180$$$) — the angle measured "},{"children":[{"kind":"text","text":"in degrees"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query print single integer $$$n$$$ ($$$3 \\le n \\le 998244353$$$) — minimal possible number of vertices in the regular $$$n$$$-gon or $$$-1$$$ if there is no such $$$n$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n54\n50\n2\n178\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n18\n90\n180\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The answer for the first query is on the picture above."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer for the second query is reached on a regular $$$18$$$-gon. For example, $$$\\angle{v_2 v_1 v_6} = 50^{\\circ}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The example angle for the third query is $$$\\angle{v_{11} v_{10} v_{12}} = 2^{\\circ}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth query, minimal possible $$$n$$$ is $$$180$$$ (not $$$90$$$)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1096C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1096/problem/C"}