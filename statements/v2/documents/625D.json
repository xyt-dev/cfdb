{"assets":[],"contentKind":"statement","contestId":"625","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Finals in arithmetic"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vitya is studying in the third grade. During the last math lesson all the pupils wrote on arithmetic quiz. Vitya is a clever boy, so he managed to finish all the tasks pretty fast and Oksana Fillipovna gave him a new one, that is much harder."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's denote a "},{"children":[{"kind":"text","text":"flip operation"}],"kind":"container"},{"kind":"text","text":" of an integer as follows: number is considered in decimal notation and then reverted. If there are any leading zeroes afterwards, they are thrown away. For example, if we flip "},{"kind":"math_inline","text":"123"},{"kind":"text","text":" the result is the integer "},{"kind":"math_inline","text":"321"},{"kind":"text","text":", but flipping "},{"kind":"math_inline","text":"130"},{"kind":"text","text":" we obtain "},{"kind":"math_inline","text":"31"},{"kind":"text","text":", and by flipping "},{"kind":"math_inline","text":"31"},{"kind":"text","text":" we come to "},{"kind":"math_inline","text":"13"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Oksana Fillipovna picked some number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" without leading zeroes, and flipped it to get number "},{"kind":"math_inline","text":"ar"},{"kind":"text","text":". Then she summed "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ar"},{"kind":"text","text":", and told Vitya the resulting value "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". His goal is to find any valid "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As Oksana Fillipovna picked some small integers as "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ar"},{"kind":"text","text":", Vitya managed to find the answer pretty fast and became interested in finding some general algorithm to deal with this problem. Now, he wants you to write the program that for given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" finds any "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" without leading zeroes, such that "},{"kind":"math_inline","text":"a + ar = n"},{"kind":"text","text":" or determine that such "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" doesn't exist."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10100 000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no such positive integer "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" without leading zeroes that "},{"kind":"math_inline","text":"a + ar = n"},{"kind":"text","text":" then print "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". Otherwise, print any valid "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". If there are many possible answers, you are allowed to pick any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"33\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"21\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample "},{"kind":"math_inline","text":"4 = 2 + 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a = 2"},{"kind":"text","text":" is the only possibility."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample "},{"kind":"math_inline","text":"11 = 10 + 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a = 10"},{"kind":"text","text":" — the only valid solution. Note, that "},{"kind":"math_inline","text":"a = 01"},{"kind":"text","text":" is incorrect, because "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" can't have leading zeroes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's easy to check that there is no suitable "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" in the third sample."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth sample "},{"kind":"math_inline","text":"33 = 30 + 3 = 12 + 21"},{"kind":"text","text":", so there are three possibilities for "},{"kind":"math_inline","text":"a"},{"kind":"text","text":": "},{"kind":"math_inline","text":"a = 30"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a = 12"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a = 21"},{"kind":"text","text":". Any of these is considered to be correct answer."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"625D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/625/problem/D"}