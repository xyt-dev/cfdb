{"assets":[],"contentKind":"statement","contestId":"315","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Sereja and Bottles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sereja and his friends went to a picnic. The guys had "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" soda bottles just for it. Sereja forgot the bottle opener as usual, so the guys had to come up with another way to open bottles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sereja knows that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th bottle is from brand "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", besides, you can use it to open "},{"children":[{"kind":"text","text":"other"}],"kind":"container"},{"kind":"text","text":" bottles of brand "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". You can use one bottle to open multiple other bottles. Sereja can open bottle with opened bottle or closed bottle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Knowing this, Sereja wants to find out the number of bottles they've got that they won't be able to open in any way. Help him and find this number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 100)"},{"kind":"text","text":" — the number of bottles. The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the bottles' description. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two integers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"math_inline","text":"(1 ≤ ai, bi ≤ 1000)"},{"kind":"text","text":" — the description of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th bottle."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print a single integer — the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1\n2 2\n3 3\n4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2\n2 3\n3 4\n4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"315A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/315/problem/A"