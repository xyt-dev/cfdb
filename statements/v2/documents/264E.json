{"assets":["/statement-assets/fa1afcef31e510acbd54f942b3422558c26a8ff3b1a7ef7a1ea7393e86700dad.png"],"contentKind":"statement","contestId":"264","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Roadside Trees"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Squirrel Liss loves nuts. Liss asks you to plant some nut trees."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positions (numbered 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from west to east) to plant a tree along a street. Trees grow one meter per month. At the beginning of each month you should process one query. The query is one of the following types:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Plant a tree of height "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" at position "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Cut down the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-th existent (not cut) tree from the west (where "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is 1-indexed). When we cut the tree it drops down and takes all the available place at the position where it has stood. So no tree can be planted at this position anymore. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"After processing each query, you should print the length of the longest increasing subsequence. A subset of existent trees is called an "},{"children":[{"kind":"text","text":"increasing subsequence"}],"kind":"container"},{"kind":"text","text":" if the height of the trees in the set is strictly increasing from west to east (for example, the westmost tree in the set must be the shortest in the set). The length of the increasing subsequence is the number of trees in it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that Liss don't like the trees with the same heights, so it is guaranteed that at any time no two trees have the exactly same heights."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤ n ≤ 105; 1 ≤ m ≤ 2·105"},{"kind":"text","text":") — the number of positions and the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains the information of queries by following formats:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query is type 1, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains three integers: 1, "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n, 1 ≤ hi ≤ 10"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" is the position of the new tree and "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" is the initial height of the new tree. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query is type 2, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two integers: 2 and "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ 10"},{"kind":"text","text":"), where the "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" is the index of the tree we want to cut. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The input is guaranteed to be correct, i.e.,"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" For type 1 queries, "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" will be pairwise distinct. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For type 2 queries, "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" will be less than or equal to the current number of trees. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" At any time no two trees have the exactly same heights. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In each line integers are separated by single spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers — the length of the longest increasing subsequence after each query. Separate the numbers by whitespaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 6\n1 1 1\n1 4 4\n1 3 4\n2 2\n1 2 8\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n3\n2\n2\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"States of street after each query you can see on the following animation:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/fa1afcef31e510acbd54f942b3422558c26a8ff3b1a7ef7a1ea7393e86700dad.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"If your browser doesn't support animation png, please see the gif version here: http://212.193.37.254/codeforces/images/162/roadtree.gif"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"264E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/264/problem/E"}