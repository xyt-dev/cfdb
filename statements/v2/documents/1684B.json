{"assets":[],"contentKind":"statement","contestId":"1684","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Z mod X = C"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given three positive integers $$$a$$$, $$$b$$$, $$$c$$$ ($$$a \\lt b \\lt c$$$). You have to find three positive integers $$$x$$$, $$$y$$$, $$$z$$$ such that:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$x \\bmod y = a,$$$$$$ $$$$$$y \\bmod z = b,$$$$$$ $$$$$$z \\bmod x = c.$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here $$$p \\bmod q$$$ denotes the remainder from dividing $$$p$$$ by $$$q$$$. It is possible to show that for such constraints the answer always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of multiple test cases. The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10\\,000$$$) — the number of test cases. Description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case contains a single line with three integers $$$a$$$, $$$b$$$, $$$c$$$ ($$$1 \\le a \\lt b \\lt c \\le 10^8$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case output three positive integers $$$x$$$, $$$y$$$, $$$z$$$ ($$$1 \\le x, y, z \\le 10^{18}$$$) such that $$$x \\bmod y = a$$$, $$$y \\bmod z = b$$$, $$$z \\bmod x = c$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output any correct answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 3 4\n127 234 421\n2 7 8\n59 94 388\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n12 11 4\n1063 234 1484\n25 23 8\n2221 94 2609\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$x \\bmod y = 12 \\bmod 11 = 1;$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$y \\bmod z = 11 \\bmod 4 = 3;$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$z \\bmod x = 4 \\bmod 12 = 4.$$$$$$"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1684B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1684/problem/B"}