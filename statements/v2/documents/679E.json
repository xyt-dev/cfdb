{"assets":["/statement-assets/1c536d79168492d2cd40f866d37a4e0af452d5b1064eb2150f73cbe6ba609860.png"],"contentKind":"statement","contestId":"679","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Bear and Bad Powers of 42"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Limak, a bear, isn't good at handling queries. So, he asks you to do it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We say that powers of "},{"kind":"math_inline","text":"42"},{"kind":"text","text":" (numbers "},{"kind":"math_inline","text":"1, 42, 1764, ..."},{"kind":"text","text":") are "},{"children":[{"kind":"text","text":"bad"}],"kind":"container"},{"kind":"text","text":". Other numbers are "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" good integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":". Your task is to handle "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries of three types:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"children":[{"kind":"text","text":"1 i"}],"kind":"container"},{"kind":"text","text":" — print "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" in a separate line. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"2 a b x"}],"kind":"container"},{"kind":"text","text":" — for "},{"attrs":{"alt":"","src":"/statement-assets/1c536d79168492d2cd40f866d37a4e0af452d5b1064eb2150f73cbe6ba609860.png"},"kind":"image"},{"kind":"text","text":" set "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". It's guaranteed that "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is a good number. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"3 a b x"}],"kind":"container"},{"kind":"text","text":" — for "},{"attrs":{"alt":"","src":"/statement-assets/1c536d79168492d2cd40f866d37a4e0af452d5b1064eb2150f73cbe6ba609860.png"},"kind":"image"},{"kind":"text","text":" increase "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". After this repeat the process while at least one "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" is bad. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You can note that after each query all "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" are good."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, q ≤ 100 000"},{"kind":"text","text":") — the size of Limak's sequence and the number of queries, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ ti ≤ 109"},{"kind":"text","text":") — initial elements of Limak's sequence. All "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" are good."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then, "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines follow. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them describes the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query. The first number in the line is an integer "},{"kind":"math_inline","text":"typei"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ typei ≤ 3"},{"kind":"text","text":") — the type of the query. There is at least one query of the first type, so the output won't be empty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In queries of the second and the third type there is "},{"kind":"math_inline","text":"1 ≤ a ≤ b ≤ n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In queries of the second type an integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ x ≤ 109"},{"kind":"text","text":") is guaranteed to be good."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In queries of the third type an integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ 109"},{"kind":"text","text":") may be bad."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the first type, print the answer in a separate line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 12\n40 1700 7 1672 4 1722\n3 2 4 42\n1 2\n1 3\n3 2 6 50\n1 2\n1 4\n1 6\n2 3 4 41\n3 1 5 1\n1 1\n1 3\n1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1742\n49\n1842\n1814\n1822\n43\n44\n107\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"After a query "},{"children":[{"kind":"text","text":"3 2 4 42"}],"kind":"container"},{"kind":"text","text":" the sequence is "},{"kind":"math_inline","text":"40, 1742, 49, 1714, 4, 1722"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After a query "},{"children":[{"kind":"text","text":"3 2 6 50"}],"kind":"container"},{"kind":"text","text":" the sequence is "},{"kind":"math_inline","text":"40, 1842, 149, 1814, 104, 1822"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After a query "},{"children":[{"kind":"text","text":"2 3 4 41"}],"kind":"container"},{"kind":"text","text":" the sequence is "},{"kind":"math_inline","text":"40, 1842, 41, 41, 104, 1822"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After a query "},{"children":[{"kind":"text","text":"3 1 5 1"}],"kind":"container"},{"kind":"text","text":" the sequence is "},{"kind":"math_inline","text":"43, 1845, 44, 44, 107, 1822"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"679E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/679/problem/E"}