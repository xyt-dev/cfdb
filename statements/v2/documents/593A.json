{"assets":[],"contentKind":"statement","contestId":"593","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. 2Char"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Andrew often reads articles in his favorite magazine 2Char. The main feature of these articles is that each of them uses at most two distinct letters. Andrew decided to send an article to the magazine, but as he hasn't written any article, he just decided to take a random one from magazine 26Char. However, before sending it to the magazine 2Char, he needs to adapt the text to the format of the journal. To do so, he removes some words from the chosen article, in such a way that the remaining text can be written using no more than two distinct letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since the payment depends from the number of non-space characters in the article, Andrew wants to keep the words with the maximum total length."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of words in the article chosen by Andrew. Following are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each of them contains one word. All the words consist only of small English letters and their total length doesn't exceed "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":". The words are not guaranteed to be distinct, in this case you are allowed to use a word in the article as many times as it appears in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maximum possible total length of words in Andrew's article."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nabb\ncacc\naaa\nbbb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\na\na\nbcbcb\ncdecdecdecdecdecde\naaaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the optimal way to choose words is {'"},{"children":[{"kind":"text","text":"abb"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"aaa"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"bbb"}],"kind":"container"},{"kind":"text","text":"'}."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the word '"},{"children":[{"kind":"text","text":"cdecdecdecdecdecde"}],"kind":"container"},{"kind":"text","text":"' consists of three distinct letters, and thus cannot be used in the article. The optimal answer is {'"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"aaaa"}],"kind":"container"},{"kind":"text","text":"'}."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"593A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/593/problem/A"}