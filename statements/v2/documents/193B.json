{"assets":["/statement-assets/4e7503cf974c450fa6f8fd2353a71353858b570130df3b06f2505b99e10f6d5e.png","/statement-assets/0457e60d80c9054c8a457a033db1754284656700ddf556a9e29c610aa696fb24.png","/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png","/statement-assets/5b97756ea5fcf399da072b33f76977cac52061ab5469cfb54940d0e91aceccd3.png"],"contentKind":"statement","contestId":"193","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Xor"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"John Doe has four arrays: "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". Each array consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. Elements of all arrays are indexed starting from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Array "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is a permutation of integers "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"John invented a game for his friends and himself. Initially a player is given array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". The player must consecutively execute exactly "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" operations on "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". You are permitted to execute the following operations:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Operation 1: For each "},{"attrs":{"alt":"","src":"/statement-assets/4e7503cf974c450fa6f8fd2353a71353858b570130df3b06f2505b99e10f6d5e.png"},"kind":"image"},{"kind":"text","text":" change "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" into "},{"attrs":{"alt":"","src":"/statement-assets/0457e60d80c9054c8a457a033db1754284656700ddf556a9e29c610aa696fb24.png"},"kind":"image"},{"kind":"text","text":". Expression "},{"attrs":{"alt":"","src":"/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"},"kind":"image"},{"kind":"text","text":" means applying the operation of a bitwise xor to numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". The given operation exists in all modern programming languages, for example, in language "},{"children":[{"kind":"text","text":"C++"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"Java"}],"kind":"container"},{"kind":"text","text":" it is marked as \"^\", in "},{"children":[{"kind":"text","text":"Pascal"}],"kind":"container"},{"kind":"text","text":" — as \"xor\". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Operation 2: For each "},{"attrs":{"alt":"","src":"/statement-assets/4e7503cf974c450fa6f8fd2353a71353858b570130df3b06f2505b99e10f6d5e.png"},"kind":"image"},{"kind":"text","text":" change "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"api + r"},{"kind":"text","text":". When this operation is executed, all changes are made at the same time. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"After all "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" operations are applied, the number of points the player gets is determined by the formula "},{"attrs":{"alt":"","src":"/statement-assets/5b97756ea5fcf399da072b33f76977cac52061ab5469cfb54940d0e91aceccd3.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"John wants to find out what maximum number of points a player can win in his game. Help him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, u ≤ 30"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ r ≤ 100"},{"kind":"text","text":") — the number of elements in each array, the number of operations and the number that describes one of the operations. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next four lines contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers — arrays "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". The first line has array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", the second line has array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", the third line has array "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and the fourth one has array "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that elements of arrays "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are positive and do not exceed "},{"kind":"math_inline","text":"104"},{"kind":"math_inline","text":"(1 ≤ ai, bi ≤ 104)"},{"kind":"text","text":", elements of array "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" do not exceed "},{"kind":"math_inline","text":"104"},{"kind":"text","text":" in the absolute value "},{"kind":"math_inline","text":"(|k| ≤ 104)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is a permutation of numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On a single line print number "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" — the maximum number of points that a player can win in John's game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{