{"assets":[],"contentKind":"statement","contestId":"2141","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Minimum on Subarrays"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a variable $$$sum$$$, which is initially equal to $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is also a data structure that can perform the following operations:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"pushback"}],"kind":"container"},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":" — adds an element with value $$$x$$$ to the end of the structure; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"pushfront"}],"kind":"container"},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":" — adds an element with value $$$x$$$ to the beginning of the structure; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"popback"}],"kind":"container"},{"kind":"text","text":" — removes the last element from the structure; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"popfront"}],"kind":"container"},{"kind":"text","text":" — removes the first element from the structure; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"min"}],"kind":"container"},{"kind":"text","text":" — adds the value of the minimum element currently in the structure to the variable $$$sum$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The operations "},{"children":[{"kind":"text","text":"popback"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"popfront"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"min"}],"kind":"container"},{"kind":"text","text":" cannot be applied to an empty structure!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Using this structure, you would like to be able to find the sum of the minimums of all non-empty subarrays of an array $$$a$$$ of $$$n$$$ elements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, your task is to find a sequence of no more than $$$n \\cdot (n + 2)$$$ commands such that after all operations, the variable $$$sum$$$ will be equal to $$$\\sum_{0 \\le l \\le r \\lt n} \\min(a[l],\\dots, a[r])$$$ for any possible array $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$1 \\le n \\le 500$$$) — the number of elements in the array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output $$$k$$$ ($$$1 \\le k \\le n \\cdot (n + 2)$$$) commands. Each command must be one of the following five lines:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"pushback"}],"kind":"container"},{"children":[{"kind":"text","text":"a[i]"}],"kind":"container"},{"kind":"text","text":"\", where $$$i$$$ — a number from $$$0$$$ to $$$n - 1$$$ "}],"kind":"list_item"},{"children":[{"kind":"t