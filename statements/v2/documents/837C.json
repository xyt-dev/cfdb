{"assets":[],"contentKind":"statement","contestId":"837","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Two Seals"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One very important person has a piece of paper in the form of a rectangle "},{"kind":"math_inline","text":"a × b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, he has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" seals. Each seal leaves an impression on the paper in the form of a rectangle of the size "},{"kind":"math_inline","text":"xi × yi"},{"kind":"text","text":". Each impression must be parallel to the sides of the piece of paper (but seal can be rotated by 90 degrees)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A very important person wants to choose two different seals and put them two impressions. Each of the selected seals puts exactly one impression. Impressions should not overlap (but they can touch sides), and the total area occupied by them should be the largest possible. What is the largest area that can be occupied by two seals?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","t