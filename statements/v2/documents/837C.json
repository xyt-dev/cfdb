:"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 10 10\n6 6\n7 7\n20 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example you can rotate the second seal by 90 degrees. Then put impression of it right under the impression of the first seal. This will occupy all the piece of paper."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example you can't choose the last seal because it doesn't fit. By choosing the first and the third seals you occupy the largest area."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example there is no such pair of seals that they both can fit on a piece of paper."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"837C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/837/problem/C"}