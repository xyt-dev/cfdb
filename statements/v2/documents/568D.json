{"assets":[],"contentKind":"statement","contestId":"568","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Sign Posts"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One Khanate had a lot of roads and very little wood. Riding along the roads was inconvenient, because the roads did not have road signs indicating the direction to important cities."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Han decided that it's time to fix the issue, and ordered to put signs on every road. The Minister of Transport has to do that, but he has only "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" signs. Help the minister to solve his problem, otherwise the poor guy can lose not only his position, but also his head."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, every road in the Khanate is a line on the "},{"kind":"math_inline","text":"Oxy"},{"kind":"text","text":" plane, given by an equation of the form "},{"kind":"math_inline","text":"Ax + By + C = 0"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" are not equal to 0 at the same time). You are required to determine whether you can put signs in at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" points so that each road had at least one sign installed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input starts with two positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105, 1 ≤ k ≤ 5"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain three integers each, "},{"kind":"math_inline","text":"Ai, Bi, Ci"},{"kind":"text","text":", the coefficients of the equation that determines the road ("},{"kind":"math_inline","text":"|Ai|, |Bi|, |Ci| ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"Ai2 + Bi2 ≠ 0"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that no two roads coincide."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no solution, print "},{"children":[{"kind":"text","text":"\"NO\""}],"kind":"container"},{"kind":"text","text":" in the single line (without the quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print in the first line "},{"children":[{"kind":"text","text":"\"YES\""}],"kind":"container"},{"kind":"text","text":" (without the quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print a single number "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"m ≤ k"},{"kind":"text","text":") — the number of used signs. In the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines print the descriptions of their locations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Description of a location of one sign is two integers "},{"kind":"math_inline","text":"v, u"},{"kind":"text","text":". If "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" are two distinct integers between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", we assume that sign is at the point of intersection of roads number "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":". If "},{"kind":"math_inline","text":"u =  - 1"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is an integer between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", then the sign is on the road number "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" in the point not lying on any other road. In any other case the description of a sign will be assumed invalid and your answer will be considered incorrect. In case if "},{"kind":"math_inline","text":"v = u"},{"kind":"text","text":", or if "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" are the numbers of two non-intersecting roads, your answer will also be considered incorrect."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The roads are numbered starting from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" in the order in which they follow in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n1 0 0\n0 -1 0\n7 -93 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1\n1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n1 0 0\n0 1 0\n1 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n3 4 5\n5 6 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n2\n1 -1\n2 -1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Note that you do not have to minimize "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", but it shouldn't be more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first test all three roads intersect at point (0,0)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test all three roads form a triangle and there is no way to place one sign so that it would stand on all three roads at once."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"568D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/568/problem/D"}