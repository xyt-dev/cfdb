ection"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, you can't choose any $$$x$$$, $$$y$$$ because for each such pair you can find a given pair where both numbers are different from chosen integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, you can choose $$$x=2$$$ and $$$y=4$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, you can choose $$$x=1$$$ and $$$y=2$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1169B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1169/problem/B"}