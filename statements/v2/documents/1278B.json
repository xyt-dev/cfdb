{"assets":[],"contentKind":"statement","contestId":"1278","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. A and B"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two integers $$$a$$$ and $$$b$$$. You can perform a sequence of operations: during the first operation you choose one of these numbers and increase it by $$$1$$$; during the second operation you choose one of these numbers and increase it by $$$2$$$, and so on. You choose the number of these operations yourself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if $$$a = 1$$$ and $$$b = 3$$$, you can perform the following sequence of three operations: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" add $$$1$$$ to $$$a$$$, then $$$a = 2$$$ and $$$b = 3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" add $$$2$$$ to $$$b$$$, then $$$a = 2$$$ and $$$b = 5$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" add $$$3$$$ to $$$a$$$, then $$$a = 5$$$ and $$$b = 5$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Calculate the minimum number of operations required to make $$$a$$$ and $$$b$$$ equal. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 100$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains two integers $$$a$$$ and $$$b$$$ ($$$1 \\le a, b \\le 10^9$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print one integer — the minimum numbers of operations required to make $$$a$$$ and $$$b$$$ equal. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 3\n11 11\n30 20\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n0\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"First test case considered in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case integers $$$a$$$ and $$$b$$$ are already equal, so you don't need to perform any operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case you have to apply the first, the second, the third and the fourth operation to $$$b$$$ ($$$b$$$ turns into $$$20 + 1 + 2 + 3 + 4 = 30$$$)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1278B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1278/problem/B"}