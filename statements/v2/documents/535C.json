{"assets":["/statement-assets/b2190b5fcf2bb98deadc2c8f4dcc57d4b58a7173169250769df27821bbf4790e.png"],"contentKind":"statement","contestId":"535","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Tavas and Karafs"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Karafs is some kind of vegetable in shape of an "},{"kind":"math_inline","text":"1 × h"},{"kind":"text","text":" rectangle. Tavaspolis people love Karafs and they use Karafs in almost any kind of food. Tavas, himself, is crazy about Karafs."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b2190b5fcf2bb98deadc2c8f4dcc57d4b58a7173169250769df27821bbf4790e.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Each Karafs has a positive integer height. Tavas has an infinite "},{"children":[{"kind":"text","text":"1-based"}],"kind":"container"},{"kind":"text","text":" sequence of Karafses. The height of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th Karafs is "},{"kind":"math_inline","text":"si = A + (i - 1) × B"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a given "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", let's define an "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-bite operation as decreasing the height of at most "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" distinct not eaten Karafses by 1. Karafs is considered as eaten when its height becomes zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now SaDDas asks you "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" queries. In each query he gives you numbers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and you should find the largest number "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"l ≤ r"},{"kind":"text","text":" and sequence "},{"kind":"math_inline","text":"sl, sl + 1, ..., sr"},{"kind":"text","text":" can be eaten "},{"children":[{"kind":"text","text":"by performing "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-bite no more than "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" times"}],"kind":"container"},{"kind":"text","text":" or print -1 if there is no such number "},{"kind":"math_inline","text":"r"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains three integers "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ A, B ≤ 106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain information about queries. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains integers "},{"kind":"math_inline","text":"l, t, m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l, t, m ≤ 106"},{"kind":"text","text":") for "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query, print its answer in a single line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 4\n1 5 3\n3 3 10\n7 10 2\n6 4 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n-1\n8\n-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 5 2\n1 5 10\n2 7 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"535C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/535/problem/C"}