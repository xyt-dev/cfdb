{"assets":[],"contentKind":"statement","contestId":"1062","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Math"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"JATC's math teacher always gives the class some interesting math problems so that they don't get bored. Today the problem is as follows. Given an integer $$$n$$$, you can perform the following operations zero or more times:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"mul"}],"kind":"container"},{"kind":"text","text":" $$$x$$$: multiplies $$$n$$$ by $$$x$$$ (where $$$x$$$ is an arbitrary positive integer). "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"sqrt"}],"kind":"container"},{"kind":"text","text":": replaces $$$n$$$ with $$$\\sqrt{n}$$$ (to apply this operation, $$$\\sqrt{n}$$$ must be an integer). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You can perform these operations as many times as you like. What is the minimum value of $$$n$$$, that can be achieved and what is the minimum number of operations, to achieve that minimum value?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Apparently, no one in the class knows the answer to this problem, maybe you can help them?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains a single integer $$$n$$$ ($$$1 \\le n \\le 10^6$$$) — the initial number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two integers: the minimum integer $$$n$$$ that can be achieved using the described operations and the minimum number of operations required."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"20\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10 2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5184\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6 4"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, you can apply the operation "},{"children":[{"kind":"text","text":"mul"}],"kind":"container"},{"kind":"text","text":" $$$5$$$ to get $$$100$$$ and then "},{"children":[{"kind":"text","text":"sqrt"}],"kind":"container"},{"kind":"text","text":" to get $$$10$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, you can first apply "},{"children":[{"kind":"text","text":"sqrt"}],"kind":"container"},{"kind":"text","text":" to get $$$72$$$, then "},{"children":[{"kind":"text","text":"mul"}],"kind":"container"},{"kind":"text","text":" $$$18$$$ to get $$$1296$$$ and finally two more "},{"children":[{"kind":"text","text":"sqrt"}],"kind":"container"},{"kind":"text","text":" and you get $$$6$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note, that even if the initial value of $$$n$$$ is less or equal $$$10^6$$$, it can still become greater than $$$10^6$$$ after applying one or more operations."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1062B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1062/problem/B"}