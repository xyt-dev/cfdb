{"assets":[],"contentKind":"statement","contestId":"10","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Power Consumption Calculation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Tom is interested in power consumption of his favourite laptop. His laptop has three modes. In normal mode laptop consumes "},{"kind":"math_inline","text":"P1"},{"kind":"text","text":" watt per minute. "},{"kind":"math_inline","text":"T1"},{"kind":"text","text":" minutes after Tom moved the mouse or touched the keyboard for the last time, a screensaver starts and power consumption changes to "},{"kind":"math_inline","text":"P2"},{"kind":"text","text":" watt per minute. Finally, after "},{"kind":"math_inline","text":"T2"},{"kind":"text","text":" minutes from the start of the screensaver, laptop switches to the \"sleep\" mode and consumes "},{"kind":"math_inline","text":"P3"},{"kind":"text","text":" watt per minute. If Tom moves the mouse or touches the keyboard when the laptop is in the second or in the third mode, it switches to the first (normal) mode. Tom's work with the laptop can be divided into "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" time periods "},{"kind":"math_inline","text":"[l1, r1], [l2, r2], ..., [ln, rn]"},{"kind":"text","text":". During each interval Tom continuously moves the mouse and presses buttons on the keyboard. Between the periods Tom stays away from the laptop. Find out the total amount of power consumed by the laptop during the period "},{"kind":"math_inline","text":"[l1, rn]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains 6 integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"P1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"P2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"P3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"T1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"T2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100, 0 ≤ P1, P2, P3 ≤ 100, 1 ≤ T1, T2 ≤ 60"},{"kind":"text","text":"). The following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain description of Tom's work. Each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains two space-separated integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ li < ri ≤ 1440"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri < li + 1"},{"kind":"text","text":" for "},{"kind":"math_inline","text":"i < n"},{"kind":"text","text":"), which stand for the start and the end of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th period of work."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 3 2 1 5 10\n0 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"30"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 8 4 2 5 10\n20 30\n50 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"570"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"10A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/10/problem/A"}