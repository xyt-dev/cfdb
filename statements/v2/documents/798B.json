{"assets":[],"contentKind":"statement","contestId":"798","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Mike and strings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mike has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" strings "},{"kind":"math_inline","text":"s1, s2, ..., sn"},{"kind":"text","text":" each consisting of lowercase English letters. In one move he can choose a string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":", erase the first character and append it to the end of the string. For example, if he has the string \""},{"children":[{"kind":"text","text":"coolmike"}],"kind":"container"},{"kind":"text","text":"\", in one move he can transform it into the string \""},{"children":[{"kind":"text","text":"oolmikec"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Mike asks himself: what is minimal number of moves that he needs to do in order to make all the strings equal?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50"},{"kind":"text","text":") — the number of strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This is followed by "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines which contain a string each. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line corresponding to string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":". Lengths of strings are equal. Lengths of each string is positive and don't exceed "},{"kind":"math_inline","text":"50"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimal number of moves Mike needs in order to make all the strings equal or print "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":" if there is no solution."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nxzzwo\nzwoxz\nzzwox\nxzzwo\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\nmolzv\nlzvmo\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"In