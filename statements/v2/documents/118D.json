{"assets":[],"contentKind":"statement","contestId":"118","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Caesar's Legions"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Gaius Julius Caesar, a famous general, loved to line up his soldiers. Overall the army had "},{"kind":"math_inline","text":"n1"},{"kind":"text","text":" footmen and "},{"kind":"math_inline","text":"n2"},{"kind":"text","text":" horsemen. Caesar thought that an arrangement is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" beautiful if somewhere in the line there are strictly more that "},{"kind":"math_inline","text":"k1"},{"kind":"text","text":" footmen standing successively one after another, or there are strictly more than "},{"kind":"math_inline","text":"k2"},{"kind":"text","text":" horsemen standing successively one after another. Find the number of "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" arrangements of the soldiers. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that all "},{"kind":"math_inline","text":"n1 + n2"},{"kind":"text","text":" warriors should be present at each arrangement. All footmen are considered indistinguishable among themselves. Similarly, all horsemen are considered indistinguishable among themselves."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains four space-separated integers "},{"kind":"math_inline","text":"n1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n1, n2 ≤ 100, 1 ≤ k1, k2 ≤ 10"},{"kind":"text","text":") which represent how many footmen and horsemen there are and the largest acceptable number of footmen and horsemen standing in succession, correspondingly."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of beautiful arrangements of the army modulo "},{"kind":"math_inline","text":"100000000"},{"kind":"math_inline","text":"(108)"},{"kind":"text","text":". That is, print the number of such ways to line up the soldiers, that no more than "},{"kind":"math_inline","text":"k1"},{"kind":"text","text":" footmen stand successively, and no more than "},{"kind":"math_inline","text":"k2"},{"kind":"text","text":" horsemen stand successively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 1 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's mark a footman as "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", and a horseman as "},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample the only beautiful line-up is: "},{"children":[{"kind":"text","text":"121"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample 5 beautiful line-ups exist: "},{"children":[{"kind":"text","text":"12122"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"12212"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"21212"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"21221"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"22121"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"118D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/118/problem/D"}