{"assets":["/statement-assets/3aa89798cc7f991b03067f2093f4a0cc35512d7ac7b1e56f0122a73ababb39e9.png"],"contentKind":"statement","contestId":"1771","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Hossam and a Letter"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Hossam bought a new piece of ground with length $$$n$$$ and width $$$m$$$, he divided it into an $$$n \\cdot m$$$ grid, each cell being of size $$$1\\times1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since Hossam's name starts with the letter '"},{"children":[{"kind":"text","text":"H"}],"kind":"container"},{"kind":"text","text":"', he decided to draw the capital letter '"},{"children":[{"kind":"text","text":"H"}],"kind":"container"},{"kind":"text","text":"' by building walls of size $$$1\\times1$$$ on some squares of the ground. Each square $$$1\\times1$$$ on the ground is assigned a quality degree: perfect, medium, or bad."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The process of building walls to form up letter '"},{"children":[{"kind":"text","text":"H"}],"kind":"container"},{"kind":"text","text":"' has the following constraints:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The letter must consist of one horizontal and two vertical lines. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The vertical lines must not be in the same or neighboring columns. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The vertical lines must start in the same row and end in the same row (and thus have the same length). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The horizontal line should connect the vertical lines, but must not cross them. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The horizontal line can be in any row between the vertical lines (not only in the middle), except the top and the bottom one. (With the horizontal line in the top row the letter looks like '"},{"children":[{"kind":"text","text":"n"}],"kind":"container"},{"kind":"text","text":"', and in the bottom row like '"},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":"'.) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" It is forbidden to build walls in cells of bad quality. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" You can use at most one square of medium quality. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" You can use any number of squares of perfect quality. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Find the maximum number of walls that can be used to draw the letter '"},{"children":[{"kind":"text","text":"H"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Check the note for more clarification."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integer numbers $$$n$$$, $$$m$$$ ($$$1 \\le n, m \\le 400$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n$$$ lines of the input contain $$$m$$$ characters each, describing the grid. The character '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' stands for a perfect square, the character '"},{"children":[{"kind":"text","text":"m"}],"kind":"container"},{"kind":"text","text":"' stands for a medium square, and the character '"},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"' stands for a bad square."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maximum number of walls that form a capital letter '"},{"children":[{"kind":"text","text":"H"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it is not possible to draw any letter '"},{"children":[{"kind":"text","text":"H"}],"kind":"container"},{"kind":"text","text":"', print $$$0$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 3\n#m.\n.#.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7 8\n...#.m..\n..m...m.\n.#..#.m#\n...m..m.\nm.......\n..#.m.mm\n......m.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n16\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, we can't build the letter '"},{"children":[{"kind":"text","text":"H"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second test case, the figure below represents the grid and some of the valid letters '"},{"children":[{"kind":"text","text":"H"}],"kind":"container"},{"kind":"text","text":"'. Perfect, medium, and bad squares are represented with white, yellow, and black colors respectively."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/3aa89798cc7f991b03067f2093f4a0cc35512d7ac7b1e56f0122a73ababb39e9.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1771E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1771/problem/E"}