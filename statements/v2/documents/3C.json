{"assets":[],"contentKind":"statement","contestId":"3","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Tic-tac-toe"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Certainly, everyone is familiar with tic-tac-toe game. The rules are very simple indeed. Two players take turns marking the cells in a "},{"kind":"math_inline","text":"3 × 3"},{"kind":"text","text":" grid (one player always draws crosses, the other — noughts). The player who succeeds first in placing three of his marks in a horizontal, vertical or diagonal line wins, and the game is finished. The player who draws crosses goes first. If the grid is filled, but neither Xs, nor 0s form the required line, a draw is announced."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a "},{"kind":"math_inline","text":"3 × 3"},{"kind":"text","text":" grid, each grid cell is empty, or occupied by a cross or a nought. You have to find the player (first or second), whose turn is next, or print one of the verdicts below: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"illegal"}],"kind":"container"},{"kind":"text","text":" — if the given board layout can't appear during a valid game; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"the first player won"}],"kind":"container"},{"kind":"text","text":" — if in the given board layout the first player has just won; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"the second player won"}],"kind":"container"},{"kind":"text","text":" — if in the given board layout the second player has just won; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"draw"}],"kind":"container"},{"kind":"text","text":" — if the given board layout has just let to a draw. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of three lines, each of the lines contains characters \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" (a period, a capital letter X, or a digit zero)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one of the six verdicts: "},{"children":[{"kind":"text","text":"first"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"second"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"illegal"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"the first player won"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"the second player won"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"draw"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"X0X\n.0.\n.X.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"second\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"3C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/3/problem/C"}