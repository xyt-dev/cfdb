{"assets":[],"contentKind":"statement","contestId":"382","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Number Busters"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Arthur and Alexander are number busters. Today they've got a competition. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Arthur took a group of four integers "},{"kind":"math_inline","text":"a, b, w, x"},{"kind":"math_inline","text":"(0 ≤ b < w, 0 < x < w)"},{"kind":"text","text":" and Alexander took integer "},{"kind":"math_inline","text":"с"},{"kind":"text","text":". Arthur and Alexander use distinct approaches to number bustings. Alexander is just a regular guy. Each second, he subtracts one from his number. In other words, he performs the assignment: "},{"kind":"math_inline","text":"c = c - 1"},{"kind":"text","text":". Arthur is a sophisticated guy. Each second Arthur performs a complex operation, described as follows: if "},{"kind":"math_inline","text":"b ≥ x"},{"kind":"text","text":", perform the assignment "},{"kind":"math_inline","text":"b = b - x"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"b < x"},{"kind":"text","text":", then perform two consecutive assignments "},{"kind":"math_inline","text":"a = a - 1; b = w - (x - b)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You've got numbers "},{"kind":"math_inline","text":"a, b, w, x, c"},{"kind":"text","text":". Determine when Alexander gets ahead of Arthur