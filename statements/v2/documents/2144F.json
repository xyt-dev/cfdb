{"assets":[],"contentKind":"statement","contestId":"2144","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Bracket Groups"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A regular bracket sequence is a bracket sequence that can be transformed into a correct arithmetic sequence. For example: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" bracket sequences \""},{"children":[{"kind":"text","text":"()()"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(())"}],"kind":"container"},{"kind":"text","text":"\" are regular (the resulting expressions are: \""},{"children":[{"kind":"text","text":"(1)+(1)"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"((1+1)+1)"}],"kind":"container"},{"kind":"text","text":"\"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" bracket sequences \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\" are not. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given $$$n$$$ bracket sequences $$$s_1, s_2, \\dots, s_n$$$ (not necessarily regular) and an even integer $$$k$$$. Your task is to split all of them into groups in such a way that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" every bracket sequence belongs to exactly one group; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for each group, there exists a "},{"children":[{"kind":"text","text":"regular"}],"kind":"container"},{"kind":"text","text":" bracket sequence of length exactly $$$k$$$ such that every bracket sequence assigned to this group is "},{"children":[{"kind":"text","text":"not a substring"}],"kind":"container"},{"kind":"text","text":" of it. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"What is the smallest number of groups that this can be achieved for? If it's impossible to do for any number of groups, report so. Otherwise, print the groups and any valid regular bracket sequence for each group. If there are multiple answers with the smallest number of groups, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\le n \\le 50$$$; $$$2 \\le k \\le 50$$$; $$$k$$$ is even)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the next $$$n$$$ lines contains a bracket sequence $$$s_i$$$ ($$$2 \\le |s_i| \\le k$$$). It consists only of characters '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it's impossible to split all bracket sequences into groups according to the rules, then print $$$-1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print the smallest possible number of groups $$$m$$$ in the first line. Then, $$$m$$$ blocks of data should follow: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The first line of each block should contain a regular bracket sequence of length $$$k$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The second line should contain a single integer $$$g$$$ — the number of bracket sequences in the current group. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The third line should contain $$$g$$$ integers from $$$1$$$ to $$$n$$$ — the indices of the bracket sequences that belong to the current group. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"None of these bracket sequences should be a substring of the chosen regular bracket sequence. Each index from $$$1$$$ to $$$n$$$ should belong to exactly one group."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers with the smallest $$$m$$$, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 6\n)))\n(((\n(())\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n(()())\n3\n1 2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 6\n(()\n()(\n())\n((((((\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n(())()\n1\n2\n()()()\n3\n1 4 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 6\n()\n)(\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"2144F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2144/problem/F"}