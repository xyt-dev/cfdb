{"assets":["/statement-assets/8b22165416992db0f9f9a7eded1d6637e3b230a3f42253bebe39c15c8eb528b1.png","/statement-assets/2bdde373f415fdfa70fa6e44f3ed608e1c1a8306496aedb64f80848e65c2bc66.png"],"contentKind":"statement","contestId":"441","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Valera and Tubes "}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Valera has got a rectangle table consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" columns. Valera numbered the table rows starting from one, from top to bottom and the columns – starting from one, from left to right. We will represent cell that is on the intersection of row "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and column "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" by a pair of integers "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valera wants to place exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" tubes on his rectangle table. A tube is such sequence of table cells "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"(xr, yr)"},{"kind":"text","text":", that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"r ≥ 2"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for any integer "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ r - 1)"},{"kind":"text","text":" the following equation "},{"kind":"math_inline","text":"|xi - xi + 1| + |yi - yi + 1| = 1"},{"kind":"text","text":" holds; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" each table cell, which belongs to the tube, must occur exactly once in the sequence. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Valera thinks that the tubes are arranged in a fancy manner if the following conditions are fulfilled: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" no pair of tubes has common cells; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" each cell of the table belongs to some tube. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Valera to arrange "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" tubes on his rectangle table in a fancy manner."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three space-separated integers "},{"kind":"math_inline","text":"n, m, k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n, m ≤ 300"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"2 ≤ 2k ≤ n·m"},{"kind":"text","text":") — the number of rows, the number of columns and the number of tubes, correspondingly. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print the description of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th tube: first print integer "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" (the number of tube cells), then print "},{"kind":"math_inline","text":"2ri"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"xi1, yi1, xi2, yi2, ..., xiri, yiri"},{"kind":"text","text":" (the sequence of table cells)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, you can print any of them. It is guaranteed that at least one solution exists. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 1 1 1 2 1 3\n3 2 1 2 2 2 3\n3 3 1 3 2 3 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6 1 1 1 2 1 3 2 3 2 2 2 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Picture for the first sample: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/8b22165416992db0f9f9a7eded1d6637e3b230a3f42253bebe39c15c8eb528b1.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Picture for the second sample: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/2bdde373f415fdfa70fa6e44f3ed608e1c1a8306496aedb64f80848e65c2bc66.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"441C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/441/problem/C"}