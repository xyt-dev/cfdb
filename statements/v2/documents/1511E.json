{"assets":[],"contentKind":"statement","contestId":"1511","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Colorings and Dominoes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a large rectangular board which is divided into $$$n \\times m$$$ cells (the board has $$$n$$$ rows and $$$m$$$ columns). Each cell is either white or black."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You paint each white cell either red or blue. Obviously, the number of different ways to paint them is $$$2^w$$$, where $$$w$$$ is the number of white cells."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After painting the white cells of the board, you want to place the maximum number of dominoes on it, according to the following rules:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" each domino covers two adjacent cells; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" each cell is covered by at most one domino; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if a domino is placed horizontally (it covers two adjacent cells in one of the rows), it should cover only red cells; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if a domino is placed vertically (it covers two adjacent cells in one of the columns), it should cover only blue cells. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let the "},{"children":[{"kind":"text","text":"value"}],"kind":"container"},{"kind":"text","text":" of the board be the maximum number of dominoes you can place. Calculate the sum of "},{"children":[{"kind":"text","text":"values"}],"kind":"container"},{"kind":"text","text":" of the board over all $$$2^w$$$ possible ways to paint it. Since it can be huge, print it modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\le n, m \\le 3 \\cdot 10^5$$$; $$$nm \\le 3 \\cdot 10^5$$$) — the number of rows and columns, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$n$$$ lines follow, each line contains a string of $$$m$$$ characters. The $$$j$$$-th character in the $$$i$$$-th string is "},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":" if the $$$j$$$-th cell in the $$$i$$$-th row is black; otherwise, that character is "},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the sum of "},{"children":[{"kind":"text","text":"values"}],"kind":"container"},{"kind":"text","text":" of the board over all $$$2^w$$$ possible ways to paint it, taken modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 4\n**oo\noo*o\n**oo\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n144\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 4\n**oo\noo**\n**oo\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n48\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 2\noo\no*\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1 4\noooo\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1511E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1511/problem/E"}