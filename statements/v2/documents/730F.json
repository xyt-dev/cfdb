{"assets":["/statement-assets/da48ceb154174c62817db7aedb5a4e1bf7f81fea9ee0b2b1c06868ba6bc2c8e3.png"],"contentKind":"statement","contestId":"730","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Ber Patio"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp is a regular customer at the restaurant \"Ber Patio\". He likes having lunches there."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"\"Ber Patio\" has special discount program for regular customers. A customer can collect bonuses and partially cover expenses in the restaurant."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's assume a customer currently has "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" bonuses and she has to pay "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" burles for a lunch. In this case the customer can use bonuses (1 bonus = 1 burle) to reduce the payment. She can cover at most half of the payment using bonuses. However, 1 bonus will be added to the customer's bonus balance per each 10 burles she paid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" a customer can choose any number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" of bonuses to use ("},{"attrs":{"alt":"","src":"/statement-assets/da48ceb154174c62817db7aedb5a4e1bf7f81fea9ee0b2b1c06868ba6bc2c8e3.png"},"kind":"image"},{"kind":"text","text":")), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the customer's bonus balance is reduced by "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the customer pays "},{"kind":"math_inline","text":"r - x"},{"kind":"text","text":" burles, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the customer's bonus balance is increased by "},{"kind":"math_inline","text":"⌊(r - x) / 10⌋"},{"kind":"text","text":" (i.e. integer division rounded down is used). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Initially, there are "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" bonuses on Polycarp's account. Polycarp is going to have a lunch in \"Ber Patio\" for the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days. He estimated the values "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the number of burles in a receipt for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day. The sum over all receipts doesn't exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":" burles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Write a program to find the minimum number of burles Polycarp has to spend and an optimal strategy to use bonuses."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ b ≤ 105"},{"kind":"text","text":") — number of days and initial number of bonuses Polycarp has."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the integer sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 1000"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the amount of burles in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day's receipt."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of all receipts does not exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":" burles."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first line, print the expected minimal number of burles to pay for all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" receipts."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the second line, print the sequence of integer numbers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is the number of bonuses to use on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day. If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 21\n12 75 52\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"110\n2 5 22 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 39\n58 64 33\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"107\n28 4 16 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"730F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/730/problem/F"}