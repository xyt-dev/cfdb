{"assets":["/statement-assets/c45c19093da26a6ce324e4feeed39dbfe4ed196e726a9a379a2b2091744e1825.png","/statement-assets/5c42b43de92817488534157012c6fc22363321d58efa4ef057550a637de798cf.png","/statement-assets/1f88ed8c2a3739edef145b66d4d9d4690c1e7305072ad902841d1e0f5a6edcfb.png","/statement-assets/ba8ea62801ba69700d04cefcffd5457b09cd3f33f3207b3dd2a147385cea06cf.png","/statement-assets/f77cc1cc5f7b76b3ba90af0955add9c9b46844db12254c939607374af91db11f.png","/statement-assets/84e342fa2f5e41825ea00d33e9c39c6ea475fe31ddcce5b6e10ec11baf88caeb.png"],"contentKind":"statement","contestId":"817","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Treasure Hunt"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Captain Bill the Hummingbird and his crew recieved an interesting challenge offer. Some stranger gave them a map, potion of teleportation and said that only this potion might help them to reach the treasure. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Bottle with potion has two values "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" written on it. These values define four moves which can be performed using the potion:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"alt":"","src":"/statement-assets/c45c19093da26a6ce324e4feeed39dbfe4ed196e726a9a379a2b2091744e1825.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5c42b43de92817488534157012c6fc22363321d58efa4ef057550a637de798cf.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1f88ed8c2a3739edef145b66d4d9d4690c1e7305072ad902841d1e0f5a6edcfb.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ba8ea62801ba69700d04cefcffd5457b09cd3f33f3207b3dd2a147385cea06cf.png"},"kind":"image"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Map shows that the position of Captain Bill the Hummingbird is "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":" and the position of the treasure is "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You task is to tell Captain Bill the Hummingbird whether he should accept this challenge or decline. If it is possible for Captain to reach the treasure using the potion then output "},{"children":[{"kind":"text","text":"\"YES\""}],"kind":"container"},{"kind":"text","text":", otherwise "},{"children":[{"kind":"text","text":"\"NO\""}],"kind":"container"},{"kind":"text","text":" (without quotes)."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"The potion can be used infinite amount of times."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four integer numbers "},{"kind":"math_inline","text":"x1, y1, x2, y2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 105 ≤ x1, y1, x2, y2 ≤ 105"},{"kind":"text","text":") — positions of Captain Bill the Hummingbird and treasure respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains two integer numbers "},{"kind":"math_inline","text":"x, y"},{"kind":