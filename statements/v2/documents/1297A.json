{"assets":[],"contentKind":"statement","contestId":"1297","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Likes Display"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp is working on the implementation of displaying likes on the Codehorses social network. The number of likes should be displayed in a format that will be easy to read by users. It was decided that for large numbers of likes the format should be like "},{"children":[{"kind":"text","text":"123K"}],"kind":"container"},{"kind":"text","text":" (one hundred twenty-three thousand) or like "},{"children":[{"kind":"text","text":"56M"}],"kind":"container"},{"kind":"text","text":" (fifty-six million)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following displaying strategy has been approved:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the number will be displayed either as an integer number from "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"999"}],"kind":"container"},{"kind":"text","text":", or as a positive integer number of thousands (from "},{"children":[{"kind":"text","text":"1K"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"999K"}],"kind":"container"},{"kind":"text","text":"), or as a positive integer number of millions (from "},{"children":[{"kind":"text","text":"1M"}],"kind":"container"},{"kind":"text","text":" on), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the specified exact number of likes $$$n$$$ when displaying should be rounded to the nearest view from the case above (if rounding is ambiguous, it must be rounded up): for example, $$$1785$$$ should be rounded to "},{"children":[{"kind":"text","text":"2K"}],"kind":"container"},{"kind":"text","text":" instead of "},{"children":[{"kind":"text","text":"1K"}],"kind":"container"},{"kind":"text","text":", $$$4500000$$$ should be rounded to "},{"children":[{"kind":"text","text":"5M"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Polycarp implement this part of the functionality: for a given non-negative integer number of likes $$$n$$$, print its view in the Codehorses interface."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases in the input. The following are descriptions of the $$$t$$$ input test cases, one per line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The description of each test case consists of a single line that contains a non-negative integer $$$n$$$ ($$$0 \\le n \\le 2\\cdot10^9$$$) — the number of likes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$t$$$ answers to the given test cases in the order from the input. Each printed value must have one of the following types:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" either an integer from "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"999"}],"kind":"container"},{"kind":"text","text":" which corresponds just to the number of likes, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" or a number of thousands from "},{"children":[{"kind":"text","text":"1K"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"999K"}],"kind":"container"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" or a number of millions from "},{"children":[{"kind":"text","text":"1M"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"2000M"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The answer is equal to a view which is the closest (by difference) to the given number $$$n$$$. If this rounding is ambiguous, then round answer up (to a greater value)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n999\n123\n0\n1782\n31415926\n1500\n999999\n35499710\n2000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n999\n123\n0\n2K\n31M\n2K\n1M\n35M\n2000M\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's describe some test cases: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1782$$$ can be displayed either as "},{"children":[{"kind":"text","text":"1K"}],"kind":"container"},{"kind":"text","text":" or as "},{"children":[{"kind":"text","text":"2K"}],"kind":"container"},{"kind":"text","text":" but "},{"children":[{"kind":"text","text":"2K"}],"kind":"container"},{"kind":"text","text":" is the nearest view; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$1500$$$ have same difference with "},{"children":[{"kind":"text","text":"1K"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"2K"}],"kind":"container"},{"kind":"text","text":" so it should be rounded up; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$999999$$$ should be displayed as "},{"children":[{"kind":"text","text":"1M"}],"kind":"container"},{"kind":"text","text":" since it's closer to it than to "},{"children":[{"kind":"text","text":"999K"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1297A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1297/problem/A"}