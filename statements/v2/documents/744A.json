{"assets":["/statement-assets/a0641bc7617217e331384ebd2475691b2497400e9a8010658e57480748254dd4.png","/statement-assets/a8199346bfe6e54461bde2f50eef3f28ce85c93656698219dc41273d595b5afb.png"],"contentKind":"statement","contestId":"744","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Hongcow Builds A Nation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Hongcow is ruler of the world. As ruler of the world, he wants to make it easier for people to travel by road within their own countries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The world can be modeled as an undirected graph with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges. "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" of the nodes are home to the governments of the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" countries that make up the world."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is at most one edge connecting any two nodes and no edge connects a node to itself. Furthermore, for any two nodes corresponding to governments, "},{"children":[{"kind":"text","text":"there is no path between those two nodes"}],"kind":"container"},{"kind":"text","text":". Any graph that satisfies all of these conditions is "},{"children":[{"kind":"text","text":"stable"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Hongcow wants to add as many edges as possible to the graph while keeping it stable. Determine the maximum number of edges Hongcow can add."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input will contain three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ m ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":") — the number of vertices and edges in the graph, and the number of vertices that are homes of the government. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line of input will contain "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"c1, c2, ..., ck"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci ≤ n"},{"kind":"text","text":"). These integers will be pairwise distinct and denote the nodes that are home to the governments in this world."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines of input will contain two integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":"). This denotes an undirected edge between nodes "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the graph described by the input is stable."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer, the maximum number of edges Hongcow can add to the graph while keeping it stable."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1 2\n1 3\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 1\n2\n1 2\n1 3\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample test, the graph looks like this: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a0641bc7617217e331384ebd2475691b2497400e9a8010658e57480748254dd4.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" Vertices "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" are special. The optimal solution is to connect vertex "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" to vertices "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". This adds a total of "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" edges. We cannot add any more edges, since vertices "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" cannot have any path between them."},{"children":[{"kind":"text","text":"For the second sample test, the graph looks like this: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a8199346bfe6e54461bde2f50eef3f28ce85c93656698219dc41273d595b5afb.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" We cannot add any more edges to this graph. Note that we are not allowed to add self-loops, and the graph must be simple."}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"744A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/744/problem/A"}