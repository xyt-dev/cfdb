{"assets":[],"contentKind":"statement","contestId":"858","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Polycarp's phone book"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" phone numbers in Polycarp's contacts on his phone. Each number is a 9-digit integer, starting with a digit different from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". All the numbers are distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is the latest version of Berdroid OS installed on Polycarp's phone. If some number is entered, is shows up all the numbers in the contacts for which there is a substring equal to the entered sequence of digits. For example, is there are three phone numbers in Polycarp's contacts: "},{"kind":"math_inline","text":"123456789"},{"kind":"text","text":", "},{"kind":"math_inline","text":"100000000"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"100123456"},{"kind":"text","text":", then:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if he enters "},{"kind":"math_inline","text":"00"},{"kind":"text","text":" two numbers will show up: "},{"kind":"math_inline","text":"100000000"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"100123456"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if he enters "},{"kind":"math_inline","t