{"assets":["/statement-assets/12973bdfde8f7805eccd17a84acc60cc76a9b53e93ad96d40b1e7e440749adcf.png","/statement-assets/d82b371a913fceef8554cc6328186dd134f6d4f0357733c5710725902263488d.png","/statement-assets/85287ae6e1a3f21bb2850b8db46ca30c1b7b639b359ddd089c606f2f95ccf29e.png","/statement-assets/b54fe7ad544e638bb2492b0e9cc8275ff0370527aa65527d4775979df6e6c15d.png","/statement-assets/d8e21bd06893599248b3b6a43af5168b359d04a88cd0c6cb7b84eb112faa0849.png","/statement-assets/c52187a5f3073caa43845db7a135406d6c9aeef0bd7efffcb13fd924ef8c7222.png","/statement-assets/dd3632059c06b0f2168b0bf40f4bf722a54498eaaaece70881feae996a8c5368.png"],"contentKind":"statement","contestId":"115","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Lawnmower"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a garden consisting entirely of grass and weeds. Your garden is described by an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" grid, with rows numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from top to bottom, and columns "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" from left to right. Each cell is identified by a pair "},{"kind":"math_inline","text":"(r, c)"},{"kind":"text","text":" which means that the cell is located at row "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and column "},{"kind":"math_inline","text":"c"},{"kind":"text","text":". Each cell may contain either grass or weeds. For example, a "},{"kind":"math_inline","text":"4 × 5"},{"kind":"text","text":" garden may look as follows (empty cells denote grass):"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/12973bdfde8f7805eccd17a84acc60cc76a9b53e93ad96d40b1e7e440749adcf.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"You have a land-mower with you to mow all the weeds. Initially, you are standing with your lawnmower at the top-left corner of the garden. That is, at cell "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":". At any moment of time you are facing a certain direction — either left or right. And initially, you face right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one move you can do either one of these:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1) Move one cell in the direction that you are facing."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":" if you are facing right: move from cell "},{"kind":"math_inline","text":"(r, c)"},{"kind":"text","text":" to cell "},{"kind":"math_inline","text":"(r, c + 1)"},{"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d82b371a913fceef8554cc6328186dd134f6d4f0357733c5710725902263488d.png"},"kind":"image"}],"kind":"container"},{"kind":"paragraph"}],"kind":"list_item"},{"children":[{"kind":"text","text":" if you are facing left: move from cell "},{"kind":"math_inline","text":"(r, c)"},{"kind":"text","text":" to cell "},{"kind":"math_inline","text":"(r, c - 1)"},{"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/85287ae6e1a3f21bb2850b8db46ca30c1b7b639b359ddd089c606f2f95ccf29e.png"},"kind":"image"}],"kind":"container"}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" 2) Move one cell down (that is, from cell "},{"kind":"math_inline","text":"(r, c)"},{"kind":"text","text":" to cell "},{"kind":"math_inline","text":"(r + 1, c)"},{"kind":"text","text":"), and change your direction to the opposite one."},{"attrs":{"ordered":false},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":" if you were facing right previously, you will face left"},{"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b54fe7ad544e638bb2492b0e9cc8275ff0370527aa65527d4775979df6e6c15d.png"},"kind":"image"}],"kind":"container"},{"kind":"paragraph"}],"kind":"list_item"},{"children":[{"kind":"text","text":" if you were facing left previously, you will face right"},{"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d8e21bd06893599248b3b6a43af5168b359d04a88cd0c6cb7b84eb112faa0849.png"},"kind":"image"}],"kind":"container"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are not allowed to leave the garden. Weeds will be mowed if you and your lawnmower are standing at the cell containing the weeds (your direction doesn't matter). This action isn't counted as a move."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of moves required to mow all the weeds?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 150"},{"kind":"text","text":") — the number of rows and columns respectively. Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines containing "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters each — the content of the grid. \""},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"\" means that this cell contains grass. \""},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"\" means that this cell contains weeds. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the top-left corner of the grid will contain grass."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the minimum number of moves required to mow all the weeds."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\nGWGGW\nGGWGG\nGWGGG\nWGGGG\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\nGWW\nWWW\nWWG\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\nG\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first example, this is the picture of the initial state of the grid:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c52187a5f3073caa43845db7a135406d6c9aeef0bd7efffcb13fd924ef8c7222.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"A possible solution is by mowing the weeds as illustrated below:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/dd3632059c06b0f2168b0bf40f4bf722a54498eaaaece70881feae996a8c5368.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"115B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/115/problem/B"}