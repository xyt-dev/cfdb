{"assets":["/statement-assets/32bacde15b56d6755c015b5d0eeb97efdda56e2ec195df765122bd68582404eb.png"],"contentKind":"statement","contestId":"891","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Envy"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"For a connected undirected weighted graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":", MST (minimum spanning tree) is a subgraph of "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" that contains all of "},{"kind":"math_inline","text":"G"},{"kind":"text","text":"'s vertices, is a tree, and sum of its edges is minimum possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":". If you run a MST algorithm on graph it would give you only one MST and it causes other edges to become jealous. You are given some queries, each query contains a set of edges of graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":", and you should determine whether there is a MST containing all these edges or not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2  ≤ n, m  ≤ 5·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n - 1 ≤ m"},{"kind":"text","text":") — the number of vertices and edges in the graph and the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains three integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"ui ≠ vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ wi ≤ 5·105"},{"kind":"text","text":") — the endpoints and weight of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge. There can be more than one edges between two vertices. It's guaranteed that the given graph is connected."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains a single integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 5·105"},{"kind":"text","text":") — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines follow, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query. It starts with an integer "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ki ≤ n - 1"},{"kind":"text","text":") — the size of edges subset and continues with "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" distinct space-separated integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the indices of the edges. It is guaranteed that the sum of "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" for "},{"kind":"math_inline","text":"1 ≤ i ≤ q"},{"kind":"text","text":" does not exceed "},{"kind":"math_inline","text":"5·105"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query you should print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if there's a MST containing these edges and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (of course without quotes again) otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 7\n1 2 2\n1 3 2\n2 3 1\n2 4 1\n3 4 1\n3 5 2\n4 5 2\n4\n2 3 4\n3 3 4 5\n2 1 7\n2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nNO\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"This is the graph of sample:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/32bacde15b56d6755c015b5d0eeb97efdda56e2ec195df765122bd68582404eb.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Weight of minimum spanning tree on this graph is "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"MST with edges "},{"kind":"math_inline","text":"(1, 3, 4, 6)"},{"kind":"text","text":", contains all of edges from the first query, so answer on the first query is \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Edges from the second query form a cycle of length "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", so there is no spanning tree including these three edges. Thus, answer is \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"891C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/891/problem/C"}