"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's look at the subtree "},{"kind":"math_inline","text":"Tv"},{"kind":"text","text":" of some vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". It is possible to read a string along each simple path starting at "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and ending at some vertex in "},{"kind":"math_inline","text":"Tv"},{"kind":"text","text":" (possibly "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" itself). Let's denote the number of "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" strings which can be read this way as "},{"attrs":{"alt":"","src":"/statement-assets/435040e0895110533fad91376a45f68abad8c80176f508d9572229b902073585.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, there's a number "},{"kind":"math_inline","text":"cv"},{"kind":"text","text":" assigned to each vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". We are interested in vertices with the maximum value of "},{"attrs":{"alt":"","src":"/statement-assets/6c12aefdabc8bc2ceeed3280cb4d981e60220f23b3b5e89e6f8e33d44512ee0f.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You should compute two statistics: the maximum value of "},{"attrs":{"alt":"","src":"/statement-assets/6c12aefdabc8bc2ceeed3280cb4d981e60220f23b3b5e89e6f8e33d44512ee0f.png"},"kind":"image"},{"kind":"text","text":" and the number of vertices "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" with the maximum "},{"attrs":{"alt":"","src":"/statement-assets/6c12aefdabc8bc2ceeed3280cb4d981e60220f23b3b5e89e6f8e33d44512ee0f.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 300 000"},{"kind":"text","text":") — the number of vertices of the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ci ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase English letters — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character of this string is the letter in vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines describe the tree "},{"kind":"math_inline","text":"T"},{"kind":"text","text":". Each of them contains two space-separated integers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ u, v ≤ n"},{"kind":"text","text":") indicating an edge between vertices "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the input will describe a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two lines. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the first line, print "},{"attrs":{"alt":"","src":"/statement-assets/0a3865368ce9e4c8fabcb2ad9569205e8ce6ef7c7cf2b9298cc8965c1fa8da10.png"},"kind":"image"},{"kind":"text","text":" over all "},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the second line, print the number of vertices "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" for which "},{"attrs":{"alt":"","src":"/statement-assets/6f0b605c6ad7691d4392b74214d289f4088cde06cb2531107af691129454d641.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n1 2 7 20 20 30 40 50 50 50\ncacabbcddd\n1 2\n6 8\n7 2\n6 2\n5 4\n5 9\n3 10\n2 5\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"51\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n0 2 4 1 1 1\nraaaba\n1 2\n2 3\n2 4\n2 5\n3 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the tree looks like this:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/2dca5638e4feb0f594b20b99c420eec12f4c435caf246a13836fa45d84567310.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The sets of strings that can be read from individual vertices are:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/44fce3bb3ffd3a01389092f64b3bc98b0821b7a697ebcbf5ad8633744038235e.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Finally, the values of "},{"attrs":{"alt":"","src":"/statement-assets/6c12aefdabc8bc2ceeed3280cb4d981e60220f23b3b5e89e6f8e33d44512ee0f.png"},"kind":"image"},{"kind":"text","text":" are:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1a60292846fdbe6e5687cea1d27e2bfeff7ea6190df732dc4f5839aab042685a.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second sample, the values of "},{"attrs":{"alt":"","src":"/statement-assets/a501bbf50fff7c9ac1067b0fd0e10d884ef0b983161b4f8985aabecf6f44e970.png"},"kind":"image"},{"kind":"text","text":" are "},{"kind":"math_inline","text":"(5, 4, 2, 1, 1, 1)"},{"kind":"text","text":". The distinct strings read in "},{"kind":"math_inline","text":"T2"},{"kind":"text","text":" are "},{"attrs":{"alt":"","src":"/statement-assets/d0d193e5d9e9fc95017fc59780eb2e82ee2d9549dee3a25ceb133cd84d56b9e5.png"},"kind":"image"},{"kind":"text","text":"; note that "},{"attrs":{"alt":"","src":"/statement-assets/6c4ff892dc347986f19c9f6699cc73d6897b545b63c54175ef34bc8544d7d332.png"},"kind":"image"},{"kind":"text","text":" can be read down to vertices "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"601D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/601/probl