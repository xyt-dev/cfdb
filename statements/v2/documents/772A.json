{"assets":["/statement-assets/9ca07664d7bed771f2d053313648f5b2c151f77f7cf8334ec44105cd4821138c.png"],"contentKind":"statement","contestId":"772","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Voltage Keepsake"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" devices that you want to use simultaneously."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th device uses "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" units of power per second. This usage is continuous. That is, in "},{"kind":"math_inline","text":"λ"},{"kind":"text","text":" seconds, the device will use "},{"kind":"math_inline","text":"λ·ai"},{"kind":"text","text":" units of power. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th device currently has "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" units of power stored. All devices can store an arbitrary amount of power."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have a single charger that can plug to any single device. The charger will add "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" units of power per second to a device. This charging is continuous. That is, if you plug in a device for "},{"kind":"math_inline","text":"λ"},{"kind":"text","text":" seconds, it will gain "},{"kind":"math_inline","text":"λ·p"},{"kind":"text","text":" units of power. You can switch which device is charging at any arbitrary unit of time (including real numbers), and the time it takes to switch is negligible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are wondering, what is the maximum amount of time you can use the devices until one of them hits "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" units of power."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If you can use the devices indefinitely, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". Otherwise, print the maximum amount of time before any one device hits "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" power."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ p ≤ 109"},{"kind":"text","text":") — the number of devices and the power of the charger."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This is followed by "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines which contain two integers each. Line "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" contains the integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ 100 000"},{"kind":"text","text":") — the power of the device and the amount of power stored in the device in the beginning."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If you can use the devices indefinitely, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". Otherwise, print the maximum amount of time before any one device hits "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" power."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your answer will be considered correct if its absolute or relative error does not exceed "},{"kind":"math_inline","text":"10 - 4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Namely, let's assume that your answer is "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and the answer of the jury is "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The checker program will consider your answer correct if "},{"attrs":{"alt":"","src":"/statement-assets/9ca07664d7bed771f2d053313648f5b2c151f77f7cf8334ec44105cd4821138c.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n2 2\n2 1000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2.0000000000"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 100\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n4 3\n5 2\n6 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.5000000000"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In sample test 1, you can charge the first device for the entire time until it hits zero power. The second device has enough power to last this time without being charged."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In sample test 2, you can use the device indefinitely."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In sample test 3, we can charge the third device for "},{"kind":"math_inline","text":"2 / 5"},{"kind":"text","text":" of a second, then switch to charge the second device for a "},{"kind":"math_inline","text":"1 / 10"},{"kind":"text","text":" of a second."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"772A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/772/problem/A"}