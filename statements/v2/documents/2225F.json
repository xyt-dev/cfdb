{"assets":[],"contentKind":"statement","contestId":"2225","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. String Cutting"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ consisting of lowercase Latin letters. You have to cut it into $$$k$$$ or more parts so that each part contains at least $$$l$$$ letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After cutting the string into parts, the resulting strings will be sorted in lexicographical order. Your task is to cut the string so that the string at the $$$k$$$-th position in the sorted order is lexicographically as large as possible. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if $$$s = $$$ \""},{"children":[{"kind":"text","text":"abracadabra"}],"kind":"container"},{"kind":"text","text":"\", $$$l = 2$$$, and $$$k = 5$$$, then it can be cut into five parts:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\" "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"rac"}],"kind":"container"},{"kind":"text","text":"\" "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"ad"}],"kind":"container"},{"kind":"text","text":"\" "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{