{"assets":["/statement-assets/782e36cf3f4527bc8d6708acf57ccabf1c78359b5a6e4151402736f31071122d.png","/statement-assets/fb9a5f7fd4165c4fac60e78681303a63774c84aba77f2d20fa063f10560b02c7.png"],"contentKind":"statement","contestId":"1002","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D3. Oracle for majority function"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Implement a quantum oracle on 3 qubits which implements a majority function. Majority function on 3-bit vectors is defined as follows: "},{"attrs":{"alt":"","src":"/statement-assets/782e36cf3f4527bc8d6708acf57ccabf1c78359b5a6e4151402736f31071122d.png"},"kind":"image"},{"kind":"text","text":" if vector "},{"attrs":{"alt":"","src":"/statement-assets/fb9a5f7fd4165c4fac60e78681303a63774c84aba77f2d20fa063f10560b02c7.png"},"kind":"image"},{"kind":"text","text":" has two or three 1s, and 0 if it has zero or one 1s."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For an explanation on how this type of quantum oracles works, see "},{"attrs":{"href":"https://codeforces.com/blog/entry/60319"},"children":[{"kind":"text","text":"Introduction to quantum oracles"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to implement an operation which takes the following inputs:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" an array of 3 qubits "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" in arbitrary state (input register),"}],"kind":"list_item"},{"children":[{"kind":"text","text":" a qubit "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" in arbitrary state (output qubit)."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The operation doesn't have an output; its \"output\" is the state in which it leaves the qubits."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your code should have the following signature:"}],"kind":"paragraph"},{"kind":"code_block","text":"namespace Solution {\n    open Microsoft.Quantum.Primitive;\n    open Microsoft.Quantum.Canon;\n\n    operation Solve (x : Qubit[], y : Qubit) : ()\n    {\n        body\n        {\n            // your code here\n        }\n    }\n}"}],"kind":"section"}],"kind":"document"},"index":"D3","problemCode":"1002D3","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1002/problem/D3"}