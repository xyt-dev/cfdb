{"assets":[],"contentKind":"statement","contestId":"1394","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Boboniu and String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Boboniu defines "},{"children":[{"kind":"text","text":"BN-string"}],"kind":"container"},{"kind":"text","text":" as a string $$$s$$$ of characters 'B' and 'N'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can perform the following operations on the BN-string $$$s$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Remove a character of $$$s$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Remove a substring \""},{"children":[{"kind":"text","text":"BN"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"NB"}],"kind":"container"},{"kind":"text","text":"\" of $$$s$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Add a character 'B' or 'N' to the end of $$$s$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Add a string \""},{"children":[{"kind":"text","text":"BN"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"NB"}],"kind":"container"},{"kind":"text","text":"\" to the end of $$$s$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that a string $$$a$$$ is a "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":" of a string $$$b$$$ if $$$a$$$ can be obtained from $$$b$$$ by deletion of several (possibly, zero or all) characters from the beginning and several (possibly, zero or all) characters from the end."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Boboniu thinks that BN-strings $$$s$$$ and $$$t$$$ are "},{"children":[{"kind":"text","text":"similar"}],"kind":"container"},{"kind":"text","text":" if and only if:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$|s|=|t|$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There exists a permutation $$$p_1, p_2, \\ldots, p_{|s|}$$$ such that for all $$$i$$$ ($$$1\\le i\\le |s|$$$), $$$s_{p_i}=t_i$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Boboniu also defines $$$\\text{dist}(s,t)$$$, the "},{"children":[{"kind":"text","text":"distance"}],"kind":"container"},{"kind":"text","text":" between $$$s$$$ and $$$t$$$, as the minimum number of operations that makes $$$s$$$ "},{"children":[{"kind":"text","text":"similar"}],"kind":"container"},{"kind":"text","text":" to $$$t$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Boboniu gives you $$$n$$$ non-empty BN-strings $$$s_1,s_2,\\ldots, s_n$$$ and asks you to find a "},{"children":[{"kind":"text","text":"non-empty"}],"kind":"container"},{"kind":"text","text":" BN-string $$$t$$$ such that the maximum distance to string $$$s$$$ is minimized, i.e. you need to minimize $$$\\max_{i=1}^n \\text{dist}(s_i,t)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$1\\le n\\le 3\\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n$$$ lines contains a string $$$s_i$$$ ($$$1\\le |s_i| \\le 5\\cdot 10^5$$$). It is guaranteed that $$$s_i$$$ only contains 'B' and 'N'. The sum of $$$|s_i|$$$ does not exceed $$$5\\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, print the minimum $$$\\max_{i=1}^n \\text{dist}(s_i,t)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line, print the suitable $$$t$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several possible $$$t$$$'s, you can print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\nB\nN\nBN\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\nBN\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\nN\nBBBBBB\nBNNNBBNBB\nNNNNBNBNNBNNNBBN\nNBNBN\nNNNNNN\nBNBNBNBBBBNNNNBBBBNNBBNBNBBNBBBBBBBB\nNNNNBN\nNBBBBBBBB\nNNNNNN\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n12\nBBBBBBBBBBBBNNNNNNNNNNNN\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8\nNNN\nNNN\nBBNNBBBN\nNNNBNN\nB\nNNN\nNNNNBNN\nNNNNNNNNNNNNNNNBNNNNNNNBNB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n12\nBBBBNNNNNNNNNNNN\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\nBNNNBNNNNBNBBNNNBBNNNNBBBBNNBBBBBBNBBBBBNBBBNNBBBNBNBBBN\nBBBNBBBBNNNNNBBNBBBNNNBB\nBBBBBBBBBBBBBBNBBBBBNBBBBBNBBBBNB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n12\nBBBBBBBBBBBBBBBBBBBBBBBBBBNNNNNNNNNNNN\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example $$$\\text{dist(B,BN)}=\\text{dist(N,BN)}=1$$$, $$$\\text{dist(BN,BN)}=0$$$. So the maximum distance is $$$1$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1394C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1394/problem/C"}