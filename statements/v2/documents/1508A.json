{"assets":[],"contentKind":"statement","contestId":"1508","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Binary Literature"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A bitstring is a string that contains only the characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Koyomi Kanou is working hard towards her dream of becoming a writer. To practice, she decided to participate in the "},{"children":[{"kind":"text","text":"Binary Novel Writing Contest"}],"kind":"container"},{"kind":"text","text":". The writing prompt for the contest consists of three bitstrings of length $$$2n$$$. A valid novel for the contest is a bitstring of length at most $$$3n$$$ that contains "},{"children":[{"kind":"text","text":"at least two"}],"kind":"container"},{"kind":"text","text":" of the three given strings as subsequences."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Koyomi has just received the three prompt strings from the contest organizers. Help her write a valid novel for the contest."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string $$$a$$$ is a subsequence of a string $$$b$$$ if $$$a$$$ can be obtained from $$$b$$$ by deletion of several (possibly, zero) characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following three lines contains a bitstring of length $$$2n$$$. It is guaranteed that these three strings are pairwise distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ across all test cases does not exceed $$$10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single line containing a bitstring of length at most $$$3n$$$ that has at least two of the given bitstrings as subsequences."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It can be proven that under the constraints of the problem, such a bitstring always exists."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple possible answers, you may output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n1\n00\n11\n01\n3\n011001\n111010\n010001\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n010\n011001010\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the bitstrings "},{"children":[{"kind":"text","text":"00"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" are subsequences of the output string: "},{"children":[{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"1"},{"children":[{"kind":"text","text":"0"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":". Note that "},{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":" is not a subsequence of the output string, but this is not required."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case all three input strings are subsequences of the output string: "},{"children":[{"children":[{"kind":"text","text":"011"}],"kind":"container"},{"kind":"text","text":"0"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"1"},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"0"},{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":"00"},{"children":[{"kind":"text","text":"1010"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"1"},{"children":[{"kind":"text","text":"100"}],"kind":"container"},{"kind":"text","text":"1"},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":"0"}],"kind":"container"},{"kind":"tex