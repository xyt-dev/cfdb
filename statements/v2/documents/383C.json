{"assets":[],"contentKind":"statement","contestId":"383","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Propagating tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Iahub likes trees very much. Recently he discovered an interesting tree named propagating tree. The tree consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", each node "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" having an initial value "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". The root of the tree is node "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This tree has a special property: when a value "},{"kind":"math_inline","text":"val"},{"kind":"text","text":" is added to a value of node "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", the value -"},{"kind":"math_inline","text":"val"},{"kind":"text","text":" is added to values of all the children of node "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". Note that when you add value -"},{"kind":"math_inline","text":"val"},{"kind":"text","text":" to a child of node "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", you also add -(-"},{"kind":"math_inline","text":"val"},{"kind":"text","text":") to all children of the child of node "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and so on. Look an example explanation to understand better how it works."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This tree supports two types of queries:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"val"},{"kind":"text","text":"\" — "},{"kind":"math_inline","text":"val"},{"kind":"text","text":" is added to the value of node "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"x"},{"kind":"text","text":"\" — print the current value of node "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In order to help Iahub understand the tree better, you must answer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries of the preceding type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 200000)"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 1000)"},{"kind":"text","text":". Each of the next "},{"kind":"math_inline","text":"n–1"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ui"},{"kind":"math_inline","text":"(1 ≤ vi, ui ≤ n)"},{"kind":"text","text":", meaning that there is an edge between nodes "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains a query in the format described above. It is guaranteed that the following constraints hold for all queries: "},{"kind":"math_inline","text":"1 ≤ x ≤ n, 1 ≤ val ≤ 1000"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of type two (print the value of node "},{"kind":"math_inline","text":"x"},{"kind":"text","text":") you must print the answer to the query on a separate line. The queries must be answered in the order given in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n1 2 1 1 2\n1 2\n1 3\n2 4\n2 5\n1 2 3\n1 1 2\n2 1\n2 2\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n3\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The values of the nodes are "},{"kind":"math_inline","text":"[1, 2, 1, 1, 2]"},{"kind":"text","text":" at the beginning."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then value "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" is added to node "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". It propagates and value -"},{"kind":"math_inline","text":"3"},{"kind":"text","text":" is added to it's sons, node "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and node "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". Then it cannot propagate any more. So the values of the nodes are "},{"kind":"math_inline","text":"[1, 5, 1,  - 2,  - 1]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then value "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" is added to node "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". It propagates and value -"},{"kind":"math_inline","text":"2"},{"kind":"text","text":" is added to it's sons, node "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and node "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". From node "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" it propagates again, adding value "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to it's sons, node "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and node "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". Node "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" has no sons, so it cannot propagate from there. The values of the nodes are "},{"kind":"math_inline","text":"[3, 3,  - 1, 0, 1]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can see all the definitions about the tree at the following link: "},{"children":[{"kind":"text","text":"http://en.wikipedia.org/wiki/Tree_(graph_theory)"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"383C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/383/problem/C"}