{"assets":[],"contentKind":"statement","contestId":"64","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Path Canonization"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A path in some Unix-similar file system is given. The path consists of elements separated with characters \""},{"children":[{"kind":"text","text":"/"}],"kind":"container"},{"kind":"text","text":"\". For example: \""},{"children":[{"kind":"text","text":"/usr/share/mysql/../tomcat6/conf/server.xml"}],"kind":"container"},{"kind":"text","text":"\". The path starts with the root directory (i.e. starts with the character \""},{"children":[{"kind":"text","text":"/"}],"kind":"container"},{"kind":"text","text":"\"). Each element means a name of file or directory, or it is one of two special elements: \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" или \""},{"children":[{"kind":"text","text":".."}],"kind":"container"},{"kind":"text","text":"\". First of them stands for the current directory (for example, path \""},{"children":[{"kind":"text","text":"/./usr/././share"}],"kind":"container"},{"kind":"text","text":"\" is equal to \""},{"children":[{"kind":"text","text":"/usr/share"}],"kind":"container"},{"kind":"text","text":"\"). The second element \""},{"children":[{"kind":"text","text":".."}],"kind":"container"},{"kind":"text","text":"\" stands for the moving to the parent directory (for example, path \""},{"children":[{"kind":"text","text":"/usr/share/../lib"}],"kind":"container"},{"kind":"text","text":"\" is equal to \""},{"children":[{"kind":"text","text":"/usr/lib"}],"kind":"container"},{"kind":"text","text":"\")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You task is to convert the given path to such a path, which doesn't contain special elements \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" and/or \""},{"children":[{"kind":"text","text":".."}],"kind":"container"},{"kind":"text","text":"\". If it is impossible, print \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\". The only reason for it is an attempt to move to the parent directory from the root."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains the given path. The path starts with \""},{"children":[{"kind":"text","text":"/"}],"kind":"container"},{"kind":"text","text":"\" and consists of elements separated with \""},{"children":[{"kind":"text","text":"/"}],"kind":"container"},{"kind":"text","text":"\". No two \""},{"children":[{"kind":"text","text":"/"}],"kind":"container"},{"kind":"text","text":"\" follow one after another (consecutively). The only path which can end with \""},{"children":[{"kind":"text","text":"/"}],"kind":"container"},{"kind":"text","text":"\" is the root directory path equal to \""},{"children":[{"kind":"text","text":"/"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each element may contain \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\"-\""},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\"-\""},{"children":[{"kind":"text","text":"9"}],"kind":"container"},{"kind":"text","text":"\" and dots. Any element different from specials \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":".."}],"kind":"container"},{"kind":"text","text":"\" contains at least one character different from the dots."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The path length is between 1 and 1000 inclusively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the required path or \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"/usr/share/mysql/../tomcat6/conf/server.xml\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"/usr/share/tomcat6/conf/server.xml\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"/a/./././..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"/\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"64G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/64/problem/G"}