{"assets":["/statement-assets/f5dcda7c303da7c3cfd5f1a3ff67fa96981a888901528c45af35739378ee04f9.png","/statement-assets/f3e6af7a82c4aaece1d8dc54778ba1b69a2fd564e692cfda75c292de6bcf0597.png","/statement-assets/faf795cc7d3b12c697f75420e317d950397f2b09fa5a247e92b6a48287c5a8fb.png","/statement-assets/37770f148eb6cd56b401c43f2f495ef4f6cac116faa59735d6f0f310ca6fc0dd.png"],"contentKind":"statement","contestId":"484","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Sign on Fence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bizon the Champion has recently finished painting his wood fence. The fence consists of a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" panels of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" meter width and of arbitrary height. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th panel's height is "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" meters. The adjacent planks follow without a gap between them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After Bizon painted the fence he decided to put a \"for sale\" sign on it. The sign will be drawn on a rectangular piece of paper and placed on the fence so that the sides of the sign are parallel to the fence panels and are also aligned with the edges of some panels. Bizon the Champion introduced the following constraints for the sign position:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The width of the sign should be exactly "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" meters. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The sign must fit into the segment of the fence from the "},{"kind":"math_inline","text":"l"},{"kind":"text","text":"-th to the "},{"kind":"math_inline","text":"r"},{"kind":"text","text":"-th panels, inclusive (also, it can't exceed the fence's bound in vertical direction). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The sign will be really pretty, So Bizon the Champion wants the sign's height to be as large as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the description of the fence and several queries for placing sign. For each query print the maximum possible height of the sign that can be placed on the corresponding segment of the fence with the given fixed width of the sign."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the number of panels in the fence ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":", — the heights of the panels ("},{"kind":"math_inline","text":"1 ≤ hi ≤ 109"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains an integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the number of the queries ("},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the descriptions of the queries, each query is represented by three integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ w ≤ r - l + 1"},{"kind":"text","text":") — the segment of the fence and the width of the sign respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query print the answer on a separate line — the maximum height of the sign that can be put in the corresponding segment of the fence with all the conditions being satisfied."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 2 3 3\n3\n2 5 3\n2 5 2\n1 5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n3\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The fence described in the sample looks as follows: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f5dcda7c303da7c3cfd5f1a3ff67fa96981a888901528c45af35739378ee04f9.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The possible positions for the signs for all queries are given below."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f3e6af7a82c4aaece1d8dc54778ba1b69a2fd564e692cfda75c292de6bcf0597.png"},"kind":"image"},{"kind":"text","text":" The optimal position of the sign for the first query. "}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/faf795cc7d3b12c697f75420e317d950397f2b09fa5a247e92b6a48287c5a8fb.png"},"kind":"image"},{"kind":"text","text":" The optimal position of the sign for the second query. "}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/37770f148eb6cd56b401c43f2f495ef4f6cac116faa59735d6f0f310ca6fc0dd.png"},"kind":"image"},{"kind":"text","text":" The optimal position of the sign for the third query. "}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"484E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/484/problem/E"}