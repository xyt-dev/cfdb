{"assets":[],"contentKind":"statement","contestId":"747","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Display Size"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A big company decided to launch a new series of rectangular displays, and decided that the display must have exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pixels. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine the size of the rectangular display — the number of lines (rows) of pixels "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and the number of columns of pixels "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", so that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" there are exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pixels on the display; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the number of rows does not exceed the number of columns, it means "},{"kind":"math_inline","text":"a ≤ b"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the difference "},{"kind":"math_inline","text":"b - a"},{"kind":"text","text":" is as small as possible. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":") — the number of pixels display should have."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two integers — the number of rows and columns on the display. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"64\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8 8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"999999\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"999 1001\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the minimum possible difference equals 2, so on the display should be 2 rows of 4 pixels."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the minimum possible difference equals 0, so on the display should be 8 rows of 8 pixels."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example the minimum possible difference equals 4, so on the display should be 1 row of 5 pixels."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"747A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/747/problem/A"}