{"assets":[],"contentKind":"statement","contestId":"242","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. King's Path"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The black king is standing on a chess field consisting of "},{"kind":"math_inline","text":"109"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"109"},{"kind":"text","text":" columns. We will consider the rows of the field numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"109"},{"kind":"text","text":" from top to bottom. The columns are similarly numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"109"},{"kind":"text","text":" from left to right. We will denote a cell of the field that is located in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column as "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You know that some squares of the given chess field are "},{"children":[{"kind":"text","text":"allowed"}],"kind":"container"},{"kind":"text","text":". All allowed cells of the chess field are given as "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" segments. Each segment is described by three integers "},{"kind":"math_inline","text":"ri, ai, bi"},{"kind":"math_inline","text":"(ai ≤ bi)"},{"kind":"text","text":", denoting that cells in columns from number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" to number "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" inclusive in the "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":"-th row are allowed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the minimum number of moves the king needs to get from square "},{"kind":"math_inline","text":"(x0, y0)"},{"kind":"text","text":" to square "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":", provided that he only moves along the allowed cells. In other words, the king can be located only on allowed cells on his way."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us remind you that a chess king can move to any of the neighboring cells in one move. Two cells of a chess field are considered neighboring if they share at least one point."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four space-separated integers "},{"kind":"math_inline","text":"x0, y0, x1, y1"},{"kind":"math_inline","text":"(1 ≤ x0, y0, x1, y1 ≤ 109)"},{"kind":"text","text":", denoting the initial and the final positions of the king."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":", denoting the number of segments of allowed cells. Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the descriptions of these segments. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains three space-separated integers "},{"kind":"math_inline","text":"ri, ai, bi"},{"kind":"math_inline","text":"(1 ≤ ri, ai, bi ≤ 109, ai ≤ bi)"},{"kind":"text","text":", denoting that cells in columns from number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" to number "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" inclusive in the "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":"-th row are allowed. Note that the segments of the allowed cells can intersect and embed arbitrarily."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the king's initial and final position are allowed cells. It is guaranteed that the king's initial and the final positions do not coincide. It is guaranteed that the total length of all given segments doesn't exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no path between the initial and final position along allowed cells, print -1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print a single integer — the minimum number of moves the king needs to get from the initial position to the final one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 7 6 11\n3\n5 3 8\n6 7 11\n5 2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4 3 10\n3\n3 1 4\n4 5 9\n3 10 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 2 10\n2\n1 1 3\n2 6 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"242C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/242/problem/C"}