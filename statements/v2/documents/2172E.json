{"assets":[],"contentKind":"statement","contestId":"2172","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Number Maze"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"At the \"Number Maze,\" a mysterious code master stands guard. He blocks the path and smiles, saying: \"Brave adventurer, passing through this gate will not be easy! An ancient numeric code, capable of being rearranged into numerous combinations, is in the code master's possession. The traveler must choose two numeric codes from these combinations and show their "},{"children":[{"kind":"text","text":"$$$x$$$A$$$y$$$B"}],"kind":"container"},{"kind":"text","text":" result, or the gate will trap the traveler here forever!\""}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The rules of "},{"children":[{"kind":"text","text":"$$$x$$$A$$$y$$$B"}],"kind":"container"},{"kind":"text","text":" are as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Each "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" indicates that a digit in both codes matches in both value and position. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Each "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" indicates that a digit in both codes matches in value but not position. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example:"}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"Codes Compared"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"Result"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"Explanation"}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"5234 vs. 5789"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"1A0B"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"Only the digit $$$5$$$ matches in both value and position."}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"5634 vs. 6589"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"0A2B"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"Digits $$$5$$$ and $$$6$$$ match only in value but are in different positions."}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"1847 vs. 6149"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"1A1B"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"The digit $$$4$$$ matches in both value and position, while the digit $$$1$$$ only matches in value."}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"}],"kind":"container"},{"children":[{"kind":"text","text":"You are given a base numeric code $$$n$$$, which can be one of $$$\\{12, 123, 1234\\}$$$. Consider all possible permutations of the digits of $$$n$$$, sorted in ascending order. Let the $$$j$$$-th and $$$k$$$-th permutations (1-indexed) be the two numeric codes chosen by the traveler."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to compare these two permutations and determine their "},{"children":[{"kind":"text","text":"$$$x$$$A$$$y$$$B"}],"kind":"container"},{"kind":"text","text":" result, according to the rules above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains a single integer $$$t$$$, representing the number of tests the code master will conduct. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains three integers $$$n$$$, $$$j$$$, and $$$k$$$, representing the base numeric code and the indices of the two permutations to be compared, respectively."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1\\le t \\le 1000$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$n \\in \\{12,123,1234\\}$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Both $$$j$$$ and $$$k$$$ are valid indices of permutations of the digits of $$$n$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the result in the format "},{"children":[{"kind":"text","text":"$$$x$$$A$$$y$$$B"}],"kind":"container"},{"kind":"text","text":", where $$$x$$$ and $$$y$$$ are integers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attr