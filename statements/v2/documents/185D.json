{"assets":[],"contentKind":"statement","contestId":"185","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Visit of the Great"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Great Mushroom King descended to the dwarves, but not everyone managed to see him. Only the few chosen ones could see the King."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We know that only "},{"kind":"math_inline","text":"LCM(k2l + 1, k2l + 1 + 1, ..., k2r + 1)"},{"kind":"text","text":" dwarves can see the Great Mushroom King. Numbers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" are chosen by the Great Mushroom King himself in some complicated manner which is unclear to common dwarves. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The dwarven historians decided to document all visits of the Great Mushroom King. For each visit the dwarven historians know three integers "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":", "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", chosen by the Great Mushroom King for this visit. They also know a prime number "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":". Help them to count the remainder of dividing the number of dwarves who can see the King, by number "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":", for each visit."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the single integer "},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"(1 ≤ t ≤ 105)"},{"kind":"text","text":" — the number of the King's visits. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" input lines contains four space-separated integers "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":", "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"pi"},{"kind":"math_inline","text":"(1 ≤ ki ≤ 106"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"0 ≤ li ≤ ri ≤ 1018; 2 ≤ pi ≤ 109)"},{"kind":"text","text":" — the numbers, chosen by the Great Mushroom King and the prime module, correspondingly. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that for all visits number "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" is prime."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each visit print the answer on a single line — the remainder of dividing the number of the dwarves who can see the King this time, by number "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":". Print the answers for the visits in the order, in which the visits are described in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n3 1 10 2\n5 0 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"We consider that "},{"kind":"math_inline","text":"LCM(a1, a2, ..., an)"},{"kind":"text","text":" represents the least common multiple of numbers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"an"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We consider that "},{"kind":"math_inline","text":"x0 = 1"},{"kind":"text","text":", for any "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"185D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/185/problem/D"}