{"assets":["/statement-assets/f6adac3f3dd3b6a1d8e44b21106eb00f7fd1af3e405b9724c1957cbb43729941.png"],"contentKind":"statement","contestId":"371","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Vessels"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a system of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vessels arranged one above the other as shown in the figure below. Assume that the vessels are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", in the order from the highest to the lowest, the volume of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vessel is "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" liters."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f6adac3f3dd3b6a1d8e44b21106eb00f7fd1af3e405b9724c1957cbb43729941.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Initially, all the vessels are empty. In some vessels water is poured. All the water that overflows from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vessel goes to the "},{"kind":"math_inline","text":"(i + 1)"},{"kind":"text","text":"-th one. The liquid that overflows from the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th vessel spills on the floor."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to simulate pouring water into the vessels. To do this, you will need to handle two types of queries:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Add "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" liters of water to the "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":"-th vessel; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Print the number of liters of water in the "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":"-th vessel. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"When you reply to the second request you can assume that all the water poured up to this point, has already overflown between the vessels."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the number of vessels ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" — the vessels' capacities ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":"). The vessels' capacities do not necessarily increase from the top vessels to the bottom ones (see the second sample). The third line contains integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the number of queries ("},{"kind":"math_inline","text":"1 ≤ m ≤ 2·105"},{"kind":"text","text":"). Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains the description of one query. The query of the first type is represented as \""},{"kind":"math_inline","text":"1 pi xi"},{"kind":"text","text":"\", the query of the second type is represented as \""},{"kind":"math_inline","text":"2 ki"},{"kind":"text","text":"\" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ xi ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ki ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query, print on a single line the number of liters of water in the corresponding vessel."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n5 10\n6\n1 1 4\n2 1\n1 2 5\n1 1 4\n2 1\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n5\n8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n5 10 8\n6\n1 1 12\n2 2\n1 1 6\n1 3 2\n2 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n10\n5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"371D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/371/problem/D"}