{"assets":[],"contentKind":"statement","contestId":"2141","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Perfect Cut"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ consisting of characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", and/or "},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a binary (consisting of "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":") string "},{"children":[{"kind":"text","text":"perfect"}],"kind":"container"},{"kind":"text","text":" if you can cut the string into two non-empty parts: a prefix $$$a$$$ and the suffix $$$b$$$, such that $$$a_i \\ge b_i$$$ for each $$$i$$$ from $$$1$$$ to $$$\\min(|a|, |b|)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to calculate the number of ways to replace all the question marks (independently) with zeros and ones so that the resulting string is perfect mod. Two ways are considered different if there exists at least one position that has different characters in these two ways. Since the answer can be large, print it modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a string $$$s$$$ ($$$2 \\le |s| \\le 2 \\cdot 10^5$$$), consisting of characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", and/or "},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraint on the input: the sum of the lengths of the strings $$$s$$$ over all test cases doesn't exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single integer — the number of ways to replace all the question marks (independently) with zeros and ones so that the resulting string is perfect, taken modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n0?1\n011\n????\n110?0\n0?1?\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n0\n15\n2\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the string "},{"children":[{"kind":"text","text":"001"}],"kind":"container"},{"kind":"text","text":" can be split into a prefix of length $$$1$$$ and a suffix of length $$$2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, the following strings can be obtained:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The string "},{"children":[{"kind":"text","text":"11010"}],"kind":"container"},{"kind":"text","text":", which can be split into a prefix of length $$$2$$$ and a suffix of length $$$3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The string "},{"children":[{"kind":"text","text":"11000"}],"kind":"container"},{"kind":"text","text":", which can be split into a prefix of length $$$4$$$ and a suffix of length $$$1$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"2141E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2141/problem/E"}