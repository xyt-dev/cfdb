{"assets":[],"contentKind":"statement","contestId":"463","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Caisa and Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"10 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Caisa is now at home and his son has a simple task for him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a rooted tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices, numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" (vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is the root). Each vertex of the tree has a value. You should answer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries. Each query is one of the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Format of the query is \"1 "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"\". Let's write out the sequence of vertices along the path from the root to vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":": "},{"kind":"math_inline","text":"u1, u2, ..., uk"},{"kind":"math_inline","text":"(u1 = 1; uk = v)"},{"kind":"text","text":". You need to output such a vertex "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" that "},{"kind":"math_inline","text":"gcd(value of ui, value of v) > 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"i < k"},{"kind":"text","text":". If there are several possible vertices "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" pick the one with maximum value of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". If there is no such vertex output "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Format of the query is \"2 "},{"kind":"math_inline","text":"v"},{"kind":"math_inline","text":"w"},{"kind":"text","text":"\". You must change the value of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"w"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given all the queries, help Caisa to solve the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"q"},{"kind":"math_inline","text":"(1 ≤ n, q ≤ 105)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 2·106)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" represent the value of node "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"math_inline","text":"(1 ≤ xi, yi ≤ n; xi ≠ yi)"},{"kind":"text","text":", denoting the edge of the tree between vertices "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains a query in the format that is given above. For each query the following inequalities hold: "},{"kind":"math_inline","text":"1 ≤ v ≤ n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 ≤ w ≤ 2·106"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"Note that"}],"kind":"container"},{"kind":"text","text":": there are no more than "},{"kind":"math_inline","text":"50"},{"kind":"text","text":" queries that changes the value of a vertex."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the first type output the result of the query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 6\n10 8 4 3\n1 2\n2 3\n3 4\n1 1\n1 2\n1 3\n1 4\n2 1 9\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n1\n2\n-1\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"math_inline","text":"gcd(x, y)"},{"kind":"text","text":" is greatest common divisor of two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"463E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/463/problem/E"}