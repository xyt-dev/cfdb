{"assets":[],"contentKind":"statement","contestId":"2159","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Rectangles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a binary grid$$$^{\\text{∗}}$$$ $$$G$$$ of dimensions $$$n \\times m$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us define a "},{"children":[{"kind":"text","text":"rectangle"}],"kind":"container"},{"kind":"text","text":" as a tuple $$$(u,d,l,r)$$$ that satisfies the following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1 \\le \\boldsymbol{u \\lt d} \\le n$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$1 \\le \\boldsymbol{l \\lt r} \\le m$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Cells $$$(u,l)$$$, $$$(u,r)$$$, $$$(d,l)$$$, $$$(d,r)$$$ all contain a $$$1$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Then, the "},{"children":[{"kind":"text","text":"area"}],"kind":"container"},{"kind":"text","text":" of a rectangle $$$(u,d,l,r)$$$ is defined as $$$(d-u+1) \\cdot (r-l+1)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, consider the following binary grid given below."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$\\begin{matrix} 1 & 0 & 1 & 0 & 1 \\\\ 1 & 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & 0 & 1 \\end{matrix}$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here, you may see two rectangles $$$(1,2,1,3)$$$ and $$$(1,3,3,5)$$$$$$^{\\text{†}}$$$, each of which has area $$$6$$$ and $$$9$$$, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each cell $$$(i,j)$$$, find the "},{"children":[{"kind":"text","text":"minimum area"}],"kind":"container"},{"kind":"text","text":" of any rectangle $$$(u,d,l,r)$$$ such that $$$u \\le i \\le d$$$ and $$$l \\le j \\le r$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$A binary grid is a grid where each cell contains $$$0$$$ or $$$1$$$. The cell on the $$$j$$$-th column of the $$$i$$$-th row is denoted as cell $$$(i,j)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$^{\\text{†}}$$$Note that these are the only rectangles in the grid; for example, $$$(1,1,1,5)$$$ is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" a rectangle as it does not satisfy $$$u \\lt d$$$."}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$m$$$ ($$$2 \\le n,m$$$, $$$n\\cdot m \\le 250\\,000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the $$$n$$$ following lines contains a string of length $$$m$$$ denoting the $$$i$$$-th row of $$$G$$$ ($$$G_{i,j} \\in \\{0,1\\}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n\\cdot m$$$ over all test cases does not exceed $$$250\\,000$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a grid of $$$n$$$ rows and $$$m$$$ columns. On the $$$j$$$-th column of the $$$i$$$-th row, you should output:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If there exists a rectangle $$$(u,d,l,r)$$$ such that $$$u \\le i \\le d$$$ and $$$l \\le j \\le r$$$, output the minimum area of any such rectangle; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Otherwise, output $$$0$$$ instead. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n3 5\n10101\n10100\n00101\n4 6\n011101\n010001\n100010\n101110\n5 5\n11100\n10110\n11111\n01101\n00111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n6 6 6 9 9\n6 6 6 9 9\n0 0 9 9 9\n0 10 8 8 10 10\n0 10 8 8 10 10\n10 10 8 8 10 0\n10 10 8 8 10 0\n6 6 6 0 0\n6 6 4 4 0\n6 4 4 4 6\n0 4 4 6 6\n0 0 6 6 6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test case is explained in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the third test case, there are six rectangles that cover at least one cell with minimum area:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$(1,3,1,2)$$$, which has area $$$6$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(1,2,1,3)$$$, which has area $$$6$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(3,4,2,3)$$$, which has area $$$4$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(2,3,3,4)$$$, which has area $$$4$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(3,5,4,5)$$$, which has area $$$6$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(4,5,3,5)$$$, which has area $$$6$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"2159B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2159/problem/B"}