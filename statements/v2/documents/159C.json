{"assets":[],"contentKind":"statement","contestId":"159","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. String Manipulation 1.0"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One popular website developed an unusual username editing procedure. One can change the username only by deleting some characters from it: to change the current name "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", a user can pick number "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and character "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" and delete the "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"-th occurrence of character "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" from the name. After the user changed his name, he can't undo the change."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, one can change name \""},{"children":[{"kind":"text","text":"arca"}],"kind":"container"},{"kind":"text","text":"\" by removing the second occurrence of character \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" to get \""},{"children":[{"kind":"text","text":"arc"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus learned that some user initially registered under nickname "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is a concatenation of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" copies of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Also, Polycarpus knows the sequence of this user's name changes. Help Polycarpus figure out the user's final name."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 2000"},{"kind":"text","text":"). The second line contains a non-empty string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of lowercase Latin letters, at most "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" characters long. The third line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ n ≤ 20000"},{"kind":"text","text":") — the number of username changes. Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains the actual changes, one per line. The changes are written as \""},{"kind":"math_inline","text":"pi"},{"kind":"math_inline","text":"ci"},{"kind":"text","text":"\" (without the quotes), where "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ 200000"},{"kind":"text","text":") is the number of occurrences of letter "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" is a lowercase Latin letter. It is guaranteed that the operations are correct, that is, the letter to be deleted always exists, and after all operations not all letters are deleted from the name. The letters' occurrences are numbered starting from 1."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single string — the user's final name after all changes are applied to it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\nbac\n3\n2 a\n1 b\n2 c\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"acb\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\nabacaba\n4\n1 a\n1 a\n1 c\n2 b\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"baa\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's consider the first sample. Initially we have name \""},{"children":[{"kind":"text","text":"bacbac"}],"kind":"container"},{"kind":"text","text":"\"; the first operation transforms it into \""},{"children":[{"kind":"text","text":"bacbc"}],"kind":"container"},{"kind":"text","text":"\", the second one — to \""},{"children":[{"kind":"text","text":"acbc"}],"kind":"container"},{"kind":"text","text":"\", and finally, the third one transforms it into \""},{"children":[{"kind":"text","text":"acb"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"159C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/159/problem/C"}