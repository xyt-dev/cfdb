{"assets":[],"contentKind":"statement","contestId":"2034","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Permutations Harmony"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Rayan wants to present a gift to Reyhaneh to win her heart. However, Reyhaneh is particular and will only accept a "},{"children":[{"kind":"text","text":"k-harmonic set of permutations"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We define a "},{"children":[{"kind":"text","text":"k-harmonic set of permutations"}],"kind":"container"},{"kind":"text","text":" as a set of $$$k$$$ "},{"children":[{"kind":"text","text":"pairwise distinct"}],"kind":"container"},{"kind":"text","text":" permutations $$$p_1, p_2, \\ldots, p_k$$$ of size $$$n$$$ such that for every pair of indices $$$i$$$ and $$$j$$$ (where $$$1 \\leq i, j \\leq n$$$), the following condition holds:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$ p_1[i] + p_2[i] + \\ldots + p_k[i] = p_1[j] + p_2[j] + \\ldots + p_k[j] $$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to help Rayan by either providing a valid "},{"children":[{"kind":"text","text":"k-harmonic set of permutations"}],"kind":"container"},{"kind":"text","text":" for given values of $$$n$$$ and $$$k$$$ or by determining that such a set does not exist."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We call a sequence of length $$$n$$$ a permutation if it contains every integer from $$$1$$$ to $$$n$$$ exactly once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 1000$$$), the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two integers $$$n$$$ and $$$k$$$ ($$$1 \\leq n, k \\leq 10^5$$$). The sum of $$$n \\cdot k$$$ over all test cases does not exceed $$$5 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, if a "},{"children":[{"kind":"text","text":"k-harmonic set of permutations"}],"kind":"container"},{"kind":"text","text":" exists, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" on the first line. Then, print $$$k$$$ lines, each containing a distinct permutation of the integers from $$$1$$$ to $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If no such set exists, print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" on the first line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output \"YES\" and \"NO\" in any case (for example, strings \"yEs\", \"yes\", and \"Yes\" will be recognized as a positive response)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If multiple answers are possible, you can output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n3 3\n4 2\n5 1\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n1 2 3\n2 3 1\n3 1 2\nYES\n1 2 3 4\n4 3 2 1\nNO\nYES\n1 2 3\n3 2 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In example 1, we have $$$p_1 = [1, 2, 3]$$$, $$$p_2 = [2, 3, 1]$$$, and $$$p_3 = [3, 1, 2]$$$. It's easy to see that $$$p_1[1] + p_2[1] + p_3[1] = p_1[2] + p_2[2] + p_3[2] = p_1[3] + p_2[3] + p_3[3] = 6$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In example 2, we have $$$p_1 = [1, 2, 3, 4]$$$ and $$$p_2 = [4, 3, 2, 1]$$$. It's easy to see that $$$p_1[1] + p_2[1] = p_1[2] + p_2[2] = p_1[3] + p_2[3] = p_1[4] + p_2[4] = 5$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In example 3, as there are five distinct elements in $$$p_1$$$, it's obvious that the answer is \"No\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"2034E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2034/problem/E"}