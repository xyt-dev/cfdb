{"assets":[],"contentKind":"statement","contestId":"110","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Lucky String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Petya loves lucky numbers. We all know that lucky numbers are the positive integers whose decimal representations contain only the lucky digits "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":". For example, numbers "},{"children":[{"kind":"text","text":"47"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"744"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" are lucky and "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"17"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"467"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya recently learned to determine whether a string of lowercase Latin letters is lucky. For each individual letter all its positions in the string are written out in the increasing order. This results in "},{"kind":"math_inline","text":"26"},{"kind":"text","text":" lists of numbers; some of them can be empty. A string is considered lucky if and only if in each list the absolute difference of any two "},{"children":[{"kind":"text","text":"adjacent"}],"kind":"container"},{"kind":"text","text":" numbers is a lucky number. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, let's consider string \""},{"children":[{"kind":"text","text":"zbcdzefdzc"}],"kind":"container"},{"kind":"text","text":"\". The lists of positions of equal letters are:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":": "},{"kind":"math_inline","text":"2"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":": "},{"kind":"math_inline","text":"3, 10"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":": "},{"kind":"math_inline","text":"4, 8"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":": "},{"kind":"math_inline","text":"6"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"f"}],"kind":"container"},{"kind":"text","text":": "},{"kind":"math_inline","text":"7"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":": "},{"kind":"math_inline","text":"1, 5, 9"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Lists of positions of letters "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"g"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"h"}],"kind":"container"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":" are empty."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"This string is lucky as all differences are lucky numbers. For letters "},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":": "},{"kind":"math_inline","text":"5 - 1 = 4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"9 - 5 = 4"},{"kind":"text","text":", for letters "},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":": "},{"kind":"math_inline","text":"10 - 3 = 7"},{"kind":"text","text":", for letters "},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":": "},{"kind":"math_inline","text":"8 - 4 = 4"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that if some letter occurs only once in a string, it doesn't influence the string's luckiness after building the lists of positions of equal letters. The string where all the letters are distinct is considered lucky."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the lexicographically minimal lucky string whose length equals "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the length of the sought string."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print on the single line the lexicographically minimal lucky string whose length equals "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level"