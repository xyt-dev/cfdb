{"assets":[],"contentKind":"statement","contestId":"725","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Jumping Ball"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In a new version of the famous Pinball game, one of the most important parts of the game field is a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" bumpers. The bumpers are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right. There are two types of bumpers. They are denoted by the characters '"},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":"'. When the ball hits the bumper at position "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" it goes one position to the right (to the position "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":") if the type of this bumper is '"},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":"', or one position to the left (to "},{"kind":"math_inline","text":"i - 1"},{"kind":"text","text":") if the type of the bumper at position "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is '"},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":"'. If there is no such position, in other words if "},{"kind":"math_inline","text":"i - 1 < 1"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"i + 1 > n"},{"kind":"text","text":", the ball falls from the game field."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Depending on the ball's starting position, the ball may eventually fall from the game field or it may stay there forever. You are given a string representing the bumpers' types. Calculate the number of positions such that the ball will eventually fall from the game field if it starts at that position."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000"},{"kind":"text","text":") — the length of the sequence of bumpers. The second line contains the string, which consists of the characters '"},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":"'. The character at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th position of this string corresponds to the type of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th bumper."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the number of positions in the sequence such that the ball will eventually fall from the game field if it starts at that position."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n<<><\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n>>>>>\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n>><<\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the ball will fall from the field if starts at position "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" or position "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, any starting position will result in the ball falling from the field."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"725A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/725/problem/A"}