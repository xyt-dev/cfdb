{"assets":[],"contentKind":"statement","contestId":"363","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Renting Bikes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A group of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" schoolboys decided to ride bikes. As nobody of them has a bike, the boys need to rent them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The renting site offered them "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" bikes. The renting price is different for different bikes, renting the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th bike costs "},{"kind":"math_inline","text":"pj"},{"kind":"text","text":" rubles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In total, the boys' shared budget is "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" rubles. Besides, each of them has his own personal money, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th boy has "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" personal rubles. The shared budget can be spent on any schoolchildren arbitrarily, but each boy's personal money can be spent on renting only this boy's bike."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each boy can rent "},{"children":[{"kind":"text","text":"at most one bike"}],"kind":"container"},{"kind":"text","text":", one cannot give his bike to somebody else."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What maximum number of schoolboys will be able to ride bikes? What minimum sum of personal money will they have to spend in total to let as many schoolchildren ride bikes as possible?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"0 ≤ a ≤ 109"},{"kind":"text","text":"). The second line contains the sequence of integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ 104"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is the amount of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th boy's personal money. The third line contains the sequence of integers "},{"kind":"math_inline","text":"p1, p2, ..., pm"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pj ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"pj"},{"kind":"text","text":" is the price for renting the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th bike."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two integers "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" is the maximum number of schoolboys that can rent a bike and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is the minimum total personal money needed to rent "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" bikes. If the schoolchildren cannot rent any bikes, then "},{"kind":"math_inline","text":"r = s = 0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 10\n5 5\n7 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5 2\n8 1 1 2\n6 3 7 5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample both schoolchildren can rent a bike. For instance, they can split the shared budget in half (5 rubles each). In this case one of them will have to pay 1 ruble from the personal money and the other one will have to pay 2 rubles from the personal money. In total, they spend 3 rubles of their personal money. This way of distribution of money minimizes the amount of spent personal money."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"363D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/363/problem/D"}