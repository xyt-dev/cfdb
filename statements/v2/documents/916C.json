{"assets":["/statement-assets/5c4323e3ffeeb0dfc4aa164894f38f6fc728185cd7aff6bb46bf9aa581da9d41.png","/statement-assets/814a81a6f9c5d6ea2dc74156a68683d9eb3c5f4f3cc3e44ef9d53eb78afe1f5f.png","/statement-assets/623ef485b2a25bbf2699c5fb6e2d01d43e78ea709d15eacf6121cf2155a8b4c8.png"],"contentKind":"statement","contestId":"916","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Jamie and Interesting Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Jamie has recently found undirected weighted graphs with the following properties very "},{"children":[{"kind":"text","text":"interesting"}],"kind":"container"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The graph is connected and contains exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" All edge weights are integers and are in range "},{"kind":"math_inline","text":"[1, 109]"},{"kind":"text","text":" inclusive. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The length of shortest path from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is a prime number. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The sum of edges' weights in the minimum spanning tree (MST) of the graph is a prime number. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The graph contains no loops or multi-edges. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If you are not familiar with some terms from the statement you can find definitions of them in notes section. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Jamie construct any graph with given number of vertices and edges that is "},{"children":[{"kind":"text","text":"interesting"}],"kind":"container"},{"kind":"text","text":"!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of input contains 2 integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"attrs":{"alt":"","src":"/statement-assets/5c4323e3ffeeb0dfc4aa164894f38f6fc728185cd7aff6bb46bf9aa581da9d41.png"},"kind":"image"},{"kind":"text","text":" — the required number of vertices and edges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line output 2 integers "},{"kind":"math_inline","text":"sp"},{"kind":"text","text":", "},{"kind":"math_inline","text":"mstw"},{"kind":"math_inline","text":"(1 ≤ sp, mstw ≤ 1014)"},{"kind":"text","text":" — the length of the shortest path and the sum of edges' weights in the minimum spanning tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines output the edges of the graph. In each line output 3 integers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", "},{"kind":"math_inline","text":"w"},{"kind":"math_inline","text":"(1 ≤ u, v ≤ n, 1 ≤ w ≤ 109)"},{"kind":"text","text":" describing the edge connecting "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and having weight "},{"kind":"math_inline","text":"w"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7 7\n1 2 3\n2 3 2\n3 4 2\n2 4 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7 13\n1 2 2\n1 3 4\n1 4 3\n4 5 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"The graph of sample 1:"}],"kind":"container"},{"attrs":{"alt":"","src":"/statement-assets/814a81a6f9c5d6ea2dc74156a68683d9eb3c5f4f3cc3e44ef9d53eb78afe1f5f.png"},"kind":"image"},{"kind":"text","text":" Shortest path sequence: "},{"kind":"math_inline","text":"{1, 2, 3, 4}"},{"kind":"text","text":". MST edges are marked with an asterisk (*)."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Definition of terms used in the problem statement:"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"shortest path"}],"kind":"container"},{"kind":"text","text":" in an undirected graph is a sequence of vertices "},{"kind":"math_inline","text":"(v1, v2, ... , vk)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" is adjacent to "},{"kind":"math_inline","text":"vi + 1"},{"kind":"math_inline","text":"1 ≤ i < k"},{"kind":"text","text":" and the sum of weight "},{"attrs":{"alt":"","src":"/statement-assets/623ef485b2a25bbf2699c5fb6e2d01d43e78ea709d15eacf6121cf2155a8b4c8.png"},"kind":"image"},{"kind":"text","text":" is minimized where "},{"kind":"math_inline","text":"w(i, j)"},{"kind":"text","text":" is the edge weight between "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":". ("},{"attrs":{"href":"https://en.wikipedia.org/wiki/Shortest_path_problem"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Shortest_path_problem"}],"kind":"link"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"prime number"}],"kind":"container"},{"kind":"text","text":" is a natural number greater than 1 that has no positive divisors other than 1 and itself. ("},{"attrs":{"href":"https://en.wikipedia.org/wiki/Prime_number"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Prime_number"}],"kind":"link"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"minimum spanning tree (MST)"}],"kind":"container"},{"kind":"text","text":" is a subset of the edges of a connected, edge-weighted undirected graph that connects all the vertices together, without any cycles and with the minimum possible total edge weight. ("},{"attrs":{"href":"https://en.wikipedia.org/wiki/Minimum_spanning_tree"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Minimum_spanning_tree"}],"kind":"link"},{"kind":"text","text":")"}],"kind":"paragraph"},{"children":[{"attrs":{"href":"https://en.wikipedia.org/wiki/Multiple_edges"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Multiple_edges"}],"kind":"link"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"916C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/916/problem/C"}