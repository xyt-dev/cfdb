{"assets":["/statement-assets/f1d8c40b30bde6174a8d793ebde8423e1a4cba5c2b2405f1ac46a23dd041c7eb.png"],"contentKind":"statement","contestId":"809","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Hitchhiking in the Baltic States"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Leha and Noora decided to go on a trip in the Baltic States. As you know from the previous problem, Leha has lost his car on the parking of the restaurant. Unfortunately, requests to the watchman didn't helped hacker find the car, so friends decided to go hitchhiking."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In total, they intended to visit "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" towns. However it turned out that sights in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th town are open for visitors only on days from "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What to do? Leha proposed to choose for each town "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" a day, when they will visit this town, i.e any integer "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" in interval "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":". After that Noora choses some subsequence of towns "},{"kind":"math_inline","text":"id1, id2, ..., idk"},{"kind":"text","text":", which friends are going to visit, that at first they are strictly increasing, i.e "},{"kind":"math_inline","text":"idi < idi + 1"},{"kind":"text","text":" is for all integers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k - 1"},{"kind":"text","text":", but also the dates of the friends visits are strictly increasing, i.e "},{"kind":"math_inline","text":"xidi < xidi + 1"},{"kind":"text","text":" is true for all integers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k - 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please help Leha and Noora in choosing such "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" for each town "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", and such subsequence of towns "},{"kind":"math_inline","text":"id1, id2, ..., idk"},{"kind":"text","text":", so that friends can visit maximal number of towns."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may assume, that Leha and Noora can start the trip any day."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 3·105"},{"kind":"text","text":") denoting the number of towns Leha and Noora intended to visit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each line "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" subsequent lines contains two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"math_inline","text":"(1 ≤ li ≤ ri ≤ 109)"},{"kind":"text","text":", denoting that sights in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th town are open for visitors on any day "},{"attrs":{"alt":"","src":"/statement-assets/f1d8c40b30bde6174a8d793ebde8423e1a4cba5c2b2405f1ac46a23dd041c7eb.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer denoting the maximal number of towns, that Leha and Noora can visit."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n6 6\n1 2\n3 4\n2 2\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first example."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's take this plan: let's visit the sight in the second town on the first day, in the third town on the third day and in the fifth town on the fourth. That's would be the optimal answer."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"809D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/809/problem/D"}