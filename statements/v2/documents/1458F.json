{"assets":[],"contentKind":"statement","contestId":"1458","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Range Diameter Sum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"7 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a tree with $$$n$$$ vertices numbered $$$1, \\ldots, n$$$. A tree is a connected simple graph without cycles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$\\mathrm{dist}(u, v)$$$ be the number of edges in the unique simple path connecting vertices $$$u$$$ and $$$v$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$\\mathrm{diam}(l, r) = \\max \\mathrm{dist}(u, v)$$$ over all pairs $$$u, v$$$ such that $$$l \\leq u, v \\leq r$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Compute $$$\\sum_{1 \\leq l \\leq r \\leq n} \\mathrm{diam}(l, r)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$1 \\leq n \\leq 10^5$$$) — the number of vertices in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n - 1$$$ lines describe the tree edges. Each of these lines contains two integers $$$u, v$$$ ($$$1 \\leq u, v \\leq n$$$) — endpoint indices of the respective tree edge. It is guaranteed that the edge list indeed describes a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — $$$\\sum_{1 \\leq l \\leq r \\leq n} \\mathrm{diam}(l, r)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 2\n2 4\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n1 8\n2 9\n5 6\n4 8\n4 2\n7 9\n3 6\n10 4\n3 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n224\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1458F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1458/problem/F"}