{"assets":[],"contentKind":"statement","contestId":"14","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Camels"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bob likes to draw camels: with a single hump, two humps, three humps, etc. He draws a camel by connecting points on a coordinate plane. Now he's drawing camels with "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" humps, representing them as polylines in the plane. Each polyline consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices with coordinates "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"(xn, yn)"},{"kind":"text","text":". The first vertex has a coordinate "},{"kind":"math_inline","text":"x1 = 1"},{"kind":"text","text":", the second — "},{"kind":"math_inline","text":"x2 = 2"},{"kind":"text","text":", etc. Coordinates "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" might be any, but should satisfy the following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" there should be "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" humps precisely, i.e. such indexes "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ j ≤ n - 1"},{"kind":"text","text":"), so that "},{"kind":"math_inline","text":"yj - 1 < yj > yj + 1"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" there should be precisely "},{"kind":"math_inline","text":"t - 1"},{"kind":"text","text":" such indexes "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ j ≤ n - 1"},{"kind":"text","text":"), so that "},{"kind":"math_inline","text":"yj - 1 > yj < yj + 1"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" no segment of a polyline should be parallel to the "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":"-axis, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" all "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" are integers between 1 and 4. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For a series of his drawings of camels with "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" humps Bob wants to buy a notebook, but he doesn't know how many pages he will need. Output the amount of different polylines that can be drawn to represent camels with "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" humps for a given number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a pair of integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 20"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ t ≤ 10"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the required amount of camels with "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" humps."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test sequences of "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"-coordinates for six camels are: 123421, 123431, 123432, 124321, 134321 и 234321 (each digit corresponds to one value of "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"14E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/14/problem/E"}