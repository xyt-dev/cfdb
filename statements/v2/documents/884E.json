{"assets":["/statement-assets/bf772544a31e985bcc26bb7a2d696adc7195c9f24402bf00a1f8bb90b80b3e89.png"],"contentKind":"statement","contestId":"884","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Binary Matrix"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"16 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a matrix of size "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":". Each element of the matrix is either 1 or 0. You have to determine the number of connected components consisting of 1's. Two cells belong to the same component if they have a common border, and both elements in these cells are 1's."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note that the memory limit is unusual!"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 212"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4 ≤ m ≤ 214"},{"kind":"text","text":") — the number of rows and columns, respectively. It is guaranteed that "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is divisible by 4."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then the representation of matrix follows. Each of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" next lines contains "},{"attrs":{"alt":"","src":"/statement-assets/bf772544a31e985bcc26bb7a2d696adc7195c9f24402bf00a1f8bb90b80b3e89.png"},"kind":"image"},{"kind":"text","text":" one-digit hexadecimal numbers (that is, these numbers can be represented either as digits from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" or as uppercase Latin letters from "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"F"},{"kind":"text","text":"). Binary representation of each of these numbers denotes next "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" elements of the matrix in the corresponding row. For example, if the number "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" is given, then the corresponding elements are "},{"children":[{"kind":"text","text":"1011"}],"kind":"container"},{"kind":"text","text":", and if the number is "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", then the corresponding elements are "},{"children":[{"kind":"text","text":"0101"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Elements are not separated by whitespaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of connected components consisting of 1's. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n1\nA\n8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 8\n5F\nE3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 4\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the matrix is: "}],"kind":"paragraph"},{"kind":"code_block","text":"\n0001\n1010\n1000\n"},{"children":[{"kind":"text","text":"It is clear that it has three components."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second example: "}],"kind":"paragraph"},{"kind":"code_block","text":"\n01011111\n11100011\n"},{"children":[{"kind":"text","text":"It is clear that the number of components is 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are no 1's in the third example, so the answer is 0."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"884E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/884/problem/E"}