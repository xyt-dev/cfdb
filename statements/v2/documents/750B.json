{"assets":["/statement-assets/5f50c96eae7af392d308b635795670fc98240fa29e960ffd9fef16005274c4c7.png","/statement-assets/0233249c069aa8fef8265c256a496ee0c7e54c0715b0106bea002fa411ce8510.png"],"contentKind":"statement","contestId":"750","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. New Year and North Pole"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In this problem we assume the Earth to be a completely round ball and its surface a perfect sphere. The length of the equator and any meridian is considered to be exactly "},{"kind":"math_inline","text":"40 000"},{"kind":"text","text":" kilometers. Thus, travelling from North Pole to South Pole or vice versa takes exactly "},{"kind":"math_inline","text":"20 000"},{"kind":"text","text":" kilometers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak, a polar bear, lives on the North Pole. Close to the New Year, he helps somebody with delivering packages all around the world. Instead of coordinates of places to visit, Limak got a description how he should move, assuming that he starts from the North Pole. The description consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" parts. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th part of his journey, Limak should move "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" kilometers in the direction represented by a string "},{"kind":"math_inline","text":"diri"},{"kind":"text","text":" that is one of: \""},{"children":[{"kind":"text","text":"North"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"South"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"West"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"East"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak isn’t sure whether the description is valid. You must help him to check the following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If at any moment of time (before any of the instructions or while performing one of them) Limak is on the North Pole, he can move only to the South. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If at any moment of time (before any of the instructions or while performing one of them) Limak is on the South Pole, he can move only to the North. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The journey must end on the North Pole. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Check if the above conditions are satisfied and print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" on a single line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains an integer "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" and a string "},{"kind":"math_inline","text":"diri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 106"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/5f50c96eae7af392d308b635795670fc98240fa29e960ffd9fef16005274c4c7.png"},"kind":"image"},{"kind":"text","text":") — the length and the direction of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th part of the journey, according to the description Limak got."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if the description satisfies the three conditions, otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\", both without the quotes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n7500 South\n10000 East\n3500 North\n4444 West\n4000 North\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n15000 South\n4000 East\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n20000 South\n1000 North\n1000000 West\n9000 North\n10000 North\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n20000 South\n10 East\n20000 North\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1000 North\n1000 South\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n50 South\n50 North\n15000 South\n15000 North\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Drawings below show how Limak's journey would look like in first two samples. In the second sample the answer is \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" because he doesn't end on the North Pole."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0233249c069aa8fef8265c256a496ee0c7e54c0715b0106bea002fa411ce8510.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"750B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/750/problem/B"}