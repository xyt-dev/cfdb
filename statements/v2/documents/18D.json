{"assets":[],"contentKind":"statement","contestId":"18","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Seller Bob"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"128 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Last year Bob earned by selling memory sticks. During each of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days of his work one of the two following events took place: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" A customer came to Bob and asked to sell him a "},{"kind":"math_inline","text":"2x"},{"kind":"text","text":" MB memory stick. If Bob had such a stick, he sold it and got "},{"kind":"math_inline","text":"2x"},{"kind":"text","text":" berllars. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Bob won some programming competition and got a "},{"kind":"math_inline","text":"2x"},{"kind":"text","text":" MB memory stick as a prize. Bob could choose whether to present this memory stick to one of his friends, or keep it. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Bob never kept more than one memory stick, as he feared to mix up their capacities, and deceive a customer unintentionally. It is also known that for each memory stick capacity there was at most one customer, who wanted to buy that memory stick. Now, knowing all the customers' demands and all the prizes won at programming competitions during the last "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days, Bob wants to know, how much money he could have earned, if he had acted optimally."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5000"},{"kind":"text","text":") — amount of Bob's working days. The following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the description of the days. Line "},{"children":[{"kind":"text","text":"sell x"}],"kind":"container"},{"kind":"text","text":" stands for a day when a customer came to Bob to buy a "},{"kind":"math_inline","text":"2x"},{"kind":"text","text":" MB memory stick ("},{"kind":"math_inline","text":"0 ≤ x ≤ 2000"},{"kind":"text","text":"). It's guaranteed that for each "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" there is not more than one line "},{"children":[{"kind":"text","text":"sell x"}],"kind":"container"},{"kind":"text","text":". Line "},{"children":[{"kind":"text","text":"win x"}],"kind":"container"},{"kind":"text","text":" stands for a day when Bob won a "},{"kind":"math_inline","text":"2x"},{"kind":"text","text":" MB memory stick ("},{"kind":"math_inline","text":"0 ≤ x ≤ 2000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the maximum possible earnings for Bob in berllars, that he would have had if he had known all the events beforehand. Don't forget, please, that Bob can't keep more than one memory stick at a time."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\nwin 10\nwin 5\nwin 3\nsell 5\nsell 3\nwin 10\nsell 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1056\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nwin 5\nsell 6\nsell 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"18D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/18/problem/D"}