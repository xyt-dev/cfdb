{"assets":["/statement-assets/8c75df0edc07c876927f5fd8eb6b9e4162deab81e42a0c42768872a3aec2847c.png"],"contentKind":"statement","contestId":"933","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. A Determined Cleanup"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"In order to put away old things and welcome a fresh new year, a thorough cleaning of the house is a must."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Little Tommy finds an old polynomial and cleaned it up by taking it modulo another. But now he regrets doing this..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given two integers "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", find a polynomial "},{"kind":"math_inline","text":"f(x)"},{"kind":"text","text":" with non-negative integer coefficients strictly less than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", whose remainder is "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" when divided by "},{"kind":"math_inline","text":"(x + k)"},{"kind":"text","text":". That is, "},{"kind":"math_inline","text":"f(x) = q(x)·(x + k) + p"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"q(x)"},{"kind":"text","text":" is a polynomial (not necessarily with integer coefficients)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"a