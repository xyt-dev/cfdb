{"assets":[],"contentKind":"statement","contestId":"167","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Wizards and Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In some country live wizards. They love playing with numbers. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The blackboard has two numbers written on it — "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The order of the numbers is not important. Let's consider "},{"kind":"math_inline","text":"a ≤ b"},{"kind":"text","text":" for the sake of definiteness. The players can cast one of the two spells in turns:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Replace "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"b - ak"},{"kind":"text","text":". Number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" can be chosen by the player, considering the limitations that "},{"kind":"math_inline","text":"k > 0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b - ak ≥ 0"},{"kind":"text","text":". Number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is chosen independently each time an active player casts a spell. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Replace "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"b mod a"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"a > b"},{"kind":"text","text":", similar moves are possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If at least one of the numbers equals zero, a player can't make a move, because taking a remainder modulo zero is considered somewhat uncivilized, and it is far too boring to subtract a zero. The player who cannot make a move, loses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To perform well in the magic totalizator, you need to learn to quickly determine which player wins, if both wizards play optimally: the one that moves first or the one that moves second."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — the number of input data sets ("},{"kind":"math_inline","text":"1 ≤ t ≤ 104"},{"kind":"text","text":"). Each of the next "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ a, b ≤ 1018"},{"kind":"text","text":"). The numbers are separated by a space."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specificator to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specificator."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For any of the "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" input sets print \""},{"children":[{"kind":"text","text":"First"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) if the player who moves first wins. Print \""},{"children":[{"kind":"text","text":"Second"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) if the player who moves second wins. Print the answers to different data sets on different lines in the order in which they are given in the input. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n10 21\n31 10\n0 1\n10 30\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"First\nSecond\nSecond\nFirst\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the first player should go to (11,10). Then, after a single move of the second player to (1,10), he will take 10 modulo 1 and win."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the first player has two moves to (1,10) and (21,10). After both moves the second player can win."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, the first player has no moves."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth sample, the first player wins in one move, taking 30 modulo 10."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"167C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/167/problem/C"}