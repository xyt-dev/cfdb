{"assets":[],"contentKind":"statement","contestId":"1089","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Fractions"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a positive integer $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find a sequence of fractions $$$\\frac{a_i}{b_i}$$$, $$$i = 1 \\ldots k$$$ (where $$$a_i$$$ and $$$b_i$$$ are positive integers) for some $$$k$$$ such that:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$ \\begin{cases} \\text{$b_i$ divides $n$, $1 \\lt b_i \\lt n$ for $i = 1 \\ldots k$} \\\\ \\text{$1 \\le a_i \\lt b_i$ for $i = 1 \\ldots k$} \\\\ \\text{$\\sum\\limits_{i=1}^k \\frac{a_i}{b_i} = 1 - \\frac{1}{n}$} \\end{cases} $$$$$$"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of a single integer $$$n$$$ ($$$2 \\le n \\le 10^9$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if there exists such a sequence of fractions or \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there exists such a sequence, next lines should contain a description of the sequence in the following format."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line should contain integer $$$k$$$ ($$$1 \\le k \\le 100\\,000$$$) — the number of elements in the sequence. It is guaranteed that if such a sequence exists, then there exists a sequence of length at most $$$100\\,000$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$k$$$ lines should contain fractions of the sequence with two integers $$$a_i$$$ and $$$b_i$$$ on each line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n2\n1 2\n1 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second example there is a sequence $$$\\frac{1}{2}, \\frac{1}{3}$$$ such that $$$\\frac{1}{2} + \\frac{1}{3} = 1 - \\frac{1}{6}$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1089F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1089/problem/F"}