{"assets":[],"contentKind":"statement","contestId":"494","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Sharti"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"During the last 24 hours Hamed and Malek spent all their time playing \"Sharti\". Now they are too exhausted to finish the last round. So they asked you for help to determine the winner of this round. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"\"Sharti\" is played on a "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" board with some of cells colored white and others colored black. The rows of the board are numbered from top to bottom using number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Also the columns of the board are numbered from left to right using numbers "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The cell located at the intersection of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column is denoted by "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The players alternatively take turns. In each turn the player must choose a square with side-length at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" with its lower-right cell painted white. Then the colors of all the cells in this square are inversed (white cells become black and vice-versa). The player who cannot perform a move in his turn loses. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You know Hamed and Malek are very clever and they would have played their best moves at each turn. Knowing this and the fact that Hamed takes the first turn, given the initial board as described in the input, you must determine which one of them will be the winner."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In this problem the initial board is specified as a set of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" rectangles. All cells that lie inside at least one of these rectangles are colored white and the rest are colored black."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first line of input three space-spereated integers "},{"kind":"math_inline","text":"n, m, k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 5·104"},{"kind":"text","text":") follow, denoting size of the board, number of rectangles and maximum size of the turn square during the game, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines four space-seperated integers "},{"kind":"math_inline","text":"ai, bi, ci, di"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ ci ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ bi ≤ di ≤ n"},{"kind":"text","text":") are given meaning that "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th rectangle determining the initial board is a rectangle with upper-left cell at "},{"kind":"math_inline","text":"(ai, bi)"},{"kind":"text","text":" and lower-right cell at "},{"kind":"math_inline","text":"(ci, di)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If Hamed wins, print \"Hamed\", otherwise print \"Malek\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 1\n1 1 3 3\n2 2 4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Malek\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"12 5 7\n3 4 5 6\n1 2 1 2\n4 5 9 9\n8 6 12 10\n12 4 12 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Hamed\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"494E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/494/problem/E"}