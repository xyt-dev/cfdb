{"assets":["/statement-assets/8d894465b9ae2759bc5f13e1bb2f0f4bf3674e51c57ac70e63c95a20e25eb7b6.png","/statement-assets/55d96bad2e40a681330e8b764400351388ac7cb7ad15d8deb9ed0065b30ead6a.png","/statement-assets/73db3d0d6e092d4261bac70498bd6ba6ff542c3a1e4fb74ff0c4320606b11dba.png"],"contentKind":"statement","contestId":"1481","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. AB Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Kilani and Abd are neighbors for 3000 years, but then the day came and Kilani decided to move to another house. As a farewell gift, Kilani is going to challenge Abd with a problem written by their other neighbor with the same name Abd."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/8d894465b9ae2759bc5f13e1bb2f0f4bf3674e51c57ac70e63c95a20e25eb7b6.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The problem is:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a connected tree rooted at node $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You should assign a character "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":" to every node in the tree so that the total number of "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"'s is equal to $$$x$$$ and the total number of "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"'s is equal to $$$n - x$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define a string for each node $$$v$$$ of the tree as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if $$$v$$$ is root then the string is just one character assigned to $$$v$$$: "}],"kind":"list_item"},{"children":[{"kind":"text","text":" otherwise, let's take a string defined for the $$$v$$$'s parent $$$p_v$$$ and add to the end of it a character assigned to $$$v$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You should assign every node a character in a way that "},{"children":[{"kind":"text","text":"minimizes the number of distinct strings"}],"kind":"container"},{"kind":"text","text":" among the strings of all nodes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$x$$$ ($$$1 \\leq n \\leq 10^5$$$; $$$0 \\leq x \\leq n$$$) — the number of vertices in the tree the number of "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"'s."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n - 1$$$ integers $$$p_2, p_3, \\dots, p_{n}$$$ ($$$1 \\leq p_i \\leq n$$$; $$$p_i \\neq i$$$), where $$$p_i$$$ is the parent of node $$$i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the input describes a connected tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, print the minimum possible total number of distinct strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line, print $$$n$$$ characters, where all characters are either "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":" and the $$$i$$$-th character is the character assigned to the $$$i$$$-th node."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Make sure that the total number of "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"'s is equal to $$$x$$$ and the total number of "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"'s is equal to $$$n - x$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is more than one answer you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n9 3\n1 2 2 4 4 4 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\naabbbbbba\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The tree from the sample is shown below:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/55d96bad2e40a681330e8b764400351388ac7cb7ad15d8deb9ed0065b30ead6a.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The tree after assigning characters to every node (according to the output) is the following:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/73db3d0d6e092d4261bac70498bd6ba6ff542c3a1e4fb74ff0c4320606b11dba.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Strings for all nodes are the following: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" string of node $$$1$$$ is: "},{"children":[{"kind":"text","text":"a"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" string of node $$$2$$$ is: "},{"children":[{"kind":"text","text":"aa"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" string of node $$$3$$$ is: "},{"children":[{"kind":"text","text":"aab"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" string of node $$$4$$$ is: "},{"children":[{"kind":"text","text":"aab"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" string of node $$$5$$$ is: "},{"children":[{"kind":"text","text":"aabb"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" string of node $$$6$$$ is: "},{"children":[{"kind":"text","text":"aabb"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" string of node $$$7$$$ is: "},{"children":[{"kind":"text","text":"aabb"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" string of node $$$8$$$ is: "},{"children":[{"kind":"text","text":"aabb"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" string of node $$$9$$$ is: "},{"children":[{"kind":"text","text":"aa"}],"kind":"container"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The set of unique strings is $$$\\{\\text{a}, \\text{aa}, \\text{aab}, \\text{aabb}\\}$$$, so the number of distinct strings is $$$4$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1481F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1481/problem/F"}