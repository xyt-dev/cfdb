{"assets":["/statement-assets/a3d5b5b79f74f59cd2e21f80eb32c3e942ed9dae79c43489a7cf998daf8ea673.png"],"contentKind":"statement","contestId":"453","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Little Pony and Lord Tirek"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Lord Tirek is a centaur and the main antagonist in the season four finale episodes in the series \"My Little Pony: Friendship Is Magic\". In \"Twilight's Kingdom\" (Part 1), Tirek escapes from Tartarus and drains magic from ponies to grow stronger."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a3d5b5b79f74f59cd2e21f80eb32c3e942ed9dae79c43489a7cf998daf8ea673.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The core skill of Tirek is called Absorb Mana. It takes all mana from a magic creature and gives them to the caster."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now to simplify the problem, assume you have "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ponies (numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"). Each pony has three attributes:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"si"},{"kind":"text","text":" : amount of mana that the pony has at time 0; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"mi"},{"kind":"text","text":" : maximum mana that the pony can have; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ri"},{"kind":"text","text":" : mana regeneration per unit time. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Lord Tirek will do "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" instructions, each of them can be described with three integers: "},{"kind":"math_inline","text":"ti, li, ri"},{"kind":"text","text":". The instruction means that at time "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", Tirek will use Absorb Mana on ponies with numbers from "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" (both borders inclusive). We'll give you all the "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" instructions in order, count how much mana Tirek absorbs for each instruction."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of ponies. Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains three integers "},{"kind":"math_inline","text":"si, mi, ri"},{"kind":"math_inline","text":"(0 ≤ si ≤ mi ≤ 105; 0 ≤ ri ≤ 105)"},{"kind":"text","text":", describing a pony. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains an integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":") — the number of instructions. Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains three integers "},{"kind":"math_inline","text":"ti, li, ri"},{"kind":"math_inline","text":"(0 ≤ ti ≤ 109; 1 ≤ li ≤ ri ≤ n)"},{"kind":"text","text":", describing an instruction of Lord Tirek. The instructions are given in strictly increasing order of "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" (all "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" are distinct)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each instruction, output a single line which contains a single integer, the total mana absorbed in this instruction."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 10 1\n0 12 1\n0 20 1\n0 12 1\n0 10 1\n2\n5 1 5\n19 1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"25\n58\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Every pony starts with zero mana. For the first instruction, each pony has 5 mana, so you get 25 mana in total and each pony has 0 mana after the first instruction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second instruction, pony 3 has 14 mana and other ponies have mana equal to their "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"453E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/453/problem/E"}