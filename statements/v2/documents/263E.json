{"assets":["/statement-assets/cca38dce7478b635b19a2d3fa4ab088a0d8a848363a54833f534d9387921b506.png","/statement-assets/e03cd04283b0d87fa2755eb83446618b4a513e8b6d4b16c570356ecc17f97fb8.png"],"contentKind":"statement","contestId":"263","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Rhombus"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got a table of size "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":". On the intersection of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") and the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column ("},{"kind":"math_inline","text":"1 ≤ j ≤ m"},{"kind":"text","text":") there is a non-negative integer "},{"kind":"math_inline","text":"ai, j"},{"kind":"text","text":". Besides, you've got a non-negative integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find such pair of integers "},{"kind":"math_inline","text":"(a, b)"},{"kind":"text","text":" that meets these conditions: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"k ≤ a ≤ n - k + 1"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"k ≤ b ≤ m - k + 1"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":