{"assets":[],"contentKind":"statement","contestId":"609","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Frogs and mosquitoes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" frogs sitting on the coordinate axis "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":". For each frog two values "},{"kind":"math_inline","text":"xi, ti"},{"kind":"text","text":" are known — the position and the initial length of the tongue of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th frog (it is guaranteed that all positions "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" are different). "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" mosquitoes one by one are landing to the coordinate axis. For each mosquito two values are known "},{"kind":"math_inline","text":"pj"},{"kind":"text","text":" — the coordinate of the position where the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th mosquito lands and "},{"kind":"math_inline","text":"bj"},{"kind":"text","text":" — the size of the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th mosquito. Frogs and mosquitoes are represented as points on the coordinate axis."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The frog can eat mosquito if mosquito is in the same position with the frog or to the right, and the distance between them is not greater than the length of the tongue of the frog."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If at some moment several frogs can eat a mosquito the leftmost frog will eat it (with minimal "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":"). After eating a mosquito the length of the tongue of a frog increases with the value of the size of eaten mosquito. It's possible that after it the frog will be able to eat some other mosquitoes (the frog should eat them in this case)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each frog print two values — the number of eaten mosquitoes and the length of the tongue after landing all mosquitoes and after eating all possible mosquitoes by frogs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each mosquito is landing to the coordinate axis only after frogs eat all possible mosquitoes landed before. Mosquitoes are given in order of their landing to the coordinate axis."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains two integers "},{"kind":"math_inline","text":"n, m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 2·105"},{"kind":"text","text":") — the number of frogs and mosquitoes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"xi, ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ xi, ti ≤ 109"},{"kind":"text","text":") — the position and the initial length of the tongue of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th frog. It is guaranteed that all "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" are different."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain two integers each "},{"kind":"math_inline","text":"pj, bj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ pj, bj ≤ 109"},{"kind":"text","text":") — the position and the size of the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th mosquito."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line should contain two integer values "},{"kind":"math_inline","text":"ci, li"},{"kind":"text","text":" — the number of mosquitoes eaten by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th frog and the length of the tongue of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th frog."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 6\n10 2\n15 0\n6 1\n0 1\n110 10\n1 1\n6 0\n15 10\n14 100\n12 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 114\n1 10\n1 1\n1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n10 2\n20 2\n12 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"609F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/609/problem/F"}