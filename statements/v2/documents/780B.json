{"assets":["/statement-assets/af572790d886b5de9e6a69678560f5b9ffb802b8d91d49716b2f7199c5afce2c.png"],"contentKind":"statement","contestId":"780","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. The Meeting Place Cannot Be Changed"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The main road in Bytecity is a straight line from south to north. Conveniently, there are coordinates measured in meters from the southernmost building in north direction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At some points on the road there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" friends, and "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them is standing at the point "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" meters and can move with any speed no greater than "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" meters per second in any of the two directions along the road: south or north."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are to compute the minimum time needed to gather all the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" friends at some point on the road. Note that the point they meet at doesn't need to have integer coordinate. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 60 000"},{"kind":"text","text":") — the number of friends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ 109"},{"kind":"text","text":") — the current coordinates of the friends, in meters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"v1, v2, ..., vn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ vi ≤ 109"},{"kind":"text","text":") — the maximum speeds of the friends, in meters per second."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum time (in seconds) needed for all the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" friends to meet at some point on the road. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your answer will be considered correct, if its absolute or relative error isn't greater than "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":". Formally, let your answer be "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", while jury's answer be "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Your answer will be considered correct if "},{"attrs":{"alt":"","src":"/statement-assets/af572790d886b5de9e6a69678560f5b9ffb802b8d91d49716b2f7199c5afce2c.png"},"kind":"image"},{"kind":"text","text":" holds."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n7 1 3\n1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2.000000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n5 10 3 2\n2 3 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.400000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, all friends can gather at the point "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" within "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" seconds. In order to achieve this, the first friend should go south all the time at his maximum speed, while the second and the third friends should go north at their maximum speeds."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"780B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/780/problem/B"}