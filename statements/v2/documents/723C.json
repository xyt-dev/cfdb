{"assets":[],"contentKind":"statement","contestId":"723","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Polycarp at the Radio"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp is a music editor at the radio station. He received a playlist for tomorrow, that can be represented as a sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is a band, which performs the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th song. Polycarp likes bands with the numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", but he doesn't really like others. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We define as "},{"kind":"math_inline","text":"bj"},{"kind":"text","text":" the number of songs the group "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" is going to perform tomorrow. Polycarp wants to change the playlist in such a way that the minimum among the numbers "},{"kind":"math_inline","text":"b1, b2, ..., bm"},{"kind":"text","text":" will be as large as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find this maximum possible value of the minimum among the "},{"kind":"math_inline","text":"bj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j ≤ m"},{"kind":"text","text":"), and the minimum number of changes in the playlist Polycarp needs to make to achieve it. One change in the playlist is a replacement of the performer of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th song with any other group."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ n ≤ 2000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the performer of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th song."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print two integers: the maximum possible value of the minimum among the "},{"kind":"math_inline","text":"bj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j ≤ m"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"bj"},{"kind":"text","text":" is the number of songs in the changed playlist performed by the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th band, and the minimum number of changes in the playlist Polycarp needs to make."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print the changed playlist."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n1 2 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n1 2 1 2 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 3\n1 3 2 2 2 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n1 3 3 2 2 2 1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n1000000000 100 7 1000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 4\n1 2 3 4 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, after Polycarp's changes the first band performs two songs ("},{"kind":"math_inline","text":"b1 = 2"},{"kind":"text","text":"), and the second band also performs two songs ("},