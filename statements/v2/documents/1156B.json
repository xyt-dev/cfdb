{"assets":[],"contentKind":"statement","contestId":"1156","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Ugly Pairs"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string, consisting of lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A pair of "},{"children":[{"kind":"text","text":"neighbouring"}],"kind":"container"},{"kind":"text","text":" letters in a string is considered ugly if these letters are also "},{"children":[{"kind":"text","text":"neighbouring"}],"kind":"container"},{"kind":"text","text":" in a alphabet. For example, string \""},{"children":[{"kind":"text","text":"abaca"}],"kind":"container"},{"kind":"text","text":"\" contains ugly pairs at positions $$$(1, 2)$$$ — \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\" and $$$(2, 3)$$$ — \""},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":"\". Letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"' aren't considered neighbouring in a alphabet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Can you rearrange the letters of a given string so that there are no ugly pairs? You can choose any order of the letters of the given string but you can't add any new letters or remove the existing ones. You can also leave the order the same."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You also have to answer $$$T$$$ separate queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$T$$$ ($$$1 \\le T \\le 100$$$) — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$T$$$ lines contains string $$$s$$$ $$$(1 \\le |s| \\le 100)$$$ — the string for the next query. It is guaranteed that it contains only lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note that in hacks you have to set $$$T = 1$$$"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$T$$$ lines. The $$$i$$$-th line should contain the answer to the $$$i$$$-th query."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the answer for the $$$i$$$-th query exists, then print such a rearrangment of letters of the given string that it contains no ugly pairs. You can choose any order of the letters of the given string but you can't add any new letters or remove the existing ones. You can also leave the order the same."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print \""},{"children":[{"kind":"text","text":"No answer"}],"kind":"container"},{"kind":"text","text":"\" for that query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nabcd\ngg\ncodeforces\nabaca\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\ncadb\ngg\ncodfoerces\nNo answer\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example answer \""},{"children":[{"kind":"text","text":"bdac"}],"kind":"container"},{"kind":"text","text":"\" is also correct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second example showcases the fact that only neighbouring in alphabet letters are not allowed. The same letter is ok."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are lots of valid answers for the third example."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1156B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1156/problem/B"}