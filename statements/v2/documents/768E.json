{"assets":["/statement-assets/440f4a2dda39d71e6b30cedde23100cb76dbd1434d3d3f1bcf073fdd77e7cb7b.png","/statement-assets/58e5bb462a84fd5e7fd669b3ed585ddb6d03e9226a054ad31a31ae5beef67425.png"],"contentKind":"statement","contestId":"768","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Game of Stones"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sam has been teaching Jon the "},{"children":[{"kind":"text","text":"Game of Stones"}],"kind":"container"},{"kind":"text","text":" to sharpen his mind and help him devise a strategy to fight the white walkers. The rules of this game are quite simple: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The game starts with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" piles of stones indexed from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th pile contains "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" stones."}],"kind":"list_item"},{"children":[{"kind":"text","text":" The players make their moves alternatively. A move is considered as removal of some number of stones from a pile. Removal of "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" stones does not count as a move."}],"kind":"list_item"},{"children":[{"kind":"text","text":" The player who is unable to make a move loses."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Now Jon believes that he is ready for battle, but Sam does not think so. To prove his argument, Sam suggested that they play a modified version of the game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this modified version, no move can be made more than once on a pile. For example, if "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" stones are removed from a pile, "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" stones cannot be removed from that pile again."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sam sets up the game and makes the first move. Jon believes that Sam is just trying to prevent him from going to battle. Jon wants to know if he can win if both play optimally."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line consists of a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":") — the number of piles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains an integer "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ si ≤ 60"},{"kind":"text","text":") — the number of stones in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th pile."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single line containing \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if Jon wins, otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first case, Sam removes all the stones and Jon loses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In second case, the following moves are possible by Sam: "},{"attrs":{"alt":"","src":"/statement-assets/440f4a2dda39d71e6b30cedde23100cb76dbd1434d3d3f1bcf073fdd77e7cb7b.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In each of these cases, last move can be made by Jon to win the game as follows: "},{"attrs":{"alt":"","src":"/statement-assets/58e5bb462a84fd5e7fd669b3ed585ddb6d03e9226a054ad31a31ae5beef67425.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"768E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/768/problem/E"}