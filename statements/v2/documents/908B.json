{"assets":["/statement-assets/e5845001a9ba97d5d2e3c0d03972462f90b1e30eacba78184e12f892add43581.png"],"contentKind":"statement","contestId":"908","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. New Year and Buggy Bot"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bob programmed a robot to navigate through a 2d maze."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The maze has some obstacles. Empty cells are denoted by the character '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"', where obstacles are denoted by '"},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is a single robot in the maze. Its start position is denoted with the character '"},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":"'. This position has no obstacle in it. There is also a single exit in the maze. Its position is denoted with the character '"},{"children":[{"kind":"text","text":"E"}],"kind":"container"},{"kind":"text","text":"'. This position has no obstacle in it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The robot can only move up, left, right, or down."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When Bob programmed the robot, he wrote down a string of digits consisting of the digits 0 to 3, inclusive. He intended for each digit to correspond to a distinct direction, and the robot would follow the directions in order to reach the exit. Unfortunately, he forgot to actually assign the directions to digits."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The robot will choose some random mapping of digits to distinct directions. The robot will map distinct digits to distinct directions. The robot will then follow the instructions according to the given string in order and chosen mapping. If an instruction would lead the robot to go off the edge of the maze or hit an obstacle, the robot will crash and break down. If the robot reaches the exit at any point, then the robot will stop following any further instructions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Bob is having trouble debugging his robot, so he would like to determine the number of mappings of digits to directions that would lead the robot to the exit."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input will contain two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n, m ≤ 50"},{"kind":"text","text":"), denoting the dimensions of the maze."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines will contain exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters each, denoting the maze."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each character of the maze will be '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":"', or '"},{"children":[{"kind":"text","text":"E"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There will be exactly one '"},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":"' and exactly one '"},{"children":[{"kind":"text","text":"E"}],"kind":"container"},{"kind":"text","text":"' in the maze."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line will contain a single string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 100"},{"kind":"text","text":") — the instructions given to the robot. Each character of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a digit from 0 to 3."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer, the number of mappings of digits to directions that will lead the robot to the exit."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6\n.....#\nS....#\n.#....\n.#....\n...E..\n333300012\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 6\n......\n......\n..SE..\n......\n......\n......\n01232123212302123021\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n...\n.S.\n###\n.E.\n...\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample, the only valid mapping is "},{"attrs":{"alt":"","src":"/statement-assets/e5845001a9ba97d5d2e3c0d03972462f90b1e30eacba78184e12f892add43581.png"},"kind":"image"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"D"},{"kind":"text","text":" is down, "},{"kind":"math_inline","text":"L"},{"kind":"text","text":" is left, "},{"kind":"math_inline","text":"U"},{"kind":"text","text":" is up, "},{"kind":"math_inline","text":"R"},{"kind":"text","text":" is right."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"908B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/908/problem/B"}