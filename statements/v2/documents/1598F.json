{"assets":[],"contentKind":"statement","contestId":"1598","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. RBS"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A bracket sequence is a string containing only characters \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\". A regular bracket sequence (or, shortly, an RBS) is a bracket sequence that can be transformed into a correct arithmetic expression by inserting characters \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" between the original characters of the sequence. For example:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" bracket sequences \""},{"children":[{"kind":"text","text":"()()"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(())"}],"kind":"container"},{"kind":"text","text":"\" are regular (the resulting expressions are: \""},{"children":[{"kind":"text","text":"(1)+(1)"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"((1+1)+1)"}],"kind":"container"},{"kind":"text","text":"\"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" bracket sequences \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\" are not. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let's denote the concatenation of two strings $$$x$$$ and $$$y$$$ as $$$x+y$$$. For example, \""},{"children":[{"kind":"text","text":"()()"}],"kind":"container"},{"kind":"text","text":"\" $$$+$$$ \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\" $$$=$$$ \""},{"children":[{"kind":"text","text":"()())("}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given $$$n$$$ bracket sequences $$$s_1, s_2, \\dots, s_n$$$. You can rearrange them in any order (you can rearrange only the strings themselves, but not the characters in them)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to rearrange the strings in such a way that the string $$$s_1 + s_2 + \\dots + s_n$$$ has as many non-empty prefixes that are RBS as possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$1 \\le n \\le 20$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$n$$$ lines follow, the $$$i$$$-th of them contains $$$s_i$$$ — a bracket sequence (a string consisting of characters \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and/or \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\". All sequences $$$s_i$$$ are non-empty, their total length does not exceed $$$4 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section