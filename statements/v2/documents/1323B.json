{"assets":["/statement-assets/d54b0cfc6f2af1f6d2ecabbfb9edcd8d3dcd908b625d2ea537a5e6d58cc2dc68.png","/statement-assets/c306a770363d35d8a4533c43f730c54fb35fb843ef3f5ed23e8ce99423af1c2e.png","/statement-assets/4bf689c34c6a2d1ed2ef1e5756e0736f78e54204d4fd942a5ada5ce4a8345c7a.png"],"contentKind":"statement","contestId":"1323","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Count Subrectangles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array $$$a$$$ of length $$$n$$$ and array $$$b$$$ of length $$$m$$$ both consisting of only integers $$$0$$$ and $$$1$$$. Consider a matrix $$$c$$$ of size $$$n \\times m$$$ formed by following rule: $$$c_{i, j} = a_i \\cdot b_j$$$ (i.e. $$$a_i$$$ multiplied by $$$b_j$$$). It's easy to see that $$$c$$$ consists of only zeroes and ones too."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How many "},{"children":[{"kind":"text","text":"subrectangles"}],"kind":"container"},{"kind":"text","text":" of size (area) $$$k$$$ consisting only of ones are there in $$$c$$$?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"subrectangle"}],"kind":"container"},{"kind":"text","text":" is an intersection of a consecutive (subsequent) segment of rows and a consecutive (subsequent) segment of columns. I.e. consider four integers $$$x_1, x_2, y_1, y_2$$$ ($$$1 \\le x_1 \\le x_2 \\le n$$$, $$$1 \\le y_1 \\le y_2 \\le m$$$) a subrectangle $$$c[x_1 \\dots x_2][y_1 \\dots y_2]$$$ is an intersection of the rows $$$x_1, x_1+1, x_1+2, \\dots, x_2$$$ and the columns $$$y_1, y_1+1, y_1+2, \\dots, y_2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The size (area) of a subrectangle is the total number of cells in it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers $$$n$$$, $$$m$$$ and $$$k$$$ ($$$1 \\leq n, m \\leq 40\\,000, 1 \\leq k \\leq n \\cdot m$$$), length of array $$$a$$$, length of array $$$b$$$ and required size of subrectangles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$0 \\leq a_i \\leq 1$$$), elements of $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains $$$m$$$ integers $$$b_1, b_2, \\ldots, b_m$$$ ($$$0 \\leq b_i \\leq 1$$$), elements of $$$b$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output single integer — the number of subrectangles of $$$c$$$ with size (area) $$$k$$$ consisting only of ones."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 3 2\n1 0 1\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 5 4\n1 1 1\n1 1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n14\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In first example matrix $$$c$$$ is:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d54b0cfc6f2af1f6d2ecabbfb9edcd8d3dcd908b625d2ea537a5e6d58cc2dc68.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"There are $$$4$$$ subrectangles of size $$$2$$$ consisting of only ones in it:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c306a770363d35d8a4533c43f730c54fb35fb843ef3f5ed23e8ce99423af1c2e.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In second example matrix $$$c$$$ is:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/4bf689c34c6a2d1ed2ef1e5756e0736f78e54204d4fd942a5ada5ce4a8345c7a.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1323B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1323/problem/B"}