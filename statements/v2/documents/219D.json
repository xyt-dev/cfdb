{"assets":[],"contentKind":"statement","contestId":"219","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Choosing Capital for Treeland"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The country Treeland consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities, some pairs of them are connected with "},{"children":[{"kind":"text","text":"unidirectional"}],"kind":"container"},{"kind":"text","text":" roads. Overall there are "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" roads in the country. We know that if we don't take the direction of the roads into consideration, we can get from any city to any other one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The council of the elders has recently decided to choose the capital of Treeland. Of course it should be a city of this country. The council is supposed to meet in the capital and regularly move from the capital to other cities (at this stage nobody is thinking about getting back to the capital from these cities). For that reason if city "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is chosen a capital, then all roads must be oriented so that if we move along them, we can get from city "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to any other city. For that some roads may have to be inversed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the elders to choose the capital so that they have to inverse the minimum number of roads in the country."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2·105"},{"kind":"text","text":") — the number of cities in Treeland. Next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain the descriptions of the roads, one road per line. A road is described by a pair of integers "},{"kind":"math_inline","text":"si, ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ si, ti ≤ n; si ≠ ti"},{"kind":"text","text":") — the numbers of cities, connected by that road. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road is oriented from city "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":". You can consider cities in Treeland indexed from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the minimum number of roads to be inversed if the capital is chosen optimally. In the second line print all possible ways to choose the capital — a sequence of indexes of cities in the increasing order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 1\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n2 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 4\n2 4\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2 3 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"219D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/219/problem/D"}