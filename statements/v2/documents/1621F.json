{"assets":[],"contentKind":"statement","contestId":"1621","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Strange Instructions"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dasha has $$$10^{100}$$$ coins. Recently, she found a binary string $$$s$$$ of length $$$n$$$ and some operations that allows to change this string (she can do each operation any number of times):"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Replace substring "},{"children":[{"kind":"text","text":"00"}],"kind":"container"},{"kind":"text","text":" of $$$s$$$ by "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and receive $$$a$$$ coins. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Replace substring "},{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":" of $$$s$$$ by "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" and receive $$$b$$$ coins. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Remove "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" from any position in $$$s$$$ and "},{"children":[{"kind":"text","text":"pay"}],"kind":"container"},{"kind":"text","text":" $$$c$$$ coins. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It turned out that while doing this operations Dasha should follow the rule:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" It is forbidden to do two operations with the same parity in a row. Operations are numbered by integers $$$1$$$-$$$3$$$ in the order they are given above. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Please, calculate what is the maximum profit Dasha can get by doing these operations and following this rule."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains four integers $$$n$$$, $$$a$$$, $$$b$$$, $$$c$$$ ($$$1 \\leq n \\leq 10^5, 1 \\leq a, b, c \\leq 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a binary string $$$s$$$ of length $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the total sum of $$$n$$$ over all test cases doesn't exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print the answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n5 2 2 1\n01101\n6 4 3 5\n110001\n6 3 2 1\n011110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n11\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case one of the optimal sequences of operations is "},{"children":[{"kind":"text","text":"0"},{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"01"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"0"},{"children":[{"kind":"text","text":"11"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":". This sequence of operations consists of operations $$$2$$$, $$$3$$$ and $$$2$$$ in this order. It satisfies all rules and gives profit $$$3$$$. It can be shown that it is impossible to achieve higher profit in this test case, so the answer is $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case one of the optimal sequences of operations is "},{"children":[{"kind":"text","text":"110"},{"children":[{"kind":"text","text":"00"}],"kind":"container"},{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":"001"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"1"},{"children":[{"kind":"text","text":"00"}],"kind":"container"},{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"101"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case one of the optimal sequences of operations is "},{"children":[{"kind":"text","text":"01"},{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"1110"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"11"},{"children":[{"kind":"text","text":"0"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"children":[{"kind":"text","text":"11"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1621F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1621/problem/F"}