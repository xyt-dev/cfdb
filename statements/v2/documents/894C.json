{"assets":[],"contentKind":"statement","contestId":"894","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Marco and GCD Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In a dream Marco met an elderly man with a pair of black glasses. The man told him the key to immortality and then disappeared with the wind of time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When he woke up, he only remembered that the key was a sequence of positive integers of some length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", but forgot the exact sequence. Let the elements of the sequence be "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". He remembered that he calculated "},{"kind":"math_inline","text":"gcd(ai, ai + 1, ..., aj)"},{"kind":"text","text":" for every "},{"kind":"math_inline","text":"1 ≤ i ≤ j ≤ n"},{"kind":"text","text":" and put it into a set "},{"kind":"math_inline","text":"S"},{"kind":"text","text":". "},{"kind":"math_inline","text":"gcd"},{"kind":"text","text":" here means the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Greatest_common_divisor"},"children":[{"kind":"text","text":"greatest common divisor"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that even if a number is put into the set "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" twice or more, it only appears once in the set."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Marco gives you the set "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" and asks you to help him figure out the initial sequence. If there are many solutions, print any of them. It is also possible that there are no sequences that produce the set "},{"kind":"math_inline","text":"S"},{"kind":"text","text":", in this case print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 1000"},{"kind":"text","text":") — the size of the set "},{"kind":"math_inline","text":"S"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"s1, s2, ..., sm"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ si ≤ 106"},{"kind":"text","text":") — the elements of the set "},{"kind":"math_inline","text":"S"},{"kind":"text","text":". It's guaranteed that the elements of the set are given in strictly increasing order, that means "},{"kind":"math_inline","text":"s1 < s2 < ... < sm"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no solution, print a single line containing "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, in the first line print a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" denoting the length of the sequence, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" should not exceed "},{"kind":"math_inline","text":"4000"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 106"},{"kind":"text","text":") — the sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can show that if a solution exists, then there is a solution with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" not exceeding "},{"kind":"math_inline","text":"4000"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" not exceeding "},{"kind":"math_inline","text":"106"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 4 6 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n4 6 12"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example "},{"kind":"math_inline","text":"2 = gcd(4, 6)"},{"kind":"text","text":", the other elements from the set appear in the sequence, and we can show that there are no values different from "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"12"},{"kind":"text","text":" among "},{"kind":"math_inline","text":"gcd(ai, ai + 1, ..., aj)"},{"kind":"text","text":" for every "},{"kind":"math_inline","text":"1 ≤ i ≤ j ≤ n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"894C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/894/problem/C"}