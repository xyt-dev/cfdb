{"assets":[],"contentKind":"statement","contestId":"1060","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Phone Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's call a string "},{"children":[{"kind":"text","text":"a phone number"}],"kind":"container"},{"kind":"text","text":" if it has length 11 and fits the pattern \""},{"children":[{"kind":"text","text":"8xxxxxxxxxx"}],"kind":"container"},{"kind":"text","text":"\", where each \""},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":"\" is replaced by a digit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, \""},{"children":[{"kind":"text","text":"80123456789"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"80000000000"}],"kind":"container"},{"kind":"text","text":"\" are phone numbers, while \""},{"children":[{"kind":"text","text":"8012345678"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"79000000000"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have $$$n$$$ cards with digits, and you want to use them to make as many phone numbers as possible. Each card must be used in at most one phone number, and you don't have to use all cards. The phone numbers do not necessarily have to be distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$n$$$ — the number of cards with digits that you have ($$$1 \\leq n \\leq 100$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string of $$$n$$$ digits (characters \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\", ..., \""},{"children":[{"kind":"text","text":"9"}],"kind":"container"},{"kind":"text","text":"\") $$$s_1, s_2, \\ldots, s_n$$$. The string will not contain any other characters, such as leading or trailing spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If at least one phone number can be made from these cards, output the maximum number of phone numbers that can be made. Otherwise, output 0."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11\n00000000008\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"22\n0011223344556677889988\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11\n31415926535\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, one phone number, \""},{"children":[{"kind":"text","text":"8000000000"}],"kind":"container"},{"kind":"text","text":"\", can be made from these cards."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, you can make two phone numbers from the cards, for example, \""},{"children":[{"kind":"text","text":"80123456789"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"80123456789"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example you can't make any phone number from the given cards."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1060A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1060/problem/A"}