{"assets":[],"contentKind":"statement","contestId":"627","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Preorder Test"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"7 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"For his computer science class, Jacob builds a model tree with sticks and balls containing "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes in the shape of a tree. Jacob has spent "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" minutes building the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ball in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Jacob's teacher will evaluate his model and grade Jacob based on the effort he has put in. However, she does not have enough time to search his whole tree to determine this; Jacob knows that she will examine the first "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" nodes in a DFS-order traversal of the tree. She will then assign Jacob a grade equal to the minimum "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" she finds among those "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" nodes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Though Jacob does not have enough time to rebuild his model, he can choose the root node that his teacher starts from. Furthermore, he can rearrange the list of neighbors of "},{"children":[{"kind":"text","text":"each node"}],"kind":"container"},{"kind":"text","text":" in any order he likes. Help Jacob find the best grade he can get on this assignment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A DFS-order traversal is an ordering of the nodes of a rooted tree, built by a recursive DFS-procedure initially called on the root of the tree. When called on a given node "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", the procedure does the following: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Print "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Traverse the list of neighbors of the node "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" in order and iteratively call DFS-procedure on each one. Do not call DFS-procedure on node "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" if you came to node "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" directly from "},{"kind":"math_inline","text":"u"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two positive integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 200 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":") — the number of balls in Jacob's tree and the number of balls the teacher will inspect."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 1 000 000"},{"kind":"text","text":"), the time Jacob used to build the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ball."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ui ≠ vi"},{"kind":"text","text":") representing a connection in Jacob's tree between balls "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maximum grade Jacob can get by picking the right root of the tree and rearranging the list of neighbors."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n3 6 1 4 2\n1 2\n2 4\n2 5\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n1 5 5 5\n1 2\n1 3\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Jacob can root the tree at node "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and order "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"'s neighbors in the order "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" (all other nodes have at most two neighbors). The resulting preorder traversal is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", and the minimum "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" of the first "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" nodes is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, it is clear that any preorder traversal will contain node "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" as either its first or second node, so Jacob cannot do better than a grade of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"627D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/627/problem/D"}