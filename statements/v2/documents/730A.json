{"assets":[],"contentKind":"statement","contestId":"730","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Toda 2"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A group of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" friends enjoys playing popular video game Toda 2. There is a rating system describing skill level of each player, initially the rating of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th friend is "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The friends decided to take part in the championship as a team. But they should have equal ratings to be allowed to compose a single team consisting of all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" friends. So the friends are faced with the problem: how to make all their ratings equal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One way to change ratings is to willingly lose in some matches. Friends can form a party consisting of "},{"children":[{"kind":"text","text":"two"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"five"}],"kind":"container"},{"kind":"text","text":" (but not more than "},{"kind":"math_inline","text":"n"},{"kind":"text","text":") friends and play a match in the game. When the party loses, the rating of each of its members decreases by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". A rating can't become negative, so "},{"kind":"math_inline","text":"ri = 0"},{"kind":"text","text":" doesn't change after losing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The friends can take part in multiple matches, each time making a party from any subset of friends (but remember about constraints on party size: from "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" members)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The friends want to make their ratings equal but as high as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the friends develop a strategy of losing the matches so that all their ratings become equal and the resulting rating is maximum possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100"},{"kind":"text","text":") — the number of friends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" non-negative integers "},{"kind":"math_inline","text":"r1, r2, ..., rn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ri ≤ 100"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" is the initial rating of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th friend."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, print a single integer "},{"kind":"math_inline","text":"R"},{"kind":"text","text":" — the final rating of each of the friends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line, print integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — the number of matches the friends have to play. Each of the following "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines should contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"', where the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th character of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line is equal to:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"', if friend "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" should not play in match "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"', if friend "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" should play in match "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Each line should contain between two and five characters '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"', inclusive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The value "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" should not exceed "},{"kind":"math_inline","text":"104"},{"kind":"text","text":", it is guaranteed that such solution exists. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Remember that you shouldn't minimize the value "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", but you should maximize "},{"kind":"math_inline","text":"R"},{"kind":"text","text":". If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n4 5 1 7 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n8\n01010\n00011\n01010\n10010\n00011\n11000\n00011\n11000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n2\n11\n11\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"730A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/730/problem/A"}