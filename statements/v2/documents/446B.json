{"assets":[],"contentKind":"statement","contestId":"446","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. DZY Loves Modification"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As we know, DZY loves playing games. One day DZY decided to play with a "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" matrix. To be more precise, he decided to modify the matrix with exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each modification is one of the following:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Pick some row of the matrix and decrease each element of the row by "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". This operation brings to DZY the value of pleasure equal to the sum of elements of the row before the decreasing. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Pick some column of the matrix and decrease each element of the column by "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". This operation brings to DZY the value of pleasure equal to the sum of elements of the column before the decreasing. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"DZY wants to know: what is the largest total value of pleasure he could get after performing exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" modifications? Please, help him to calculate this value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four space-separated integers "},{"kind":"math_inline","text":"n, m, k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 103; 1 ≤ k ≤ 106; 1 ≤ p ≤ 100)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow. Each of them contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers representing "},{"kind":"math_inline","text":"aij (1 ≤ aij ≤ 103)"},{"kind":"text","text":" — the elements of the current row of the matrix."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the maximum possible total pleasure value DZY could get."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 2 2\n1 3\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 5 2\n1 3\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample test, we can modify: column 2, row 2. After that the matrix becomes:"}],"kind":"paragraph"},{"kind":"code_block","text":"\n1 1\n0 0\n\n"},{"children":[{"kind":"text","text":"For the second sample test, we can modify: column 2, row 2, row 1, column 1, column 2. After that the matrix becomes:"}],"kind":"paragraph"},{"kind":"code_block","text":"\n-3 -3\n-2 -2\n\n"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"446B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/446/problem/B"}