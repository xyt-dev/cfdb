{"assets":[],"contentKind":"statement","contestId":"429","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Points and Segments"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Iahub isn't well prepared on geometry problems, but he heard that this year there will be a lot of geometry problems on the IOI selection camp. Scared, Iahub locked himself in the basement and started thinking of new problems of this kind. One of them is the following."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Iahub wants to draw "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct segments "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":" on the "},{"kind":"math_inline","text":"OX"},{"kind":"text","text":" axis. He can draw each segment with either red or blue. The drawing is good if and only if the following requirement is met: for each point "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" of the "},{"kind":"math_inline","text":"OX"},{"kind":"text","text":" axis consider all the segments that contains point "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"; suppose, that "},{"kind":"math_inline","text":"rx"},{"kind":"text","text":" red segments and "},{"kind":"math_inline","text":"bx"},{"kind":"text","text":" blue segments contain point "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"; for each point "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" inequality "},{"kind":"math_inline","text":"|rx - bx| ≤ 1"},{"kind":"text","text":" must be satisfied."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A segment "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":" contains a point "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" if and only if "},{"kind":"math_inline","text":"l ≤ x ≤ r"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Iahub gives you the starting and ending points of all the segments. You have to find any good drawing for him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of segments. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ li ≤ ri ≤ 109"},{"kind":"text","text":") — the borders of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that all the segments are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no good drawing for a given test, output a single integer -1. Otherwise output "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers; each integer must be 0 or 1. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number denotes the color of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th segment (0 is red and 1 is blue)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple good drawings you can output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n0 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 5\n1 3\n3 5\n2 10\n11 11\n12 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 1 0 1 0 0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"429E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/429/problem/E"}