{"assets":[],"contentKind":"statement","contestId":"325","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Square and Rectangles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rectangles. The corners of rectangles have integer coordinates and their edges are parallel to the "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Oy"},{"kind":"text","text":" axes. The rectangles may touch each other, but they do not overlap (that is, there are no points that belong to the interior of more than one rectangle). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine if the rectangles form a square. In other words, determine if the set of points inside or on the border of at least one rectangle is precisely equal to the set of points inside or on the border of some square."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5"},{"kind":"text","text":"). Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain four integers each, describing a single rectangle: "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ x1 < x2 ≤ 31400, 0 ≤ y1 < y2 ≤ 31400"},{"kind":"text","text":") — "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":" are "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-coordinates of the left and right edges of the rectangle, and "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":" are "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"-coordinates of the bottom and top edges of the rectangle. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"No two rectangles overlap (that is, there are no points that belong to the interior of more than one rectangle)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\", if the given rectangles form a square, or \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 0 2 3\n0 3 3 5\n2 0 5 2\n3 2 5 5\n2 2 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 0 2 3\n0 3 3 5\n2 0 5 2\n3 2 5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"325A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/325/problem/A"}