{"assets":[],"contentKind":"statement","contestId":"2276","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Replace and Compress"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ of length $$$n$$$ consisting of the characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". You need to perform exactly one operation consisting of two steps:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" choose "},{"children":[{"kind":"text","text":"at most one"}],"kind":"container"},{"kind":"text","text":" character with index from $$$2$$$ to $$$n-1$$$ inclusive and replace it with the opposite one: "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":". You may choose not to change any character. "},{"children":[{"kind":"text","text":"The first and the last characters of the string cannot be changed"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" replace each maximal block of consecutive equal characters with one such character. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A block is called maximal if it cannot be extended to the left or to the right by adding the same character. For example, after the second step, the string "},{"children":[{"kind":"text","text":"100111011"}],"kind":"container"},{"kind":"text","text":" will become "},{"children":[{"kind":"text","text":"10101"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Count the number of different strings that can be obtained after performing this operation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of one line containing a string $$$s$$$ ($$$3 \\le |s| \\le 3 \\cdot 10^5$$$) consisting only of the characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraints on the input:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the sum of the lengths of strings $$$s$$$ over all test cases does not exceed $$$3 \\cdot 10^5$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer — the number of different strings that can be obtained after performing the operation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n001\n000\n010\n00010\n100111011\n001011010\n1111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n2\n3\n3\n2\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, you may choose not to change any character or replace the second character. Before compression, the resulting strings are "},{"children":[{"kind":"text","text":"001"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"011"}],"kind":"container"},{"kind":"text","text":", respectively. After compression, both strings become "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":", so the answer is $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth test case:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if no character is changed, after compression we get "},{"children":[{"kind":"text","text":"10101"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if the second character is replaced, we get "},{"children":[{"kind":"text","text":"110111011"}],"kind":"container"},{"kind":"text","text":", and after compression — "},{"children":[{"kind":"text","text":"10101"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if the fifth character is replaced, we get "},{"children":[{"kind":"text","text":"100101011"}],"kind":"container"},{"kind":"text","text":", and after compression — "},{"children":[{"kind":"text","text":"1010101"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if the seventh character is replaced, we get "},{"children":[{"kind":"text","text":"100111111"}],"kind":"container"},{"kind":"text","text":", and after compression — "},{"children":[{"kind":"text","text":"101"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In total, three different strings can be obtained: "},{"children":[{"kind":"text","text":"101"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"10101"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"1010101"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"2276B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2276/problem/B"}