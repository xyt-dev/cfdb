{"assets":["/statement-assets/690f3793de76d97567cd325631df59689898648bc6d5478d4bed276184e2dffb.png","/statement-assets/5cd6bb1957cba42ee26b72acc09fc7d01cdf6ce7ec0eae7971655df454061a54.png","/statement-assets/d13a95f411018938903a4dac7edcaf849a546ba76178ca871116997645d67248.png"],"contentKind":"statement","contestId":"283","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Cow Program"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Farmer John has just given the cows a program to play with! The program contains two integer variables, "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", and performs the following operations on a sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" of positive integers:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Initially, "},{"kind":"math_inline","text":"x = 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y = 0"},{"kind":"text","text":". If, after any step, "},{"kind":"math_inline","text":"x ≤ 0"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"x > n"},{"kind":"text","text":", the program immediately terminates. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The program increases both "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" by a value equal to "},{"kind":"math_inline","text":"ax"},{"kind":"text","text":" simultaneously. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The program now increases "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"ax"},{"kind":"text","text":" while decreasing "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"ax"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The program executes steps 2 and 3 (first step 2, then step 3) repeatedly until it terminates (it may never terminate). So, the sequence of executed steps may start with: step 2, step 3, step 2, step 3, step 2 and so on. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The cows are not very good at arithmetic though, and they want to see how the program works. Please help them!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the sequence "},{"kind":"math_inline","text":"a2, a3, ..., an"},{"kind":"text","text":". Suppose for each "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ n - 1)"},{"kind":"text","text":" we run the program on the sequence "},{"kind":"math_inline","text":"i, a2, a3, ..., an"},{"kind":"text","text":". For each such run output the final value of "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" if the program terminates or "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if it does not terminate."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2·105"},{"kind":"text","text":"). The next line contains "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" space separated integers, "},{"kind":"math_inline","text":"a2, a3, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines. On the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line, print the requested value when the program is run on the sequence "},{"kind":"math_inline","text":"i, a2, a3, ...an"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n6\n8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" For "},{"kind":"math_inline","text":"i = 1, "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" becomes "},{"attrs":{"alt":"","src":"/statement-assets/690f3793de76d97567cd325631df59689898648bc6d5478d4bed276184e2dffb.png"},"kind":"image"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" becomes "},{"kind":"math_inline","text":"1 + 2 = 3"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For "},{"kind":"math_inline","text":"i = 2, "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" becomes "},{"attrs":{"alt":"","src":"/statement-assets/5cd6bb1957cba42ee26b72acc09fc7d01cdf6ce7ec0eae7971655df454061a54.png"},"kind":"image"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" becomes "},{"kind":"math_inline","text":"2 + 4 = 6."}],"kind":"list_item"},{"children":[{"kind":"text","text":" For "},{"kind":"math_inline","text":"i = 3, "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" becomes "},{"attrs":{"alt":"","src":"/statement-assets/d13a95f411018938903a4dac7edcaf849a546ba76178ca871116997645d67248.png"},"kind":"image"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" becomes "},{"kind":"math_inline","text":"3 + 1 + 4 = 8."}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"283B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/283/problem/B"}