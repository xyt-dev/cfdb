{"assets":[],"contentKind":"statement","contestId":"1105","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Zuhair and Strings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Given a string $$$s$$$ of length $$$n$$$ and integer $$$k$$$ ($$$1 \\le k \\le n$$$). The string $$$s$$$ has a level $$$x$$$, if $$$x$$$ is largest non-negative integer, such that it's possible to find in $$$s$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$x$$$ "},{"children":[{"kind":"text","text":"non-intersecting"}],"kind":"container"},{"kind":"text","text":" (non-overlapping) substrings of length $$$k$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" all characters of these $$$x$$$ substrings are the same (i.e. each substring contains only one distinct character and this character is the same for all the substrings). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A substring is a sequence of consecutive (adjacent) characters, it is defined by two integers $$$i$$$ and $$$j$$$ ($$$1 \\le i \\le j \\le n$$$), denoted as $$$s[i \\dots j]$$$ = \"$$$s_{i}s_{i+1} \\dots s_{j}$$$\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if $$$k = 2$$$, then:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the string \""},{"children":[{"kind":"text","text":"aabb"}],"kind":"container"},{"kind":"text","text":"\" has level $$$1$$$ (you can select substring \""},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"\"), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the strings \""},{"children":[{"kind":"text","text":"zzzz"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"zzbzz"}],"kind":"container"},{"kind":"text","text":"\" has level $$$2$$$ (you can select two non-intersecting substrings \""},{"children":[{"kind":"text","text":"zz"}],"kind":"container"},{"kind":"text","text":"\" in each of them), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the strings \""},{"children":[{"kind":"text","text":"abed"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"aca"}],"kind":"container"},{"kind":"text","text":"\" have level $$$0$$$ (you can't find at least one substring of the length $$$k=2$$$ containing the only distinct character). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Zuhair gave you the integer $$$k$$$ and the string $$$s$$$ of length $$$n$$$. You need to find $$$x$$$, the level of the string $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\le k \\le n \\le 2 \\cdot 10^5$$$) — the length of the string and the value of $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string $$$s$$$ of length $$$n$$$ consisting only of lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer $$$x$$$ — the level of the string."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8 2\naaacaabb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 1\nab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 2\nabab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, we can select $$$2$$$ non-intersecting substrings consisting of letter '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"': \""},{"children":[{"kind":"text","text":"(aa)ac(aa)bb"}],"kind":"container"},{"kind":"text","text":"\", so the level is $$$2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, we can select either substring \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\" to get the answer $$$1$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1105B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1105/problem/B"}