{"assets":[],"contentKind":"statement","contestId":"609","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. The Best Gift"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Emily's birthday is next week and Jack has decided to buy a present for her. He knows she loves books so he goes to the local bookshop, where there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" books on sale from one of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" genres."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the bookshop, Jack decides to buy "},{"children":[{"kind":"text","text":"two books of different genres"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Based on the genre of books on sale in the shop, find the number of options available to Jack for choosing two books of different genres for Emily. Options are considered different if they differ in at least one book."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The books are given by indices of their genres. The genres are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2·105, 2 ≤ m ≤ 10"},{"kind":"text","text":") — the number of books in the bookstore and the number of genres."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ m"},{"kind":"text","text":") equals the genre of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th book."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that for each genre there is at least one book of that genre."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer — the number of ways in which Jack can choose books."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the answer doesn't exceed the value "},{"kind":"math_inline","text":"2·109"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n2 1 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 4\n4 2 3 1 2 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"18\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The answer to the first test sample equals 5 as Sasha can choose:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" the first and second books, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the first and third books, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the first and fourth books, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the second and third books, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the third and fourth books. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"609B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/609/problem/B"}