{"assets":[],"contentKind":"statement","contestId":"1759","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Yes-Yes?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You talked to Polycarp and asked him a question. You know that when he wants to answer \"yes\", he repeats "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" many times in a row."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Because of the noise, you only heard part of the answer — some substring of it. That is, if he answered "},{"children":[{"kind":"text","text":"YesYes"}],"kind":"container"},{"kind":"text","text":", then you could hear "},{"children":[{"kind":"text","text":"esY"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"YesYes"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"sYes"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":", but you couldn't "},{"children":[{"kind":"text","text":"Yess"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"se"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine if it is true that the given string $$$s$$$ is a substring of "},{"children":[{"kind":"text","text":"YesYesYes..."}],"kind":"container"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" repeated many times in a row)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input data contains the singular $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases in the test."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case is described by a single string of Latin letters $$$s$$$ ($$$1 \\le |s| \\le 50$$$) — the part of Polycarp's answer that you heard, where $$$|s|$$$ — is the length of the string $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output $$$t$$$ lines, each of which is the answer to the corresponding test case. As an answer, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if the specified string $$$s$$$ is a substring of the string "},{"children":[{"kind":"text","text":"YesYesYes...Yes"}],"kind":"container"},{"kind":"text","text":" (the number of words "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" is arbitrary), and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output the answer in any case (for example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","te