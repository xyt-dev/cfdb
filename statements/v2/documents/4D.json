{"assets":[],"contentKind":"statement","contestId":"4","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Mysterious Present"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Peter decided to wish happy birthday to his friend from Australia and send him a card. To make his present more mysterious, he decided to make a "},{"children":[{"kind":"text","text":"chain"}],"kind":"container"},{"kind":"text","text":". Chain here is such a sequence of envelopes "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" = {"},{"kind":"math_inline","text":"a1,  a2,  ...,  an"},{"kind":"text","text":"}, where the width and the height of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th envelope is strictly higher than the width and the height of the "},{"kind":"math_inline","text":"(i  -  1)"},{"kind":"text","text":"-th envelope respectively. Chain size is the number of envelopes in the chain. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Peter wants to make the chain of the maximum size from the envelopes he has, the chain should be such, that he'll be able to put a card into it. The card fits into the chain if its width and height is lower than the width and the height of the smallest envelope in the chain respectively. It's forbidden to turn the card and the envelopes. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Peter has very many envelopes and very little time, this hard task is entrusted to you."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"w"},{"kind":"text","text":", "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤ n ≤ 5000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ w,  h  ≤ 106"},{"kind":"text","text":") — amount of envelopes Peter has, the card width and height respectively. Then there follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each of them contains two integer numbers "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" — width and height of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th envelope ("},{"kind":"math_inline","text":"1 ≤ wi,  hi ≤ 106"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the maximum chain size. In the second line print the numbers of the envelopes (separated by space), forming the required chain, starting with the number of the smallest envelope. Remember, please, that the card should fit into the smallest envelope. If the chain of maximum size is not unique, print any of the answers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the card does not fit into any of the envelopes, print number "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" in the single line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 1\n2 2\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 3\n5 4\n12 11\n9 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 3 2 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"4D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/4/problem/D"}