{"assets":[],"contentKind":"statement","contestId":"285","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Find Marble"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya and Vasya are playing a game. Petya's got "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" non-transparent glasses, standing in a row. The glasses' positions are indexed with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right. Note that the positions are indexed but the glasses are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First Petya puts a marble under the glass in position "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Then he performs some (possibly zero) shuffling operations. One shuffling operation means moving the glass from the first position to position "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":", the glass from the second position to position "},{"kind":"math_inline","text":"p2"},{"kind":"text","text":" and so on. That is, a glass goes from position "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to position "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":". Consider all glasses are moving simultaneously during one shuffling operation. When the glasses are shuffled, the marble doesn't travel from one glass to another: it moves together with the glass it was initially been put in."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After all shuffling operations Petya shows Vasya that the ball has moved to position "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Vasya's task is to say what minimum number of shuffling operations Petya has performed or determine that Petya has made a mistake and the marble could not have got from position "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to position "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers: "},{"kind":"math_inline","text":"n, s, t (1 ≤ n ≤ 105; 1 ≤ s, t ≤ n)"},{"kind":"text","text":" — the number of glasses, the ball's initial and final position. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers: "},{"kind":"math_inline","text":"p1, p2, ..., pn (1 ≤ pi ≤ n)"},{"kind":"text","text":" — the shuffling operation parameters. It is guaranteed that all "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":"'s are distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" can equal "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the marble can move from position "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to position "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", then print on a single line a non-negative integer — the minimum number of shuffling operations, needed to get the marble to position "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". If it is impossible, print number -1."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 1\n2 3 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 3\n4 1 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 4\n1 2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 3\n2 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"285B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/285/problem/B"}