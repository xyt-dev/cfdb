kind":"text","text":"\" + \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":"\" = \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\" + \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the first string can be splitted into strings \""},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"bb"}],"kind":"container"},{"kind":"text","text":"\", that are equivalent only to themselves. That's why string \""},{"children":[{"kind":"text","text":"aabb"}],"kind":"container"},{"kind":"text","text":"\" is equivalent only to itself and to string \""},{"children":[{"kind":"text","text":"bbaa"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"559B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/559/problem/B"}