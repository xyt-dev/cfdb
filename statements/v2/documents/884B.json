{"assets":[],"contentKind":"statement","contestId":"884","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Japanese Crosswords Strike Back"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A one-dimensional Japanese crossword can be represented as a binary string of length "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". An encoding of this crossword is an array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the number of segments formed completely of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"'s, and "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the length of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th segment. No two segments touch or intersect."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"x = 6"},{"kind":"text","text":" and the crossword is "},{"kind":"math_inline","text":"111011"},{"kind":"text","text":", then its encoding is an array "},{"kind":"math_inline","text":"{3, 2}"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"x = 8"},{"kind":"text","text":" and the crossword is "},{"kind":"math_inl