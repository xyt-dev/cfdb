{"assets":[],"contentKind":"statement","contestId":"357","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Group of Students"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"At the beginning of the school year Berland State University starts two city school programming groups, for beginners and for intermediate coders. The children were tested in order to sort them into groups. According to the results, each student got some score from 1 to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" points. We know that "},{"kind":"math_inline","text":"c1"},{"kind":"text","text":" schoolchildren got 1 point, "},{"kind":"math_inline","text":"c2"},{"kind":"text","text":" children got 2 points, ..., "},{"kind":"math_inline","text":"cm"},{"kind":"text","text":" children got "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" points. Now you need to set the passing rate "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" (integer from 1 to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"): all schoolchildren who got less than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" points go to the beginner group and those who get at strictly least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" points go to the intermediate group. We know that if the size of a group is more than "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", then the university won't find a room for them. We also know that if a group has less than "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" schoolchildren, then it is too small and there's no point in having classes with it. So, you need to split all schoolchildren into two groups so that the size of each group was from "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", inclusive. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the university pick the passing rate in a way that meets these requirements."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ m ≤ 100"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"c1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"cm"},{"kind":"text","text":", separated by single spaces ("},{"kind":"math_inline","text":"0 ≤ ci ≤ 100"},{"kind":"text","text":"). The third line contains two space-separated integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ y ≤ 10000"},{"kind":"text","text":"). At least one "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" is greater than 0."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is impossible to pick a passing rate in a way that makes the size of each resulting groups at least "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and at most "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", print 0. Otherwise, print an integer from 1 to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the passing rate you'd like to suggest. If there are multiple possible answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n3 4 3 2 1\n6 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 3 3 4 2\n3 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 5\n3 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the beginner group has 7 students, the intermediate group has 6 of them. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample another correct answer is 3."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"357A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/357/problem/A"}