{"assets":[],"contentKind":"statement","contestId":"685","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Travelling Through the Snow Queen's Kingdom"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Gerda is travelling to the palace of the Snow Queen."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The road network consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" intersections and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" bidirectional roads. Roads are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Snow Queen put a powerful spell on the roads to change the weather conditions there. Now, if Gerda steps on the road "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" at the moment of time less or equal to "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", she will leave the road exactly at the moment "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". In case she steps on the road "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" at the moment of time greater than "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", she stays there forever."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Gerda starts at the moment of time "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" at the intersection number "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and goes to the palace of the Snow Queen, located at the intersection number "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Moreover, she has to be there at the moment "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" (or earlier), before the arrival of the Queen."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the description of the road network, determine for "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" if it's possible for Gerda to get to the palace on time."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m, q ≤ 200 000"},{"kind":"text","text":") — the number of intersections in the road network of Snow Queen's Kingdom, the number of roads and the number of queries you have to answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains the description of the road number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". The description consists of two integers "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ vi, ui ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi ≠ ui"},{"kind":"text","text":") — the indices of the intersections connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road. It's possible to get both from "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and from "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" using only this road. Each pair of intersection may appear several times, meaning there are several roads connecting this pair."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Last "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain the queries descriptions. Each of them consists of four integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ si, ti ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"si ≠ ti"},{"kind":"text","text":") — the moment of time Gerda starts her journey, the last moment of time she is allowed to arrive to the palace, the index of the starting intersection and the index of the intersection where palace is located."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if Gerda can be at the Snow Queen palace on time (not later than "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":") or \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4 6\n1 2\n2 3\n3 4\n3 5\n1 3 1 4\n1 3 2 4\n1 4 4 5\n1 4 4 1\n2 3 1 4\n2 2 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\nYes\nYes\nNo\nNo\nYes\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"685E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/685/problem/E"}