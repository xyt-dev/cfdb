{"assets":[],"contentKind":"statement","contestId":"1837","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Best Binary String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ consisting of the characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":". Let's call it a "},{"children":[{"kind":"text","text":"pattern"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's say that the binary string (a string where each character is either "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":") "},{"children":[{"kind":"text","text":"matches"}],"kind":"container"},{"kind":"text","text":" the "},{"children":[{"kind":"text","text":"pattern"}],"kind":"container"},{"kind":"text","text":" if you can replace each character "},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":" with "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" (for each character, the choice is independent) so that the strings become equal. For example, "},{"children":[{"kind":"text","text":"0010"}],"kind":"container"},{"kind":"text","text":" matches "},{"children":[{"kind":"text","text":"?01?"}],"kind":"container"},{"kind":"text","text":", but "},{"children":[{"kind":"text","text":"010"}],"kind":"container"},{"kind":"text","text":" doesn't match "},{"children":[{"kind":"text","text":"1??"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"??"}],"kind":"container"},{"kind":"text","text":", or "},{"children":[{"kind":"text","text":"????"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define the "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" of the binary string as the minimum number of operations of the form \"reverse an arbitrary contiguous substring of the string\" required to sort the string in non-descending order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to find a binary string with the minimum possible cost among those that match the given pattern. If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 3 \\cdot 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first and only line of each test case contains the string $$$s$$$ ($$$1 \\le |s| \\le 3 \\cdot 10^5$$$) consisting of characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", and/or "},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of the string lengths over all test cases does not exceed $$$3 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a binary string with the minimum possible cost among those that match the given pattern. If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n??01?\n10100\n1??10?\n0?1?10?10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n00011\n10100\n111101\n011110010\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case of the example, the cost of the resulting string is $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the cost of the resulting string is $$$2$$$: we can reverse the substring from the $$$1$$$-st character to the $$$5$$$-th character, and we obtain the string "},{"children":[{"kind":"text","text":"00101"}],"kind":"container"},{"kind":"text","text":". Then we reverse the substring from the $$$3$$$-rd to the $$$4$$$-th character, and we obtain the string "},{"children":[{"kind":"text","text":"00011"}],"kind":"container"},{"kind":"text","text":", which is sorted in non-descending order."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1837C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1837/problem/C"}