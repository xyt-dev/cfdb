nd":"paragraph"},{"children":[{"kind":"text","text":"You are given a Brainfuck program. Your task is to calculate the size of the equivalent Unary program, and print it modulo "},{"kind":"math_inline","text":"1000003"},{"kind":"math_inline","text":"(106 + 3)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input will consist of a single line "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" which gives a Brainfuck program. String "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" will contain between 1 and 100 characters, inclusive. Each character of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" will be \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"["}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"]"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":","}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the size of the equivalent Unary program modulo "},{"kind":"math_inline","text":"1000003"},{"kind":"math_inline","text":"(106 + 3)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"