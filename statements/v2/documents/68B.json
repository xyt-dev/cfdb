{"assets":["/statement-assets/08061f7994c34828fe72e3615d25d32d1fb39df8ae1232bde5cfbb540c4d9b40.png"],"contentKind":"statement","contestId":"68","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Energy exchange"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"It is well known that the planet suffers from the energy crisis. Little Petya doesn't like that and wants to save the world. For this purpose he needs every accumulator to contain the same amount of energy. Initially every accumulator has some amount of energy: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th accumulator has "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" units of energy. Energy can be transferred from one accumulator to the other. Every time "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" units of energy are transferred ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is not necessarily an integer) "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" percent of it is lost. That is, if "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" units were transferred from one accumulator to the other, amount of energy in the first one decreased by "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" units and in other increased by "},{"attrs":{"alt":"","src":"/statement-assets/08061f7994c34828fe72e3615d25d32d1fb39df8ae1232bde5cfbb540c4d9b40.png"},"kind":"image"},{"kind":"text","text":" units."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to help Petya find what maximum equal amount of energy can be stored in each accumulator after the transfers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10000, 0 ≤ k ≤ 99"},{"kind":"text","text":") — number of accumulators and the percent of energy that is lost during transfers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ... , an"},{"kind":"text","text":" — amounts of energy in the first, second, .., "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th accumulator respectively ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 1000, 1 ≤ i ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output maximum possible amount of energy that can remain in each of accumulators after the transfers of energy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The absolute or relative error in the answer should not exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 50\n4 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2.000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 90\n1 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.909090909\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"68B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/68/problem/B"}