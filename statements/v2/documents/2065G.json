{"assets":[],"contentKind":"statement","contestId":"2065","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Skibidus and Capping"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Skibidus was abducted by aliens of Amog! Skibidus tries to talk his way out, but the Amog aliens don't believe him. To prove that he is not totally capping, the Amog aliens asked him to solve this task:"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An integer $$$x$$$ is considered a "},{"children":[{"kind":"text","text":"semi-prime"}],"kind":"container"},{"kind":"text","text":" if it can be written as $$$p \\cdot q$$$ where $$$p$$$ and $$$q$$$ are (not necessarily distinct) "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Prime_number"},"children":[{"kind":"text","text":"prime numbers"}],"kind":"link"},{"kind":"text","text":". For example, $$$9$$$ is a "},{"children":[{"kind":"text","text":"semi-prime"}],"kind":"container"},{"kind":"text","text":" since it can be written as $$$3 \\cdot 3$$$, and $$$3$$$ is a prime number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Skibidus was given an array $$$a$$$ containing $$$n$$$ integers. He must report the number of pairs $$$(i, j)$$$ such that $$$i \\leq j$$$ and $$$\\operatorname{lcm}(a_i, a_j)$$$$$$^{\\text{∗}}$$$ is "},{"children":[{"kind":"text","text":"semi-prime"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$Given two integers $$$x$$$ and $$$y$$$, $$$\\operatorname{lcm}(x, y)$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Least_common_multiple"},"children":[{"kind":"text","text":"least common multiple"}],"kind":"link"},{"kind":"text","text":" of $$$x$$$ and $$$y$$$."}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\leq t \\leq 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains an integer $$$n$$$ ($$$2 \\leq n \\leq 2 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following line contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$2 \\leq a_i \\leq n$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the number of ordered pairs of indices on a new line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n4\n2 2 3 4\n6\n2 2 3 4 5 6\n9\n2 2 4 5 7 8 9 3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n12\n18\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the $$$5$$$ pairs of indices are $$$(1, 3)$$$, $$$(1, 4)$$$, $$$(2, 3)$$$, $$$(2, 4)$$$, and $$$(4, 4)$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"2065G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2065/problem/G"}