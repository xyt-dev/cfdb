{"assets":[],"contentKind":"statement","contestId":"1898","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Milica and String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Milica has a string $$$s$$$ of length $$$n$$$, consisting only of characters "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":". She wants to modify $$$s$$$ so it contains "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" $$$k$$$ instances of "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":". In one operation, she can do the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Select an integer $$$i$$$ ($$$1 \\leq i \\leq n$$$) and a character $$$c$$$ ($$$c$$$ is equal to either "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then, replace "},{"children":[{"kind":"text","text":"each"}],"kind":"container"},{"kind":"text","text":" of the first $$$i$$$ characters of string $$$s$$$ (that is, characters $$$s_1, s_2, \\ldots, s_i$$$) with $$$c$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Milica does not want to perform too many operations in order not to waste too much time on them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"She asks you to find the minimum number of operations required to modify $$$s$$$ so it contains exactly $$$k$$$ instances of "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":". She also wants you to find these operations (that is, integer $$$i$$$ and character $$$c$$$ selected in each operation)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\leq t \\leq 500$$$). The description of test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$k$$$ ($$$3 \\leq n \\leq 100$$$, $$$0 \\leq k \\leq n$$$) — the length of the string $$$s$$$ and the number of characters "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" Milica wants to appear in $$$s$$$ in the end."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains the string $$$s$$$ of length $$$n$$$, consisting only of characters "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, in the first line output a single integer $$$m$$$ — the minimum number of operations Milica should perform."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the $$$j$$$-th of the next $$$m$$$ lines output an integer $$$i$$$ ($$$1 \\le i \\le n$$$) and a character $$$c$$$ ($$$c$$$ is '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"') — the parameters of the $$$j$$$-th operation as described in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions with the minimum possible number of operations, output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n5 2\nAAABB\n5 3\nAABAB\n5 0\nBBBBB\n3 0\nBAA\n10 3\nBBBABBBBAB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n1\n1 B\n1\n5 A\n1\n2 A\n1\n6 A\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, there are already $$$2$$$ characters "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" in $$$s$$$, so Milica does not have to perform any operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the only way to achieve $$$3$$$ characters "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" in $$$s$$$ in one operation is to replace the first character of $$$s$$$ by "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" on the first operation: "},{"children":[{"kind":"text","text":"AABAB"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"ABAB"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, the only way to achieve $$$0$$$ characters "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" in $$$s$$$ in one operation is to replace the first $$$5$$$ characters of $$$s$$$ by "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" on the first operation: "},{"children":[{"kind":"text","text":"BBBBB"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"children":[{"kind":"text","text":"AAAAA"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, one of the ways to achieve $$$0$$$ characters "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" in $$$s$$$ in one operation is to replace the first $$$2$$$ characters of $$$s$$$ by "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" on the first operation: "},{"children":[{"kind":"text","text":"BAA"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"children":[{"kind":"text","text":"AA"}],"kind":"container"},{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":". Note that \""},{"children":[{"kind":"text","text":"1 A"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"3 A"}],"kind":"container"},{"kind":"text","text":"\" are also correct one-operation solutions."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1898A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1898/problem/A"}