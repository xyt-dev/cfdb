{"assets":[],"contentKind":"statement","contestId":"553","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Kyoya and Colored Balls"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Kyoya Ootori has a bag with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" colored balls that are colored with "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" different colors. The colors are labeled from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Balls of the same color are indistinguishable. He draws balls from the bag one by one until the bag is empty. He noticed that he drew the last ball of color "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" before drawing the last ball of color "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k - 1"},{"kind":"text","text":". Now he wonders how many different ways this can happen. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input will have one integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 1000"},{"kind":"text","text":") the number of colors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then, "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines will follow. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line will contain "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":", the number of balls of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th color ("},{"kind":"math_inline","text":"1 ≤ ci ≤ 1000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The total number of balls doesn't exceed 1000."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single integer, the number of ways that Kyoya can draw the balls from the bag as described in the statement, modulo "},{"kind":"math_inline","text":"1 000 000 007"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2\n2\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1\n2\n3\n4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1680\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, we have 2 balls of color 1, 2 balls of color 2, and 1 ball of color 3. The three ways for Kyoya are: "}],"kind":"paragraph"},{"kind":"code_block","text":"\n1 2 1 2 3\n1 1 2 2 3\n2 1 1 2 3\n"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"553A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/553/problem/A"}