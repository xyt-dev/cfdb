{"assets":[],"contentKind":"statement","contestId":"662","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. International Olympiad"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"International Abbreviation Olympiad takes place annually starting from 1989. Each year the competition receives an abbreviation of form "},{"children":[{"kind":"text","text":"IAO'y"}],"kind":"container"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" stands for some number of consequent last digits of the current year. Organizers always pick an abbreviation with non-empty string "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" that has never been used before. Among all such valid abbreviations they choose the shortest one and announce it to be the abbreviation of this year's competition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the first three Olympiads (years 1989, 1990 and 1991, respectively) received the abbreviations "},{"children":[{"kind":"text","text":"IAO'9"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"IAO'0"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"IAO'1"}],"kind":"container"},{"kind":"text","text":", while the competition in 2015 received an abbreviation "},{"children":[{"kind":"text","text":"IAO'15"}],"kind":"container"},{"kind":"text","text":", as "},{"children":[{"kind":"text","text":"IAO'5"}],"kind":"container"},{"kind":"text","text":" has been already used in 1995."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a list of abbreviations. For each of them determine the year it stands for."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":") — the number of abbreviations to process. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, each containing a single abbreviation. It's guaranteed that each abbreviation contains at most nine digits."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each abbreviation given in the input, find the year of the corresponding Olympiad."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nIAO'15\nIAO'2015\nIAO'1\nIAO'9\nIAO'0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2015\n12015\n1991\n1989\n1990\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nIAO'9\nIAO'99\nIAO'999\nIAO'9999\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1989\n1999\n2999\n9999\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"662D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/662/problem/D"}