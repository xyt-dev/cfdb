{"assets":[],"contentKind":"statement","contestId":"1913","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Rating Increase"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Monocarp is a great solver of adhoc problems. Recently, he participated in an Educational Codeforces Round, and gained rating!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Monocarp knew that, before the round, his rating was $$$a$$$. After the round, it increased to $$$b$$$ ($$$b \\gt a$$$). He wrote both values one after another to not forget them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, he wrote them so close to each other, that he can't tell now where the first value ends and the second value starts."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, help him find some values $$$a$$$ and $$$b$$$ such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" neither of them has a leading zero; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" both of them are strictly greater than $$$0$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b \\gt a$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" they produce the given value $$$ab$$$ when written one after another. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there are multiple answers, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of testcases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each testcase consists of a single string $$$ab$$$ of length from $$$2$$$ to $$$8$$$ that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" consists only of digits; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" doesn't start with a zero. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase, determine if such values $$$a$$$ and $$$b$$$ exist. If they don't, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". Otherwise, print two integers $$$a$$$ and $$$b$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n20002001\n391125\n200200\n2001000\n12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2000 2001\n39 1125\n-1\n200 1000\n1 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second testcase, printing $$$3$$$ and $$$91125$$$ is also valid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third testcase, $$$20$$$ and $$$0200$$$ is not valid, because $$$b$$$ has a leading zero. $$$200$$$ and $$$200$$$ is not valid, because $$$200$$$ is not strictly greater than $$$200$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1913A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1913/problem/A"}