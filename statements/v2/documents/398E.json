{"assets":[],"contentKind":"statement","contestId":"398","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Sorting Permutations"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"We are given a permutation sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" of numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Let's assume that in one second, we can choose some disjoint pairs "},{"kind":"math_inline","text":"(u1, v1), (u2, v2), ..., (uk, vk)"},{"kind":"text","text":" and swap all "},{"kind":"math_inline","text":"aui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"avi"},{"kind":"text","text":" for every "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" at the same time ("},{"kind":"math_inline","text":"1 ≤ ui < vi ≤ n"},{"kind":"text","text":"). The pairs are disjoint if every "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vj"},{"kind":"text","text":" are different from each other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We want to sort the sequence completely in increasing order as fast as possible. Given the initial permutation, calculate the number of ways to achieve this. Two ways are different if and only if there is a time "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", such that the set of pairs used for swapping at that time are different as sets (so ordering of pairs doesn't matter). If the given permutation is already sorted, it takes no time to sort, so the number of ways to sort it is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To make the problem more interesting, we have "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" holes inside the permutation. So exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" numbers of "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" are not yet determined. For every possibility of filling the holes, calculate the number of ways, and print the total sum of these values modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(0 ≤ k ≤ 12)"},{"kind":"text","text":". The second line contains the permutation sequence "},{"kind":"math_inline","text":"a1, ..., an"},{"kind":"math_inline","text":"(0 ≤ ai ≤ n)"},{"kind":"text","text":". If a number is not yet determined, it is denoted as "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". There are exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" zeroes. All the numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" that aren't equal to zero are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the total sum of the number of ways modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 0\n1 5 2 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n1 0 2 4 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"398E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/398/problem/E"}