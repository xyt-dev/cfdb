{"assets":[],"contentKind":"statement","contestId":"827","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Rusty String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Grigory loves strings. Recently he found a metal strip on a loft. The strip had length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and consisted of letters \""},{"children":[{"kind":"text","text":"V"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"K"}],"kind":"container"},{"kind":"text","text":"\". Unfortunately, rust has eaten some of the letters so that it's now impossible to understand which letter was written."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Grigory couldn't understand for a long time what these letters remind him of, so he became interested in the following question: if we put a letter \""},{"children":[{"kind":"text","text":"V"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"K"}],"kind":"container"},{"kind":"text","text":"\" on each unreadable position, which values can the period of the resulting string be equal to?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A period of a string is such an integer "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to the length of the string that if we put the string shifted by "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" positions to the right on itself, then all overlapping letters coincide. For example, "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" are periods of \""},{"children":[{"kind":"text","text":"VKKVK"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"There are several (at least one) test cases in the input. The first line contains single integer — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is an empty line before each test case. Each test case is described in two lines: the first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5·105"},{"kind":"text","text":") — the length of the string, the second line contains the string of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", consisting of letters \""},{"children":[{"kind":"text","text":"V"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"K"}],"kind":"container"},{"kind":"text","text":"\" and characters \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\". The latter means the letter on its position is unreadable."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of lengths among all test cases doesn't exceed "},{"kind":"math_inline","text":"5·105"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"For hacks"}],"kind":"container"},{"kind":"text","text":" you can only use tests with one test case."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print two lines. In the first line print the number of possible periods after we replace each unreadable letter with \""},{"children":[{"kind":"text","text":"V"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"K"}],"kind":"container"},{"kind":"text","text":"\". In the next line print all these values in increasing order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n \n5\nV??VK\n \n6\n??????\n \n4\n?VK?\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n3 5\n6\n1 2 3 4 5 6\n3\n2 3 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case from example we can obtain, for example, \""},{"children":[{"kind":"text","text":"VKKVK"}],"kind":"container"},{"kind":"text","text":"\", which has periods "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case we can obtain \""},{"children":[{"kind":"text","text":"VVVVVV"}],"kind":"container"},{"kind":"text","text":"\" which has all periods from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case string \""},{"children":[{"kind":"text","text":"KVKV"}],"kind":"container"},{"kind":"text","text":"\" has periods "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", and string \""},{"children":[{"kind":"text","text":"KVKK"}],"kind":"container"},{"kind":"text","text":"\" has periods "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"827E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/827/problem/E"}