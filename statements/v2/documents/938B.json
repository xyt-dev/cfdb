{"assets":[],"contentKind":"statement","contestId":"938","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Run For Your Prize"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You and your friend are participating in a TV show \"Run For Your Prize\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At the start of the show "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" prizes are located on a straight line. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th prize is located at position "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". Positions of all prizes are distinct. You start at position "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", your friend — at position "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" (and there is no prize in any of these two positions). You have to work as a team and collect all prizes in minimum possible time, in any order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You know that it takes exactly "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" second to move from position "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to position "},{"kind":"math_inline","text":"x + 1"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"x - 1"},{"kind":"text","text":", both for you and your friend. You also have trained enough to instantly pick up any prize, if its position is equal to your current position (and the same is true for your friend). Carrying prizes does not affect your speed (or your friend's speed) at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now you may discuss your strategy with your friend and decide who will pick up each prize. Remember that every prize must be picked up, either by you or by your friend."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of seconds it will take to pick up all the prizes?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of prizes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ ai ≤ 106 - 1"},{"kind":"text","text":") — the positions of the prizes. No two prizes are located at the same position. Positions are given in ascending order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the minimum number of seconds it will take to collect all prizes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 3 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 999995\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example you take all the prizes: take the first at "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", the second at "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and the third at "},{"kind":"math_inline","text":"8"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example you take the first prize in "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" second and your friend takes the other in "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" seconds, you do this simultaneously, so the total time is "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"938B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/938/problem/B"}