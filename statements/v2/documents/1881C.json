{"assets":["/statement-assets/38d832a760ac4d9ec4532acb5dc204b08fdd7a12124aec6617312ea01e94de9c.png"],"contentKind":"statement","contestId":"1881","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Perfect Square"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Kristina has a matrix of size $$$n$$$ by $$$n$$$, filled with lowercase Latin letters. The value of $$$n$$$ is "},{"children":[{"kind":"text","text":"even"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"She wants to change some characters so that her matrix becomes a "},{"children":[{"kind":"text","text":"perfect square"}],"kind":"container"},{"kind":"text","text":". A matrix is called a "},{"children":[{"kind":"text","text":"perfect square"}],"kind":"container"},{"kind":"text","text":" if it remains unchanged when rotated $$$90^\\circ$$$ clockwise "},{"children":[{"kind":"text","text":"once"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here is an example of rotating a matrix by $$$90^\\circ$$$:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/38d832a760ac4d9ec4532acb5dc204b08fdd7a12124aec6617312ea01e94de9c.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In one operation, Kristina can choose any cell and replace its value with the next character in the alphabet. If the character is equal to \""},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"\", its value "},{"children":[{"kind":"text","text":"does not change"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the "},{"children":[{"kind":"text","text":"minimum"}],"kind":"container"},{"kind":"text","text":" number of operations required to make the matrix a "},{"children":[{"kind":"text","text":"perfect square"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if the $$$4$$$ by $$$4$$$ matrix looks like this:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$\\matrix{ a & b & b & a \\cr b & c & \\textbf{b} & b \\cr b & c & c & b\\cr a & b & b & a \\cr }$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"then it is enough to apply $$$1$$$ operation to the letter "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":", highlighted in bold."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^2$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follows the description of each test case."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single "},{"children":[{"kind":"text","text":"even"}],"kind":"container"},{"kind":"text","text":" integer $$$n$$$ ($$$2 \\le n \\le 10^3$$$) — the number of rows and columns in the matrix."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follows $$$n$$$ lines, each containing exactly $$$n$$$ lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$10^3$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single number on a separate line: the "},{"children":[{"kind":"text","text":"minimum"}],"kind":"container"},{"kind":"text","text":" number of operations required for Kristina to obtain a "},{"children":[{"kind":"text","text":"perfect square"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n4\nabba\nbcbb\nbccb\nabba\n2\nab\nba\n6\ncodefo\nrcesco\ndeforc\nescode\nforces\ncodefo\n4\nbaaa\nabba\nbaba\nbaab\n4\nbbaa\nabba\naaba\nabba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n181\n5\n9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test case is explained in the problem statement."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1881C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1881/problem/C"}