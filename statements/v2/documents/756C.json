{"assets":[],"contentKind":"statement","contestId":"756","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Nikita and stack"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Nikita has a stack. A stack in this problem is a data structure that supports two operations. Operation "},{"children":[{"kind":"text","text":"push(x)"}],"kind":"container"},{"kind":"text","text":" puts an integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" on the top of the stack, and operation "},{"children":[{"kind":"text","text":"pop()"}],"kind":"container"},{"kind":"text","text":" deletes the top integer from the stack, i. e. the last added. If the stack is empty, then the operation "},{"children":[{"kind":"text","text":"pop()"}],"kind":"container"},{"kind":"text","text":" does nothing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nikita made "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" operations with the stack but forgot them. Now Nikita wants to remember them. He remembers them one by one, on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th step he remembers an operation he made "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":"-th. In other words, he remembers the operations in order of some permutation "},{"kind":"math_inline","text":"p1, p2, ..., pm"},{"kind":"text","text":". After each step Nikita wants to know what is the integer on the top of the stack after performing the operations he have already remembered, in the corresponding order. Help him!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":") — the number of operations Nikita made."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the operations Nikita remembers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line starts with two integers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ti = 0"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"ti = 1"},{"kind":"text","text":") — the index of operation he remembers on the step "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", and the type of the operation. "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" equals "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", if the operation is "},{"children":[{"kind":"text","text":"pop()"}],"kind":"container"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", is the operation is "},{"children":[{"kind":"text","text":"push(x)"}],"kind":"container"},{"kind":"text","text":". If the operation is "},{"children":[{"kind":"text","text":"push(x)"}],"kind":"container"},{"kind":"text","text":", the line also contains the integer "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ 106"},{"kind":"text","text":") — the integer added to the stack."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that each integer from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is present exactly once among integers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers. The integer "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" should equal the number on the top of the stack after performing all the operations Nikita remembered on the steps from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". If the stack is empty after performing all these operations, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 1 2\n1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 2\n2 1 3\n3 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n3\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n5 0\n4 0\n3 1 1\n2 1 1\n1 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n-1\n-1\n-1\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, after Nikita remembers the operation on the first step, the operation "},{"children":[{"kind":"text","text":"push(2)"}],"kind":"container"},{"kind":"text","text":" is the only operation, so the answer is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". After he remembers the operation "},{"children":[{"kind":"text","text":"pop()"}],"kind":"container"},{"kind":"text","text":" which was done before "},{"children":[{"kind":"text","text":"push(2)"}],"kind":"container"},{"kind":"text","text":", answer stays the same."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, the operations are "},{"children":[{"kind":"text","text":"push(2)"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"push(3)"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"pop()"}],"kind":"container"},{"kind":"text","text":". Nikita remembers them in the order they were performed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example Nikita remembers the operations in the reversed order."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"756C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/756/problem/C"}