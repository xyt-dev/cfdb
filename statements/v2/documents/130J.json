{"assets":[],"contentKind":"statement","contestId":"130","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"J. Date calculation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In Gregorian calendar a typical year consists of "},{"kind":"math_inline","text":"365"},{"kind":"text","text":" days and "},{"kind":"math_inline","text":"12"},{"kind":"text","text":" months. The numbers of days in the months are: "},{"kind":"math_inline","text":"31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31"},{"kind":"text","text":". If year index is divisible by "},{"kind":"math_inline","text":"400"},{"kind":"text","text":", or divisible by "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" but not by "},{"kind":"math_inline","text":"100"},{"kind":"text","text":", the year becomes leap year, with one extra day in the second month (the one which typically has "},{"kind":"math_inline","text":"28"},{"kind":"text","text":" days)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the index of the year and the index of the day in the year. Find out the date of this day (day and month it will fall upon)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains the year index, between "},{"kind":"math_inline","text":"1600"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2400"},{"kind":"text","text":", inclusive. The second line contains the day index, between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"366"},{"kind":"text","text":", inclusive. It is guaranteed that the day index will be valid for this year, i.e., day "},{"kind":"math_inline","text":"366"},{"kind":"text","text":" will occur only in a leap year."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the index of the day and the index of the month, separated with a space."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2011\n324\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20 11\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2012\n274\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"30 9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"All indexes are "},{"kind":"math_inline","text":"1"},{"kind":"text","text"