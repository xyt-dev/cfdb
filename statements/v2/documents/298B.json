{"assets":[],"contentKind":"statement","contestId":"298","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Sail"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The polar bears are going fishing. They plan to sail from "},{"kind":"math_inline","text":"(sx, sy)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(ex, ey)"},{"kind":"text","text":". However, the boat can only sail by wind. At each second, the wind blows in one of these directions: east, south, west or north. Assume the boat is currently at "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If the wind blows to the east, the boat will move to "},{"kind":"math_inline","text":"(x + 1, y)"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the wind blows to the south, the boat will move to "},{"kind":"math_inline","text":"(x, y - 1)"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the wind blows to the west, the boat will move to "},{"kind":"math_inline","text":"(x - 1, y)"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the wind blows to the north, the boat will move to "},{"kind":"math_inline","text":"(x, y + 1)"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Alternatively, they can hold the boat by the anchor. In this case, the boat stays at "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":". Given the wind direction for "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" seconds, what is the earliest time they sail to "},{"kind":"math_inline","text":"(ex, ey)"},{"kind":"text","text":"?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains five integers "},{"kind":"math_inline","text":"t, sx, sy, ex, ey"},{"kind":"math_inline","text":"(1 ≤ t ≤ 105,  - 109 ≤ sx, sy, ex, ey ≤ 109)"},{"kind":"text","text":". The starting location and the ending location will be different."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" characters, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character is the wind blowing direction at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th second. It will be one of the four possibilities: \"E\" (east), \"S\" (south), \"W\" (west) and \"N\" (north)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If they can reach "},{"kind":"math_inline","text":"(ex, ey)"},{"kind":"text","text":" within "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" seconds, print the earliest time they can achieve it. Otherwise, print \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 0 0 1 1\nSESNW\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 5 3 3 6\nNENSWESNEE\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, they can stay at seconds "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", and move at seconds "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, they cannot sail to the destination."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"298B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/298/problem/B"}