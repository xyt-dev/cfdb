{"assets":["/statement-assets/80361c069d23e306733ed4550ae03658090ffcc0f049d65e3c22f188185f5961.png","/statement-assets/24ded59a90dc21c423d2cd425da8b7f8de69e17e9ee7364e113a345eee80d777.png","/statement-assets/4e51be636b2deb906b113860368fa5f14144ed08d262e426fa2b639223203f32.png","/statement-assets/c136a5d70ef5cc87fbb4f9737fa2d3596454f1b727579d2e5e264c13dbe56335.png","/statement-assets/be0ba954d266018f586f367f1c8de372c2250984b3be69a1d550eda63da14a66.png","/statement-assets/bb0774dbb77a121aafa338526c67b6ab7f2adebc528132c285626c8868c7722a.png"],"contentKind":"statement","contestId":"591","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Rebranding"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The name of one small but proud corporation consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase English letters. The Corporation has decided to try rebranding — an active marketing strategy, that includes a set of measures to change either the brand (both for the company and the goods it produces) or its components: the name, the logo, the slogan. They decided to start with the name."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For this purpose the corporation has consecutively hired "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" designers. Once a company hires the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th designer, he immediately contributes to the creation of a new corporation name as follows: he takes the newest version of the name and replaces all the letters "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":", and all the letters "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". This results in the new version. It is possible that some of these letters do no occur in the string. It may also happen that "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" coincides with "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":". The version of the name received after the work of the last designer becomes the new name of the corporation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Manager Arkady has recently got a job in this company, but is already soaked in the spirit of teamwork and is very worried about the success of the rebranding. Naturally, he can't wait to find out what is the new name the Corporation will receive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Satisfy Arkady's curiosity and tell him the final version of the name."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 200 000"},{"kind":"text","text":") — the length of the initial name and the number of designers hired, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase English letters and represents the original name of the corporation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the descriptions of the designers' actions: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains two space-separated lowercase English letters "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the new name of the corporation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 1\npolice\np m\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"molice\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11 6\nabacabadaba\na b\nb c\na d\ne g\nf a\nb b\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"cdcbcdcfcdc\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second sample the name of the corporation consecutively changes as follows:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/80361c069d23e306733ed4550ae03658090ffcc0f049d65e3c22f188185f5961.png"},"kind":"image"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/24ded59a90dc21c423d2cd425da8b7f8de69e17e9ee7364e113a345eee80d777.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/4e51be636b2deb906b113860368fa5f14144ed08d262e426fa2b639223203f32.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c136a5d70ef5cc87fbb4f9737fa2d3596454f1b727579d2e5e264c13dbe56335.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/be0ba954d266018f586f367f1c8de372c2250984b3be69a1d550eda63da14a66.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/bb0774dbb77a121aafa338526c67b6ab7f2adebc528132c285626c8868c7722a.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"591B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/591/problem/B"}