{"assets":["/statement-assets/14c8ba43bfcdd7c2c6d569466460d28369a0e85e85a2318e8ac9db8fdb504a3a.png"],"contentKind":"statement","contestId":"9","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Running Student"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"And again a misfortune fell on Poor Student. He is being late for an exam."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Having rushed to a bus stop that is in point "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":", he got on a minibus and they drove along a straight line, parallel to axis "},{"kind":"math_inline","text":"OX"},{"kind":"text","text":", in the direction of increasing "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Poor Student knows the following: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" during one run the minibus makes "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" stops, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th stop is in point "},{"kind":"math_inline","text":"(xi, 0)"}],"kind":"list_item"},{"children":[{"kind":"text","text":" coordinates of all the stops are different "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the minibus drives at a constant speed, equal to "},{"kind":"math_inline","text":"vb"}],"kind":"list_item"},{"children":[{"kind":"text","text":" it can be assumed the passengers get on and off the minibus at a bus stop momentarily "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Student can get off the minibus only at a bus stop "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Student will have to get off the minibus at a terminal stop, if he does not get off earlier "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the University, where the exam will be held, is in point "},{"kind":"math_inline","text":"(xu, yu)"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Student can run from a bus stop to the University at a constant speed "},{"kind":"math_inline","text":"vs"},{"kind":"text","text":" as long as needed "}],"kind":"list_item"},{"children":[{"kind":"text","text":" a distance between two points can be calculated according to the following formula: "},{"attrs":{"alt":"","src":"/statement-assets/14c8ba43bfcdd7c2c6d569466460d28369a0e85e85a2318e8ac9db8fdb504a3a.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Student is already on the minibus, so, he cannot get off at the first bus stop "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Poor Student wants to get to the University as soon as possible. Help him to choose the bus stop, where he should get off. If such bus stops are multiple, choose the bus stop closest to the University."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integer numbers: "},{"kind":"math_inline","text":"2 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ vb, vs ≤ 1000"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" non-negative integers in ascending order: coordinates "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" of the bus stop with index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". It is guaranteed that "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":" equals to zero, and "},{"kind":"math_inline","text":"xn ≤ 105"},{"kind":"text","text":". The third line contains the coordinates of the University, integers "},{"kind":"math_inline","text":"xu"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yu"},{"kind":"text","text":", not exceeding "},{"kind":"math_inline","text":"105"},{"kind":"text","text":" in absolute value. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line output the answer to the problem — index of the optimum bus stop."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5 2\n0 2 4 6\n4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 1\n0 100000\n100000 100000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"As you know, students are a special sort of people, and minibuses usually do not hurry. That's why you should not be surprised, if Student's speed is higher than the speed of the minibus."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"9B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/9/problem/B"}