{"assets":["/statement-assets/dcdbbb2081c6738638dee9f86d9ce113952a8b7a88cd20a4b2f87756fe928b63.png","/statement-assets/cb17ad53755cee21d0bf4d7d4b27f8f60d028dacb28c63dac642368c2fb97613.png","/statement-assets/b1cff6afc1ccd1b23cc2fd822f4af1730bc7b8b654e67c67d691ba07d52eb0c9.png","/statement-assets/67205b8dfc236b1452f59815a4324646d43b27f22c60584a833c88b501fab2d7.png","/statement-assets/f6aca3141cdfb82fc15e5f53626d44f2b47b004a2b1906d664cf4badcf448fdf.png"],"contentKind":"statement","contestId":"687","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Remainders Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Today Pari and Arya are playing a game called Remainders."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pari chooses two positive integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", and tells Arya "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" but not "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". Arya have to find the value "},{"attrs":{"alt":"","src":"/statement-assets/dcdbbb2081c6738638dee9f86d9ce113952a8b7a88cd20a4b2f87756fe928b63.png"},"kind":"image"},{"kind":"text","text":". There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ancient numbers "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"text","text":" and Pari has to tell Arya "},{"attrs":{"alt":"","src":"/statement-assets/cb17ad53755cee21d0bf4d7d4b27f8f60d028dacb28c63dac642368c2fb97613.png"},"kind":"image"},{"kind":"text","text":" if Arya wants. Given "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and the ancient values, tell us if Arya has a winning strategy independent of value of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" or not. Formally, is it true that Arya can understand the value "},{"attrs":{"alt":"","src":"/statement-assets/dcdbbb2081c6738638dee9f86d9ce113952a8b7a88cd20a4b2f87756fe928b63.png"},"kind":"image"},{"kind":"text","text":" for any positive integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note, that "},{"attrs":{"alt":"","src":"/statement-assets/b1cff6afc1ccd1b23cc2fd822f4af1730bc7b8b654e67c67d691ba07d52eb0c9.png"},"kind":"image"},{"kind":"text","text":" means the remainder of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" after dividing it by "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n,  k ≤ 1 000 000"},{"kind":"text","text":") — the number of ancient integers and value "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" that is chosen by Pari."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci ≤ 1 000 000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if Arya has a winning strategy independent of value of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", or \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n2 3 5 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 7\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Arya can understand "},{"attrs":{"alt":"","src":"/statement-assets/67205b8dfc236b1452f59815a4324646d43b27f22c60584a833c88b501fab2d7.png"},"kind":"image"},{"kind":"text","text":" because "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" is one of the ancient numbers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, Arya can't be sure what "},{"attrs":{"alt":"","src":"/statement-assets/f6aca3141cdfb82fc15e5f53626d44f2b47b004a2b1906d664cf4badcf448fdf.png"},"kind":"image"},{"kind":"text","text":" is. For example "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" have the same remainders after dividing by "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", but they differ in remainders after dividing by "},{"kind":"math_inline","text":"7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"687B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/687/problem/B"}