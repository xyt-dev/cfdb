{"assets":[],"contentKind":"statement","contestId":"25","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Test"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sometimes it is hard to prepare tests for programming problems. Now Bob is preparing tests to new problem about strings — input data to his problem is one string. Bob has 3 wrong solutions to this problem. The first gives the wrong answer if the input data contains the substring "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":", the second enters an infinite loop if the input data contains the substring "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":", and the third requires too much memory if the input data contains the substring "},{"kind":"math_inline","text":"s3"},{"kind":"text","text":". Bob wants these solutions to fail single test. What is the minimal length of test, which couldn't be passed by all three Bob's solutions?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"There are exactly 3 lines in the input data. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":". All the strings are non-empty, consists of lowercase Latin letters, the length of each string doesn't exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one number — what is minimal length of the string, containing "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s3"},{"kind":"text","text":" as substrings."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ab\nbc\ncd\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abacaba\nabaaba\nx\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"25E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/25/problem/E"}