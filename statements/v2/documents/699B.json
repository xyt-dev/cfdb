{"assets":[],"contentKind":"statement","contestId":"699","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. One Bomb"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a description of a depot. It is a rectangular checkered field of "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" size. Each cell in a field can be empty (\""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\") or it can be occupied by a wall (\""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have one bomb. If you lay the bomb at the cell "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":", then after triggering it will wipe out all walls in the row "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and all walls in the column "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are to determine if it is possible to wipe out all walls in the depot by placing and triggering "},{"children":[{"kind":"text","text":"exactly one bomb"}],"kind":"container"},{"kind":"text","text":". The bomb can be laid both in an empty cell or in a cell occupied by a wall."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 1000"},{"kind":"text","text":") — the number of rows and columns in the depot field. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" symbols \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\" each — the description of the field. "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th symbol in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them stands for cell "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":". If the symbol is equal to \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\", then the corresponding cell is empty, otherwise it equals \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\" and the corresponding cell is occupied by a wall."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is impossible to wipe out all walls by placing and triggering exactly one bomb, then print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" in the first line (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in the first line and two integers in the second line — the coordinates of the cell at which the bomb should be laid. If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n.*..\n....\n.*..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n..*\n.*.\n*..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 5\n..*..\n..*..\n*****\n..*..\n..*..\n..*..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n3 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"699B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/699/problem/B"}