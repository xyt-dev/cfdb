{"assets":[],"contentKind":"statement","contestId":"2135","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Against the Difference"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"We define that a "},{"children":[{"kind":"text","text":"block"}],"kind":"container"},{"kind":"text","text":" is an array where all elements in it are equal to the length of the array. For example, $$$[3, 3, 3]$$$, $$$[1]$$$, and $$$[4, 4, 4, 4]$$$ are "},{"children":[{"kind":"text","text":"blocks"}],"kind":"container"},{"kind":"text","text":", while $$$[1, 1, 1]$$$ and $$$[2, 3, 3]$$$ are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An array is called "},{"children":[{"kind":"text","text":"neat"}],"kind":"container"},{"kind":"text","text":" if it can be obtained by the concatenation of an arbitrary number of "},{"children":[{"kind":"text","text":"blocks"}],"kind":"container"},{"kind":"text","text":" (possibly zero). Note that an empty array is always "},{"children":[{"kind":"text","text":"neat"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array $$$a$$$ consisting of $$$n$$$ integers. Find the length of its longest "},{"children":[{"kind":"text","text":"neat"}],"kind":"container"},{"kind":"text","text":" subsequence$$$^{\\text{∗}}$$$. "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$A sequence $$$c$$$ is a subsequence of a sequence $$$a$$$ if $$$c$$$ can be obtained from $$$a$$$ by the deletion of several (possibly, zero or all) element from arbitrary positions. "}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains an integer $$$n$$$ ($$$1 \\le n \\le 2\\cdot 10^5$$$) — the length of $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1,a_2,\\ldots,a_n$$$ ($$$1 \\le a_i \\le n$$$) — the elements of $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2\\cdot 10^5$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the length of the longest "},{"children":[{"kind":"text","text":"neat"}],"kind":"container"},{"kind":"text","text":" subsequence of $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1\n1\n2\n2 2\n4\n2 2 1 1\n6\n1 2 3 3 3 1\n8\n8 8 8 8 8 8 8 7\n10\n2 3 3 1 2 3 5 1 1 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n4\n5\n0\n5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the whole array $$$[1]$$$ is "},{"children":[{"kind":"text","text":"neat"}],"kind":"container"},{"kind":"text","text":" because it is a "},{"children":[{"kind":"text","text":"block"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the whole array $$$[2, 2]$$$ is "},{"children":[{"kind":"text","text":"neat"}],"kind":"container"},{"kind":"text","text":" because it is a "},{"children":[{"kind":"text","text":"block"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, the whole array $$$[2,2,1,1]$$$ is "},{"children":[{"kind":"text","text":"neat"}],"kind":"container"},{"kind":"text","text":" because it is the concatenation of three "},{"children":[{"kind":"text","text":"blocks"}],"kind":"container"},{"kind":"text","text":": $$$[2,2]$$$, $$$[1]$$$, and $$$[1]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, one of the longest "},{"children":[{"kind":"text","text":"neat"}],"kind":"container"},{"kind":"text","text":" subsequences of $$$a$$$ is $$$[1, 3, 3, 3, 1]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth test case, the longest "},{"children":[{"kind":"text","text":"neat"}],"kind":"container"},{"kind":"text","text":" subsequence of $$$a$$$ is the empty subsequence."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2135A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2135/problem/A"}