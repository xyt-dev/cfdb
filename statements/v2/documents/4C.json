{"assets":[],"contentKind":"statement","contestId":"4","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Registration system"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A new e-mail service \"Berlandesk\" is going to be opened in Berland in the near future. The site administration wants to launch their project as soon as possible, that's why they ask you to help. You're suggested to implement the prototype of site registration system. The system should work on the following principle. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each time a new user wants to register, he sends to the system a request with his "},{"children":[{"kind":"text","text":"name"}],"kind":"container"},{"kind":"text","text":". If such a "},{"children":[{"kind":"text","text":"name"}],"kind":"container"},{"kind":"text","text":" does not exist in the system database, it is inserted into the database, and the user gets the response "},{"children":[{"kind":"text","text":"OK"}],"kind":"container"},{"kind":"text","text":", confirming the successful registration. If the "},{"children":[{"kind":"text","text":"name"}],"kind":"container"},{"kind":"text","text":" already exists in the system database, the system makes up a new user name, sends it to the user as a prompt and "},{"children":[{"kind":"text","text":"also inserts the prompt into the database"}],"kind":"container"},{"kind":"text","text":". The new name is formed by the following rule. Numbers, starting with 1, are appended one after another to "},{"children":[{"kind":"text","text":"name"}],"kind":"container"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"name1"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"name2"}],"kind":"container"},{"kind":"text","text":", ...), among these numbers the least "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is found so that "},{"children":[{"kind":"text","text":"name"}],"kind":"container"},{"kind":"math_inline","text":"i"},{"kind":"text","text":" does not yet exist in the database."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":"). The following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the requests to the system. Each request is a non-empty line, and consists of not more than 32 characters, which are all lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, which are system responses to the requests: "},{"children":[{"kind":"text","text":"OK"}],"kind":"container"},{"kind":"text","text":" in case of successful registration, or a prompt with a new name, if the requested name is already taken."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nabacaba\nacaba\nabacaba\nacab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"OK\nOK\nabacaba1\nOK\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\nfirst\nfirst\nsecond\nsecond\nthird\nthird\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"OK\nfirst1\nOK\nsecond1\nOK\nthird1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"4C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/4/problem/C"}