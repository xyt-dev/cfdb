{"assets":["/statement-assets/78ffde5d152aa7969349876d6a16d70cd66d4ff8cfda47a1a9ed921ed3d7b930.png","/statement-assets/1499add40a0d099d33a313332d09912e02581c3c5f053b124771692ccb65d03c.png"],"contentKind":"statement","contestId":"294","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Shaass and Bookshelf"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Shaass has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" books. He wants to make a bookshelf for all his books. He wants the bookshelf's dimensions to be as small as possible. The thickness of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th book is "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" and its pages' width is equal to "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":". The thickness of each book is either "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". All books have the same page heights."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/78ffde5d152aa7969349876d6a16d70cd66d4ff8cfda47a1a9ed921ed3d7b930.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Shaass puts the books on the bookshelf in the following way. First he selects some of the books and put them vertically. Then he puts the rest of the books horizontally above the vertical books. The sum of the widths of the horizontal books must be no more than the total thickness of the vertical books. A sample arrangement of the books is depicted in the figure."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1499add40a0d099d33a313332d09912e02581c3c5f053b124771692ccb65d03c.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Help Shaass to find the minimum total thickness of the vertical books that we can achieve."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1 ≤ n ≤ 100)"},{"kind":"text","text":". Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" denoting the thickness and width of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th book correspondingly, ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 2, 1 ≤ wi ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the only line of the output print the minimum total thickness of the vertical books that we can achieve."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 12\n1 3\n2 15\n2 5\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 10\n2 1\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"294B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/294/problem/B"}