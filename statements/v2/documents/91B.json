{"assets":[],"contentKind":"statement","contestId":"91","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Queue"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" walruses standing in a queue in an airport. They are numbered starting from the queue's tail: the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st walrus stands at the end of the queue and the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th walrus stands at the beginning of the queue. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th walrus has the age equal to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th walrus becomes displeased if there's a younger walrus standing in front of him, that is, if exists such "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"i < j"},{"kind":"text","text":"), that "},{"kind":"math_inline","text":"ai > aj"},{"kind":"text","text":". The "},{"children":[{"kind":"text","text":"displeasure"}],"kind":"container"},{"kind":"text","text":" of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th walrus is equal to the number of walruses between him and the furthest walrus ahead of him, which is younger than the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th one. That is, the further that young walrus stands from him, the stronger the displeasure is."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The airport manager asked you to count for each of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" walruses in the queue his displeasure."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":") — the number of walruses in the queue. The second line contains integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that some walruses can have the same age but for the displeasure to emerge the walrus that is closer to the head of the queue needs to be "},{"children":[{"kind":"text","text":"strictly younger"}],"kind":"container"},{"kind":"text","text":" than the other one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers: if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th walrus is pleased with everything, print \"-1\" (without the quotes). Otherwise, print the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th walrus's displeasure: the number of other walruses that stand between him and the furthest from him younger walrus."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n10 8 5 3 50 45\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1 0 -1 0 -1 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n10 4 6 3 2 8 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 2 1 0 -1 -1 -1 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n10 3 1 10 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 0 -1 -1 -1 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"91B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/91/problem/B"}