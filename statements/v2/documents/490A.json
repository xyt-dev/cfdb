{"assets":[],"contentKind":"statement","contestId":"490","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Team Olympiad"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The School №0 of the capital of Berland has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" children studying in it. All the children in this school are gifted: some of them are good at programming, some are good at maths, others are good at PE (Physical Education). Hence, for each child we know value "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"ti = 1"},{"kind":"text","text":", if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th child is good at programming, "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ti = 2"},{"kind":"text","text":", if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th child is good at maths, "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ti = 3"},{"kind":"text","text":", if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th child is good at PE "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Each child happens to be good at exactly one of these three subjects."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Team Scientific Decathlon Olympias requires teams of three students. The school teachers decided that the teams will be composed of three children that are good at different subjects. That is, each team must have one mathematician, one programmer and one sportsman. Of course, each child can be a member of no more than one team."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the maximum number of teams that the school will be able to present at the Olympiad? How should the teams be formed for that?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5000"},{"kind":"text","text":") — the number of children in the school. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 3"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" describes the skill of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th child."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line output integer "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" — the largest possible number of teams. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then print "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" lines, containing three numbers in each line. Each triple represents the indexes of the children forming the team. You can print both the teams, and the numbers in the triplets in any order. The children are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in the order of their appearance in the input. Each child must participate in no more than one team. If there are several solutions, print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If no teams can be compiled, print the only line with value "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" equal to 0."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 3 1 3 2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n3 5 2\n6 7 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 1 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"490A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/490/problem/A"}