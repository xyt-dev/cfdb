{"assets":[],"contentKind":"statement","contestId":"20","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. BerOS file system"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The new operating system BerOS has a nice feature. It is possible to use any number of characters "},{"children":[{"kind":"text","text":"'/'"}],"kind":"container"},{"kind":"text","text":" as a delimiter in path instead of one traditional "},{"children":[{"kind":"text","text":"'/'"}],"kind":"container"},{"kind":"text","text":". For example, strings "},{"children":[{"kind":"text","text":"//usr///local//nginx/sbin//"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"/usr/local/nginx///sbin"}],"kind":"container"},{"kind":"text","text":" are equivalent. The character "},{"children":[{"kind":"text","text":"'/'"}],"kind":"container"},{"kind":"text","text":" (or some sequence of such characters) at the end of the path is required only in case of the path to the root directory, which can be represented as single character "},{"children":[{"kind":"text","text":"'/'"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A path called normalized if it contains the smallest possible number of characters "},{"children":[{"kind":"text","text":"'/'"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to transform a given path to the normalized form."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains only lowercase Latin letters and character "},{"children":[{"kind":"text","text":"'/'"}],"kind":"container"},{"kind":"text","text":" — the path to some directory. All paths start with at least one character "},{"children":[{"kind":"text","text":"'/'"}],"kind":"container"},{"kind":"text","text":". The length of the given line is no more than 100 characters, it is not empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The path in normalized form."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"//usr///local//nginx/sbin\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"/usr/local/nginx/sbin\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"20A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/20/problem/A"}