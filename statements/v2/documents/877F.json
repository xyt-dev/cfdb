{"assets":[],"contentKind":"statement","contestId":"877","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Ann and Books"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In Ann's favorite book shop are as many as "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" books on math and economics. Books are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Each of them contains non-negative number of problems."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Today there is a sale: any subsegment of a segment from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" can be bought at a fixed price. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ann decided that she wants to buy such non-empty subsegment that the sale operates on it and the number of math problems is greater than the number of economics problems "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Note that "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" may be positive, negative or zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, Ann is not sure on which segment the sale operates, but she has "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" assumptions. For each of them she wants to know the number of options to buy a subsegment satisfying the condition (because the time she spends on choosing depends on that)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Currently Ann is too busy solving other problems, she asks you for help. For each her assumption determine the number of subsegments of the given segment such that the number of math problems is greaten than the number of economics problems on that subsegment exactly by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":" - 109 ≤ k ≤ 109"},{"kind":"text","text":") — the number of books and the needed difference between the number of math problems and the number of economics problems."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 2"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th book is on math or "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th is on economics."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the number of problems in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th book."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fourth line contains a single integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 100 000"},{"kind":"text","text":") — the number of assumptions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":") describing the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th Ann's assumption."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines, in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them print the number of subsegments for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th Ann's assumption."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n1 1 1 2\n1 1 1 1\n4\n1 2\n1 3\n1 4\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n3\n4\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 0\n1 2 1 2\n0 0 0 0\n1\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Ann can buy subsegments "},{"kind":"math_inline","text":"[1;1], [2;2], [3;3], [2;4]"},{"kind":"text","text":" if they fall into the sales segment, because the number of math problems is greater by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" on them that the number of economics problems. So we should count for each assumption the number of these subsegments that are subsegments of the given segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Segments "},{"kind":"math_inline","text":"[1;1]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"[2;2]"},{"kind":"text","text":" are subsegments of "},{"kind":"math_inline","text":"[1;2]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Segments "},{"kind":"math_inline","text":"[1;1], [2;2]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"[3;3]"},{"kind":"text","text":" are subsegments of "},{"kind":"math_inline","text":"[1;3]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Segments "},{"kind":"math_inline","text":"[1;1], [2;2], [3;3], [2;4]"},{"kind":"text","text":" are subsegments of "},{"kind":"math_inline","text":"[1;4]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Segment "},{"kind":"math_inline","text":"[3;3]"},{"kind":"text","text":" is subsegment of "},{"kind":"math_inline","text":"[3;4]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"877F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/877/problem/F"}