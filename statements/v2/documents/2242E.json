{"assets":[],"contentKind":"statement","contestId":"2242","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Product of Closures"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let the "},{"children":[{"kind":"text","text":"closure"}],"kind":"container"},{"kind":"text","text":" of a positive integer $$$x \\gt 0$$$ be the following infinite binary string $$$C(x)$$$: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Write $$$x$$$ in binary form without leading zeros; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Concatenate the obtained string with itself infinitely many times and call the result $$$C(x)$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, $$$C(1)$$$ $$$=$$$ "},{"children":[{"kind":"text","text":"11111..."}],"kind":"container"},{"kind":"text","text":", $$$C(4)$$$ $$$=$$$ "},{"children":[{"kind":"text","text":"10010010010010..."}],"kind":"container"},{"kind":"text","text":", $$$C(9)$$$ $$$=$$$ "},{"children":[{"kind":"text","text":"100110011001..."}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let the "},{"children":[{"kind":"text","text":"product"}],"kind":"container"},{"kind":"text","text":" of two closures $$$C(x) \\mathop{\\&} C(y)$$$ be the infinite binary string obtained by the "},{"children":[{"kind":"text","text":"bitwise"}],"kind":"container"},{"kind":"text","text":" binary "},{"children":[{"kind":"text","text":"AND"}],"kind":"container"},{"kind":"text","text":" of the strings $$$C(x)$$$ and $$$C(y)$$$. For example, for $$$C(4) \\mathop{\\&} C(9)$$$ we get"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$ \\begin{array}{r} \\begin{array}{r} C(4)\\\\ C(9)\\\\ \\end{array} \\mathop{\\&} \\begin{array}{r} 100100100100100100...\\\\ 100110011001100110...\\\\ \\end{array} \\\\ \\hline \\begin{array}{r} 100100000000100100... \\end{array} \\end{array} $$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given three integers $$$l$$$, $$$r$$$, and $$$n$$$. Among all numbers in the segment $$$[l, r]$$$, find two integers $$$x$$$ and $$$y$$$ ($$$l \\le x \\lt y \\le r$$$) such that $$$C(x) \\mathop{\\&} C(y)$$$ is "},{"children":[{"kind":"text","text":"lexicographically smallest"}],"kind":"container"},{"kind":"text","text":", and print the first $$$n$$$ binary symbols of this product. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains three integers $$$l$$$, $$$r$$$, and $$$n$$$ ($$$1 \\le l \\lt r \\lt 2^{30}$$$; $$$1 \\le n \\le 1000$$$) — the range of possible values and the length of the answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one binary string of length $$$n$$$ — the first $$$n$$$ symbols of the lexicographically smallest product of closures."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],