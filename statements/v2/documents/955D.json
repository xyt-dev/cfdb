{"assets":[],"contentKind":"statement","contestId":"955","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Scissors"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Jenya has recently acquired quite a useful tool — "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-scissors for cutting strings. They are generally used for cutting out two non-intersecting substrings of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" from an arbitrary string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" (its length should be at least "},{"kind":"math_inline","text":"2·k"},{"kind":"text","text":" in order to perform this operation) and concatenating them afterwards (preserving the initial order). For example, with the help of "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-scissors you can cut "},{"kind":"math_inline","text":"ab"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"de"},{"kind":"text","text":" out of "},{"kind":"math_inline","text":"abcde"},{"kind":"text","text":" and concatenate them into "},{"kind":"math_inline","text":"abde"},{"kind":"text","text":", but not "},{"kind":"math_inline","text":"ab"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bc"},{"kind":"text","text":" since they're intersecting."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's a nice idea to test this tool before using it in practice. After looking through the papers, Jenya came up with two strings "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". His question is whether it is possible to apply his scissors to string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" such that the resulting concatenation contains "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" as a substring?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(2 ≤ m ≤ 2·k ≤ n ≤ 5·105)"},{"kind":"text","text":" — length of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", length of "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" and the aforementioned scissors' parameter correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next two lines feature "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" consisting of lowercase latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no answer, print «"},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"». "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print «"},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"» and two integers "},{"kind":"math_inline","text":"L"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"R"},{"kind":"text","text":" denoting the indexes where cutted substrings start ("},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-indexed). If there are several possible answers, output any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 4 3\nbaabaab\naaaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n1 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3 2\ncbcbcb\nbcc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n2 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 5 3\naabbaaa\naaaaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case you can cut out two substrings starting at "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". The resulting string "},{"children":[{"kind":"text","text":"baaaab"}],"kind":"container"},{"kind":"text","text":" contains "},{"children":[{"kind":"text","text":"aaaa"}],"kind":"container"},{"kind":"text","text":" as a substring."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample case the resulting string is "},{"children":[{"kind":"text","text":"bccb"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"955D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/955/problem/D"}