{"assets":[],"contentKind":"statement","contestId":"598","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Chocolate Bar"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a rectangular chocolate bar consisting of "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" single squares. You want to eat "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"math_inline","text":"k"},{"kind":"text","text":" squares, so you may need to break the chocolate bar. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one move you can break any single rectangular piece of chocolate in two rectangular pieces. You can break only by lines between squares: horizontally or vertically. The cost of breaking is equal to square of the break length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if you have a chocolate bar consisting of "},{"kind":"math_inline","text":"2 × 3"},{"kind":"text","text":" unit squares then you can break it horizontally and get two "},{"kind":"math_inline","text":"1 × 3"},{"kind":"text","text":" pieces (the cost of such breaking is "},{"kind":"math_inline","text":"32 = 9"},{"kind":"text","text":"), or you can break it vertically in two ways and get two pieces: "},{"kind":"math_inline","text":"2 × 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2 × 2"},{"kind":"text","text":" (the cost of such breaking is "},{"kind":"math_inline","text":"22 = 4"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For several given values "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" find the minimum total cost of breaking. You can eat exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" squares of chocolate if after all operations of breaking there is a set of rectangular pieces of chocolate with the total size equal to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" squares. The remaining "},{"kind":"math_inline","text":"n·m - k"},{"kind":"text","text":" squares are not necessarily form a single rectangular piece."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 40910"},{"kind":"text","text":") — the number of values "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" to process."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 30, 1 ≤ k ≤ min(n·m, 50)"},{"kind":"text","text":") — the dimensions of the chocolate bar and the number of squares you want to eat respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" print the minimum total cost needed to break the chocolate bar, in order to make it possible to eat exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" squares."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 2 1\n2 2 3\n2 2 2\n2 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n5\n4\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first query of the sample one needs to perform two breaks:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" to split "},{"kind":"math_inline","text":"2 × 2"},{"kind":"text","text":" bar into two pieces of "},{"kind":"math_inline","text":"2 × 1"},{"kind":"text","text":" (cost is "},{"kind":"math_inline","text":"22 = 4"},{"kind":"text","text":"), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" to split the resulting "},{"kind":"math_inline","text":"2 × 1"},{"kind":"text","text":" into two "},{"kind":"math_inline","text":"1 × 1"},{"kind":"text","text":" pieces (cost is "},{"kind":"math_inline","text":"12 = 1"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second query of the sample one wants to eat "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" unit squares. One can use exactly the same strategy as in the first query of the sample."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"598E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/598/problem/E"}