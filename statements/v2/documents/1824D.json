{"assets":[],"contentKind":"statement","contestId":"1824","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. LuoTianyi and the Function"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"7 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"LuoTianyi gives you an array $$$a$$$ of $$$n$$$ integers and the index begins from $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Define $$$g(i,j)$$$ as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$g(i,j)$$$ is the largest integer $$$x$$$ that satisfies $$$\\{a_p:i\\le p\\le j\\}\\subseteq\\{a_q:x\\le q\\le j\\}$$$ while $$$i \\le j$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" and $$$g(i,j)=0$$$ while $$$i \\gt j$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"There are $$$q$$$ queries. For each query you are given four integers $$$l,r,x,y$$$, you need to calculate $$$\\sum\\limits_{i=l}^{r}\\sum\\limits_{j=x}^{y}g(i,j)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$q$$$ ($$$1\\le n,q\\le 10^6$$$) — the length of the array $$$a$$$ and the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1,a_2,\\ldots,a_n$$$ ($$$1\\le a_i\\le n$$$) — the elements of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$q$$$ lines describe a query. The $$$i$$$-th line contains four integers $$$l,r,x,y$$$ ($$$1\\le l\\le r\\le n, 1\\le x\\le y\\le n$$$) — the integers in the $$$i$$$-th query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$q$$$ lines where $$$i$$$-th line contains one integer — the answer for the $$$i$$$-th query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6 4\n1 2 2 1 3 4\n1 1 4 5\n2 3 3 3\n3 6 1 2\n6 6 6 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n6\n0\n6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10 5\n10 2 8 10 9 8 2 1 1 8\n1 1 10 10\n2 2 3 3\n6 6 6 6\n1 1 4 5\n4 8 4 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n2\n6\n4\n80\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first query, the answer is $$$g(1,4)+g(1,5)=3+3=6$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$x=1,2,3$$$ can satisfies $$$\\{a_p:1\\le p\\le 4\\}\\subseteq\\{a_q:x\\le q\\le 4\\}$$$, $$$3$$$ is the largest integer so $$$g(1,4)=3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second query, the answer is $$$g(2,3)+g(3,3)=3+3=6$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third query, the answer is $$$0$$$, because all $$$i \\gt j$$$ and $$$g(i,j)=0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth query, the answer is $$$g(6,6)=6$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second query, the answer is $$$g(2,3)=2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth query, the answer is $$$g(1,4)+g(1,5)=2+2=4$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1824D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1824/problem/D"}