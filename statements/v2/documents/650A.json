{"assets":["/statement-assets/3af6eb275370546e3446886b61d8ffcdd8f585997c935f1b4112a9e5b6bfba48.png","/statement-assets/15e36de783137a07750f72d6c2742caacd1551c9e1cb24ba790d13c8af1f2424.png"],"contentKind":"statement","contestId":"650","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Watchmen"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Watchmen are in a danger and Doctor Manhattan together with his friend Daniel Dreiberg should warn them as soon as possible. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" watchmen on a plane, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th watchman is located at point "},{"kind":"math_inline","text":"(xi, yi)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"They need to arrange a plan, but there are some difficulties on their way. As you know, Doctor Manhattan considers the distance between watchmen "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" to be "},{"kind":"math_inline","text":"|xi - xj| + |yi - yj|"},{"kind":"text","text":". Daniel, as an ordinary person, calculates the distance using the formula "},{"attrs":{"alt":"","src":"/statement-assets/3af6eb275370546e3446886b61d8ffcdd8f585997c935f1b4112a9e5b6bfba48.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The success of the operation relies on the number of pairs "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i < j ≤ n"},{"kind":"text","text":"), such that the distance between watchman "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and watchmen "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" calculated by Doctor Manhattan is equal to the distance between them calculated by Daniel. You were asked to compute the number of such pairs."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains the single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000"},{"kind":"text","text":") — the number of watchmen."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|xi|, |yi| ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some positions may coincide."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of pairs of watchmen such that the distance between them calculated by Doctor Manhattan is equal to the distance calculated by Daniel."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1\n7 5\n1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n0 0\n0 1\n0 2\n-1 1\n0 1\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the distance between watchman "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and watchman "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"|1 - 7| + |1 - 5| = 10"},{"kind":"text","text":" for Doctor Manhattan and "},{"attrs":{"alt":"","src":"/statement-assets/15e36de783137a07750f72d6c2742caacd1551c9e1cb24ba790d13c8af1f2424.png"},"kind":"image"},{"kind":"text","text":" for Daniel. For pairs "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 5)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(7, 5)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 5)"},{"kind":"text","text":" Doctor Manhattan and Daniel will calculate the same distances."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"650A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/650/problem/A"}