{"assets":["/statement-assets/b337a913a919f1e79e133f09f761cf6581189da0718aa17ebead3007f27c4714.png"],"contentKind":"statement","contestId":"763","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Timofey and rectangles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One of Timofey's birthday presents is a colourbook in a shape of an infinite plane. On the plane "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rectangles with sides parallel to coordinate axes are situated. All sides of the rectangles have "},{"children":[{"kind":"text","text":"odd"}],"kind":"container"},{"kind":"text","text":" length. Rectangles cannot intersect, but they can touch each other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Timofey to color his rectangles in "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" different colors in such a way that every two rectangles touching each other by side would have different color, or determine that it is impossible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two rectangles intersect if their intersection has positive area. Two rectangles touch by sides if there is a pair of sides such that their intersection has non-zero length"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b337a913a919f1e79e133f09f761cf6581189da0718aa17ebead3007f27c4714.png"},"kind":"image"},{"children":[{"kind":"text","text":"The picture corresponds to the first example"}],"kind":"container"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5·105"},{"kind":"text","text":") — the number of rectangles."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains four integers "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ x1 < x2 ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":" - 109 ≤ y1 < y2 ≤ 109"},{"kind":"text","text":"), that means that points "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":" are the coordinates of two opposite corners of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th rectangle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed, that all sides of the rectangles have "},{"children":[{"kind":"text","text":"odd"}],"kind":"container"},{"kind":"text","text":" lengths and rectangles don't intersect each other."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" in the only line if it is impossible to color the rectangles in "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" different colors in such a way that every two rectangles touching each other by side would have different color."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" in the first line. Then print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them print single integer "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci ≤ 4"},{"kind":"text","text":") — the color of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th rectangle."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n0 0 5 3\n2 -1 5 0\n-3 -4 2 -1\n-1 -1 2 0\n-3 0 0 5\n5 2 10 3\n7 -3 10 2\n4 -2 7 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1\n2\n2\n3\n2\n2\n4\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"763B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/763/problem/B"}