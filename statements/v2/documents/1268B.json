{"assets":["/statement-assets/97994883341ba279030e6f1e7718e156983ed29a43e627db2dd1d60b50a28989.png","/statement-assets/ec997c27d8b5e2eeca0ddbfb05af130078afb1bcf1a152520e5a05e839852b62.png","/statement-assets/b911b6fc38603630b83322b2781bed009b1085605aa3f29f3fc1389fc08c4ec3.png"],"contentKind":"statement","contestId":"1268","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Domino for Young"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a Young diagram. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given diagram is a histogram with $$$n$$$ columns of lengths $$$a_1, a_2, \\ldots, a_n$$$ ($$$a_1 \\geq a_2 \\geq \\ldots \\geq a_n \\geq 1$$$)."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/97994883341ba279030e6f1e7718e156983ed29a43e627db2dd1d60b50a28989.png"},"kind":"image"},{"children":[{"kind":"text","text":"Young diagram for $$$a=[3,2,2,2,1]$$$."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Your goal is to find the largest number of non-overlapping dominos that you can draw inside of this histogram, a domino is a $$$1 \\times 2$$$ or $$$2 \\times 1$$$ rectangle."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contain one integer $$$n$$$ ($$$1 \\leq n \\leq 300\\,000$$$): the number of columns in the given histogram."}],"kin