{"assets":[],"contentKind":"statement","contestId":"678","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Lena and Queries"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Lena is a programmer. She got a task to solve at work."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is an empty set of pairs of integers and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" queries to process. Each query is one of three types:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Add a pair "},{"kind":"math_inline","text":"(a, b)"},{"kind":"text","text":" to the set. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Remove a pair added in the query number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". All queries are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For a given integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" find the maximal value "},{"kind":"math_inline","text":"x·q + y"},{"kind":"text","text":" over all pairs "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" from the set. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Lena to process the queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 3·105"},{"kind":"text","text":") — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines starts with integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 3"},{"kind":"text","text":") — the type of the query."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A pair of integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ a, b ≤ 109"},{"kind":"text","text":") follows in the query of the first type."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An integer "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") follows in the query of the second type. It is guaranteed that "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is less than the number of the query, the query number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has the first type and the pair from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query is not already removed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ q ≤ 109"},{"kind":"text","text":") follows in the query of the third type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the queries of 