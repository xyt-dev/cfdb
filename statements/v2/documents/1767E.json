{"assets":[],"contentKind":"statement","contestId":"1767","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Algebra Flash"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"children":[{"kind":"text","text":"Algebra Flash 2.2 has just been released!"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"Changelog:"}],"kind":"container"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" New gamemode! "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"Thank you for the continued support of the game!"}],"kind":"container"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Huh, is that it? Slightly disappointed, you boot up the game and click on the new gamemode. It says \""},{"children":[{"kind":"text","text":"Colored platforms"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are $$$n$$$ platforms, numbered from $$$1$$$ to $$$n$$$, placed one after another. There are $$$m$$$ colors available in the game, numbered from $$$1$$$ to $$$m$$$. The $$$i$$$-th platform is colored $$$c_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You start on the platform $$$1$$$ and want to reach platform $$$n$$$. In one move, you can jump from some platform $$$i$$$ to platforms $$$i + 1$$$ or $$$i + 2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All platforms are initially deactivated (including platforms $$$1$$$ and $$$n$$$). For each color $$$j$$$, you can pay $$$x_j$$$ coins to activate all platforms of that color."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You want to activate some platforms so that you could start on an activated platform $$$1$$$, jump through some activated platforms and reach an activated platform $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What's the smallest amount of coins you can spend to achieve that?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$m$$$ ($$$2 \\le n \\le 3 \\cdot 10^5$$$; $$$1 \\le m \\le 40$$$) — the number of platforms and the number of colors, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$c_1, c_2, \\dots, c_n$$$ ($$$1 \\le c_i \\le m$$$) — the colors of the platforms."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains $$$m$$$ integers $$$x_1, x_2, \\dots, x_m$$$ ($$$1 \\le x_i \\le 10^7$$$) — the cost of activating all platforms of each color."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the smallest amount of coins you can spend to activate some platforms so that you could start on an activated platform $$$1$$$, jump through some activated platforms and reach an activated platform $$$n$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_in