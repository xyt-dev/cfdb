{"assets":[],"contentKind":"statement","contestId":"883","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Automatic Door"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is an automatic door at the entrance of a factory. The door works in the following way:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" when one or several people come to the door and it is closed, the door immediately opens automatically and all people immediately come inside, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" when one or several people come to the door and it is open, all people immediately come inside, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" opened door immediately closes in "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" seconds after its opening, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if the door is closing and one or several people are coming to the door at the same moment, then all of them will have enough time to enter and only after that the door will close. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, if "},{"kind":"math_inline","text":"d = 3"},{"kind":"text","text":" and four people are coming at four different moments of time "},{"kind":"math_inline","text":"t1 = 4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t2 = 7"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t3 = 9"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t4 = 13"},{"kind":"text","text":" then the door will open three times: at moments "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"13"},{"kind":"text","text":". It will close at moments "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"12"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is known that "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" employees will enter at moments "},{"kind":"math_inline","text":"a, 2·a, 3·a, ..., n·a"},{"kind":"text","text":" (the value "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is positive integer). Also "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" clients will enter at moments "},{"kind":"math_inline","text":"t1, t2, ..., tm"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Write program to find the number of times the automatic door will open. Assume that the door is initially closed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, a ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ d ≤ 1018"},{"kind":"text","text":") — the number of the employees, the number of the clients, the moment of time when the first employee will come and the period of time in which the door closes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains integer sequence "},{"kind":"math_inline","text":"t1, t2, ..., tm"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 1018"},{"kind":"text","text":") — moments of time when clients will come. The values "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" are given in non-decreasing order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of times the door will open."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 3 4\n7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 4 2\n7 9 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the only employee will come at moment "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". At this moment the door will open and will stay open until the moment "},{"kind":"math_inline","text":"7"},{"kind":"text","text":". At the same moment of time the client will come, so at first he will enter and only after it the door will close. Thus the door will open one time."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"883A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/883/problem/A"}