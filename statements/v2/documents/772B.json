{"assets":["/statement-assets/af572790d886b5de9e6a69678560f5b9ffb802b8d91d49716b2f7199c5afce2c.png","/statement-assets/177de1f243aeb90241a9a5015516a94364fa99d27f097ee23cc681a3b0e5b191.png","/statement-assets/d11d6706676ab8aa53107c1d72799ead5bd67bec03bccb6e33d578a5d2d18e5f.png"],"contentKind":"statement","contestId":"772","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Volatile Kite"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a convex polygon "},{"kind":"math_inline","text":"P"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct vertices "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":". Vertex "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" has coordinates "},{"kind":"math_inline","text":"(xi, yi)"},{"kind":"text","text":" in the 2D plane. These vertices are listed in clockwise order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can choose a real number "},{"kind":"math_inline","text":"D"},{"kind":"text","text":" and move each vertex of the polygon a distance of at most "},{"kind":"math_inline","text":"D"},{"kind":"text","text":" from their original positions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the maximum value of "},{"kind":"math_inline","text":"D"},{"kind":"text","text":" such that no matter how you move the vertices, the polygon does not intersect itself and stays convex."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line has one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"4 ≤ n ≤ 1 000"},{"kind":"text","text":") — the number of vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the coordinates of the vertices. Line "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ xi, yi ≤ 109"},{"kind":"text","text":") — the coordinates of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex. These points are guaranteed to be given in clockwise order, and will form a strictly convex polygon (in particular, no three consecutive points lie on the same straight line)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one real number "},{"kind":"math_inline","text":"D"},{"kind":"text","text":", which is the maximum real number such that no matter how you move the vertices, the polygon stays convex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your answer will be considered correct if its absolute or relative error does not exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Namely, let's assume that your answer is "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and the answer of the jury is "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The checker program will consider your answer correct if "},{"attrs":{"alt":"","src":"/statement-assets/af572790d886b5de9e6a69678560f5b9ffb802b8d91d49716b2f7199c5afce2c.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 0\n0 1\n1 1\n1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.3535533906\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n5 0\n10 0\n12 -4\n10 -8\n5 -8\n3 -4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.0000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here is a picture of the first sample"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/177de1f243aeb90241a9a5015516a94364fa99d27f097ee23cc681a3b0e5b191.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here is an example of making the polygon non-convex."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d11d6706676ab8aa53107c1d72799ead5bd67bec03bccb6e33d578a5d2d18e5f.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This is not an optimal solution, since the maximum distance we moved one point is "},{"kind":"math_inline","text":" ≈ 0.4242640687"},{"kind":"text","text":", whereas we can make it non-convex by only moving each point a distance of at most "},{"kind":"math_inline","text":" ≈ 0.3535533906"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"772B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/772/problem/B"}