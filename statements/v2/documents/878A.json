{"assets":[],"contentKind":"statement","contestId":"878","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Short Program"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya learned a new programming language CALPAS. A program in this language always takes one non-negative integer and returns one non-negative integer as well."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the language, there are only three commands: apply a bitwise operation AND, OR or XOR with a given constant to the current integer. A program can contain an arbitrary sequence of these operations with arbitrary constants from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"1023"},{"kind":"text","text":". When the program is run, all operations are applied (in the given order) to the argument and in the end the result integer is returned."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya wrote a program in this language, but it turned out to be too long. Write a program in CALPAS that does the same thing as the Petya's program, and consists of no more than "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" lines. Your program should return the same integer as Petya's program for all arguments from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"1023"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5·105"},{"kind":"text","text":") — the number of lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain commands. A command consists of a character that represents the operation (\""},{"children":[{"kind":"text","text":"&"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"|"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":"\" for AND, OR or XOR respectively), and the constant "},{"kind":"math_inline","text":"xi"},{"kind":"math_inline","text":"0 ≤ xi ≤ 1023"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output an integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ k ≤ 5"},{"kind":"text","text":") — the length of your program."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines must contain commands in the same format as in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n| 3\n^ 2\n| 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n| 3\n^ 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n& 1\n& 3\n& 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n& 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n^ 1\n^ 2\n^ 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"You can read about bitwise operations in "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Bitwise_operation"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second sample:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" be an input of the Petya's program. It's output is "},{"kind":"math_inline","text":"((x&1)&3)&5 = x&(1&3&5) = x&1"},{"kind":"text","text":". So these two programs always give the same outputs."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"878A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/878/problem/A"}