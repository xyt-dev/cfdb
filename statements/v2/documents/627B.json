{"assets":[],"contentKind":"statement","contestId":"627","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Factory Repairs"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A factory produces thimbles in bulk. Typically, it can produce up to "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" thimbles a day. However, some of the machinery is defective, so it can currently only produce "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" thimbles each day. The factory intends to choose a "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-day period to do maintenance and construction; it cannot produce any thimbles during this time, but will be restored to its full production of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" thimbles per day after the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" days are complete."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially, no orders are pending. The factory receives updates of the form "},{"kind":"math_inline","text":"di"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", indicating that "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" new orders have been placed for the "},{"kind":"math_inline","text":"di"},{"kind":"text","text":"-th day. Each order requires a single thimble to be produced on precisely the specified day. The factory may opt to fill as many or as few of the orders in a single batch as it likes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As orders come in, the factory owner would like to know the maximum number of orders he will be able to fill if he starts repairs on a given day "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":". Help the owner answer his questions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains five integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 200 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ b < a ≤ 10 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ q ≤ 200 000"},{"kind":"text","text":") — the number of days, the length of the repair time, the production rates of the factory, and the number of updates, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain the descriptions of the queries. Each query is of one of the following two forms: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1 di ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ di ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ai ≤ 10 000"},{"kind":"text","text":"), representing an update of "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" orders on day "},{"kind":"math_inline","text":"di"},{"kind":"text","text":", or "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2 pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n - k + 1"},{"kind":"text","text":"), representing a question: at the moment, how many orders could be filled if the factory decided to commence repairs on day "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":"? "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It's guaranteed that the input will contain at least one query of the second type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the second type, print a line containing a single integer — the maximum number of orders that the factory can fill over all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 2 1 8\n1 1 2\n1 5 3\n1 2 1\n2 2\n1 4 2\n1 3 2\n2 1\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n6\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4 10 1 6\n1 1 5\n1 5 5\n1 3 2\n1 5 2\n2 1\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first sample."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We produce up to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" thimble a day currently and will produce up to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" thimbles a day after repairs. Repairs take "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" days."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the first question, we are able to fill "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" order on day "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", no orders on days "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" since we are repairing, no orders on day "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" since no thimbles have been ordered for that day, and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" orders for day "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" since we are limited to our production capacity, for a total of "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" orders filled."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the third question, we are able to fill "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" order on day "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" order on day "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" orders on day "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", for a total of "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" orders."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"627B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/627/problem/B"}