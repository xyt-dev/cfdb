{"assets":["/statement-assets/f697eedae849c9d94ab6d7c18cf98e1348451e194df138a64260af7ba9437138.png","/statement-assets/9007577e00bc158119ce3499923948cef03096ce842418fa6e59ef8a3fbf4681.png"],"contentKind":"statement","contestId":"509","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Restoring Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya had two arrays consisting of non-negative integers: "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Vasya chose a positive integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and created an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" matrix "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" using the following formula:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f697eedae849c9d94ab6d7c18cf98e1348451e194df138a64260af7ba9437138.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Vasya wrote down matrix "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" on a piece of paper and put it in the table."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A year later Vasya was cleaning his table when he found a piece of paper containing an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" matrix "},{"kind":"math_inline","text":"w"},{"kind":"text","text":". He remembered making a matrix one day by the rules given above but he was not sure if he had found the paper with the matrix "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" from those days. Your task is to find out if the matrix "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" that you've found could have been obtained by following these rules and if it could, then for what numbers "},{"kind":"math_inline","text":"k, a1, a2, ..., an, b1, b2, ..., bm"},{"kind":"text","text":" it is possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100"},{"kind":"text","text":"), separated by a space — the number of rows and columns in the found matrix, respectively. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the following lines contains numbers "},{"kind":"math_inline","text":"wi, 1, wi, 2, ..., wi, m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ wi, j ≤ 109"},{"kind":"text","text":"), separated by spaces — the elements of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row of matrix "},{"kind":"math_inline","text":"w"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the matrix "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" could not have been obtained in the manner described above, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in the single line of output."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print four lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first line print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print an integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 1018"},{"kind":"text","text":"). Note that each element of table "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" should be in range between "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k - 1"},{"kind":"text","text":" inclusively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 1018"},{"kind":"text","text":"), separated by spaces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth line print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"b1, b2, ..., bm"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ bi ≤ 1018"},{"kind":"text","text":"), separated by spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n1 2 3\n2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1000000007\n0 1 \n1 2 3 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n1 2\n2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n3\n0 1 \n1 2 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n1 2\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"By "},{"attrs":{"alt":"","src":"/statement-assets/9007577e00bc158119ce3499923948cef03096ce842418fa6e59ef8a3fbf4681.png"},"kind":"image"},{"kind":"text","text":" we denote the remainder of integer division of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"c"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that if there exists some set of numbers "},{"kind":"math_inline","text":"k, a1, ..., an, b1, ..., bm"},{"kind":"text","text":", that you could use to make matrix "},{"kind":"math_inline","text":"w"},{"kind":"text","text":", then there also exists a set of numbers that meets the limits "},{"kind":"math_inline","text":"1 ≤ k ≤ 1018"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ai ≤ 1018"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ bi ≤ 1018"},{"kind":"text","text":" in the output format. In other words, these upper bounds are introduced only for checking convenience purposes."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"509D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/509/problem/D"}