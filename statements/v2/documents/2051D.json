{"assets":[],"contentKind":"statement","contestId":"2051","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Counting Pairs"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a sequence $$$a$$$, consisting of $$$n$$$ integers, where the $$$i$$$-th element of the sequence is equal to $$$a_i$$$. You are also given two integers $$$x$$$ and $$$y$$$ ($$$x \\le y$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A pair of integers $$$(i, j)$$$ is considered "},{"children":[{"kind":"text","text":"interesting"}],"kind":"container"},{"kind":"text","text":" if the following conditions are met:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1 \\le i \\lt j \\le n$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if you simultaneously remove the elements at positions $$$i$$$ and $$$j$$$ from the sequence $$$a$$$, the sum of the remaining elements is at least $$$x$$$ and at most $$$y$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is to determine the number of "},{"children":[{"kind":"text","text":"interesting"}],"kind":"container"},{"kind":"text","text":" pairs of integers for the given sequence $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two lines:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The first line contains three integers $$$n, x, y$$$ ($$$3 \\le n \\le 2 \\cdot 10^5$$$, $$$1 \\le x \\le y \\le 2 \\cdot 10^{14}$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The second line contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^{9}$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Additional constraint on the input: the sum of $$$n$$$ across all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output one integer — the number of "},{"children":[{"kind":"text","text":"interesting"}],"kind":"container"},{"kind":"text","text":" pairs of integers for the given sequence $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n4 8 10\n4 6 3 6\n6 22 27\n4 9 6 3 4 5\n3 8 10\n3 2 1\n3 1 1\n2 3 4\n3 3 6\n3 2 1\n4 4 12\n3 3 2 1\n6 8 8\n1 1 2 2 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n7\n0\n0\n1\n5\n6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, there are $$$4$$$ "},{"children":[{"kind":"text","text":"interesting"}],"kind":"container"},{"kind":"text","text":" pairs of integers:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" $$$(1, 2)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(1, 4)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(2, 3)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(3, 4)$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"2051D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2051/problem/D"}