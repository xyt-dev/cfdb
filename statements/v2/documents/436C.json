{"assets":["/statement-assets/e3a57fe0b8533e86426d115cb60e19de88ebb63cfc5213c87289da928f9d35c2.png"],"contentKind":"statement","contestId":"436","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Dungeons and Candies"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"During the loading of the game \"Dungeons and Candies\" you are required to get descriptions of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" levels from the server. Each description is a map of an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" checkered rectangular field. Some cells of the field contain candies (each cell has at most one candy). An empty cell is denoted as \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" on the map, but if a cell has a candy, it is denoted as a letter of the English alphabet. A level may contain identical candies, in this case the letters in the corresponding cells of the map will be the same."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e3a57fe0b8533e86426d115cb60e19de88ebb63cfc5213c87289da928f9d35c2.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"When you transmit information via a network, you want to minimize traffic — the total size of the transferred data. The levels can be transmitted in any order. There are two ways to transmit the current level "},{"kind":"math_inline","text":"A"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" You can transmit the whole level "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". Then you need to transmit "},{"kind":"math_inline","text":"n·m"},{"kind":"text","text":" bytes via the network. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" You can transmit the difference between level "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and some previously transmitted level "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" (if it exists); this operation requires to transmit "},{"kind":"math_inline","text":"dA, B·w"},{"kind":"text","text":" bytes, where "},{"kind":"math_inline","text":"dA, B"},{"kind":"text","text":" is the number of cells of the field that are different for "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" is a constant. Note, that you should compare only the corresponding cells of levels "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" to calculate "},{"kind":"math_inline","text":"dA, B"},{"kind":"text","text":". You cannot transform the maps of levels, i.e. rotate or shift them relatively to each other. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is to find a way to transfer all the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" levels and minimize the traffic."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four integers "},{"kind":"math_inline","text":"n, m, k, w"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 10; 1 ≤ k, w ≤ 1000)"},{"kind":"text","text":". Then follows the description of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" levels. Each level is described by "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters. Each character is either a letter of the English alphabet or a dot (\""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\"). Please note that the case of the letters matters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the required minimum number of transferred bytes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" pairs of integers "},{"kind":"math_inline","text":"x1, y1, x2, y2, ..., xk, yk"},{"kind":"text","text":", describing the way to transfer levels. Pair "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" means that level "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" needs to be transferred by way "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":". If "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" equals 0, that means that the level must be transferred using the first way, otherwise "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" must be equal to the number of a previously transferred level. It means that you will transfer the difference between levels "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" to transfer level "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". Print the pairs in the order of transferring levels. The levels are numbered 1 through "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" in the order they follow in the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple optimal solutions, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 3 2\nA.A\n...\nA.a\n..C\nX.Y\n...\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n1 0\n2 1\n3 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 4 1\nA\n.\nB\n.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 0\n2 0\n4 2\n3 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 3 5 2\nABA\nBBB\nBBA\nBAB\nABB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n1 0\n3 1\n2 3\n4 2\n5 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"436C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/436/problem/C"}