{"assets":["/statement-assets/08d0da3c2d8ba99c46e41ba0450982fdc9a753742c7ce3d65721cd4ad07b748e.png"],"contentKind":"statement","contestId":"643","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Bear and Colors"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bear Limak has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" colored balls, arranged in one long row. Balls are numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", from left to right. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" possible colors, also numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ball has color "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a fixed interval (set of consecutive elements) of balls we can define a "},{"children":[{"kind":"text","text":"dominant"}],"kind":"container"},{"kind":"text","text":" color. It's a color occurring the biggest number of times in the interval. In case of a tie between some colors, the one with the smallest number (index) is chosen as dominant."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"attrs":{"alt":"","src":"/statement-assets/08d0da3c2d8ba99c46e41ba0450982fdc9a753742c7ce3d65721cd4ad07b748e.png"},"kind":"image"},{"kind":"text","text":" non-empty intervals in total. For each color, your task is to count the number of intervals in which this color is dominant."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5000"},{"kind":"text","text":") — the number of balls."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ n"},{"kind":"text","text":") where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" is the color of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ball."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should be equal to the number of intervals where "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is a dominant color."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7 3 0 0 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6 0 0 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, color "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" is dominant in three intervals:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" An interval "},{"kind":"math_inline","text":"[2, 2]"},{"kind":"text","text":" contains one ball. This ball's color is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" so it's clearly a dominant color. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" An interval "},{"kind":"math_inline","text":"[4, 4]"},{"kind":"text","text":" contains one ball, with color "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" again. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" An interval "},{"kind":"math_inline","text":"[2, 4]"},{"kind":"text","text":" contains two balls of color "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and one ball of color "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" more intervals and color "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is dominant in all of them."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"643A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/643/problem/A"}