{"assets":["/statement-assets/1449d9eaee1c390bfd59a7bb25578bc787072680f4a735cd800e08ba87040192.png"],"contentKind":"statement","contestId":"185","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Mushroom Scientists"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As you very well know, the whole Universe traditionally uses three-dimensional Cartesian system of coordinates. In this system each point corresponds to three real coordinates "},{"kind":"math_inline","text":"(x, y, z)"},{"kind":"text","text":". In this coordinate system, the distance between the center of the Universe and the point is calculated by the following formula: "},{"attrs":{"alt":"","src":"/statement-assets/1449d9eaee1c390bfd59a7bb25578bc787072680f4a735cd800e08ba87040192.png"},"kind":"image"},{"kind":"text","text":". Mushroom scientists that work for the Great Mushroom King think that the Universe isn't exactly right and the distance from the center of the Universe to a point equals "},{"kind":"math_inline","text":"xa·yb·zc"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To test the metric of mushroom scientists, the usual scientists offered them a task: find such "},{"kind":"math_inline","text":"x, y, z"},{"kind":"math_inline","text":"(0 ≤ x, y, z; x + y + z ≤ S)"},{"kind":"text","text":", that the distance between the center of the Universe and the point "},{"kind":"math_inline","text":"(x, y, z)"},{"kind":"text","text":" is maximum possible in the metric of mushroom scientists. The mushroom scientists aren't good at maths, so they commissioned you to do the task."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that in this problem, it is considered that "},{"kind":"math_inline","text":"00 = 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"S"},{"kind":"math_inline","text":"(1 ≤ S ≤ 103)"},{"kind":"text","text":" — the maximum sum of coordinates of the sought point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains three space-separated integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"math_inline","text":"(0 ≤ a, b, c ≤ 103)"},{"kind":"text","text":" — the numbers that describe the metric of mushroom scientists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print three real numbers — the coordinates of the point that reaches maximum value in the metrics of mushroom scientists. If there are multiple answers, print any of them that meets the limitations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A natural logarithm of distance from the center of the Universe to the given point in the metric of mushroom scientists shouldn't differ from the natural logarithm of the maximum distance by more than "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":". We think that "},{"kind":"math_inline","text":"ln(0) =  - ∞"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.0 1.0 1.0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3.0 0.0 0.0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"185B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/185/problem/B"}