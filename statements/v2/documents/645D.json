{"assets":["/statement-assets/f9f448351e828931d494d1061bdd76b18c8262e8a10ab44143413809ba0366c2.png"],"contentKind":"statement","contestId":"645","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Robot Rapping Results Report"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"While Farmer John rebuilds his farm in an unfamiliar portion of Bovinia, Bessie is out trying some alternative jobs. In her new gig as a reporter, Bessie needs to know about programming competition results as quickly as possible. When she covers the 2016 Robot Rap Battle Tournament, she notices that all of the robots operate under deterministic algorithms. In particular, robot "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" will beat robot "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" if and only if robot "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has a higher skill level than robot "},{"kind":"math_inline","text":"j"},{"kind":"text","text":". And if robot "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" beats robot "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" and robot "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" beats robot "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", then robot "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" will beat robot "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Since rapping is such a subtle art, two robots can never have the same skill level."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the results of the rap battles in the order in which they were played, determine the "},{"children":[{"kind":"text","text":"minimum number"}],"kind":"container"},{"kind":"text","text":" of first rap battles that needed to take place before Bessie could order all of the robots by skill level."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input consists of two integers, the number of robots "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100 000"},{"kind":"text","text":") and the number of rap battles "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/f9f448351e828931d494d1061bdd76b18c8262e8a10ab44143413809ba0366c2.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines describe the results of the rap battles in the order they took place. Each consists of two integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ui ≠ vi"},{"kind":"text","text":"), indicating that robot "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" beat robot "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th rap battle. No two rap battles involve the same pair of robots."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that at least one ordering of the robots satisfies all "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" relations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" such that the ordering of the robots by skill level is uniquely defined by the first "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" rap battles. If there exists more than one ordering that satisfies all "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" relations, output "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n2 1\n1 3\n2 3\n4 2\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 2\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the robots from strongest to weakest must be "},{"kind":"math_inline","text":"(4, 2, 1, 3)"},{"kind":"text","text":", which Bessie can deduce after knowing the results of the first four rap battles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, both "},{"kind":"math_inline","text":"(1, 3, 2)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(3, 1, 2)"},{"kind":"text","text":" are possible orderings of the robots from strongest to weakest after both rap battles."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"645D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/645/problem/D"}