{"assets":[],"contentKind":"statement","contestId":"2253","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. 4-beauty"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"For a set of integers $$$S$$$, define its "},{"children":[{"kind":"text","text":"divisibility characteristic"}],"kind":"container"},{"kind":"text","text":" as the number of ordered pairs $$$(x, y)$$$ such that $$$x \\ne y$$$, $$$x$$$ and $$$y$$$ belong to $$$S$$$, and $$$x$$$ is divisible by $$$y$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a set of integers $$$A$$$, define its "},{"children":[{"kind":"text","text":"$$$4$$$-beauty"}],"kind":"container"},{"kind":"text","text":" as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" consider all sets of four distinct numbers that belong to $$$A$$$ and form an arithmetic progression; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" find the maximum divisibility characteristic among all such sets. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there are no suitable sets of four numbers, then the $$$4$$$-beauty equals $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially, the set $$$\\{1, 2, \\ldots, n\\}$$$ is given. You may remove numbers from it. Removing the number $$$i$$$ costs $$$m_i$$$ coins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Calculate the minimum number of coins you have to spend in order to decrease the $$$4$$$-beauty of the set."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$4 \\le n \\le 5 \\cdot 10^5$$$) — the number of elements in the initial set."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$m_1, m_2, \\ldots, m_n$$$ ($$$1 \\le m_i \\le 10^9$$$), where $$$m_i$$$ is the cost of removing the number $$$i$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the minimum number of coins you have to spend in order to decrease the $$$4$$$-beauty of the set. It can be shown that it is always possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n5 3 7 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 100 100 100 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n2 10 100 10 100 3 100 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n9 9 7 4 8 2 6 5 1 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the only arithmetic progression of four numbers is $$$1, 2, 3, 4$$$. Its divisibility characteristic equals $$$4$$$. It is sufficient to remove the number $$$4$$$, paying $$$2$$$ coins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, it is sufficient to remove the number $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, it is optimal to remove the numbers $$$1$$$ and $$$6$$$, paying $$$2+3=5$$$ coins."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"2253F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2253/problem/F"}