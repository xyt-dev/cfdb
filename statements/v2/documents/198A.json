{"assets":[],"contentKind":"statement","contestId":"198","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. About Bacteria"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Qwerty the Ranger took up a government job and arrived on planet Mars. He should stay in the secret lab and conduct some experiments on bacteria that have funny and abnormal properties. The job isn't difficult, but the salary is high."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At the beginning of the first experiment there is a single bacterium in the test tube. Every second each bacterium in the test tube divides itself into "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" bacteria. After that some abnormal effects create "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" more bacteria in the test tube. Thus, if at the beginning of some second the test tube had "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" bacteria, then at the end of the second it will have "},{"kind":"math_inline","text":"kx + b"},{"kind":"text","text":" bacteria."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The experiment showed that after "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" seconds there were exactly "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" bacteria and the experiment ended at this point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second experiment Qwerty is going to sterilize the test tube and put there "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" bacteria. He hasn't started the experiment yet but he already wonders, how many seconds he will need to grow at least "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" bacteria. The ranger thinks that the bacteria will divide by the same rule as in the first experiment. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Qwerty and find the minimum number of seconds needed to get a tube with at least "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" bacteria in the second experiment."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four space-separated integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"(1 ≤ k, b, n, t ≤ 106)"},{"kind":"text","text":" — the parameters of bacterial growth, the time Qwerty needed to grow "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" bacteria in the first experiment and the initial number of bacteria in the second experiment, correspondingly."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the minimum number of seconds Qwerty needs to grow at least "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" bacteria in the tube."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 4 4 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 4 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"198A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/198/problem/A"}