{"assets":[],"contentKind":"statement","contestId":"958","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E3. Guard Duty (hard)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Now that Heidi knows that she can assign Rebel spaceships to bases (recall the easy subtask), she is asking you: how "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" to do this? Now, given positions of "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" spaceships and "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" bases on a plane, your task is to connect spaceships and bases with line segments so that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The segments do not intersect. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Such a connection forms a perfect matching. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10000"},{"kind":"text","text":"). For "},{"kind":"math_inline","text":"1 ≤ i ≤ N"},{"kind":"text","text":", the "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":"-th line contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|xi|, |yi| ≤ 10000"},{"kind":"text","text":") denoting the coordinates of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th spaceship. The following "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" lines have the same format, denoting the position of bases. It is guaranteed that no two points coincide and no three points are on the same line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The output should have "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" lines. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line should contain an integer "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":", the index of the base to which the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th spaceship is connected. The sequence "},{"kind":"math_inline","text":"p1, ..., pN"},{"kind":"text","text":" should form a permutation of "},{"kind":"math_inline","text":"1, ..., N"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that a solution exists. If there are multiple solutions, you can output any one of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n6 6\n5 1\n2 4\n4 0\n5 4\n1 2\n2 1\n3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Outpu