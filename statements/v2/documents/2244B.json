{"assets":[],"contentKind":"statement","contestId":"2244","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Nikita and Books"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As is well known, Nikita loves reading. Today, he made a mess in his room and arranged his books into $$$n$$$ stacks in a row, numbered from $$$1$$$ to $$$n$$$ from left to right. The $$$i$$$-th stack contains $$$a_i$$$ books. This arrangement is called "},{"children":[{"kind":"text","text":"neat"}],"kind":"container"},{"kind":"text","text":" if, in every stack except the rightmost one, the number of books is strictly less than in the stack to its right; that is, the array $$$a$$$ is strictly increasing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Yura wants to make the arrangement "},{"children":[{"kind":"text","text":"neat"}],"kind":"container"},{"kind":"text","text":" by performing the following operation any number of times:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Choose a stack $$$i$$$ such that $$$1 \\le i \\lt n$$$ and $$$a_i \\gt 1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Take $$$1$$$ book from the top of stack $$$i$$$, so $$$a_i$$$ decreases by $$$1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Put this book on top of stack $$$i + 1$$$, so $$$a_{i+1}$$$ increases by $$$1$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Determine whether Yura can make the arrangement "},{"children":[{"kind":"text","text":"neat"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the number of stacks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_i$$$ ($$$1 \\le a_i \\le 10^9$$$) — the initial number of books in each stack."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if Yura can make the arrangement "},{"children":[{"kind":"text","text":"neat"}],"kind":"container"},{"kind":"text","text":", and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may output each letter in any case (lowercase or uppercase). For example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be accepted."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n3\n1 2 3\n3\n1 1 2\n3\n10 1 1\n3\n2 2 2\n4\n1 4 2 2\n5\n8 2 8 1 8\n4\n1 1 3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\nYES\nYES\nNO\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"2244B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2244/problem/B"}