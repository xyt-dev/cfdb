{"assets":[],"contentKind":"statement","contestId":"731","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Socks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Arseniy is already grown-up and independent. His mother decided to leave him alone for "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" days and left on a vacation. She have prepared a lot of food, left some money and washed all Arseniy's clothes. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ten minutes before her leave she realized that it would be also useful to prepare instruction of which particular clothes to wear on each of the days she will be absent. Arseniy's family is a bit weird so all the clothes is enumerated. For example, each of Arseniy's "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" socks is assigned a unique integer from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Thus, the only thing his mother had to do was to write down two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" for each of the days — the indices of socks to wear on the day "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" (obviously, "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" stands for the left foot and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" for the right). Each sock is painted in one of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" colors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When mother already left Arseniy noticed that according to instruction he would wear the socks of different colors on some days. Of course, that is a terrible mistake cause by a rush. Arseniy is a smart boy, and, by some magical coincidence, he posses "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" jars with the paint — one for each of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" colors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Arseniy wants to repaint some of the socks in such a way, that for each of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" days he can follow the mother's instructions and wear the socks of the same color. As he is going to be very busy these days he will have no time to change the colors of any socks so he has to finalize the colors now."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The new computer game Bota-3 was just realised and Arseniy can't wait to play it. What is the minimum number of socks that need their color to be changed in order to make it possible to follow mother's instructions and wear the socks of the same color during each of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" days."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 200 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ m ≤ 200 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 200 000"},{"kind":"text","text":") — the number of socks, the number of days and the number of available colors respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"c1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"cn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci ≤ k"},{"kind":"text","text":") — current colors of Arseniy's socks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li, ri ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"li ≠ ri"},{"kind":"text","text":") — indices of socks which Arseniy should wear during the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the minimum number of socks that should have their colors changed in order to be able to obey the instructions and not make people laugh from watching the socks of different colors."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 3\n1 2 3\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 2\n1 1 2\n1 2\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Arseniy can repaint the first and the third socks to the second color."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, there is no need to change any colors."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"731C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/731/problem/C"}