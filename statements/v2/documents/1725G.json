{"assets":["/statement-assets/68ee2aac08048b7e96259a6bf845f2a79fc1364f2012e670e00a85c25fb37eef.png"],"contentKind":"statement","contestId":"1725","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Garage"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"128 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pak Chanek plans to build a garage. He wants the garage to consist of a square and a right triangle that are arranged like the following illustration."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/68ee2aac08048b7e96259a6bf845f2a79fc1364f2012e670e00a85c25fb37eef.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Define $$$a$$$ and $$$b$$$ as the lengths of two of the sides in the right triangle as shown in the illustration. An integer $$$x$$$ is suitable if and only if we can construct a garage with assigning "},{"children":[{"kind":"text","text":"positive integer"}],"kind":"container"},{"kind":"text","text":" values for the lengths $$$a$$$ and $$$b$$$ ($$$a \\lt b$$$) so that the area of the square at the bottom is exactly $$$x$$$. As a good friend of Pak Chanek, you are asked to help him find the $$$N$$$-th smallest suitable number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains a single integer $$$N$$$ ($$$1 \\leq N \\leq 10^9$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"An integer that represents the $$$N$$$-th smallest suitable number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The $$$3$$$-rd smallest suitable number is $$$7$$$. A square area of $$$7$$$ can be obtained by assigning $$$a=3$$$ and $$$b=4$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1725G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1725/problem/G"}