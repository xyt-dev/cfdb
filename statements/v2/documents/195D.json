{"assets":["/statement-assets/e78d3ea0e7cf76dc76a2c60946a79de3c8d03fb860e21a7720ed10cf8947948c.png"],"contentKind":"statement","contestId":"195","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Analyzing Polyline"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As Valeric and Valerko were watching one of the last Euro Championship games in a sports bar, they broke a mug. Of course, the guys paid for it but the barman said that he will let them watch football in his bar only if they help his son complete a programming task. The task goes like that."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's consider a set of functions of the following form: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e78d3ea0e7cf76dc76a2c60946a79de3c8d03fb860e21a7720ed10cf8947948c.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" Let's define a sum of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" functions "},{"kind":"math_inline","text":"y1(x), ..., yn(x)"},{"kind":"text","text":" of the given type as function "},{"kind":"math_inline","text":"s(x) = y1(x) + ... + yn(x)"},{"kind":"text","text":" for any "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". It's easy to show that in this case the graph "},{"kind":"math_inline","text":"s(x)"},{"kind":"text","text":" is a polyline. You are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" functions of the given type, your task is to find the number of angles that do not equal 180 degrees, in the graph "},{"kind":"math_inline","text":"s(x)"},{"kind":"text","text":", that is the sum of the given functions."},{"children":[{"kind":"text","text":"Valeric and Valerko really want to watch the next Euro Championship game, so they asked you to help them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":" — the number of functions. Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two space-separated integer numbers "},{"kind":"math_inline","text":"ki, bi"},{"kind":"math_inline","text":"( - 109 ≤ ki, bi ≤ 109)"},{"kind":"text","text":" that determine the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th function."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the number of angles that do not equal 180 degrees in the graph of the polyline that equals the sum of the given functions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 0\n0 2\n-1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n-2 -4\n1 7\n-5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"195D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/195/problem/D"}