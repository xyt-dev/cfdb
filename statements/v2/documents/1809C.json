{"assets":[],"contentKind":"statement","contestId":"1809","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Sum on Subarrays"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"For an array $$$a = [a_1, a_2, \\dots, a_n]$$$, let's denote its "},{"children":[{"kind":"text","text":"subarray"}],"kind":"container"},{"kind":"text","text":" $$$a[l, r]$$$ as the array $$$[a_l, a_{l+1}, \\dots, a_r]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the array $$$a = [1, -3, 1]$$$ has $$$6$$$ non-empty subarrays:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a[1,1] = [1]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a[1,2] = [1,-3]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a[1,3] = [1,-3,1]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a[2,2] = [-3]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a[2,3] = [-3,1]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a[3,3] = [1]$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given two integers $$$n$$$ and $$$k$$$. Construct an array $$$a$$$ consisting of $$$n$$$ integers such that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" all elements of $$$a$$$ are from $$$-1000$$$ to $$$1000$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a$$$ has exactly $$$k$$$ subarrays with positive sums; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the rest $$$\\dfrac{(n+1) \\cdot n}{2}-k$$$ subarrays of $$$a$$$ have negative sums. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 5000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of one line containing two integers $$$n$$$ and $$$k$$$ ($$$2 \\le n \\le 30$$$; $$$0 \\le k \\le \\dfrac{(n+1) \\cdot n}{2}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print $$$n$$$ integers — the elements of the array meeting the constraints. It can be shown that the answer always exists. If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n3 2\n2 0\n2 2\n4 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 -3 1\n-13 -42\n-13 42\n-3 -4 10 -2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1809C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1809/problem/C"}