{"assets":[],"contentKind":"statement","contestId":"332","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Binary Key"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's assume that "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" are strings of positive length, called the "},{"children":[{"kind":"text","text":"container"}],"kind":"container"},{"kind":"text","text":" and the "},{"children":[{"kind":"text","text":"key"}],"kind":"container"},{"kind":"text","text":" correspondingly, string "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" only consists of characters 0 and 1. Let's take a look at a simple algorithm that extracts "},{"children":[{"kind":"text","text":"message"}],"kind":"container"},{"kind":"math_inline","text":"s"},{"kind":"text","text":" from the given container "},{"kind":"math_inline","text":"p"},{"kind":"text","text":":"}],"kind":"paragraph"},{"kind":"code_block","text":"\ni = 0;\nj = 0;\ns = <>;\nwhile i is less than the length of the string p\n{\n    if q[j] == 1, then add to the right of string s character p[i];\n    increase variables i, j by one;\n    if the value of the variable j equals the length of the string q, then j = 0; \n}\n"},{"children":[{"kind":"text","text":"In the given pseudocode "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" are integer variables, "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a string, '"},{"children":[{"kind":"text","text":"="}],"kind":"container"},{"kind":"text","text":"' is an assignment operator, '"},{"children":[{"kind":"text","text":"=="}],"kind":"container"},{"kind":"text","text":"' is a comparison operation, '"},{"children":[{"kind":"text","text":"[]"}],"kind":"container"},{"kind":"text","text":"' is the operation of obtaining the string character with the preset index, '"},{"children":[{"kind":"text","text":"<>"}],"kind":"container"},{"kind":"text","text":"' is an empty string. We suppose that in all strings the characters are numbered starting from zero. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We understand that implementing such algorithm is quite easy, so your task is going to be slightly different. You need to construct the lexicographically minimum key of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", such that when it is used, the algorithm given above extracts message "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" from container "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" (otherwise find out that such key doesn't exist)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first two lines of the input are non-empty strings "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |p| ≤ 106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ |s| ≤ 200"},{"kind":"text","text":"), describing the container and the message, correspondingly. The strings can contain any characters with the ASCII codes from 32 to 126, inclusive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 2000)"},{"kind":"text","text":" — the key's length."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the required key (string of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", consisting only of characters 0 and 1). If the key doesn't exist, print the single character 0."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abacaba\naba\n6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"100001\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abacaba\naba\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"String "},{"kind":"math_inline","text":"x = x1x2... xp"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"lexicographically smaller"}],"kind":"container"},{"kind":"text","text":" than string "},{"kind":"math_inline","text":"y = y1y2... yq"},{"kind":"text","text":", if either "},{"kind":"math_inline","text":"p < q"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x1 = y1, x2 = y2, ... , xp = yp"},{"kind":"text","text":", or there exists such integer "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ r < min(p, q))"},{"kind":"text","text":" that "},{"kind":"math_inline","text":"x1 = y1, x2 = y2, ... , xr = yr"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"xr + 1 < yr + 1"},{"kind":"text","text":". Symbols are compared according to their ASCII codes."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"332E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/332/problem/E"}