{"assets":[],"contentKind":"statement","contestId":"1750","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Count GCD"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two integers $$$n$$$ and $$$m$$$ and an array $$$a$$$ of $$$n$$$ integers. For each $$$1 \\le i \\le n$$$ it holds that $$$1 \\le a_i \\le m$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to count the number of different arrays $$$b$$$ of length $$$n$$$ such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1 \\le b_i \\le m$$$ for each $$$1 \\le i \\le n$$$, and "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\gcd(b_1,b_2,b_3,...,b_i) = a_i$$$ for each $$$1 \\le i \\le n$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Here $$$\\gcd(a_1,a_2,\\dots,a_i)$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Greatest_common_divisor"},"children":[{"kind":"text","text":"greatest common divisor (GCD)"}],"kind":"link"},{"kind":"text","text":" of integers $$$a_1,a_2,\\ldots,a_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since this number can be too large, print it modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test consist of multiple test cases. The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 100$$$) — the number of test cases. The description of test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$, $$$1 \\le m \\le 10^9$$$) — the length of the array $$$a$$$ and the maximum possible value of the element."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\le a_i \\le m$$$) — the elements of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ across all test cases doesn't exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single integer — the number of different arrays satisfying the conditions above. Since this number can be large, print it modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n3 5\n4 2 1\n2 1\n1 1\n5 50\n2 3 5 2 3\n4 1000000000\n60 30 1 1\n2 1000000000\n1000000000 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1\n0\n595458194\n200000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the possible arrays $$$b$$$ are: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[4,2,1]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[4,2,3]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[4,2,5]$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second test case, the only array satisfying the demands is $$$[1,1]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, it can be proven no such array exists."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1750D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1750/problem/D"}