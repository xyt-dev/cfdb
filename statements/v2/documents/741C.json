{"assets":["/statement-assets/bc1d5076d8f66221c0552f2b60b68c78865cce8b9929aefd96c0dc417960dec3.png"],"contentKind":"statement","contestId":"741","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Arpa’s overnight party and Mehrdad’s silent entering"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Note that girls in Arpa’s land are really attractive."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Arpa loves overnight parties. In the middle of one of these parties Mehrdad suddenly appeared. He saw "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pairs of friends sitting around a table. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th pair consisted of a boy, sitting on the "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"-th chair, and his girlfriend, sitting on the "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":"-th chair. The chairs were numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" in clockwise direction. There was exactly one person sitting on each chair."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/bc1d5076d8f66221c0552f2b60b68c78865cce8b9929aefd96c0dc417960dec3.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"There were two types of food: Kooft and Zahre-mar. Now Mehrdad wonders, was there any way to serve food for the guests such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Each person had exactly one type of food, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" No boy had the same type of food as his girlfriend, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Among any three guests sitting on consecutive chairs, there was two of them who had different type of food. Note that chairs "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" are considered consecutive. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Find the answer for the Mehrdad question. If it was possible, find some arrangement of food types that satisfies the conditions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤  n  ≤  105"},{"kind":"text","text":") — the number of pairs of guests."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains a pair of integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤ ai, bi ≤  2n"},{"kind":"text","text":") — the number of chair on which the boy in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th pair was sitting and the number of chair on which his girlfriend was sitting. It's guaranteed that there was exactly one person sitting on each chair. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no solution, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should contain two integers which represent the type of food for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th pair. The first integer in the line is the type of food the boy had, and the second integer is the type of food the girl had. If someone had Kooft, print "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", otherwise print "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 4\n2 5\n3 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n2 1\n1 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"741C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/741/problem/C"}