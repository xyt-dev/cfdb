{"assets":[],"contentKind":"statement","contestId":"1166","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Silent Classroom"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are $$$n$$$ students in the first grade of Nlogonia high school. The principal wishes to split the students into two classrooms (each student must be in exactly one of the classrooms). Two distinct students whose name starts with the same letter will be chatty if they are put in the same classroom (because they must have a lot in common). Let $$$x$$$ be the number of such pairs of students in a split. Pairs $$$(a, b)$$$ and $$$(b, a)$$$ are the same and counted only once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if there are $$$6$$$ students: \""},{"children":[{"kind":"text","text":"olivia"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"jacob"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"tanya"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"jack"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"oliver"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"jessica"}],"kind":"container"},{"kind":"text","text":"\", then:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" splitting into two classrooms (\""},{"children":[{"kind":"text","text":"jack"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"jacob"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"jessica"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"tanya"}],"kind":"container"},{"kind":"text","text":"\") and (\""},{"children":[{"kind":"text","text":"olivia"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"oliver"}],"kind":"container"},{"kind":"text","text":"\") will give $$$x=4$$$ ($$$3$$$ chatting pairs in the first classroom, $$$1$$$ chatting pair in the second classroom), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" splitting into two classrooms (\""},{"children":[{"kind":"text","text":"jack"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"tanya"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"olivia"}],"kind":"container"},{"kind":"text","text":"\") and (\""},{"children":[{"kind":"text","text":"jessica"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"oliver"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"jacob"}],"kind":"container"},{"kind":"text","text":"\") will give $$$x=1$$$ ($$$0$$$ chatting pairs in the first classroom, $$$1$$$ chatting pair in the second classroom). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given the list of the $$$n$$$ names. What is the minimum $$$x$$$ we can obtain by splitting the students into classrooms?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that it is valid to place all of the students in one of the classrooms, leaving the other one empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$1\\leq n \\leq 100$$$) — the number of students."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After this $$$n$$$ lines follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th line contains the name of the $$$i$$$-th student."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed each name is a string of lowercase English letters of length at most $$$20$$$. Note that multiple students may share the same name."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The output must consist of a single integer $$$x$$$ — the minimum possible number of chatty pairs."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\njorge\njose\noscar\njerry\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\nkambei\ngorobei\nshichiroji\nkyuzo\nheihachi\nkatsushiro\nkikuchiyo\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\nmike\nmike\nmike\nmike\nmike\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the minimum number of pairs is $$$1$$$. This can be achieved, for example, by putting everyone except "},{"children":[{"kind":"text","text":"jose"}],"kind":"container"},{"kind":"text","text":" in one classroom, and "},{"children":[{"kind":"text","text":"jose"}],"kind":"container"},{"kind":"text","text":" in the other, so "},{"children":[{"kind":"text","text":"jorge"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"jerry"}],"kind":"container"},{"kind":"text","text":" form the only chatty pair."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the minimum number of pairs is $$$2$$$. This can be achieved, for example, by putting "},{"children":[{"kind":"text","text":"kambei"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"gorobei"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"shichiroji"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"kyuzo"}],"kind":"container"},{"kind":"text","text":" in one room and putting "},{"children":[{"kind":"text","text":"heihachi"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"katsushiro"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"kikuchiyo"}],"kind":"container"},{"kind":"text","text":" in the other room. In this case the two pairs are "},{"children":[{"kind":"text","text":"kambei"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"kyuzo"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"katsushiro"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"kikuchiyo"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample the minimum number of pairs is $$$4$$$. This can be achieved by placing three of the students named "},{"children":[{"kind":"text","text":"mike"}],"kind":"container"},{"kind":"text","text":" in one classroom and the other two students in another classroom. Thus there will be three chatty pairs in one classroom and one chatty pair in the other classroom."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1166A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1166/problem/A"}