{"assets":[],"contentKind":"statement","contestId":"621","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Wet Shark and Bishops"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Today, Wet Shark is given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" bishops on a "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":" grid. Both rows and columns of the grid are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":". Rows are numbered from top to bottom, while columns are numbered from left to right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Wet Shark thinks that two bishops attack each other if they share the same diagonal. Note, that this is the only criteria, so two bishops may attack each other (according to Wet Shark) even if there is another bishop located between them. Now Wet Shark wants to count the number of pairs of bishops that attack each other."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000"},{"kind":"text","text":") — the number of bishops."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two space separated integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ 1000"},{"kind":"text","text":") — the number of row and the number of column where "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th bishop is positioned. It's guaranteed that no two bishops share the same position."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one integer — the number of pairs of bishops which attack each other. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 1\n1 5\n3 3\n5 1\n5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1\n2 3\n3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample following pairs of bishops attack each other: "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 5)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 4)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(3, 5)"},{"kind":"text","text":". Pairs "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 5)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(4, 5)"},{"kind":"text","text":" do not attack each other because they do not share the same diagonal."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"621B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/621/problem/B"}