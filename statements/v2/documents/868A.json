{"assets":[],"contentKind":"statement","contestId":"868","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Bark to Unlock"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As technologies develop, manufacturers are making the process of unlocking a phone as user-friendly as possible. To unlock its new phone, Arkady's pet dog Mu-mu has to bark the password once. The phone represents a password as a string of two lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mu-mu's enemy Kashtanka wants to unlock Mu-mu's phone to steal some sensible information, but it can only bark "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct words, each of which can be represented as a string of two lowercase English letters. Kashtanka wants to bark several words (not necessarily distinct) one after another to pronounce a string containing the password as a substring. Tell if it's possible to unlock the phone in this way, or not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two lowercase English letters — the password on the phone."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of words Kashtanka knows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain two lowercase English letters each, representing the words Kashtanka knows. The words are guaranteed to be distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if Kashtanka can bark several words in a line forming a string containing the password, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print each letter in arbitrary case (upper or lower)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ya\n4\nah\noy\nto\nha\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"hp\n2\nht\ntp\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ah\n1\nha\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the password is \""},{"children":[{"kind":"text","text":"ya"}],"kind":"container"},{"kind":"text","text":"\", and Kashtanka can bark \""},{"children":[{"kind":"text","text":"oy"}],"kind":"container"},{"kind":"text","text":"\" and then \""},{"children":[{"kind":"text","text":"ah"}],"kind":"container"},{"kind":"text","text":"\", and then \""},{"children":[{"kind":"text","text":"ha"}],"kind":"container"},{"kind":"text","text":"\" to form the string \""},{"children":[{"kind":"text","text":"oyahha"}],"kind":"container"},{"kind":"text","text":"\" which contains the password. So, the answer is \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example Kashtanka can't produce a string containing password as a substring. Note that it can bark \""},{"children":[{"kind":"text","text":"ht"}],"kind":"container"},{"kind":"text","text":"\" and then \""},{"children":[{"kind":"text","text":"tp"}],"kind":"container"},{"kind":"text","text":"\" producing \""},{"children":[{"kind":"text","text":"http"}],"kind":"container"},{"kind":"text","text":"\", but it doesn't contain the password \""},{"children":[{"kind":"text","text":"hp"}],"kind":"container"},{"kind":"text","text":"\" as a substring."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example the string \""},{"children":[{"kind":"text","text":"hahahaha"}],"kind":"container"},{"kind":"text","text":"\" contains \""},{"children":[{"kind":"text","text":"ah"}],"kind":"container"},{"kind":"text","text":"\" as a substring."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"868A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/868/problem/A"}