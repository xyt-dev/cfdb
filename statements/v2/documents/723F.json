{"assets":[],"contentKind":"statement","contestId":"723","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. st-Spanning Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an undirected connected graph consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges. There are no loops and no multiple edges in the graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are also given two distinct vertices "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", and two values "},{"kind":"math_inline","text":"ds"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"dt"},{"kind":"text","text":". Your task is to build any spanning tree of the given graph (note that the graph is not weighted), such that the degree of the vertex "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" doesn't exceed "},{"kind":"math_inline","text":"ds"},{"kind":"text","text":", and the degree of the vertex "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" doesn't exceed "},{"kind":"math_inline","text":"dt"},{"kind":"text","text":", or determine, that there is no such spanning tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"spanning tree"}],"kind":"container"},{"kind":"text","text":" of the graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" is a subgraph which is a tree and contains all vertices of the graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":". In other words, it is a connected graph which contains "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" edges and can be obtained by removing some of the edges from "},{"kind":"math_inline","text":"G"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The degree of a vertex is the number of edges incident to this vertex."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 200 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ min(400 000, n·(n - 1) / 2)"},{"kind":"text","text":") — the number of vertices and the number of edges in the graph. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the descriptions of the graph's edges. Each of the lines contains two integers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ u, v ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"u ≠ v"},{"kind":"text","text":") — the ends of the corresponding edge. It is guaranteed that the graph contains no loops and no multiple edges and that it is connected."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line contains four integers "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ds"},{"kind":"text","text":", "},{"kind":"math_inline","text":"dt"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ s, t ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"s ≠ t"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ds, dt ≤ n - 1"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the answer doesn't exist print \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in the only line of the output. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, in the first line print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" (without quotes). In the each of the next "},{"kind":"math_inline","text":"(n - 1)"},{"kind":"text","text":" lines print two integers — the description of the edges of the spanning tree. Each of the edges of the spanning tree must be printed exactly once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output edges in any order. You can output the ends of each edge in any order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2\n2 3\n3 1\n1 2 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n3 2\n1 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 8\n7 4\n1 3\n5 4\n5 7\n3 2\n2 4\n6 1\n1 2\n6 4 1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n1 3\n5 7\n3 2\n7 4\n2 4\n6 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"723F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/723/problem/F"}