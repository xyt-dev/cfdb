{"assets":[],"contentKind":"statement","contestId":"217","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Blackboard Fibonacci"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Fibonacci numbers are the sequence of integers: "},{"kind":"math_inline","text":"f0 = 0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f1 = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f2 = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f3 = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f4 = 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f5 = 5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"fn = fn - 2 + fn - 1"},{"kind":"text","text":". So every next number is the sum of the previous two."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Bajtek has developed a nice way to compute Fibonacci numbers on a blackboard. First, he writes a 0. Then, below it, he writes a 1. Then he performs the following two operations:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" operation \""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\": replace the top number with the sum of both numbers; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" operation \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\": replace the bottom number with the sum of both numbers. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If he performs "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" operations, starting with \""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\" and then choosing operations alternately (so that the sequence of operations looks like \""},{"children":[{"kind":"text","text":"TBTBTBTB"}],"kind":"container"},{"kind":"math_inline","text":"..."},{"kind":"text","text":"\"), the last number written will be equal to "},{"kind":"math_inline","text":"fn + 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, Bajtek sometimes makes mistakes and repeats an operation two or more times in a row. For example, if Bajtek wanted to compute "},{"kind":"math_inline","text":"f7"},{"kind":"text","text":", then he would want to do "},{"kind":"math_inline","text":"n = 6"},{"kind":"text","text":" operations: \""},{"children":[{"kind":"text","text":"TBTBTB"}],"kind":"container"},{"kind":"text","text":"\". If he instead performs the sequence of operations \""},{"children":[{"kind":"text","text":"TTTBBT"}],"kind":"container"},{"kind":"text","text":"\", then he will have made 3 mistakes, and he will incorrectly compute that the seventh Fibonacci number is 10. The number of mistakes in the sequence of operations is the number of neighbouring equal operations («"},{"children":[{"kind":"text","text":"TT"}],"kind":"container"},{"kind":"text","text":"» or «"},{"children":[{"kind":"text","text":"BB"}],"kind":"container"},{"kind":"text","text":"»)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" of operations that Bajtek has made in an attempt to compute "},{"kind":"math_inline","text":"fn + 1"},{"kind":"text","text":" and the number "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" that is the result of his computations (that is last written number). Find the minimum possible number of mistakes that Bajtek must have made and any possible sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" operations resulting in "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" with that number of mistakes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Assume that Bajtek always correctly starts with operation \""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, r ≤ 106)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the output should contain one number — the minimum possible number of mistakes made by Bajtek. The second line should contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters, starting with \""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\", describing one possible sequence of operations with that number of mistakes. Each character must be either \""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the required sequence doesn't exist, output \""},{"children":[{"kind":"text","text":"IMPOSSIBLE"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\nTBBTTB\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\nTBTB\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"IMPOSSIBLE\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"217B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/217/problem/B"}