{"assets":["/statement-assets/c4caec0a13739205b504d2f41fa3134d597b3a7c9490e4d6eb7ee3d6701bb527.png"],"contentKind":"statement","contestId":"166","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Tetrahedron"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a tetrahedron. Let's mark its vertices with letters "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", "},{"kind":"math_inline","text":"B"},{"kind":"text","text":", "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"D"},{"kind":"text","text":" correspondingly."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c4caec0a13739205b504d2f41fa3134d597b3a7c9490e4d6eb7ee3d6701bb527.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"An ant is standing in the vertex "},{"kind":"math_inline","text":"D"},{"kind":"text","text":" of the tetrahedron. The ant is quite active and he wouldn't stay idle. At each moment of time he makes a step from one vertex to another one along some edge of the tetrahedron. The ant just can't stand on one place."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You do not have to do much to solve the problem: your task is to count the number of ways in which the ant can go from the initial vertex "},{"kind":"math_inline","text":"D"},{"kind":"text","text":" to itself in exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" steps. In other words, you are asked to find out the number of different cyclic paths with the length of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from vertex "},{"kind":"math_inline","text":"D"},{"kind":"text","text":" to itself. As the number can be quite large, you should print it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"). "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the only integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 107"},{"kind":"text","text":") — the required length of the cyclic path."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer — the required number of ways modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"21\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The required paths in the first sample are: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"D - A - D"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"D - B - D"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"D - C - D"}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"166E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/166/problem/E"}