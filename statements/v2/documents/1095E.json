{"assets":[],"contentKind":"statement","contestId":"1095","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Almost Regular Bracket Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a bracket sequence $$$s$$$ consisting of $$$n$$$ opening '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' and closing '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"' brackets."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"regular"}],"kind":"container"},{"kind":"text","text":" bracket sequence is a bracket sequence that can be transformed into a correct arithmetic expression by inserting characters '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' between the original characters of the sequence. For example, bracket sequences \""},{"children":[{"kind":"text","text":"()()"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"(())"}],"kind":"container"},{"kind":"text","text":"\" are regular (the resulting expressions are: \""},{"children":[{"kind":"text","text":"(1)+(1)"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"((1+1)+1)"}],"kind":"container"},{"kind":"text","text":"\"), and \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can change the type of some bracket $$$s_i$$$. It means that if $$$s_i = $$$ '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"' then you can change it to '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' and vice versa."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to calculate the number of positions $$$i$$$ such that if you change the type of the $$$i$$$-th bracket, then the resulting bracket sequence becomes "},{"children":[{"kind":"text","text":"regular"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$n$$$ ($$$1 \\le n \\le 10^6$$$) — the length of the bracket sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains the string $$$s$$$ consisting of $$$n$$$ opening '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' and closing '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"' brackets."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the number of positions $$$i$$$ such that if you change the type of the $$$i$$$-th bracket, then the resulting bracket sequence becomes "},{"children":[{"kind":"text","text":"regular"}],"kind":"container"},{"kind":"text","text":"."}]