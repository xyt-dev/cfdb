{"assets":["/statement-assets/a4792e1d711964fd6d37e2ead2c29a64a1a91b8aac5708397e516319861a7623.png","/statement-assets/37bf834ff9a893e148e810f60e1adc259a3cc9fb7017a5ba603c7e020d1a780a.png","/statement-assets/3a25fb459ecd30667278a1d0e8944771f3ee4637f56de9f35ad152c5d9dbb635.png"],"contentKind":"statement","contestId":"1118","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Palindromic Matrix"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's call some square matrix with integer values in its cells "},{"children":[{"kind":"text","text":"palindromic"}],"kind":"container"},{"kind":"text","text":" if it doesn't change after the order of rows is reversed and it doesn't change after the order of columns is reversed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the following matrices are "},{"children":[{"children":[{"kind":"text","text":"palindromic"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":":"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a4792e1d711964fd6d37e2ead2c29a64a1a91b8aac5708397e516319861a7623.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The following matrices are "},{"children":[{"kind":"text","text":"not "},{"children":[{"kind":"text","text":"palindromic"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" because they change after the order of rows is reversed:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/37bf834ff9a893e148e810f60e1adc259a3cc9fb7017a5ba603c7e020d1a780a.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The following matrices are "},{"children":[{"kind":"text","text":"not "},{"children":[{"kind":"text","text":"palindromic"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" because they change after the order of columns is reversed:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/3a25fb459ecd30667278a1d0e8944771f3ee4637f56de9f35ad152c5d9dbb635.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"You are given $$$n^2$$$ integers. Put them into a matrix of $$$n$$$ rows and $$$n$$$ columns so that each number is used exactly once, each cell contains exactly one number and the resulting matrix is "},{"children":[{"kind":"text","text":"palindromic"}],"kind":"container"},{"kind":"text","text":". If there are multiple answers, print any. If there is no solution, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$1 \\le n \\le 20$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n^2$$$ integers $$$a_1, a_2, \\dots, a_{n^2}$$$ ($$$1 \\le a_i \\le 1000$$$) — the numbers to put into a matrix of $$$n$$$ rows and $$$n$$$ columns."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is possible to put all of the $$$n^2$$$ numbers into a matrix of $$$n$$$ rows and $$$n$$$ columns so that each number is used exactly once, each cell contains exactly one number and the resulting matrix is "},{"children":[{"kind":"text","text":"palindromic"}],"kind":"container"},{"kind":"text","text":", then print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\". Then print $$$n$$$ lines with $$$n$$$ space-separated numbers — the resulting matrix."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it's impossible to construct any matrix, then print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print each letter in any case (upper or lower). For example, \""},{"children":[{"kind":"text","text":"YeS"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"no"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"yES"}],"kind":"container"},{"kind":"text","text":"\" are all acceptable."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 8 8 1 2 2 2 2 2 2 2 2 1 8 8 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n1 2 2 1\n8 2 2 8\n8 2 2 8\n1 2 2 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 1 1 1 1 3 3 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n1 3 1\n3 1 3\n1 3 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 2 1 9 8 4 3 8 8 3 4 8 9 2 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n10 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Note that there exist multiple answers for the first two examples."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1118C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1118/problem/C"}