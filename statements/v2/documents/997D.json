{"assets":["/statement-assets/91bf9adfdc6f527d819631964b5620f20850ad042bf9a0ecbc9a2948a89166b2.png","/statement-assets/2775c87f66282ec23f27e45cc257f19f60e6827fbdeb1067630ee330c183d94f.png","/statement-assets/7ff78c3ac3126748f6381326357102777932e84fee2ff708b4e840937e1e8fbf.png"],"contentKind":"statement","contestId":"997","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Cycles in product"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"7 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider a tree (that is, an undirected connected graph without loops) $$$T_1$$$ and a tree $$$T_2$$$. Let's define their "},{"children":[{"kind":"text","text":"cartesian product"}],"kind":"container"},{"kind":"text","text":" $$$T_1 \\times T_2$$$ in a following way."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$V$$$ be the set of vertices in $$$T_1$$$ and $$$U$$$ be the set of vertices in $$$T_2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then the set of vertices of graph $$$T_1 \\times T_2$$$ is $$$V \\times U$$$, that is, a set of ordered pairs of vertices, where the first vertex in pair is from $$$V$$$ and the second — from $$$U$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's draw the following edges:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Between $$$(v, u_1)$$$ and $$$(v, u_2)$$$ there is an undirected edge, if $$$u_1$$$ and $$$u_2$$$ are adjacent in $$$U$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Similarly, between $$$(v_1, u)$$$ and $$$(v_2, u)$$$ there is an undirected edge, if $$$v_1$$$ and $$$v_2$$$ are adjacent in $$$V$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Please see the notes section for the pictures of products of trees in the sample tests."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's examine the graph $$$T_1 \\times T_2$$$. How much cycles (not necessarily simple) of length $$$k$$$ it contains? Since this number can be very large, print it modulo $$$998244353$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sequence of vertices $$$w_1$$$, $$$w_2$$$, ..., $$$w_k$$$, where $$$w_i \\in V \\times U$$$ called cycle, if any neighboring vertices are adjacent and $$$w_1$$$ is adjacent to $$$w_k$$$. Cycles that differ only by the cyclic shift or direction of traversal are still considered "},{"children":[{"kind":"text","text":"different"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of input contains three integers — $$$n_1$$$, $$$n_2$$$ and $$$k$$$ ($$$2 \\le n_1, n_2 \\le 4000$$$, $$$2 \\le k \\le 75$$$) — number of vertices in the first tree, number of vertices in the second tree and the cycle length respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow $$$n_1 - 1$$$ lines describing the first tree. Each of this lines contains two integers — $$$v_i, u_i$$$ ($$$1 \\le v_i, u_i \\le n_1$$$), which define edges of the first tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow $$$n_2 - 1$$$ lines, which describe the second tree in the same format."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed, that given graphs are trees."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — number of cycles modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 2\n1 2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 4\n1 2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"32\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 4\n1 2\n1 2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"70\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 2\n1 2\n1 3\n1 4\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The following three pictures illustrate graph, which are products of the trees from sample tests."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first example, the list of cycles of length $$$2$$$ is as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" «AB», «BA» "}],"kind":"list_item"},{"children":[{"kind":"text","text":" «BC», «CB» "}],"kind":"list_item"},{"children":[{"kind":"text","text":" «AD», «DA» "}],"kind":"list_item"},{"children":[{"kind":"text","text":" «CD», «DC» "}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/91bf9adfdc6f527d819631964b5620f20850ad042bf9a0ecbc9a2948a89166b2.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/2775c87f66282ec23f27e45cc257f19f60e6827fbdeb1067630ee330c183d94f.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/7ff78c3ac3126748f6381326357102777932e84fee2ff708b4e840937e1e8fbf.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"997D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/997/problem/D"}