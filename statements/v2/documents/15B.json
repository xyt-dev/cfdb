{"assets":[],"contentKind":"statement","contestId":"15","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Laser"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya is the most responsible worker in the Research Institute. So he was asked to make a very important experiment: to melt the chocolate bar with a new laser device. The device consists of a rectangular field of "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" cells and a robotic arm. Each cell of the field is a "},{"kind":"math_inline","text":"1 × 1"},{"kind":"text","text":" square. The robotic arm has two lasers pointed at the field perpendicularly to its surface. At any one time lasers are pointed at the centres of some two cells. Since the lasers are on the robotic hand, their movements are synchronized — if you move one of the lasers by a vector, another one moves by the same vector."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following facts about the experiment are known: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" initially the whole field is covered with a chocolate bar of the size "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":", both lasers are located above the field and are active; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the chocolate melts within one cell of the field at which the laser is pointed; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" all moves of the robotic arm should be parallel to the sides of the field, after each move the lasers should be pointed at the centres of some two cells; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" at any one time both lasers should be pointed at the field. Petya doesn't want to become a second Gordon Freeman. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and the cells "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":", where the lasers are initially pointed at ("},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" is a column number, "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" is a row number). Rows are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" from top to bottom and columns are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right. You are to find the amount of cells of the field on which the chocolate can't be melted in the given conditions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer number "},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"(1 ≤ t ≤ 10000)"},{"kind":"text","text":" — the number of test sets. Each of the following "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines describes one test set. Each line contains integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":", separated by a space ("},{"kind":"math_inline","text":"2 ≤ n, m ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ x1, x2 ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ y1, y2 ≤ m"},{"kind":"text","text":"). Cells "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":" are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each of the "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines of the output should contain the answer to the corresponding input test set."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n4 4 1 1 3 3\n4 3 1 1 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"15B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/15/problem/B"}