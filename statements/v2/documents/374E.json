{"assets":[],"contentKind":"statement","contestId":"374","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Inna and Babies"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"6 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Inna, Dima and Sereja are in one room together. It's cold outside, so Sereja suggested to play a board game called \"Babies\". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The babies playing board is an infinite plane containing "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" blue babies and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" red ones. Each baby is a segment that grows in time. At time moment "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" the blue baby "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" is a blue segment with ends at points "},{"kind":"math_inline","text":"(x - t, y + t)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x + t, y - t)"},{"kind":"text","text":". Similarly, at time "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" the red baby "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" is a red segment with ends at points "},{"kind":"math_inline","text":"(x + t, y + t)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x - t, y - t)"},{"kind":"text","text":" of the plane. Initially, at time "},{"kind":"math_inline","text":"t = 0"},{"kind":"text","text":" all babies are points on the plane."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The goal of the game is to find the first integer moment of time when the plane contains a rectangle of a non-zero area which sides are fully covered by some babies. A side may be covered by multiple babies. More formally, each point of each side of the rectangle should be covered by at least one baby of any color. At that, you must assume that the babies are closed segments, that is, they contain their endpoints."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the positions of all babies — help Inna and Dima to find the required moment of time."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 2000)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the coordinates of the blue babies. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains integers "},{"kind":"math_inline","text":"xi, yi"},{"kind":"text","text":" — a baby's coordinates. Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the coordinates of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" red babies in the similar form."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All coordinates of the input don't exceed "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" in their absolute value. Note that all babies stand in distinct points."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the single line print a single integer — the answer to the problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the rectangle never appears on the plane, print \""},{"children":[{"kind":"text","text":"Poor Sereja!"}],"kind":"container"},{"kind":"text","text":"\" without the quotes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n2 2\n5 5\n3 7\n5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n2 2\n3 2\n6 2\n4 2\n5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"374E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/374/problem/E"}