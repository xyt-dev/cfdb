{"assets":[],"contentKind":"statement","contestId":"260","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Ancient Prophesy"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A recently found Ancient Prophesy is believed to contain the exact Apocalypse date. The prophesy is a string that only consists of digits and characters \""},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We'll say that some date is mentioned in the Prophesy if there is a substring in the Prophesy that is the date's record in the format \""},{"children":[{"kind":"text","text":"dd-mm-yyyy"}],"kind":"container"},{"kind":"text","text":"\". We'll say that the number of the date's occurrences is the number of such substrings in the Prophesy. For example, the Prophesy \""},{"children":[{"kind":"text","text":"0012-10-2012-10-2012"}],"kind":"container"},{"kind":"text","text":"\" mentions date "},{"children":[{"kind":"text","text":"12-10-2012"}],"kind":"container"},{"kind":"text","text":" twice (first time as \""},{"children":[{"kind":"text","text":"00"},{"children":[{"kind":"text","text":"12-10-2012"}],"kind":"container"},{"kind":"text","text":"-10-2012"}],"kind":"container"},{"kind":"text","text":"\", second time as \""},{"children":[{"kind":"text","text":"0012-10-20"},{"children":[{"kind":"text","text":"12-10-2012"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":"\")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The date of the Apocalypse is such correct date that the number of times it is mentioned in the Prophesy is strictly larger than that of any other correct date."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A date is correct if the year lies in the range from "},{"kind":"math_inline","text":"2013"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"2015"},{"kind":"text","text":", the month is from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"12"},{"kind":"text","text":", and the number of the day is strictly more than a zero and doesn't exceed the number of days in the current month. Note that a date is written in the format \""},{"children":[{"kind":"text","text":"dd-mm-yyyy"}],"kind":"container"},{"kind":"text","text":"\", that means that leading zeroes may be added to the numbers of the months or days if needed. In other words, date \""},{"children":[{"kind":"text","text":"1-1-2013"}],"kind":"container"},{"kind":"text","text":"\" isn't recorded in the format \""},{"children":[{"kind":"text","text":"dd-mm-yyyy"}],"kind":"container"},{"kind":"text","text":"\", and date \""},{"children":[{"kind":"text","text":"01-01-2013"}],"kind":"container"},{"kind":"text","text":"\" is recorded in it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Notice, that any year between 2013 and 2015 is not a leap year."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the Prophesy: a non-empty string that only consists of digits and characters \""},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"\". The length of the Prophesy doesn't exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":" characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print the date of the Apocalypse. It is guaranteed that such date exists and is unique."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"777-444---21-12-2013-12-2013-12-2013---444-777\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13-12-2013"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"260B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/260/problem/B"}