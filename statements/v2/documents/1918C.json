{"assets":[],"contentKind":"statement","contestId":"1918","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. XOR-distance"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given integers $$$a$$$, $$$b$$$, $$$r$$$. Find the smallest value of $$$|({a \\oplus x}) - ({b \\oplus x})|$$$ among all $$$0 \\leq x \\leq r$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\oplus$$$ is the operation of "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise XOR"}],"kind":"link"},{"kind":"text","text":", and $$$|y|$$$ is "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Absolute_value"},"children":[{"kind":"text","text":"absolute value"}],"kind":"link"},{"kind":"text","text":" of $$$y$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case contains integers $$$a$$$, $$$b$$$, $$$r$$$ ($$$0 \\le a, b, r \\le 10^{18}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single number — the smallest possible value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n4 6 0\n0 3 2\n9 6 10\n92 256 23\n165 839 201\n1 14 5\n2 7 2\n96549 34359 13851\n853686404475946 283666553522252166 127929199446003072\n735268590557942972 916721749674600979 895150420120690183\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n1\n1\n164\n542\n5\n3\n37102\n27934920819538516\n104449824168870225\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test, when $$$r = 0$$$, then $$$x$$$ is definitely equal to $$$0$$$, so the answer is $$$|{4 \\oplus 0} - {6 \\oplus 0}| = |4 - 6| = 2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" When $$$x = 0$$$, $$$|{0 \\oplus 0} - {3 \\oplus 0}| = |0 - 3| = 3$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" When $$$x = 1$$$, $$$|{0 \\oplus 1} - {3 \\oplus 1}| = |1 - 2| = 1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" When $$$x = 2$$$, $$$|{0 \\oplus 2} - {3 \\oplus 2}| = |2 - 1| = 1$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Therefore, the answer is $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test, the minimum is achieved when $$$x = 1$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1918C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1918/problem/C"}