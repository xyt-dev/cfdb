{"assets":[],"contentKind":"statement","contestId":"542","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Place Your Ad Here"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ivan Anatolyevich's agency is starting to become famous in the town. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"They have already ordered and made "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" TV commercial videos. Each video is made in a special way: the colors and the soundtrack are adjusted to the time of the day and the viewers' mood. That's why the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th video can only be shown within the time range of "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":" (it is not necessary to use the whole segment but the broadcast time should be within this segment)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now it's time to choose a TV channel to broadcast the commercial. Overall, there are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" TV channels broadcasting in the city, the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th one has "},{"kind":"math_inline","text":"cj"},{"kind":"text","text":" viewers, and is ready to sell time "},{"kind":"math_inline","text":"[aj, bj]"},{"kind":"text","text":" to broadcast the commercial."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ivan Anatolyevich is facing a hard choice: he has to choose exactly one video "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and exactly one TV channel "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" to broadcast this video and also a time range to broadcast "},{"kind":"math_inline","text":"[x, y]"},{"kind":"text","text":". At that the time range should be chosen so that it is both within range "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":" and within range "},{"kind":"math_inline","text":"[aj, bj]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define the "},{"children":[{"kind":"text","text":"efficiency"}],"kind":"container"},{"kind":"text","text":" of the broadcast as value "},{"kind":"math_inline","text":"(y - x)·cj"},{"kind":"text","text":" — the total sum of time that all the viewers of the TV channel are going to spend watching the commercial. Help Ivan Anatolyevich choose the broadcast with the maximum "},{"children":[{"kind":"text","text":"efficiency"}],"kind":"container"},{"kind":"text","text":"!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 2·105"},{"kind":"text","text":") — the number of commercial videos and channels, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ li ≤ ri ≤ 109"},{"kind":"text","text":") — the segment of time when it is possible to show the corresponding video."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains three integers "},{"kind":"math_inline","text":"aj"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bj"},{"kind":"text","text":", "},{"kind":"math_inline","text":"cj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ aj ≤ bj ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ cj ≤ 109"},{"kind":"text","text":"), characterizing the TV channel."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print an integer — the maximum possible "},{"children":[{"kind":"text","text":"efficiency"}],"kind":"container"},{"kind":"text","text":" of the broadcast. If there is no correct way to get a strictly positive "},{"children":[{"kind":"text","text":"efficiency"}],"kind":"container"},{"kind":"text","text":", print a zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the maximum "},{"children":[{"kind":"text","text":"efficiency"}],"kind":"container"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"strictly"}],"kind":"container"},{"kind":"text","text":" positive, in the second line also print the number of the video "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") and the number of the TV channel "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j ≤ m"},{"kind":"text","text":") in the most effective broadcast."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple optimal answers, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n7 9\n1 4\n2 8 2\n0 4 1\n8 9 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n0 0\n1 1 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test the most optimal solution is to show the second commercial using the first TV channel at time "},{"kind":"math_inline","text":"[2, 4]"},{"kind":"text","text":". The efficiency of such solution is equal to "},{"kind":"math_inline","text":"(4 - 2)·2 = 4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test Ivan Anatolievich's wish does not meet the options of the TV channel, the segments do not intersect, so the answer is zero."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"542A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/542/problem/A"}