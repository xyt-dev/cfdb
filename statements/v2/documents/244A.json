{"assets":[],"contentKind":"statement","contestId":"244","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Dividing Orange"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day Ms Swan bought an orange in a shop. The orange consisted of "},{"kind":"math_inline","text":"n·k"},{"kind":"text","text":" segments, numbered with integers from 1 to "},{"kind":"math_inline","text":"n·k"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There were "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" children waiting for Ms Swan at home. The children have recently learned about the orange and they decided to divide it between them. For that each child took a piece of paper and wrote the number of the segment that he would like to get: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th "},{"kind":"math_inline","text":"(1 ≤ i ≤ k)"},{"kind":"text","text":" child wrote the number "},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"(1 ≤ ai ≤ n·k)"},{"kind":"text","text":". All numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" accidentally turned out to be different."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now the children wonder, how to divide the orange so as to meet these conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" each child gets exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" orange segments; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th child gets the segment with number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" for sure; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" no segment goes to two children simultaneously. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help the children, divide the orange and fulfill the requirements, described above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n, k ≤ 30)"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., ak"},{"kind":"math_inline","text":"(1 ≤ ai ≤ n·k)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the number of the orange segment that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th child would like to get."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print exactly "},{"kind":"math_inline","text":"n·k"},{"kind":"text","text":" distinct integers. The first "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers represent the indexes of the segments the first child will get, the second "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers represent the indexes of the segments the second child will get, and so on. Separate the printed numbers with whitespaces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print a child's segment indexes in any order. It is guaranteed that the answer always exists. If there are multiple correct answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 4 \n1 3 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 2 1 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"244A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/244/problem/A"}