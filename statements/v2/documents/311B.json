{"assets":[],"contentKind":"statement","contestId":"311","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Cats Transport"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Zxr960115 is owner of a large farm. He feeds "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" cute cats and employs "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" feeders. There's a straight road across the farm and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" hills along the road, numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right. The distance between hill "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(i - 1)"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" meters. The feeders live in hill 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One day, the cats went out to play. Cat "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" went on a trip to hill "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":", finished its trip at time "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", and then waited at hill "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" for a feeder. The feeders must take all the cats. Each feeder goes straightly from hill 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" without waiting at a hill and takes all the "},{"children":[{"kind":"text","text":"waiting"}],"kind":"container"},{"kind":"text","text":" cats at each hill away. Feeders walk at a speed of 1 meter per unit time and are strong enough to take as many cats as they want."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, suppose we have two hills "},{"kind":"math_inline","text":"(d2 = 1)"},{"kind":"text","text":" and one cat that finished its trip at time 3 at hill 2 "},{"kind":"math_inline","text":"(h1 = 2)"},{"kind":"text","text":". Then if the feeder leaves hill 1 at time 2 or at time 3, he can take this cat, but if he leaves hill 1 at time 1 he can't take it. If the feeder leaves hill 1 at time 2, the cat waits him for 0 time units, if the feeder leaves hill 1 at time 3, the cat waits him for 1 time units."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to schedule the time leaving from hill 1 for each feeder so that the sum of the waiting time of all cats is minimized."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n, m, p"},{"kind":"math_inline","text":"(2 ≤ n ≤ 105, 1 ≤ m ≤ 105, 1 ≤ p ≤ 100)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"d2, d3, ..., dn"},{"kind":"math_inline","text":"(1 ≤ di < 104)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ti"},{"kind":"math_inline","text":"(1 ≤ hi ≤ n, 0 ≤ ti ≤ 109)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output an integer, the minimum sum of waiting time of all cats."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not write the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 6 2\n1 3 5\n1 0\n2 1\n4 9\n1 10\n2 10\n3 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"311B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/311/problem/B"}