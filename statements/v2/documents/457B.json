{"assets":[],"contentKind":"statement","contestId":"457","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Distributed Join"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Piegirl was asked to implement two table join operation for distributed database system, minimizing the network traffic."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Suppose she wants to join two tables, "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":". Each of them has certain number of rows which are distributed on different number of partitions. Table "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is distributed on the first cluster consisting of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" partitions. Partition with index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" rows from "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". Similarly, second cluster containing table "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" partitions, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th one having "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" rows from "},{"kind":"math_inline","text":"B"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one network operation she can copy one row from any partition to any other partition. At the end, for each row from "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and each row from "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" there should be a partition that has both rows. Determine the minimal number of network operations to achieve this."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains two integer numbers, "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m, n ≤ 105"},{"kind":"text","text":"). Second line contains description of the first cluster with "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space separated integers, "},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 109)"},{"kind":"text","text":". Similarly, third line describes second cluster with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space separated integers, "},{"kind":"math_inline","text":"bi"},{"kind":"math_inline","text":"(1 ≤ bi ≤ 109)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — minimal number of copy operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n2 6\n3 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n10 10\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example it makes sense to move all the rows to the second partition of the second cluster which is achieved in "},{"kind":"math_inline","text":"2 + 6 + 3 = 11"},{"kind":"text","text":" operations"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example Piegirl can copy each row from "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" to the both partitions of the first cluster which needs "},{"kind":"math_inline","text":"2·3 = 6"},{"kind":"text","text":" copy operations."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"457B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/457/problem/B"}