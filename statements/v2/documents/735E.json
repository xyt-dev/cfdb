{"assets":[],"contentKind":"statement","contestId":"735","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Ostap and Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ostap already settled down in Rio de Janiero suburb and started to grow a tree in his garden. Recall that a tree is a connected undirected acyclic graph. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ostap's tree now has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. He wants to paint some vertices of the tree black such that from any vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" there is at least one black vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" at distance no more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"Distance"}],"kind":"container"},{"kind":"text","text":" between two vertices of the tree is the minimum possible number of edges of the path between them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As this number of ways to paint the tree can be large, Ostap wants you to compute it modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":". Two ways to paint the tree are considered different if there exists a vertex that is painted black in one way and is not painted in the other one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ min(20, n - 1)"},{"kind":"text","text":") — the number of vertices in Ostap's tree and the maximum allowed distance to the nearest black vertex. "},{"children":[{"kind":"text","text":"Don't miss"}],"kind":"container"},{"kind":"text","text":" the unusual constraint for "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain two integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":") — indices of vertices, connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge. It's guaranteed that given graph is a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the remainder of division of the number of ways to paint the tree by "},{"kind":"math_inline","text":"1 000 000 007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"