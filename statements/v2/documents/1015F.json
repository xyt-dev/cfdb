{"assets":[],"contentKind":"statement","contestId":"1015","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Bracket Substring"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a bracket sequence $$$s$$$ (not necessarily a regular one). A bracket sequence is a string containing only characters '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A regular bracket sequence is a bracket sequence that can be transformed into a correct arithmetic expression by inserting characters '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' between the original characters of the sequence. For example, bracket sequences \""},{"children":[{"kind":"text","text":"()()"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(())"}],"kind":"container"},{"kind":"text","text":"\" are regular (the resulting expressions are: \""},{"children":[{"kind":"text","text":"(1)+(1)"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"((1+1)+1)"}],"kind":"container"},{"kind":"text","text":"\"), and \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your problem is to calculate the number of regular bracket sequences of length $$$2n$$$ containing the given bracket sequence $$$s$$$ as a substring (consecutive sequence of characters) modulo $$$10^9+7$$$ ($$$1000000007$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$n$$$ ($$$1 \\le n \\le 100$$$) — the half-length of the resulting regular bracket sequences (the resulting sequences must have length equal to $$$2n$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains one string $$$s$$$ ($$$1 \\le |s| \\le 200$$$) — the string $$$s$$$ that should be a substring in each of the resulting regular bracket sequences ($$$|s|$$$ is the length of $$$s$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print only one integer — the number of regular bracket sequences containing the given bracket sequence $$$s$$$ as a substring. Since this number can be huge, print it modulo $$$10^9+7$$$ ($$$1000000007$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n()))()\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n(()\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n(((\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"All regular bracket sequences satisfying the conditions above for the first example: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"(((()))())"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"((()()))()"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"((()))()()"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"(()(()))()"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"()((()))()"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"All regular bracket sequences satisfying the conditions above for the second example: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"((()))"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"(()())"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"(())()"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"()(())"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"And there is no regular bracket sequences of length $$$4$$$ containing \""},{"children":[{"kind":"text","text":"((("}],"kind":"container"},{"kind":"text","text":"\" as a substring in the third example."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1015F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1015/problem/F"}