{"assets":[],"contentKind":"statement","contestId":"100","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Battleship"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Do you know the game Battleship? If no, look into Wikipedia article http://en.wikipedia.org/wiki/Battleship_(game). You are given the positions of ships on a "},{"kind":"math_inline","text":"10 × 10"},{"kind":"text","text":" board for playing Battleship. According to the rules, the board should contain the following ships: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" one of size 4 ("},{"kind":"math_inline","text":"4 × 1"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"1 × 4"},{"kind":"text","text":" rectangle), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" two of size 3 ("},{"kind":"math_inline","text":"3 × 1"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"1 × 3"},{"kind":"text","text":" rectangles), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" three of size 2 ("},{"kind":"math_inline","text":"2 × 1"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"1 × 2"},{"kind":"text","text":" rectangles), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" four of size 1 ("},{"kind":"math_inline","text":"1 × 1"},{"kind":"text","text":" rectangles). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The ships should not 'bend', touch each other or overlap in any way. Each ship can be oriented horizontaly or verticaly. Your task is to check whether the given set of boards meets the given conditions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10"},{"kind":"text","text":") — the number of boards. Each board is described by 10 lines containing 10 characters each. The symbol \"0\" stands for an empty square and the symbol \"*\" stands for a square occupied by a ship. The descriptions of boards are separated with empty lines."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines YES or NO. Print the first word if the board meets the given conditions; otherwise print the second word."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n****000000\n0000000000\n***00***00\n0000000000\n00000000**\n000**00000\n00000000**\n000*000000\n00000*00*0\n0*00000000\n\n****000000\n0000000000\n***00***00\n0000000000\n00000000**\n000**00000\n00000000**\n0000*00000\n00000*00*0\n0*00000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"100H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/100/problem/H"}