{"assets":[],"contentKind":"statement","contestId":"391","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Word Folding"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"You will receive 5 points for solving this problem."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Manao has invented a new operation on strings that is called folding. Each fold happens between a pair of consecutive letters and places the second part of the string above first part, running in the opposite direction and aligned to the position of the fold. Using this operation, Manao converts the string into a structure that has one more level than there were fold operations performed. See the following examples for clarity."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We will denote the positions of folds with '"},{"children":[{"kind":"text","text":"|"}],"kind":"container"},{"kind":"text","text":"' characters. For example, the word \""},{"children":[{"kind":"text","text":"ABRACADABRA"}],"kind":"container"},{"kind":"text","text":"\" written as \""},{"children":[{"kind":"text","text":"AB|RACA|DAB|RA"}],"kind":"container"},{"kind":"text","text":"\" indicates that it has been folded three times: first, between the leftmost pair of '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"' letters; second, between '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"'; and third, between the rightmost pair of '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"' letters. Here are several examples of folded strings:"}],"kind":"paragraph"},{"kind":"code_block","text":"\n\"ABCDEF|GHIJK\" |  \"A|BCDEFGHIJK\" |  \"AB|RACA|DAB|RA\" |  \"X|XXXXX|X|X|XXXXXX\"\n               |                 |                   |       XXXXXX\n    KJIHG      |   KJIHGFEDCB    |      AR           |       X\n   ABCDEF      |            A    |     DAB           |       X\n               |                 |     ACAR          |       XXXXX\n               |                 |       AB          |           X\n"},{"children":[{"kind":"text","text":"One last example for \""},{"children":[{"kind":"text","text":"ABCD|EFGH|IJ|K"}],"kind":"container"},{"kind":"text","text":"\": "}],"kind":"paragraph"},{"kind":"code_block","text":"\n K\nIJ\nHGFE\nABCD\n"},{"children":[{"kind":"text","text":"Manao noticed that each folded string can be viewed as several piles of letters. For instance, in the previous example, there are four piles, which can be read as \""},{"children":[{"kind":"text","text":"AHI"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"BGJK"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"CF"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"DE"}],"kind":"container"},{"kind":"text","text":"\" from bottom to top. Manao wonders what is the highest pile of identical letters he can build using fold operations on a given word. Note that the pile should not contain gaps and should start at the bottom level. For example, in the rightmost of the four examples above, none of the piles would be considered valid since each of them has gaps, starts above the bottom level, or both."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input will consist of one line containing a single string of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters with "},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":" and no spaces. All characters of the string will be uppercase letters."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"This problem doesn't have subproblems. You will get 5 points for the correct submission."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the size of the largest pile composed of identical characters that can be seen in a valid result of folding operations on the given string."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ABRACADABRA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ABBBCBDB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"AB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first example. Manao can create a pile of three '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"'s using the folding \""},{"children":[{"kind":"text","text":"AB|RACAD|ABRA"}],"kind":"container"},{"kind":"text","text":"\", which results in the following structure: "}],"kind":"paragraph"},{"kind":"code_block","text":"\nABRA\nDACAR\n   AB\n"},{"children":[{"kind":"text","text":"In the second example, Manao can create a pile of three '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"'s using the following folding: \""},{"children":[{"kind":"text","text":"AB|BB|CBDB"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"paragraph"},{"kind":"code_block","text":"\nCBDB\nBB\nAB\n"},{"children":[{"kind":"text","text":"Another way for Manao to create a pile of three '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"'s with \""},{"children":[{"kind":"text","text":"ABBBCBDB"}],"kind":"container"},{"kind":"text","text":"\" is the following folding: \""},{"children":[{"kind":"text","text":"AB|B|BCBDB"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"paragraph"},{"kind":"code_block","text":"\n BCBDB\n B\nAB\n"},{"children":[{"kind":"text","text":"In the third example, there are no folds performed and the string is just written in one line."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"391B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/391/problem/B"}