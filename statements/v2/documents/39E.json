{"assets":[],"contentKind":"statement","contestId":"39","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. What Has Dirichlet Got to Do with That?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You all know the Dirichlet principle, the point of which is that if "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" boxes have no less than "},{"kind":"math_inline","text":"n + 1"},{"kind":"text","text":" items, that leads to the existence of a box in which there are at least two items."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Having heard of that principle, but having not mastered the technique of logical thinking, 8 year olds Stas and Masha invented a game. There are "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" different boxes and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" different items, and each turn a player can either add a new box or a new item. The player, after whose turn the number of ways of putting "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" items into "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" boxes becomes no less then a certain given number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", loses. All the boxes and items are considered to be different. Boxes may remain empty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Who loses if both players play optimally and Stas's turn is first?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only input line has three integers "},{"kind":"math_inline","text":"a, b, n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a ≤ 10000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ b ≤ 30"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ n ≤ 109"},{"kind":"text","text":") — the initial number of the boxes, the number of the items and the number which constrains the number of ways, respectively. Guaranteed that the initial number of ways is strictly less than "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output \"Stas\" if Masha wins. Output \"Masha\" if Stas wins. In case of a draw, output \"Missing\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Masha\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5 16808\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Masha\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Stas\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 4 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Missing\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second example the initial number of ways is equal to "},{"kind":"math_inline","text":"3125"},{"kind":"text","text":". "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If Stas increases the number of boxes, he will lose, as Masha may increase the number of boxes once more during her turn. After that any Stas's move will lead to defeat. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" But if Stas increases the number of items, then any Masha's move will be losing. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"39E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/39/problem/E"}