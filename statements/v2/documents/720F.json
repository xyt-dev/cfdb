{"assets":[],"contentKind":"statement","contestId":"720","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Array Covering"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Misha has an array of integers of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". He wants to choose "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" different continuous subarrays, so that each element of the array belongs to at least one of the chosen subarrays."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Misha wants to choose the subarrays in such a way that if he calculated the sum of elements for each subarray, and then add up all these sums, the resulting value was maximum possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ n·(n + 1) / 2"},{"kind":"text","text":") — the number of elements in the array and the number of different subarrays that must be chosen."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 50 000 ≤ ai ≤ 50 000"},{"kind":"text","text":") — the elements of the array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one integer — the maximum possible value Misha can get by choosing "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" different subarrays."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n6 -4 -10 -4 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"720F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/720/problem/F"}