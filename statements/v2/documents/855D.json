}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In test case "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", as object "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" is a special case of object "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and object "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" has object "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", this will mean that object "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" will also have object "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". This is because when a general case (object "},{"kind":"math_inline","text":"1"},{"kind":"text","text":") has object "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", its special case (object "},{"kind":"math_inline","text":"2"},{"kind":"text","text":") will definitely have object "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"855D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/855/problem/D"}