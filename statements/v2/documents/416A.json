{"assets":[],"contentKind":"statement","contestId":"416","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Guess a number!"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A TV show called \"Guess a number!\" is gathering popularity. The whole Berland, the old and the young, are watching the show."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The rules are simple. The host thinks of an integer "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" and the participants guess it by asking questions to the host. There are four types of acceptable questions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Is it true that "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is strictly larger than number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"? "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Is it true that "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is strictly smaller than number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"? "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Is it true that "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is larger than or equal to number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"? "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Is it true that "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is smaller than or equal to number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"? "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"On each question the host answers truthfully, \"yes\" or \"no\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the sequence of questions and answers, find any integer value of "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" that meets the criteria of all answers. If there isn't such value, print \""},{"children":[{"kind":"text","text":"Impossible"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10000"},{"kind":"text","text":") — the number of questions (and answers). Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each contain one question and one answer to it. The format of each line is like that: \""},{"children":[{"kind":"text","text":"sign x answer"}],"kind":"container"},{"kind":"text","text":"\", where the "},{"children":[{"kind":"text","text":"sign"}],"kind":"container"},{"kind":"text","text":" is:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":"\" (for the first type queries), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":"\" (for the second type queries), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":">="}],"kind":"container"},{"kind":"text","text":"\" (for the third type queries), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"<="}],"kind":"container"},{"kind":"text","text":"\" (for the fourth type queries). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"All values of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" are integer and meet the inequation "},{"kind":"math_inline","text":" - 109 ≤ x ≤ 109"},{"kind":"text","text":". The "},{"children":[{"kind":"text","text":"answer"}],"kind":"container"},{"kind":"text","text":" is an English letter \""},{"children":[{"kind":"text","text":"Y"}],"kind":"container"},{"kind":"text","text":"\" (for \"yes\") or \""},{"children":[{"kind":"text","text":"N"}],"kind":"container"},{"kind":"text","text":"\" (for \"no\")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consequtive elements in lines are separated by a single space."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print any of such integers "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", that the answers to all the queries are correct. The printed number "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" must meet the inequation "},{"kind":"math_inline","text":" - 2·109 ≤ y ≤ 2·109"},{"kind":"text","text":". If there are many answers, print any of them. If such value doesn't exist, print word \""},{"children":[{"kind":"text","text":"Impossible"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":