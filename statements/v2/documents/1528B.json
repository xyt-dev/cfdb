{"assets":["/statement-assets/9ed673e220fe4f48a77dba60e0acbac50b34fb3b307cd1477951ce3941a75ebc.png","/statement-assets/35c19ca4bce6efe89bed1c31764d268df004e08d19f466ae550569d461278b88.png","/statement-assets/1dc8efd15f577471b8bf7a66215ab881ee703cd2a0413cecd7bb4bd246a2bcc3.png"],"contentKind":"statement","contestId":"1528","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Kavi on Pairing Duty"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Kavi has $$$2n$$$ points lying on the $$$OX$$$ axis, $$$i$$$-th of which is located at $$$x = i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Kavi considers all ways to split these $$$2n$$$ points into $$$n$$$ pairs. Among those, he is interested in "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" pairings, which are defined as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider $$$n$$$ segments with ends at the points in correspondent pairs. The pairing is called good, if for every $$$2$$$ different segments $$$A$$$ and $$$B$$$ among those, at least one of the following holds:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" One of the segments $$$A$$$ and $$$B$$$ lies completely inside the other. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$A$$$ and $$$B$$$ have the same length. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Consider the following example:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9ed673e220fe4f48a77dba60e0acbac50b34fb3b307cd1477951ce3941a75ebc.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"$$$A$$$ is a good pairing since the red segment lies completely inside the blue segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$B$$$ is a good pairing since the red and the blue segment have the same length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$C$$$ is not a good pairing since none of the red or blue segments lies inside the other, neither do they have the same size."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Kavi is interested in the number of good pairings, so he wants you to find it for him. As the result can be large, find this number modulo $$$998244353$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two pairings are called different, if some two points are in one pair in some pairing and in different pairs in another."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line of the input contains a single integer $$$n$$$ $$$(1\\le n \\le 10^6)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of good pairings modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n6"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n688750769"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The good pairings for the second example are: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/35c19ca4bce6efe89bed1c31764d268df004e08d19f466ae550569d461278b88.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the third example, the good pairings are: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1dc8efd15f577471b8bf7a66215ab881ee703cd2a0413cecd7bb4bd246a2bcc3.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1528B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1528/problem/B"}