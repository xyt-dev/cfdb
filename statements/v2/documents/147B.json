{"assets":["/statement-assets/cf95950dde7fa8dc743544d6da48749f4a1c24094238bb988b6d7e66eda7a8db.png"],"contentKind":"statement","contestId":"147","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Smile House"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A smile house is created to raise the mood. It has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rooms. Some of the rooms are connected by doors. For each two rooms (number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"), which are connected by a door, Petya knows their value "},{"kind":"math_inline","text":"cij"},{"kind":"text","text":" — the value which is being added to his mood when he moves from room "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to room "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya wondered whether he can raise his mood infinitely, moving along some cycle? And if he can, then what minimum number of rooms he will need to visit during one period of a cycle?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/cf95950dde7fa8dc743544d6da48749f4a1c24094238bb988b6d7e66eda7a8db.png"},"kind":"image"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the number of rooms, and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is the number of doors in the Smile House. Then follows the description of the doors: "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines each containing four integers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", "},{"kind":"math_inline","text":"cij"},{"kind":"text","text":" и "},{"kind":"math_inline","text":"cji"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i, j ≤ n, i ≠ j,  - 104 ≤ cij, cji ≤ 104"},{"kind":"text","text":"). It is guaranteed that no more than one door connects any two rooms. No door connects the room with itself."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of rooms that one needs to visit during one traverse of the cycle that can raise mood infinitely. If such cycle does not exist, print number "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n1 2 -10 3\n1 3 1 -10\n2 4 -10 -1\n3 4 0 -3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Cycle is such a sequence of rooms "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"ak"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":" is connected with "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":" is connected with "},{"kind":"math_inline","text":"a3"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"ak - 1"},{"kind":"text","text":" is connected with "},{"kind":"math_inline","text":"ak"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ak"},{"kind":"text","text":" is connected with "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":". Some elements of the sequence can coincide, that is, the cycle should not necessarily be simple. The number of rooms in the cycle is considered as "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", the sequence's length. Note that the minimum possible length equals two."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"147B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/147/problem/B"}