{"assets":["/statement-assets/aedcb0389e86f38ad00f828cd8e2cec8662b9ee2a005c6c06380ccd5ffb29796.png"],"contentKind":"statement","contestId":"274","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Mirror Room"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Imagine an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" grid with some blocked cells. The top left cell in the grid has coordinates "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" and the bottom right cell has coordinates "},{"kind":"math_inline","text":"(n, m)"},{"kind":"text","text":". There are "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" blocked cells in the grid and others are empty. You flash a laser beam from the center of an empty cell "},{"kind":"math_inline","text":"(xs, ys)"},{"kind":"text","text":" in one of the diagonal directions (i.e. north-east, north-west, south-east or south-west). If the beam hits a blocked cell or the border of the grid it will reflect. The behavior of the beam reflection in different situations is depicted in the figure below. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/aedcb0389e86f38ad00f828cd8e2cec8662b9ee2a005c6c06380ccd5ffb29796.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"After a while the beam enters an infinite cycle. Count the number of empty cells that the beam goes through at least once. We consider that the beam goes through cell if it goes through its center."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 105, 0 ≤ k ≤ 105)"},{"kind":"text","text":". Each of the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"math_inline","text":"(1 ≤ xi ≤ n, 1 ≤ yi ≤ m)"},{"kind":"text","text":" indicating the position of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th blocked cell. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line contains "},{"kind":"math_inline","text":"xs"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ys"},{"kind":"math_inline","text":"(1 ≤ xs ≤ n, 1 ≤ ys ≤ m)"},{"kind":"text","text":" and the flash direction which is equal to \""},{"children":[{"kind":"text","text":"NE"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"NW"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"SE"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"SW"}],"kind":"container"},{"kind":"text","text":"\". These strings denote directions "},{"kind":"math_inline","text":"( - 1, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"( - 1,  - 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1,  - 1)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that no two blocked cells have the same coordinates."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line of the output print the number of empty cells that the beam goes through at least once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not write the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 0\n1 2 SW\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 5 3\n3 3\n4 3\n5 3\n2 1 SE\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"274E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/274/problem/E"}