{"assets":[],"contentKind":"statement","contestId":"348","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Apple Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a rooted tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. In each leaf vertex there's a single integer — the number of apples in this vertex. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"weight"}],"kind":"container"},{"kind":"text","text":" of a subtree is the sum of all numbers in this subtree leaves. For instance, the weight of a subtree that corresponds to some leaf is the number written in the leaf."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A tree is "},{"children":[{"kind":"text","text":"balanced"}],"kind":"container"},{"kind":"text","text":" if for every vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" of the tree all its subtrees, corresponding to the children of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", are of equal weight. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Count the minimum number of apples that you need to remove from the tree (specifically, from some of its leaves) in order to make the tree balanced. Notice that you can always achieve the goal by just removing all apples."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(2 ≤ n ≤ 105)"},{"kind":"text","text":", showing the number of vertices in the tree. The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(0 ≤ ai ≤ 108)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the number of apples in the vertex number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". The number of apples in non-leaf vertices is guaranteed to be zero. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines, describing the tree edges. Each line contains a pair of integers "},{"kind":"math_inline","text":"xi, yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ n, xi ≠ yi"},{"kind":"text","text":") — the vertices connected by an edge. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The vertices are indexed from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Vertex 1 is the root."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum number of apples to remove in order to make the tree balanced."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not write the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the sin, cout streams "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n0 0 12 13 5 6\n1 2\n1 3\n1 4\n2 5\n2 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"348B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/348/problem/B"}