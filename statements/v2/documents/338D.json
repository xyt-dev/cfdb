{"assets":[],"contentKind":"statement","contestId":"338","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. GCD Table"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider a table "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"G(i, j) = GCD(i, j)"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"1 ≤ i ≤ n, 1 ≤ j ≤ m"},{"kind":"text","text":". "},{"kind":"math_inline","text":"GCD(a, b)"},{"kind":"text","text":" is the greatest common divisor of numbers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have a sequence of positive integer numbers "},{"kind":"math_inline","text":"a1, a2, ..., ak"},{"kind":"text","text":". We say that this sequence occurs in table "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" if it coincides with consecutive elements in some row, starting from some position. More formally, such numbers "},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 ≤ j ≤ m - k + 1"},{"kind":"text","text":" should exist that "},{"kind":"math_inline","text":"G(i, j + l - 1) = al"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"1 ≤ l ≤ k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine if the sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" occurs in table "},{"kind":"math_inline","text":"G"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 1012"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"1 ≤ k ≤ 10000"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., ak"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 1012"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single word \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\", if the given sequence occurs in table "},{"kind":"math_inline","text":"G"},{"kind":"text","text":", otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"100 100 5\n5 2 1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"100 8 5\n5 2 1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"100 100 7\n1 2 3 4 5 6 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Sample 1. The tenth row of table "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" starts from sequence {1, 2, 1, 2, 5, 2, 1, 2, 1, 10}. As you can see, elements from fifth to ninth coincide with sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sample 2. This time the width of table "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" equals 8. Sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" doesn't occur there."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"338D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/338/problem/D"}