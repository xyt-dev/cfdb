{"assets":[],"contentKind":"statement","contestId":"799","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Aquarium decoration"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Arkady and Masha want to choose decorations for thier aquarium in Fishdom game. They have "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" decorations to choose from, each of them has some cost. To complete a task Arkady and Masha need to choose "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"math_inline","text":"m"},{"kind":"text","text":" decorations from given, and they want to spend as little money as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is one difficulty: Masha likes some "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of the given decorations, Arkady likes some "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" of the given decorations. Some decorations may be liked by both Arkady and Masha, or not be liked by both. The friends want to choose such decorations so that each of them likes "},{"children":[{"kind":"text","text":"at least"}],"kind":"container"},{"kind":"math_inline","text":"k"},{"kind":"text","text":" decorations among the chosen. Help Masha and Arkady find the minimum sum of money they need to spend."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":") — the number of decorations, how many decorations the friends should choose, how many decorations each of them should like among the chosen."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci ≤ 109"},{"kind":"text","text":") — decorations costs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains single integer "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a ≤ n"},{"kind":"text","text":") — the number of decorations liked by Masha. The fourth line contains "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"x1, x2, ..., xa"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ n"},{"kind":"text","text":") — the ids of decorations liked by Masha."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next two lines describe decorations liked by Arkady in the same format."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print single integer: the minimum sum of money the friends should spend to fulfill all constraints. If it is not possible, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 2\n3 2 2 1\n2\n1 2\n2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 2\n3 2 2 1\n2\n1 2\n3\n4 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 2\n3 2 2 1\n2\n1 2\n3\n4 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the only possible variant to choose "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" decorations having all conditions satisfied is to choose decorations "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example friends can choose decoration "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" instead of decoration "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", because this one is one coin cheaper."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example it's not possible to choose "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" decorations in a way that both are liked by both Masha and Arkady."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"799E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/799/problem/E"}