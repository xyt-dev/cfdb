{"assets":[],"contentKind":"statement","contestId":"677","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Vanya and Food Processor"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vanya smashes potato in a vertical food processor. At each moment of time the height of the potato in the processor doesn't exceed "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" and the processor smashes "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" centimeters of potato each second. If there are less than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" centimeters remaining, than during this second processor smashes all the remaining potato."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vanya has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pieces of potato, the height of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th piece is equal to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". He puts them in the food processor one by one starting from the piece number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and finishing with piece number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Formally, each second the following happens:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" If there is at least one piece of potato remaining, Vanya puts them in the processor one by one, until there is not enough space for the next piece. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Processor smashes "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" centimeters of potato (or just everything that is inside). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Provided the information about the parameter of the food processor and the size of each potato in a row, compute how long will it take for all the potato to become smashed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000, 1 ≤ k ≤ h ≤ 109"},{"kind":"text","text":") — the number of pieces of potato, the height of the food processor and the amount of potato being smashed each second, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ h"},{"kind":"text","text":") — the heights of the pieces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of seconds required to smash all the potatoes following the process described in the problem statement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6 3\n5 4 3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6 3\n5 5 5 5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6 3\n1 2 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first sample. "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" First Vanya puts the piece of potato of height "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" into processor. At the end of the second there is only amount of height "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" remaining inside. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Now Vanya puts the piece of potato of height "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". At the end of the second there is amount of height "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" remaining. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Vanya puts the piece of height "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" inside and again there are only "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" centimeters remaining at the end of this second. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Vanya finally puts the pieces of height "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" inside. At the end of the second the height of potato in the processor is equal to "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" During this second processor finally smashes all the remaining potato and the process finishes. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second sample, Vanya puts the piece of height "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" inside and waits for "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" seconds while it is completely smashed. Then he repeats the same process for "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" other pieces. The total time is equal to "},{"kind":"math_inline","text":"2·5 = 10"},{"kind":"text","text":" seconds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, Vanya simply puts all the potato inside the processor and waits "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" seconds."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"677B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/677/problem/B"}