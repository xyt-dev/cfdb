{"assets":["/statement-assets/b968410a31c84b77eea82ecfb465fead6368547585a98ff7685f39f0a10c4eb5.png"],"contentKind":"statement","contestId":"584","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Dima and Lisa"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dima loves representing an odd number as the sum of multiple primes, and Lisa loves it when there are at most three primes. Help them to represent the given number as the sum of at most than three primes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, you are given an "},{"children":[{"kind":"text","text":"odd"}],"kind":"container"},{"kind":"text","text":" numer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Find a set of numbers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ k"},{"kind":"text","text":"), such that"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"1 ≤ k ≤ 3"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"pi"},{"kind":"text","text":" is a prime"}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b968410a31c84b77eea82ecfb465fead6368547585a98ff7685f39f0a10c4eb5.png"},"kind":"image"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The numbers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" do not necessarily have to be distinct. It is guaranteed that at least one possible solution exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains an odd number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n < 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ k ≤ 3)"},{"kind":"text","text":", showing how many numbers are in the representation you found."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print numbers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" in any order. If there are multiple possible solutions, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"27\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n5 11 11\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A prime is an integer strictly larger than one that is divisible only by one and by itself."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"584D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/584/problem/D"}