{"assets":[],"contentKind":"statement","contestId":"1491","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Switch and Flip"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are $$$n$$$ coins labeled from $$$1$$$ to $$$n$$$. Initially, coin $$$c_i$$$ is on position $$$i$$$ and is facing upwards (($$$c_1, c_2, \\dots, c_n)$$$ is a permutation of numbers from $$$1$$$ to $$$n$$$). You can do some operations on these coins. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one operation, you can do the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"Choose $$$2$$$ distinct indices $$$i$$$ and $$$j$$$."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Then, swap the coins on positions $$$i$$$ and $$$j$$$."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Then, flip both coins on positions $$$i$$$ and $$$j$$$. (If they are initially faced up, they will be faced down after the operation and vice versa)"}],"kind":"paragraph"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Construct a sequence of at most $$$n+1$$$ operations such that after performing all these operations the coin $$$i$$$ will be on position $$$i$$$ at the end, "},{"children":[{"kind":"text","text":"facing up"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that you "},{"children":[{"kind":"text","text":"do not need"}],"kind":"container"},{"kind":"text","text":" to minimize the number of operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$n$$$ ($$$3 \\leq n \\leq 2 \\cdot 10^5$$$) — the number of coins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$c_1,c_2,\\dots,c_n$$$ ($$$1 \\le c_i \\le n$$$, $$$c_i \\neq c_j$$$ for $$$i\\neq j$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, output an integer $$$q$$$ $$$(0 \\leq q \\leq n+1)$$$ — the number of operations you used."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the following $$$q$$$ lines, output two integers $$$i$$$ and $$$j$$$ $$$(1 \\leq i, j \\leq n, i \\ne j)$$$ — the positions you chose for the current operation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 3\n3 2\n3 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 2 3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let coin $$$i$$$ facing upwards be denoted as $$$i$$$ and coin $$$i$$$ facing downwards be denoted as $$$-i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The series of moves performed in the first sample changes the coins as such:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[~~~2,~~~1,~~~3]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[-3,~~~1,-2]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[-3,~~~2,-1]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[~~~1,~~~2,~~~3]$$$ "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second sample, the coins are already in their correct positions so there is no need to swap."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1491G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1491/problem/G"}