{"assets":["/statement-assets/90386a4e24bf3bc6474299110fe9518ef8864e6a7c80a384a0f316df2796344a.png","/statement-assets/37c2c62830767f2d81ca8c4b73539bbf487adbe5e1dd3cdd342f114d9f8a8b82.png"],"contentKind":"statement","contestId":"71","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Progress Bar"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A progress bar is an element of graphical interface that displays the progress of a process for this very moment before it is completed. Let's take a look at the following form of such a bar."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A bar is represented as "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" squares, located in line. To add clarity, let's number them with positive integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from the left to the right. Each square has saturation ("},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th square), which is measured by an integer from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". When the bar for some "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") is displayed, squares "},{"kind":"math_inline","text":"1, 2, ... , i - 1"},{"kind":"text","text":" has the saturation "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", squares "},{"kind":"math_inline","text":"i + 1, i + 2, ... , n"},{"kind":"text","text":" has the saturation "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", and the saturation of the square "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" can have any value from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So some first squares of the progress bar always have the saturation "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Some last squares always have the saturation "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". And there is no more than one square that has the saturation different from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The degree of the process's completion is measured in percents. Let the process be "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"% completed. Then the following inequation is fulfilled: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/90386a4e24bf3bc6474299110fe9518ef8864e6a7c80a384a0f316df2796344a.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"An example of such a bar can be seen on the picture."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/37c2c62830767f2d81ca8c4b73539bbf487adbe5e1dd3cdd342f114d9f8a8b82.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"For the given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" determine the measures of saturation for all the squares "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" of the progress bar."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"We are given 3 space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, k ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ t ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should be equal to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 10 54\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10 10 10 10 10 4 0 0 0 0 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11 13 37\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13 13 13 13 0 0 0 0 0 0 0 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"71B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/71/problem/B"}