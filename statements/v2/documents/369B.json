{"assets":[],"contentKind":"statement","contestId":"369","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Valera and Contest"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Valera loves to participate in competitions. Especially in programming contests. Today he has participated in the contest with his team, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students (including Valera). This contest was an individual competition, so each student in the team solved problems individually."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the contest was over, Valera was interested in results. He found out that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" each student in the team scored at least "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" points and at most "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" points; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in total, all members of the team scored exactly "},{"kind":"math_inline","text":"sall"},{"kind":"text","text":" points; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the total score of the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" members of the team who scored the most points is equal to exactly "},{"kind":"math_inline","text":"sk"},{"kind":"text","text":"; more formally, if "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" is the sequence of points earned by the team of students in the non-increasing order "},{"kind":"math_inline","text":"(a1 ≥ a2 ≥ ... ≥ an)"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"sk = a1 + a2 + ... + ak"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"However, Valera did not find out exactly how many points each of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students scored. Valera asked you to recover any distribution of scores between the students of the team, such that all the conditions above are met."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains exactly six integers "},{"kind":"math_inline","text":"n, k, l, r, sall, sk"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, k, l, r ≤ 1000"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"l ≤ r"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"k ≤ n"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"1 ≤ sk ≤ sall ≤ 106"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the input is such that the answer exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" — the number of points each student scored. If there are multiple solutions, you can print any of them. You can print the distribution of points in any order. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3 1 3 13 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 3 2 3 3 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3 1 3 15 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 3 3 3 3 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"369B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/369/problem/B"}