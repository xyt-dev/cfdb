ading"},{"kind":"code_block","text":"\n..........\n...*....*.\n.*.o....o.\n.*........\n.*......**\n.o.*....o*\n\n....**ooo\n.*o**o.*o\n\n.....\n*...*\n*****\n*****\n*****\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1669G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1669/problem/G"}