{"assets":[],"contentKind":"statement","contestId":"1669","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Fall Down"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a grid with $$$n$$$ rows and $$$m$$$ columns, and three types of cells: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" An empty cell, denoted with '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A stone, denoted with '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" An obstacle, denoted with the lowercase Latin letter '"},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"All stones fall down until they meet the floor (the bottom row), an obstacle, or other stone which is already immovable. (In other words, all the stones just fall down as long as they can fall.)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Simulate the process. What does the resulting grid look like?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of multiple test cases. The first line contains an intege