{"assets":[],"contentKind":"statement","contestId":"534","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Exam"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"An exam for "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students will take place in a long and narrow room, so the students will sit in a line in some order. The teacher suspects that students with adjacent numbers ("},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":") always studied side by side and became friends and if they take an exam sitting next to each other, they will help each other for sure."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to choose the maximum number of students and make such an arrangement of students in the room that no two students with adjacent numbers sit side by side."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5000"},{"kind":"text","text":") — the number of students at an exam."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the maximum number of students who can be seated so that no two students with adjacent numbers sit next to each other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"a1, a2, ..., ak"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ n"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the number of the student on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th position. The students on adjacent positions mustn't have adjacent numbers. Formally, the following should be true: "},{"kind":"math_inline","text":"|ai - ai + 1| ≠ 1"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k - 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"If there are several possible answers, output any of them."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 5 3 6 2 4"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 3"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"534A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/534/problem/A"}