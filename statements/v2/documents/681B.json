{"assets":[],"contentKind":"statement","contestId":"681","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Economy Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Kolya is developing an economy simulator game. His most favourite part of the development process is in-game testing. Once he was entertained by the testing so much, that he found out his game-coin score become equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Kolya remembers that at the beginning of the game his game-coin score was equal to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and that he have bought only some houses (for "},{"kind":"math_inline","text":"1 234 567"},{"kind":"text","text":" game-coins each), cars (for "},{"kind":"math_inline","text":"123 456"},{"kind":"text","text":" game-coins each) and computers (for "},{"kind":"math_inline","text":"1 234"},{"kind":"text","text":" game-coins each)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Kolya is now interested, whether he could have spent all of his initial "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" game-coins buying only houses, cars and computers or there is a bug in the game. Formally, is there a triple of non-negative integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"a × 1 234 567 + b × 123 456 + c × 1 234 = n"},{"kind":"text","text":"?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please help Kolya answer this question."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 109"},{"kind":"text","text":") — Kolya's initial game-coin score."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if it's possible that Kolya spent all of his initial "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" coins buying only houses, cars and computers. Otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1359257\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"17851817\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, one of the possible solutions is to buy one house, one car and one computer, spending "},{"kind":"math_inline","text":"1 234 567 + 123 456 + 1234 = 1 359 257"},{"kind":"text","text":" game-coins in total."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"681B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/681/problem/B"}