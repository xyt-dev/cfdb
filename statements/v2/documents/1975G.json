{"assets":[],"contentKind":"statement","contestId":"1975","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Zimpha Fan Club"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"12 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day, Zimpha casually came up with a problem. As a member of \"Zimpha fan club\", you decided to solve that problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given two strings $$$s$$$ and $$$t$$$ of length $$$n$$$ and $$$m$$$, respectively. Both strings only consist of lowercase English letters, "},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to replace all occurrences of "},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":", observing the following rules:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" For each "},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":", you must replace it with any lowercase English letter. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For each "},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":", you must replace it with a string of any (possibly, zero) length which only consists of lowercase English letters. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that you can replace two different instances of "},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":" with different characters. You can also replace each two different instances of "},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":" with different strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Suppose $$$s$$$ and $$$t$$$ have been transformed into $$$s'$$$ and $$$t'$$$. Now you're wondering if there's a replacement that makes $$$s'=t'$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\leq n, m \\leq 2 \\cdot 10^6$$$) — the length of the strings $$$s$$$ and $$$t$$$, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string $$$s$$$ of length $$$n$$$. It is guaranteed that $$$s$$$ only consists of lowercase English letters, "},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains the string $$$t$$$ of length $$$m$$$. It is guaranteed that $$$t$$$ only consists of lowercase English letters, "},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" if there is a replacement that makes $$$s'=t'$$$, and output \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" in any case (for example, strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be recognized as a positive response)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10 10\njustmonika\nj-stsayori\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNo"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7 8\nttk-wxx\n*tt-l-xx\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}