,"text":". In $$$t$$$, "},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":" will be replaced by the empty string with the first and second "},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":" will be replaced with "},{"children":[{"kind":"text","text":"k"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"w"}],"kind":"container"},{"kind":"text","text":" respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth test case, we can transform both strings into "},{"children":[{"kind":"text","text":"bulijiojioxdibuliduo"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1975G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1975/problem/G"}