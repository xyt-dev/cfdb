{"assets":["/statement-assets/dc96d1c8eb35f9611080e3eaeef6a20ff34778b318febcaed8cf8f986b69b6f5.png","/statement-assets/30c3778bb20cd8cd654b091022d5f96023479174906402de2e7de48a43cc2d3c.png","/statement-assets/c25e541ba102aba9c541e132e8ea8f8406e7aea7dc0bceb366e7c4e13b957193.png"],"contentKind":"statement","contestId":"786","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. ALT"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"ALT is a planet in a galaxy called \"Encore\". Humans rule this planet but for some reason there's no dog in their planet, so the people there are sad and depressed. Rick and Morty are universal philanthropists and they want to make people in ALT happy. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"ALT has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" bidirectional roads numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":". One can go from any city to any other city using these roads."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are two types of people in ALT:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Guardians. A guardian lives in a house alongside a road and guards the road. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Citizens. A citizen lives in a house inside a city and works in an office in another city. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Every person on ALT is either a guardian or a citizen and there's exactly one guardian alongside each road. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/dc96d1c8eb35f9611080e3eaeef6a20ff34778b318febcaed8cf8f986b69b6f5.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Rick and Morty talked to all the people in ALT, and here's what they got:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" There are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" citizens living in ALT. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Citizen number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" lives in city number "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and works in city number "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Every day each citizen will go through all roads along the shortest path from his home to his work. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A citizen will be happy if and only if either he himself has a puppy himself or all of guardians along his path to his work has a puppy (he sees the guardian's puppy in each road and will be happy). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A guardian is always happy. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You need to tell Rick and Morty the minimum number of puppies they need in order to make all people in ALT happy, and also provide an optimal way to distribute these puppies."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2 × 104"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 104"},{"kind":"text","text":") — number of cities and number of citizens respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain the roads, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains endpoint of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge, "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v, u ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v ≠ u"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the information about citizens. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"xi ≠ yi"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line of input print a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", the total number of puppies they need ("},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print an integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":", the number of puppies to give to citizens, followed by "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"a1, a2, ..., aq"},{"kind":"text","text":", index of citizens to give puppy to ("},{"kind":"math_inline","text":"0 ≤ q ≤ min(m, k)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ai ≤ m"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third line print an integer "},{"kind":"math_inline","text":"e"},{"kind":"text","text":", the number of puppies to give to guardians, followed by "},{"kind":"math_inline","text":"e"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"b1, b2, ..., be"},{"kind":"text","text":", index of road of guardians to give puppy to ("},{"kind":"math_inline","text":"0 ≤ e ≤ min(n - 1, k)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ bi ≤ n - 1"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sum of "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"e"},{"kind":"text","text":" should be equal to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n2 4\n3 4\n1 4\n2 4\n2 1\n2 4\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 5 \n2 3 1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 7\n3 4\n1 4\n2 1\n4 2\n4 2\n2 4\n1 4\n2 1\n3 1\n4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 6 \n2 2 3 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Map of ALT in the first sample testcase (numbers written on a road is its index):"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/30c3778bb20cd8cd654b091022d5f96023479174906402de2e7de48a43cc2d3c.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Map of ALT in the second sample testcase (numbers written on a road is its index): "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c25e541ba102aba9c541e132e8ea8f8406e7aea7dc0bceb366e7c4e13b957193.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"786E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/786/problem/E"}