{"assets":[],"contentKind":"statement","contestId":"926","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Is This a Zebra?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A camera you have accidentally left in a desert has taken an interesting photo. The photo has a resolution of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pixels width, and each column of this photo is all white or all black. Thus, we can represent the photo as a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" zeros and ones, where "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" means that the corresponding column is all white, and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" means that the corresponding column is black."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You think that this photo can contain a zebra. In this case the whole photo should consist of several (possibly, only one) alternating black and white stripes of equal width. For example, the photo "},{"kind":"math_inline","text":"[0, 0, 0, 1, 1, 1, 0, 0, 0]"},{"kind":"text","text":" can be a photo of zebra, while the photo "},{"kind":"math_inline","text":"[0, 0, 0, 1, 1, 1, 1]"},{"kind":"text","text":" can not, because the width of the black stripe is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", while the width of the white stripe is "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". Can the given photo be a photo of zebra or not?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the width of the photo."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence of integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 1"},{"kind":"text","text":") — the description of the photo. If "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is zero, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th column is all black. If "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is one, then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th column is all white."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the photo can be a photo of zebra, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes). Otherwise, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print each letter in any case (upper or lower)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n0 0 0 1 1 1 0 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n0 0 0 1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n1 1 1 0 0 0 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n1 1 0 1 1 0 1 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first two examples are described in the statements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example all pixels are white, so the photo can be a photo of zebra."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example the width of the first stripe is equal to three (white color), the width of the second stripe is equal to three (black), and the width of the third stripe is equal to two (white). Thus, not all stripes have equal length, so this photo is not a photo of zebra."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"926C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/926/problem/C"}