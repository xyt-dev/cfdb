{"assets":[],"contentKind":"statement","contestId":"217","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Formurosa"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Bytelandian Institute for Biological Research (BIBR) is investigating the properties of two species of bacteria, named simply 0 and 1. Even under a microscope, bacteria of those two species are very difficult to distinguish. In fact, the only thing the scientists possess that is able to differentiate between them is a plant called Formurosa."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the scientists place a sample of colonies of bacteria on each on Formurosa's leaves, it will activate a complicated nutrition process. During that process color of Formurosa changes to reflect the result of a — possibly very complicated — logical formula on the species of bacteria, involving constants and the operators "},{"kind":"math_inline","text":"|"},{"kind":"text","text":" (OR), "},{"kind":"math_inline","text":"&"},{"kind":"text","text":" (AND) and "},{"kind":"math_inline","text":"^"},{"kind":"text","text":" (XOR). If it is 0, the plant will turn red, otherwise — it will turn blue."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if the nutrition process of Formurosa is described by the formula: "},{"kind":"math_inline","text":"(((?^?)|?)&(1^?))"},{"kind":"text","text":"; then Formurosa has four leaves (the \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\" signs denote the leaves). If we place "},{"kind":"math_inline","text":"0, 1, 0, 0"},{"kind":"text","text":" on the respective leaves, the result of the nutrition process will be "},{"kind":"math_inline","text":"(((0^1)|0)&(1^0)) = 1"},{"kind":"text","text":", therefore the plant will turn blue."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The scientists have "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" colonies of bacteria. They do not know their types; the only thing they know for sure is that "},{"children":[{"kind":"text","text":"not all colonies are of the same type"}],"kind":"container"},{"kind":"text","text":". They want to attempt to determine the bacteria's species by repeated evaluations with Formurosa. During each evaluation they must place exactly one sample on every leaf of the plant. However, they may use multiple samples of one colony during a single evaluation; they can even cover the whole plant with bacteria from one colony!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Is it possible for them to always determine the species of each colony, no matter what they are (assuming they are not all the same)?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 106"},{"kind":"text","text":") — the number of colonies of bacteria."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the formula describing the nutrition process of Formurosa. This line contains only characters «"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"|"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"&"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"» and complies with the following grammar:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"s → 0|1|?|(s|s)|(s&s)|(s^s)"}],"kind":"container"},{"children":[{"kind":"text","text":"The formula consists of no more than "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is always possible to determine the species of each colony, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes). Otherwise, output \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n(?^?)\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n?\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n((?^?)&?)\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"217C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/217/problem/C"}