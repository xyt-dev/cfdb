{"assets":["/statement-assets/aef1d2b5752cd327f00d795ab5f1c3141faf971958d347c6c0c61c6cce0da1ee.png","/statement-assets/3cae889d3d679c0def711ead631ec0e8907e9bcd187cd669cae473d3bea7e98b.png"],"contentKind":"statement","contestId":"850","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Tournament Construction"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ivan is reading a book about tournaments. He knows that a tournament is an oriented graph with exactly one oriented edge between each pair of vertices. The score of a vertex is the number of edges going outside this vertex. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Yesterday Ivan learned Landau's criterion: there is tournament with scores "},{"kind":"math_inline","text":"d1 ≤ d2 ≤ ... ≤ dn"},{"kind":"text","text":" if and only if "},{"attrs":{"alt":"","src":"/statement-assets/aef1d2b5752cd327f00d795ab5f1c3141faf971958d347c6c0c61c6cce0da1ee.png"},"kind":"image"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"1 ≤ k < n"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/statement-assets/3cae889d3d679c0def711ead631ec0e8907e9bcd187cd669cae473d3bea7e98b.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, Ivan wanna solve following problem: given a "},{"children":[{"kind":"text","text":"set"}],"kind":"container"},{"kind":"text","text":" of numbers "},{"kind":"math_inline","text":"S = {a1, a2, ..., am}"},{"kind":"text","text":", is there a tournament with given set of scores? I.e. is there tournament with sequence of scores "},{"kind":"math_inline","text":"d1, d2, ..., dn"},{"kind":"text","text":" such that if we remove duplicates in scores, we obtain the required set "},{"kind":"math_inline","text":"{a1, a2, ..., am}"},{"kind":"text","text":"? "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find a tournament with "},{"children":[{"kind":"text","text":"minimum"}],"kind":"container"},{"kind":"text","text":" possible number of vertices. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 31"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"a1, a2, ..., am"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 30"},{"kind":"text","text":") — elements of the set "},{"kind":"math_inline","text":"S"},{"kind":"text","text":". It is guaranteed that all elements of the set are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there are no such tournaments, print string \""},{"children":[{"kind":"text","text":"=("}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the number of vertices in the tournament."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters — matrix of the tournament. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th element in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row should be "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" if the edge between the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th and the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th vertices is oriented towards the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th vertex, and "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" otherwise. The main diagonal should contain only zeros."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n0011\n1001\n0100\n0010\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n0 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n000111\n100011\n110001\n011001\n001101\n000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"850D","schema":2,"sourceK