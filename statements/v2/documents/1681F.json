{"assets":[],"contentKind":"statement","contestId":"1681","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Unique Occurrences"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"6 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a tree, consisting of $$$n$$$ vertices. Each edge has an integer value written on it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$f(v, u)$$$ be the number of values that appear "},{"children":[{"kind":"text","text":"exactly once"}],"kind":"container"},{"kind":"text","text":" on the edges of a simple path between vertices $$$v$$$ and $$$u$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Calculate the sum of $$$f(v, u)$$$ over all pairs of vertices $$$v$$$ and $$$u$$$ such that $$$1 \\le v \\lt u \\le n$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$2 \\le n \\le 5 \\cdot 10^5$$$) — the number of vertices in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n-1$$$ lines contains three integers $$$v, u$$$ and $$$x$$$ ($$$1 \\le v, u, x \\le n$$$) — the description of an edge: the vertices it connects and the value written on it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The given edges form a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role