{"assets":["/statement-assets/1ae22f61db293cf2e07fdc3922dfc629fe50424264f74918ab55686a373077bc.png"],"contentKind":"statement","contestId":"838","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Convex Countour"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an strictly convex polygon with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. It is guaranteed that no three points are collinear. You would like to take a maximum non intersecting path on the polygon vertices that visits each point at most once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More specifically your path can be represented as some sequence of distinct polygon vertices. Your path is the straight line segments between adjacent vertices in order. These segments are not allowed to touch or intersect each other except at the vertices in your sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the polygon, print the maximum length non-intersecting path that visits each point at most once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input will contain a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2 500"},{"kind":"text","text":"), the number of points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines will contain two integers "},{"kind":"math_inline","text":"xi, yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|xi|, |yi| ≤ 109"},{"kind":"text","text":"), denoting the coordinates of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that these points are listed in clockwise order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single floating point number, representing the longest non-intersecting path that visits the vertices at most once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your answer will be accepted if it has absolute or relative error at most "},{"kind":"math_inline","text":"10 - 9"},{"kind":"text","text":". More specifically, if your answer is "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and the jury answer is "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", your answer will be accepted if "},{"attrs":{"alt":"","src":"/statement-assets/1ae22f61db293cf2e07fdc3922dfc629fe50424264f74918ab55686a373077bc.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 0\n0 1\n1 1\n1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3.4142135624\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"One optimal path is to visit points 0,1,3,2 in order."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"838E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/838/problem/E"}