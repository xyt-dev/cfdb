{"assets":[],"contentKind":"statement","contestId":"2252","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Always Changing"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a binary string $$$s$$$ of length $$$n$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string is called alternating if no two adjacent characters are the same. For example, "},{"children":[{"kind":"text","text":"0101"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" are alternating, but "},{"children":[{"kind":"text","text":"0110"}],"kind":"container"},{"kind":"text","text":" is not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You want to transform $$$s$$$ into an alternating string by performing the following operation any number of times (possibly zero): "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose any character currently in the string and delete it. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"However, your sequence of operations must follow a rule: the characters you delete must strictly alternate. This means if the last character you deleted was "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", the next character you delete must be "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", and vice versa. Your very first deleted character can be either "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the minimum number of operations required to make $$$s$$$ an alternating string. If it is impossible to achieve this, output $$$-1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the length of the string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains the binary string $$$s$$$ of length $$$n$$$, consisting only of the characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the minimum number of operations required to make $$$s$$$ an alternating string, or $$$-1$$$ if it is impossible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n4\n0101\n3\n111\n6\n100110\n6\n100010\n6\n011110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n-1\n2\n3\n5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the string "},{"children":[{"kind":"text","text":"0101"}],"kind":"container"},{"kind":"text","text":" is already alternating. No operations are needed, so the answer is $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the string is "},{"children":[{"kind":"text","text":"111"}],"kind":"container"},{"kind":"text","text":". To make it alternating, we must leave at most one "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", which requires deleting two "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"s. However, our deletions must strictly alternate between "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". Since we have no "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"s to delete, it is impossible to perform two deletions. The answer is $$$-1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, the string is "},{"children":[{"kind":"text","text":"100110"}],"kind":"container"},{"kind":"text","text":". We can simply delete one "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and one "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" to resolve the adjacent duplicates. Since we deleted exactly one "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and one "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", the operations are perfectly balanced and valid. The remaining string is "},{"children":[{"kind":"text","text":"1010"}],"kind":"container"},{"kind":"text","text":", requiring exactly $$$2$$$ operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, the string is "},{"children":[{"kind":"text","text":"100010"}],"kind":"container"},{"kind":"text","text":". To resolve the adjacent duplicates, we would naturally want to delete two "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"s to form "},{"children":[{"kind":"text","text":"1010"}],"kind":"container"},{"kind":"text","text":". However, deleting two "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"s and zero "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"s violates the strict alternation rule (the difference in counts cannot exceed $$$1$$$). To fix this imbalance, we are forced to additionally delete a "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" from the edge of the string. We delete two "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"s and one "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" (e.g., in the order "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"), leaving the alternating string "},{"children":[{"kind":"text","text":"010"}],"kind":"container"},{"kind":"text","text":". This requires $$$3$$$ operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth test case, the string is "},{"children":[{"kind":"text","text":"011110"}],"kind":"container"},{"kind":"text","text":". Resolving the adjacent duplicates requires deleting three "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"s. To balance this, we must additionally delete at least two "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"s. Since our compressed string "},{"children":[{"kind":"text","text":"010"}],"kind":"container"},{"kind":"text","text":" only has two "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"s (at its outer edges), we are forced to delete both of them, leaving a final string of just "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". We deleted three "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"s and two "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"s, which takes $$$5$$$ operations."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"2252B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2252/problem/B"}