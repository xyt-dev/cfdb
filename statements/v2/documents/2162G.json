{"assets":["/statement-assets/80679e2022879fb2a2992ae8f1ad86258f8721a3d24c58569e3d7aeda7bb6c80.png","/statement-assets/d75a793d949ca1b538607ef82806e376645493251f010468aba7005db5a7d958.png"],"contentKind":"statement","contestId":"2162","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Beautiful Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A tree is a connected graph without cycles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A tree is called "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if the sum of the products of the vertex labels for all its edges is a "},{"children":[{"kind":"text","text":"perfect square"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, let $$$E$$$ be the set of edges in the tree. The tree is called "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if the value $$$$$$S = \\sum_{\\{u, v\\} \\in E} (u \\cdot v)$$$$$$ is a perfect square. That is, there exists an integer $$$x$$$ such that $$$S = x^2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an integer $$$n$$$. Your task is to construct a beautiful tree having $$$n$$$ vertices or report that such a tree does not exist."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of testcases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each testcase contains a single integer $$$n$$$ ($$$2 \\le n \\le 2\\cdot10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all the testcases does not exceed $$$2\\cdot10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase, if there is no beautiful tree having $$$n$$$ vertices, print $$$-1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print $$$n-1$$$ lines denoting the edges of a beautiful tree having $$$n$$$ vertices. Each line should contain two space-separated integers $$$u,v$$$ ($$$1 \\le u,v \\le n$$$) representing an edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The vertices can be printed in any order within an edge, and the edges can be printed in any order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2\n3\n4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n1 3\n2 3\n1 2\n3 1\n4 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Test case 1:"}],"kind":"container"},{"kind":"text","text":" No beautiful tree exists with $$$2$$$ vertices. Hence, print $$$-1$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Test case 2:"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/80679e2022879fb2a2992ae8f1ad86258f8721a3d24c58569e3d7aeda7bb6c80.png"},"kind":"image"},{"children":[{"kind":"text","text":"$$$S = (2\\cdot3) + (1\\cdot3) = 9 = (3)^2$$$"}],"kind":"container"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"Test case 3:"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d75a793d949ca1b538607ef82806e376645493251f010468aba7005db5a7d958.png"},"kind":"image"},{"children":[{"kind":"text","text":"$$$S = (2\\cdot1) + (3\\cdot1) + (4\\cdot1) = 9 = (3)^2$$$"}],"kind":"container"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"2162G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2162/problem/G"}