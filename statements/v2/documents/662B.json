{"assets":["/statement-assets/851a6e1a25bd92d63321ccaaa688b4a7c3f7fa516de06d0ad1cb8cb7440cece9.png"],"contentKind":"statement","contestId":"662","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Graph Coloring"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an undirected graph that consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges. Initially, each edge is colored either red or blue. Each turn a player picks a single vertex and switches the color of "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" edges incident to it. That is, all red edges with an endpoint in this vertex change the color to blue, while all blue edges with an endpoint in this vertex change the color to red."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the minimum possible number of moves required to make the colors of all edges equal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100 000"},{"kind":"text","text":") — the number of vertices and edges, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines provide the description of the edges, as the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains two integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ui ≠ vi"},{"kind":"text","text":") — the indices of the vertices connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge, and a character "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/851a6e1a25bd92d63321ccaaa688b4a7c3f7fa516de06d0ad1cb8cb7440cece9.png"},"kind":"image"},{"kind":"text","text":") providing the initial color of this edge. If "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" equals '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"', then this edge is initially colored red. Otherwise, "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" is equal to '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' and this edge is initially colored blue. It's guaranteed that there are no self-loops and multiple edges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no way to make the colors of all edges equal output "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":" in the only line of the output. Otherwise first output "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the minimum number of moves required to achieve the goal, then output "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., ak"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is equal to the index of the vertex that should be used at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th move."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple optimal sequences of moves, output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2 B\n3 1 R\n3 2 B\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 5\n1 3 R\n2 3 R\n3 4 B\n4 5 R\n4 6 R\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n3 4 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n1 2 R\n1 3 R\n2 3 B\n3 4 B\n1 4 B\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"662B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/662/problem/B"}