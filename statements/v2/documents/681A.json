{"assets":[],"contentKind":"statement","contestId":"681","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. A Good Contest"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Codeforces user' handle color depends on his rating — it is red if his rating is greater or equal to "},{"kind":"math_inline","text":"2400"},{"kind":"text","text":"; it is orange if his rating is less than "},{"kind":"math_inline","text":"2400"},{"kind":"text","text":" but greater or equal to "},{"kind":"math_inline","text":"2200"},{"kind":"text","text":", etc. Each time participant takes part in a rated contest, his rating is changed depending on his performance."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Anton wants the color of his handle to become red. He considers his performance in the rated contest to be "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if he outscored some participant, whose handle was colored red before the contest and his rating has increased after it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Anton has written a program that analyses contest results and determines whether he performed good or not. Are you able to do the same?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of participants Anton has outscored in this contest ."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines describe participants results: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them consists of a participant handle "},{"kind":"math_inline","text":"namei"},{"kind":"text","text":" and two integers "},{"kind":"math_inline","text":"beforei"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"afteri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 4000 ≤ beforei, afteri ≤ 4000"},{"kind":"text","text":") — participant's rating before and after the contest, respectively. Each handle is a non-empty string, consisting of no more than "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" characters, which might be lowercase and uppercase English letters, digits, characters «"},{"children":[{"kind":"text","text":"_"}],"kind":"container"},{"kind":"text","text":"» and «"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"» characters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all handles are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print «"},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"» (quotes for clarity), if Anton has performed good in the contest and «"},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"» (quotes for clarity) otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nBurunduk1 2526 2537\nBudAlNik 2084 2214\nsubscriber 2833 2749\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nApplejack 2400 2400\nFluttershy 2390 2431\nPinkie_Pie -2500 -2450\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Anton has outscored user with handle "},{"children":[{"kind":"text","text":"Burunduk1"}],"kind":"container"},{"kind":"text","text":", whose handle was colored red before the contest and his rating has increased after the contest."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, "},{"children":[{"kind":"text","text":"Applejack"}],"kind":"container"},{"kind":"text","text":"'s rating has not increased after the contest, while both "},{"children":[{"kind":"text","text":"Fluttershy"}],"kind":"container"},{"kind":"text","text":"'s and "},{"children":[{"kind":"text","text":"Pinkie_Pie"}],"kind":"container"},{"kind":"text","text":"'s handles were not colored red before the contest."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"681A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/681/problem/A"}