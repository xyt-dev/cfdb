{"assets":[],"contentKind":"statement","contestId":"1533","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Binary String Partition"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's call a string $$$t$$$ consisting of characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":", if either the number of occurrences of character "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" in this string does not exceed $$$k$$$, or the number of occurrences of characters "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" in this string does not exceed $$$k$$$ (or both). For example, if $$$k = 3$$$, the strings "},{"children":[{"kind":"text","text":"101010"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"111"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"00000"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1111111000"}],"kind":"container"},{"kind":"text","text":" are "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":", and the strings "},{"children":[{"kind":"text","text":"1111110000"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"01010101"}],"kind":"container"},{"kind":"text","text":" are not "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string $$$s$$$. You have to divide it into the minimum possible number of "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" strings, i. e., find a sequence of strings $$$t_1, t_2, \\dots, t_m$$$ such that every $$$t_i$$$ is "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":", $$$t_1 + t_2 + \\dots + t_m = s$$$ (where $$$+$$$ is the concatenation operator), and $$$m$$$ is minimum possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For every $$$k$$$ from $$$1$$$ to $$$|s|$$$, find the minimum possible number of strings such that $$$s$$$ can be divided into them (i. e. the minimum possible $$$m$$$ in the partition)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains one string $$$s$$$ ($$$1 \\le |s| \\le 2 \\cdot 10^5$$$). Each character of $$$s$$$ is either "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$|s|$$$ integers. The $$$i$$$-th integer should be equal to the minimum number of strings in the partition of $$$s$$$, when $$$k = i$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n00100010\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2 1 1 1 1 1 1 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1001011100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3 2 2 2 1 1 1 1 1 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1533F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1533/problem/F"}