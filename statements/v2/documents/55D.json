{"assets":[],"contentKind":"statement","contestId":"55","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Beautiful numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Volodya is an odd boy and his taste is strange as well. It seems to him that a positive integer number is "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if and only if it is divisible by each of its nonzero digits. We will not argue with this and just count the quantity of beautiful numbers in given ranges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains the number of cases "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 10"},{"kind":"text","text":"). Each of the next "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines contains two natural numbers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ 9 ·1018"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specificator to read or write 64-bit integers in C++. It is preffered to use "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":" (also you may use "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output should contain "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" numbers — answers to the queries, one number per line — quantities of beautiful numbers in given intervals (from "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", inclusively)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n1 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n12 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"55D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/55/problem/D"}