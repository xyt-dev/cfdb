{"assets":[],"contentKind":"statement","contestId":"79","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Password"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Finally Fox Ciel arrived in front of her castle!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"She have to type a password to enter her castle. An input device attached to her castle is a bit unusual."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The input device is a "},{"kind":"math_inline","text":"1 × n"},{"kind":"text","text":" rectangle divided into "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" square panels. They are numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right. Each panel has a state either ON or OFF. Initially all panels are in the OFF state. She can enter her castle if and only if "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":"-th, "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":"-th, "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"xk"},{"kind":"text","text":"-th panels are in the ON state and other panels are in the OFF state."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"She is given an array "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"al"},{"kind":"text","text":". In each move, she can perform the following operation: choose an index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ l"},{"kind":"text","text":"), choose consecutive "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" panels, and flip the states of those panels (i.e. ON"},{"kind":"math_inline","text":" → "},{"kind":"text","text":"OFF, OFF"},{"kind":"math_inline","text":" → "},{"kind":"text","text":"ON)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately she forgets how to type the password with only above operations. Determine the minimal number of operations required to enter her castle."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10000, 1 ≤ k ≤ 10, 1 ≤ l ≤ 100"},{"kind":"text","text":"), separated by single spaces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"xk"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x1 < x2 < ... < xk ≤ n"},{"kind":"text","text":"), separated by single spaces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"al"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ n"},{"kind":"text","text":"), separated by single spaces. It is possible that some elements of the array "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" are equal value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimal number of moves required to type the password. If it's impossible, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 8 2\n1 2 3 5 6 7 8 9\n3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 1\n1 2\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"One possible way to type the password in the first example is following: In the first move, choose 1st, 2nd, 3rd panels and flip those panels. In the second move, choose 5th, 6th, 7th, 8th, 9th panels and flip those panels."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"79D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/79/problem/D"}