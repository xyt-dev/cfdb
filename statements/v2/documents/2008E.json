{"assets":[],"contentKind":"statement","contestId":"2008","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Alternating String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sakurako really loves "},{"children":[{"kind":"text","text":"alternating strings"}],"kind":"container"},{"kind":"text","text":". She calls a string $$$s$$$ of lowercase Latin letters an "},{"children":[{"kind":"text","text":"alternating string"}],"kind":"container"},{"kind":"text","text":" if characters in the even positions are the same, if characters in the odd positions are the same, and the length of the string is "},{"children":[{"kind":"text","text":"even"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the strings '"},{"children":[{"kind":"text","text":"abab"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"gg"}],"kind":"container"},{"kind":"text","text":"' are "},{"children":[{"kind":"text","text":"alternating"}],"kind":"container"},{"kind":"text","text":", while the strings '"},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"ggwp"}],"kind":"container"},{"kind":"text","text":"' are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As a good friend, you decided to gift such a string, but you couldn't find one. Luckily, you can perform two types of operations on the string: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Choose an index $$$i$$$ and delete the $$$i$$$-th character from the string, which will reduce the length of the string by $$$1$$$. This type of operation can be performed "},{"children":[{"kind":"text","text":"no more than $$$1$$$ time"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Choose an index $$$i$$$ and replace $$$s_i$$$ with any other letter. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Since you are in a hurry, you need to determine the minimum number of operations required to make the string an "},{"children":[{"kind":"text","text":"alternating"}],"kind":"container"},{"kind":"text","text":" one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$)  — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single number $$$n$$$ ($$$1 \\le n\\le 2\\cdot 10^5$$$)  — the length of the string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$s$$$, consisting of lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ across all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the minimum number of operations required to turn the string $$$s$$$ into an "},{"children":[{"kind":"text","text":"alternating"}],"kind":"container"},{"kind":"text","text":" one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n1\na\n2\nca\n3\naab\n5\nababa\n6\nacdada\n9\nejibmyyju\n6\nbbccbc\n6\nabacba\n5\nbcbca\n5\ndcbdb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n0\n1\n1\n2\n6\n2\n3\n1\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the string "},{"children":[{"kind":"text","text":"ababa"}],"kind":"container"},{"kind":"text","text":", you can delete the first character to get "},{"children":[{"kind":"text","text":"baba"}],"kind":"container"},{"kind":"text","text":", which is an "},{"children":[{"kind":"text","text":"alternating"}],"kind":"container"},{"kind":"text","text":" string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the string "},{"children":[{"kind":"text","text":"acdada"}],"kind":"container"},{"kind":"text","text":", you can change the first two characters to get "},{"children":[{"kind":"text","text":"dadada"}],"kind":"container"},{"kind":"text","text":", which is an "},{"children":[{"kind":"text","text":"alternating"}],"kind":"container"},{"kind":"text","text":" string."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"2008E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2008/problem/E"}