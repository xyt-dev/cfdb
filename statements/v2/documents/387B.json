{"assets":[],"contentKind":"statement","contestId":"387","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. George and Round"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"George decided to prepare a Codesecrof round, so he has prepared "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" problems for the round. Let's number the problems with integers "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". George estimates the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th problem's complexity by integer "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To make the round "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":", he needs to put at least "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" problems there. Besides, he needs to have at least one problem with complexity exactly "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", at least one with complexity exactly "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., and at least one with complexity exactly "},{"kind":"math_inline","text":"an"},{"kind":"text","text":". Of course, the round can also have problems with other complexities."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"George has a poor imagination. It's easier for him to make some already prepared problem simpler than to come up with a new one and prepare it. George is magnificent at simplifying problems. He can simplify any already prepared problem with complexity "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" to any positive integer complexity "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"c ≥ d"},{"kind":"text","text":"), by changing limits on the input data."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, nothing is so simple. George understood that even if he simplifies some problems, he can run out of problems for a "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" round. That's why he decided to find out the minimum number of problems he needs to come up with in addition to the "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" he's prepared in order to make a good round. Note that George can come up with a new problem of any complexity."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 3000"},{"kind":"text","text":") — the minimal number of problems in a good round and the number of problems George's prepared. The second line contains space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a1 < a2 < ... < an ≤ 106"},{"kind":"text","text":") — the requirements for the complexity of the problems in a good round. The third line contains space-separated integers "},{"kind":"math_inline","text":"b1, b2, ..., bm"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ b1 ≤ b2... ≤ bm ≤ 106"},{"kind":"text","text":") — the complexities of the problems prepared by George. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n1 2 3\n1 2 2 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n1 2 3\n1 1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n2 3 4\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the set of the prepared problems meets the requirements for a good round."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, it is enough to come up with and prepare two problems with complexities "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" to get a good round."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample it is very easy to get a good round if come up with and prepare extra problems with complexities: "},{"kind":"math_inline","text":"2, 3, 4"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"387B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/387/problem/B"}