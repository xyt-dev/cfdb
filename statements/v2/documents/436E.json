{"assets":["/statement-assets/96c02807f62e758eded7a0617017c7c9dc41802ee9dfaff6eca7c040e861999a.png"],"contentKind":"statement","contestId":"436","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Cardboard Box"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Everyone who has played Cut the Rope knows full well how the gameplay is organized. All levels in the game are divided into boxes. Initially only one box with some levels is available. Player should complete levels to earn stars, collecting stars opens new box with levels."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/96c02807f62e758eded7a0617017c7c9dc41802ee9dfaff6eca7c040e861999a.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Imagine that you are playing Cut the Rope for the first time. Currently you have only the levels of the first box (by the way, it is called \"Cardboard Box\"). Each level is characterized by two integers: "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" — how long it takes to complete the level for one star, "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" — how long it takes to complete the level for two stars "},{"kind":"math_inline","text":"(ai < bi)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You want to open the next box as quickly as possible. So, you need to earn at least "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" stars. How do make it happen? Note that the level can be passed only once: either for one star or for two. You do not necessarily need to pass all the levels."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"w"},{"kind":"math_inline","text":"(1 ≤ n ≤ 3·105; 1 ≤ w ≤ 2n)"},{"kind":"text","text":" — the number of levels in the first box and the number of stars you need to open another box. Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"math_inline","text":"(1 ≤ ai < bi ≤ 109)"},{"kind":"text","text":" — the attributes of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th level."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — the minimum time you need to open the next box. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next line, print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" digits without spaces — the description of the optimal scenario: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if you need to pass the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th level for one star, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th digit should equal 1; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if you need to pass the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th level for two stars, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th digit should equal 2; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if you do not need to pass the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th level at all, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th digit should equal 0. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n1 2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n12\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n10 20\n5 10\n10 20\n6 9\n25 30\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n01020\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test sample, answer "},{"children":[{"kind":"text","text":"21"}],"kind":"container"},{"kind":"text","text":" is also assumed correct."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"436E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/436/problem/E"}