{"assets":["/statement-assets/c7e2b3588493ca9ce4edc37ff4e21ec93046a6cb1ab0d4b2319a35c99cfcf87b.png","/statement-assets/96b499f3f5dce4fc6771df40a40d8fd9d9ad50aecd119ef22030fd4523644ef3.png","/statement-assets/d5099c91715df1444ee83da1bd07495254421c217808af5ec30cfa14c9fc199c.png"],"contentKind":"statement","contestId":"437","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. The Child and Polygon"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"This time our child has a simple polygon. He has to find the number of ways to split the polygon into non-degenerate triangles, each way must satisfy the following requirements:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" each vertex of each triangle is one of the polygon vertex; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" each side of the polygon must be the side of exactly one triangle; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the area of intersection of every two triangles equals to zero, and the sum of all areas of triangles equals to the area of the polygon; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" each triangle must be completely inside the polygon; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"each side of each triangle must contain exactly two vertices of the polygon"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The picture below depicts an example of a correct splitting."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c7e2b3588493ca9ce4edc37ff4e21ec93046a6cb1ab0d4b2319a35c99cfcf87b.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Please, help the child. Calculate the described number of ways modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109  +  7)"},{"kind":"text","text":" for him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(3 ≤ n ≤ 200)"},{"kind":"text","text":" — the number of vertices of the polygon. Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each line containing two integers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains "},{"kind":"math_inline","text":"xi, yi"},{"kind":"math_inline","text":"(|xi|, |yi| ≤ 107)"},{"kind":"text","text":" — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex of the polygon in clockwise or counterclockwise order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the polygon is simple."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the number of ways modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109  +  7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 0\n0 1\n1 1\n1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 0\n1 0\n0 1\n-1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 0\n1 0\n1 1\n0 1\n-2 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, there are two possible splittings:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/96b499f3f5dce4fc6771df40a40d8fd9d9ad50aecd119ef22030fd4523644ef3.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second sample, there are only one possible splitting:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d5099c91715df1444ee83da1bd07495254421c217808af5ec30cfa14c9fc199c.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"437E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/437/problem/E"}