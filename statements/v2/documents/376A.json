{"assets":["/statement-assets/c3fe49f4bc5797a98e69f134586213931f5df17a11df4483597945256fae9f8b.png","/statement-assets/7b648121f664a7a482e025017c3b93813246940001738c9cacbcbc089cfd23cf.png","/statement-assets/ac7a6f185224fe22f9a6233313886ee433e3708aa81662ade30571b1656db7a0.png","/statement-assets/e6fa61408c27d194b87368eec390ebcceda848c357d5def5564542ce8a025e78.png"],"contentKind":"statement","contestId":"376","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Lever"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a description of a lever as string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". We'll represent the string length as record "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":", then the lever looks as a horizontal bar with weights of length "},{"kind":"math_inline","text":"|s| - 1"},{"kind":"text","text":" with exactly one pivot. We will assume that the bar is a segment on the "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":" axis between points "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"|s| - 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The decoding of the lever description is given below."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character of the string equals \""},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":"\", that means that at coordinate "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" there is the pivot under the bar. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character of the string equals \""},{"children":[{"kind":"text","text":"="}],"kind":"container"},{"kind":"text","text":"\", that means that at coordinate "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" there is nothing lying on the bar. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character of the string equals digit "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"1-9"}],"kind":"container"},{"kind":"text","text":"), that means that at coordinate "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" there is a weight of mass "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" on the bar. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is, given the lever description, print if it will be in balance or not. Assume that the bar doesn't weight anything. Assume that the bar initially is in balance then all weights are simultaneously put on it. After that the bar either tilts to the left, or tilts to the right, or is in balance."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the lever description as a non-empty string "},{"kind":"math_inline","text":"s"},{"kind":"math_inline","text":"(3 ≤ |s| ≤ 106)"},{"kind":"text","text":", consisting of digits ("},{"children":[{"kind":"text","text":"1-9"}],"kind":"container"},{"kind":"text","text":") and characters \""},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"="}],"kind":"container"},{"kind":"text","text":"\". It is guaranteed that the line contains exactly one character \""},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":"\". It is guaranteed that the pivot of the lever isn't located in any end of the lever bar."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To solve the problem you may need 64-bit integer numbers. Please, do not forget to use them in your programs."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"left"}],"kind":"container"},{"kind":"text","text":"\" if the given lever tilts to the left, \""},{"children":[{"kind":"text","text":"right"}],"kind":"container"},{"kind":"text","text":"\" if it tilts to the right and \""},{"children":[{"kind":"text","text":"balance"}],"kind":"container"},{"kind":"text","text":"\", if it is in balance."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"=^==\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"balance\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9===^==1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"left\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2==^7==\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"right\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"41^52==\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"balance\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"As you solve the problem, you may find the following link useful to better understand how a lever functions: "},{"children":[{"kind":"text","text":"http://en.wikipedia.org/wiki/Lever"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The pictures to the examples:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c3fe49f4bc5797a98e69f134586213931f5df17a11df4483597945256fae9f8b.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/7b648121f664a7a482e025017c3b93813246940001738c9cacbcbc089cfd23cf.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statem