{"assets":[],"contentKind":"statement","contestId":"321","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Ciel and Duel"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Fox Ciel is playing a card game with her friend Jiro."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Jiro has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cards, each one has two attributes: "},{"kind":"math_inline","text":"position"},{"kind":"text","text":" (Attack or Defense) and "},{"kind":"math_inline","text":"strength"},{"kind":"text","text":". Fox Ciel has "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" cards, each one has these two attributes too. It's known that position of all Ciel's cards is Attack."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now is Ciel's battle phase, Ciel can do the following operation many times:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Choose one of her cards "},{"kind":"math_inline","text":"X"},{"kind":"text","text":". This card mustn't be chosen before. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If Jiro has no alive cards at that moment, he gets the damage equal to ("},{"kind":"math_inline","text":"X"},{"kind":"text","text":"'s strength). Otherwise, Ciel needs to choose one Jiro's alive card "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":", then: "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":"'s position is Attack, then ("},{"kind":"math_inline","text":"X"},{"kind":"text","text":"'s strength) "},{"kind":"math_inline","text":" ≥ "},{"kind":"text","text":" ("},{"kind":"math_inline","text":"Y"},{"kind":"text","text":"'s strength) must hold. After this attack, card "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" dies, and Jiro gets the damage equal to ("},{"kind":"math_inline","text":"X"},{"kind":"text","text":"'s strength) - ("},{"kind":"math_inline","text":"Y"},{"kind":"text","text":"'s strength). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":"'s position is Defense, then ("},{"kind":"math_inline","text":"X"},{"kind":"text","text":"'s strength) "},{"kind":"math_inline","text":" > "},{"kind":"text","text":" ("},{"kind":"math_inline","text":"Y"},{"kind":"text","text":"'s strength) must hold. After this attack, card "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" dies, but Jiro gets no damage. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Ciel can end her battle phase at any moment (so, she can use not all her cards). Help the Fox to calculate the maximal sum of damage Jiro can get."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100"},{"kind":"text","text":") — the number of cards Jiro and Ciel have."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains a string "},{"kind":"math_inline","text":"position"},{"kind":"text","text":" and an integer "},{"kind":"math_inline","text":"strength"},{"kind":"math_inline","text":"(0 ≤ strength ≤ 8000)"},{"kind":"text","text":" — the position and strength of Jiro's current card. Position is the string \""},{"children":[{"kind":"text","text":"ATK"}],"kind":"container"},{"kind":"text","text":"\" for attack, and the string \""},{"children":[{"kind":"text","text":"DEF"}],"kind":"container"},{"kind":"text","text":"\" for defense."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains an integer "},{"kind":"math_inline","text":"strength"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ strength ≤ 8000"},{"kind":"text","text":") — the strength of Ciel's current card."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output an integer: the maximal damage Jiro can get."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\nATK 2000\nDEF 1700\n2500\n2500\n2500\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\nATK 10\nATK 100\nATK 1000\n1\n11\n101\n1001\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"992\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4\nDEF 0\nATK 0\n0\n0\n1\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, Ciel has 3 cards with same "},{"kind":"math_inline","text":"strength"},{"kind":"text","text":". The best strategy is as follows. First she uses one of these 3 cards to attack \"ATK 2000\" card first, this attack destroys that card and Jiro gets "},{"kind":"math_inline","text":"2500 - 2000 = 500"},{"kind":"text","text":" damage. Then she uses the second card to destroy the \"DEF 1700\" card. Jiro doesn't get damage that time. Now Jiro has no cards so she can use the third card to attack and Jiro gets "},{"kind":"math_inline","text":"2500"},{"kind":"text","text":" damage. So the answer is "},{"kind":"math_inline","text":"500 + 2500 = 3000"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, she should use the \"1001\" card to attack the \"ATK 100\" card, then use the \"101\" card to attack the \"ATK 10\" card. Now Ciel still has cards but she can choose to end her battle phase. The total damage equals "},{"kind":"math_inline","text":"(1001 - 100) + (101 - 10) = 992"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case note that she can destroy the \"ATK 0\" card by a card with strength equal to 0, but she can't destroy a \"DEF 0\" card with that card."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"321B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/321/problem/B"}