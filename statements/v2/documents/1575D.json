{"assets":[],"contentKind":"statement","contestId":"1575","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Divisible by Twenty-Five"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mr. Chanek has an integer represented by a string $$$s$$$. Zero or more digits have been erased and are denoted by the character "},{"children":[{"kind":"text","text":"_"}],"kind":"container"},{"kind":"text","text":". There are also zero or more digits marked by the character "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":", meaning they're the same digit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mr. Chanek wants to count the number of possible integer $$$s$$$, where $$$s$$$ is divisible by $$$25$$$. Of course, $$$s$$$ must not contain any leading zero. He can replace the character "},{"children":[{"kind":"text","text":"_"}],"kind":"container"},{"kind":"text","text":" with any digit. He can also replace the character "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":" with any digit, but it must be the same for every character "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As a note, a leading zero is any "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" digit that comes before the first nonzero digit in a number string in positional notation. For example, "},{"children":[{"kind":"text","text":"0025"}],"kind":"container"},{"kind":"text","text":" has two leading zeroes. An exception is the integer zero, ("},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" has no leading zero, but "},{"children":[{"kind":"text","text":"0000"}],"kind":"container"},{"kind":"text","text":" has three leading zeroes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"One line containing the string $$$s$$$ ($$$1 \\leq |s| \\leq 8$$$). The string $$$s$$$ consists of the characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"3"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"6"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"8"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"9"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"_"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output an integer denoting the number of possible integer $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n25\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n_00\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n_XX\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n0_25\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the only possible $$$s$$$ is $$$25$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second and third example, $$$s \\in \\{100, 200,300,400,500,600,700,800,900\\}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth example, all possible $$$s$$$ will have at least one leading zero."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1575D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1575/problem/D"}