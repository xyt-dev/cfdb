{"assets":[],"contentKind":"statement","contestId":"1721","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Image"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have an image file of size $$$2 \\times 2$$$, consisting of $$$4$$$ pixels. Each pixel can have one of $$$26$$$ different colors, denoted by lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You want to recolor some of the pixels of the image "},{"children":[{"kind":"text","text":"so that all $$$4$$$ pixels have the same color"}],"kind":"container"},{"kind":"text","text":". In one move, you can choose "},{"children":[{"kind":"text","text":"no more than two"}],"kind":"container"},{"kind":"text","text":" pixels "},{"children":[{"kind":"text","text":"of the same color"}],"kind":"container"},{"kind":"text","text":" and paint them into some other color "},{"children":[{"kind":"text","text":"(if you choose two pixels, both should be painted into the same color)"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of moves you have to make in order to fulfill your goal?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two lines. Each of these lines contains two lowercase letters of Latin alphabet "},{"children":[{"kind":"text","text":"without any separators"}],"kind":"container"},{"kind":"text","text":", denoting a row of pixels in the image."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer — the minimum number of moves you have to make so that all $$$4$$$ pixels of the image have the same color."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\nrb\nbr\ncc\nwb\naa\naa\nab\ncd\nyy\nxx\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n0\n3\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's analyze the test cases of the example."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first test case, you can paint the bottom left pixel and the top right pixel (which share the same color) into the color "},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":", so all pixels have this color."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, two moves are enough:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" paint both top pixels, which have the same color "},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":", into the color "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" paint the bottom left pixel into the color "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the third test case, all pixels already have the same color."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, you may leave any of the pixels unchanged, and paint all three other pixels into the color of that pixel in three moves."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth test case, you can paint both top pixels into the color "},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1721A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1721/problem/A"}