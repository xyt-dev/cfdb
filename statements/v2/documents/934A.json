{"assets":[],"contentKind":"statement","contestId":"934","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. A Compatible Pair"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Nian is a monster which lives deep in the oceans. Once a year, it shows up on the land, devouring livestock and even people. In order to keep the monster away, people fill their villages with red colour, light, and cracking noise, all of which frighten the monster out of coming."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Little Tommy has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lanterns and Big Banban has "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lanterns. Tommy's lanterns have brightness "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":", and Banban's have brightness "},{"kind":"math_inline","text":"b1, b2, ..., bm"},{"kind":"text","text":" respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Tommy intends to hide one of his lanterns, then Banban picks one of Tommy's non-hidden lanterns and one of his own lanterns to form a pair. The pair's brightness will be the product of the brightness of two lanterns."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Tommy wants to make the product as small as possible, while Banban tries to make it as large as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are asked to find the brightness of the chosen pair if both of them choose optimally."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n, m ≤ 50"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"b1, b2, ..., bm"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the integers range from "},{"kind":"math_inline","text":" - 109"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"109"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the brightness of the chosen pair."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n20 18\n2 14\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"252\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n-1 0 1 2 3\n-1 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, Tommy will hide "},{"kind":"math_inline","text":"20"},{"kind":"text","text":" and Banban will choose "},{"kind":"math_inline","text":"18"},{"kind":"text","text":" from Tommy and "},{"kind":"math_inline","text":"14"},{"kind":"text","text":" from himself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, Tommy will hide "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and Banban will choose "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" from Tommy and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" from himself."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"934A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/934/problem/A"}