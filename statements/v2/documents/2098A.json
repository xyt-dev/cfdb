{"assets":[],"contentKind":"statement","contestId":"2098","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Vadim's Collection"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"We call a phone number a "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if it is a string of $$$10$$$ digits, where the $$$i$$$-th digit from the left is at least $$$10 - i$$$. That is, the first digit must be at least $$$9$$$, the second at least $$$8$$$, $$$\\ldots$$$, with the last digit being at least $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, "},{"children":[{"kind":"text","text":"9988776655"}],"kind":"container"},{"kind":"text","text":" is a beautiful phone number, while "},{"children":[{"kind":"text","text":"9099999999"}],"kind":"container"},{"kind":"text","text":" is not, since the second digit, which is $$$0$$$, is less than $$$8$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vadim has a "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" phone number. He wants to rearrange its digits in such a way that the result is the "},{"children":[{"kind":"text","text":"smallest possible beautiful"}],"kind":"container"},{"kind":"text","text":" phone number. Help Vadim solve this problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please note that the phone numbers are compared as integers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a single string $$$s$$$ of length $$$10$$$, consisting of digits. It is guaranteed that $$$s$$$ is a "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" phone number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single string of length $$$10$$$ — the smallest possible beautiful phone number that Vadim can obtain."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n9999999999\n9988776655\n9988776650\n9899999999\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n9999999999\n9876556789\n9876567890\n9899999999\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, for the first phone number "},{"children":[{"kind":"text","text":"9999999999"}],"kind":"container"},{"kind":"text","text":", regardless of the rearrangement of digits, the same phone number is obtained."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, for the phone number "},{"children":[{"kind":"text","text":"9988776655"}],"kind":"container"},{"kind":"text","text":", it can be proven that "},{"children":[{"kind":"text","text":"9876556789"}],"kind":"container"},{"kind":"text","text":" is the smallest phone number that can be obtained by rearranging the digits."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2098A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2098/problem/A"}