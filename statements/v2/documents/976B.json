{"assets":["/statement-assets/4e5454a3316d8c6f9f5f9af891335135e4e268f2e89fcdd48fbfd4e7b5d9149d.png"],"contentKind":"statement","contestId":"976","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Lara Croft and the New Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You might have heard about the next game in Lara Croft series coming out this year. You also might have watched its trailer. Though you definitely missed the main idea about its plot, so let me lift the veil of secrecy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Lara is going to explore yet another dangerous dungeon. Game designers decided to use good old 2D environment. The dungeon can be represented as a rectangle matrix of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" columns. Cell "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" is the cell in the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-th row in the "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"-th column. Lara can move between the neighbouring by side cells in all four directions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Moreover, she has even chosen the path for herself to avoid all the traps. She enters the dungeon in cell "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":", that is top left corner of the matrix. Then she goes down all the way to cell "},{"kind":"math_inline","text":"(n, 1)"},{"kind":"text","text":" — the bottom left corner. Then she starts moving in the snake fashion — all the way to the right, one cell up, then to the left to the cell in "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd column, one cell up. She moves until she runs out of non-visited cells. "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" given are such that she always end up in cell "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Lara has already moved to a neighbouring cell "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" times. Can you determine her current position?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n, m ≤ 109"},{"kind":"text","text":", "},{"children":[{"kind":"math_inline","text":"n"},{"kind":"text","text":" is always even"}],"kind":"container"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k < n·m"},{"kind":"text","text":"). Note that "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" doesn't fit into "},{"kind":"math_inline","text":"32"},{"kind":"text","text":"-bit integer type!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the cell (the row and the column where the cell is situated) where Lara ends up after she moves "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" times."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here is her path on matrix "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"3"},{"kind":"text","text":":"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/4e5454a3316d8c6f9f5f9af891335135e4e268f2e89fcdd48fbfd4e7b5d9149d.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"976B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/976/problem/B"}