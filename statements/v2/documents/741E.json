{"assets":["/statement-assets/5a6ceb32e76e6645e5f213e0d71978538a0abba5590eb7a81e8a78b3216a3dd6.png","/statement-assets/4c27149f5c62433cda70ee90a2e17724f08a9a8eb9a1adce0af3c5ec07fdb525.png","/statement-assets/e3764684cea60280607a8473e8057692fcf7397793bb3254551984bf99e09b1f.png"],"contentKind":"statement","contestId":"741","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Arpa’s abnormal DNA and Mehrdad’s deep interest"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"All of us know that girls in Arpa’s land are... ok, you’ve got the idea :D"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Anyone knows that Arpa isn't a normal man, he is ... well, sorry, I can't explain it more. Mehrdad is interested about the reason, so he asked Sipa, one of the best biology scientists in Arpa's land, for help. Sipa has a DNA editor."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5a6ceb32e76e6645e5f213e0d71978538a0abba5590eb7a81e8a78b3216a3dd6.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Sipa put Arpa under the DNA editor. DNA editor showed Arpa's DNA as a string "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase English letters. Also Sipa has another DNA "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" consisting of lowercase English letters that belongs to a normal man."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now there are "},{"kind":"math_inline","text":"(n + 1)"},{"kind":"text","text":" options to change Arpa's DNA, numbered from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them is to put "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" between "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th and "},{"kind":"math_inline","text":"(i + 1)"},{"kind":"text","text":"-th characters of "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ i ≤ n"},{"kind":"text","text":"). If "},{"kind":"math_inline","text":"i = 0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" will be put before "},{"kind":"math_inline","text":"S"},{"kind":"text","text":", and if "},{"kind":"math_inline","text":"i = n"},{"kind":"text","text":", it will be put after "},{"kind":"math_inline","text":"S"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mehrdad wants to choose the most "},{"children":[{"kind":"text","text":"interesting"}],"kind":"container"},{"kind":"text","text":" option for Arpa's DNA among these "},{"kind":"math_inline","text":"n + 1"},{"kind":"text","text":" options. DNA "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is more "},{"children":[{"kind":"text","text":"interesting"}],"kind":"container"},{"kind":"text","text":" than "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" if "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is lexicographically smaller than "},{"kind":"math_inline","text":"B"},{"kind":"text","text":". Mehrdad asked Sipa "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" questions: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given integers "},{"kind":"math_inline","text":"l, r, k, x, y"},{"kind":"text","text":", what is the most interesting option if we only consider such options "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" that "},{"kind":"math_inline","text":"l ≤ i ≤ r"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/statement-assets/4c27149f5c62433cda70ee90a2e17724f08a9a8eb9a1adce0af3c5ec07fdb525.png"},"kind":"image"},{"kind":"text","text":"? If there are several most interesting options, Mehrdad wants to know one with the smallest number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since Sipa is a biology scientist but not a programmer, you should help him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains strings "},{"kind":"math_inline","text":"S"},{"kind":"text","text":", "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" and integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |S|, |T|, q ≤ 105"},{"kind":"text","text":") — Arpa's DNA, the DNA of a normal man, and the number of Mehrdad's questions. The strings "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" consist only of small English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines describe the Mehrdad's questions. Each of these lines contain five integers "},{"kind":"math_inline","text":"l, r, k, x, y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ l ≤ r ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ x ≤ y < k"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" integers. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th of them should be the number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" of the most interesting option among those that satisfy the conditions of the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th question. If there is no option "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" satisfying the conditions in some question, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abc d 4\n0 3 2 0 0\n0 3 1 0 0\n1 2 1 0 0\n0 1 3 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 3 2 -1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abbbbbbaaa baababaaab 10\n1 2 1 0 0\n2 7 8 4 7\n2 3 9 2 8\n3 4 6 1 1\n0 8 5 2 4\n2 8 10 4 7\n7 10 1 0 0\n1 4 6 0 2\n0 9 8 0 6\n4 8 5 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 4 2 -1 2 4 10 1 1 5 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Explanation of first sample case:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first question Sipa has two options: "},{"children":[{"kind":"text","text":"dabc"}],"kind":"container"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"i = 0"},{"kind":"text","text":") and "},{"children":[{"kind":"text","text":"abdc"}],"kind":"container"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"i = 2"},{"kind":"text","text":"). The latter ("},{"children":[{"kind":"text","text":"abcd"}],"kind":"container"},{"kind":"text","text":") is better than "},{"children":[{"kind":"text","text":"abdc"}],"kind":"container"},{"kind":"text","text":", so answer is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the last question there is no "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"0 ≤ i ≤ 1"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/statement-assets/e3764684cea60280607a8473e8057692fcf7397793bb3254551984bf99e09b1f.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"741E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/741/problem/E"}