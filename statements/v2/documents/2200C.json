{"assets":[],"contentKind":"statement","contestId":"2200","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Specialty String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"AksLolCoding is playing a game on a string $$$s$$$ of length $$$n$$$. Initially, $$$s$$$ contains only lowercase Latin characters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one turn, AksLolCoding can choose any pair of integers $$$(i,j)$$$ such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1 \\leq i \\lt j \\leq n$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s_i = s_j \\neq *$$$; and "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s_k = *$$$ for all $$$i \\lt k \\lt j$$$. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" If no such $$$i,j$$$ exists, then the game ends. Otherwise, AksLolCoding sets $$$s_i:=*$$$ and $$$s_j:=*$$$."},{"children":[{"kind":"text","text":"Once the game ends, AksLolCoding wins if and only if every character in $$$s$$$ is equal to $$$*$$$. Determine if it is possible for AksLolCoding to win."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note:"}],"kind":"container"},{"kind":"text","text":" $$$*$$$ represents ASCII character 42."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\leq t \\leq 100$$$), the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains an integer $$$n$$$ ($$$1 \\leq n \\leq 5000$$$), the length of the string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$s$$$ consisting of lowercase Latin characters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of $$$n$$$ over all test cases does not exceed $$$5000$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the answer to each test case on its own line. If AksLolCoding can win, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes). Else, output \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output the answer in any case (upper or lower). For example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be recognized as positive responses."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1\na\n6\nllmllm\n6\nuwuuwu\n6\nbyebye\n6\noooioi\n12\nsiixxsevvenn\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\nYES\nYES\nNO\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, it can be shown that it is impossible for AksLolCoding to win."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, AksLolCoding can win by making the following moves: "},{"children":[{"kind":"text","text":"llmllm"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"llm**m"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"**m**m"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"******"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, AksLolCoding can win by making the following moves: "},{"children":[{"kind":"text","text":"uwuuwu"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"uw**wu"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"u****u"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"******"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"2200C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2200/problem/C"}