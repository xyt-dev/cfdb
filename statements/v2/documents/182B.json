{"assets":[],"contentKind":"statement","contestId":"182","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Vasya's Calendar"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya lives in a strange world. The year has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" months and the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th month has "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" days. Vasya got a New Year present — the clock that shows not only the time, but also the date."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The clock's face can display any number from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". It is guaranteed that "},{"kind":"math_inline","text":"ai ≤ d"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The clock does not keep information about the current month, so when a new day comes, it simply increases the current day number by one. The clock cannot display number "},{"kind":"math_inline","text":"d + 1"},{"kind":"text","text":", so after day number "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" it shows day "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" (the current day counter resets). The mechanism of the clock allows you to increase the day number by one manually. When you execute this operation, day "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" is also followed by day "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya begins each day checking the day number on the clock. If the day number on the clock does not match the actual day number in the current month, then Vasya manually increases it by one. Vasya is persistent and repeats this operation until the day number on the clock matches the actual number of the current day in the current month."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A year passed and Vasya wonders how many times he manually increased the day number by one, from the first day of the first month to the last day of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th month inclusive, considering that on the first day of the first month the clock display showed day "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the single number "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" — the maximum number of the day that Vasya's clock can show "},{"kind":"math_inline","text":"(1 ≤ d ≤ 106)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the number of months in the year "},{"kind":"math_inline","text":"(1 ≤ n ≤ 2000)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers: "},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"(1 ≤ ai ≤ d)"},{"kind":"text","text":" — the number of days in each month in the order in which they follow, starting from the first one. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the number of times Vasya manually increased the day number by one throughout the last year."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n3\n3 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"31\n12\n31 28 31 30 31 30 31 31 30 31 30 31\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the situation is like this: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Day 1. Month 1. The clock shows "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Vasya changes nothing. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Day 2. Month 1. The clock shows "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Vasya changes nothing. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Day 1. Month 2. The clock shows "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". Vasya manually increases the day number by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". After that the clock shows "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". Vasya increases the day number by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" manually. After that the clock shows "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Day 2. Month 2. The clock shows "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Vasya changes nothing. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" In total, Vasya manually changed the day number by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" exactly "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" times."}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"182B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/182/problem/B"}