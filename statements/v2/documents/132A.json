{"assets":[],"contentKind":"statement","contestId":"132","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Turing Tape"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"INTERCAL is the oldest of esoteric programming languages. One of its many weird features is the method of character-based output, known as Turing Tape method. It converts an array of unsigned 8-bit integers into a sequence of characters to print, using the following method."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The integers of the array are processed one by one, starting from the first. Processing "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th element of the array is done in three steps:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1. The 8-bit binary notation of the ASCII-code of the previous printed character is reversed. When the first element of the array is processed, the result of this step is considered to be 0."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th element of the array is subtracted from the result of the previous step modulo 256."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"3. The binary notation of the result of the previous step is reversed again to produce ASCII-code of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character to be printed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the text printed using this method. Restore the array used to produce this text."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input will consist of a single line "},{"kind":"math_inline","text":"text"},{"kind":"text","text":" which contains the message printed using the described method. String "},{"kind":"math_inline","text":"text"},{"kind":"text","text":" will contain between 1 and 100 characters, inclusive. ASCII-code of each character of "},{"kind":"math_inline","text":"text"},{"kind":"text","text":" will be between 32 (space) and 126 (tilde), inclusive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the initial array, which was used to produce "},{"kind":"math_inline","text":"text"},{"kind":"text","text":", one integer per line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"Hello, World!\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"238\n108\n112\n0\n64\n194\n48\n26\n244\n168\n24\n16\n162\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's have a closer look at the beginning of the example. The first character is \""},{"children":[{"kind":"text","text":"H"}],"kind":"container"},{"kind":"text","text":"\" with ASCII-code "},{"kind":"math_inline","text":"72 = 010010002"},{"kind":"text","text":". Its reverse is "},{"kind":"math_inline","text":"000100102 = 18"},{"kind":"text","text":", and this number should become the result of the second step of processing. The result of the first step is considered to be 0, so the first element of the array has to be "},{"kind":"math_inline","text":"(0 - 18)"},{"kind":"text","text":" mod "},{"kind":"math_inline","text":"256 = 238"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" mod "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is the remainder of division of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"132A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/132/problem/A"}