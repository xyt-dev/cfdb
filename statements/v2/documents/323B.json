{"assets":[],"contentKind":"statement","contestId":"323","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Tournament-graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In this problem you have to build tournament graph, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices, such, that for any oriented pair of vertices "},{"kind":"math_inline","text":"(v, u)"},{"kind":"math_inline","text":"(v ≠ u)"},{"kind":"text","text":" there exists a path from vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" consisting of no more then two edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A directed graph without self-loops is a "},{"children":[{"kind":"text","text":"tournament"}],"kind":"container"},{"kind":"text","text":", if there is exactly one edge between any two distinct vertices (in one out of two possible directions)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(3 ≤ n ≤ 1000)"},{"kind":"text","text":", the number of the graph's vertices."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if there is no graph, satisfying the described conditions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers in each. The numbers should be separated with spaces. That is adjacency matrix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of the found tournament. Consider the graph vertices to be numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Then "},{"kind":"math_inline","text":"av, u = 0"},{"kind":"text","text":", if there is no edge from "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"av, u = 1"},{"kind":"text","text":" if there is one. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As the output graph has to be a tournament, following equalities must be satisfied: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"av, u + au, v = 1"},{"kind":"text","text":" for each "},{"kind":"math_inline","text":"v, u"},{"kind":"math_inline","text":"(1 ≤ v, u ≤ n; v ≠ u)"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"av, v = 0"},{"kind":"text","text":" for each "},{"kind":"math_inline","text":"v"},{"kind":"math_inline","text":"(1 ≤ v ≤ n)"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 1 0\n0 0 1\n1 0 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"323B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/323/problem/B"}