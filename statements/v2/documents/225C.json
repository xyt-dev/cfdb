{"assets":[],"contentKind":"statement","contestId":"225","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Barcode"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" pixel picture. Each pixel can be white or black. Your task is to change the colors of as few pixels as possible to obtain a barcode picture."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A picture is a barcode if the following conditions are fulfilled: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" All pixels in each column are of the same color. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The width of each monochrome vertical line is at least "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and at most "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" pixels. In other words, if we group all neighbouring columns of the pixels with equal color, the size of each group can not be less than "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" or greater than "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m, x, y ≤ 1000; x ≤ y"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, describing the original image. Each of these lines contains exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters. Character \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" represents a white pixel and \""},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"\" represents a black pixel. The picture description doesn't have any other characters besides \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the minimum number of pixels to repaint. It is guaranteed that the answer exists. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 5 1 2\n##.#.\n.###.\n###..\n#...#\n.##.#\n###..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"