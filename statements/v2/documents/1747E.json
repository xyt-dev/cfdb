{"assets":[],"contentKind":"statement","contestId":"1747","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. List Generation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"For given integers $$$n$$$ and $$$m$$$, let's call a pair of arrays $$$a$$$ and $$$b$$$ of integers "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":", if they satisfy the following conditions: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a$$$ and $$$b$$$ have the same length, let their length be $$$k$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$k \\ge 2$$$ and $$$a_1 = 0, a_k = n, b_1 = 0, b_k = m$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" For each $$$1 \\lt i \\le k$$$ the following holds: $$$a_i \\geq a_{i - 1}$$$, $$$b_i \\geq b_{i - 1}$$$, and $$$a_i + b_i \\neq a_{i - 1} + b_{i - 1}$$$."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Find the sum of $$$|a|$$$ over all good pairs of arrays $$$(a,b)$$$. Since the answer can be very large, output it modulo $$$10^9 + 7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of multiple test cases. The first line contains a single integer $$$t (1 \\leq t \\leq 10^4)$$$  — the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains two integers $$$n$$$ and $$$m$$$ $$$(1 \\leq n, m \\leq 5 \\cdot 10^6)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$5 \\cdot 10^6$$$ and the sum of $$$m$$$ over all test cases does not exceed $$$5 \\cdot 10^6$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer  — the sum of $$$|a|$$$ over all good pairs of arrays $$$(a,b)$$$ modulo $$$10^9 + 7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 1\n1 2\n2 2\n100 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n26\n101\n886336572\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"first testcase"}],"kind":"container"},{"kind":"text","text":", the good pairs of arrays are "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$([0, 1], [0, 1])$$$, length = $$$2$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$([0, 1, 1], [0, 0, 1])$$$, length = $$$3$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$([0, 0, 1], [0, 1, 1])$$$, length = $$$3$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Hence the sum of the lengths would be $$${2 + 3 + 3} = 8$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1747E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1747/problem/E"}