{"assets":["/statement-assets/17ce415f04b1412191d5cd7b1f9a4bac5093acfed86e72483f1cfd27c87f0bb8.png","/statement-assets/c9144a92146b9ce3bb93286386a72f054fc7aa426d519ebbfb8aece67dfdccdf.png","/statement-assets/0948ad582c440e16f2a63943d2426d13aaa170f184dcd5b26607aff2f740ba40.png","/statement-assets/5617a714562ea617143ac206ad410bbdc3bacb86222d1584218e94662caa5caa.png","/statement-assets/50cd91634d91066d5c4391c2426d7e472d77af33fd2f97c2a40a67539ab08198.png"],"contentKind":"statement","contestId":"1338","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Edge Weight Assignment"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have unweighted tree of $$$n$$$ vertices. You have to assign a "},{"children":[{"kind":"text","text":"positive"}],"kind":"container"},{"kind":"text","text":" weight to each edge so that the following condition would hold:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" For every two different leaves $$$v_{1}$$$ and $$$v_{2}$$$ of this tree, "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise XOR"}],"kind":"link"},{"kind":"text","text":" of weights of all edges on the simple path between $$$v_{1}$$$ and $$$v_{2}$$$ has to be equal to $$$0$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that you can put "},{"children":[{"kind":"text","text":"very large"}],"kind":"container"},{"kind":"text","text":" positive integers (like $$$10^{(10^{10})}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that such assignment always exists under given constraints. Now let's define $$$f$$$ as "},{"children":[{"kind":"text","text":"the number of distinct weights"}],"kind":"container"},{"kind":"text","text":" in assignment."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/17ce415f04b1412191d5cd7b1f9a4bac5093acfed86e72483f1cfd27c87f0bb8.png"},"kind":"image"},{"kind":"text","text":" In this example, assignment is valid, because bitwise XOR of all edge weights between every pair of leaves is $$$0$$$. $$$f$$$ value is $$$2$$$ here, because there are $$$2$$$ distinct edge weights($$$4$$$ and $$$5$$$)."},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c9144a92146b9ce3bb93286386a72f054fc7aa426d519ebbfb8aece67dfdccdf.png"},"kind":"image"},{"kind":"text","text":" In this example, assignment is invalid, because bitwise XOR of all edge weights between vertex $$$1$$$ and vertex $$$6$$$ ($$$3, 4, 5, 4$$$) is not $$$0$$$. "}],"kind":"paragraph"}],"kind":"container"},{"children":[{"kind":"text","text":"What are the minimum and the maximum possible values of $$$f$$$ for the given tree? Find and print both."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer $$$n$$$ ($$$3 \\le n \\le 10^{5}$$$) — the number of vertices in given tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the next $$$n-1$$$ lines contains two integers $$$a_{i}$$$ and $$$b_{i}$$$ ($$$1 \\le a_{i} \\lt b_{i} \\le n$$$) — it means there is an edge between $$$a_{i}$$$ and $$$b_{i}$$$. It is guaranteed that given graph forms tree of $$$n$$$ vertices."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two integers — the minimum and maximum possible value of $$$f$$$ can be made from valid assignment of given tree. Note that it's always possible to make an assignment under given constraints."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 3\n2 3\n3 4\n4 5\n5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 3\n2 3\n3 4\n4 5\n4 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n1 2\n2 7\n3 4\n4 7\n5 6\n6 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, possible assignments for each minimum and maximum are described in picture below. Of course, there are multiple possible assignments for each minimum and maximum. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0948ad582c440e16f2a63943d2426d13aaa170f184dcd5b26607aff2f740ba40.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second example, possible assignments for each minimum and maximum are described in picture below. The $$$f$$$ value of valid assignment of this tree is always $$$3$$$. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5617a714562ea617143ac206ad410bbdc3bacb86222d1584218e94662caa5caa.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the third example, possible assignments for each minimum and maximum are described in picture below. Of course, there are multiple possible assignments for each minimum and maximum. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/50cd91634d91066d5c4391c2426d7e472d77af33fd2f97c2a40a67539ab08198.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1338B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1338/problem/B"}