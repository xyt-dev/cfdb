{"assets":[],"contentKind":"statement","contestId":"1328","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. K-th Beautiful String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"For the given integer $$$n$$$ ($$$n \\gt 2$$$) let's write down all the strings of length $$$n$$$ which contain $$$n-2$$$ letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and two letters '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' in "},{"children":[{"kind":"text","text":"lexicographical"}],"kind":"container"},{"kind":"text","text":" (alphabetical) order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Recall that the string $$$s$$$ of length $$$n$$$ is lexicographically less than string $$$t$$$ of length $$$n$$$, if there exists such $$$i$$$ ($$$1 \\le i \\le n$$$), that $$$s_i \\lt t_i$$$, and for any $$$j$$$ ($$$1 \\le j \\lt i$$$) $$$s_j = t_j$$$. The lexicographic comparison of strings is implemented by the operator "},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":" in modern programming languages."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if $$$n=5$$$ the strings are (the order does matter):"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"children":[{"kind":"text","text":"aaabb"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"aabab"}],"kind":"container"}],"kind":"list_item"},{"chi