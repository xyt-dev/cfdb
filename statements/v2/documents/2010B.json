{"assets":[],"contentKind":"statement","contestId":"2010","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Three Brothers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Three brothers agreed to meet. Let's number the brothers as follows: the oldest brother is number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", the middle brother is number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", and the youngest brother is number "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When it was time for the meeting, one of the brothers was late. Given the numbers of the two brothers who arrived on time, you need to determine the number of the brother who was late."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two different integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a ≠ b"},{"kind":"text","text":") — the numbers of the brothers who arrived on time. The numbers are given in arbitrary order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind"