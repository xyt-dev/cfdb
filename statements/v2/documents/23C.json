{"assets":[],"contentKind":"statement","contestId":"23","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Oranges and Apples"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In "},{"kind":"math_inline","text":"2N - 1"},{"kind":"text","text":" boxes there are apples and oranges. Your task is to choose "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" boxes so, that they will contain not less than half of all the apples and not less than half of all the oranges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains one number "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" — amount of tests. The description of each test starts with a natural number "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" — amount of boxes. Each of the following "},{"kind":"math_inline","text":"2N - 1"},{"kind":"text","text":" lines contains numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"oi"},{"kind":"text","text":" — amount of apples and oranges in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th box ("},{"kind":"math_inline","text":"0 ≤ ai, oi ≤ 109"},{"kind":"text","text":"). The sum of "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" in all the tests in the input doesn't exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":". All the input numbers are integer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test output two lines. In the first line output "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":", if it's possible to choose "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" boxes, or "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" otherwise. If the answer is positive output in the second line "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" numbers — indexes of the chosen boxes. Boxes are numbered from 1 in the input order. Otherwise leave the second line empty. Separate the numbers with one space."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n2\n10 15\n5 7\n20 18\n1\n0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1 3\nYES\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"23C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/23/problem/C"}