{"assets":["/statement-assets/7b7fbf2d2f14bba1957e302c3c04b3f6dac9a9e3053112ec48dd11325b4eadbc.png","/statement-assets/8907927e03491e27d81797c059c38eaa3ac1b4416b334b06a72e61b536c6aac2.png","/statement-assets/4d6f820f4d72f1994321227487e3d4d56fd76c772b97cbb3d1f85a55f605ed03.png","/statement-assets/e8f1b2ffb012c1322602a72d1dd5a9845d1b462bd6cc7afaf45eb484cd52fcbf.png"],"contentKind":"statement","contestId":"587","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Duff in Mafia"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"6 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Duff is one if the heads of Mafia in her country, Andarz Gu. Andarz Gu has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities (numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":") connected by "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" bidirectional roads (numbered by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each road has a destructing time, and a color. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road connects cities "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and its color is "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" and its destructing time is "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mafia wants to destruct a "},{"children":[{"kind":"text","text":"matching"}],"kind":"container"},{"kind":"text","text":" in Andarz Gu. A "},{"children":[{"kind":"text","text":"matching"}],"kind":"container"},{"kind":"text","text":" is a subset of roads such that no two roads in this subset has common endpoint. They can destruct these roads in parallel, i. e. the total destruction time is a maximum over destruction times of all selected roads."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/7b7fbf2d2f14bba1957e302c3c04b3f6dac9a9e3053112ec48dd11325b4eadbc.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"They want two conditions to be satisfied:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The remaining roads form a "},{"children":[{"kind":"text","text":"proper coloring"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Destructing time of this matching is minimized. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The remaining roads after destructing this matching form a "},{"children":[{"kind":"text","text":"proper coloring"}],"kind":"container"},{"kind":"text","text":" if and only if no two roads of the same color have same endpoint, or, in the other words, edges of each color should form a "},{"children":[{"kind":"text","text":"matching"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is no programmer in Mafia. That's why Duff asked for your help. Please help her and determine which matching to destruct in order to satisfied those conditions (or state that this is not possible)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 5 × 104"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 ≤ m ≤ 5 × 104"},{"kind":"text","text":"), number of cities and number of roads in the country."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the the roads. "},{"kind":"math_inline","text":"i - th"},{"kind":"text","text":" of them contains four integers "},{"kind":"math_inline","text":"vi, ui, ci"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ vi, ui ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi ≠ ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 ≤ ci, ti ≤ 109"},{"kind":"text","text":" for each "},{"kind":"math_inline","text":"1 ≤ i ≤ m"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line of input, print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if satisfying the first condition is possible and \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it is possible, then you have to print two integers "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" in the second line, the minimum destructing time and the number of roads in the matching ("},{"attrs":{"alt":"","src":"/statement-assets/8907927e03491e27d81797c059c38eaa3ac1b4416b334b06a72e61b536c6aac2.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" distinct integers separated by spaces, indices of the roads in the matching in any order. Roads are numbered starting from one in order of their appearance in the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there's more than one solution, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 7\n2 1 3 7\n3 1 1 6\n5 4 1 8\n4 5 1 1\n3 2 2 3\n4 5 2 5\n2 3 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n3 2\n4 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n3 2 1 3\n1 3 1 1\n3 2 1 4\n1 3 2 2\n1 3 2 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Graph of Andarz Gu in the first sample case is as follows:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/4d6f820f4d72f1994321227487e3d4d56fd76c772b97cbb3d1f85a55f605ed03.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"A solution would be to destruct the roads with crosses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Graph of Andarz Gu in the second sample case is as follows:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e8f1b2ffb012c1322602a72d1dd5a9845d1b462bd6cc7afaf45eb484cd52fcbf.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"587D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/587/problem/D"}