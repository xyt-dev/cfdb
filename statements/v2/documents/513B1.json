{"assets":["/statement-assets/ec7b7264216bc496317c0f8b71109629d40cd7cd7be1eb75de29bde1940fcd67.png"],"contentKind":"statement","contestId":"513","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B1. Permutations"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" of numbers "},{"kind":"math_inline","text":"1, 2, ..., n"},{"kind":"text","text":". Let's define "},{"kind":"math_inline","text":"f(p)"},{"kind":"text","text":" as the following sum:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ec7b7264216bc496317c0f8b71109629d40cd7cd7be1eb75de29bde1940fcd67.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Find the lexicographically "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-th permutation of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in the set of permutations having the maximum possible value of "},{"kind":"math_inline","text":"f(p)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line of input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ cntn"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"cntn"},{"kind":"text","text":" is the number of permutations of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" with maximum possible value of "},{"kind":"math_inline","text":"f(p)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"The problem consists of two subproblems. The subproblems have different constraints on the input. You will get some score for the correct submission of the subproblem. The description of the subproblems follows."}],"kind":"container"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" In subproblem B1 ("},{"kind":"math_inline","text":"3"},{"kind":"text","text":" points), the constraint "},{"kind":"math_inline","text":"1 ≤ n ≤ 8"},{"kind":"text","text":" will hold. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" In subproblem B2 ("},{"kind":"math_inline","text":"4"},{"kind":"text","text":" points), the constraint "},{"kind":"math_inline","text":"1 ≤ n ≤ 50"},{"kind":"text","text":" will hold. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" number forming the required permutation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3 2 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, both permutations of numbers {1, 2} yield maximum possible "},{"kind":"math_inline","text":"f(p)"},{"kind":"text","text":" which is equal to 4. Among them, "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":" comes second in lexicographical order."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B1","problemCode":"513B1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/513/problem/B1"}