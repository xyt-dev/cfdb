{"assets":["/statement-assets/0d0c62cb61fb014ed3e37eee22cdd9ff5599a41e142fa7e7239402877275cd00.png"],"contentKind":"statement","contestId":"854","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Fraction"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya is a big fan of mathematics, especially its part related to fractions. Recently he learned that a fraction "},{"attrs":{"alt":"","src":"/statement-assets/0d0c62cb61fb014ed3e37eee22cdd9ff5599a41e142fa7e7239402877275cd00.png"},"kind":"image"},{"kind":"text","text":" is called "},{"children":[{"kind":"text","text":"proper"}],"kind":"container"},{"kind":"text","text":" iff its numerator is smaller than its denominator ("},{"kind":"math_inline","text":"a < b"},{"kind":"text","text":") and that the fraction is called "},{"children":[{"kind":"text","text":"irreducible"}],"kind":"container"},{"kind":"text","text":" if its numerator and its denominator are coprime (they do not have positive common divisors except "},{"kind":"math_inline","text":"1"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During his free time, Petya thinks about proper irreducible fractions and converts them to decimals using the calculator. One day he mistakenly pressed addition button ("},{"kind":"math_inline","text":" + "},{"kind":"text","text":") instead of division button ("},{"kind":"math_inline","text":"÷"},{"kind":"text","text":") and got sum of numerator and denominator that was equal to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" instead of the expected decimal notation. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya wanted to restore the original fraction, but soon he realized that it might not be done uniquely. That's why he decided to determine maximum possible proper irreducible fraction "},{"attrs":{"alt":"","src":"/statement-assets/0d0c62cb61fb014ed3e37eee22cdd9ff5599a41e142fa7e7239402877275cd00.png"},"kind":"image"},{"kind":"text","text":" such that sum of its numerator and denominator equals "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Help Petya deal with this problem."}],"kind":"paragraph"},{"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line of input there is an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 1000"},{"kind":"text","text":"), the sum of numerator and denominator of the fraction."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output two space-separated positive integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", numerator and denominator of the maximum possible proper irreducible fraction satisfying the given sum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5 7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"854A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/854/problem/A"}