{"assets":[],"contentKind":"statement","contestId":"777","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Alyona and Spreadsheet"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"During the lesson small girl Alyona works with one famous spreadsheet computer program and learns how to edit tables."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now she has a table filled with integers. The table consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" columns. By "},{"kind":"math_inline","text":"ai, j"},{"kind":"text","text":" we will denote the integer located at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column. We say that the table is sorted in non-decreasing order in the column "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" if "},{"kind":"math_inline","text":"ai, j ≤ ai + 1, j"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Teacher gave Alyona "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" tasks. For each of the tasks two integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" are given and Alyona has to answer the following question: if one keeps the rows from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" inclusive and deletes all others, will the table be sorted in non-decreasing order in at least one column? Formally, does there exist such "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" that "},{"kind":"math_inline","text":"ai, j ≤ ai + 1, j"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r - 1"},{"kind":"text","text":" inclusive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Alyona is too small to deal with this task and asks you to help!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n·m ≤ 100 000"},{"kind":"text","text":") — the number of rows and the number of columns in the table respectively. Note that your are given a constraint that bound the product of these two integers, i.e. the number of elements in the table."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th integers in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" of these lines stands for "},{"kind":"math_inline","text":"ai, j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, j ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line of the input contains an integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 100 000"},{"kind":"text","text":") — the number of task that teacher gave to Alyona."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line of the output if the table consisting of rows from "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" inclusive is sorted in non-decreasing order in at least one column. Otherwise, print \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n1 2 3 5\n3 1 3 2\n4 5 2 3\n5 5 3 2\n4 4 3 4\n6\n1 1\n2 5\n4 5\n3 5\n1 3\n1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\nNo\nYes\nYes\nYes\nNo\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the sample, the whole table is not sorted in any column. However, rows 1–3 are sorted in column "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", while rows 4–5 are sorted in column "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"777C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/777/problem/C"}