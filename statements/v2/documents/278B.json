{"assets":[],"contentKind":"statement","contestId":"278","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. New Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Coming up with a new problem isn't as easy as many people think. Sometimes it is hard enough to name it. We'll consider a title "},{"children":[{"kind":"text","text":"original"}],"kind":"container"},{"kind":"text","text":" if it doesn't occur as a substring in any titles of recent Codeforces problems. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You've got the titles of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" last problems — the strings, consisting of lowercase English letters. Your task is to find the shortest original title for the new problem. If there are multiple such titles, choose the lexicographically minimum one. Note, that title of the problem can't be an empty string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"math_inline","text":"s[l... r]"},{"kind":"math_inline","text":"(1 ≤ l ≤ r ≤ |s|)"},{"kind":"text","text":" of string "},{"kind":"math_inline","text":"s = s1s2... s|s|"},{"kind":"text","text":" (where "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":" is the length of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":") is string "},{"kind":"math_inline","text":"slsl + 1... sr"},{"kind":"text","text":"."}],"