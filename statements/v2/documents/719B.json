{"assets":[],"contentKind":"statement","contestId":"719","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Anatoly and Cockroaches"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Anatoly lives in the university dorm as many other students do. As you know, cockroaches are also living there together with students. Cockroaches might be of two colors: black and red. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cockroaches living in Anatoly's room."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Anatoly just made all his cockroaches to form a single line. As he is a perfectionist, he would like the colors of cockroaches in the line to "},{"children":[{"kind":"text","text":"alternate"}],"kind":"container"},{"kind":"text","text":". He has a can of black paint and a can of red paint. In one turn he can either swap any two cockroaches, or take any single cockroach and change it's color."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Anatoly find out the minimum number of turns he needs to make the colors of cockroaches in the line alternate."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of cockroaches."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", consisting of characters '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"' that denote black cockroach and red cockroach respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the minimum number of moves Anatoly has to perform in order to make the colors of cockroaches in the line to alternate."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nrbbrr\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nbbbbb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nrbr\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Anatoly has to swap third and fourth cockroaches. He needs "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" turn to do this."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the optimum answer is to paint the second and the fourth cockroaches red. This requires "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" turns."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, the colors of cockroaches in the line are alternating already, thus the answer is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"719B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/719/problem/B"}