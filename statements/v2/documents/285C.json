ext":"3\n-1 -1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample you should decrease the first number by one and then increase the second number by one. The resulting permutation is "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample you need 6 moves to build permutation "},{"kind":"math_inline","text":"(1, 3, 2)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"285C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/285/problem/C"}