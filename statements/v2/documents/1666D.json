{"assets":[],"contentKind":"statement","contestId":"1666","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Deletive Editing"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Daisy loves playing games with words. Recently, she has been playing the following Deletive Editing word game with Daniel. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Daisy picks a word, for example, \""},{"children":[{"kind":"text","text":"DETERMINED"}],"kind":"container"},{"kind":"text","text":"\". On each game turn, Daniel calls out a letter, for example, '"},{"children":[{"kind":"text","text":"E"}],"kind":"container"},{"kind":"text","text":"', and Daisy removes "},{"children":[{"kind":"text","text":"the first occurrence"}],"kind":"container"},{"kind":"text","text":" of this letter from the word, getting \""},{"children":[{"kind":"text","text":"DTERMINED"}],"kind":"container"},{"kind":"text","text":"\". On the next turn, Daniel calls out a letter again, for example, '"},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"', and Daisy removes its first occurrence, getting \""},{"children":[{"kind":"text","text":"TERMINED"}],"kind":"container"},{"kind":"text","text":"\". They continue with '"},{"children":[{"kind":"text","text":"I"}],"kind":"container"},{"kind":"text","text":"', getting \""},{"children":[{"kind":"text","text":"TERMNED"}],"kind":"container"},{"kind":"text","text":"\", with '"},{"children":[{"kind":"text","text":"N"}],"kind":"container"},{"kind":"text","text":"', getting \""},{"children":[{"kind":"text","text":"TERMED"}],"kind":"container"},{"kind":"text","text":"\", and with '"},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"', getting \""},{"children":[{"kind":"text","text":"TERME"}],"kind":"container"},{"kind":"text","text":"\". Now, if Daniel calls out the letter '"},{"children":[{"kind":"text","text":"E"}],"kind":"container"},{"kind":"text","text":"', Daisy gets \""},{"children":[{"kind":"text","text":"TRME"}],"kind":"container"},{"kind":"text","text":"\", but there is no way she can get the word \""},{"children":[{"kind":"text","text":"TERM"}],"kind":"container"},{"kind":"text","text":"\" if they start playing with the word \""},{"children":[{"kind":"text","text":"DETERMINED"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Daisy is curious if she can get the final word of her choice, starting from the given initial word, by playing this game for zero or more turns. Your task it help her to figure this out."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer $$$n$$$ — the number of test cases ($$$1 \\le n \\le 10\\,000$$$). The following $$$n$$$ lines contain test cases. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two words $$$s$$$ and $$$t$$$ separated by a space. Each word consists of at least one and at most 30 uppercase English letters; $$$s$$$ is the Daisy's initial word for the game; $$$t$$$ is the final word that Daisy would like to get at the end of the game."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output $$$n$$$ lines to the output — a single line for each test case. Output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if it is possible for Daisy to get from the initial word $$$s$$$ to the final word $$$t$$$ by playing the Deletive Editing game. Output \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\nDETERMINED TRME\nDETERMINED TERM\nPSEUDOPSEUDOHYPOPARATHYROIDISM PEPA\nDEINSTITUTIONALIZATION DONATION\nCONTEST CODE\nSOLUTION SOLUTION\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\nNO\nYES\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1666D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1666/problem/D"}