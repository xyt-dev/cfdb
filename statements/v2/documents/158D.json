{"assets":[],"contentKind":"statement","contestId":"158","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Ice Sculptures"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Berland University is preparing to celebrate the 256-th anniversary of its founding! A specially appointed Vice Rector for the celebration prepares to decorate the campus. In the center of the campus "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ice sculptures were erected. The sculptures are arranged in a circle at equal distances from each other, so they form a regular "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-gon. They are numbered in clockwise order with numbers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The site of the University has already conducted a voting that estimated each sculpture's characteristic of "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" — the degree of the sculpture's attractiveness. The values of "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" can be positive, negative or zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When the university rector came to evaluate the work, he said that this might be not the perfect arrangement. He suggested to melt some of the sculptures so that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the remaining sculptures form a regular polygon (the number of vertices should be between 3 and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the sum of the "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" values of the remaining sculptures is maximized. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help the Vice Rector to analyze the criticism — find the maximum value of "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" sum which can be obtained in this way. It is allowed not to melt any sculptures at all. The sculptures can not be moved."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 20000"},{"kind":"text","text":") — the initial number of sculptures. The second line contains a sequence of integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" — the degree of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th sculpture's attractiveness ("},{"kind":"math_inline","text":" - 1000 ≤ ti ≤ 1000"},{"kind":"text","text":"). The numbers on the line are separated by spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the required maximum sum of the sculptures' attractiveness."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n1 2 -3 4 -5 5 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 -2 3 -4 5 -6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 2 3 4 5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"21\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample it is best to leave every second sculpture, that is, leave sculptures with attractivenesses: 2, 4, 5 и 3."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"158D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/158/problem/D"}