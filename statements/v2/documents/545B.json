{"assets":[],"contentKind":"statement","contestId":"545","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Equidistant String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Susie loves strings. Today she calculates distances between them. As Susie is a small girl after all, her strings contain only digits zero and one. She uses the definition of Hamming distance:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We will define the distance between two strings "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" of the same length consisting of digits zero and one as the number of positions "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" isn't equal to "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As besides everything else Susie loves symmetry, she wants to find for two strings "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" such string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", that the distance from "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" was equal to the distance from "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's time for Susie to go to bed, help her find such string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" or state that it is impossible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The length of string "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is within range from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"105"},{"kind":"text","text":". It is guaranteed that both strings contain only digits zero and one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a string of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", consisting of digits zero and one, that meets the problem statement. If no such string exist, print on a single line \"impossible\" (without the quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple possible answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0001\n1011\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0011\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"000\n111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"impossible\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample different answers are possible, namely — 0010, 0011, 0110, 0111, 1000, 1001, 1100, 1101."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"545B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/545/problem/B"}