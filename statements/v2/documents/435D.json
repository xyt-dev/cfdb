{"assets":["/statement-assets/86eeece768788700c7b89bb2a1b916a6281bd03f9d70d459985d0918c8825400.png","/statement-assets/927917d44c222c4d03b45edaf554a7c602b45eddc689a179ff35b01eb2aaeda5.png"],"contentKind":"statement","contestId":"435","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Special Grid"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" grid, some of its nodes are black, the others are white. Moreover, it's not an ordinary grid — each unit square of the grid has painted diagonals."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The figure below is an example of such grid of size "},{"kind":"math_inline","text":"3 × 5"},{"kind":"text","text":". Four nodes of this grid are black, the other "},{"kind":"math_inline","text":"11"},{"kind":"text","text":" nodes are white."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/86eeece768788700c7b89bb2a1b916a6281bd03f9d70d459985d0918c8825400.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Your task is to count the number of such triangles on the given grid that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the corners match the white nodes, and the area is positive; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" all sides go along the grid lines (horizontal, vertical or diagonal); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" no side contains black nodes. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(2 ≤ n, m ≤ 400)"},{"kind":"text","text":". Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters (zeros and ones) — the description of the grid. If the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th character in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line equals zero, then the node on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th horizontal line and on the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th vertical line is painted white. Otherwise, the node is painted black."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The horizontal lines are numbered starting from one from top to bottom, the vertical lines are numbered starting from one from left to right. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of required triangles."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n10000\n10010\n00001\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n00\n00\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n11\n11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The figure below shows red and blue triangles. They are the examples of the required triangles in the first sample. One of the invalid triangles is painted green. It is invalid because not all sides go along the grid lines."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/927917d44c222c4d03b45edaf554a7c602b45eddc689a179ff35b01eb2aaeda5.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"435D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/435/problem/D"}