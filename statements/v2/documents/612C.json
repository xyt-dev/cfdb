{"assets":[],"contentKind":"statement","contestId":"612","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Replace To Make Regular Bracket Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consists of opening and closing brackets of four kinds "},{"children":[{"kind":"text","text":"<>"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"{}"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"[]"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":". There are two types of brackets: opening and closing. You can replace any bracket by another of the same type. For example, you can replace "},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":" by the bracket "},{"children":[{"kind":"text","text":"{"}],"kind":"container"},{"kind":"text","text":", but you can't replace it by "},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following definition of a regular bracket sequence is well-known, so you can be familiar with it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define a regular bracket sequence (RBS). Empty string is RBS. Let "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" be a RBS then the strings "},{"children":[{"kind":"text","text":"<"},{"kind":"math_inline","text":"s1"},{"kind":"text","text":">"},{"kind":"math_inline","text":"s2"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"{"},{"kind":"math_inline","text":"s1"},{"kind":"text","text":"}"},{"kind":"math_inline","text":"s2"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"["},{"kind":"math_inline","text":"s1"},{"kind":"text","text":"]"},{"kind":"math_inline","text":"s2"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"("},{"kind":"math_inline","text":"s1"},{"kind":"text","text":")"},{"kind":"math_inline","text":"s2"}],"kind":"container"},{"kind":"text","text":" are also RBS."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example the string \""},{"children":[{"kind":"text","text":"[[(){}]<>]"}],"kind":"container"},{"kind":"text","text":"\" is RBS, but the strings \""},{"children":[{"kind":"text","text":"[)()"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"][()()"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the least number of replaces to make the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" RBS."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains a non empty string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of only opening and closing brackets of four kinds. The length of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" does not exceed "},{"kind":"math_inline","text":"106"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it's impossible to get RBS from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" print "},{"children":[{"kind":"text","text":"Impossible"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print the least number of replaces needed to get RBS from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"[<}){}\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"{()}[]\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"]]\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"l