{"assets":[],"contentKind":"statement","contestId":"518","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Pasha and Pipe"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"On a certain meeting of a ruling party \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\" minister Pavel suggested to improve the sewer system and to create a new pipe in the city."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The city is an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" rectangular squared field. Each square of the field is either empty (then the pipe can go in it), or occupied (the pipe cannot go in such square). Empty squares are denoted by character '"},{"kind":"math_inline","text":"."},{"kind":"text","text":"', occupied squares are denoted by character '"},{"kind":"math_inline","text":"#"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The pipe must meet the following criteria:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the pipe is a polyline of width "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the pipe goes in empty squares, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the pipe starts from the edge of the field, but not from a corner square, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the pipe ends at the edge of the field but not in a corner square, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the pipe has at most "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" turns ("},{"kind":"math_inline","text":"90"},{"kind":"text","text":" degrees), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the border squares of the field must share "},{"children":[{"kind":"text","text":"exactly two"}],"kind":"container"},{"kind":"text","text":" squares with the pipe, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if the pipe looks like a single segment, then the end points of the pipe must lie on distinct edges of the field, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for each non-border square of the pipe there are "},{"children":[{"kind":"text","text":"exacly two"}],"kind":"container"},{"kind":"text","text":" side-adjacent squares that also belong to the pipe, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for each border square of the pipe there is "},{"children":[{"kind":"text","text":"exactly one"}],"kind":"container"},{"kind":"text","text":" side-adjacent cell that also belongs to the pipe. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Here are some samples of "},{"children":[{"kind":"text","text":"allowed"}],"kind":"container"},{"kind":"text","text":" piping routes: "}],"kind":"paragraph"},{"kind":"code_block","text":"\n           ....#            ....#            .*..#\n           *****            ****.            .***.\n           ..#..            ..#*.            ..#*.\n           #...#            #..*#            #..*#\n           .....            ...*.            ...*.\n"},{"children":[{"kind":"text","text":"Here are some samples of "},{"children":[{"kind":"text","text":"forbidden"}],"kind":"container"},{"kind":"text","text":" piping routes: "}],"kind":"paragraph"},{"kind":"code_block","text":"\n           .**.#            *...#            .*.*#\n           .....            ****.            .*.*.\n           ..#..            ..#*.            .*#*.\n           #...#            #..*#            #*.*#\n           .....            ...*.            .***.\n"},{"children":[{"kind":"text","text":"In these samples the pipes are represented by characters '"},{"kind":"math_inline","text":" * "},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You were asked to write a program that calculates the number of distinct ways to make exactly one pipe in the city. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The two ways to make a pipe are considered distinct if they are distinct in at least one square."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n, m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n, m ≤ 2000"},{"kind":"text","text":") — the height and width of Berland map."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters — the map of the city. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the square of the map is marked by character '"},{"kind":"math_inline","text":"."},{"kind":"text","text":"', then the square is empty and the pipe can through it. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the square of the map is marked by character '"},{"kind":"math_inline","text":"#"},{"kind":"text","text":"', then the square is full and the pipe can't through it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line of the output print a single integer — the number of distinct ways to create a pipe."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n...\n..#\n...\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n..\n..\n..\n..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n#...#\n#...#\n###.#\n###.#\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample there are 3 ways to make a pipe (the squares of the pipe are marked by characters '"},{"kind":"math_inline","text":" * "},{"kind":"tex