{"assets":[],"contentKind":"statement","contestId":"600","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Edge coloring of bipartite graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an undirected bipartite graph without multiple edges. You should paint the edges of graph to minimal number of colours, so that no two adjacent edges have the same colour."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"a, b, m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ m ≤ 105"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is the size of the first part, "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is the size of the second part, "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is the number of edges in the graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"x, y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ a, 1 ≤ y ≤ b"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is the number of the vertex in the first part and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is the number of the vertex in the second part. It is guaranteed that there are no multiple edges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print integer "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" — the minimal number of colours. The second line should contain "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" — the colours of the edges (in the order they appear in the input)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several solutions, you can print any one of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 5\n1 2\n2 2\n3 2\n4 1\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3 1 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"600F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/600/problem/F"}