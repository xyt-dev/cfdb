{"assets":["/statement-assets/5c13551ed62b71af59ea0bc6e6043fabb25f04c7e9c959827aafb7b989d48a08.png","/statement-assets/c641274b03bcb154c47bbe18bd80052a652acf312b59a2fe16342e1496df5f3c.png","/statement-assets/1020ff523cb2c182280145f7e337a2a5b612cb585539d9f071a59f52ca7f8ed8.png"],"contentKind":"statement","contestId":"100","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"J. Interval Coloring"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Aryo has got a lot of intervals for his "},{"kind":"math_inline","text":"2418"},{"kind":"text","text":"th birthday. He is really excited and decided to color all these intervals with some colors. He has a simple rule for himself. He calls a coloring nice if there exists "},{"children":[{"kind":"text","text":"no"}],"kind":"container"},{"kind":"text","text":" three intervals "},{"kind":"math_inline","text":"a, b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" such that the following conditions are satisfied simultaneously: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"a, b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" are colored with the same color, "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5c13551ed62b71af59ea0bc6e6043fabb25f04c7e9c959827aafb7b989d48a08.png"},"kind":"image"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c641274b03bcb154c47bbe18bd80052a652acf312b59a2fe16342e1496df5f3c.png"},"kind":"image"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1020ff523cb2c182280145f7e337a2a5b612cb585539d9f071a59f52ca7f8ed8.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Moreover he found out that for every intervals "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", there is at least one point in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" which isn't in "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given some set of intervals. You have to find the minimum number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", such that Aryo can find a nice coloring with "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" colors."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 103"},{"kind":"text","text":"), number of intervals."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain a interval description each. Each interval is described by two numbers "},{"kind":"math_inline","text":"si, ei"},{"kind":"text","text":" which are the start and end points of it ("},{"kind":"math_inline","text":" - 105 < si, ei < 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"si ≤ ei"},{"kind":"text","text":"). See samples for clarity. A square bracket stands for including of the corresponding endpoint, while a round bracket stands for excluding."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Write a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the minimum number of colors needed for a nice coloring."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n[1,2)\n(3,4]\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n[1,3]\n[2,6]\n(5,7)\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"J","problemCode":"100J","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/100/problem/J"}