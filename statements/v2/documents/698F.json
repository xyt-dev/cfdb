open? Print the answer modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 1 000 000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ pi ≤ n"},{"kind":"text","text":") where "},{"kind":"math_inline","text":"pi = 0"},{"kind":"text","text":" means a gap to fill, and "},{"kind":"math_inline","text":"pi ≥ 1"},{"kind":"text","text":" means a fixed number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that if "},{"kind":"math_inline","text":"i ≠ j"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"pi, pj ≥ 1"},{"kind":"text","text":" then "},{"kind":"math_inline","text":"pi ≠ pj"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of ways to fill the gaps modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":" (i.e. modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","t