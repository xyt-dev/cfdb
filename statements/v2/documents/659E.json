{"assets":["/statement-assets/efca80e95ad5e2fd998c4c5532f1971f8f7e2d807a460f43445e77b307580b42.png","/statement-assets/2fe83c103dd9f23e19339fc9957b59c60337c3d95bf734b01173dc1bbb8d3be2.png","/statement-assets/785e4a2c1c8559b213f0fced4bf66ed80c472d0e13c1cd2fb0266c3b3119c38c.png","/statement-assets/a1a14bbe080f750738cd5a155f33c4186ceac8f5203cb4d618beb925f59de207.png","/statement-assets/598b8c8e1923fce28ce1ec72fe7c4d6b01f6cc9b6ed8a184e910ea6038837781.png","/statement-assets/8b4e02a73f8741eed57c34a72ed4feea30173c5302aacb91d482fd8ab48f1a04.png","/statement-assets/a992fd893bf24dca11bc38856d0b837cf51a4b8102489451ff36eaf716db94bb.png","/statement-assets/fc552c3e4a485fb65e6527f80037015d0c2d77eb60d1d76c03b509fdd9ed84ca.png","/statement-assets/db00fa50676c6a9ba3b128784d7eb39d5cc378c388c335f5614ce0de61ae26d2.png"],"contentKind":"statement","contestId":"659","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. New Reform"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Berland has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities connected by "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" bidirectional roads. No road connects a city to itself, and each pair of cities is connected by no more than one road. It is "},{"children":[{"kind":"text","text":"not guaranteed"}],"kind":"container"},{"kind":"text","text":" that you can get from any city to any other one, using only the existing roads."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The President of Berland decided to make changes to the road system and instructed the Ministry of Transport to make this reform. Now, each road should be unidirectional (only lead from one city to another)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In order not to cause great resentment among residents, the reform needs to be conducted so that there can be as few separate cities as possible. A city is considered "},{"children":[{"kind":"text","text":"separate"}],"kind":"container"},{"kind":"text","text":", if no road leads into it, while it is allowed to have roads leading from this city."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the Ministry of Transport to find the minimum possible number of separate cities after the reform."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two positive integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the number of the cities and the number of roads in Berland ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 100 000"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the descriptions of the roads: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road is determined by two distinct integers "},{"kind":"math_inline","text":"xi, yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"xi ≠ yi"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" are the numbers of the cities connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there is no more than one road between each pair of cities, but it is not guaranteed that from any city you can get to any other one, using only roads."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum number of separated cities after the reform."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n2 1\n1 3\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n2 1\n1 3\n2 3\n2 5\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 5\n1 2\n2 3\n4 5\n4 6\n5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the following road orientation is allowed: "},{"attrs":{"alt":"","src":"/statement-assets/efca80e95ad5e2fd998c4c5532f1971f8f7e2d807a460f43445e77b307580b42.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/2fe83c103dd9f23e19339fc9957b59c60337c3d95bf734b01173dc1bbb8d3be2.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/785e4a2c1c8559b213f0fced4bf66ed80c472d0e13c1cd2fb0266c3b3119c38c.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second sample: "},{"attrs":{"alt":"","src":"/statement-assets/efca80e95ad5e2fd998c4c5532f1971f8f7e2d807a460f43445e77b307580b42.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/a1a14bbe080f750738cd5a155f33c4186ceac8f5203cb4d618beb925f59de207.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/598b8c8e1923fce28ce1ec72fe7c4d6b01f6cc9b6ed8a184e910ea6038837781.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/8b4e02a73f8741eed57c34a72ed4feea30173c5302aacb91d482fd8ab48f1a04.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/785e4a2c1c8559b213f0fced4bf66ed80c472d0e13c1cd2fb0266c3b3119c38c.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third sample: "},{"attrs":{"alt":"","src":"/statement-assets/efca80e95ad5e2fd998c4c5532f1971f8f7e2d807a460f43445e77b307580b42.png"},"kind":"image"},{"kind":"te