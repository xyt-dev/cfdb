{"assets":[],"contentKind":"statement","contestId":"146","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Lucky Mask"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Petya loves lucky numbers very much. Everybody knows that lucky numbers are positive integers whose decimal record contains only the lucky digits "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":". For example, numbers "},{"children":[{"kind":"text","text":"47"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"744"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" are lucky and "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"17"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"467"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya calls a "},{"children":[{"kind":"text","text":"mask"}],"kind":"container"},{"kind":"text","text":" of a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" the number that is obtained after successive writing of all lucky digits of number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from the left to the right. For example, the mask of number "},{"kind":"math_inline","text":"72174994"},{"kind":"text","text":" is number "},{"kind":"math_inline","text":"7744"},{"kind":"text","text":", the mask of "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"7"},{"kind":"text","text":", the mask of "},{"kind":"math_inline","text":"9999047"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"47"},{"kind":"text","text":". Obviously, mask of any number is always a lucky number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya has two numbers — an arbitrary integer "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and a lucky number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Help him find the minimum number "},{"kind":"math_inline","text":"c"},{"kind":"math_inline","text":"(c > a)"},{"kind":"text","text":" such that the mask of number "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" equals "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"math_inline","text":"(1 ≤ a, b ≤ 105)"},{"kind":"text","text":". It is guaranteed that number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is lucky."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line print a single number — the number "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" that is sought by Petya."}],"kind":"p