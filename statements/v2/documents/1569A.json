{"assets":[],"contentKind":"statement","contestId":"1569","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Balanced Substring"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$, consisting of $$$n$$$ letters, each letter is either '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"'. The letters in the string are numbered from $$$1$$$ to $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$s[l; r]$$$ is a continuous substring of letters from index $$$l$$$ to $$$r$$$ of the string inclusive. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string is called balanced if the number of letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' in it is equal to the number of letters '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"'. For example, strings \""},{"children":[{"kind":"text","text":"baba"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"aabbab"}],"kind":"container"},{"kind":"text","text":"\" are balanced and strings \""},{"children":[{"kind":"text","text":"aaab"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find any non-empty balanced substring $$$s[l; r]$$$ of string $$$s$$$. Print its $$$l$$$ and $$$r$$$ ($$$1 \\le l \\le r \\le n$$$). If there is no such substring, then print $$$-1$$$ $$$-1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of testcases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then the descriptions of $$$t$$$ testcases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of the testcase contains a single integer $$$n$$$ ($$$1 \\le n \\le 50$$$) — the length of the string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the testcase contains a string $$$s$$$, consisting of $$$n$$$ letters, each letter is either '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase print two integers. If there exists a non-empty balanced substring $$$s[l; r]$$$, then print $$$l$$$ $$$r$$$ ($$$1 \\le l \\le r \\le n$$$). Otherwise, print $$$-1$$$ $$$-1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1\na\n6\nabbaba\n6\nabbaba\n9\nbabbabbaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1 -1\n1 6\n3 6\n2 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first testcase there are no non-empty balanced subtrings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second and third testcases there are multiple balanced substrings, including the entire string \""},{"children":[{"kind":"text","text":"abbaba"}],"kind":"container"},{"kind":"text","text":"\" and substring \""},{"children":[{"kind":"text","text":"baba"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1569A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1569/problem/A"}