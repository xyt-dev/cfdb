{"assets":[],"contentKind":"statement","contestId":"2200","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Deletion Sort"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"AksLolCoding is playing a game on an array $$$a$$$ of $$$n$$$ positive integers. During each turn:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If $$$a$$$ is "},{"children":[{"kind":"text","text":"non-decreasing"}],"kind":"container"},{"kind":"text","text":"$$$^{\\text{∗}}$$$, the game ends. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Otherwise, AksLolCoding can choose "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" single element and remove it from the array. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Determine the "},{"children":[{"kind":"text","text":"minimum"}],"kind":"container"},{"kind":"text","text":" possible number of elements that can be remaining in the array after the game ends."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$$$$a$$$ is non-decreasing if $$$a_i\\leq a_{i+1}$$$ for all $$$1\\leq i\\leq m-1$$$, where $$$m$$$ is the length of $$$a$$$."}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\leq t \\leq 1000$$$), the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains an integer $$$n$$$ ($$$1 \\leq n \\leq 10$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers, the elements of $$$a$$$ ($$$1 \\leq a_i \\leq 100$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output an integer: the minimum possible number of elements left once the array is sorted."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n4\n1 4 2 3\n1\n100\n2\n6 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n1\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the minimum of $$$1$$$ element can be achieved by removing $$$1$$$, $$$2$$$, and $$$3$$$ in that order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second and third test cases, no elements can be removed."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"2200B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2200/problem/B"}