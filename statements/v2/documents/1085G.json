{"assets":["/statement-assets/04622cf147596b58be579074decd0e3ebd5db0d4f01384f213e2a7142d2b3482.png","/statement-assets/d286302f797fb528bbddcc787a69eb7c4ae2923320f4ca57f1512ac8ff8d0759.png"],"contentKind":"statement","contestId":"1085","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Beautiful Matrix"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya collects "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" matrix."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A matrix of size $$$n \\times n$$$ is "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" All elements of the matrix are integers between $$$1$$$ and $$$n$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For every row of the matrix, all elements of this row are different; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For every pair of vertically adjacent elements, these elements are different. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Today Petya bought a "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" matrix $$$a$$$ of size $$$n \\times n$$$, and now he wants to determine its rarity."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The rarity of the matrix is its index in the list of "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" matrices of size $$$n \\times n$$$, sorted in lexicographical order. Matrix comparison is done row by row. (The index of lexicographically smallest matrix is "},{"children":[{"kind":"text","text":"zero"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since the number of "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" matrices may be huge, Petya wants you to calculate the rarity of the matrix $$$a$$$ modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$1 \\le n \\le 2000$$$) — the number of rows and columns in $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n$$$ lines contains $$$n$$$ integers $$$a_{i,j}$$$ ($$$1 \\le a_{i,j} \\le n$$$) — the elements of $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that $$$a$$$ is a "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" matrix."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the rarity of matrix $$$a$$$, taken modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n2 1\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 2 3\n2 3 1\n3 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 2 3\n3 1 2\n2 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"There are only $$$2$$$ "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" matrices of size $$$2 \\times 2$$$:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/04622cf147596b58be579074decd0e3ebd5db0d4f01384f213e2a7142d2b3482.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"There are the first $$$5$$$ "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" matrices of size $$$3 \\times 3$$$ in lexicographical order:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d2863