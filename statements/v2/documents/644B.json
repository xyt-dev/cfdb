{"assets":[],"contentKind":"statement","contestId":"644","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Processing Queries"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In this problem you have to simulate the workflow of one-thread server. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" queries to process, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th will be received at moment "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" and needs to be processed for "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" units of time. All "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" are guaranteed to be distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When a query appears server may react in three possible ways: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" If server is free and query queue is empty, then server immediately starts to process this query. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If server is busy and there are less than "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" queries in the queue, then new query is added to the end of the queue. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If server is busy and there are already "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" queries pending in the queue, then new query is just rejected and will never be processed. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"As soon as server finished to process some query, it picks new one from the queue (if it's not empty, of course). If a new query comes at some moment "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", and the server finishes to process another query at exactly the same moment, we consider that first query is picked from the queue and only then new query appears."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each query find the moment when the server will finish to process it or print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if this query will be rejected."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, b ≤ 200 000"},{"kind":"text","text":") — the number of queries and the maximum possible size of the query queue."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines with queries descriptions (in chronological order). Each description consists of two integers "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti, di ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" is the moment of time when the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query appears and "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" is the time server needs to process it. It is guaranteed that "},{"kind":"math_inline","text":"ti - 1 < ti"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i > 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"e1, e2, ..., en"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ei"},{"kind":"text","text":" is the moment the server will finish to process the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query (queries are numbered in the order they appear in the input) or "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":" if the corresponding query will be rejected."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1\n2 9\n4 8\n10 9\n15 2\n19 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11 19 -1 21 22 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n2 8\n4 8\n10 9\n15 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10 18 27 -1 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first sample. "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The server will start to process first query at the moment "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and will finish to process it at the moment "},{"kind":"math_inline","text":"11"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" At the moment "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" second query appears and proceeds to the queue. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" At the moment "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" third query appears. However, the server is still busy with query "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b = 1"},{"kind":"text","text":" and there is already query "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" pending in the queue, so third query is just rejected. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" At the moment "},{"kind":"math_inline","text":"11"},{"kind":"text","text":" server will finish to process first query and will take the second query from the queue. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" At the moment "},{"kind":"math_inline","text":"15"},{"kind":"text","text":" fourth query appears. As the server is currently busy it proceeds to the queue. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" At the moment "},{"kind":"math_inline","text":"19"},{"kind":"text","text":" two events occur simultaneously: server finishes to proceed the second query and the fifth query appears. As was said in the statement above, first server will finish to process the second query, then it will pick the fourth query from the queue and only then will the fifth query appear. As the queue is empty fifth query is proceed there. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Server finishes to process query number "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" at the moment "},{"kind":"math_inline","text":"21"},{"kind":"text","text":". Query number "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" is picked from the queue. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Server finishes to process query number "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" at the moment "},{"kind":"math_inline","text":"22"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"644B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/644/problem/B"}