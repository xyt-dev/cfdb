{"assets":["/statement-assets/1f23499f0e9ed68c6172e670598b944f7869ab108d5de38948146e7c951f5b53.png","/statement-assets/26694cbcddf436657dcf261508a8f8d7924da07fd364f66a0858e64e2cb4751f.gif"],"contentKind":"statement","contestId":"1312","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Two Regular Polygons"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two integers $$$n$$$ and $$$m$$$ ($$$m \\lt n$$$). Consider a "},{"children":[{"kind":"text","text":"convex"}],"kind":"container"},{"kind":"text","text":" regular polygon of $$$n$$$ vertices. Recall that a regular polygon is a polygon that is equiangular (all angles are equal in measure) and equilateral (all sides have the same length)."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1f23499f0e9ed68c6172e670598b944f7869ab108d5de38948146e7c951f5b53.png"},"kind":"image"},{"kind":"text","text":" Examples of convex regular polygons "}],"kind":"container"},{"children":[{"kind":"text","text":"Your task is to say if it is possible to build another "},{"children":[{"kind":"text","text":"convex"}],"kind":"container"},{"kind":"text","text":" regular polygon with $$$m$$$ vertices such that its center coincides with the center of the initial polygon and each of its vertices is some vertex of the initial polygon."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to answer $$$t$$$ independent test cases."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$t$$$ lines describe test cases. Each test case is given as two space-separated integers $$$n$$$ and $$$m$$$ ($$$3 \\le m \\lt n \\le 100$$$) — the number of vertices in the initial polygon and the number of vertices in the polygon you want to build."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the answer — \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes), if it is possible to build another "},{"children":[{"kind":"text","text":"convex"}],"kind":"container"},{"kind":"text","text":" regular polygon with $$$m$$$ vertices such that its center coincides with the center of the initial polygon and each of its vertices is some vertex of the initial polygon and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n6 3\n7 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/26694cbcddf436657dcf261508a8f8d7924da07fd364f66a0858e64e2cb4751f.gif"},"kind":"image"},{"kind":"text","text":" The first test case of the example "}],"kind":"container"},{"children":[{"kind":"text","text":"It can be shown that the answer for the second test case of the example is \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1312A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1312/problem/A"}