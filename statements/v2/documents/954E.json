{"assets":["/statement-assets/1ec5bd237767aaedf896475992cf9f21480f994c1ef1b275c23f0e7568f737ac.png","/statement-assets/3734960753e60191df45ac6655faa4982feb0be81271dfd20acce4fdae9b1f82.png","/statement-assets/5e4377a041081ceb982cf66341139f39f3efe9cd37ceaa919219fc2f7096545d.png"],"contentKind":"statement","contestId":"954","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Water Taps"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider a system of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" water taps all pouring water into the same container. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th water tap can be set to deliver any amount of water from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ml per second (this amount may be a real number). The water delivered by "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th tap has temperature "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If for every "},{"attrs":{"alt":"","src":"/statement-assets/1ec5bd237767aaedf896475992cf9f21480f994c1ef1b275c23f0e7568f737ac.png"},"kind":"image"},{"kind":"text","text":" you set "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th tap to deliver exactly "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ml of water per second, then the resulting temperature of water will be "},{"attrs":{"alt":"","src":"/statement-assets/3734960753e60191df45ac6655faa4982feb0be81271dfd20acce4fdae9b1f82.png"},"kind":"image"},{"kind":"text","text":" (if "},{"attrs":{"alt":"","src":"/statement-assets/5e4377a041081ceb982cf66341139f39f3efe9cd37ceaa919219fc2f7096545d.png"},"kind":"image"},{"kind":"text","text":", then to avoid division by zero we state that the resulting water temperature is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to set all the water taps in such a way that the resulting temperature is exactly "},{"kind":"math_inline","text":"T"},{"kind":"text","text":". What is the maximum amount of water you may get per second if its temperature has to be "},{"kind":"math_inline","text":"T"},{"kind":"text","text":"?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ T ≤ 106"},{"kind":"text","text":") — the number of water taps and the desired temperature of water, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 106"},{"kind":"text","text":") where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the maximum amount of water "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th tap can deliver per second."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"t1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"tn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 106"},{"kind":"text","text":") — the temperature of water each tap delivers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum possible amount of water with temperature exactly "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" you can get per second (if it is impossible to obtain water with such temperature, then the answer is considered to be "},{"kind":"math_inline","text":"0"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your answer is considered correct if its absolute or relative error doesn't exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 100\n3 10\n50 150\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6.000000000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},