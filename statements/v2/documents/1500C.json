{"assets":[],"contentKind":"statement","contestId":"1500","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Matrix Sorting"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two tables $$$A$$$ and $$$B$$$ of size $$$n \\times m$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We define a "},{"children":[{"kind":"text","text":"sorting by column"}],"kind":"container"},{"kind":"text","text":" as the following: we choose a column and reorder the rows of the table by the value in this column, from the rows with the smallest value to the rows with the largest. In case there are two or more rows with equal value in this column, their relative order does not change (such sorting algorithms are called "},{"children":[{"kind":"text","text":"stable"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can find this behavior of sorting by column in many office software for managing spreadsheets. Petya works in one, and he has a table $$$A$$$ opened right now. He wants to perform zero of more sortings by column to transform this table to table $$$B$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine if it is possible to do so, and if yes, find a sequence of columns to sort by. Note that you "},{"children":[{"kind":"text","text":"do not need"}],"kind":"container"},{"kind":"text","text":" to minimize the number of sortings."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\le n, m \\le 1500$$$) — the sizes of the tables."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n$$$ lines contains $$$m$$$ integers $$$a_{i,j}$$$ ($$$1 \\le a_{i, j} \\le n$$$), denoting the elements of the table $$$A$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n$$$ lines contains $$$m$$$ integers $$$b_{i, j}$$$ ($$$1 \\le b_{i, j} \\le n$$$), denoting the elements of the table $$$B$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is not possible to transform $$$A$$$ into $$$B$$$, print $$$-1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, first print an integer $$$k$$$ ($$$0 \\le k \\le 5000$$$) — the number of sortings in your solution."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then print $$$k$$$ integers $$$c_1, \\ldots, c_k$$$ ($$$1 \\le c_i \\le m$$$) — the columns, by which Petya needs to perform a sorting."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can show that if a solution exists, there is one in no more than $$$5000$$$ sortings."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 2\n2 2\n1 2\n1 2\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 3\n2 3 2\n1 3 3\n1 1 2\n1 1 2\n1 3 3\n2 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n1 2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 2\n1 1\n2 1\n2 1\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 1\n2\n2\n2\n1\n1\n2\n2\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n1 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the second example. After the sorting by the first column the table becomes"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$\\begin{matrix} 1&3&3\\\\ 1&1&2\\\\ 2&3&2. \\end{matrix}$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the sorting by the second column the table becomes"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$\\begin{matrix} 1&1&2\\\\ 1&3&3\\\\ 2&3&2, \\end{matrix}$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"and this is what we need."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test any sorting does not change anything, because the columns are already sorted."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1500C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1500/problem/C"}