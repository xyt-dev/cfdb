{"assets":["/statement-assets/784da404b0a7be7bd4b1a4c2803ecc50a18907f1f431b58e2bcdd611d7759381.png","/statement-assets/bae470416b2d4c1bdcca806a615bde794e912c8e8af4a13b097d9cad45e71c81.png","/statement-assets/f97b9c076173a8267323078ecc36d9e073c2a0a3a14374741b1e36ee08293360.png","/statement-assets/c6ceca9c044c4816c69bab368d48ac3751a11d07fa69ea0696d026dad7c43630.png","/statement-assets/f1be52745ba73902d4ae90609e68dee04e8c2ce150359c723ee5a1b7a8d0e6af.png"],"contentKind":"statement","contestId":"766","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Mahmoud and a xor trip"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mahmoud and Ehab live in a country with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and connected by "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" undirected roads. It's guaranteed that you can reach any city from any other using these roads. Each city has a number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" attached to it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We define the distance from city "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" as the "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" of numbers attached to the cities on the path from "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"y"},{"children":[{"kind":"text","text":"(including both "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":". In other words if values attached to the cities on the path from "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" form an array "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" then the distance between them is "},{"attrs":{"alt":"","src":"/statement-assets/784da404b0a7be7bd4b1a4c2803ecc50a18907f1f431b58e2bcdd611d7759381.png"},"kind":"image"},{"kind":"text","text":", where "},{"attrs":{"alt":"","src":"/statement-assets/bae470416b2d4c1bdcca806a615bde794e912c8e8af4a13b097d9cad45e71c81.png"},"kind":"image"},{"kind":"text","text":" is bitwise "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mahmoud and Ehab want to choose two cities and make a journey from one to another. The index of the start city is always less than or equal to the index of the finish city (they may start and finish in the same city and in this case the distance equals the number attached to that city). They can't determine the two cities so they try every city as a start and every city with greater index as a finish. They want to know the total distance between all pairs of cities."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of cities in Mahmoud and Ehab's country."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then the second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 106"},{"kind":"text","text":") which represent the numbers attached to the cities. Integer "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is attached to the city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n  -  1"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤  u,  v  ≤  n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"u  ≠  v"},{"kind":"text","text":"), denoting that there is an undirected road between cities "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". It's guaranteed that you can reach any city from any other using these roads."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one number denoting the total distance between all pairs of cities."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 4 5\n1 2\n2 3\n3 4\n3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"52\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n10 9 8 7 6\n1 2\n2 3\n3 4\n3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"131\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A bitwise "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" takes two bit integers of equal length and performs the logical "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" operation on each pair of corresponding bits. The result in each position is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" if only the first bit is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" or only the second bit is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", but will be "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" if both are "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" or both are "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". You can read more about bitwise "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" operation here: "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample the available paths are:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" city "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to itself with a distance of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" city "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to itself with a distance of "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" city "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" to itself with a distance of "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" city "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" with a distance of "},{"attrs":{"alt":"","src":"/statement-assets/f97b9c076173a8267323078ecc36d9e073c2a0a3a14374741b1e36ee08293360.png"},"kind":"image"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" city "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" with a distance of "},{"attrs":{"alt":"","src":"/statement-assets/c6ceca9c044c4816c69bab368d48ac3751a11d07fa69ea0696d026dad7c43630.png"},"kind":"image"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" city "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" with a distance of "},{"attrs":{"alt":"","src":"/statement-assets/f1be52745ba73902d4ae90609e68dee04e8c2ce150359c723ee5a1b7a8d0e6af.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" The total distance between all pairs of cities equals "},{"kind":"math_inline","text":"1 + 2 + 3 + 3 + 0 + 1 = 10"},{"kind":"text","text":"."}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"766E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/766/problem/E"}