{"assets":[],"contentKind":"statement","contestId":"1520","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Not Adjacent Matrix"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"We will consider the numbers $$$a$$$ and $$$b$$$ as adjacent if they differ by exactly one, that is, $$$|a-b|=1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We will consider cells of a square matrix $$$n \\times n$$$ as adjacent if they have a common side, that is, for cell $$$(r, c)$$$ cells $$$(r, c-1)$$$, $$$(r, c+1)$$$, $$$(r-1, c)$$$ and $$$(r+1, c)$$$ are adjacent to it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a given number $$$n$$$, construct a square matrix $$$n \\times n$$$ such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Each integer from $$$1$$$ to $$$n^2$$$ occurs in this matrix exactly once; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If $$$(r_1, c_1)$$$ and $$$(r_2, c_2)$$$ are adjacent cells, then the numbers written in them "},{"children":[{"kind":"text","text":"must not be adjacent"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 100$$$). Then $$$t$$$ test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case is characterized by one integer $$$n$$$ ($$$1 \\le n \\le 100$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":", if the required matrix does not exist; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the required matrix, otherwise (any such matrix if many of them exist). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The matrix should be outputted as $$$n$$$ lines, where each line contains $$$n$$$ integers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1\n2\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n-1\n2 9 7\n4 6 3\n1 8 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1520C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1520/problem/C"}