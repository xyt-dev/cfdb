{"assets":[],"contentKind":"statement","contestId":"2043","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Problem with Queries"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"8 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array $$$a$$$, consisting of $$$n$$$ integers. Your task is to process $$$q$$$ queries of two types: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1~p~x$$$ — set the value of the element at index $$$p$$$ equal to $$$x$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$2~l~r$$$ — count the number of pairs of indices $$$(i, j)$$$ such that $$$l \\le i \\lt j \\le r$$$ and $$$a_i \\ne a_j$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that the queries in this task are "},{"children":[{"kind":"text","text":"encoded"}],"kind":"container"},{"kind":"text","text":"; each subsequent query can only be decoded after calculating the answer to the preceding query of the second type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$1 \\le n \\le 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le n$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a single integer $$$q$$$ ($$$1 \\le q \\le 3 \\cdot 10^5$$$) — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$q$$$ lines describe the queries in one of the following formats: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1~p'~x'$$$ ($$$0 \\le p', x' \\le n-1$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$2~l'~r'$$$ ($$$0 \\le l', r' \\le n-1$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The queries are "},{"children":[{"kind":"text","text":"encoded"}],"kind":"container"},{"kind":"text","text":" as follows: let $$$\\mathit{last}$$$ be the answer to the latest processed query of the second type (initially, $$$\\mathit{last} = 0$$$)."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if the type of the query is $$$1$$$, then $$$p = ((p' + \\mathit{last}) \\bmod n) + 1$$$, $$$x = ((x' + \\mathit{last}) \\bmod n) + 1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if the type of the query is $$$2$$$, $$$l = ((l' + \\mathit{last}) \\bmod n) + 1$$$, $$$r = ((r' + \\mathit{last}) \\bmod n) + 1$$$. If $$$l \\gt r$$$, swap their values. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"Don't forget to update the value of $$$\\mathit{last}$$$ after answering each query of the second type."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraint on the input: there is at least one query of the second type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the second type, print the answer — the number of pairs of indices $$$(i, j)$$$ such that $$$l \\le i \\lt j \\le r$$$ and $$$a_i \\ne a_j$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 2 3\n5\n2 0 2\n1 0 2\n2 0 2\n1 2 0\n2 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3 2 0 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n1 3 4 4 7 1 3\n3\n2 1 6\n2 1 0\n2 5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n13 18 0 "}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the actual queries (after decoding) are:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"2 1 3"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"1 1 3"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"2 1 3"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"1 2 3"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"2 1 3"}],"kind":"container"}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"2043G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2043/problem/G"}