{"assets":[],"contentKind":"statement","contestId":"1265","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Beautiful String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A string is called beautiful if no two consecutive characters are equal. For example, \""},{"children":[{"kind":"text","text":"ababcb"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"abab"}],"kind":"container"},{"kind":"text","text":"\" are beautiful strings, while \""},{"children":[{"kind":"text","text":"aaaaaa"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abaa"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"bb"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ahcl wants to construct a beautiful string. He has a string $$$s$$$, consisting of only characters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"'. Ahcl needs to replace each character '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"' with one of the three characters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"', such that the resulting string is beautiful. Please help him!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, after replacing all characters '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"', the condition $$$s_i \\neq s_{i+1}$$$ should be satisfied for all $$$1 \\leq i \\leq |s| - 1$$$, where $$$|s|$$$ is the length of the string $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains positive integer $$$t$$$ ($$$1 \\leq t \\leq 1000$$$) — the number of test cases. Next $$$t$$$ lines contain the descriptions of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each line contains a non-empty string $$$s$$$ consisting of only characters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that in each test case a string $$$s$$$ has at least one character '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"'. The sum of lengths of strings $$$s$$$ in all test cases does not exceed $$$10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case given in the input print the answer in the following format:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If it is impossible to create a beautiful string, print \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\" (without quotes); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Otherwise, print the resulting beautiful string after replacing all '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"' characters. If there are multiple answers, you can print any of them. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\na???cb\na??bbc\na?b?c\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nababcb\n-1\nacbac\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, all possible correct answers are \""},{"children":[{"kind":"text","text":"ababcb"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abcacb"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abcbcb"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"acabcb"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"acbacb"}],"kind":"container"},{"kind":"text","text":"\". The two answers \""},{"children":[{"kind":"text","text":"abcbab"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"abaabc"}],"kind":"container"},{"kind":"text","text":"\" are incorrect, because you can replace only '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"' characters and the resulting string must be beautiful."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, it is impossible to create a beautiful string, because the $$$4$$$-th and $$$5$$$-th characters will be always equal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, the only answer is \""},{"children":[{"kind":"text","text":"acbac"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1265A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1265/problem/A"}