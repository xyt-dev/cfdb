{"assets":[],"contentKind":"statement","contestId":"666","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Codeword"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"6 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The famous sculptor Cicasso is a Reberlandian spy!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"These is breaking news in Berlandian papers today. And now the sculptor is hiding. This time you give the shelter to the maestro. You have a protected bunker and you provide it to your friend. You set the security system in such way that only you can open the bunker. To open it one should solve the problem which is hard for others but is simple for you."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Every day the bunker generates a codeword "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Every time someone wants to enter the bunker, integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" appears on the screen. As the answer one should enter another integer — the residue modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":" of the number of strings of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" that consist only of lowercase English letters and contain the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" as the "},{"children":[{"kind":"text","text":"subsequence"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The subsequence of string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is a string "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" that can be derived from the string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" by removing some symbols from it (maybe none or all of them). In particular any string is the subsequence of itself. For example, the string \""},{"children":[{"kind":"text","text":"cfo"}],"kind":"container"},{"kind":"text","text":"\" is the subsequence of the string \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You haven't implemented the algorithm that calculates the correct answers yet and you should do that ASAP."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":") — the number of the events in the test case."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains nonempty string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" — the string generated by the bunker for the current day."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the description of the events. The description starts from integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — the type of the event."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"t = 1"},{"kind":"text","text":" consider a new day has come and now a new string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is used. In that case the same line contains a new value of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"t = 2"},{"kind":"text","text":" integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is given "},{"kind":"math_inline","text":"(1 ≤ n ≤ 105"},{"kind":"text","text":"). This event means that it's needed to find the answer for the current string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and the value "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of lengths of all generated strings doesn't exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":". All of the given strings consist only of lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the type "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" print the answer modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":" on the separate line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\na\n2 2\n1 bc\n2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"51\n162626\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first event words of the form \""},{"children":[{"kind":"text","text":"a?"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"?a"}],"kind":"container"},{"kind":"text","text":"\" are counted, where "},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":" is an arbitrary symbol. There are "},{"kind":"math_inline","text":"26"},{"kind":"text","text":" words of each of these types, but the word \""},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"\" satisfies both patterns, so the answer is "},{"kind":"math_inline","text":"51"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"666C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/666/problem/C"}