{"assets":[],"contentKind":"statement","contestId":"71","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Way Too Long Words"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sometimes some words like \""},{"children":[{"kind":"text","text":"localization"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"internationalization"}],"kind":"container"},{"kind":"text","text":"\" are so long that writing them many times in one text is quite tiresome."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's consider a word "},{"children":[{"kind":"text","text":"too long"}],"kind":"container"},{"kind":"text","text":", if its length is "},{"children":[{"kind":"text","text":"strictly more"}],"kind":"container"},{"kind":"text","text":" than "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" characters. All too long words should be replaced with a special abbreviation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This abbreviation is made like this: we write down the first and the last letter of a word and between them we write the number of letters between the first and the last letters. That number is in decimal system and doesn't contain any leading zeroes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus, \""},{"children":[{"kind":"text","text":"localization"}],"kind":"container"},{"kind":"text","text":"\" will be spelt as \""},{"children":[{"kind":"text","text":"l10n"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"internationalization"}],"kind":"container"},{"kind":"text","text":"» will be spelt as \""},{"children":[{"kind":"text","text":"i18n"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are suggested to automatize the process of changing the words with abbreviations. At that all too long words should be replaced by the abbreviation and the words that are not too long should not undergo any changes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":"). Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains one word. All the words consist of lowercase Latin letters and possess the lengths of from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line should contain the result of replacing of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th word from the input data."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nword\nlocalization\ninternationalization\npneumonoultramicroscopicsilicovolcanoconiosis\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"word\nl10n\ni18n\np43s\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"71A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/71/problem/A"}