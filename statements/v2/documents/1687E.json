{"assets":[],"contentKind":"statement","contestId":"1687","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Become Big For Me"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"children":[{"kind":"text","text":"Come, let's build a world where even the weak are not forgotten!"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"—Kijin Seija, "},{"children":[{"kind":"text","text":"Double Dealing Characters"}],"kind":"container"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Shinmyoumaru has a mallet that can turn objects bigger or smaller. She is testing it out on a sequence $$$a$$$ and a number $$$v$$$ whose initial value is $$$1$$$. She wants to make $$$v = \\gcd\\limits_{i\\ne j}\\{a_i\\cdot a_j\\}$$$ by "},{"children":[{"kind":"text","text":"no more than"}],"kind":"container"},{"kind":"text","text":" $$$10^5$$$ operations ($$$\\gcd\\limits_{i\\ne j}\\{a_i\\cdot a_j\\}$$$ denotes the $$$\\gcd$$$ of all products of two distinct elements of the sequence $$$a$$$). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In each operation, she picks a subsequence $$$b$$$ of $$$a$$$, and does one of the followings: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"Enlarge"}],"kind":"container"},{"kind":"text","text":": $$$v = v \\cdot \\mathrm{lcm}(b)$$$ "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Reduce"}],"kind":"container"},{"kind":"text","text":": $$$v = \\frac{v}{\\mathrm{lcm}(b)}$$$ "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that she does "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" need to guarantee that $$$v$$$ is an integer, that is, $$$v$$$ does "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" need to be a multiple of $$$\\mathrm{lcm}(b)$$$ when performing Reduce."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Moreover, she wants to guarantee that the total length of $$$b$$$ chosen over the operations does not exceed $$$10^6$$$. Fine a possible operation sequence for her. "},{"children":[{"kind":"text","text":"You don't need to minimize anything"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$2\\leq n\\leq 10^5$$$) — the size of sequence $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1,a_2,\\cdots,a_n$$$ ($$$1\\leq a_i\\leq 10^6$$$) — the sequence $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It can be shown that the answer exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a non-negative integer $$$k$$$ ($$$0\\leq k\\leq 10^5$$$) — the number of operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following $$$k$$$ lines contains several integers. For each line, the first two integers $$$f$$$ ($$$f\\in\\{0,1\\}$$$) and $$$p$$$ ($$$1\\le p\\le n$$$) stand for the option you choose ($$$0$$$ for Enlarge and $$$1$$$ for Reduce) and the length of $$$b$$$. The other $$$p$$$ integers of the line $$$i_1,i_2,\\ldots,i_p$$$ ($$$1\\le i_1 \\lt i_2 \\lt \\ldots \\lt i_p\\le n$$$) represents the indexes of the subsequence. Formally, $$$b_j=a_{i_j}$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n6 10 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n0 3 1 2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n2 4 8 16\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n0 1 4\n1 1 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Test case 1:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\gcd\\limits_{i\\ne j}\\{a_i\\cdot a_j\\}=\\gcd\\{60,90,150\\}=30$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Perform $$$v = v\\cdot \\operatorname{lcm}\\{a_1,a_2,a_3\\}=30$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Test case 2:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\gcd\\limits_{i\\ne j}\\{a_i\\cdot a_j\\}=8$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Perform $$$v = v\\cdot \\operatorname{lcm}\\{a_4\\}=16$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Perform $$$v = \\frac{v}{\\operatorname{lcm}\\{a_1\\}}=8$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1687E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1687/problem/E"}