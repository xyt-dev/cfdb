{"assets":["/statement-assets/470ed8c4cb1887444caf7c539832ad15d6d222471624da2f2ef6214cc378f009.png","/statement-assets/1bfb6971c61d781877ed61c8c252a2e806168cba267d37b68da8d05ebf58d574.png","/statement-assets/31dc8441ea7657a3e29febca566bc56039c6f85061e14b33d8ae52dd72a33920.png"],"contentKind":"statement","contestId":"300","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Painting Square"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasily the bear has got a large square white table of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" columns. The table has got a black border around this table."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/470ed8c4cb1887444caf7c539832ad15d6d222471624da2f2ef6214cc378f009.png"},"kind":"image"},{"children":[{"kind":"text","text":"The example of the initial table at "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" = 5."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Vasily the bear wants to paint his square table in exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" moves. Each move is sequence of actions:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The bear chooses some square inside his table. At that the square must have a black border painted around it. Also, the square shouldn't contain a black cell. The number of cells in the square shouldn't be less than "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The bear chooses some row and some column inside the chosen square. Then he paints each cell of this row and this column inside the chosen square. After that the rectangles, formed by the square's border and the newly painted cells, must be squares of a non-zero area. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1bfb6971c61d781877ed61c8c252a2e806168cba267d37b68da8d05ebf58d574.png"},"kind":"image"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"An example of correct painting at "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" = 7 и "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" = 2."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"The bear already knows numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Help him — find the number of ways to paint the square in exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" moves. Two ways to paint are called distinct if the resulting tables will differ in at least one cell. As the answer can be rather large, print the remainder after dividing it by "},{"kind":"math_inline","text":"7340033"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"q"},{"kind":"math_inline","text":"(1 ≤ q ≤ 105)"},{"kind":"text","text":" — the number of test data."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n ≤ 109, 0 ≤ k ≤ 1000)"},{"kind":"text","text":" — the size of the initial table and the number of moves for the corresponding test."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test from the input print the answer to the problem modulo "},{"kind":"math_inline","text":"7340033"},{"kind":"text","text":". Print the answers to the tests in the order in which the tests are given in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n1 0\n1 1\n3 0\n3 1\n2 0\n2 1\n3 2\n7 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n0\n1\n1\n1\n0\n0\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"All possible painting ways for the test "},{"kind":"math_inline","text":"n = 7"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":" are:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/31dc8441ea7657a3e29febca566bc56039c6f85061e14b33d8ae52dd72a33920.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"300D","schema":2,"sourceKind":"html","so