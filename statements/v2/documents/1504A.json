{"assets":[],"contentKind":"statement","contestId":"1504","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Déjà Vu"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A palindrome is a string that reads the same backward as forward. For example, the strings \""},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"aaa"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"abccba"}],"kind":"container"},{"kind":"text","text":"\" are palindromes, but \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\" are not. You hate palindromes because they give you déjà vu."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is a string $$$s$$$. You "},{"children":[{"kind":"text","text":"must"}],"kind":"container"},{"kind":"text","text":" insert "},{"children":[{"kind":"text","text":"exactly one"}],"kind":"container"},{"kind":"text","text":" character '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' somewhere in $$$s$$$. If it is possible to create a string that is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" a palindrome, you should find one example. Otherwise, you should report that it is impossible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, suppose $$$s=$$$ \""},{"children":[{"kind":"text","text":"cbabc"}],"kind":"container"},{"kind":"text","text":"\". By inserting an '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', you can create \""},{"children":[{"kind":"text","text":"acbabc"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"cababc"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"cbaabc"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"cbabac"}],"kind":"container"},{"kind":"text","text":"\", or \""},{"children":[{"kind":"text","text":"cbabca"}],"kind":"container"},{"kind":"text","text":"\". However \""},{"children":[{"kind":"text","text":"cbaabc"}],"kind":"container"},{"kind":"text","text":"\" is a palindrome, so you must output one of the other options."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1\\le t\\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a string $$$s$$$ consisting of lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The total length of all strings does not exceed $$$3\\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, if there is no solution, output \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" followed by your constructed string of length $$$|s|+1$$$ on the next line. If there are multiple solutions, you may print any."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print each letter of \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" in any case (upper or lower)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\ncbabc\nab\nzza\nba\na\nnutforajaroftuna\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\ncbabac\nYES\naab\nYES\nzaza\nYES\nbaa\nNO\nYES\nnutforajarofatuna\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test case is described in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, we can make either \""},{"children":[{"kind":"text","text":"aab"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\". But \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\" is a palindrome, so \""},{"children":[{"kind":"text","text":"aab"}],"kind":"container"},{"kind":"text","text":"\" is the only correct answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, \""},{"children":[{"kind":"text","text":"zaza"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"zzaa"}],"kind":"container"},{"kind":"text","text":"\" are correct answers, but not \""},{"children":[{"kind":"text","text":"azza"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, \""},{"children":[{"kind":"text","text":"baa"}],"kind":"container"},{"kind":"text","text":"\" is the only correct answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth test case, we can only make \""},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"\", which is a palindrome. So the answer is \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the sixth test case, \""},{"children":[{"kind":"text","text":"anutforajaroftuna"}],"kind":"container"},{"kind":"text","text":"\" is a palindrome, but inserting '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' elsewhere is valid."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1504A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1504/problem/A"}