{"assets":["/statement-assets/814c4793ddd97dd9d1a3a38836b7842f025f47228b7f8b3c08e86808310bfd3d.png"],"contentKind":"statement","contestId":"486","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Valid Sets"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As you know, an undirected connected graph with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes and "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" edges is called a "},{"children":[{"kind":"text","text":"tree"}],"kind":"container"},{"kind":"text","text":". You are given an integer "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" and a tree consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes. Each node "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has a value "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" associated with it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We call a set "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" of tree nodes "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" if following conditions are satisfied:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"S"},{"kind":"text","text":" is non-empty."}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"S"},{"kind":"text","text":" is connected. In other words, if nodes "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" are in "},{"kind":"math_inline","text":"S"},{"kind":"text","text":", then all nodes lying on the simple path between "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" should also be presented in "},{"kind":"math_inline","text":"S"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/814c4793ddd97dd9d1a3a38836b7842f025f47228b7f8b3c08e86808310bfd3d.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is to count the number of valid sets. Since the result can be very large, you must print its remainder modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ d ≤ 2000"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated positive integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":"("},{"kind":"math_inline","text":"1 ≤ ai ≤ 2000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then the next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" line each contain pair of integers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ u, v ≤ n"},{"kind":"text","text":") denoting that there is an edge between "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". It is guaranteed that these edges form a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of valid sets modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 4\n2 1 3 2\n1 2\n1 3\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 3\n1 2 3\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 8\n7 8 7 5 4 6 4 10\n1 6\n1 2\n5 8\n1 3\n3 5\n6 7\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"41\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, there are exactly 8 valid sets: "},{"kind":"math_inline","text":"{1}, {2}, {3}, {4}, {1, 2}, {1, 3}, {3, 4}"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"{1, 3, 4}"},{"kind":"text","text":". Set "},{"kind":"math_inline","text":"{1, 2, 3, 4}"},{"kind":"text","text":" is not valid, because the third condition isn't satisfied. Set "},{"kind":"math_inline","text":"{1, 4}"},{"kind":"text","text":" satisfies the third condition, but conflicts with the second condition."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"486D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/486/problem/D"}