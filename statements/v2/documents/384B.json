ing"},{"children":[{"kind":"text","text":"On the first line of the output print an integer "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", the size of the array ("},{"kind":"math_inline","text":"p"},{"kind":"text","text":" can be at most "},{"attrs":{"alt":"","src":"/statement-assets/39619503f917ff5ff7c884d09d416f2fa9a26cf83c6eed5d8abe2e566783b74c.png"},"kind":"image"},{"kind":"text","text":"). Each of the next "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" lines must contain two distinct integers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"math_inline","text":"(1 ≤ i, j ≤ m, i ≠ j)"},{"kind":"text","text":", representing the chosen indices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple correct answers, you can print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 5 0\n1 3 2 5 4\n1 4 3 2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 4\n2 3\n4 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 1\n1 2\n2 3\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{