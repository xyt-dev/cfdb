{"assets":[],"contentKind":"statement","contestId":"178","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A2. Educational Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Smart Beaver from ABBYY began to develop a new educational game for children. The rules of the game are fairly simple and are described below."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The playing field is a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" non-negative integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The goal of the game is to make numbers "},{"kind":"math_inline","text":"a1, a2, ..., ak"},{"kind":"text","text":" (i.e. some prefix of the sequence) equal to zero for some fixed "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(k < n)"},{"kind":"text","text":", and this should be done in the smallest possible number of moves."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One move is choosing an integer "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") such that "},{"kind":"math_inline","text":"ai > 0"},{"kind":"text","text":" and an integer "},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"(t ≥ 0)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"i + 2t ≤ n"},{"kind":"text","text":". After the values of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" have been selected, the value of "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is decreased by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", and the value of "},{"kind":"math_inline","text":"ai + 2t"},{"kind":"text","text":" is increased by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". For example, let "},{"kind":"math_inline","text":"n = 4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a = (1, 0, 1, 2)"},{"kind":"text","text":", then it is possible to make move "},{"kind":"math_inline","text":"i = 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t = 0"},{"kind":"text","text":" and get "},{"kind":"math_inline","text":"a = (1, 0, 0, 3)"},{"kind":"text","text":" or to make move "},{"kind":"math_inline","text":"i = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t = 1"},{"kind":"text","text":" and get "},{"kind":"math_inline","text":"a = (0, 0, 2, 2)"},{"kind":"text","text":" (the only possible other move is "},{"kind":"math_inline","text":"i = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t = 0"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and the initial sequence "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". The task is to calculate the minimum number of moves needed to make the first "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" elements of the original sequence equal to zero for each possible "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ k < n)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 104"},{"kind":"text","text":"), separated by single spaces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The input limitations for getting 20 points are: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1 ≤ n ≤ 300"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The input limitations for getting 50 points are: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1 ≤ n ≤ 2000"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The input limitations for getting 100 points are: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1 ≤ n ≤ 105"}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print exactly "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines: the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th output line must contain the minimum number of moves needed to make the first "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" elements of the original sequence "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" equal to zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specif