{"assets":["/statement-assets/0f388237ad39ac7ea9ac6ca448819a06617d53d01179b2d7209879bf60362ffc.png","/statement-assets/846360e989e5a4df39770a8309060a74778e4e76958f0e0cf8f3428765862fcf.png","/statement-assets/a2545e3affb58e5d252e3762ad8b71e0517a208f74c584c5f0bb1b207ab6fb05.png"],"contentKind":"statement","contestId":"603","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Ruminations on Ruminants"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Kevin Sun is ruminating on the origin of cows while standing at the origin of the Cartesian plane. He notices "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines "},{"attrs":{"alt":"","src":"/statement-assets/0f388237ad39ac7ea9ac6ca448819a06617d53d01179b2d7209879bf60362ffc.png"},"kind":"image"},{"kind":"text","text":" on the plane, each representable by an equation of the form "},{"kind":"math_inline","text":"ax + by = c"},{"kind":"text","text":". He also observes that no two lines are parallel and that no three lines pass through the same point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each triple "},{"kind":"math_inline","text":"(i, j, k)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"1 ≤ i < j < k ≤ n"},{"kind":"text","text":", Kevin considers the triangle formed by the three lines "},{"attrs":{"alt":"","src":"/statement-assets/846360e989e5a4df39770a8309060a74778e4e76958f0e0cf8f3428765862fcf.png"},"kind":"image"},{"kind":"text","text":" . He calls a triangle "},{"children":[{"kind":"text","text":"original"}],"kind":"container"},{"kind":"text","text":" if the circumcircle of that triangle passes through the origin. Since Kevin believes that the circles of bovine life are tied directly to such triangles, he wants to know the number of original triangles formed by unordered triples of distinct lines. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Recall that the "},{"children":[{"kind":"text","text":"circumcircle"}],"kind":"container"},{"kind":"text","text":" of a triangle is the circle which passes through all the vertices of that triangle."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 2000"},{"kind":"text","text":"), the number of lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines describe lines "},{"attrs":{"alt":"","src":"/statement-assets/0f388237ad39ac7ea9ac6ca448819a06617d53d01179b2d7209879bf60362ffc.png"},"kind":"image"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains three space-separated integers "},{"kind":"math_inline","text":"ai, bi, ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|ai|, |bi|, |ci| ≤ 10 000, ai2 + bi2 > 0"},{"kind":"text","text":"), representing the equation "},{"kind":"math_inline","text":"aix + biy = ci"},{"kind":"text","text":" of line "},{"attrs":{"alt":"","src":"/statement-assets/a2545e3affb58e5d252e3762ad8b71e0517a208f74c584c5f0bb1b207ab6fb05.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer, the number of triples "},{"kind":"math_inline","text":"(i, j, k)"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"i < j < k"},{"kind":"text","text":" such that lines "},{"attrs":{"alt":"","src":"/statement-assets/846360e989e5a4df39770a8309060a74778e4e76958f0e0cf8f3428765862fcf.png"},"kind":"image"},{"kind":"text","text":" form an original triangle."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 0 0\n0 1 0\n1 1 -1\n1 -1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n0 1 1\n1 1 2\n1 -1 -2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Note that in the first sample, some of the lines pass through the origin."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, there is exactly one triple of lines: "},{"kind":"math_inline","text":"y = 1, x + y = 2, x - y =  - 2."},{"kind":"text","text":" The triangle they form has vertices "},{"kind":"math_inline","text":"(0, 2), (1, 1), ( - 1, 1)"},{"kind":"text","text":". The circumcircle of this triangle has equation "},{"kind":"math_inline","text":"x2 + (y - 1)2 = 1"},{"kind":"text","text":". This indeed passes through "},{"kind":"math_inline","text":"(0, 0)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"603D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/603/problem/D"}