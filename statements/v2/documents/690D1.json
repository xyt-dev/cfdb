{"assets":[],"contentKind":"statement","contestId":"690","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D1. The Wall (easy)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"0.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"\"The zombies are lurking outside. Waiting. Moaning. And when they come...\""}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"\"When they come?\""}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"\"I hope the Wall is high enough.\""}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Zombie attacks have hit the Wall, our line of defense in the North. Its protection is failing, and cracks are showing. In places, gaps have appeared, splitting the wall into multiple segments. We call on "},{"children":[{"kind":"text","text":"you"}],"kind":"container"},{"kind":"text","text":" for help. Go forth and explore the wall! Report how many disconnected segments there are."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The wall is a two-dimensional structure made of bricks. Each brick is one unit wide and one unit high. Bricks are stacked on top of each other to form columns that are up to "},{"kind":"math_inline","text":"R"},{"kind":"text","text":" bricks high. Each brick is placed either on the ground or directly on top of another brick. Consecutive non-empty columns form a "},{"children":[{"kind":"text","text":"wall segment"}],"kind":"container"},{"k