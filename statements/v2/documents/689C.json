{"assets":[],"contentKind":"statement","contestId":"689","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Mike and Chocolate Thieves"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bad news came to Mike's village, some thieves stole a bunch of chocolates from the local factory! Horrible! "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Aside from loving sweet things, thieves from this area are known to be very greedy. So after a thief takes his number of chocolates for himself, the next thief will take exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" times more than the previous one. The value of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"k > 1"},{"kind":"text","text":") is a secret integer known only to them. It is also known that each thief's bag can carry at most "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" chocolates (if they intend to take more, the deal is cancelled) and that there were "},{"children":[{"kind":"text","text":"exactly four"}],"kind":"container"},{"kind":"text","text":" thieves involved. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sadly, only the thieves know the value of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", but rumours say that the numbers of ways they could have taken the chocolates (for a fixed "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", but not fixed "},{"kind":"math_inline","text":"k"},{"kind":"text","text":") is "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Two ways are considered different if one of the thieves (they should be numbered in the order they take chocolates) took different number of chocolates in them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mike want to track the thieves down, so he wants to know what their bags are and value of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" will help him in that. Please find "},{"children":[{"kind":"text","text":"the smallest possible"}],"kind":"container"},{"kind":"text","text":" value of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" or tell him that the rumors are false and there is no such "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line of input contains the integer "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ m ≤ 1015)"},{"kind":"text","text":" — the number of ways the thieves might steal the chocolates, as rumours say."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the maximum amount of chocolates that thieves' bags can carry. If there are more than one "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" satisfying the rumors, "},{"children":[{"kind":"text","text":"print the smallest one"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is no such "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" for a false-rumoured "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", print "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"54\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case the smallest "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" that leads to exactly one way of stealing chocolates is "},{"kind":"math_inline","text":"n = 8"},{"kind":"text","text":", whereas the amounts of stealed chocolates are "},{"kind":"math_inline","text":"(1, 2, 4, 8)"},{"kind":"text","text":" (the number of chocolates stolen by each of the thieves)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample case the smallest "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" that leads to exactly "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" ways is "},{"kind":"math_inline","text":"n = 54"},{"kind":"text","text":" with the possibilities: "},{"kind":"math_inline","text":"(1, 2, 4, 8),  (1, 3, 9, 27),  (2, 4, 8, 16),  (2, 6, 18, 54),  (3, 6, 12, 24),  (4, 8, 16, 32),  (5, 10, 20, 40),  (6, 12, 24, 48)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is no "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" leading to exactly "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" ways of stealing chocolates in the third sample case."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"689C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/689/problem/C"}