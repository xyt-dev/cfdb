{"assets":[],"contentKind":"statement","contestId":"394","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Counting Sticks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"0.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"When new students come to the Specialized Educational and Scientific Centre (SESC) they need to start many things from the beginning. Sometimes the teachers say (not always unfairly) that we cannot even count. So our teachers decided to teach us arithmetics from the start. And what is the best way to teach students add and subtract? — That's right, using counting sticks! An here's our new task: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An expression of counting sticks is an expression of type:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"[ "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" sticks][sign "},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"]["},{"kind":"math_inline","text":"B"},{"kind":"text","text":" sticks][sign "},{"children":[{"kind":"text","text":"="}],"kind":"container"},{"kind":"text","text":"]["},{"kind":"math_inline","text":"C"},{"kind":"text","text":" sticks] "},{"kind":"math_inline","text":"(1 ≤ A, B, C)"},{"kind":"text","text":". "}],"kind":"container"},{"children":[{"kind":"text","text":"Sign "},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":" consists of two crossed sticks: one vertical and one horizontal. Sign "},{"children":[{"kind":"text","text":"="}],"kind":"container"},{"kind":"text","text":" consists of two horizontal sticks. The expression is arithmetically correct if "},{"kind":"math_inline","text":"A + B = C"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We've got an expression that looks like "},{"kind":"math_inline","text":"A + B = C"},{"kind":"text","text":" given by counting sticks. Our task is to shift at most one stick (or we can shift nothing) so that the expression became arithmetically correct. Note that we cannot remove the sticks from the expression, also we cannot shift the sticks from the signs "},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"="}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We really aren't fabulous at arithmetics. Can you help us?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains the initial expression. It is guaranteed that the expression looks like "},{"kind":"math_inline","text":"A + B = C"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"1 ≤ A, B, C ≤ 100"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there isn't a way to shift the stick so the expression becomes correct, print on a single line \""},{"children":[{"kind":"text","text":"Impossible"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes). If there is a way, print the resulting expression. Follow the format of the output from the test samples. Don't print extra space characters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple correct answers, print any of them. For clarifications, you are recommended to see the test samples."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"||+|=|||||\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"|||+|=||||\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"|||||+||=||\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Impossible\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"|+|=||||||\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Impossible\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"||||+||=||||||\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"||||+||=||||||\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample we can shift stick from the third group of sticks to the first one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample we cannot shift vertical stick from "},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":" sign to the second group of sticks. So we cannot make a "},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":" sign."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is no answer in the third sample because we cannot remove sticks from the expression."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the forth sample the initial expression is already arithmetically correct and that is why we don't have to shift sticks."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"394A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/394/problem/A"}