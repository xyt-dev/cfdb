{"assets":[],"contentKind":"statement","contestId":"2131","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Wafu!"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"To help improve her math, Kudryavka is given a set $$$S$$$ that consists of $$$n$$$ distinct positive integers. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially, her "},{"children":[{"kind":"text","text":"score"}],"kind":"container"},{"kind":"text","text":" is $$$1$$$. She can perform an arbitrary number of the following operations on the set if it is not empty:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Let the minimum value of $$$S$$$ be $$$m$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Multiply her "},{"children":[{"kind":"text","text":"score"}],"kind":"container"},{"kind":"text","text":" by $$$m$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Remove $$$m$$$ from $$$S$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For every integer $$$i$$$ such that $$$1 \\le i \\lt m$$$, add $$$i$$$ to the set $$$S$$$. It can be shown that no duplicates are added during this step. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"She is addicted to performing operations, but after $$$k$$$ operations, she realizes she forgot her "},{"children":[{"kind":"text","text":"score"}],"kind":"container"},{"kind":"text","text":". Please help her determine her "},{"children":[{"kind":"text","text":"score"}],"kind":"container"},{"kind":"text","text":", modulo $$$10^9+7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$, $$$1 \\le k \\le 10^9$$$). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$s_1, s_2, \\dots, s_n$$$ ($$$1 \\le s_i \\le 10^9$$$, $$$s_i \\neq s_j$$$) — the elements of the initial set $$$S$$$. It is guaranteed that the set $$$S$$$ is not empty before each of the $$$k$$$ operations is performed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output an integer indicating the answer modulo $$$10^9+7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n2 3\n1 3\n3 6\n5 1 4\n2 100\n2 100\n5 15\n1 2 3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n24\n118143737\n576\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let us simulate the process in the first test case:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$ \\{1,3\\} \\xrightarrow{\\text{remove}\\ 1} \\{3\\} \\xrightarrow[\\text{add}\\ 1,2]{\\text{remove}\\ 3} \\{1,2\\} \\xrightarrow{\\text{remove}\\ 1} \\{2\\} $$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The removed values are $$$1$$$, $$$3$$$ and $$$1$$$ respectively, so her "},{"children":[{"kind":"text","text":"score"}],"kind":"container"},{"kind":"text","text":" is $$$1\\times 3\\times 1 = 3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the answer is $$$1 \\times 4 \\times 1 \\times 2 \\times 1 \\times 3 = 24$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"2131G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2131/problem/G"}