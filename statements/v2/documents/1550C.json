{"assets":[],"contentKind":"statement","contestId":"1550","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Manhattan Subarrays"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Suppose you have two points $$$p = (x_p, y_p)$$$ and $$$q = (x_q, y_q)$$$. Let's denote the Manhattan distance between them as $$$d(p, q) = |x_p - x_q| + |y_p - y_q|$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's say that three points $$$p$$$, $$$q$$$, $$$r$$$ form a "},{"children":[{"kind":"text","text":"bad"}],"kind":"container"},{"kind":"text","text":" triple if $$$d(p, r) = d(p, q) + d(q, r)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's say that an array $$$b_1, b_2, \\dots, b_m$$$ is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if it is impossible to choose three "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" indices $$$i$$$, $$$j$$$, $$$k$$$ such that the points $$$(b_i, i)$$$, $$$(b_j, j)$$$ and $$$(b_k, k)$$$ form a bad triple."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array $$$a_1, a_2, \\dots, a_n$$$. Calculate the number of "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" subarrays of $$$a$$$. A subarray of the array $$$a$$$ is the array $$$a_l, a_{l + 1}, \\dots, a_r$$$ for some $$$1 \\le l \\le r \\le n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that, according to the definition, subarrays of length $$$1$$$ and $$$2$$$ are "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 5000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains one integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the length of array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the sum of $$$n$$$ doesn't exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the number of "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" subarrays of array $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n4\n2 4 1 3\n5\n6 9 1 9 6\n2\n13 37\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n12\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, it can be proven that any subarray of $$$a$$$ is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":". For example, subarray $$$[a_2, a_3, a_4]$$$ is good since it contains only three elements and: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$d((a_2, 2), (a_4, 4)) = |4 - 3| + |2 - 4| = 3$$$ $$$ \\lt $$$ $$$d((a_2, 2), (a_3, 3)) + d((a_3, 3), (a_4, 4)) = 3 + 1 + 2 + 1 = 7$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$d((a_2, 2), (a_3, 3))$$$ $$$ \\lt $$$ $$$d((a_2, 2), (a_4, 4)) + d((a_4, 4), (a_3, 3))$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$d((a_3, 3), (a_4, 4))$$$ $$$ \\lt $$$ $$$d((a_3, 3), (a_2, 2)) + d((a_2, 2), (a_4, 4))$$$; "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second test case, for example, subarray $$$[a_1, a_2, a_3, a_4]$$$ is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" good, since it contains a "},{"children":[{"kind":"text","text":"bad"}],"kind":"container"},{"kind":"text","text":" triple $$$(a_1, 1)$$$, $$$(a_2, 2)$$$, $$$(a_4, 4)$$$: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$d((a_1, 1), (a_4, 4)) = |6 - 9| + |1 - 4| = 6$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$d((a_1, 1), (a_2, 2)) = |6 - 9| + |1 - 2| = 4$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$d((a_2, 2), (a_4, 4)) = |9 - 9| + |2 - 4| = 2$$$; "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So, $$$d((a_1, 1), (a_4, 4)) = d((a_1, 1), (a_2, 2)) + d((a_2, 2), (a_4, 4))$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1550C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1550/problem/C"}