{"assets":[],"contentKind":"statement","contestId":"2065","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Skibidus and Amog'u"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Skibidus lands on a foreign planet, where the local Amog tribe speaks the Amog'u language. In "},{"children":[{"kind":"text","text":"Amog'u"}],"kind":"container"},{"kind":"text","text":", there are two forms of nouns, which are "},{"children":[{"kind":"text","text":"singular"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"plural"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given that the root of the noun is transcribed as $$$S$$$, the two forms are transcribed as:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Singular: $$$S$$$ $$$+$$$ \""},{"children":[{"kind":"text","text":"us"}],"kind":"container"},{"kind":"text","text":"\" "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Plural: $$$S$$$ $$$+$$$ \""},{"children":[{"kind":"text","text":"i"}],"kind":"container"},{"kind":"text","text":"\" "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Here, $$$+$$$ denotes "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Concatenation"},"children":[{"kind":"text","text":"string concatenation"}],"kind":"link"},{"kind":"text","text":". For example, "},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":" $$$+$$$ "},{"children":[{"kind":"text","text":"def"}],"kind":"container"},{"kind":"text","text":" $$$=$$$ "},{"children":[{"kind":"text","text":"abcdef"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, when $$$S$$$ is transcribed as \""},{"children":[{"kind":"text","text":"amog"}],"kind":"container"},{"kind":"text","text":"\", then the singular form is transcribed as \""},{"children":[{"kind":"text","text":"amogus"}],"kind":"container"},{"kind":"text","text":"\", and the plural form is transcribed as \""},{"children":[{"kind":"text","text":"amogi"}],"kind":"container"},{"kind":"text","text":"\". Do note that "},{"children":[{"kind":"text","text":"Amog'u"}],"kind":"container"},{"kind":"text","text":" nouns can have an "},{"children":[{"kind":"text","text":"empty"}],"kind":"container"},{"kind":"text","text":" root — in specific, \""},{"children":[{"kind":"text","text":"us"}],"kind":"container"},{"kind":"text","text":"\" is the singular form of \""},{"children":[{"kind":"text","text":"i"}],"kind":"container"},{"kind":"text","text":"\" (which, on an unrelated note, means \"imposter\" and \"imposters\" respectively)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a transcribed "},{"children":[{"kind":"text","text":"Amog'u"}],"kind":"container"},{"kind":"text","text":" noun in singular form, please convert it to the transcription of the corresponding plural noun."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 100$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a string $$$W$$$, which is a transcribed "},{"children":[{"kind":"text","text":"Amog'u"}],"kind":"container"},{"kind":"text","text":" noun in "},{"children":[{"kind":"text","text":"singular"}],"kind":"container"},{"kind":"text","text":" form. It is guaranteed that $$$W$$$ consists of only lowercase English letters, has a length of at most $$$10$$$, and ends with \""},{"children":[{"kind":"text","text":"us"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the transcription of the corresponding plural noun on a separate line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n9\nus\nsus\nfungus\ncactus\nsussus\namogus\nchungus\nntarsus\nskibidus\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\ni\nsi\nfungi\ncacti\nsussi\namogi\nchungi\nntarsi\nskibidi\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2065A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2065/problem/A"}