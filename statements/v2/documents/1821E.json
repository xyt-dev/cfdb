{"assets":[],"contentKind":"statement","contestId":"1821","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Rearrange Brackets"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A regular bracket sequence is a bracket sequence that can be transformed into a correct arithmetic expression by inserting characters \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" between the original characters of the sequence. For example:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" bracket sequences \""},{"children":[{"kind":"text","text":"()()"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(())"}],"kind":"container"},{"kind":"text","text":"\" are regular (the resulting expressions are: \""},{"children":[{"kind":"text","text":"(1)+(1)"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"((1+1)+1)"}],"kind":"container"},{"kind":"text","text":"\"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" bracket sequences \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\" are not. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given a regular bracket sequence. In one move, you can remove a pair of "},{"children":[{"kind":"text","text":"adjacent"}],"kind":"container"},{"kind":"text","text":" brackets such that the left one is an opening bracket and the right one is a closing bracket. Then concatenate the resulting parts without changing the order. The cost of this move is the number of brackets to the right of the right bracket of this pair."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" of the regular bracket sequence is the smallest total cost of the moves required to make the sequence empty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Actually, you are not removing any brackets. Instead, you are given a regular bracket sequence and an integer $$$k$$$. You can perform the following operation "},{"children":[{"kind":"text","text":"at most $$$k$$$ times"}],"kind":"container"},{"kind":"text","text":": "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" extract some bracket from the sequence and insert it back at any position (between any two brackets, at the start or at the end; possibly, at the same place it was before). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"After all operations are performed, the bracket sequence has to be regular. What is the smallest possible "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" of the resulting regular bracket sequence?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of testcases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each testcase contains a single integer $$$k$$$ ($$$0 \\le k \\le 5$$$) — the maximum number of operations you can perform."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a non-empty regular bracket sequence, it consists only of characters '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The total length of the regular bracket sequences over all testcases doesn't exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase, print a single integer — the smallest possible "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" of the regular bracket sequence after you perform at most $$$k$$$ operations on it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n0\n()\n0\n(())\n1\n(())\n5\n()\n1\n(()()(()))\n2\n((())()(()())((())))\n3\n((())()(()())((())))\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n1\n0\n0\n1\n4\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1821E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1821/problem/E"}