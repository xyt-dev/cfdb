{"assets":[],"contentKind":"statement","contestId":"727","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. T-shirts Distribution"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The organizers of a programming contest have decided to present t-shirts to participants. There are six different t-shirts sizes in this problem: "},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"XL"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"XXL"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"XXXL"}],"kind":"container"},{"kind":"text","text":" (sizes are listed in increasing order). The t-shirts are already prepared. For each size from "},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"XXXL"}],"kind":"container"},{"kind":"text","text":" you are given the number of t-shirts of this size."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During the registration, the organizers asked each of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" participants about the t-shirt size he wants. If a participant hesitated between two sizes, he could specify two neighboring sizes — this means that any of these two sizes suits him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Write a program that will determine whether it is possible to present a t-shirt to each participant of the competition, or not. Of course, each participant should get a t-shirt of proper size: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the size he wanted, if he specified one size; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" any of the two neibouring sizes, if he specified two sizes. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If it is possible, the program should find any valid distribution of the t-shirts."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains six non-negative integers — the number of t-shirts of each size. The numbers are given for the sizes "},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"XL"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"XXL"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"XXXL"}],"kind":"container"},{"kind":"text","text":", respectively. The total number of t-shirts doesn't exceed "},{"kind":"math_inline","text":"100 000"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of participants."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the sizes specified by the participants, one line per participant. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains information provided by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th participant: single size or two sizes separated by comma (without any spaces). If there are two sizes, the sizes are written in increasing order. It is guaranteed that two sizes separated by comma are neighboring."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is not possible to present a t-shirt to each participant, print «"},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"» (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print "},{"kind":"math_inline","text":"n + 1"},{"kind":"text","text":" lines. In the first line print «"},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"» (without quotes). In the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines print the t-shirt sizes the orginizers should give to participants, one per line. The order of the participants should be the same as in the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 1 0 1 1 0\n3\nXL\nS,M\nXL,XXL\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nXL\nM\nXXL\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 2 0 1 1\n5\nS\nM\nS,M\nXXL,XXXL\nXL,XXL\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"727D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/727/problem/D"}