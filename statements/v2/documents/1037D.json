{"assets":[],"contentKind":"statement","contestId":"1037","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Valid BFS?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Breadth-first_search"},"children":[{"kind":"text","text":"BFS"}],"kind":"link"},{"kind":"text","text":" algorithm is defined as follows."}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Consider an undirected graph with vertices numbered from $$$1$$$ to $$$n$$$. Initialize $$$q$$$ as a new "},{"attrs":{"href":"http://gg.gg/queue_en"},"children":[{"kind":"text","text":"queue"}],"kind":"link"},{"kind":"text","text":" containing only vertex $$$1$$$, mark the vertex $$$1$$$ as used. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Extract a vertex $$$v$$$ from the head of the queue $$$q$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Print the index of vertex $$$v$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Iterate in arbitrary order through all such vertices $$$u$$$ that $$$u$$$ is a neighbor of $$$v$$$ and is not marked yet as used. Mark the vertex $$$u$$$ as used and insert it into the tail of the queue $$$q$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the queue is not empty, continue from step "},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Otherwise finish. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Since the order of choosing neighbors of each vertex can vary, it turns out that there may be multiple sequences which "},{"children":[{"kind":"text","text":"BFS"}],"kind":"container"},{"kind":"text","text":" can print."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem you need to check whether a given sequence corresponds to some valid "},{"children":[{"kind":"text","text":"BFS"}],"kind":"container"},{"kind":"text","text":" traversal of the given tree "},{"children":[{"kind":"text","text":"starting from vertex $$$1$$$"}],"kind":"container"},{"kind":"text","text":". The "},{"attrs":{"href":"http://gg.gg/tree_en"},"children":[{"kind":"text","text":"tree"}],"kind":"link"},{"kind":"text","text":" is an undirected graph, such that there is exactly one simple path between any two vertices."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) which denotes the number of nodes in the tree. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following $$$n - 1$$$ lines describe the edges of the tree. Each of them contains two integers $$$x$$$ and $$$y$$$ ($$$1 \\le x, y \\le n$$$) — the endpoints of the corresponding edge of the tree. It is guaranteed that the given graph is a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line contains $$$n$$$ distinct integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\le a_i \\le n$$$) — the sequence to check."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" (quotes for clarity) if the sequence corresponds to some valid "},{"children":[{"kind":"text","text":"BFS"}],"kind":"container"},{"kind":"text","text":" traversal of the given tree and \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" (quotes for clarity) otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print each letter in any case (upper or lower)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2\n1 3\n2 4\n1 2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2\n1 3\n2 4\n1 2 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Both sample tests have the same tree in them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this tree, there are two valid "},{"children":[{"kind":"text","text":"BFS"}],"kind":"container"},{"kind":"text","text":" orderings: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1, 2, 3, 4$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$1, 3, 2, 4$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The ordering $$$1, 2, 4, 3$$$ doesn't correspond to any valid "},{"children":[{"kind":"text","text":"BFS"}],"kind":"container"},{"kind":"text","text":" order."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1037D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1037/problem/D"}