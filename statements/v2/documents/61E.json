{"assets":[],"contentKind":"statement","contestId":"61","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Enemy is weak"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Romans have attacked again. This time they are much more than the Persians but Shapur is ready to defeat them. He says: \"A lion is never afraid of a hundred sheep\". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nevertheless Shapur has to find weaknesses in the Roman army to defeat them. So he gives the army a weakness number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In Shapur's opinion the weakness of an army is equal to the number of triplets "},{"kind":"math_inline","text":"i, j, k"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"i < j < k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ai > aj > ak"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"ax"},{"kind":"text","text":" is the power of man standing at position "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". The Roman army has one special trait — powers of all the people in it are distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Shapur find out how weak the Romans are."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 106"},{"kind":"text","text":") — the number of men in Roman army. Next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different positive integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n, 1 ≤ ai ≤ 109"},{"kind":"text","text":") — powers of men in the Roman army. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single integer number, the weakness of the Roman army. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specificator to read or write 64-bit integers in C++. It is preffered to use "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" (also you may use "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","tex