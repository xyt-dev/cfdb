{"assets":["/statement-assets/d8e464fae269f5240c8442cf3a6b922d6783a8c151586e4a9e8a547fbcbcb60b.png"],"contentKind":"statement","contestId":"512","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Fox And Polygon"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Fox Ciel just designed a puzzle game called \"Polygon\"! It is played using triangulations of a regular "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-edge polygon. The goal is to transform one "},{"children":[{"kind":"text","text":"triangulation"}],"kind":"container"},{"kind":"text","text":" to another by some tricky rules."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d8e464fae269f5240c8442cf3a6b922d6783a8c151586e4a9e8a547fbcbcb60b.png"},"kind":"image"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"Triangulation"}],"kind":"container"},{"kind":"text","text":" of an "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-edge poylgon is a set of "},{"kind":"math_inline","text":"n - 3"},{"kind":"text","text":" diagonals satisfying the condition that no two diagonals share a common internal point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the initial state of the game may look like (a) in above figure. And your goal may look like (c). In each step you can choose a diagonal inside the polygon (but not the one of edges of the polygon) and "},{"children":[{"kind":"text","text":"flip"}],"kind":"container"},{"kind":"text","text":" this diagonal. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Suppose you are going to "},{"children":[{"kind":"text","text":"flip"}],"kind":"container"},{"kind":"text","text":" a diagonal "},{"kind":"math_inline","text":"a – b"},{"kind":"text","text":". There always exist two triangles sharing "},{"kind":"math_inline","text":"a – b"},{"kind":"text","text":" as a side, let's denote them as "},{"kind":"math_inline","text":"a – b – c"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a – b – d"},{"kind":"text","text":". As a result of this operation, the diagonal "},{"kind":"math_inline","text":"a – b"},{"kind":"text","text":" is replaced by a diagonal "},{"kind":"math_inline","text":"c – d"},{"kind":"text","text":". It can be easily proven that after "},{"children":[{"kind":"text","text":"flip"}],"kind":"container"},{"kind":"text","text":" operation resulting set of diagonals is still a "},{"children":[{"kind":"text","text":"triangulation"}],"kind":"container"},{"kind":"text","text":" of the polygon."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So in order to solve above case, you may first "},{"children":[{"kind":"text","text":"flip"}],"kind":"container"},{"kind":"text","text":" diagonal "},{"kind":"math_inline","text":"6 – 3"},{"kind":"text","text":", it will be replaced by diagonal "},{"kind":"math_inline","text":"2 – 4"},{"kind":"text","text":". Then you "},{"children":[{"kind":"text","text":"flip"}],"kind":"container"},{"kind":"text","text":" diagonal "},{"kind":"math_inline","text":"6 – 4"},{"kind":"text","text":" and get figure (c) as result."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ciel just proved that for any starting and destination triangulations this game has a solution. She wants you to solve it in no more than "},{"kind":"math_inline","text":"20 000"},{"kind":"text","text":" steps for any puzzle satisfying "},{"kind":"math_inline","text":"n ≤ 1000"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contain an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"4 ≤ n ≤ 1000"},{"kind":"text","text":"), number of edges of the regular polygon. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follows two groups of "},{"kind":"math_inline","text":"(n - 3)"},{"kind":"text","text":" lines describing the original triangulation and goal triangulation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Description of each triangulation consists of "},{"kind":"math_inline","text":"(n - 3)"},{"kind":"text","text":" lines. Each line contains 2 integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":"), describing a diagonal "},{"kind":"math_inline","text":"ai – bi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that both original and goal triangulations are correct (i. e. no two diagonals share a common internal point in both of these triangulations)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"First, output an integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ k ≤ 20, 000"},{"kind":"text","text":"): number of steps."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then output "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines, each containing 2 integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":": the endpoints of a diagonal you are going to flip at step "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". You may output "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" in any order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several possible solutions, output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 3\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n2 6\n3 6\n4 6\n6 2\n5 2\n4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n6 3\n6 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n7 1\n2 7\n7 3\n6 3\n4 6\n6 1\n6 2\n6 3\n6 4\n6 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n7 3\n7 2\n7 1"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Sample test 2 is discussed above and shown on the picture."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"512E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/512/problem/E"}