{"assets":[],"contentKind":"statement","contestId":"988","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Divisibility by 25"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an integer $$$n$$$ from $$$1$$$ to $$$10^{18}$$$ without leading zeroes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one move you can swap any two adjacent digits in the given number in such a way that the resulting number will not contain leading zeroes. In other words, "},{"children":[{"kind":"text","text":"after each move"}],"kind":"container"},{"kind":"text","text":" the number you have cannot contain any leading zeroes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of moves you have to make to obtain a number that is divisible by $$$25$$$? Print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if it is impossible to obtain a number that is divisible by $$$25$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$n$$$ ($$$1 \\le n \\le 10^{18}$$$). It is guaranteed that the first (left) digit of the number $$$n$$$ is not a zero."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text