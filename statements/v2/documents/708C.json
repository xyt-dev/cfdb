{"assets":["/statement-assets/7881a7507b1455e1eeccbaf09616abc04ee2f6dbd7de0866a194155a07e2b963.png"],"contentKind":"statement","contestId":"708","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Centroids"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Tree"}],"kind":"container"},{"kind":"text","text":" is a connected acyclic graph. Suppose you are given a tree consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. The vertex of this tree is called "},{"children":[{"kind":"text","text":"centroid"}],"kind":"container"},{"kind":"text","text":" if the size of each connected component that appears if this vertex is removed from the tree doesn't exceed "},{"attrs":{"alt":"","src":"/statement-assets/7881a7507b1455e1eeccbaf09616abc04ee2f6dbd7de0866a194155a07e2b963.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a tree of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and can perform no more than one edge replacement. "},{"children":[{"kind":"text","text":"Edge replacement"}],"kind":"container"},{"kind":"text","text":" is the operation of removing one edge from the tree (without deleting incident vertices) and inserting one new edge (without adding new vertices) in such a way that the graph remains a tree. For each vertex you have to determine if it's possible to make it centroid by performing no more than one edge replacement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 400 000"},{"kind":"text","text":") — the number of vertices in the tree. Each of the next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains a pair of vertex indices "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":") — endpoints of the corresponding edge."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should be equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex can be made centroid by replacing no more than one edge, and should be equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1 1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2\n1 3\n1 4\n1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 0 0 0 0 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample each vertex can be made a centroid. For example, in order to turn vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to centroid one have to replace the edge "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":" with the edge "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"708C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/708/problem/C"}