{"assets":["/statement-assets/992ad54f474c070587a412c7cae96bc1f4cca3a59da27b6a9be25a8bb31cb6d3.png"],"contentKind":"statement","contestId":"551","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. GukiZ and Contest"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Professor GukiZ likes programming contests. He especially likes to rate his students on the contests he prepares. Now, he has decided to prepare a new contest. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In total, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students will attend, and before the start, every one of them has some positive integer rating. Students are indexed from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Let's denote the rating of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th student as "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". After the contest ends, every student will end up with some positive integer position. GukiZ expects that his students will take places according to their ratings. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He thinks that each student will take place equal to "},{"attrs":{"alt":"","src":"/statement-assets/992ad54f474c070587a412c7cae96bc1f4cca3a59da27b6a9be25a8bb31cb6d3.png"},"kind":"image"},{"kind":"text","text":". In particular, if student "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" has rating strictly lower then student "},{"kind":"math_inline","text":"B"},{"kind":"text","text":", "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" will get the strictly better position than "},{"kind":"math_inline","text":"B"},{"kind":"text","text":", and if two students have equal ratings, they will share the same position. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"GukiZ would like you to reconstruct the results by following his expectations. Help him and determine the position after the end of the contest for each of his students if everything goes as expected."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2000"},{"kind":"text","text":"), number of GukiZ's students. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers "},{"kind":"math_inline","text":"a1, a2, ... an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 2000"},{"kind":"text","text":") where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the rating of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th student ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line, print the position after the end of the contest for each of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students in the same order as they appear in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 1 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n3 5 3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 1 4 3 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, students "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" are positioned first (there is no other student with higher rating), and student "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is positioned third since there are two students with higher rating."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, first student is the only one on the contest."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, students "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" share the first position with highest rating, student "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" is next with third position, and students "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" are the last sharing fourth position."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"551A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/551/problem/A"}