{"assets":[],"contentKind":"statement","contestId":"14","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Young Photographer"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Among other things, Bob is keen on photography. Especially he likes to take pictures of sportsmen. That was the reason why he placed himself in position "},{"kind":"math_inline","text":"x0"},{"kind":"text","text":" of a long straight racetrack and got ready to take pictures. But the problem was that not all the runners passed him. The total amount of sportsmen, training at that racetrack, equals "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". And each of them regularly runs distances within a particular segment of the racetrack, which is the same for each sportsman. For example, the first sportsman runs from position "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":" to position "},{"kind":"math_inline","text":"b1"},{"kind":"text","text":", the second — from "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"b2"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum distance that Bob should move to have a chance to take pictures of each sportsman? Bob can take a picture of a sportsman, if he stands within the segment that this sportsman covers on the racetrack."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input file contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x0"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"0 ≤ x0 ≤ 1000"},{"kind":"text","text":"). The following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain pairs of integers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai, bi ≤ 1000"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the required minimum distance in the same units as the positions on the racetrack. If there is no such a position, output -1."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n0 7\n14 2\n4 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"14B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/14/problem/B"}