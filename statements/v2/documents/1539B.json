{"assets":[],"contentKind":"statement","contestId":"1539","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Love Song"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya once wrote a sad love song and shared it to Vasya. The song is a string consisting of lowercase English letters. Vasya made up $$$q$$$ questions about this song. Each question is about a subsegment of the song starting from the $$$l$$$-th letter to the $$$r$$$-th letter. Vasya considers a substring made up from characters on this segment and repeats each letter in the subsegment $$$k$$$ times, where $$$k$$$ is the index of the corresponding letter in the alphabet. For example, if the question is about the substring \""},{"children":[{"kind":"text","text":"abbcb"}],"kind":"container"},{"kind":"text","text":"\", then Vasya repeats letter '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' once, each of the letters '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' twice, letter '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\" three times, so that the resulting string is \""},{"children":[{"kind":"text","text":"abbbbcccbb"}],"kind":"container"},{"kind":"text","text":"\", its length is $$$10$$$. Vasya is interested about the length of the resulting string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Petya find the length of each string obtained by Vasya."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$q$$$ ($$$1\\leq n\\leq 100\\,000$$$, $$$1\\leq q \\leq 100\\,000$$$) — the length of the song and the number of questions. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains one string $$$s$$$ — the song, consisting of $$$n$$$ lowercase letters of English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya's questions are contained in the next $$$q$$$ lines. Each line contains two integers $$$l$$$ and $$$r$$$ ($$$1 \\leq l \\leq r \\leq n$$$) — the bounds of the question."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$q$$$ lines: for each question print the length of the string obtained by Vasya."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7 3\nabacaba\n1 3\n2 5\n1 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n7\n11\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7 4\nabbabaa\n1 3\n5 7\n6 6\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n4\n1\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n13 7\nsonoshikumiwo\n1 5\n2 10\n7 7\n1 13\n4 8\n2 5\n3 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n82\n125\n9\n191\n62\n63\n97\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Vasya is interested in three questions. In the first question Vasya considers the substring \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\", that transforms to \""},{"children":[{"kind":"text","text":"abba"}],"kind":"container"},{"kind":"text","text":"\", so the answer is equal to $$$4$$$. In the second question Vasya considers \""},{"children":[{"kind":"text","text":"baca"}],"kind":"container"},{"kind":"text","text":"\", that transforms to \""},{"children":[{"kind":"text","text":"bbaccca"}],"kind":"container"},{"kind":"text","text":"\", so the answer is $$$7$$$. In the third question Vasya considers the string \""},{"children":[{"kind":"text","text":"abacaba"}],"kind":"container"},{"kind":"text","text":"\",that transforms to \""},{"children":[{"kind":"text","text":"abbacccabba"}],"kind":"container"},{"kind":"text","text":"\" of length $$$11$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1539B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1539/problem/B"}