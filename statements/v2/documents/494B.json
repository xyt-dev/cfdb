{"assets":["/statement-assets/77c0e5bbe79c81d368461958cc9e14f00b81c2de30cc4ad78a713f074f28431d.png","/statement-assets/db7e4dfa0b2723c0b876bc666135750795286b03b5c18be6458e35225752a449.png","/statement-assets/b9dcc680577bec7c0bdb8e5cf5674e1c4773949577eb1dd67eb1209ed2cf5036.png","/statement-assets/6dc4e6b02b6036ff29e89b3eac6f3d834d57970607d25c40a6e0106386dca160.png"],"contentKind":"statement","contestId":"494","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Obsessive String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Hamed has recently found a string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" and suddenly became quite fond of it. He spent several days trying to find all occurrences of "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in other strings he had. Finally he became tired and started thinking about the following problem. Given a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" how many ways are there to extract "},{"kind":"math_inline","text":"k ≥ 1"},{"kind":"text","text":" non-overlapping substrings from it such that each of them contains string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" as a substring? More formally, you need to calculate the number of ways to choose two sequences "},{"kind":"math_inline","text":"a1, a2, ..., ak"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b1, b2, ..., bk"},{"kind":"text","text":" satisfying the following requirements:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"k ≥ 1"}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/77c0e5bbe79c81d368461958cc9e14f00b81c2de30cc4ad78a713f074f28431d.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/db7e4dfa0b2723c0b876bc666135750795286b03b5c18be6458e35225752a449.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b9dcc680577bec7c0bdb8e5cf5674e1c4773949577eb1dd67eb1209ed2cf5036.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6dc4e6b02b6036ff29e89b3eac6f3d834d57970607d25c40a6e0106386dca160.png"},"kind":"image"},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is a substring of string "},{"kind":"math_inline","text":"saisai + 1... sbi"},{"kind":"text","text":" (string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is considered as "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-indexed). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"As the number of ways can be rather large print it modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Input consists of two lines containing strings "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s|, |t| ≤ 105"},{"kind":"text","text":"). Each string consists of lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"childr