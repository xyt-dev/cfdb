{"assets":[],"contentKind":"statement","contestId":"1654","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Prefix Removals"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ consisting of lowercase letters of the English alphabet. You must perform the following algorithm on $$$s$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Let $$$x$$$ be the length of the longest prefix of $$$s$$$ which occurs somewhere else in $$$s$$$ as a contiguous substring (the other occurrence may also intersect the prefix). If $$$x = 0$$$, break. Otherwise, remove the first $$$x$$$ characters of $$$s$$$, and repeat. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A prefix is a string consisting of several first letters of a given string, without any reorders. An empty prefix is also a valid prefix. For example, the string \""},{"children":[{"kind":"text","text":"abcd"}],"kind":"container"},{"kind":"text","text":"\" has 5 prefixes: empty string, \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"abcd"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For instance, if we perform the algorithm on $$$s =$$$ \""},{"children":[{"kind":"text","text":"abcabdc"}],"kind":"container"},{"kind":"text","text":"\", "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Initially, \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\" is the longest prefix that also appears somewhere else as a substring in $$$s$$$, so $$$s =$$$ \""},{"children":[{"kind":"text","text":"cabdc"}],"kind":"container"},{"kind":"text","text":"\" after $$$1$$$ operation. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then, \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\" is the longest prefix that also appears somewhere else as a substring in $$$s$$$, so $$$s =$$$ \""},{"children":[{"kind":"text","text":"abdc"}],"kind":"container"},{"kind":"text","text":"\" after $$$2$$$ operations. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Now $$$x=0$$$ (because there are no non-empty prefixes of \""},{"children":[{"kind":"text","text":"abdc"}],"kind":"container"},{"kind":"text","text":"\" that also appear somewhere else as a substring in $$$s$$$), so the algorithm terminates. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Find the final state of the string after performing the algorithm."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This is followed by $$$t$$$ lines, each containing a description of one test case. Each line contains a string $$$s$$$. The given strings consist only of lowercase letters of the English alphabet and have lengths between $$$1$$$ and $$$2 \\cdot 10^5$$$ inclusive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of the lengths of $$$s$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single line containing the string $$$s$$$ after executing the algorithm. It can be shown that such string is non-empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\nabcabdc\na\nbbbbbbbbbb\ncodeforces\ncffcfccffccfcffcfccfcffccffcfccf\nzyzyzwxxyyxxyyzzyzzxxwzxwywxwzxxyzzw\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nabdc\na\nb\ndeforces\ncf\nxyzzw\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test case is explained in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, no operations can be performed on $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Initially, $$$s =$$$ \""},{"children":[{"kind":"text","text":"bbbbbbbbbb"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After $$$1$$$ operation, $$$s =$$$ \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the fourth test case, "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Initially, $$$s =$$$ \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After $$$1$$$ operation, $$$s =$$$ \""},{"children":[{"kind":"text","text":"odeforces"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After $$$2$$$ operations, $$$s =$$$ \""},{"children":[{"kind":"text","text":"deforces"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1654B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1654/problem/B"}