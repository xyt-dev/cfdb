{"assets":[],"contentKind":"statement","contestId":"216","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Martian Luck"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You know that the Martians use a number system with base "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Digit "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ b < k"},{"kind":"text","text":") is considered "},{"children":[{"kind":"text","text":"lucky"}],"kind":"container"},{"kind":"text","text":", as the first contact between the Martians and the Earthlings occurred in year "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" (by Martian chronology)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"digital root"}],"kind":"container"},{"kind":"math_inline","text":"d(x)"},{"kind":"text","text":" of number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is a number that consists of a single digit, resulting after cascading summing of all digits of number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". Word \"cascading\" means that if the first summing gives us a number that consists of several digits, then we sum up all digits again, and again, until we get a one digit number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, "},{"kind":"math_inline","text":"d(35047) = d((3 + 5 + 0 + 4)7) = d(157) = d((1 + 5)7) = d(67) = 67"},{"kind":"text","text":". In this sample the calculations are performed in the 7-base notation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If a number's digital root equals "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", the Martians also call this number lucky."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", which consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" digits in the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-base notation system. Your task is to find, how many distinct substrings of the given string are lucky numbers. Leading zeroes are permitted in the numbers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that substring "},{"kind":"math_inline","text":"s[i... j]"},{"kind":"text","text":" of the string "},{"kind":"math_inline","text":"s = a1a2... an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ j ≤ n"},{"kind":"text","text":") is the string "},{"kind":"math_inline","text":"aiai + 1... aj"},{"kind":"text","text":". Two substrings "},{"kind":"math_inline","text":"s[i1... j1]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s[i2... j2]"},{"kind":"text","text":" of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" are different if either "},{"kind":"math_inline","text":"i1 ≠ i2"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"j1 ≠ j2"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ k ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ b < k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" as a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, representing digits in the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-base notation: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th integer equals "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai < k"},{"kind":"text","text":") — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th digit of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". The numbers in the lines are space-separated."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of substrings that are lucky numbers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the %lld specifier to read or write 64-bit integers in С++. It is preferred to use the cin, cout streams or the %I64d specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 5 6\n3 2 0 5 6 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 6 4\n3 5 0 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"257 0 3\n0 0 256\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the following substrings have the sought digital root: "},{"kind":"math_inline","text":"s[1... 2]"},{"kind":"text","text":" = \"3 2\", "},{"kind":"math_inline","text":"s[1... 3]"},{"kind":"text","text":" = \"3 2 0\", "},{"kind":"math_inline","text":"s[3... 4]"},{"kind":"text","text":" = \"0 5\", "},{"kind":"math_inline","text":"s[4... 4]"},{"kind":"text","text":" = \"5\" and "},{"kind":"math_inline","text":"s[2... 6]"},{"kind":"text","text":" = \"2 0 5 6 1\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"216E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/216/problem/E"}