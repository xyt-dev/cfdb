{"assets":["/statement-assets/c1e2481ff0be601167acd1efbfe2161efe32d190ae7c83e4bc67027ddeca5c3f.png"],"contentKind":"statement","contestId":"965","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Battleship"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Arkady is playing Battleship. The rules of this game aren't really important."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is a field of $$$n \\times n$$$ cells. There should be exactly one $$$k$$$-decker on the field, i. e. a ship that is $$$k$$$ cells long oriented either horizontally or vertically. However, Arkady doesn't know where it is located. For each cell Arkady knows if it is definitely empty or can contain a part of the ship."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider all possible locations of the ship. Find such a cell that belongs to the maximum possible number of different locations of the ship."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\le k \\le n \\le 100$$$) — the size of the field and the size of the ship."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n$$$ lines contain the field. Each line contains $$$n$$$ characters, each of which is either '"},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"' (denotes a definitely empty cell) or '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' (denotes a cell that can belong to the ship)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output two integers — the row and the column of a cell that belongs to the maximum possible number of different locations of the ship."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, output any of them. In particular, if no ship can be placed on the field, you can output any cell."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n#..#\n#.#.\n....\n.###\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 4\n#....##...\n.#...#....\n..#..#..#.\n...#.#....\n.#..##.#..\n.....#...#\n...#.##...\n.#...#.#..\n.....#..#.\n...#.#...#\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"19 6\n##..............###\n#......#####.....##\n.....#########.....\n....###########....\n...#############...\n..###############..\n.#################.\n.#################.\n.#################.\n.#################.\n#####....##....####\n####............###\n####............###\n#####...####...####\n.#####..####..#####\n...###........###..\n....###########....\n.........##........\n#.................#\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The picture below shows the three possible locations of the ship that contain the cell $$$(3, 2)$$$ in the first sample."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c1e2481ff0be601167acd1efbfe2161efe32d190ae7c83e4bc67027ddeca5c3f.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"965B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/965/problem/B"}