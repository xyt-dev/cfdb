{"assets":[],"contentKind":"statement","contestId":"808","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Selling Souvenirs"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After several latest reforms many tourists are planning to visit Berland, and Berland people understood that it's an opportunity to earn money and changed their jobs to attract tourists. Petya, for example, left the IT corporation he had been working for and started to sell souvenirs at the market."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This morning, as usual, Petya will come to the market. Petya has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different souvenirs to sell; "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th souvenir is characterised by its weight "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" and cost "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":". Petya knows that he might not be able to carry all the souvenirs to the market. So Petya wants to choose a subset of souvenirs such that its total weight is not greater than "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", and total cost is maximum possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Petya to determine maximum possible total cost."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 300000"},{"kind":"text","text":") — the number of Petya's souvenirs and total weight that he can carry to the market."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th line contains two integers "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ wi ≤ 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ci ≤ 109"},{"kind":"text","text":") — the weight and the cost of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th souvenir."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one number — maximum possible total cost of souvenirs that Petya can carry to the market."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n1 3\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n3 10\n2 7\n2 8\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"808E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/808/problem/E"}