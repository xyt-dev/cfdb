{"assets":["/statement-assets/47b0115ae9963b05e1bdc395a7d3da2511deb2084a7b7c5132e8fd0c8263adaf.png"],"contentKind":"statement","contestId":"733","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Grasshopper And the String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day, the Grasshopper was jumping on the lawn and found a piece of paper with a string. Grasshopper became interested what is the minimum "},{"children":[{"kind":"text","text":"jump ability"}],"kind":"container"},{"kind":"text","text":" he should have in order to be able to reach the far end of the string, jumping only on vowels of the English alphabet. "},{"children":[{"kind":"text","text":"Jump ability"}],"kind":"container"},{"kind":"text","text":" is the maximum possible length of his jump. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, consider that at the begginning the Grasshopper is located directly in front of the leftmost character of the string. His goal is to reach the position right after the rightmost character of the string. In one jump the Grasshopper could jump to the right any distance from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to the value of his "},{"children":[{"kind":"text","text":"jump ability"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/47b0115ae9963b05e1bdc395a7d3da2511deb2084a7b7c5132e8fd0c8263adaf.png"},"kind":"image"},{"children":[{"kind":"text","text":"The picture corresponds to the first example."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"The following letters are vowels: '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"E"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"I"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"O"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"Y"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains non-empty string consisting of capital English letters. It is guaranteed that the length of the string does not exceed 100. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print single integer "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" — the minimum "},{"children":[{"kind":"text","text":"jump ability"}],"kind":"container"},{"kind":"text","text":" of the Grasshopper (in the number of symbols) that is needed to overcome the given string, jumping only on vowels."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ABABBBACFEYUK