{"assets":["/statement-assets/fb90f7a6c830219630fe8cc41f805d00df2fa59fa7f0c4c58c98cfde0dd1bf2e.png","/statement-assets/a771437cbf6cc738b6342001e1f3dac3826528a2c00cc337398957dc355e262e.png","/statement-assets/97899aa55ca2b50043fd61b79c50f49fc7ca172145fb0da037ec7441048b38ab.png","/statement-assets/5fe8c63c5fa3d114cce4a1eb2a7d86c8cefffbfc4809fb9c40123ae1bb9df1c9.png"],"contentKind":"statement","contestId":"576","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Points on Plane"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"On a plane are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" points ("},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":") with integer coordinates between "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"106"},{"kind":"text","text":". The distance between the two points with numbers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is said to be the following value: "},{"attrs":{"alt":"","src":"/statement-assets/fb90f7a6c830219630fe8cc41f805d00df2fa59fa7f0c4c58c98cfde0dd1bf2e.png"},"kind":"image"},{"kind":"text","text":" (the distance calculated by such formula is called "},{"children":[{"kind":"text","text":"Manhattan distance"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We call a hamiltonian path to be some permutation "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" of numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". We say that the length of this path is value "},{"attrs":{"alt":"","src":"/statement-assets/a771437cbf6cc738b6342001e1f3dac3826528a2c00cc337398957dc355e262e.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find some hamiltonian path with a length of no more than "},{"kind":"math_inline","text":"25 × 108"},{"kind":"text","text":". Note that you do not have to minimize the path length."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":"-th line contains the coordinates of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th point: "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ xi, yi ≤ 106"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that no two points coincide."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the permutation of numbers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the sought Hamiltonian path. The permutation must meet the inequality "},{"attrs":{"alt":"","src":"/statement-assets/97899aa55ca2b50043fd61b79c50f49fc7ca172145fb0da037ec7441048b38ab.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple possible answers, print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the answer exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 7\n8 10\n3 4\n5 0\n9 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 3 1 2 5 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the sample test the total distance is:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5fe8c63c5fa3d114cce4a1eb2a7d86c8cefffbfc4809fb9c40123ae1bb9df1c9.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"(|5 - 3| + |0 - 4|) + (|3 - 0| + |4 - 7|) + (|0 - 8| + |7 - 10|) + (|8 - 9| + |10 - 12|) = 2 + 4 + 3 + 3 + 8 + 3 + 1 + 2 = 26"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"576C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/576/problem/C"}