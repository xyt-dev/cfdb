{"assets":["/statement-assets/0dcdb6ec1771eba20556c50e591234688ed4b911ce47246e5941f7cfeee3c82a.png","/statement-assets/82ddc8d28a11008fc92297575c9d26eb25242c13046689622feef7415257e015.png","/statement-assets/6e2c0b9744ebd2344854c892499e404cc3cdef28e7b8ee64629f222810828cc7.png","/statement-assets/e7af428e4e6322ee59197f7b16ecb53ec8ceaf6e5612dfba53e94d8220e1b378.png"],"contentKind":"statement","contestId":"2026","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Perpendicular Segments"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a coordinate plane and three integers $$$X$$$, $$$Y$$$, and $$$K$$$. Find two line segments $$$AB$$$ and $$$CD$$$ such that "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" the coordinates of points $$$A$$$, $$$B$$$, $$$C$$$, and $$$D$$$ are integers; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$0 \\le A_x, B_x, C_x, D_x \\le X$$$ and $$$0 \\le A_y, B_y, C_y, D_y \\le Y$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the length of segment $$$AB$$$ is at least $$$K$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the length of segment $$$CD$$$ is at least $$$K$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" segments $$$AB$$$ and $$$CD$$$ are "},{"children":[{"kind":"text","text":"perpendicular"}],"kind":"container"},{"kind":"text","text":": if you draw lines that contain $$$AB$$$ and $$$CD$$$, they will cross at a right angle. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that it's "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" necessary for segments to intersect. Segments are perpendicular as long as the lines they induce are perpendicular."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 5000$$$) — the number of test cases. Next, $$$t$$$ cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first and only line of each test case contains three integers $$$X$$$, $$$Y$$$, and $$$K$$$ ($$$1 \\le X, Y \\le 1000$$$; $$$1 \\le K \\le 1414$$$)."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Additional constraint on the input:"}],"kind":"container"},{"kind":"text","text":" the values of $$$X$$$, $$$Y$$$, and $$$K$$$ are chosen in such a way that the answer exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print two lines. The first line should contain $$$4$$$ integers $$$A_x$$$, $$$A_y$$$, $$$B_x$$$, and $$$B_y$$$ — the coordinates of the first segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line should also contain $$$4$$$ integers $$$C_x$$$, $$$C_y$$$, $$$D_x$$$, and $$$D_y$$$ — the coordinates of the second segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 1 1\n3 4 1\n4 3 3\n3 4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0 0 1 0\n0 0 0 1\n2 4 2 2\n0 1 1 1\n0 0 1 3\n1 2 4 1\n0 1 3 4\n0 3 3 0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The answer for the first test case is shown below: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0dcdb6ec1771eba20556c50e591234688ed4b911ce47246e5941f7cfeee3c82a.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" The answer for the second test case: "},{"children":[{"attrs":{"alt":"","src":"/statement-assets/82ddc8d28a11008fc92297575c9d26eb25242c13046689622feef7415257e015.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" The answer for the third test case: "},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6e2c0b9744ebd2344854c892499e404cc3cdef28e7b8ee64629f222810828cc7.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" The answer for the fourth test case: "},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e7af428e4e6322ee59197f7b16ecb53ec8ceaf6e5612dfba53e94d8220e1b378.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2026A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2026/problem/A"}