at, the value that is assigned on the "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"-th operation, must equal "},{"kind":"math_inline","text":"at"},{"kind":"text","text":". For each operation numbers "},{"kind":"math_inline","text":"y, i, j"},{"kind":"text","text":" are chosen anew."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the minimum number of variables "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", such that those variables can help you perform the described sequence of operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 23)"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(1 ≤ ak ≤ 109)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all numbers in the sequence are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print a single number — the minimum number of variables "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", such that those variables can help you perform the described sequence of operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If you cannot perform the sequence of operations at any "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"k