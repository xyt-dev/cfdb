{"assets":["/statement-assets/0c8d0b6987012efd3346b8679a82d87bef1e3ddfb30fbcea057833eeaf0e7b5e.png","/statement-assets/10aae64cb9349663b9a99fb0a2565477c33f8529674453d04ab831584d03d47a.png","/statement-assets/7080c19766d1d43b761a4fc092145d9abc0d5988b41c4d675b804735960f86b8.png","/statement-assets/a97cd50e95028a52fb2c8a364e116b1827ed74888994f4d1604619a0481eb061.png","/statement-assets/876d781aa3ccfa82da687e27458c3a38cd31a2bce43a2994babdaf275a5077fc.png","/statement-assets/169b73faf4be8a34907b5f3e2071f106c131adc551c68744e3f0c388d898c5ce.png","/statement-assets/998452b3439a6ad0ff62c10b5f5c47a0232b944b82bf1717413c275047bfc946.png","/statement-assets/26635f5bda6a62936b9f3fe3892277b80514e0479863910914f6022ccdba04f0.png"],"contentKind":"statement","contestId":"901","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Cyclic Cipher"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"attrs":{"alt":"","src":"/statement-assets/0c8d0b6987012efd3346b8679a82d87bef1e3ddfb30fbcea057833eeaf0e7b5e.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Senor Vorpal Kickass'o invented an innovative method to encrypt integer sequences of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". To encrypt a sequence, one has to choose a secret sequence "},{"attrs":{"alt":"","src":"/statement-assets/10aae64cb9349663b9a99fb0a2565477c33f8529674453d04ab831584d03d47a.png"},"kind":"image"},{"kind":"text","text":", that acts as a key."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vorpal is very selective, so the key should be such a sequence "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", that its cyclic shifts are linearly independent, that is, there is no non-zero set of coefficients "},{"kind":"math_inline","text":"x0, x1, ..., xn - 1"},{"kind":"text","text":", such that "},{"attrs":{"alt":"","src":"/statement-assets/7080c19766d1d43b761a4fc092145d9abc0d5988b41c4d675b804735960f86b8.png"},"kind":"image"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" at the same time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After that for a sequence "},{"attrs":{"alt":"","src":"/statement-assets/a97cd50e95028a52fb2c8a364e116b1827ed74888994f4d1604619a0481eb061.png"},"kind":"image"},{"kind":"text","text":" you should build the following cipher:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/876d781aa3ccfa82da687e27458c3a38cd31a2bce43a2994babdaf275a5077fc.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In other words, you are to compute the quadratic deviation between each cyclic shift of "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" and the sequence "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". The resulting sequence is the Kickass's cipher. The cipher is in development right now and Vorpal wants to decipher a sequence after it has been encrypted. You are to solve this problem for him. You are given sequences "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". You are to find all suitable sequences "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/169b73faf4be8a34907b5f3e2071f106c131adc551c68744e3f0c388d898c5ce.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"b0, b1, ..., bn - 1"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/998452b3439a6ad0ff62c10b5f5c47a0232b944b82bf1717413c275047bfc946.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"c0, c1, ..., cn - 1"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/26635f5bda6a62936b9f3fe3892277b80514e0479863910914f6022ccdba04f0.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all cyclic shifts of sequence "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" are linearly independent."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of sequences "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", such that after encrypting them with key "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" you get the sequence "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After that in each of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" next lines print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a0, a1, ..., an - 1"},{"kind":"text","text":". Print the sequences in lexicographical order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" could be equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n100\n81\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n91\n109\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 3\n165 185 197\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n-6 -9 -1\n8 5 13\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"901E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/901/problem/E"}