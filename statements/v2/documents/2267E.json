{"assets":[],"contentKind":"statement","contestId":"2267","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Clean Substrings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"A binary string $$$t$$$ of length $$$m$$$ is called "},{"children":[{"kind":"text","text":"clean"}],"kind":"container"},{"kind":"text","text":" if $$$t_i = t_{i+1}$$$ for all $$$1\\le i\\lt m$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The chief engineer of the country has made another discovery. He invented a smart robot that can perform the following operation on any binary string $$$t$$$ for one coin:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose any "},{"children":[{"kind":"text","text":"clean"}],"kind":"container"},{"kind":"text","text":" substring$$$^{\\text{∗}}$$$ of the string $$$t$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Invert all elements of the substring (change $$$0$$$ to $$$1$$$ and vice versa). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Define the "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" of a string $$$t$$$ as the minimum number of coins needed to make it "},{"children":[{"kind":"text","text":"clean"}],"kind":"container"},{"kind":"text","text":". Define the "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" of a string $$$t$$$ as the sum of the "},{"children":[{"kind":"text","text":"beauties"}],"kind":"container"},{"kind":"text","text":" of all its substrings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a binary string $$$s$$$ of length $$$n$$$. The engineer's competitors are going to modify the string exactly $$$q$$$ times. Each modification is described by one number $$$i$$$. After the modification, $$$s_i$$$ is inverted. Your task is to compute the "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" of the string $$$s$$$ before and after each modification."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$A string $$$a$$$ is a substring of a string $$$b$$$ if $$$a$$$ can be obtained from $$$b$$$ by the deletion of several (possibly, zero or all) characters from the beginning and several (possibly, zero or all) characters from the end."}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$q$$$ ($$$1\\le n, q\\le 2\\cdot 10^5$$$) — the length of the binary string and the number of modifications."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains the binary string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$q$$$ lines of each test case contain one integer $$$i$$$ ($$$1\\le i\\le n$$$) — the description of the modifications."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of all $$$n$$$ values and the sum of all $$$q$$$ values over all test cases do not exceed $$$2\\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output $$$q + 1$$$ integers separated by spaces — the answer before the modifications and after each modification of the string."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n3 1\n110\n2\n4 2\n1010\n1\n2\n8 4\n10101110\n3\n5\n2\n3\n10 5\n1100101110\n1\n6\n10\n7\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2 2 \n7 5 5 \n36 23 22 25 26 \n61 66 41 35 59 60 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first test case."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Before the modifications, the string $$$s$$$ is "},{"children":[{"kind":"text","text":"110"}],"kind":"container"},{"kind":"text","text":". The "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" of the string is $$$2$$$: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" of substring $$$s[1, 1]$$$ is 0. "}],"kind":"list_item"},{"children":[{"kind":