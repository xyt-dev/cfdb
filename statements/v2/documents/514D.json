{"assets":[],"contentKind":"statement","contestId":"514","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. R2D2 and Droid Army"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"An army of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" droids is lined up in one row. Each droid is described by "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., am"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the number of details of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th type in this droid's mechanism. R2-D2 wants to destroy the sequence of consecutive droids of maximum length. He has "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" weapons, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th weapon can affect all the droids in the army by destroying one detail of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th type (if the droid doesn't have details of this type, nothing happens to it). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A droid is considered to be destroyed when all of its details are destroyed. R2-D2 can make at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" shots. How many shots from the weapon of what type should R2-D2 make to destroy the sequence of consecutive droids of maximum length?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n, m, k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ 109"},{"kind":"text","text":") — the number of droids, the number of detail types and the number of available shots, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow describing the droids. Each line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., am"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 108"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the number of details of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th type for the respective robot."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space-separated integers, where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number is the number of shots from the weapon of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th type that the robot should make to destroy the subsequence of consecutive droids of the maximum length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple optimal solutions, print any of them. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is not necessary to make exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" shots, the number of shots can be less."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 4\n4 0\n1 2\n2 1\n0 2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 4\n1 2\n1 3\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test the second, third and fourth droids will be destroyed. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test the first and second droids will be destroyed."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"514D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/514/problem/D"}