{"assets":["/statement-assets/2f1cdf11e49bb51fe830a03957de0119b805bed104aa1c5949e749598b69bd13.png","/statement-assets/b641c78c4104752c7ecd0a6548821e7611bf3c2cea860385180923f6936eba1d.png","/statement-assets/0b54a208d5e7dc896170231e1cf13eb4fbe29664f00cb5179ad385e0d0604e86.png"],"contentKind":"statement","contestId":"908","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. New Year and Boolean Bridges"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Your friend has a hidden directed graph with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"f(u, v)"},{"kind":"text","text":" be true if there is a directed path from node "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" to node "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", and false otherwise. For each pair of distinct nodes, "},{"kind":"math_inline","text":"u, v"},{"kind":"text","text":", you know at least one of the three statements is true: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"attrs":{"alt":"","src":"/statement-assets/2f1cdf11e49bb51fe830a03957de0119b805bed104aa1c5949e749598b69bd13.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b641c78c4104752c7ecd0a6548821e7611bf3c2cea860385180923f6936eba1d.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0b54a208d5e7dc896170231e1cf13eb4fbe29664f00cb5179ad385e0d0604e86.png"},"kind":"image"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Here AND, OR and XOR mean AND, OR and exclusive OR operations, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" matrix saying which one of the three statements holds for each pair of vertices. The entry in the "},{"kind":"math_inline","text":"u"},{"kind":"text","text":"-th row and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"-th column has a single character. "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" If the first statement holds, this is represented by the character '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the second holds, this is represented by the character '"},{"children":[{"kind":"text","text":"O"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the third holds, this is represented by the character '"},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The diagonal of this matrix will only contain the character '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that it is possible that a pair of nodes may satisfy multiple statements, in which case, the character given will represent one of the true statements for that pair. This matrix is also guaranteed to be symmetric."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You would like to know if there is a directed graph that is consistent with this matrix. If it is impossible, print the integer "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". Otherwise, print the minimum number of edges that could be consistent with this information."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line will contain an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 47"},{"kind":"text","text":"), the number of nodes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines will contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters each: the matrix of what you know about the graph connectivity in the format described in the statement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of edges that is consistent with the given information, or "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if it is impossible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n-AAA\nA-AA\nAA-A\nAAA-\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n-XX\nX-X\nXX-\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Sample 1: The hidden graph is a strongly connected graph. We can put all four nodes in a cycle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sample 2: One valid graph is "},{"kind":"math_inline","text":"3 → 1 → 2"},{"kind":"text","text":". For each distinct pair, exactly one of "},{"kind":"math_inline","text":"f(u, v), f(v, u)"},{"kind":"text","text":" holds."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"908H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/908/problem/H"}