{"assets":[],"contentKind":"statement","contestId":"267","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Subtractions"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got two numbers. As long as they are both larger than zero, they go through the same operation: subtract the lesser number from the larger one. If they equal substract one number from the another. For example, one operation transforms pair (4,17) to pair (4,13), it transforms (5,5) to (0,5)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You've got some number of pairs ("},{"kind":"math_inline","text":"ai, bi"},{"kind":"text","text":"). How many operations will be performed for each of them?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the number of pairs "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤  n  ≤  1000"},{"kind":"text","text":"). Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each line contains a pair of positive integers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤  ai,  bi  ≤  109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":