{"assets":[],"contentKind":"statement","contestId":"60","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Serial Time!"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Cereal Guy's friend Serial Guy likes to watch soap operas. An episode is about to start, and he hasn't washed his plate yet. But he decided to at least put in under the tap to be filled with water. The plate can be represented by a parallelepiped "},{"kind":"math_inline","text":"k × n × m"},{"kind":"text","text":", that is, it has "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" layers (the first layer is the upper one), each of which is a rectangle "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" with empty squares ('.') and obstacles ('#'). The water can only be present in the empty squares. The tap is positioned above the square "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" of the first layer, it is guaranteed that this square is empty. Every minute a cubical unit of water falls into the plate. Find out in how many minutes the Serial Guy should unglue himself from the soap opera and turn the water off for it not to overfill the plate. That is, you should find the moment of time when the plate is absolutely full and is going to be overfilled in the next moment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note: the water fills all the area within reach (see sample 4). Water flows in "},{"children":[{"kind":"text","text":"each"}],"kind":"container"},{"kind":"text","text":" of the 6 directions, through faces of "},{"kind":"math_inline","text":"1 × 1 × 1"},{"kind":"text","text":" cubes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three numbers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k, n, m ≤ 10"},{"kind":"text","text":") which are the sizes of the plate. Then follow "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" rectangles consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each containing "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters '.' or '#', which represents the \"layers\" of the plate in the order from the top to the bottom. The rectangles are separated by empty lines (see the samples). The last line contains "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ n, 1 ≤ y ≤ m"},{"kind":"text","text":") which are the tap's coordinates. "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is the number of the line and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is the number of the column. Lines of each layer are numbered from left to right by the integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", columns of each layer are numbered from top to bottom by the integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The answer should contain a single number, showing in how many minutes the plate will be filled."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 1\n\n.\n\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 1\n\n.\n\n#\n\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 2\n\n.#\n##\n\n..\n..\n\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 2\n\n#.\n##\n\n#.\n.#\n\n..\n..\n\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 3\n\n.#.\n###\n##.\n\n.##\n###\n##.\n\n...\n...\n...\n\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"60B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/60/problem/B"}