,"text":"The first line contains single integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$t$$$ lines contains test cases — one per line. The first and only line of each test case contains string $$$s$$$ ($$$2 \\le |s| \\le 2 \\cdot 10^5$$$). Each character $$$s_i$$$ is digit "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"–"},{"children":[{"kind":"text","text":"9"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the total length of strings doesn't exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the minimum number of characters you need to erase from $$$s$$$ to make it good."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n95831\n100120013\n252525252525\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n5\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, you can erase any $$$3$$$ characters, for example, the $$$1$$$-st, the $$$3$$$-rd, and the $$$4$$$-th. You'll get string "},{"children":[{"kind":"text","text":"51"}],"kind":"container"},{"kind":"text","text":" and it is good."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, we can erase all characters except "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":": the remaining string is "},{"children":[{"kind":"text","text":"0000"}],"kind":"container"},{"kind":"text","text":" and it's good."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, the given string $$$s$$$ is already good."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1389C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1389/problem/C"}