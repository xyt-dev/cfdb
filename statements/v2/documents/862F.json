{"assets":[],"contentKind":"statement","contestId":"862","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Mahmoud and Ehab and the final stage"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mahmoud and Ehab solved Dr. Evil's questions so he gave them the password of the door of the evil land. When they tried to open the door using it, the door gave them a final question to solve before they leave (yes, the door is digital, Dr. Evil is modern). If they don't solve it, all the work will be useless and they won't leave the evil land forever. Will you help them?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mahmoud and Ehab are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" strings "},{"kind":"math_inline","text":"s1, s2, ... , sn"},{"kind":"text","text":" numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries, Each query has one of the following forms:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"a"},{"kind":"math_inline","text":"b"},{"kind":"math_inline","text":"(1 ≤ a ≤ b ≤ n)"},{"kind":"text","text":", For all the intervals "},{"kind":"math_inline","text":"[l;r]"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"(a ≤ l ≤ r ≤ b)"},{"kind":"text","text":" find the maximum value of this expression:"},{"children":[{"kind":"math_inline","text":"(r - l + 1) * LCP(sl, sl + 1, ... , sr - 1, sr)"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"LCP(str1, str2, str3, ... )"},{"kind":"text","text":" is the length of the longest common prefix of the strings "},{"kind":"math_inline","text":"str1, str2, str3, ... "},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"y"},{"kind":"math_inline","text":"(1 ≤ x ≤ n)"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is a string, consisting of lowercase English letters. Change the string at position "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains 2 integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105, 1 ≤ q ≤ 105)"},{"kind":"text","text":" – The number of strings and the number of queries, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" strings "},{"kind":"math_inline","text":"stri"},{"kind":"text","text":" consisting of lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines describe the queries and may have one of the 2 forms:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"a"},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a ≤ b ≤ n"},{"kind":"text","text":")."}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ n"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is a string consisting of lowercase English letters."}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"the total length of all strings in input won't exceed "},{"kind":"math_inline","text":"105"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of first type output its answer in a new line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 9\nmahmoud mahmoudbadawy drmahmoud drevil mahmoud\n1 1 5\n1 1 2\n1 2 3\n2 3 mahmoud\n2 4 mahmoud\n2 2 mahmouu\n1 1 5\n1 2 3\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n14\n13\n30\n12\n7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"862F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/862/problem/F"}