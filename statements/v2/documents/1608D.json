{"assets":[],"contentKind":"statement","contestId":"1608","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Dominoes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given $$$n$$$ dominoes. Each domino has a left and a right cell. Each cell can be colored either black or white. Some cells are already colored, while some aren't yet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The coloring is said to be "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" if and only if it is possible to rearrange the dominoes in some order such that for each $$$1 \\le i \\le n$$$ the color of the right cell of the $$$i$$$-th domino is different from the color of the left cell of the $$$((i \\bmod n)+1)$$$-st domino. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that you can't rotate the dominoes, so the left cell always remains the left cell, and the right cell always remains the right cell."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Count the number of valid ways to color the yet uncolored cells of dominoes. Two ways are considered different if there is a cell that is colored white in one way and black in the other. In particular, colorings "},{"children":[{"kind":"text","text":"BW"}],"kind":"container"},{"children":[{"kind":"text","text":"WB"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"WB"}],"kind":"container"},{"children":[{"kind":"text","text":"BW"}],"kind":"container"},{"kind":"text","text":" different (and both invalid)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As this number can be very big, output it modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer $$$n$$$ ($$$1 \\le n \\le 10^5$$$) — the number of dominoes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n$$$ lines describe dominoes. Each line contains two characters which represent the left and the right cell. Character "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" means that the corresponding cell is black, character "},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":" means that the corresponding cell is white, and "},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":" means that the cell is yet to be colored. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n?W\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n??\nW?\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nBB\n??\nW?\n??\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, there is only one domino, and we need the color of its right cell to be different from the color of its left cell. There is only one way to achieve this."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, there are only $$$2$$$ such colorings:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"BB"}],"kind":"container"},{"children":[{"kind":"text","text":"WW"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"WB"}],"kind":"container"},{"children":[{"kind":"text","text":"WB"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1608D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1608/problem/D"}