{"assets":[],"contentKind":"statement","contestId":"282","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Painting Eggs"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Bitlandians are quite weird people. They have very peculiar customs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As is customary, Uncle J. wants to have "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" eggs painted for Bitruz (an ancient Bitland festival). He has asked G. and A. to do the work."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The kids are excited because just as is customary, they're going to be paid for the job! "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall uncle J. has got "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" eggs. G. named his price for painting each egg. Similarly, A. named his price for painting each egg. It turns out that for each egg the sum of the money both A. and G. want for the painting equals "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Uncle J. wants to distribute the eggs between the children so as to give each egg to exactly one child. Also, Uncle J. wants the total money paid to A. to be different from the total money paid to G. by no more than "},{"kind":"math_inline","text":"500"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Uncle J. Find the required distribution of eggs or otherwise say that distributing the eggs in the required manner is impossible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 106)"},{"kind":"text","text":" — the number of eggs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"gi"},{"kind":"text","text":" each "},{"kind":"math_inline","text":"(0 ≤ ai, gi ≤ 1000; ai + gi = 1000)"},{"kind":"text","text":": "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the price said by A. for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th egg and "},{"kind":"math_inline","text":"gi"},{"kind":"text","text":" is the price said by G. for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th egg."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is impossible to assign the painting, print \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print a string, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" letters \""},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th letter of this string should represent the child who will get the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th egg in the required distribution. Letter \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\" represents A. and letter \""},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"\" represents G. If we denote the money Uncle J. must pay A. for the painting as "},{"kind":"math_inline","text":"Sa"},{"kind":"text","text":", and the money Uncle J. must pay G. for the painting as "},{"kind":"math_inline","text":"Sg"},{"kind":"text","text":", then this inequality must hold: "},{"kind":"math_inline","text":"|Sa  -  Sg|  ≤  500"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several solutions, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 999\n999 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"AG\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n400 600\n400 600\n400 600\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"AGA\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"282B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/282/problem/B"}