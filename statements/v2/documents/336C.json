{"assets":[],"contentKind":"statement","contestId":"336","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Vasily the Bear and Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasily the bear has got a sequence of positive integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". Vasily the Bear wants to write out several numbers on a piece of paper so that the beauty of the numbers he wrote out was maximum. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" of the written out numbers "},{"kind":"math_inline","text":"b1, b2, ..., bk"},{"kind":"text","text":" is such maximum non-negative integer "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", that number "},{"kind":"math_inline","text":"b1"},{"kind":"math_inline","text":"and"},{"kind":"math_inline","text":"b2"},{"kind":"math_inline","text":"and"},{"kind":"math_inline","text":"..."},{"kind":"math_inline","text":"and"},{"kind":"math_inline","text":"bk"},{"kind":"text","text":" is divisible by number "},{"kind":"math_inline","text":"2v"},{"kind":"text","text":" without a remainder. If such number "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" doesn't exist (that is, for any non-negative integer "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", number "},{"kind":"math_inline","text":"b1"},{"kind":"math_inline","text":"and"},{"kind":"math_inline","text":"b2"},{"kind":"math_inline","text":"and"},{"kind":"math_inline","text":"..."},{"kind":"math_inline","text":"and"},{"kind":"math_inline","text":"bk"},{"kind":"text","text":" is divisible by "},{"kind":"math_inline","text":"2v"},{"kind":"text","text":" without a remainder), the beauty of the written out numbers equals -1. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Tell the bear which numbers he should write out so that the beauty of the written out numbers is maximum. If there are multiple ways to write out the numbers, you need to choose the one where the bear writes out as many numbers as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here expression "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"and"},{"kind":"math_inline","text":"y"},{"kind":"text","text":" means applying the bitwise AND operation to numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". In programming languages C++ and Java this operation is represented by \"&\", in Pascal — by \"and\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(1 ≤ a1 < a2 < ... < an ≤ 109)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single integer "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(k > 0)"},{"kind":"text","text":", showing how many numbers to write out. In the second line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"b1, b2, ..., bk"},{"kind":"text","text":" — the numbers to write out. You are allowed to print numbers "},{"kind":"math_inline","text":"b1, b2, ..., bk"},{"kind":"text","text":" in any order, but all of them must be distinct. If there are multiple ways to write out the numbers, choose the one with the maximum number of numbers to write out. If there still are multiple ways, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n4 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"336C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/336/problem/C"}