{"assets":[],"contentKind":"statement","contestId":"576","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Painting Edges"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"6 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"children":[{"kind":"text","text":"600 megabytes"}],"kind":"container"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Note the unusual memory limit for this problem."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an undirected graph consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges. The vertices are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", the edges are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Each edge can be unpainted or be painted in one of the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" colors, which are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Initially, none of the edges is painted in any of the colors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You get queries of the form \"Repaint edge "},{"kind":"math_inline","text":"ei"},{"kind":"text","text":" to color "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":"\". At any time the graph formed by the edges of the same color must be bipartite. If after the repaint this condition is violated, then the query is considered to be invalid and edge "},{"kind":"math_inline","text":"ei"},{"kind":"text","text":" keeps its color. Otherwise, edge "},{"kind":"math_inline","text":"ei"},{"kind":"text","text":" is repainted in color "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":", and the query is considered to valid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Recall that the graph is called "},{"children":[{"kind":"text","text":"bipartite"}],"kind":"container"},{"kind":"text","text":" if the set of its vertices can be divided into two parts so that no edge connected vertices of the same parts."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, suppose you are given a triangle graph, that is a graph with three vertices and edges "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(3, 1)"},{"kind":"text","text":". Suppose that the first two edges are painted color "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", and the third one is painted color "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Then the query of \"repaint the third edge in color "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"\" will be incorrect because after its execution the graph formed by the edges of color "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" will not be bipartite. On the other hand, it is possible to repaint the second edge in color "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You receive "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries. For each query, you should either apply it, and report that the query is valid, or report that the query is invalid."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 5·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m, q ≤ 5·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 50"},{"kind":"text","text":") — the number of vertices, the number of edges, the number of colors and the number of queries. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges of the graph in the form "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries of the form "},{"kind":"math_inline","text":"ei"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ei ≤ m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ci ≤ k"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the graph doesn't contain multiple edges and loops."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if it is valid, or \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if this query destroys the bipartivity of the graph formed by the edges of some color."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 2 5\n1 2\n2 3\n1 3\n1 1\n2 1\n3 2\n3 1\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nYES\nYES\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"576E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/576/problem/E"}