{"assets":[],"contentKind":"statement","contestId":"1627","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Not Adding"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have an array $$$a_1, a_2, \\dots, a_n$$$ consisting of $$$n$$$ "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" integers. You are allowed to perform the following operation on it:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose two elements from the array $$$a_i$$$ and $$$a_j$$$ ($$$i \\ne j$$$) such that $$$\\gcd(a_i, a_j)$$$ is not present in the array, and add $$$\\gcd(a_i, a_j)$$$ to the end of the array. Here $$$\\gcd(x, y)$$$ denotes "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Greatest_common_divisor"},"children":[{"kind":"text","text":"greatest common divisor (GCD)"}],"kind":"link"},{"kind":"text","text":" of integers $$$x$$$ and $$$y$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that the array changes after each operation, and the subsequent operations are performed on the new array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the "},{"children":[{"kind":"text","text":"maximum"}],"kind":"container"},{"kind":"text","text":" number of times you can perform the operation on the array?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line consists of a single integer $$$n$$$ ($$$2 \\le n \\le 10^6$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line consists of $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\leq a_i \\leq 10^6$$$). All $$$a_i$$$ are "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single line containing one integer — the maximum number of times the operation can be performed on the given array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n4 20 1 25 30\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n6 10 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, one of the ways to perform maximum number of operations on the array is: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Pick $$$i = 1, j= 5$$$ and add $$$\\gcd(a_1, a_5) = \\gcd(4, 30) = 2$$$ to the array. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Pick $$$i = 2, j= 4$$$ and add $$$\\gcd(a_2, a_4) = \\gcd(20, 25) = 5$$$ to the array. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Pick $$$i = 2, j= 5$$$ and add $$$\\gcd(a_2, a_5) = \\gcd(20, 30) = 10$$$ to the array. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It can be proved that there is no way to perform more than $$$3$$$ operations on the original array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example one can add $$$3$$$, then $$$1$$$, then $$$5$$$, and $$$2$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1627D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1627/problem/D"}