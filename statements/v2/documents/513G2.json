{"assets":["/statement-assets/8f5c374328209e220960cf100994affdfe508f8a3e4d87a1b922fe95e8b7dbd2.png","/statement-assets/995055100410411b6727bf3ec8b36f0cee77b2b3e8bbe8eeb763af975af05ac9.png","/statement-assets/1e23b97891f936f7fe0c4978a391d1b850a9c626d1a6bc4e7c5a034ecb1d2aee.png"],"contentKind":"statement","contestId":"513","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G2. Inversions problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a permutation of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":". We perform "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" operations of the following type: choose uniformly at random two indices "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"l ≤ r"},{"kind":"text","text":") and reverse the order of the elements "},{"kind":"math_inline","text":"pl, pl + 1, ..., pr"},{"kind":"text","text":". Your task is to find the expected value of the number of inversions in the resulting permutation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 109"},{"kind":"text","text":"). The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" — the given permutation. All "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" are different and in range from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"The problem consists of three subproblems. The subproblems have different constraints on the input. You will get some score for the correct submission of the subproblem. The description of the subproblems follows."}],"kind":"container"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" In subproblem G1 ("},{"kind":"math_inline","text":"3"},{"kind":"text","text":" points), the constraints "},{"kind":"math_inline","text":"1 ≤ n ≤ 6"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 4"},{"kind":"text","text":" will hold. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" In subproblem G2 ("},{"kind":"math_inline","text":"5"},{"kind":"text","text":" points), the constraints "},{"kind":"math_inline","text":"1 ≤ n ≤ 30"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 200"},{"kind":"text","text":" will hold. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" In subproblem G3 ("},{"kind":"math_inline","text":"16"},{"kind":"text","text":" points), the constraints "},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 109"},{"kind":"text","text":" will hold. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the answer with absolute or relative error no more than "},{"kind":"math_inline","text":"1e - 9"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.833333333333333\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n1 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.458333333333334\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first sample test. We will randomly pick an interval of the permutation "},{"kind":"math_inline","text":"(1, 2, 3)"},{"kind":"text","text":" (which has no inversions) and reverse the order of its elements. With probability "},{"attrs":{"alt":"","src":"/statement-assets/8f5c374328209e220960cf100994affdfe508f8a3e4d87a1b922fe95e8b7dbd2.png"},"kind":"image"},{"kind":"text","text":", the interval will consist of a single element and the permutation will not be altered. With probability "},{"attrs":{"alt":"","src":"/statement-assets/995055100410411b6727bf3ec8b36f0cee77b2b3e8bbe8eeb763af975af05ac9.png"},"kind":"image"},{"kind":"text","text":" we will inverse the first two elements' order and obtain the permutation "},{"kind":"math_inline","text":"(2, 1, 3)"},{"kind":"text","text":" which has one inversion. With the same probability we might pick the interval consisting of the last two elements which will lead to the permutation "},{"kind":"math_inline","text":"(1, 3, 2)"},{"kind":"text","text":" with one inversion. Finally, with probability "},{"attrs":{"alt":"","src":"/statement-assets/995055100410411b6727bf3ec8b36f0cee77b2b3e8bbe8eeb763af975af05ac9.png"},"kind":"image"},{"kind":"text","text":" the randomly picked interval will contain all elements, leading to the permutation "},{"kind":"math_inline","text":"(3, 2, 1)"},{"kind":"text","text":" with 3 inversions. Hence, the expected number of inversions is equal to "},{"attrs":{"alt":"","src":"/statement-assets/1e23b97891f936f7fe0c4978a391d1b850a9c626d1a6bc4e7c5a034ecb1d2aee.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G2","problemCode":"513G2","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/513/problem/G2"}