{"assets":["/statement-assets/bfdadf345ce77c5e01b2bac75925e0ca171c183589eff2e3bdb195e5b3a31225.png","/statement-assets/f549a2faeb6f5e0ab138b52b3525242058727aaab89e63a137769cf0d761d2d7.png","/statement-assets/ccc6a0f6d2fdbab3d62c75191f9e9ec11431b2321ae44612bc3e6b57b914de48.png","/statement-assets/cb3e7afd67bfda098045d745c2dfbd9389b0075753f727f8d84b4f97ac7fc54a.png","/statement-assets/aaadffb175e682ecfdb90a7b814bb9e7c8a2a00dff76f6c215f60c74888df638.png"],"contentKind":"statement","contestId":"1188","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A1. Add on a Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Note that this is the first problem of the two similar problems. You can hack this problem only if you solve both problems."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a tree with $$$n$$$ nodes. In the beginning, $$$0$$$ is written on all edges. In one operation, you can choose any $$$2$$$ distinct "},{"children":[{"kind":"text","text":"leaves"}],"kind":"container"},{"kind":"text","text":" $$$u$$$, $$$v$$$ and any "},{"children":[{"kind":"text","text":"real"}],"kind":"container"},{"kind":"text","text":" number $$$x$$$ and add $$$x$$$ to values written on all edges on the simple path between $$$u$$$ and $$$v$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, on the picture below you can see the result of applying two operations to the graph: adding $$$2$$$ on the path from $$$7$$$ to $$$6$$$, and then adding $$$-0.5$$$ on the path from $$$4$$$ to $$$5$$$. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/bfdadf345ce77c5e01b2bac75925e0ca171c183589eff2e3bdb195e5b3a31225.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Is it true that for any configuration of real numbers written on edges, we can achieve it with a finite number of operations?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Leaf is a node of a tree of degree $$$1$$$. Simple path is a path that doesn't contain any node twice."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$2 \\le n \\le 10^5$$$) — the number of nodes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n-1$$$ lines contains two integers $$$u$$$ and $$$v$$$ ($$$1 \\le u, v \\le n$$$, $$$u \\neq v$$$), meaning that there is an edge between nodes $$$u$$$ and $$$v$$$. It is guaranteed that these edges form a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is a configuration of real numbers written on edges of the tree that we can't achieve by performing the operations, output \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print each letter in any case (upper or lower)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 2\n1 3\n1 4\n2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 2\n1 3\n1 4\n2 5\n2 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, we can add any real $$$x$$$ to the value written on the only edge $$$(1, 2)$$$."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f549a2faeb6f5e0ab138b52b3525242058727aaab89e63a137769cf0d761d2d7.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second example, one of configurations that we can't reach is $$$0$$$ written on $$$(1, 2)$$$ and $$$1$$$ written on $$$(2, 3)$$$."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ccc6a0f6d2fdbab3d62c75191f9e9ec11431b2321ae44612bc3e6b57b914de48.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Below you can see graphs from examples $$$3$$$, $$$4$$$:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/cb3e7afd67bfda098045d745c2dfbd9389b0075753f727f8d84b4f97ac7fc54a.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/aaadffb175e682ecfdb90a7b814bb9e7c8a2a00dff76f6c215f60c74888df638.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"A1","problemCode":"1188A1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1188/problem/A1"}