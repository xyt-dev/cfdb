{"assets":[],"contentKind":"statement","contestId":"2267","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. New LRT"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"A new LRT (light rail transit) has opened in the famous city. It is a train that moves along a straight line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given two numbers $$$n$$$ and $$$m$$$, and an array $$$c$$$ consisting of $$$m$$$ integers. You are at position $$$0$$$, and you need to get to position $$$n$$$. If you are at position $$$i$$$, you can ride the train as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose a positive integer $$$x$$$ such that $$$m\\& x = x$$$, where $$$\\&$$$ denotes the "},{"children":[{"kind":"text","text":"bitwise AND operation"}],"kind":"link"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Move from position $$$i$$$ to $$$i + x$$$, paying $$$c_x$$$ coins. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" The "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" of a trip is the total number of coins that had to be paid to get from position $$$0$$$ to position $$$n$$$. Two trips are considered different if the order of moves differs or the moves themselves differ. Your task is to determine the sum of the "},{"children":[{"kind":"text","text":"costs"}],"kind":"container"},{"kind":"text","text":" of all possible trips. Since the answer may be large, output it modulo $$$10^9 + 7$$$."}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$m$$$ ($$$1\\le n, m\\lt 2^{20}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$m$$$ integers $$$c_1, c_2, \\ldots, c_m$$$ ($$$1\\le c_i\\le 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ and the sum of $$$m$$$ over all test cases do not exceed $$$2^{20}$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output one number — the answer to the problem modulo $$$10^9 + 7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n3 3\n2 2 1\n4 5\n3 1 2 4 5\n5 3\n9 1 5\n8 3\n1000000000 1000000000 1000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n15\n16\n271\n999997081\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, there are $$$4$$$ ways to get to position $$$n$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$0\\rightarrow 1\\rightarrow 2\\rightarrow 3$$$. The "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" of this trip is $$$c_1 + c_1 + c_1 = 6$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$0\\rightarrow 1\\rightarrow 3$$$. The "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" of this trip is $$$c_1 + c_2 = 4$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$0\\rightarrow 2\\rightarrow 3$$$. The "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" of this trip is $$$c_2 + c_1 = 4$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$0\\rightarrow 3$$$. The "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" of this trip is $$$c_3 = 1$$$. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" Thus, the answer is $$$6 + 4 + 4 + 1 = 15$$$."}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"2267G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2267/problem/G"}