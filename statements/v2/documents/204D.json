{"assets":[],"contentKind":"statement","contestId":"204","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Little Elephant and Retro Strings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Little Elephant has found a ragged old black-and-white string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" on the attic."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The characters of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" are numbered from the left to the right from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":" is the length of the string. Let's denote the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"si"},{"kind":"text","text":". As the string is black-and-white, each character of the string is either letter \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\", or letter \""},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"\". Unfortunately, the string is very old and some characters are damaged. The damaged positions are denoted as \""},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Little Elephant in determined to restore the string and hang it on the wall. For that he needs to replace each character \""},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"\" by a \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\" or a \""},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"\". The string must look good on the wall, so it must be "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":". The Little Elephant considers a string beautiful if it has two non-intersecting substrings of a given length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", such that the left one fully consists of characters \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\", and the right one fully consists of characters \""},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"\". More formally, there are four integers "},{"kind":"math_inline","text":"a, b, c, d"},{"kind":"math_inline","text":"(1 ≤ a ≤ b < c ≤ d ≤ |s|; b - a + 1 = d - c + 1 = k)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" = \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\" "},{"kind":"math_inline","text":"(a ≤ i ≤ b)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"sj"},{"kind":"text","text":" = \""},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"\" "},{"kind":"math_inline","text":"(c ≤ j ≤ d)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the Little Elephant find the number of different beautiful strings he can obtain from string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Two strings are considered different if there is such position, where the character in the first string differs from the corresponding character in the second string. If this string doesn't contain characters «"},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"» and it is already beautiful — the answer is "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As the answer can be rather large, print it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ k ≤ n ≤ 106)"},{"kind":"text","text":". The second line contains string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". String "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" has length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and only consists of characters \""},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On a single line print an integer — the answer to the problem modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\nXXX\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\nXXXX\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 2\nXXBXXWXXXX\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"166\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"204D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/204/problem/D"}