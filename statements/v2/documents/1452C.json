{"assets":[],"contentKind":"statement","contestId":"1452","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Two Brackets"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$, consisting of brackets of two types: '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"["}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"]"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string is called a regular bracket sequence (RBS) if it's of one of the following types: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" empty string; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' + RBS + '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"'; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"["}],"kind":"container"},{"kind":"text","text":"' + RBS + '"},{"children":[{"kind":"text","text":"]"}],"kind":"container"},{"kind":"text","text":"'; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" RBS + RBS. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"where plus is a concatenation of two strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one move you can choose a non-empty subsequence of the string $$$s$$$ (not necessarily consecutive) that is an RBS, remove it from the string and concatenate the remaining parts without changing the order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the maximum number of moves you can perform?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of testcases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$t$$$ lines contains a non-empty string, consisting only of characters '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"["}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"]"}],"kind":"container"},{"kind":"text","text":"'. The total length of the strings over all testcases doesn't exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase print a single integer — the maximum number of moves you can perform on a given string $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n()\n[]()\n([)]\n)]([\n)[(]\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n2\n0\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example you can just erase the whole string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example you can first erase the brackets on positions $$$1$$$ and $$$2$$$: \""},{"children":[{"children":[{"kind":"text","text":"[]"}],"kind":"container"},{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":"\", then \""},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":"\" is left. After that you can erase it whole. You could erase the whole string from the beginning but you would get one move instead of two."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example you can first erase the brackets on positions $$$1$$$ and $$$3$$$: \""},{"children":[{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"["},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"]"}],"kind":"container"},{"kind":"text","text":"\". They form an RBS \""},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":"\". Then \""},{"children":[{"kind":"text","text":"[]"}],"kind":"container"},{"kind":"text","text":"\" is left, so you can erase it whole."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example there is no subsequence that is an RBS, so you can't perform a move at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth example you can erase the brackets on positions $$$2$$$ and $$$4$$$: \""},{"children":[{"kind":"text","text":")"},{"children":[{"kind":"text","text":"["}],"kind":"container"},{"kind":"text","text":"("},{"children":[{"kind":"text","text":"]"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":"\" and get \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\" as a result. You can erase nothing from it."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1452C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1452/problem/C"}