{"assets":["/statement-assets/825f346e99060c899756827bd8030148d0812ae4b1cd0fa25ac7a6119ab351a4.png"],"contentKind":"statement","contestId":"937","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Vile Grasshoppers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The weather is fine today and hence it's high time to climb the nearby pine and enjoy the landscape."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The pine's trunk includes several branches, located one above another and numbered from "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". Some of them (more precise, from "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"p"},{"kind":"text","text":") are occupied by tiny vile grasshoppers which you're at war with. These grasshoppers are known for their awesome jumping skills: the grasshopper at branch "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" can jump to branches "},{"attrs":{"alt":"","src":"/statement-assets/825f346e99060c899756827bd8030148d0812ae4b1cd0fa25ac7a6119ab351a4.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Keeping this in mind, you wisely decided to choose such a branch that none of the grasshoppers could interrupt you. At the same time you wanna settle as high as possible since the view from up there is simply breathtaking."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In other words, your goal is to find the highest branch that cannot be reached by any of the grasshoppers or report that it's impossible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains two integers "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"math_inline","text":"(2 ≤ p ≤ y ≤ 109)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the number of the highest suitable branch. If there are none, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" instead."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case grasshopper from branch "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" reaches branches "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" while branch "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" is initially settled by another grasshopper. Therefore the answer is "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It immediately follows that there are no valid branches in second sample case."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"937B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/937/problem/B"}