{"assets":[],"contentKind":"statement","contestId":"426","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Sereja and Mirroring"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's assume that we are given a matrix "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"x × y"},{"kind":"text","text":", let's determine the operation of mirroring matrix "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The mirroring of matrix "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is a "},{"kind":"math_inline","text":"2x × y"},{"kind":"text","text":" matrix "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" which has the following properties:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the upper half of matrix "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" (rows with numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":") exactly matches "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the lower half of matrix "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" (rows with numbers from "},{"kind":"math_inline","text":"x + 1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"2x"},{"kind":"text","text":") is symmetric to the upper one; the symmetry line is the line that separates two halves (the line that goes in the middle, between rows "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x + 1"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Sereja has an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" matrix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". He wants to find such matrix "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", that it can be transformed into matrix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", if we'll perform on it "},{"children":[{"kind":"text","text":"several"}],"kind":"container"},{"kind":"text","text":" (possibly zero) mirrorings. What minimum number of rows can such matrix contain?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 100)"},{"kind":"text","text":". Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers — the elements of matrix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains integers "},{"kind":"math_inline","text":"ai1, ai2, ..., aim"},{"kind":"math_inline","text":"(0 ≤ aij ≤ 1)"},{"kind":"text","text":" — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row of the matrix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level