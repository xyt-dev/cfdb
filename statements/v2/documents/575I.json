{"assets":[],"contentKind":"statement","contestId":"575","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"I. Robots protection"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Company \"Robots industries\" produces robots for territory protection. Robots protect triangle territories — right isosceles triangles with catheti parallel to North-South and East-West directions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Owner of some land buys and sets robots on his territory to protect it. From time to time, businessmen want to build offices on that land and want to know how many robots will guard it. You are to handle these queries. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" — width and height of the land, and integer "},{"kind":"math_inline","text":"Q"},{"kind":"text","text":" — number of queries to handle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"Q"},{"kind":"text","text":" lines contain queries you need to process."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two types of queries: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"dir"},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"y"},{"kind":"math_inline","text":"len"},{"kind":"text","text":" — add a robot to protect a triangle. Depending on the value of "},{"kind":"math_inline","text":"dir"},{"kind":"text","text":", the values of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"len"},{"kind":"text","text":" represent a different triangle: "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"dir = 1"},{"kind":"text","text":": Triangle is defined by the points "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x + len, y)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x, y + len)"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"dir = 2"},{"kind":"text","text":": Triangle is defined by the points "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x + len, y)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x, y - len)"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"dir = 3"},{"kind":"text","text":": Triangle is defined by the points "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x - len, y)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x, y + len)"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"dir = 4"},{"kind":"text","text":": Triangle is defined by the points "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x - len, y)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x, y - len)"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"y"},{"kind":"text","text":" — output how many robots guard this point (robot guards a point if the point is inside or on the border of its triangle) "}],"kind":"list_item"}],"kind":"list"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1 ≤ N ≤ 5000"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1 ≤ Q ≤ 105"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1 ≤ dir ≤ 4"}],"kind":"list_item"},{"children":[{"kind":"text","text":" All points of triangles are within range "},{"kind":"math_inline","text":"[1, N]"}],"kind":"list_item"},{"children":[{"kind":"text","text":" All numbers are positive integers "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each second type query output how many robots guard this point. Each answer should be in a separate line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"17 10\n1 1 3 2 4\n1 3 10 3 7\n1 2 6 8 2\n1 3 9 4 2\n2 4 4\n1 4 15 10 6\n2 7 7\n2 9 4\n2 12 2\n2 13 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2\n2\n0\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"I","problemCode":"575I","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/575/problem/I"}