{"assets":["/statement-assets/d3df10fdff253580c9e4acea874202a1e6bdfea979bcd51e1b4be3574d7e3c08.png","/statement-assets/02e8ab580ba16651372779fbfb3cf7d45fe1546b8bb78311a53b14b91155d871.png","/statement-assets/1667c8174fb56d9d9cb163a4cd968142abeb42c7f9fdb497f3be2e67dd0dfc68.png"],"contentKind":"statement","contestId":"356","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Xenia and String Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Xenia the coder went to The Olympiad of Informatics and got a string problem. Unfortunately, Xenia isn't fabulous in string algorithms. Help her solve the problem."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"String"}],"kind":"container"},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a sequence of characters "},{"kind":"math_inline","text":"s1s2... s|s|"},{"kind":"text","text":", where record "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":" shows the length of the string. "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Substring"}],"kind":"container"},{"kind":"math_inline","text":"s[i... j]"},{"kind":"text","text":" of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is string "},{"kind":"math_inline","text":"sisi + 1... sj"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"String "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a "},{"children":[{"kind":"text","text":"Gray"}],"kind":"container"},{"kind":"text","text":" string, if it meets the conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the length of string "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":" is odd; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" character "},{"attrs":{"alt":"","src":"/statement-assets/d3df10fdff253580c9e4acea874202a1e6bdfea979bcd51e1b4be3574d7e3c08.png"},"kind":"image"},{"kind":"text","text":" occurs exactly once in the string; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" either "},{"kind":"math_inline","text":"|s| = 1"},{"kind":"text","text":", or substrings "},{"attrs":{"alt":"","src":"/statement-assets/02e8ab580ba16651372779fbfb3cf7d45fe1546b8bb78311a53b14b91155d871.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/statement-assets/1667c8174fb56d9d9cb163a4cd968142abeb42c7f9fdb497f3be2e67dd0dfc68.png"},"kind":"image"},{"kind":"text","text":" are the same and are Gray strings. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, strings \""},{"children":[{"kind":"text","text":"abacaba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"xzx"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"g"}],"kind":"container"},{"kind":"text","text":"\" are Gray strings and strings \""},{"children":[{"kind":"text","text":"aaa"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"xz"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abaxcbc"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" of string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is the sum of the squares of the lengths of all substrings of string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" that are Gray strings. In other words, consider all pairs of values "},{"kind":"math_inline","text":"i, j"},{"kind":"math_inline","text":"(1 ≤ i ≤ j ≤ |p|)"},{"kind":"text","text":". If substring "},{"kind":"math_inline","text":"p[i... j]"},{"kind":"text","text":" is a Gray string, you should add "},{"kind":"math_inline","text":"(j - i + 1)2"},{"kind":"text","text":" to the beauty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Xenia has got string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" consisting of lowercase English letters. She is allowed to replace at most one letter of the string by any other English letter. The task is to get a string of maximum beauty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a non-empty string "},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"(1 ≤ |t| ≤ 105)"},{"kind":"text","text":". String "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" only consists of lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the sought maximum beauty value Xenia can get."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"zzz\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"aba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abacaba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"83\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"aaaaaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"15\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test sample the given string can be transformed into string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" = \""},{"children":[{"kind":"text","text":"zbz"}],"kind":"container"},{"kind":"text","text":"\". Such string contains Gray strings as substrings "},{"kind":"math_inline","text":"p[1... 1]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p[2... 2]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p[3... 3]"},{"kind":"text","text":" и "},{"kind":"math_inline","text":"p[1... 3]"},{"kind":"text","text":". In total, the beauty of string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" gets equal to "},{"kind":"math_inline","text":"12 + 12 + 12 + 32 = 12"},{"kind":"text","text":". You can't obtain a more beautiful string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case it is not necessary to perform any operation. The initial string has the maximum possible beauty."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"356E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/356/problem/E"}