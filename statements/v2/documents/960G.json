{"assets":[],"contentKind":"statement","contestId":"960","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Bandit Blues"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Japate, while traveling through the forest of Mala, saw "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" bags of gold lying in a row. Each bag has some "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" weight of gold between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"N"},{"kind":"text","text":". Japate can carry only one bag of gold with him, so he uses the following strategy to choose a bag."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially, he starts with an empty bag (zero weight). He considers the bags in some order. If the current bag has a higher weight than the bag in his hand, he picks the current bag."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Japate put the bags in some order. Japate realizes that he will pick "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" bags, if he starts picking bags from the front, and will pick "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" bags, if he starts picking bags from the back. By picking we mean replacing the bag in his hand with the current one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now he wonders how many permutations of bags are possible, in which he picks "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" bags from the front and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" bags from back using the above strategy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since the answer can be very large, output it modulo "},{"kind":"math_inline","text":"998244353"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of input contains three space separated integers "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ N ≤ 105"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ A, B ≤ N"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the number of valid permutations modulo "},{"kind":"math_inline","text":"998244353"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"22"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In sample case "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", the only possible permutation is "},{"kind":"math_inline","text":"[1]"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In sample cases "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", only two permutations of size "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" are possible:"},{"kind":"math_inline","text":"{[1, 2], [2, 1]}"},{"kind":"text","text":". The values of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" for first permutation is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", and for the second permutation these values are "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In sample case "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", out of 120 permutations of "},{"kind":"math_inline","text":"[1, 2, 3, 4, 5]"},{"kind":"text","text":" possible, only 22 satisfy the given constraints of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"960G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/960/problem/G"}