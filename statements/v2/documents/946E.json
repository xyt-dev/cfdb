{"assets":[],"contentKind":"statement","contestId":"946","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Largest Beautiful Number"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Yes, that's another problem with definition of \"beautiful\" numbers"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a positive integer "},{"kind":"math_inline","text":"x"},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if its decimal representation without leading zeroes contains even number of digits, and there exists a permutation of this representation which is palindromic. For example, "},{"kind":"math_inline","text":"4242"},{"kind":"text","text":" is a beautiful number, since it contains "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" digits, and there exists a palindromic permutation "},{"kind":"math_inline","text":"2442"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a positive integer "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", find the largest beautiful number which is less than "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 105"},{"kind":"text","text":") — the number of testcases you have to solve."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines follow, each representing one testcase and containing one string which is the decimal representation of number "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". It is guaranteed that this string has even length, contains no leading zeroes, and there exists at least one beautiful number less than "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of lengths of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" over all testcases doesn't exceed "},{"kind":"math_inline","text":"2·105"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase print one line containing the largest beautiful number which is less than "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" (it is guaranteed that the answer exists)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n89\n88\n1000\n28923845\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"88\n77\n99\n28923839\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"946E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/946/problem/E"}