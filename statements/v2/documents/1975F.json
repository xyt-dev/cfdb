{"assets":[],"contentKind":"statement","contestId":"1975","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Set"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Define the "},{"children":[{"kind":"text","text":"binary encoding"}],"kind":"container"},{"kind":"text","text":" of a finite set of natural numbers $$$T \\subseteq \\{0,1,2,\\ldots\\}$$$ as $$$f(T) = \\sum\\limits_{i \\in T} 2^i$$$. For example, $$$f(\\{0,2\\}) = 2^0 + 2^2 = 5$$$ and $$$f(\\{\\}) = 0$$$. Notice that $$$f$$$ is a bijection from all such sets to all non-negative integers. As such, $$$f^{-1}$$$ is also defined."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an integer $$$n$$$ along with $$$2^n-1$$$ sets $$$V_1,V_2,\\ldots,V_{2^n-1}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find all sets $$$S$$$ that satisfy the following constraint: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$S \\subseteq \\{0,1,\\ldots,n-1\\}$$$. Note that $$$S$$$ can be "},{"children":[{"kind":"text","text":"empty"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For all "},{"children":[{"kind":"text","text":"non-empty"}],"kind":"container"},{"kind":"text","text":" subsets $$$T \\subseteq \\{0,1,\\ldots,n-1\\}$$$, $$$|S \\cap T| \\in V_{f(T)}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Due to the large input and output, both input and output will be given in terms of binary encodings of the sets."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer $$$n$$$ ($$$1 \\leq n \\leq 20$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of input contains $$$2^n-1$$$ integers $$$v_1,v_2,\\ldots,v_{2^n-1}$$$ ($$$0 \\leq v_i \\lt 2^{n+1}$$$) — the sets $$$V_i$$$ given in their binary encoding where $$$V_i = f^{-1}(v_i)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of output should contain an integer $$$k$$$ indicating the number of possible $$$S$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the following $$$k$$$ lines, you should output $$$f(S)$$$ for all possible $$$S$$$ in "},{"children":[{"kind":"text","text":"increasing order"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n15 15 15 15 15 15 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n3\n5\n6\n7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"ki