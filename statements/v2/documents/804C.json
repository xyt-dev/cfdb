{"assets":[],"contentKind":"statement","contestId":"804","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Ice cream coloring"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Isart and Modsart were trying to solve an interesting problem when suddenly Kasra arrived. Breathless, he asked: \"Can you solve a problem I'm stuck at all day?\""}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We have a tree "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" types of ice cream numerated from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Each vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has a set of "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" types of ice cream. Vertices which have the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ("},{"kind":"math_inline","text":"1 ≤ i ≤ m"},{"kind":"text","text":") type of ice cream form a connected subgraph. We build a new graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" vertices. We put an edge between the "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"-th and the "},{"kind":"math_inline","text":"u"},{"kind":"text","text":"-th ("},{"kind":"math_inline","text":"1 ≤ u, v ≤ m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"u ≠ v"},{"kind":"text","text":") vertices in "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" if and only if there exists a vertex in "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" that has both the "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"-th and the "},{"kind":"math_inline","text":"u"},{"kind":"text","text":"-th types of ice cream in its set. The problem is to paint the vertices of "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" with minimum possible number of colors in a way that no adjacent vertices have the same color."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please note that we consider that empty set of vertices form a connected subgraph in this problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As usual, Modsart don't like to abandon the previous problem, so Isart wants you to solve the new problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 3·105"},{"kind":"text","text":") — the number of vertices in "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" and the number of ice cream types."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contain single integer "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ si ≤ 3·105"},{"kind":"text","text":") and then "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" distinct integers, each between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the types of ice cream in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex. The sum of "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" doesn't exceed "},{"kind":"math_inline","text":"5·105"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines follow. Each of these lines describes an edge of the tree with two integers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ u, v ≤ n"},{"kind":"text","text":") — the indexes of connected by this edge vertices."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print single integer "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" in the first line — the minimum number of colors to paint the vertices in graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of which should be the color of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex. The colors should be between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":". If there are some answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 1\n2 2 3\n1 2\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1 2 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n0\n1 1\n1 3\n3 2 4 5\n2 1\n3 2\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 1 2 3 "}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the first type of ice cream is present in the first vertex only, so we can color it in any color. The second and the third ice cream are both presented in the second vertex, so we should paint them in different colors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the colors of the second, the fourth and the fifth ice cream should obviously be distinct."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"804C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/804/problem/C"}