{"assets":[],"contentKind":"statement","contestId":"2187","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Cool Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"There are two integer constants $$$x$$$ and $$$y$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a binary$$$^{\\text{∗}}$$$ string $$$r$$$ of length $$$n$$$, we define its "},{"children":[{"kind":"text","text":"generating array"}],"kind":"container"},{"kind":"text","text":" as an array $$$c=[c_0,c_1,\\ldots,c_n]$$$ such that $$$c_0=0$$$, and for each $$$1 \\le i \\le n$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If $$$r_i=\\mathtt{0}$$$, then $$$c_i=x+c_{i-1}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If $$$r_i=\\mathtt{1}$$$, then $$$c_i=y-c_{i-1}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Additionally, we define $$$f(r)=\\sum\\limits_{i=1}^n c_i$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an incomplete binary string $$$s$$$ of length $$$n$$$, where some characters in it are missing, represented by $$$\\mathtt{?}$$$. An integer $$$k$$$ is called "},{"children":[{"kind":"text","text":"cool"}],"kind":"container"},{"kind":"text","text":" if and only if there exists a way to replace each $$$\\mathtt{?}$$$ in $$$s$$$ with either $$$\\mathtt{0}$$$ or $$$\\mathtt{1}$$$, such that $$$f(s)=k$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to calculate the sum of all "},{"children":[{"kind":"text","text":"cool"}],"kind":"container"},{"kind":"text","text":" integers, modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$A binary string is a string where each character is either $$$\\mathtt{0}$$$ or $$$\\mathtt{1}$$$."}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains three integers $$$n$$$, $$$x$$$, and $$$y$$$ ($$$1 \\le n \\le 10^5$$$, $$$1 \\le x,y \\le 10^6$$$) — the length of $$$s$$$ and the given constants."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the incomplete binary string $$$s$$$ of length $$$n$$$ ($$$s_i \\in \\{\\mathtt{0}, \\mathtt{1}, \\mathtt{?}\\}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$10^5$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the sum of all "},{"children":[{"kind":"text","text":"cool"}],"kind":"container"},{"kind":"text","text":" integers modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 1 2\n0\n1 1 2\n?\n3 7 5\n?0?\n7 114514 191981\n?1?????\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n3\n100\n8039591\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the string $$$s$$$ has already been determined, and its "},{"children":[{"kind":"text","text":"generating array"}],"kind":"container"},{"kind":"text","text":" is $$$[0, 1]$$$. Thus, $$$f(s)=1$$$, and the only "},{"children":[{"kind":"text","text":"cool"}],"kind":"container"},{"kind":"text","text":" integer is $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, there are four ways to complete the string $$$s$$$:"}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$s$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"Generating array"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$f(s)$$$"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\mathtt{000}$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$[0, 7, 14, 21]$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$42$$$"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\mathtt{001}$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$[0, 7, 14, -9]$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$12$$$"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\mathtt{100}$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$[0, 5, 12, 19]$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$36$$$"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\mathtt{101}$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$[0, 5, 12, -7]$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$10$$$"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"}],"kind":"container"},{"children":[{"kind":"text","text":"Thus, the sum of all "},{"children":[{"kind":"text","text":"cool"}],"kind":"container"},{"kind":"text","text":" integers is $$$42+12+36+10=100$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"2187D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2187/problem/D"}