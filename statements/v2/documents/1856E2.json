{"assets":["/statement-assets/45b8ba13a1ad5075ddf161a4f3241c8bba720252c80e1ffa0f212b804d60bfff.png","/statement-assets/4ce06f2b9f8accdcb6901c5fbee92f2a11f1a5a942d6450006b4ac9c2ce00691.png","/statement-assets/e53d445c62bfdbc8e9e95e0f3e0989ed1368c440953418f36914281a4ae2688c.png"],"contentKind":"statement","contestId":"1856","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E2. PermuTree (hard version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is the hard version of the problem. The differences between the two versions are the constraint on $$$n$$$ and the time limit. You can make hacks only if both versions of the problem are solved."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a tree with $$$n$$$ vertices rooted at vertex $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For some permutation$$$^\\dagger$$$ $$$a$$$ of length $$$n$$$, let $$$f(a)$$$ be the number of pairs of vertices $$$(u, v)$$$ such that $$$a_u \\lt a_{\\operatorname{lca}(u, v)} \\lt a_v$$$. Here, $$$\\operatorname{lca}(u,v)$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Lowest_common_ancestor"},"children":[{"kind":"text","text":"lowest common ancestor"}],"kind":"link"},{"kind":"text","text":" of vertices $$$u$$$ and $$$v$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the maximum possible value of $$$f(a)$$$ over all permutations $$$a$$$ of length $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$^\\dagger$$$ A permutation of length $$$n$$$ is an array consisting of $$$n$$$ distinct integers from $$$1$$$ to $$$n$$$ in arbitrary order. For example, $$$[2,3,1,5,4]$$$ is a permutation, but $$$[1,2,2]$$$ is not a permutation ($$$2$$$ appears twice in the array), and $$$[1,3,4]$$$ is also not a permutation ($$$n=3$$$ but there is $$$4$$$ in the array)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$2 \\le n \\le 10^6$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n - 1$$$ integers $$$p_2,p_3,\\ldots,p_n$$$ ($$$1 \\le p_i \\lt i$$$) indicating that there is an edge between vertices $$$i$$$ and $$$p_i$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the maximum value of $$$f(a)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 1 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 2 2 1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The tree in the first test: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/45b8ba13a1ad5075ddf161a4f3241c8bba720252c80e1ffa0f212b804d60bfff.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"One possible optimal permutation $$$a$$$ is $$$[2, 1, 4, 5, 3]$$$ with $$$4$$$ suitable pairs of vertices: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$(2, 3)$$$, since $$$\\operatorname{lca}(2, 3) = 1$$$ and $$$1 \\lt 2 \\lt 4$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(2, 4)$$$, since $$$\\operatorname{lca}(2, 4) = 1$$$ and $$$1 \\lt 2 \\lt 5$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(2, 5)$$$, since $$$\\operatorname{lca}(2, 5) = 1$$$ and $$$1 \\lt 2 \\lt 3$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(5, 4)$$$, since $$$\\operatorname{lca}(5, 4) = 3$$$ and $$$3 \\lt 4 \\lt 5$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The tree in the third test: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/4ce06f2b9f8accdcb6901c5fbee92f2a11f1a5a942d6450006b4ac9c2ce00691.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The tree in the fourth test: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e53d445c62bfdbc8e9e95e0f3e0989ed1368c440953418f36914281a4ae2688c.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E2","problemCode":"1856E2","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1856/problem/E2"}