{"assets":[],"contentKind":"statement","contestId":"545","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Woodcutters"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Susie listens to fairy tales before bed every day. Today's fairy tale was about wood cutters and the little girl immediately started imagining the choppers cutting wood. She imagined the situation that is described below."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" trees located along the road at points with coordinates "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":". Each tree has its height "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":". Woodcutters can cut down a tree and fell it to the left or to the right. After that it occupies one of the segments "},{"kind":"math_inline","text":"[xi - hi, xi]"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"[xi;xi + hi]"},{"kind":"text","text":". The tree that is not cut down occupies a single point with coordinate "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". Woodcutters can fell a tree if the segment to be occupied by the fallen tree doesn't contain any occupied point. The woodcutters want to process as many trees as possible, so Susie wonders, what is the maximum number of trees to fell. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of trees."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain pairs of integers "},{"kind":"math_inline","text":"xi, hi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, hi ≤ 109"},{"kind":"text","text":") — the coordinate and the height of the "},{"kind":"math_inline","text":"і"},{"kind":"text","text":"-th tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The pairs are given in the order of ascending "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". No two trees are located at the point with the same coordinate."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the maximum number of trees that you can cut down by the given rules."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2\n2 1\n5 10\n10 9\n19 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2\n2 1\n5 10\n10 9\n20 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample you can fell the trees like that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" fell the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st tree to the left — now it occupies segment "},{"kind":"math_inline","text":"[ - 1;1]"}],"kind":"list_item"},{"children":[{"kind":"text","text":" fell the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd tree to the right — now it occupies segment "},{"kind":"math_inline","text":"[2;3]"}],"kind":"list_item"},{"children":[{"kind":"text","text":" leave the "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-rd tree — it occupies point "},{"kind":"math_inline","text":"5"}],"kind":"list_item"},{"children":[{"kind":"text","text":" leave the "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"-th tree — it occupies point "},{"kind":"math_inline","text":"10"}],"kind":"list_item"},{"children":[{"kind":"text","text":" fell the "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"-th tree to the right — now it occupies segment "},{"kind":"math_inline","text":"[19;20]"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second sample you can also fell "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"-th tree to the right, after that it will occupy segment "},{"kind":"math_inline","text":"[10;19]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document