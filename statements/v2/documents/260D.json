{"assets":[],"contentKind":"statement","contestId":"260","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Black and White Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The board has got a painted tree graph, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes. Let us remind you that a non-directed graph is called a tree if it is connected and doesn't contain any cycles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each node of the graph is painted black or white in such a manner that there aren't two nodes of the same color, connected by an edge. Each edge contains its value written on it as a non-negative integer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A bad boy Vasya came up to the board and wrote number "},{"kind":"math_inline","text":"sv"},{"kind":"text","text":" near each node "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" — the sum of values of all edges that are incident to this node. Then Vasya removed the edges and their values from the board."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to restore the original tree by the node colors and numbers "},{"kind":"math_inline","text":"sv"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":") — the number of nodes in the tree. Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain pairs of space-separated integers "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":", "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ci ≤ 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ si ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" stands for the color of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex (0 is for white, 1 is for black), and "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" represents the sum of values of the edges that are incident to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex of the tree that is painted on the board."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the description of "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" edges of the tree graph. Each description is a group of three integers "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":", "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ vi, ui ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi ≠ ui"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ wi ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" — are the numbers of the nodes that are connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge, and "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" is its value. Note that the following condition must fulfill "},{"kind":"math_inline","text":"cvi ≠ cui"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that for any input data there exists at least one graph that meets these data. If there are multiple solutions, print any of them. You are allowed to print the edges in any order. As you print the numbers, separate them with spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 3\n1 2\n0 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 1 3\n3 2 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 0\n0 3\n1 8\n0 2\n0 3\n0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 3 3\n5 3 3\n4 3 2\n1 6 0\n2 1 0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"260D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/260/problem/D"}