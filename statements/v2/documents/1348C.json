{"assets":[],"contentKind":"statement","contestId":"1348","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Phoenix and Distribution"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Phoenix has a string $$$s$$$ consisting of lowercase Latin letters. He wants to distribute all the letters of his string into $$$k$$$ "},{"children":[{"kind":"text","text":"non-empty"}],"kind":"container"},{"kind":"text","text":" strings $$$a_1, a_2, \\dots, a_k$$$ such that every letter of $$$s$$$ goes to exactly one of the strings $$$a_i$$$. The strings $$$a_i$$$ "},{"children":[{"kind":"text","text":"do not"}],"kind":"container"},{"kind":"text","text":" need to be substrings of $$$s$$$. Phoenix can distribute letters of $$$s$$$ and rearrange the letters within each string $$$a_i$$$ however he wants."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if $$$s = $$$ "},{"children":[{"kind":"text","text":"baba"}],"kind":"container"},{"kind":"text","text":" and $$$k=2$$$, Phoenix may distribute the letters of his string in many ways, such as: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"ba"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"abb"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"ab"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"bb"}],"kind":"container"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"But these ways are invalid: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"baa"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"ba"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"ba"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"baba"}],"kind":"container"},{"kind":"text","text":" and empty string ($$$a_i$$$ should be non-empty) "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Phoenix wants to distribute the letters of his string $$$s$$$ into $$$k$$$ strings $$$a_1, a_2, \\dots, a_k$$$ to "},{"children":[{"kind":"text","text":"minimize"}],"kind":"container"},{"kind":"text","text":" the lexicographically maximum string among them, i. e. minimize $$$max(a_1, a_2, \\dots, a_k)$$$. Help him find the optimal distribution and print the minimal possible value of $$$max(a_1, a_2, \\dots, a_k)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"String $$$x$$$ is lexicographically less than string $$$y$$$ if either $$$x$$$ is a prefix of $$$y$$$ and $$$x \\ne y$$$, or there exists an index $$$i$$$ ($$$1 \\le i \\le min(|x|, |y|))$$$ such that $$$x_i$$$ < $$$y_i$$$ and for every $$$j$$$ $$$(1 \\le j \\lt i)$$$ $$$x_j = y_j$$$. Here $$$|x|$$$ denotes the length of the string $$$x$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of multiple test cases. The first line contains an integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases. Each test case consists of two lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case consists of two integers $$$n$$$ and $$$k$$$ ($$$1 \\le k \\le n \\le 10^5$$$) — the length of string $$$s$$$ and the number of non-empty strings, into which Phoenix wants to distribute letters of $$$s$$$, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$s$$$ of length $$$n$$$ consisting only of lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases is $$$\\le 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$t$$$ answers — one per test case. The $$$i$$$-th answer should be the minimal possible value of $$$max(a_1, a_2, \\dots, a_k)$$$ in the $$$i$$$-th test case."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n4 2\nbaba\n5 2\nbaacb\n5 3\nbaacb\n5 3\naaaaa\n6 4\naaxxzz\n7 1\nphoenix\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nab\nabbc\nb\naa\nx\nehinopx\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, one optimal solution is to distribute "},{"children":[{"kind":"text","text":"baba"}],"kind":"container"},{"kind":"text","text":" into "},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, one optimal solution is to distribute "},{"children":[{"kind":"text","text":"baacb"}],"kind":"container"},{"kind":"text","text":" into "},{"children":[{"kind":"text","text":"abbc"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, one optimal solution is to distribute "},{"children":[{"kind":"text","text":"baacb"}],"kind":"container"},{"kind":"text","text":" into "},{"children":[{"kind":"text","text":"ac"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, one optimal solution is to distribute "},{"children":[{"kind":"text","text":"aaaaa"}],"kind":"container"},{"kind":"text","text":" into "},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth test case, one optimal solution is to distribute "},{"children":[{"kind":"text","text":"aaxxzz"}],"kind":"container"},{"kind":"text","text":" into "},{"children":[{"kind":"text","text":"az"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"az"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the sixth test case, one optimal solution is to distribute "},{"children":[{"kind":"text","text":"phoenix"}],"kind":"container"},{"kind":"text","text":" into "},{"children":[{"kind":"text","text":"ehinopx"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1348C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1348/problem/C"}