{"assets":["/statement-assets/1d37458ac5b0bd5e13540f97900a75a2f16670f5dc79486b4b0c6d608189c03e.png"],"contentKind":"statement","contestId":"2002","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Distanced Coloring"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You received an $$$n\\times m$$$ grid from a mysterious source. The source also gave you a magic positive integer constant $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The source told you to color the grid with some colors, satisfying the following condition:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If $$$(x_1,y_1)$$$, $$$(x_2,y_2)$$$ are two distinct cells with the same color, then $$$\\max(|x_1-x_2|,|y_1-y_2|)\\ge k$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You don't like using too many colors. Please find the minimum number of colors needed to color the grid."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1\\le t\\le1000$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case consists of three positive integers $$$n$$$, $$$m$$$, $$$k$$$ ($$$1\\le n,m,k\\le10^4$$$) — the dimensions of the grid and the magic constant."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single integer — the minimum number of colors needed to color the grid."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n3 3 2\n5 1 10000\n7 3 4\n3 2 7\n8 9 6\n2 5 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n5\n12\n6\n36\n8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, one of the optimal constructions is:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1d37458ac5b0bd5e13540f97900a75a2f16670f5dc79486b4b0c6d608189c03e.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second test case, the color of all cells must be pairwise different, so the answer is $$$5$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2002A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2002/problem/A"}