{"assets":[],"contentKind":"statement","contestId":"883","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"I. Photo Processing"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Evlampiy has found one more cool application to process photos. However the application has certain limitations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each photo "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has a contrast "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":". In order for the processing to be truly of high quality, the application must receive at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" photos with contrasts which differ as little as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Evlampiy already knows the contrast "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" for each of his "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" photos. Now he wants to split the photos into groups, so that each group contains at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" photos. As a result, each photo must belong to exactly one group."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He considers a processing time of the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th group to be the difference between the maximum and minimum values of "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" in the group. Because of multithreading the processing time of a division into groups is the maximum processing time among all groups."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Split "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" photos into groups in a such way that the processing time of the division is the minimum possible, i.e. that the the maximum processing time over all groups as least as possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 3·105"},{"kind":"text","text":") — number of photos and minimum size of a group."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"v1, v2, ..., vn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ vi ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" is the contrast of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th photo."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimal processing time of the division into groups."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n50 110 130 40 120\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n2 3 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the photos should be split into 2 groups: "},{"kind":"math_inline","text":"[40, 50]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"[110, 120, 130]"},{"kind":"text","text":". The processing time of the first group is "},{"kind":"math_inline","text":"10"},{"kind":"text","text":", and the processing time of the second group is "},{"kind":"math_inline","text":"20"},{"kind":"text","text":". Maximum among "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"20"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"20"},{"kind":"text","text":". It is impossible to split the photos into groups in a such way that the processing time of division is less than "},{"kind":"math_inline","text":"20"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the photos should be split into four groups, each containing one photo. So the minimal possible processing time of a division is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"I","problemCode":"883I","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/883/problem/I"}