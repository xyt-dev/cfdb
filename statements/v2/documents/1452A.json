{"assets":[],"contentKind":"statement","contestId":"1452","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Robot Program"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is an infinite 2-dimensional grid. The robot stands in cell $$$(0, 0)$$$ and wants to reach cell $$$(x, y)$$$. Here is a list of possible commands the robot can execute:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" move north from cell $$$(i, j)$$$ to $$$(i, j + 1)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" move east from cell $$$(i, j)$$$ to $$$(i + 1, j)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" move south from cell $$$(i, j)$$$ to $$$(i, j - 1)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" move west from cell $$$(i, j)$$$ to $$$(i - 1, j)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" stay in cell $$$(i, j)$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The robot wants to reach cell $$$(x, y)$$$ in as few commands as possible. However, he can't execute the same command two or more times in a row."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of commands required to reach $$$(x, y)$$$ from $$$(0, 0)$$$?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 100$$$) — the number of testcases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$t$$$ lines contains two integers $$$x$$$ and $$$y$$$ ($$$0 \\le x, y \\le 10^4$$$) — the destination coordinates of the robot."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase print a single integer — the minimum number of commands required for the robot to reach $$$(x, y)$$$ from $$$(0, 0)$$$ if no command is allowed to be executed two or more times in a row."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n5 5\n3 4\n7 1\n0 0\n2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n7\n13\n0\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The explanations for the example test:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We use characters "},{"children":[{"kind":"text","text":"N"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"E"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" to denote going north, going east, going south, going west and staying in the current cell, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first test case, the robot can use the following sequence: "},{"children":[{"kind":"text","text":"NENENENENE"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the robot can use the following sequence: "},{"children":[{"kind":"text","text":"NENENEN"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, the robot can use the following sequence: "},{"children":[{"kind":"text","text":"ESENENE0ENESE"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, the robot doesn't need to go anywhere at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth test case, the robot can use the following sequence: "},{"children":[{"kind":"text","text":"E0E"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1452A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1452/problem/A"}