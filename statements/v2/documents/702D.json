{"assets":[],"contentKind":"statement","contestId":"702","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Road to Post Office"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasiliy has a car and he wants to get from home to the post office. The distance which he needs to pass equals to "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" kilometers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasiliy's car is not new — it breaks after driven every "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" kilometers and Vasiliy needs "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" seconds to repair it. After repairing his car Vasiliy can drive again (but after "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" kilometers it will break again, and so on). In the beginning of the trip the car is just from repair station."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To drive one kilometer on car Vasiliy spends "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" seconds, to walk one kilometer on foot he needs "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" seconds ("},{"kind":"math_inline","text":"a < b"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find minimal time after which Vasiliy will be able to reach the post office. Consider that in every moment of time Vasiliy can left his car and start to go on foot."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains 5 positive integers "},{"kind":"math_inline","text":"d, k, a, b, t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ d ≤ 1012"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"1 ≤ k, a, b, t ≤ 106"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"a < b"},{"kind":"text","text":"), where:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"d"},{"kind":"text","text":" — the distance from home to the post office; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the distance, which car is able to drive before breaking; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"a"},{"kind":"text","text":" — the time, which Vasiliy spends to drive 1 kilometer on his car; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"b"},{"kind":"text","text":" — the time, which Vasiliy spends to walk 1 kilometer on foot; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"t"},{"kind":"text","text":" — the time, which Vasiliy spends to repair his car. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimal time after which Vasiliy will be able to reach the post office."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 1 4 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 1 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Vasiliy needs to drive the first 2 kilometers on the car (in 2 seconds) and then to walk on foot 3 kilometers (in 12 seconds). So the answer equals to 14 seconds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example Vasiliy needs to drive the first 2 kilometers on the car (in 2 seconds), then repair his car (in 5 seconds) and drive 2 kilometers more on the car (in 2 seconds). After that he needs to walk on foot 1 kilometer (in 4 seconds). So the answer equals to 13 seconds."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"702D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/702/problem/D"}