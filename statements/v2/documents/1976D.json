{"assets":[],"contentKind":"statement","contestId":"1976","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Invertible Bracket Sequences"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A regular bracket sequence is a bracket sequence that can be transformed into a correct arithmetic expression by inserting characters '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' between the original characters of the sequence. For example:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" bracket sequences \""},{"children":[{"kind":"text","text":"()()"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(())"}],"kind":"container"},{"kind":"text","text":"\" are regular (the resulting expressions are: \""},{"children":[{"kind":"text","text":"(1)+(1)"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"((1+1)+1)"}],"kind":"container"},{"kind":"text","text":"\"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" bracket sequences \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\" are not. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let's define the "},{"children":[{"kind":"text","text":"inverse"}],"kind":"container"},{"kind":"text","text":" of the bracket sequence as follows: replace all brackets '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' with '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"', and vice versa (all brackets '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"' with '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"'). For example, strings \""},{"children":[{"kind":"text","text":"()(("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")())"}],"kind":"container"},{"kind":"text","text":"\" are inverses of each other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a regular bracket sequence $$$s$$$. Calculate the number of pairs of integers $$$(l,r)$$$ ($$$1 \\le l \\le r \\le |s|$$$) such that if you replace the substring of $$$s$$$ from the $$$l$$$-th character to the $$$r$$$-th character (inclusive) with its inverse, $$$s$$$ will still be a regular bracket sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a non-empty regular bracket sequence; it consists only of characters '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' and/or '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraint on 