{"assets":["/statement-assets/aa0a7e75af4aaf3562b33969a7fefb5894e89ab0c3a6632ddd7bf1a33f298f48.png"],"contentKind":"statement","contestId":"1015","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E1. Stars Drawing (Easy Edition)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"star"}],"kind":"container"},{"kind":"text","text":" is a figure of the following type: an asterisk character '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"' in the center of the figure and four rays (to the left, right, top, bottom) of the same positive length. The size of a "},{"children":[{"kind":"text","text":"star"}],"kind":"container"},{"kind":"text","text":" is the length of its rays. The size of a star must be a positive number (i.e. rays of length $$$0$$$ are not allowed)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's consider empty cells are denoted by '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"', then the following figures are "},{"children":[{"kind":"text","text":"stars"}],"kind":"container"},{"kind":"text","text":":"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/aa0a7e75af4aaf3562b33969a7fefb5894e89ab0c3a6632ddd7bf1a33f298f48.png"},"kind":"image"},{"children":[{"kind":"text","text":"The leftmost figure is a "},{"children":[{"kind":"text","text":"star"}],"kind":"container"},{"kind":"text","text":" of size $$$1$$$, the middle figure is a "},{"children":[{"kind":"text","text":"star"}],"kind":"container"},{"kind":"text","text":" of size $$$2$$$ and the rightmost figure is a "},{"children":[{"kind":"text","text":"star"}],"kind":"container"},{"kind":"text","text":" of size $$$3$$$."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"You are given a rectangular grid of size $$$n \\times m$$$ consisting only of asterisks '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"' and periods (dots) '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"'. Rows are numbered from $$$1$$$ to $$$n$$$, columns are numbered from $$$1$$$ to $$$m$$$. Your task is to draw this grid using "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" number of "},{"children":[{"kind":"text","text":"stars"}],"kind":"container"},{"kind":"text","text":" or find out that it is impossible. "},{"children":[{"kind":"text","text":"Stars"}],"kind":"container"},{"kind":"text","text":" can intersect, overlap or even coincide with each other. The number of "},{"children":[{"kind":"text","text":"stars"}],"kind":"container"},{"kind":"text","text":" in the output can't exceed $$$n \\cdot m$$$. Each star should be completely inside the grid. You can use stars of same and arbitrary sizes."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"In this problem, you do not need to minimize the number of stars. Just find any way to draw the given grid with at most $$$n \\cdot m$$$ stars."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers $$$n$$$ and $$$m$$$ ($$$3 \\le n, m \\le 100$$$) — the sizes of the given grid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n$$$ lines contains $$$m$$$ characters each, the $$$i$$$-th line describes the $$$i$$$-th row of the grid. It is guaranteed that grid consists of characters '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' only."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is impossible to draw the given grid using "},{"children":[{"kind":"text","text":"stars"}],"kind":"container"},{"kind":"text","text":" only, print \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise in the first line print one integer $$$k$$$ ($$$0 \\le k \\le n \\cdot m$$$) — the number of "},{"children":[{"kind":"text","text":"stars"}],"kind":"container"},{"kind":"text","text":" needed to draw the given grid. The next $$$k$$$ lines should contain three integers each — $$$x_j$$$, $$$y_j$$$ and $$$s_j$$$, where $$$x_j$$$ is the row index of the central "},{"children":[{"kind":"text","text":"star"}],"kind":"container"},{"kind":"text","text":" character, $$$y_j$$$ is the column index of the central "},{"children":[{"kind":"text","text":"star"}],"kind":"container"},{"kind":"text","text":" character and $$$s_j$$$ is the size of the "},{"children":[{"kind":"text","text":"star"}],"kind":"container"},{"kind":"text","text":". Each "},{"children":[{"kind":"text","text":"star"}],"kind":"container"},{"kind":"text","text":" should be completely inside the grid."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 8\n....*...\n...**...\n..*****.\n...**...\n....*...\n........\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 4 1\n3 5 2\n3 5 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n.*...\n****.\n.****\n..**.\n.....\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 2 1\n3 3 1\n3 4 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n.*...\n***..\n.*...\n.*...\n.....\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n*.*\n.*.\n*.*\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the output "}],"kind":"paragraph"},{"kind":"code_block","text":"2\n3 4 1\n3 5 2\n"},{"children":[{"kind":"text","text":"is also correct."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E1","problemCode":"1015E1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1015/problem/E1"}