{"assets":[],"contentKind":"statement","contestId":"1810","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Last Number"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a multiset $$$S$$$. Initially, $$$S = \\{1,2,3, \\ldots, n\\}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You will perform the following operation $$$n-1$$$ times."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose the largest number $$$S_{\\text{max}}$$$ in $$$S$$$ and the smallest number $$$S_{\\text{min}}$$$ in $$$S$$$. Remove the two numbers from $$$S$$$, and add $$$S_{\\text{max}} - S_{\\text{min}}$$$ into $$$S$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It's easy to show that there will be exactly one number left after $$$n-1$$$ operations. Output that number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^5$$$) — the number of test cases. Their description follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each test case, one single line contains a single integer $$$n$$$ ($$$2 \\le n \\le 10^9$$$) — the initial size of the multiset $$$S$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output an integer denoting the only number left after $$$n-1$$$ operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n2\n4\n7\n15\n177567\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n2\n4\n33914\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"We show how the multiset $$$S$$$ changes for $$$n=4$$$."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Operation $$$1$$$: $$$S=\\{1,2,3,4\\}$$$, remove $$$4$$$, $$$1$$$, add $$$3$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" Operation $$$2$$$: $$$S=\\{2,3,3\\}$$$, remove $$$3$$$, $$$2$$$, add $$$1$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" Operation $$$3$$$: $$$S=\\{1,3\\}$$$, remove $$$3$$$, $$$1$$$, add $$$2$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" Final: $$$S = \\{2\\}$$$."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Thus, the answer for $$$n = 4$$$ is $$$2$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"1810H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1810/problem/H"}