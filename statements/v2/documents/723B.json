{"assets":[],"contentKind":"statement","contestId":"723","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Text Document Analysis"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Modern text editors usually show some information regarding the document being edited. For example, the number of words, the number of pages, or the number of characters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem you should implement the similar functionality."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string which only consists of:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" uppercase and lowercase English letters, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" underscore symbols (they are used as separators), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" parentheses (both opening and closing). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is guaranteed that each opening parenthesis has a succeeding closing parenthesis. Similarly, each closing parentheses has a preceding opening parentheses matching it. For each pair of matching parentheses there are no other parenthesis between them. In other words, each parenthesis in the string belongs to a matching \"opening-closing\" pair, and such pairs can't be nested."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the following 