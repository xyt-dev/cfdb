{"assets":[],"contentKind":"statement","contestId":"1916","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H1. Matrix Rank (Easy Version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is the easy version of the problem. The only differences between the two versions of this problem are the constraints on $$$k$$$. You can make hacks only if all versions of the problem are solved."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given integers $$$n$$$, $$$p$$$ and $$$k$$$. $$$p$$$ is guaranteed to be a prime number. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each $$$r$$$ from $$$0$$$ to $$$k$$$, find the number of $$$n \\times n$$$ matrices $$$A$$$ of the field$$$^\\dagger$$$ of integers modulo $$$p$$$ such that the rank$$$^\\ddagger$$$ of $$$A$$$ is exactly $$$r$$$. Since these values are big, you are only required to output them modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$^\\dagger$$$ "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Field_(mathematics)"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Field_(mathematics)"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$^\\ddagger$$$ "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Rank_(linear_algebra)"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Rank_(linear_algebra)"}],"kind":"link"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains three integers $$$n$$$, $$$p$$$ and $$$k$$$ ($$$1 \\leq n \\leq 10^{18}$$$, $$$2 \\leq p \\lt 998\\,244\\,353$$$, $$$0 \\leq k \\leq 5000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that $$$p$$$ is a prime number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output $$$k+1$$$ integers, the answers for each $$$r$$$ from $$$0$$$ to $$$k$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 49 294 168 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1 51549919 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 51549918 0 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"H1","problemCode":"1916H1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1916/problem/H1"}