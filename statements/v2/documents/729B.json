{"assets":[],"contentKind":"statement","contestId":"729","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Spotlights"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Theater stage is a rectangular field of size "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":". The director gave you the stage's plan which actors will follow. For each cell it is stated in the plan if there would be an actor in this cell or not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are to place a spotlight on the stage in some "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" position. The spotlight will project light in one of the four directions (if you look at the stage from above) — left, right, up or down. Thus, the spotlight's position is a cell it is placed to and a direction it shines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A position is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if two conditions hold: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" there is no actor in the cell the spotlight is placed to; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" there is at least one actor in the direction the spotlight projects. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Count the number of "},{"children":[{"kind":"text","text":"good"}],"k