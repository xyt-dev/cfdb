{"assets":[],"contentKind":"statement","contestId":"75","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Facetook Priority Wall"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Facetook is a well known social network website, and it will launch a new feature called Facetook Priority Wall. This feature will sort all posts from your friends according to the priority factor (it will be described)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This priority factor will be affected by three types of actions: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" 1. \""},{"children":[{"kind":"math_inline","text":"X"},{"kind":"text","text":" posted on "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":"'s wall"}],"kind":"container"},{"kind":"text","text":"\" (15 points), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 2. \""},{"children":[{"kind":"math_inline","text":"X"},{"kind":"text","text":" commented on "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":"'s post"}],"kind":"container"},{"kind":"text","text":"\" (10 points), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 3. \""},{"children":[{"kind":"math_inline","text":"X"},{"kind":"text","text":" likes "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":"'s post"}],"kind":"container"},{"kind":"text","text":"\" (5 points). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"math_inline","text":"X"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" will be two distinct names. And each action will increase the priority factor between "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" (and vice versa) by the above value of points (the priority factor between "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" is the same as the priority factor between "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"X"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You will be given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" actions with the above format (without the action number and the number of points), and you have to print all the distinct names in these actions sorted according to the priority factor with you."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains your name. The second line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", which is the number of actions ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":"). Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, it is guaranteed that each one contains exactly 1 action in the format given above. There is exactly one space between each two words in a line, and there are no extra spaces. All the letters are lowercase. All names in the input will consist of at least 1 letter and at most 10 small Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines, where "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is the number of distinct names in the input (excluding yourself). Each line should contain just 1 name. The names should be sorted according to the priority factor with you in the descending order (the highest priority factor should come first). If two or more names have the same priority factor, print them in the alphabetical (lexicographical) order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note, that you should output all the names that are present in the input data (excluding yourself), even if that person has a zero priority factor."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The lexicographical comparison is performed by the standard \""},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":"\" operator in modern programming languages. The line "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is lexicographically smaller than the line "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", if either "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is the prefix of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", or if exists such an "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ min(|a|, |b|)"},{"kind":"text","text":"), that "},{"kind":"math_inline","text":"ai < bi"},{"kind":"text","text":", and for any "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j < i"},{"kind":"text","text":") "},{"kind":"math_inline","text":"aj = bj"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"|a|"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"|b|"},{"kind":"text","text":" stand for the lengths of strings "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" correspondently."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ahmed\n3\nahmed posted on fatma's wall\nfatma commented on ahmed's post\nmona likes ahmed's post\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"fatma\nmona\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"aba\n1\nlikes likes posted's post\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"likes\nposted\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"75B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/75/problem/B"}