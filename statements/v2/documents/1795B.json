{"assets":[],"contentKind":"statement","contestId":"1795","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Ideal Point"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given $$$n$$$ one-dimensional segments (each segment is denoted by two integers — its endpoints)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define the function $$$f(x)$$$ as the number of segments covering point $$$x$$$ (a segment covers the point $$$x$$$ if $$$l \\le x \\le r$$$, where $$$l$$$ is the left endpoint and $$$r$$$ is the right endpoint of the segment)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An integer point $$$x$$$ is called "},{"children":[{"kind":"text","text":"ideal"}],"kind":"container"},{"kind":"text","text":" if it belongs to more segments than any other integer point, i. e. $$$f(y) \\lt f(x)$$$ is true for any other integer point $$$y$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an integer $$$k$$$. Your task is to determine whether it is possible to remove some (possibly zero) segments, so that the given point $$$k$$$ becomes "},{"children":[{"kind":"text","text":"ideal"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\le n, k \\le 50$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$n$$$ lines follow, $$$i$$$-th line of them contains two integers $$$l_i$$$ and $$$r_i$$$ ($$$1 \\le l_i, r_i \\le 50$$$; $$$l_i \\le r_i$$$) — the endpoints of the $$$i$$$-th segment."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" if it is possible to remove some (possibly zero) segments, so that the given point $$$k$$$ becomes "},{"children":[{"kind":"text","text":"ideal"}],"kind":"container"},{"kind":"text","text":", otherwise print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may print each letter in any case ("},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" will all be recognized as positive answer, "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"no"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"nO"}],"kind":"container"},{"kind":"text","text":" will all be recognized as negative answer)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n4 3\n1 3\n7 9\n2 5\n3 6\n2 9\n1 4\n3 7\n1 3\n2 4\n3 5\n1 4\n6 7\n5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the point $$$3$$$ is already ideal (it is covered by three segments), so you don't have to delete anything."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example, you can delete everything except the segment $$$[5, 5]$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1795B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1795/problem/B"}