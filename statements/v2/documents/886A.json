{"assets":[],"contentKind":"statement","contestId":"886","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. ACM ICPC"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In a small but very proud high school it was decided to win ACM ICPC. This goal requires to compose as many teams of three as possible, but since there were only "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" students who wished to participate, the decision was to build exactly two teams."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After practice competition, participant number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" got a "},{"children":[{"kind":"text","text":"score"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"Team score"}],"kind":"container"},{"kind":"text","text":" is defined as sum of scores of its participants. High school management is interested if it's possible to build two teams with equal scores. Your task is to answer that question."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains six integers "},{"kind":"math_inline","text":"a1, ..., a6"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 1000"},{"kind":"text","text":") — scores of the participants"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (quotes for clarity), if it is possible to build teams with equal score, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print each character either upper- or lowercase (\""},{"children":[{"kind":"text","text":"YeS"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\" are valid when the answer is \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 3 2 1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 1 1 1 99\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, first team can be composed of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"st, "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"nd and "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"th participant, second — of "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"rd, "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"th and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"th: team scores are "},{"kind":"math_inline","text":"1 + 3 + 1 = 2 + 1 + 2 = 5"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, score of participant number "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" is too high: his team score will be definitely greater."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"886A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/886/problem/A"}