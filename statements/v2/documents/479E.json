{"assets":[],"contentKind":"statement","contestId":"479","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Riding in a Lift"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Imagine that you are in a building that has exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" floors. You can move between the floors in a lift. Let's number the floors from bottom to top with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Now you're on the floor number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". You are very bored, so you want to take the lift. Floor number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" has a secret lab, the entry is forbidden. However, you already are in the mood and decide to make "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" consecutive trips in the lift."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us suppose that at the moment you are on the floor number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" (initially, you were on floor "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"). For another trip between floors you choose some floor with number "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"y ≠ x"},{"kind":"text","text":") and the lift travels to this floor. As you cannot visit floor "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" with the secret lab, you decided that the distance from the current floor "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to the chosen "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" must be strictly less than the distance from the current floor "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to floor "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" with the secret lab. Formally, it means that the following inequation must fulfill: "},{"kind":"math_inline","text":"|x - y| < |x - b|"},{"kind":"text","text":". After the lift successfully transports you to floor "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", you write down number "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" in your notepad."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the number of distinct number sequences that you could have written in the notebook as the result of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" trips in the lift. As the sought number of trips can be rather large, find the remainder after dividing the number by "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains four space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 5000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 5000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ a, b ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a ≠ b"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the remainder after dividing the sought number of sequences by "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Two sequences "},{"kind":"math_inline","text":"p1, p2, ..., pk"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q1, q2, ..., qk"},{"kind":"text","text":" are "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":", if there is such integer "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j ≤ k"},{"kind":"text","text":"), that "},{"kind":"math_inline","text":"pj ≠ qj"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Notes to the samples"}],"kind":"container"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" In the first sample after the first trip you are either on floor "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", or on floor "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", because "},{"kind":"math_inline","text":"|1 - 2| < |2 - 4|"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"|3 - 2| < |2 - 4|"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" In the second sample there are two possible sequences: "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":". You cannot choose floor "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" for the first trip because in this case no floor can be the floor for the second trip. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" In the third sample there are no sought sequences, because you cannot choose the floor for the first trip. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"479E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/479/problem/E"}