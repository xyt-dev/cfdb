{"assets":["/statement-assets/6099c970cfc70c36c43f303127af7aefd20e49dec7583a5fab7b464cdd27353a.png"],"contentKind":"statement","contestId":"573","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Bear and Bowling"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"6 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Limak is an old brown bear. He often goes bowling with his friends. Today he feels really good and tries to beat his own record!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For rolling a ball one gets a score — an integer (maybe negative) number of points. Score for "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th roll is multiplied by "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and scores are summed up. So, for "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" rolls with scores "},{"kind":"math_inline","text":"s1, s2, ..., sk"},{"kind":"text","text":", total score is "},{"attrs":{"alt":"","src":"/statement-assets/6099c970cfc70c36c43f303127af7aefd20e49dec7583a5fab7b464cdd27353a.png"},"kind":"image"},{"kind":"text","text":". Total score is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" if there were no rolls."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak made "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rolls and got score "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" for "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them. He wants to maximize his total score and he came up with an interesting idea. He will cancel some rolls, saying that something distracted him or there was a strong wind."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak is able to cancel any number of rolls, maybe even all or none of them. Total score is calculated as if there were only non-canceled rolls. Look at the sample tests for clarification. What maximum total score can Limak get?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|ai| ≤ 107)"},{"kind":"text","text":" - scores for Limak's rolls."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum possible total score after choosing rolls to cancel."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n-2 -8 0 5 -3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n-10 20 -30 40 -50 60\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"400\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In first sample Limak should cancel rolls with scores "},{"kind":"math_inline","text":" - 8"},{"kind":"text","text":" and "},{"kind":"math_inline","text":" - 3"},{"kind":"text","text":". Then he is left with three rolls with scores "},{"kind":"math_inline","text":" - 2, 0, 5"},{"kind":"text","text":". Total score is "},{"kind":"math_inline","text":"1·( - 2) + 2·0 + 3·5 = 13"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In second sample Limak should cancel roll with score "},{"kind":"math_inline","text":" - 50"},{"kind":"text","text":". Total score is "},{"kind":"math_inline","text":"1·( - 10) + 2·20 + 3·( - 30) + 4·40 + 5·60 = 400"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"573E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/573/problem/E"}