{"assets":["/statement-assets/b86e17a886198e647bcbc54e8358b20b5ef4472c7bab2fbf2176208bd356460e.png"],"contentKind":"statement","contestId":"573","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Bear and Blocks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Limak is a little bear who loves to play. Today he is playing by destroying block towers. He built "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" towers in a row. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th tower is made of "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" identical blocks. For clarification see picture for the first sample."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak will repeat the following operation till everything is destroyed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Block is called internal if it has all four neighbors, i.e. it has each side (top, left, down and right) adjacent to other block or to the floor. Otherwise, block is boundary. In one operation Limak destroys all boundary blocks. His paws are very fast and he destroys all those blocks at the same time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak is ready to start. You task is to count how many operations will it take him to destroy all towers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"h1, h2, ..., hn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ hi ≤ 109)"},{"kind":"text","text":" — sizes of towers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of operations needed to destroy all towers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n2 1 4 6 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n3 3 3 1 3 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The picture below shows all three operations for the first sample test. Each time boundary blocks are marked with red color. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b86e17a886198e647bcbc54e8358b20b5ef4472c7bab2fbf2176208bd356460e.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" After first operation there are four blocks left and only one remains after second operation. This last block is destroyed in third operation."}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"573B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/573/problem/B"}