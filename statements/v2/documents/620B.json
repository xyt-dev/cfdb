{"assets":["/statement-assets/b2cfe1ae288b4dc14549a9d6a526547022f7b4893912e7055b57286043d88158.bmp"],"contentKind":"statement","contestId":"620","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Grandfather Dovlet’s calculator"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Once Max found an electronic calculator from his grandfather Dovlet's chest. He noticed that the numbers were written with seven-segment indicators ("},{"attrs":{"href":"https://en.wikipedia.org/wiki/Seven-segment_display"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Seven-segment_display"}],"kind":"link"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b2cfe1ae288b4dc14549a9d6a526547022f7b4893912e7055b57286043d88158.bmp"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Max starts to type all the values from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". After typing each number Max resets the calculator. Find the total number of segments printed on the calculator."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example if "},{"kind":"math_inline","text":"a = 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b = 3"},{"kind":"text","text":" then at first the calculator will print "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" segments, then — "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" segments and at last it will print "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" segments. So the total number of printed segments is "},{"kind":"math_inline","text":"12"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains two integers "},{"kind":"math_inline","text":"a, b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a ≤ b ≤ 106"},{"kind":"text","text":") — the first and the last number typed by Max."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" — the total number of printed segments."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"39\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"620B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/620/problem/B"}