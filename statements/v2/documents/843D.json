{"assets":["/statement-assets/7b00809d760e9e0fced0e1eccc15a6afb80c5f0b6d7358ad14d84ca17fc2519b.png","/statement-assets/a248013b5cd23f3dd6552f2e9c3509405650201cb451a42c1e6370442d6820af.png"],"contentKind":"statement","contestId":"843","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Dynamic Shortest Path"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"10 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a weighted directed graph, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges. You should answer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries of two types:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"1 v"}],"kind":"container"},{"kind":"text","text":" — find the length of shortest path from vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"2 c "},{"kind":"math_inline","text":"l1 l2 ... lc"}],"kind":"container"},{"kind":"text","text":" — add "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to weights of edges with indices "},{"kind":"math_inline","text":"l1, l2, ..., lc"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input data contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ q ≤ 2000"},{"kind":"text","text":") — the number of vertices and edges in the graph, and the number of requests correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines of input data contain the descriptions of edges: "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains description of edge with index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" — three integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ ci ≤ 109"},{"kind":"text","text":") — the beginning and the end of edge, and its initial weight correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines of input data contain the description of edges in the format described above ("},{"kind":"math_inline","text":"1 ≤ v ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ lj ≤ m"},{"kind":"text","text":"). It's guaranteed that inside single query all "},{"kind":"math_inline","text":"lj"},{"kind":"text","text":" are distinct. Also, it's guaranteed that a total number of edges in all requests of the second type does not exceed "},{"kind":"math_inline","text":"106"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of first type print the length of the shortest path from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" in a separate line. Print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":", if such path does not exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 9\n1 2 0\n2 3 0\n2 1 2\n1 3\n1 2\n2 1 1\n1 3\n1 2\n2 2 1 2\n1 3\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n0\n2\n1\n4\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4 9\n2 3 1\n2 4 1\n3 4 1\n1 2 0\n1 5\n1 4\n2 1 2\n2 1 2\n1 4\n2 2 1 3\n1 4\n2 1 4\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n1\n2\n3\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"The description of changes of the graph in the first samp