{"assets":[],"contentKind":"statement","contestId":"602","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Approximating a Constant Range"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"When Xellos was doing a practice course in university, he once had to measure the intensity of an effect that slowly approached equilibrium. A good way to determine the equilibrium intensity would be choosing a sufficiently large number of consecutive data points that seems as constant as possible and taking their average. Of course, with the usual sizes of data, it's nothing challenging — but why not make a similar programming contest problem while we're at it?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You're given a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" data points "},{"kind":"math_inline","text":"a1, ..., an"},{"kind":"text","text":". There aren't any big jumps between consecutive data points — for each "},{"kind":"math_inline","text":"1 ≤ i < n"},{"kind":"text","text":", it's guaranteed that "},{"kind":"math_inline","text":"|ai + 1 - ai| ≤ 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A range "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":" of data points is said to be "},{"children":[{"kind":"text","text":"almost constant"}],"kind":"container"},{"kind":"text","text":" if the difference between the largest and the smallest value in that range is at most "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Formally, let "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" be the maximum and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" the minimum value of "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" for "},{"kind":"math_inline","text":"l ≤ i ≤ r"},{"kind":"text","text":"; the range "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":" is almost constant if "},{"kind":"math_inline","text":"M - m ≤ 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the length of the longest almost constant range."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of data points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 100 000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the maximum length of an almost constant range of the given sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11\n5 4 5 5 6 7 8 8 8 7 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the longest almost constant range is "},{"kind":"math_inline","text":"[2, 5]"},{"kind":"text","text":"; its length (the number of data points in it) is 4."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, there are three almost constant ranges of length "},{"kind":"math_inline","text":"4"},{"kind":"text","text":": "},{"kind":"math_inline","text":"[1, 4]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"[6, 9]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"[7, 10]"},{"kind":"text","text":"; the only almost constant range of the maximum length "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"[6, 10]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"602B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/602/problem/B"}