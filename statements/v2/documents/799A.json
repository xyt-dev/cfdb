{"assets":[],"contentKind":"statement","contestId":"799","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Carrot Cakes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In some game by Playrix it takes "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" minutes for an oven to bake "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" carrot cakes, all cakes are ready at the same moment "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" minutes after they started baking. Arkady needs at least "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cakes to complete a task, but he currently don't have any. However, he has infinitely many ingredients and one oven. Moreover, Arkady can build one more similar oven to make the process faster, it would take "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" minutes to build the oven. While the new oven is being built, only old one can bake cakes, after the new oven is built, both ovens bake simultaneously. Arkady can't build more than one oven."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine if it is reasonable to build the second oven, i.e. will it decrease the minimum time needed to get "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cakes or not. If the time needed with the second oven is the same as with one oven, then it is unreasonable."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains four integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, t, k, d ≤ 1 000"},{"kind":"text","text":") — the number of cakes needed, the time needed for one oven to bake "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" cakes, the number of cakes baked at the same time, the time needed to build the second oven. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is reasonable to build the second oven, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\". Otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 6 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 6 4 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 3 11 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example it is possible to get "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" cakes in "},{"kind":"math_inline","text":"12"},{"kind":"text","text":" minutes using one oven. The second oven can be built in "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" minutes, so after "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" minutes the first oven bakes "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" cakes, the second oven bakes "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" more ovens after "},{"kind":"math_inline","text":"11"},{"kind":"text","text":" minutes. Thus, it is reasonable to build the second oven. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example it doesn't matter whether we build the second oven or not, thus it takes "},{"kind":"math_inline","text":"12"},{"kind":"text","text":" minutes to bake "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" cakes in both cases. Thus, it is unreasonable to build the second oven."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example the first oven bakes "},{"kind":"math_inline","text":"11"},{"kind":"text","text":" cakes in "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" minutes, that is more than needed "},{"kind":"math_inline","text":"10"},{"kind":"text","text":". It is unreasonable to build the second oven, because its building takes more time that baking the needed number of cakes using the only oven."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"799A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/799/problem/A"}