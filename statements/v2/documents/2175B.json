{"assets":[],"contentKind":"statement","contestId":"2175","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. XOR Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given three integers $$$n$$$, $$$l$$$, and $$$r$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to generate an array $$$a$$$ of positive ($$$1 \\leq a_i \\leq 10^9$$$) integers of length $$$n$$$. Let $$$f(x, y)$$$, for $$$1 \\le x \\le y \\le n$$$, be the bitwise XOR$$$^{\\text{∗}}$$$ value $$$a_x \\oplus a_{x+1} \\oplus \\ldots \\oplus a_y$$$. You need to make sure that $$$$$$\\begin{cases} f(x, y) = 0\\quad \\text{when }x = l\\text{ and }y = r; \\text{and}\\\\ f(x, y) \\ne 0\\quad \\text{when }x \\ne l \\text{ or } y \\ne r. \\end{cases}$$$$$$"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$$$$\\oplus$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise XOR operation"}],"kind":"link"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains three integers $$$n$$$, $$$l$$$, and $$$r$$$ ($$$2 \\leq n \\leq 4\\cdot 10^5$$$, $$$1 \\leq l \\lt r \\leq n$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ across all test cases does not exceed $$$5\\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single line containing $$$n$$$ integers $$$a_1, a_2, \\ldots a_n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can show that an answer always exists. If there are multiple solutions, print any of them. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n3 1 3\n4 1 3\n8 2 4\n4 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n9 8 1 \n2 7 5 4 \n9 1 9 8 10 5 4 9\n85484 130377 6031 6031\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, $$$f(1, 3) = 9 \\oplus 8 \\oplus 1 = 0$$$, while all other non-empty subarrays have non-zero bitwise XOR: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$f(1, 2) = 9 \\oplus 8 = 1 \\ne 0$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$f(2, 3) = 8 \\oplus 1 = 9 \\ne 0$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$f(1, 1) = 9 \\ne 0$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$f(2, 2) = 8 \\ne 0$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$f(3, 3) = 1 \\ne 0$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second test case, $$$2 \\oplus 7 \\oplus 5 = 0$$$, while, for example, $$$7 \\oplus 5 \\oplus 4 = 6 \\ne 0$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"2175B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2175/problem/B"}