{"assets":[],"contentKind":"statement","contestId":"735","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Ostap and Grasshopper"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"On the way to Rio de Janeiro Ostap kills time playing with a grasshopper he took with him in a special box. Ostap builds a line of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" such that some cells of this line are empty and some contain obstacles. Then, he places his grasshopper to one of the empty cells and a small insect in another empty cell. The grasshopper wants to eat the insect."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ostap knows that grasshopper is able to jump to any empty cell that is "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"math_inline","text":"k"},{"kind":"text","text":" cells away from the current (to the left or to the right). Note that it doesn't matter whether intermediate cells are empty or not as the grasshopper makes a jump over them. For example, if "},{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":" the grasshopper can jump to a neighboring cell only, and if "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":" the grasshopper can jump over a single cell."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your goal is to determine whether there is a sequence of jumps such that grasshopper will get from his initial position to the cell with an insect."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ n - 1"},{"kind":"text","text":") — the number of cells in the line and the length of one grasshopper's jump."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" consisting of characters '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"'. Character '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' means that the corresponding cell is empty, character '"},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"' means that the corresponding cell contains an obstacle and grasshopper can't jump there. Character '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"' means that the grasshopper starts at this position and, finally, '"},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"' means that the target insect is located at this cell. It's guaranteed that characters '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"' appear in this line "},{"children":[{"kind":"text","text":"exactly once"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there exists a sequence of jumps (each jump of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"), such that the grasshopper can get from his initial position to the cell with the insect, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in the only line of the input. Otherwise, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n#G#T#\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 1\nT....G\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 3\nT..#..G\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2\n..GT..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the grasshopper can make one jump to the right in order to get from cell "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to cell "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the grasshopper is only able to jump to neighboring cells but the way to the insect is free — he can get there by jumping left "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, the grasshopper can't make a single jump."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth sample, the grasshopper can only jump to the cells with odd indices, thus he won't be able to reach the insect."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"735A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/735/problem/A"}