{"assets":[],"contentKind":"statement","contestId":"785","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Anton and Permutation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Anton likes permutations, especially he likes to permute their elements. Note that a permutation of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" elements is a sequence of numbers "},{"kind":"math_inline","text":"{a1, a2, ..., an}"},{"kind":"text","text":", in which every number from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" appears exactly once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One day Anton got a new permutation and started to play with it. He does the following operation "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" times: he takes two elements of the permutation and swaps these elements. After each operation he asks his friend Vanya, how many inversions there are in the new permutation. The number of inversions in a permutation is the number of distinct pairs "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"1 ≤ i < j ≤ n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ai > aj"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vanya is tired of answering Anton's silly questions. So he asked you to write a program that would answer these questions instead of him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially Anton's permutation was "},{"kind":"math_inline","text":"{1, 2, ..., n}"},{"kind":"text","text":", that is "},{"kind":"math_inline","text":"ai = i"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"math_inline","text":"(1 ≤ n ≤ 200 000, 1 ≤ q ≤ 50 000)"},{"kind":"text","text":" — the length of the permutation and the number of operations that Anton does."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines of the input contains two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"math_inline","text":"(1 ≤ li, ri ≤ n)"},{"kind":"text","text":" — the indices of elements that Anton swaps during the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th operation. Note that indices of elements that Anton swaps during the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th operation can coincide. Elements in the permutation are numbered starting with one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line of the output is the number of inversions in the Anton's permutation after the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th operation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n4 5\n2 4\n2 5\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n4\n3\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 7\n1 4\n3 5\n2 3\n3 3\n3 6\n2 1\n5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n6\n7\n7\n10\n11\n8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first sample."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the first Anton's operation the permutation will be "},{"kind":"math_inline","text":"{1, 2, 3, 5, 4}"},{"kind":"text","text":". There is only one inversion in it: "},{"kind":"math_inline","text":"(4, 5)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the second Anton's operation the permutation will be "},{"kind":"math_inline","text":"{1, 5, 3, 2, 4}"},{"kind":"text","text":". There are four inversions: "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 5)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(3, 4)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the third Anton's operation the permutation will be "},{"kind":"math_inline","text":"{1, 4, 3, 2, 5}"},{"kind":"text","text":". There are three inversions: "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 4)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(3, 4)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the fourth Anton's operation the permutation doesn't change, so there are still three inversions."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"785E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/785/problem/E"}