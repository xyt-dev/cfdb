{"assets":[],"contentKind":"statement","contestId":"774","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"K. Stepan and Vowels"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Stepan likes to repeat vowel letters when he writes words. For example, instead of the word \""},{"children":[{"kind":"text","text":"pobeda"}],"kind":"container"},{"kind":"text","text":"\" he can write \""},{"children":[{"kind":"text","text":"pobeeeedaaaaa"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sergey does not like such behavior, so he wants to write a program to format the words written by Stepan. This program must combine all consecutive equal vowels to a single vowel. The vowel letters are \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"i"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"u"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are exceptions: if letters \""},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"\" repeat in a row exactly "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" times, like in words \""},{"children":[{"kind":"text","text":"feet"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"foot"}],"kind":"container"},{"kind":"text","text":"\", the program must skip them and do not transform in one vowel. For example, the word \""},{"children":[{"kind":"text","text":"iiiimpleeemeentatiioon"}],"kind":"container"},{"kind":"text","text":"\" must be converted to the word \""},{"children":[{"kind":"text","text":"implemeentatioon"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sergey is very busy and asks you to help him and write the required program."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of letters in the word written by Stepan."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" which has length that equals to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and contains only lowercase English letters — the word written by Stepan."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the single string — the word written by Stepan converted according to the rules described in the statement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"13\npobeeeedaaaaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"pobeda\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"22\niiiimpleeemeentatiioon\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"implemeentatioon\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"18\naeiouyaaeeiioouuyy\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"aeiouyaeeioouy\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"24\naaaoooiiiuuuyyyeeeggghhh\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"aoiuyeggghhh\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"