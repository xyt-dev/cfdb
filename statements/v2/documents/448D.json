{"assets":[],"contentKind":"statement","contestId":"448","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Multiplication Table"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bizon the Champion isn't just charming, he also is very smart."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"While some of us were learning the multiplication table, Bizon the Champion had fun in his own manner. Bizon the Champion painted an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" multiplication table, where the element on the intersection of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column equals "},{"kind":"math_inline","text":"i·j"},{"kind":"text","text":" (the rows and columns of the table are numbered starting from 1). Then he was asked: what number in the table is the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th largest number? Bizon the Champion always answered correctly and immediately. Can you repeat his success?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the given multiplication table. If you write out all "},{"kind":"math_inline","text":"n·m"},{"kind":"text","text":" numbers from the table in the non-decreasing order, then the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th number you write out is called the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th largest number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 5·105; 1 ≤ k ≤ n·m)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th largest number in a "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" multiplication table."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 10 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A "},{"kind":"math_inline","text":"2 × 3"},{"kind":"text","text":" multiplication table looks like this:"}],"kind":"paragraph"},{"kind":"code_block","text":"\n1 2 3\n2 4 6\n\n"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"448D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/448/problem/D"}