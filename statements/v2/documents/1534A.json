{"assets":[],"contentKind":"statement","contestId":"1534","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Colour the Flag"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Today we will be playing a red and white colouring game (no, this is not the Russian Civil War; these are just the colours of the Canadian flag)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an $$$n \\times m$$$ grid of \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" characters. \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\" is red, \""},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"\" is white and \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" is blank. The neighbours of a cell are those that share an edge with it (those that only share a corner do not count)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your job is to colour the blank cells red or white so that every red cell only has white neighbours (and no red ones) and every white cell only has red neighbours (and no white ones). You are not allowed to recolour already coloured cells."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains $$$t$$$ ($$$1 \\le t \\le 100$$$), the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In each test case, the first line will contain $$$n$$$ ($$$1 \\le n \\le 50$$$) and $$$m$$$ ($$$1 \\le m \\le 50$$$), the height and width of the grid respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n$$$ lines will contain the grid. Each character of the grid is either '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"', or '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if there is a valid grid or \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" if there is not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is, output the grid on the next $$$n$$$ lines. If there are multiple answers, print any."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the output, the \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\"s and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"s are case-insensitive, meaning that outputs such as \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"nO"}],"kind":"container"},{"kind":"text","text":"\" are valid. However, "},{"children":[{"kind":"text","text":"the grid is case-sensitive"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n4 6\n.R....\n......\n......\n.W....\n4 4\n.R.W\n....\n....\n....\n5 1\nR\nW\nR\nW\nR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nWRWRWR\nRWRWRW\nWRWRWR\nRWRWRW\nNO\nYES\nR\nW\nR\nW\nR\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The answer for the first example case is given in the example output, and it can be proven that no grid exists that satisfies the requirements of the second example case. In the third example all cells are initially coloured, and the colouring is valid."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1534A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1534/problem/A"}