{"assets":[],"contentKind":"statement","contestId":"1932","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Final Countdown"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are in a nuclear laboratory that is about to explode and destroy the Earth. You must save the Earth before the final countdown reaches zero. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The countdown consists of $$$n$$$ ($$$1 \\le n \\le 4 \\cdot 10^5$$$) mechanical indicators, each showing one decimal digit. You noticed that when the countdown changes its state from $$$x$$$ to $$$x-1$$$, it doesn't happen in one move. Instead, each change of a single digit takes one second. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, for example, if the countdown shows "},{"children":[{"kind":"text","text":"42"}],"kind":"container"},{"kind":"text","text":", then it will change to "},{"children":[{"kind":"text","text":"41"}],"kind":"container"},{"kind":"text","text":" in one second, because only one digit is changed, but if the countdown shows "},{"children":[{"kind":"text","text":"2300"}],"kind":"container"},{"kind":"text","text":", then it will change to "},{"children":[{"kind":"text","text":"2299"}],"kind":"container"},{"kind":"text","text":" in three seconds, because the three last digits are changed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find out how much time is left before the countdown reaches zero."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. Then the descriptions of the test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1\\le n\\le 4\\cdot 10^5$$$). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string of $$$n$$$ digits, the current state of the countdown. It is guaranteed that at least one digit is not zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of $$$n$$$ for all tests does not exceed $$$4\\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single integer without leading zeroes, the number of seconds left before the countdown reaches zero. Note that this number may be huge."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n2\n42\n5\n12345\n2\n99\n4\n0005\n27\n456480697259671309012631002\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n46\n13715\n108\n5\n507200774732968121125145546\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, there are four changes that take 2 seconds: "},{"children":[{"kind":"text","text":"40"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"39"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"30"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"29"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"20"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"19"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"09"}],"kind":"container"},{"kind":"text","text":", other changes take 1 second each. So the total time is $$$2\\cdot 4 + 1\\cdot(42-4) = 46$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1932E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1932/problem/E"}