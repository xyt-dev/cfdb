{"assets":[],"contentKind":"statement","contestId":"673","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Problems for Round"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" problems prepared for the next Codeforces round. They are arranged in ascending order by their difficulty, and no two problems have the same difficulty. Moreover, there are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" pairs of similar problems. Authors want to split problems between two division according to the following rules: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Problemset of each division should be non-empty. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Each problem should be used in exactly one division (yes, it is unusual requirement). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Each problem used in division 1 should be harder than any problem used in division 2. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If two problems are similar, they should be used in different divisions. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your goal is count the number of ways to split problem between two divisions and satisfy all the rules. Two ways to split problems are considered to be different if there is at least one problem that belongs to division 1 in one of them and to division 2 in the other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note, that the relation of similarity "},{"children":[{"kind":"text","text":"is not"}],"kind":"container"},{"kind":"text","text":" transitive. That is, if problem "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is similar to problem "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" and problem "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" is similar to problem "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", it doesn't follow that "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is similar to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ m ≤ 100 000"},{"kind":"text","text":") — the number of problems prepared for the round and the number of pairs of similar problems, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains a pair of similar problems "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n, ui ≠ vi"},{"kind":"text","text":"). It's guaranteed, that no pair of problems meets twice in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the number of ways to split problems in two divisions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n1 4\n5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2\n2 3\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n3 1\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, problems "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" should be used in division 2, while problems "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" in division 1. Problem "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" may be used either in division 1 or in division 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, all pairs of problems are similar and there is no way to split problem between two divisions without breaking any rules."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Third sample reminds you that the similarity relation is not transitive. Problem "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" is similar to both "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", but "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is not similar to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", so they may be used together."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"673B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/673/problem/B"}