{"assets":["/statement-assets/e44ebe12e86096eb63ec1e777bb399125c8c171532a733181ac7658e51abae4f.png","/statement-assets/456abb653c8467ff24cd973dcdd61037b57e693a5bbcb51458d9011b011b4c3a.png"],"contentKind":"statement","contestId":"820","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Mister B and Angle in Polygon"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"On one quiet day all of sudden Mister B decided to draw angle "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" on his field. Aliens have already visited his field and left many different geometric figures on it. One of the figures is "},{"children":[{"kind":"text","text":"regular convex "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-gon"}],"kind":"container"},{"kind":"text","text":" (regular convex polygon with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sides)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"That's why Mister B decided to use this polygon. Now Mister B must find three distinct vertices "},{"kind":"math_inline","text":"v1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v3"},{"kind":"text","text":" such that the angle "},{"attrs":{"alt":"","src":"/statement-assets/e44ebe12e86096eb63ec1e777bb399125c8c171532a733181ac7658e51abae4f.png"},"kind":"image"},{"kind":"text","text":" (where "},{"kind":"math_inline","text":"v2"},{"kind":"text","text":" is the vertex of the angle, and "},{"kind":"math_inline","text":"v1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v3"},{"kind":"text","text":" lie on its sides) is as close as possible to "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". In other words, the value "},{"attrs":{"alt":"","src":"/statement-assets/456abb653c8467ff24cd973dcdd61037b57e693a5bbcb51458d9011b011b4c3a.png"},"kind":"image"},{"kind":"text","text":" should be minimum possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are many optimal solutions, Mister B should be satisfied with any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First and only line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ a ≤ 180"},{"kind":"text","text":") — the number of vertices in the polygon and the needed angle, in degrees."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print three space-separated integers: the vertices "},{"kind":"math_inline","text":"v1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v3"},{"kind":"text","text":", which form "},{"attrs":{"alt":"","src":"/statement-assets/e44ebe12e86096eb63ec1e777bb399125c8c171532a733181ac7658e51abae4f.png"},"kind":"image"},{"kind":"text","text":". If there are multiple optimal solutions, print any of them. The vertices are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in clockwise order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 67\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 68\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 1 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In first sample test vertices of regular triangle can create only angle of "},{"kind":"math_inline","text":"60"},{"kind":"text","text":" degrees, that's why every possible angle is correct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vertices of square can create "},{"kind":"math_inline","text":"45"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"90"},{"kind":"text","text":" degrees angles only. That's why in second sample test the angle of "},{"kind":"math_inline","text":"45"},{"kind":"text","text":" degrees was chosen, since "},{"kind":"math_inline","text":"|45 - 67| < |90 - 67|"},{"kind":"text","text":". Other correct answers are: \"3 1 2\", \"3 2 4\", \"4 2 3\", \"4 3 1\", \"1 3 4\", \"1 4 2\", \"2 4 1\", \"4 1 3\", \"3 1 4\", \"3 4 2\", \"2 4 3\", \"2 3 1\", \"1 3 2\", \"1 2 4\", \"4 2 1\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In third sample test, on the contrary, the angle of "},{"kind":"math_inline","text":"90"},{"kind":"text","text":" degrees was chosen, since "},{"kind":"math_inline","text":"|90 - 68| < |45 - 68|"},{"kind":"text","text":". Other correct answers are: \"2 1 4\", \"3 2 1\", \"1 2 3\", \"4 3 2\", \"2 3 4\", \"1 4 3\", \"3 4 1\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"820B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/820/problem/B"}