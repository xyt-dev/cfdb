{"assets":[],"contentKind":"statement","contestId":"1327","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Letters and Question Marks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$S$$$ and an array of strings $$$[t_1, t_2, \\dots, t_k]$$$. Each string $$$t_i$$$ consists of lowercase Latin letters from "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"n"}],"kind":"container"},{"kind":"text","text":"; $$$S$$$ consists of lowercase Latin letters from "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"n"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"no more than $$$14$$$"}],"kind":"container"},{"kind":"text","text":" question marks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each string $$$t_i$$$ has its cost $$$c_i$$$ — an integer number. The value of some string $$$T$$$ is calculated as $$$\\sum\\limits_{i = 1}^{k} F(T, t_i) \\cdot c_i$$$, where $$$F(T, t_i)$$$ is the number of occurences of string $$$t_i$$$ in $$$T$$$ as a substring. For example, $$$F(\\text{aaabaaa}, \\text{aa}) = 4$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to replace all question marks in $$$S$$$ with "},{"children":[{"kind":"text","text":"pairwise distinct"}],"kind":"container"},{"kind":"text","text":" lowercase Latin letters from "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"n"}],"kind":"container"},{"kind":"text","text":" so the value of $$$S$$$ is maximum possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$k$$$ ($$$1 \\le k \\le 1000$$$) — the number of strings in the array $$$[t_1, t_2, \\dots, t_k]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$k$$$ lines follow, each containing one string $$$t_i$$$ (consisting of lowercase Latin letters from "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"n"}],"kind":"container"},{"kind":"text","text":") and one integer $$$c_i$$$ ($$$1 \\le |t_i| \\le 1000$$$, $$$-10^6 \\le c_i \\le 10^6$$$). The sum of lengths of all strings $$$t_i$$$ does not exceed $$$1000$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line contains one string $$$S$$$ ($$$1 \\le |S| \\le 4 \\cdot 10^5$$$) consisting of lowercase Latin letters from "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"n"}],"kind":"container"},{"kind":"text","text":" and question marks. The number of question marks in $$$S$$$ is not greater than $$$14$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the maximum value of $$$S$$$ after replacing all question marks with "},{"children":[{"kind":"text","text":"pairwise distinct"}],"kind":"container"},{"kind":"text","text":" lowercase Latin letters from "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"n"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nabc -10\na 1\nb 1\nc 3\n?b?\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\na 1\na 1\n?\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\na 1\nb 3\nab 4\nab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1\na -1\n?????????????\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level"