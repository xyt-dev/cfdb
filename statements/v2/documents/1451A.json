{"assets":[],"contentKind":"statement","contestId":"1451","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Subtract or Divide"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ridbit starts with an integer $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one move, he can perform one of the following operations: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" divide $$$n$$$ by one of its "},{"children":[{"kind":"text","text":"proper"}],"kind":"container"},{"kind":"text","text":" divisors, or "}],"kind":"list_item"},{"children":[{"kind":"text","text":" subtract $$$1$$$ from $$$n$$$ if $$$n$$$ is greater than $$$1$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A proper divisor is a divisor of a number, excluding itself. For example, $$$1$$$, $$$2$$$, $$$4$$$, $$$5$$$, and $$$10$$$ are proper divisors of $$$20$$$, but $$$20$$$ itself is not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of moves Ridbit is required to make to reduce $$$n$$$ to $$$1$$$?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 1000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains