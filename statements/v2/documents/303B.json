{"assets":["/statement-assets/ac437b17a16235dbf6afb8e90d21a468732c50cc360d7c1bf1e5189232a1cc9f.png","/statement-assets/e1f83a86d8deea27822e4d1b55171a2d536366af683e8c84ac0c2678a67f859d.png"],"contentKind":"statement","contestId":"303","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Rectangle Puzzle II"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a rectangle grid. That grid's size is "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":". Let's denote the coordinate system on the grid. So, each point on the grid will have coordinates — a pair of integers "},{"kind":"math_inline","text":"(x, y)"},{"kind":"math_inline","text":"(0 ≤ x ≤ n, 0 ≤ y ≤ m)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find a maximum sub-rectangle on the grid "},{"kind":"math_inline","text":"(x1, y1, x2, y2)"},{"kind":"text","text":" so that it contains the given point "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":", and its length-width ratio is exactly "},{"kind":"math_inline","text":"(a, b)"},{"kind":"text","text":". In other words the following conditions must hold: "},{"kind":"math_inline","text":"0 ≤ x1 ≤ x ≤ x2 ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ y1 ≤ y ≤ y2 ≤ m"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/ac437b17a16235dbf6afb8e90d21a468732c50cc360d7c1bf1e5189232a1cc9f.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sides of this sub-rectangle should be parallel to the axes. And values "},{"kind":"math_inline","text":"x1, y1, x2, y2"},{"kind":"text","text":" should be integers."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e1f83a86d8deea27822e4d1b55171a2d536366af683e8c84ac0c2678a67f859d.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"If there are multiple solutions, find the rectangle which is closest to "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":". Here \"closest\" means the Euclid distance between "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" and the center of the rectangle is as small as possible. If there are still multiple solutions, find the lexicographically minimum one. Here \"lexicographically minimum\" means that we should consider the sub-rectangle as sequence of integers "},{"kind":"math_inline","text":"(x1, y1, x2, y2)"},{"kind":"text","text":", so we can choose the lexicographically minimum one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains six integers "},{"kind":"math_inline","text":"n, m, x, y, a, b"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 109, 0 ≤ x ≤ n, 0 ≤ y ≤ m, 1 ≤ a ≤ n, 1 ≤ b ≤ m)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print four integers "},{"kind":"math_inline","text":"x1, y1, x2, y2"},{"kind":"text","text":", which represent the founded sub-rectangle whose left-bottom point is "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":" and right-up point is "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9 9 5 5 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3 9 7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"100 100 52 50 46 56\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"17 8 86 92\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"303B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/303/problem/B"}