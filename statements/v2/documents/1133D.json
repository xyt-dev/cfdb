_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, we may choose $$$d = -2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, we may choose $$$d = -\\frac{1}{13}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, we cannot obtain any zero in array $$$c$$$, no matter which $$$d$$$ we choose."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example, we may choose $$$d = 6$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1133D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1133/problem/D"}