{"assets":["/statement-assets/c680322965b610a73a65e13bb6b79e19512bf795403ba4e91f629207b18689ed.png","/statement-assets/4221d2ee008714b87c3400e4da9489f3bcfed79fe3776e688fcb93ba688e4d17.png"],"contentKind":"statement","contestId":"617","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Watering Flowers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A flowerbed has many flowers and two fountains."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can adjust the water pressure and set any values "},{"kind":"math_inline","text":"r1(r1 ≥ 0)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r2(r2 ≥ 0)"},{"kind":"text","text":", giving the distances at which the water is spread from the first and second fountain respectively. You have to set such "},{"kind":"math_inline","text":"r1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r2"},{"kind":"text","text":" that all the flowers are watered, that is, for each flower, the distance between the flower and the first fountain doesn't exceed "},{"kind":"math_inline","text":"r1"},{"kind":"text","text":", or the distance to the second fountain doesn't exceed "},{"kind":"math_inline","text":"r2"},{"kind":"text","text":". It's OK if some flowers are watered by both fountains."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to decrease the amount of water you need, that is set such "},{"kind":"math_inline","text":"r1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r2"},{"kind":"text","text":" that all the flowers are watered and the "},{"kind":"math_inline","text":"r12 + r22"},{"kind":"text","text":" is minimum possible. Find this minimum value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2000"},{"kind":"text","text":", "},{"kind":"math_inline","text":" - 107 ≤ x1, y1, x2, y2 ≤ 107"},{"kind":"text","text":") — the number of flowers, the coordinates of the first and the second fountain."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 107 ≤ xi, yi ≤ 107"},{"kind":"text","text":") — the coordinates of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th flower."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all "},{"kind":"math_inline","text":"n + 2"},{"kind":"text","text":" points in the input are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum possible value "},{"kind":"math_inline","text":"r12 + r22"},{"kind":"text","text":". Note, that in this problem optimal answer is always integer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 -1 0 5 3\n0 2\n5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 0 0 5 0\n9 4\n8 3\n-1 0\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"33\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first sample is ("},{"kind":"math_inline","text":"r12 = 5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r22 = 1"},{"kind":"text","text":"): "},{"attrs":{"alt":"","src":"/statement-assets/c680322965b610a73a65e13bb6b79e19512bf795403ba4e91f629207b18689ed.png"},"kind":"image"},{"kind":"text","text":" The second sample is ("},{"kind":"math_inline","text":"r12 = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r22 = 32"},{"kind":"text","text":"): "},{"attrs":{"alt":"","src":"/statement-assets/4221d2ee008714b87c3400e4da9489f3bcfed79fe3776e688fcb93ba688e4d17.png"},"kind":"image"}],"kind":"paragraph