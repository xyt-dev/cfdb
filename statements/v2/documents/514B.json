{"assets":["/statement-assets/c273166e5f78bb0ab5dcf2c3a9bdcc72cc09c4eb7a66cb7d750a11a46da39455.png"],"contentKind":"statement","contestId":"514","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Han Solo and Lazer Gun"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" Imperial stormtroopers on the field. The battle field is a plane with Cartesian coordinate system. Each stormtrooper is associated with his coordinates "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" on this plane. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Han Solo has the newest duplex lazer gun to fight these stormtroopers. It is situated at the point "},{"kind":"math_inline","text":"(x0, y0)"},{"kind":"text","text":". In one shot it can can destroy all the stormtroopers, situated on some line that crosses point "},{"kind":"math_inline","text":"(x0, y0)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine what minimum number of shots Han Solo needs to defeat all the stormtroopers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The gun is the newest invention, it shoots very quickly and even after a very large number of shots the stormtroopers don't have enough time to realize what's happening and change their location. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x0"},{"kind":"text","text":" и "},{"kind":"math_inline","text":"y0"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":" - 104 ≤ x0, y0 ≤ 104"},{"kind":"text","text":") — the number of stormtroopers on the battle field and the coordinates of your gun."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain two integers each "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 104 ≤ xi, yi ≤ 104"},{"kind":"text","text":") — the coordinates of the stormtroopers on the battlefield. It is guaranteed that no stormtrooper stands at the same point with the gun. Multiple stormtroopers can stand at the same point."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum number of shots Han Solo needs to destroy all the stormtroopers. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 0 0\n1 1\n2 2\n2 0\n-1 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 2\n1 1\n1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Explanation to the first and second samples from the statement, respectively: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c273166e5f78bb0ab5dcf2c3a9bdcc72cc09c4eb7a66cb7d750a11a46da39455.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"514B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/514/problem/B"}