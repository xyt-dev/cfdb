{"assets":["/statement-assets/2cf48fe4e7a003eac12f6ee873c1191398c6e25a260cc8458481ad754ee752dc.png"],"contentKind":"statement","contestId":"1469","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Power Sockets"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"// "},{"children":[{"kind":"text","text":"We decided to drop the legend about the power sockets but feel free to come up with your own :^)"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Define a chain: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" a chain of length $$$1$$$ is a single vertex; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" a chain of length $$$x$$$ is a chain of length $$$x-1$$$ with a new vertex connected to the end of it with a single edge. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given $$$n$$$ chains of lengths $$$l_1, l_2, \\dots, l_n$$$. You plan to build a tree using some of them."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Each vertex of the tree is either white or black. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The tree initially only has a white root vertex. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" All chains initially consist only of white vertices. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" You can take one of the chains and connect any of its vertices to any white vertex of the tree with an edge. The chain becomes part of the tree. Both endpoints of this edge become black. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Each chain can be used no more than once. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Some chains can be left unused. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The distance between two vertices of the tree is the number of edges on the shortest path between them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is at least $$$k$$$ white vertices in the resulting tree, then the value of the tree is the distance between the root and the $$$k$$$-th closest white vertex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What's the minimum value of the tree you can obtain? If there is no way to build a tree with at least $$$k$$$ white vertices, then print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$, $$$2 \\le k \\le 10^9$$$) — the number of chains and the minimum number of white vertices a tree should have to have a value."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$l_1, l_2, \\dots, l_n$$$ ($$$3 \\le l_i \\le 2 \\cdot 10^5$$$) — the lengths of the chains."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer. If there is no way to build a tree with at least $$$k$$$ white vertices, then print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". Otherwise, print the minimum value the tree can have."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1 2\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 3\n4 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 5\n4 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 10\n5 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/2cf48fe4e7a003eac12f6ee873c1191398c6e25a260cc8458481ad754ee752dc.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"You are allowed to not use all the chains, so it's optimal to only use chain of length $$$4$$$ in the second example."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1469F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1469/problem/F"}