{"assets":["/statement-assets/d1bb954c57c6032a9fb35a4f62619904ea84dccbd7802a2a129e113a68f03564.png","/statement-assets/68c67a615cf6650b2ecf024520b81d78a5d2d2eb483433f095798607c808f42a.png"],"contentKind":"statement","contestId":"1025","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Recovering BST"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dima the hamster enjoys nibbling different things: cages, sticks, bad problemsetters and even trees!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Recently he found a binary search tree and instinctively nibbled all of its edges, hence messing up the vertices. Dima knows that if Andrew, who has been thoroughly assembling the tree for a long time, comes home and sees his creation demolished, he'll get extremely upset. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To not let that happen, Dima has to recover the binary search tree. Luckily, he noticed that any two vertices connected by a direct edge had their greatest common divisor value exceed $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Dima construct such a "},{"children":[{"kind":"text","text":"binary search tree"}],"kind":"container"},{"kind":"text","text":" or determine that it's impossible. The definition and properties of a binary search tree can be found "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Binary_search_tree"},"children":[{"kind":"text","text":"here."}],"kind":"link"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the number of vertices $$$n$$$ ($$$2 \\le n \\le 700$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line features $$$n$$$ distinct integers $$$a_i$$$ ($$$2 \\le a_i \\le 10^9$$$) — the values of vertices "},{"children":[{"kind":"text","text":"in ascending order"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is possible to reassemble the binary search tree, such that the greatest common divisor of any two vertices connected by the edge is greater than $$$1$$$, print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" (quotes for clarity)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" (quotes for clarity)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n3 6 9 18 36 108\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n7 17\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n4 8 10 12 15 18 33 44 81\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The picture below illustrates one of the possible trees for the first example."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d1bb954c57c6032a9fb35a4f62619904ea84dccbd7802a2a129e113a68f03564.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The picture below illustrates one of the possible trees for the third example."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/68c67a615cf6650b2ecf024520b81d78a5d2d2eb483433f095798607c808f42a.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1025D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1025/problem/D"}