{"assets":[],"contentKind":"statement","contestId":"2261","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. 1 2 3 and XOR, Where Did Everybody Go?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"7 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a sequence $$$a$$$ consisting of $$$n$$$ non-negative integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a sequence $$$b$$$ consisting of $$$k$$$ non-negative integers, define a "},{"children":[{"kind":"text","text":"dot increment"}],"kind":"container"},{"kind":"text","text":" on $$$b$$$ as the following operation:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Select an index $$$i$$$ ($$$1 \\le i \\le k$$$), and add any "},{"children":[{"kind":"text","text":"non-negative"}],"kind":"container"},{"kind":"text","text":" integer of choice to $$$b_i$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Then, let $$$f(b)$$$ be the minimum value of $$$b_1 \\oplus b_2 \\oplus \\ldots \\oplus b_k$$$ after performing a dot increment on $$$b$$$ "},{"children":[{"kind":"text","text":"exactly once"}],"kind":"container"},{"kind":"text","text":".$$$^{\\text{∗}}$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please find the value of the following sum."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$\\sum_{1 \\le l \\le r \\le n}f([a_l,a_{l+1},\\ldots,a_r])$$$$$$"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$Here, $$$\\oplus$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise XOR operation"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains an integer $$$n$$$ ($$$1 \\le n \\le 4\\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains integers $$$a_1,a_2,\\ldots,a_n$$$ ($$$0 \\le a_i \\lt 2^{25}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ does not exceed $$$4\\cdot 10^5$$$ over all test cases."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the answer to the problem on a separate line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n5\n5 4 6 7 5\n5\n3 3 2 2 3\n1\n67\n10\n1827481 5921082 14619611 643973 6718274 2948 244716 29 0 6717827\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n43\n21\n67\n36695941\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, for example, consider $$$f([5,4,6,7,5])$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"By incrementing $$$b_2=4$$$ by $$$1$$$, $$$b$$$ becomes $$$[5,5,6,7,5]$$$, and $$$5 \\oplus 5 \\oplus 6 \\oplus 7 \\oplus 5 = 4$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It can be shown that $$$b_1 \\oplus b_2 \\oplus b_3 \\oplus b_4 \\oplus b_5$$$ cannot be smaller than $$$4$$$ after one dot increment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of minimum values over all subarrays can be shown to be $$$43$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"2261G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2261/problem/G"}