{"assets":[],"contentKind":"statement","contestId":"1844","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Great Grids"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"An $$$n \\times m$$$ grid of characters is called "},{"children":[{"kind":"text","text":"great"}],"kind":"container"},{"kind":"text","text":" if it satisfies these three conditions: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Each character is either '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"', or '"},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Every $$$2 \\times 2$$$ contiguous subgrid contains all three different letters. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Any two cells that share a common edge contain different letters. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let $$$(x,y)$$$ denote the cell in the $$$x$$$-th row from the top and $$$y$$$-th column from the left."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You want to construct a great grid that satisfies $$$k$$$ constraints. Each constraint consists of two cells, $$$(x_{i,1},y_{i,1})$$$ and $$$(x_{i,2},y_{i,2})$$$, that share exactly one corner. You want your great grid to have the same letter in cells $$$(x_{i,1},y_{i,1})$$$ and $$$(x_{i,2},y_{i,2})$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine whether there exists a great grid satisfying all the constraints. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^3$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains three integers, $$$n$$$, $$$m$$$, and $$$k$$$ ($$$2 \\le n,m \\le 2 \\cdot 10^3$$$, $$$1 \\le k \\le 4 \\cdot 10^3$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$k$$$ lines contains four integers, $$$x_{i,1}$$$, $$$y_{i,1}$$$, $$$x_{i,2}$$$, and $$$y_{i,2}$$$ ($$$1 \\le x_{i,1} \\lt x_{i,2} \\le n$$$, $$$1 \\le y_{i,1},y_{i,2} \\le m$$$). It is guaranteed that either $$$(x_{i,2},y_{i,2}) = (x_{i,1}+1,y_{i,1}+1)$$$ or $$$(x_{i,2},y_{i,2}) = (x_{i,1}+1,y_{i,1}-1)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The pairs of cells are pairwise distinct, i.e. for all $$$1 \\le i \\lt j \\le k$$$, it is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" true that $$$x_{i,1} = x_{j,1}$$$, $$$y_{i,1} = y_{j,1}$$$, $$$x_{i,2} = x_{j,2}$$$, and $$$y_{i,2} = y_{j,2}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$m$$$ over all test cases does not exceed $$$2 \\cdot 10^3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$k$$$ over all test cases does not exceed $$$4 \\cdot 10^3$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if a great grid satisfying all the constraints exists and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output the answer in any case (upper or lower). For example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be recognized as positive responses."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n3 4 4\n1 1 2 2\n2 1 3 2\n1 4 2 3\n2 3 3 2\n2 7 2\n1 1 2 2\n1 2 2 1\n8 5 4\n1 2 2 1\n1 5 2 4\n7 1 8 2\n7 4 8 5\n8 5 4\n1 2 2 1\n1 5 2 4\n7 1 8 2\n7 5 8 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the following great grid satisfies all the constraints: "}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"B"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"A"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"B"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"C"}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"C"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"B"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"C"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"A"}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"A"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"C"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"A"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"B"}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"},{"children":[{"kind":"text","text":"In the second test case, the two constraints imply that cells $$$(1,1)$$$ and $$$(2,2)$$$ have the same letter and cells $$$(1,2)$$$ and $$$(2,1)$$$ have the same letter, which makes it impossible for the only $$$2 \\times 2$$$ subgrid to contain all three different letters."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1844E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1844/problem/E"}