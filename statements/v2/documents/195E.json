{"assets":["/statement-assets/7a010afd9a76412c1c95ff74ff0a30a4c3dc96593f53d557346f17d7f14a9b1e.png"],"contentKind":"statement","contestId":"195","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Building Forest"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"An "},{"children":[{"kind":"text","text":"oriented weighted forest"}],"kind":"container"},{"kind":"text","text":" is an acyclic weighted digraph in which from each vertex at most one edge goes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"root"}],"kind":"container"},{"kind":"text","text":" of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" of an oriented weighted forest is a vertex from which no edge goes and which can be reached from vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" moving along the edges of the weighted oriented forest. We denote the root of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"root(v)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"depth"}],"kind":"container"},{"kind":"text","text":" of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is the sum of weights of paths passing from the vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to its root. Let's denote the depth of the vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"depth(v)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's consider the process of constructing a weighted directed forest. Initially, the forest does not contain vertices. Vertices are added sequentially one by one. Overall, there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" performed operations of adding. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th "},{"kind":"math_inline","text":"(i > 0)"},{"kind":"text","text":" adding operation is described by a set of numbers "},{"kind":"math_inline","text":"(k,  v1,  x1,  v2,  x2,  ... ,  vk,  xk)"},{"kind":"text","text":" and means that we should add vertex number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" edges to the graph: an edge from vertex "},{"kind":"math_inline","text":"root(v1)"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" with weight "},{"kind":"math_inline","text":"depth(v1) + x1"},{"kind":"text","text":", an edge from vertex "},{"kind":"math_inline","text":"root(v2)"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" with weight "},{"kind":"math_inline","text":"depth(v2) + x2"},{"kind":"text","text":" and so on. If "},{"kind":"math_inline","text":"k = 0"},{"kind":"text","text":", then only vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is added to the graph, there are no added edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is like this: given the operations of adding vertices, calculate the sum of the weights of all edges of the forest, resulting after the application of all defined operations, modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":" — the number of operations of adding a vertex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain descriptions of the operations, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains the description of the operation of adding the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex in the following format: the first number of a line is an integer "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(0 ≤ k ≤ i - 1)"},{"kind":"text","text":", then follow "},{"kind":"math_inline","text":"2k"},{"kind":"text","text":" space-separated integers: "},{"kind":"math_inline","text":"v1, x1, v2, x2, ... , vk, xk"},{"kind":"math_inline","text":"(1 ≤ vj ≤ i - 1, |xj| ≤ 109)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The operations are given in the order, in which they should be applied to the graph. It is guaranteed that sum "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" of all operations does not exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":", also that applying operations of adding vertexes does not result in loops and multiple edges. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the sum of weights of all edges of the resulting graph modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n0\n0\n1 2 1\n2 1 5 2 2\n1 1 2\n1 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"30\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0\n1 1 5\n0\n0\n2 3 1 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Conside the first sample:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is added. "},{"kind":"math_inline","text":"k = 0"},{"kind":"text","text":", thus no edges are added."}],"kind":"list_item"},{"children":[{"kind":"text","text":" Vertex "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" is added. "},{"kind":"math_inline","text":"k = 0"},{"kind":"text","text":", thus no edges are added."}],"kind":"list_item"},{"children":[{"kind":"text","text":" Vertex "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" is added. "},{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":". "},{"kind":"math_inline","text":"v1 = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x1 = 1"},{"kind":"text","text":". Edge from vertex "},{"kind":"math_inline","text":"root(2) = 2"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" with weight "},{"kind":"math_inline","text":"depth(2) + x1 = 0 + 1 = 1"},{"kind":"text","text":" is added. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Vertex "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" is added. "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":". "},{"kind":"math_inline","text":"v1 = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x1 = 5"},{"kind":"text","text":". Edge from vertex "},{"kind":"math_inline","text":"root(1) = 1"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" with weight "},{"kind":"math_inline","text":"depth(1) + x1 = 0 + 5 = 5"},{"kind":"text","text":" is added. "},{"kind":"math_inline","text":"v2 = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2 = 2"},{"kind":"text","text":". Edge from vertex "},{"kind":"math_inline","text":"root(2) = 3"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" with weight "},{"kind":"math_inline","text":"depth(2) + x1 = 1 + 2 = 3"},{"kind":"text","text":" is added."}],"kind":"list_item"},{"children":[{"kind":"text","text":" Vertex "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" is added. "},{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":". "},{"kind":"math_inline","text":"v1 = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x1 = 2"},{"kind":"text","text":". Edge from vertex "},{"kind":"math_inline","text":"root(1) = 4"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" with weight "},{"kind":"math_inline","text":"depth(1) + x1 = 5 + 2 = 7"},{"kind":"text","text":" is added."}],"kind":"list_item"},{"children":[{"kind":"text","text":" Vertex "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" is added. "},{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":". "},{"kind":"math_inline","text":"v1 = 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x1 = 4"},{"kind":"text","text":". Edge from vertex "},{"kind":"math_inline","text":"root(3) = 5"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" with weight "},{"kind":"math_inline","text":"depth(3) + x1 = 10 + 4 = 14"},{"kind":"text","text":" is added."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The resulting graph is shown on the pictore below: "},{"attrs":{"alt":"","src":"/statement-assets/7a010afd9a76412c1c95ff74ff0a30a4c3dc96593f53d557346f17d7f14a9b1e.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"195E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/195/problem/E"}