{"assets":[],"contentKind":"statement","contestId":"954","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Runner's Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are running through a rectangular field. This field can be represented as a matrix with "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" columns. "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" denotes a cell belonging to "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You start in "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":" and have to end your path in "},{"kind":"math_inline","text":"(2, m)"},{"kind":"text","text":". From the cell "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" you may advance to:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"(i - 1, j + 1)"},{"kind":"text","text":" — only if "},{"kind":"math_inline","text":"i > 1"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"(i, j + 1)"},{"kind":"text","text":", or "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"(i + 1, j + 1)"},{"kind":"text","text":" — only if "},{"kind":"math_inline","text":"i < 3"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"However, there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" obstacles blocking your path. "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th obstacle is denoted by three integers "},{"kind":"math_inline","text":"ak"},{"kind":"text","text":", "},{"kind":"math_inline","text":"lk"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"rk"},{"kind":"text","text":", and it forbids entering any cell "},{"kind":"math_inline","text":"(ak, j)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"lk ≤ j ≤ rk"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to calculate the number of different paths from "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(2, m)"},{"kind":"text","text":", and print it modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 104"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3 ≤ m ≤ 1018"},{"kind":"text","text":") — the number of obstacles and the number of columns in the matrix, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, each containing three integers "},{"kind":"math_inline","text":"ak"},{"kind":"text","text":", "},{"kind":"math_inline","text":"lk"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"rk"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ak ≤ 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ lk ≤ rk ≤ m - 1"},{"kind":"text","text":") denoting an obstacle blocking every cell "},{"kind":"math_inline","text":"(ak, j)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"lk ≤ j ≤ rk"},{"kind":"text","text":". Some cells may be blocked by multiple obstacles."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of different paths from "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(2, m)"},{"kind":"text","text":", taken modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":". If it is impossible to get from "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(2, m)"},{"kind":"text","text":", then the number of paths is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 5\n1 3 4\n2 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"954F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/954/problem/F"}