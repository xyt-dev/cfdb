{"assets":["/statement-assets/11e1a26e89dd0df63d4b17a0ae34057d06e081c6bd236ab349df02bd9f3c6c19.png"],"contentKind":"statement","contestId":"808","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Tea Party"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp invited all his friends to the tea party to celebrate the holiday. He has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cups, one for each of his "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" friends, with volumes "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". His teapot stores "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" milliliters of tea ("},{"kind":"math_inline","text":"w ≤ a1 + a2 + ... + an"},{"kind":"text","text":"). Polycarp wants to pour tea in cups in such a way that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Every cup will contain tea for at least half of its volume "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Every cup will contain integer number of milliliters of tea "}],"kind":"list_item"},{"children":[{"kind":"text","text":" All the tea from the teapot will be poured into cups "}],"kind":"list_item"},{"children":[{"kind":"text","text":" All friends will be "},{"children":[{"kind":"text","text":"satisfied"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Friend with cup "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" won't be "},{"children":[{"kind":"text","text":"satisfied"}],"kind":"container"},{"kind":"text","text":", if there exists such cup "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" that cup "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" contains less tea than cup "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" but "},{"kind":"math_inline","text":"ai > aj"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each cup output how many milliliters of tea should be poured in it. If it's impossible to pour all the tea and satisfy all conditions then output "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/11e1a26e89dd0df63d4b17a0ae34057d06e081c6bd236ab349df02bd9f3c6c19.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output how many milliliters of tea every cup should contain. If there are