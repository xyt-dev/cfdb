{"assets":[],"contentKind":"statement","contestId":"123","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Prime Permutation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of small Latin letters. Let's denote the length of the string as "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":". The characters in the string are numbered starting from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find out if it is possible to rearrange characters in string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" so that for any prime number "},{"kind":"math_inline","text":"p ≤ |s|"},{"kind":"text","text":" and for any integer "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ranging from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"|s| / p"},{"kind":"text","text":" (inclusive) the following condition was fulfilled "},{"kind":"math_inline","text":"sp = sp × i"},{"kind":"text","text":". If the answer is positive, find one way to rearrange the characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains the initial string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of small Latin letters ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 1000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is possible to rearrange the characters in the string so that the above-mentioned conditions were fulfilled, then print in the first line \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) and print on the second line one of the possible resulting strings. If such permutation is impossible to perform, then print the single string \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nabc\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abcd\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"xxxyxxx\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nxxxxxxy\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample any of the six possible strings will do: \"abc\", \"acb\", \"bac\", \"bca\", \"cab\" or \"cba\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample no letter permutation will satisfy the condition at "},{"kind":"math_inline","text":"p = 2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"s2 = s4"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test any string where character \"y\" doesn't occupy positions 2, 3, 4, 6 will be valid."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"123A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/123/problem/A"}