{"assets":[],"contentKind":"statement","contestId":"152","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Marks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya, or Mr. Vasily Petrov is a dean of a department in a local university. After the winter exams he got his hands on a group's gradebook."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall the group has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students. They received marks for "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" subjects. Each student got a mark from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" (inclusive) for each subject."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's consider a student the "},{"children":[{"kind":"text","text":"best at some subject"}],"kind":"container"},{"kind":"text","text":", if there is no student who got a higher mark for this subject. Let's consider a student "},{"children":[{"kind":"text","text":"successful"}],"kind":"container"},{"kind":"text","text":", if there exists a subject he is the "},{"children":[{"kind":"text","text":"best at"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the number of "},{"children":[{"kind":"text","text":"successful"}],"kind":"container"},{"kind":"text","text":" students in the group."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100"},{"kind":"text","text":") — the number of students and the number of subjects, correspondingly. Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each containing "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters describe the gradebook. Each character in the gradebook is a number from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"9"},{"kind":"text","text":". Note that the marks in a rows are not sepatated by spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the single number — the number of "},{"children":[{"kind":"text","text":"successful"}],"kind":"container"},{"kind":"text","text":" students in the given group."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n223\n232\n112\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n91728\n11828\n11111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test the student number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is the best at subjects "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", student "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" is the best at subjects "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", but student "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" isn't the best at any subject."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test each student is the best at at least one subject."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"152A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/152/problem/A"}