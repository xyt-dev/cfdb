{"assets":[],"contentKind":"statement","contestId":"637","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Promocodes with Mistakes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"During a New Year special offer the \"Sudislavl Bars\" offered "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" promo codes. Each promo code consists of exactly six digits and gives right to one free cocktail at the bar \"Mosquito Shelter\". Of course, all the promocodes differ."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As the \"Mosquito Shelter\" opens only at 9, and partying in Sudislavl usually begins at as early as 6, many problems may arise as to how to type a promotional code without errors. It is necessary to calculate such maximum "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", that the promotional code could be uniquely identified if it was typed with no more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" errors. At that, "},{"kind":"math_inline","text":"k = 0"},{"kind":"text","text":" means that the promotional codes must be entered exactly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A mistake in this problem should be considered as entering the wrong numbers. For example, value \""},{"children":[{"kind":"text","text":"123465"}],"kind":"container"},{"kind":"text","text":"\" contains two errors relative to promocode \""},{"children":[{"kind":"text","text":"123456"}],"kind":"container"},{"kind":"text","text":"\". Regardless of the number of errors the entered value consists of exactly six digits."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the output contains number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":") — the number of promocodes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains a single promocode, consisting of exactly 6 digits. It is guaranteed that all the promocodes are distinct. Promocodes can start from digit \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" (naturally, not exceeding the length of the promocode), such that any promocode can be uniquely identified if it is typed with at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" mistakes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n000000\n999999\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n211111\n212111\n222111\n111111\n112111\n121111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample "},{"kind":"math_inline","text":"k < 3"},{"kind":"text","text":", so if a bar customer types in value \""},{"children":[{"kind":"text","text":"090909"}],"kind":"container"},{"kind":"text","text":"\", then it will be impossible to define which promocode exactly corresponds to it."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"637C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/637/problem/C"}