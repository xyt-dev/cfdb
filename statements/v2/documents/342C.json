{"assets":["/statement-assets/faf66db0ea222dff7a9506c1ec4b6b3e442d11d861dcdfb58b82b56e0cc23c1d.png","/statement-assets/28fbceab238528fe5f3ee07d0a741720068db7efd9b9b8638c37f53e1841690e.png"],"contentKind":"statement","contestId":"342","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Cupboard and Balloons"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A girl named Xenia has a cupboard that looks like an arc from ahead. The arc is made of a semicircle with radius "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" (the cupboard's top) and two walls of height "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" (the cupboard's sides). The cupboard's depth is "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", that is, it looks like a rectangle with base "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and height "},{"kind":"math_inline","text":"h + r"},{"kind":"text","text":" from the sides. The figure below shows what the cupboard looks like (the front view is on the left, the side view is on the right)."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/faf66db0ea222dff7a9506c1ec4b6b3e442d11d861dcdfb58b82b56e0cc23c1d.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Xenia got lots of balloons for her birthday. The girl hates the mess, so she wants to store the balloons in the cupboard. Luckily, each balloon is a sphere with radius "},{"attrs":{"alt":"","src":"/statement-assets/28fbceab238528fe5f3ee07d0a741720068db7efd9b9b8638c37f53e1841690e.png"},"kind":"image"},{"kind":"text","text":". Help Xenia calculate the maximum number of balloons she can put in her cupboard. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can say that a balloon is in the cupboard if you can't see any part of the balloon on the left or right view. The balloons in the cupboard can touch each other. It is not allowed to squeeze the balloons or deform them in any way. You can assume that the cupboard's walls are negligibly thin."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains two integers "},{"kind":"math_inline","text":"r, h"},{"kind":"math_inline","text":"(1 ≤ r, h ≤ 107)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maximum number of balloons Xenia can put in the cupboard."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"342C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/342/problem/C"}