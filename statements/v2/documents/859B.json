{"assets":["/statement-assets/445f9b35acd5ab77fe427a6a1bc46b2133fbd78c4442653984092ab7c766161e.png"],"contentKind":"statement","contestId":"859","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Lazy Security Guard"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Your security guard friend recently got a new job at a new security company. The company requires him to patrol an area of the city encompassing exactly "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" city blocks, but they let him choose which blocks. That is, your friend must walk the perimeter of a region whose area is exactly "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" blocks. Your friend is quite lazy and would like your help to find the shortest possible route that meets the requirements. The city is laid out in a square grid pattern, and is large enough that for the sake of the problem it can be considered infinite."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Input will consist of a single integer "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ N ≤ 106"},{"kind":"text","text":"), the number of city blocks that must be enclosed by the route."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"at