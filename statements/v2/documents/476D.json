only if for all pairs of distinct elements "},{"kind":"math_inline","text":"si"},{"kind":"text","text":", "},{"kind":"math_inline","text":"sj"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"S"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/ff30e5a89bc54aeb415dd5665fbae9e36339fd3e765624a45d04321ec35779b4.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", Dreamoon wants to make up "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sets of rank "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" using integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" such that no integer is used in two different sets (of course you can leave some integers without use). Calculate the minimum "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" that makes it possible and print one possible solution."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line of the input contains two space separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10 000, 1 ≤ k ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first line print a single integer — the minimal possible "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines print four space separated integers representing the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th set."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Neither the order of the sets nor the order of integers within a set is important. If there are multiple possible solutions with minimal "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", print any one of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"22\n2 4 6 22\n14 18 10 16\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first example it's easy to see that set "},{"kind":"math_inline","text":"{1, 2, 3, 4}"},{"kind":"text","text":" isn't a valid set of rank 1 since "},{"attrs":{"alt":"","src":"/statement-assets/74c357cc917e66b9c99493bd4219ba62526284a23bbcd1c508213