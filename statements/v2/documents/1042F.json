{"assets":["/statement-assets/27fca5f6cae1cb621e6b6c48fb91fe72f2ee9ce6285b785792bff91a01f9c205.png"],"contentKind":"statement","contestId":"1042","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Leaf Sets"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an undirected tree, consisting of $$$n$$$ vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The vertex is called a leaf if it has exactly one vertex adjacent to it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The distance between some pair of vertices is the number of edges in the shortest path between them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call some set of leaves "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if the maximum distance between any pair of leaves in it is less or equal to $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You want to split "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" leaves into "},{"children":[{"kind":"text","text":"non-intersecting"}],"kind":"container"},{"kind":"text","text":" beautiful sets. What is the minimal number of sets in such a split?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$k$$$ ($$$3 \\le n \\le 10^6$$$, $$$1 \\le k \\le 10^6$$$) — the number of vertices in the tree and the maximum distance between any pair of leaves in each beautiful set."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n - 1$$$ lines contains two integers $$$v_i$$$ and $$$u_i$$$ ($$$1 \\le v_i, u_i \\le n$$$) — the description of the $$$i$$$-th edge. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given edges form a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimal number of beautiful sets the split can have. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9 3\n1 2\n1 3\n2 4\n2 5\n3 6\n6 7\n6 8\n3 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n1 2\n2 3\n3 4\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 1\n1 2\n1 3\n1 4\n1 5\n1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here is the graph for the first example:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/27fca5f6cae1cb621e6b6c48fb91fe72f2ee9ce6285b785792bff91a01f9c205.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1042F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1042/problem/F"}