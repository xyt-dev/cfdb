{"assets":[],"contentKind":"statement","contestId":"448","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Divisors"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bizon the Champion isn't just friendly, he also is a rigorous coder."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define function "},{"kind":"math_inline","text":"f(a)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is a sequence of integers. Function "},{"kind":"math_inline","text":"f(a)"},{"kind":"text","text":" returns the following sequence: first all divisors of "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":" go in the increasing order, then all divisors of "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":" go in the increasing order, and so on till the last element of sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". For example, "},{"kind":"math_inline","text":"f([2, 9, 1]) = [1, 2, 1, 3, 9, 1]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's determine the sequence "},{"kind":"math_inline","text":"Xi"},{"kind":"text","text":", for integer "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(i ≥ 0)"},{"kind":"text","text":": "},{"kind":"math_inline","text":"X0 = [X]"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"[X]"},{"kind":"text","text":" is a sequence consisting of a single number "},{"kind":"math_inline","text":"X"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"Xi = f(Xi - 1)"},{"kind":"math_inline","text":"(i > 0)"},{"kind":"text","text":". For example, at "},{"kind":"math_inline","text":"X = 6"},{"kind":"text","text":" we get "},{"kind":"math_inline","text":"X0 = [6]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"X1 = [1, 2, 3, 6]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"X2 = [1, 1, 2, 1, 3, 1, 2, 3, 6]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the numbers "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", find the sequence "},{"kind":"math_inline","text":"Xk"},{"kind":"text","text":". As the answer can be rather large, find only the first "},{"kind":"math_inline","text":"105"},{"kind":"text","text":" elements of this sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line contains two space-separated integers — "},{"kind":"math_inline","text":"X"},{"kind":"math_inline","text":"(1 ≤ X ≤ 1012)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(0 ≤ k ≤ 1018)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the elements of the sequence "},{"kind":"math_inline","text":"Xk"},{"kind":"text","text":" in a single line, separated by a space. If the number of elements exceeds "},{"kind":"math_inline","text":"105"},{"kind":"text","text":", then print only the first "},{"kind":"math_inline","text":"105"},{"kind":"text","text":" elements."}],"kind":"paragraph"}],"kind":"section"},{