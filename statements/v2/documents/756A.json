{"assets":[],"contentKind":"statement","contestId":"756","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Pavel and barbecue"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pavel cooks barbecue. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" skewers, they lay on a brazier in a row, each on one of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positions. Pavel wants each skewer to be cooked some time in every of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positions in two directions: in the one it was directed originally and in the reversed direction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pavel has a plan: a permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and a sequence "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":", consisting of zeros and ones. Each second Pavel move skewer on position "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to position "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":", and if "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" equals "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" then he reverses it. So he hope that every skewer will visit every position in both directions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, not every pair of permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" suits Pavel. What is the minimum total number of elements in the given permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and the given sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" he needs to change so that every skewer will visit each of "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" placements? Note that after changing the permutation should remain a permutation as well."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is no problem for Pavel, if some skewer visits some of the placements several times before he ends to cook. In other words, a permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and a sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" suit him if there is an integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"k ≥ 2n"},{"kind":"text","text":"), so that after "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" seconds each skewer visits each of the "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" placements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It can be shown that some suitable pair of permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" exists for any "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contain the integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105"},{"kind":"text","text":") — the number of skewers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence of integers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":") — the permutation, according to which Pavel wants to move the skewers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a sequence "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" consisting of zeros and ones, according to which Pavel wants to reverse the skewers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print single integer — the minimum total number of elements in the given permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and the given sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" he needs to change so that every skewer will visit each of "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" placements."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n4 3 2 1\n0 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 3 1\n0 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Pavel can change the permutation to "},{"kind":"math_inline","text":"4, 3, 1, 2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example Pavel can change any element of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"756A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/756/problem/A"}