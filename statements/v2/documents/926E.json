{"assets":[],"contentKind":"statement","contestId":"926","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Merge Equal Elements"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a sequence of positive integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"While possible, you perform the following operation: find a pair of equal consecutive elements. If there are more than one such pair, find the leftmost (with the smallest indices of elements). If the two integers are equal to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", delete both and insert a single integer "},{"kind":"math_inline","text":"x + 1"},{"kind":"text","text":" on their place. This way the number of elements in the sequence is decreased by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" on each step. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You stop performing the operation when there is no pair of equal consecutive elements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if the initial sequence is "},{"kind":"math_inline","text":"[5, 2, 1, 1, 2, 2]"},{"kind":"text","text":", then after the first operation you get "},{"kind":"math_inline","text":"[5, 2, 2, 2, 2]"},{"kind":"text","text":", after the second — "},{"kind":"math_inline","text":"[5, 3, 2, 2]"},{"kind":"text","text":", after the third — "},{"kind":"math_inline","text":"[5, 3, 3]"},{"kind":"text","text":", and finally after the fourth you get "},{"kind":"math_inline","text":"[5, 4]"},{"kind":"text","text":". After that there are no equal consecutive elements left in the sequence, so you stop the process."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the final sequence after you stop performing the operation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2·105"},{"kind":"text","text":") — the number of elements in the sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the sequence of integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of elements in the sequence after you stop performing the operation. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers — the sequence after you stop performing the operation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n5 2 1 1 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n5 4 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1000000000 1000000000 1000000000 1000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1000000002 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n4 10 22 11 12 5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n4 10 22 11 12 5 6 "}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first example is described in the statements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the initial sequence is "},{"kind":"math_inline","text":"[1000000000, 1000000000, 1000000000, 1000000000]"},{"kind":"text","text":". After the first operation the sequence is equal to "},{"kind":"math_inline","text":"[1000000001, 1000000000, 1000000000]"},{"kind":"text","text":". After the second operation the sequence is "},{"kind":"math_inline","text":"[1000000001, 1000000001]"},{"kind":"text","text":". After the third operation the sequence is "},{"kind":"math_inline","text":"[1000000002]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example there are no two equal consecutive elements initially, so the sequence does not change."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"926E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/926/problem/E"}