{"assets":["/statement-assets/d3be7d5c73402394fe9ec69ca71139cef226e2d9a371b320aa47da2f4bf3a6ac.png","/statement-assets/de7f0e0f7f6c7b9d329dd50f6a4ed4b413810e16728f105bb0011c9cb5a922b0.png","/statement-assets/a0273f81ac7433de949522f5a5562f2d0ae19bf6961f266ec25cda68c884b350.png"],"contentKind":"statement","contestId":"399","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Red and Blue Balls"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"0.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"User ainta has a stack of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" red and blue balls. He can apply a certain operation which changes the colors of the balls inside the stack."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" While the top ball inside the stack is red, pop the ball from the top of the stack. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then replace the blue ball on the top with a red ball. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" And finally push some blue balls to the stack until the stack has total of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" balls inside. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there are no blue balls inside the stack, ainta can't apply this operation. Given the initial state of the stack, ainta wants to know the maximum number of operations he can repeatedly apply."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50"},{"kind":"text","text":") — the number of balls inside the stack."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|s| = n"},{"kind":"text","text":") describing the initial state of the stack. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" denotes the color of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ball (we'll number the balls from top to bottom of the stack). If the character is \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\", the color is red. If the character is \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\", the color is blue."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum number of operations ainta can repeatedly apply."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not write the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nRBR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nRBBR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nRBBRR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first example is depicted below."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The explanation how user ainta applies the first operation. He pops out one red ball, changes the color of the ball in the middle from blue to red, and pushes one blue ball."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d3be7d5c73402394fe9ec69ca71139cef226e2d9a371b320aa47da2f4bf3a6ac.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The explanation how user ainta applies the second operation. He will not pop out red balls, he simply changes the color of the ball on the top from blue to red."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/de7f0e0f7f6c7b9d329dd50f6a4ed4b413810e16728f105bb0011c9cb5a922b0.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"From now on, ainta can't apply any operation because there are no blue balls inside the stack. ainta applied two operations, so the answer is 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second example is depicted below. The blue arrow denotes a single operation."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a0273f81ac7433de949522f5a5562f2d0ae19bf6961f266ec25cda68c884b350.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"399B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/399/problem/B"}