{"assets":["/statement-assets/60d04bf09e3275377cc990c45bfe97e8bbca1c35a5ad703b892d640772664693.png"],"contentKind":"statement","contestId":"682","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Alyona and Triangles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" points with integer coordinates on the plane. Points are given in a way such that there is no triangle, formed by any three of these "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" points, which area exceeds "},{"kind":"math_inline","text":"S"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Alyona tried to construct a triangle with integer coordinates, which contains all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" points and which area doesn't exceed "},{"kind":"math_inline","text":"4S"},{"kind":"text","text":", but, by obvious reason, had no success in that. Please help Alyona construct such triangle. Please note that vertices of resulting triangle are not necessarily chosen from "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" given points."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line of the input two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 5000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ S ≤ 1018"},{"kind":"text","text":") are given — the number of points given and the upper bound value of any triangle's area, formed by any three of given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines describes given points: "},{"kind":"math_inline","text":"ith"},{"kind":"text","text":" of them consists of two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"math_inline","text":"( - 108 ≤ xi, yi ≤ 108)"},{"kind":"text","text":" — coordinates of "},{"kind":"math_inline","text":"ith"},{"kind":"text","text":" point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there is at least one triple of points not lying on the same line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the coordinates of three points — vertices of a triangle which contains all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" points and which area doesn't exceed "},{"kind":"math_inline","text":"4S"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Coordinates of every triangle's vertex should be printed on a separate line, every coordinate pair should be separated by a single space. Coordinates should be an integers not exceeding "},{"kind":"math_inline","text":"109"},{"kind":"text","text":" by absolute value."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there is at least one desired triangle. If there is more than one answer, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n0 0\n1 0\n0 1\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1 0\n2 0\n0 2"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/60d04bf09e3275377cc990c45bfe97e8bbca1c35a5ad703b892d640772664693.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"682E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/682/problem/E"}