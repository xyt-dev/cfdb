{"assets":[],"contentKind":"statement","contestId":"386","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Fly, freebies, fly!"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Everyone loves a freebie. Especially students."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is well-known that if in the night before exam a student opens window, opens the student's record-book and shouts loudly three times \"Fly, freebie, fly!\" — then flown freebie helps him to pass the upcoming exam."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the night before the exam on mathematical analysis "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students living in dormitory shouted treasured words. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th student made a sacrament at the time "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" is the number of seconds elapsed since the beginning of the night."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is known that the freebie is a capricious and willful lady. That night the freebie was near dormitory only for "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" seconds. Therefore, if for two students their sacrament times differ for more than "},{"kind":"math_inline","text":"T"},{"kind":"text","text":", then the freebie didn't visit at least one of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since all students are optimists, they really want to know what is the maximal number of students visited by the freebie can be."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the number of students shouted \"Fly, freebie, fly!\" The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 1000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line contains integer "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ T ≤ 1000"},{"kind":"text","text":") — the time interval during which the freebie was near the dormitory."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the largest number of people who will pass exam tomorrow because of the freebie visit."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n4 1 7 8 3 8\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"386B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/386/problem/B"}