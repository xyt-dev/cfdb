{"assets":["/statement-assets/cccb3132e9bb9565063560d18e51f1fb9cc78dfb78c5e4942d91afbb60a94a28.png","/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png","/statement-assets/8572c63e50049db0a1be936bead987c1d38e99d4fdaa1a3f9d31712c25af35ac.png","/statement-assets/fed9bdc3458e6c7655941a4a0fa94fe3716334a3061117d143b8e7c6573a9e7e.png"],"contentKind":"statement","contestId":"817","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Choosing The Commander"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As you might remember from the previous round, Vova is currently playing a strategic game known as Rage of Empires."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vova managed to build a large army, but forgot about the main person in the army - the commander. So he tries to hire a commander, and he wants to choose the person who will be respected by warriors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each warrior is represented by his personality — an integer number "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":". Each commander has two characteristics — his personality "},{"kind":"math_inline","text":"pj"},{"kind":"text","text":" and leadership "},{"kind":"math_inline","text":"lj"},{"kind":"text","text":" (both are integer numbers). Warrior "},{"kind":"math_inline","text":"i"},{"children":[{"kind":"text","text":"respects"}],"kind":"container"},{"kind":"text","text":" commander "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" only if "},{"attrs":{"alt":"","src":"/statement-assets/cccb3132e9bb9565063560d18e51f1fb9cc78dfb78c5e4942d91afbb60a94a28.png"},"kind":"image"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"},"kind":"image"},{"kind":"text","text":" is the bitwise excluding OR of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially Vova's army is empty. There are three different types of events that can happen with the army:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1 pi"},{"kind":"text","text":" — one warrior with personality "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" joins Vova's army; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2 pi"},{"kind":"text","text":" — one warrior with personality "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" leaves Vova's army; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"3 pi li"},{"kind":"text","text":" — Vova tries to hire a commander with personality "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and leadership "},{"kind":"math_inline","text":"li"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For each event of the third type Vova wants to know how many warriors (counting only those who joined the army and haven't left yet) "},{"children":[{"kind":"text","text":"respect"}],"kind":"container"},{"kind":"text","text":" the commander he tries to hire."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 100000"},{"kind":"text","text":") — the number of events."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines follow. Each line describes the event:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1 pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ 108"},{"kind":"text","text":") — one warrior with personality "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" joins Vova's army; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2 pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ 108"},{"kind":"text","text":") — one warrior with personality "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" leaves Vova's army (it is guaranteed that there is at least one such warrior in Vova's army by this moment); "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"3 pi li"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi, li ≤ 108"},{"kind":"text","text":") — Vova tries to hire a commander with personality "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and leadership "},{"kind":"math_inline","text":"li"},{"kind":"text","text":". There is at least one event of this type. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each event of the third type print one integer — the number of warriors who "},{"children":[{"kind":"text","text":"respect"}],"kind":"container"},{"kind":"text","text":" the commander Vova tries to hire in the event."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 3\n1 4\n3 6 3\n2 4\n3 6 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the example the army consists of two warriors with personalities "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" after first two events. Then Vova tries to hire a commander with personality "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" and leadership "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", and only one warrior respects him ("},{"attrs":{"alt":"","src":"/statement-assets/8572c63e50049db0a1be936bead987c1d38e99d4fdaa1a3f9d31712c25af35ac.png"},"kind":"image"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"2 < 3"},{"kind":"text","text":", but "},{"attrs":{"alt":"","src":"/statement-assets/fed9bdc3458e6c7655941a4a0fa94fe3716334a3061117d143b8e7c6573a9e7e.png"},"kind":"image"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"5 ≥ 3"},{"kind":"text","text":"). Then warrior with personality "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" leaves, and when Vova tries to hire that commander again, there are no warriors who respect him."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"817E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/817/problem/E"}