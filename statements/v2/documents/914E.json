{"assets":[],"contentKind":"statement","contestId":"914","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Palindromes in a Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a tree (a connected acyclic undirected graph) of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. Vertices are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and each vertex is assigned a character from "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"t"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A path in the tree is said to be palindromic if at least one permutation of the labels in the path is a palindrome."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each vertex, output the number of palindromic paths passing through it. "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note:"}],"kind":"container"},{"kind":"text","text":" The path from vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is considered to be the same as the path from vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", and this path will be counted only once for each of the vertices it passes through."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2·105"},{"kind":"text","text":")  — the number of vertices in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines each contain two integers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤  u, v  ≤  n, u ≠ v"},{"kind":"text","text":") denoting an edge connecting vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". It is guaranteed that the given graph is a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains a string consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase characters from "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"t"}],"kind":"container"},{"kind":"text","text":" where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") character is the label of vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" in the tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers in a single line, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of which is the number of palindromic paths passing through vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" in the tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2\n2 3\n3 4\n3 5\nabcbb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3 4 3 3 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n6 2\n4 3\n3 7\n5 2\n7 2\n1 4\nafefdfs\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 4 1 1 2 4 2 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case, the following paths are palindromic:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"2 - 3 - 4"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"2 - 3 - 5"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"4 - 3 - 5"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additionally, all paths containing only one vertex are palindromic. Listed below are a few paths in the first sample that are not palindromic:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"1 - 2 - 3"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"1 - 2 - 3 - 4"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"1 - 2 - 3 - 5"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"914E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/914/problem/E"}