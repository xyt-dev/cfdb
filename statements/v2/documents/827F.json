{"assets":[],"contentKind":"statement","contestId":"827","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Dirty Arkady's Kitchen"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"6 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Arkady likes to walk around his kitchen. His labyrinthine kitchen consists of several important places connected with passages. Unfortunately it happens that these passages are flooded with milk so that it's impossible to pass through them. Namely, it's possible to pass through each passage in any direction only during some time interval."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The lengths of all passages are equal and Arkady makes through them in one second. For security reasons, Arkady can never stop, also, he can't change direction while going through a passage. In other words, if he starts walking in some passage, he should reach its end and immediately leave the end."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Today Arkady needs to quickly reach important place "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from place "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". He plans to exit the place "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" at time moment "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and reach the place "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" as early as he can. Please find the minimum time he should spend on his way."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ m ≤ 5·105"},{"kind":"text","text":") — the number of important places and the number of passages, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After that, "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follow, each of them describe one passage. Each line contains four integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a ≠ b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ l < r ≤ 109"},{"kind":"text","text":") — the places the passage connects and the time segment during which it's possible to use this passage."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — minimum time Arkady should spend to reach the destination. If he can't reach the place "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6\n1 2 0 1\n2 5 2 3\n2 5 0 1\n1 3 0 1\n3 4 1 2\n4 5 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n1 2 1 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Arkady should go through important places "},{"kind":"math_inline","text":"1 → 3 → 4 → 5"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example Arkady can't start his walk because at time moment "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" it's impossible to use the only passage."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"827F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/827/problem/F"}