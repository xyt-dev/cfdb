{"assets":[],"contentKind":"statement","contestId":"169","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Replacing Digits"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an integer "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" that consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" digits. You are also given a sequence of digits "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". The digit in position "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j ≤ m"},{"kind":"text","text":") of sequence "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" means that you can choose an arbitrary position "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") in "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and replace the digit in the chosen position "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"sj"},{"kind":"text","text":". Each element in the sequence "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" can participate in no more than one replacing operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to perform such sequence of replacements, that the given number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" gets maximum value. You are allowed to use not all elements from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains positive integer "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". Its length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is positive and doesn't exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":". The second line contains sequence of digits "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Its length "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is positive and doesn't exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":". The digits in the sequence "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" are written consecutively without any separators."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The given number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" doesn't contain leading zeroes. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum value that can be obtained from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" after a series of replacements. You are allowed to use not all elements from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". The printed number shouldn't contain any leading zeroes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[