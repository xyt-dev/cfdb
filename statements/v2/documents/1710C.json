{"assets":[],"contentKind":"statement","contestId":"1710","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. XOR Triangle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a positive integer $$$n$$$. Since $$$n$$$ may be very large, you are given its binary representation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You should compute the number of triples $$$(a,b,c)$$$ with $$$0 \\leq a,b,c \\leq n$$$ such that $$$a \\oplus b$$$, $$$b \\oplus c$$$, and $$$a \\oplus c$$$ are the sides of a non-degenerate triangle. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here, $$$\\oplus$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise XOR operation"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You should output the answer modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Three positive values $$$x$$$, $$$y$$$, and $$$z$$$ are the sides of a non-degenerate triangle if and only if $$$x+y \\gt z$$$, $$$x+z \\gt y$$$, and $$$y+z \\gt x$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and only line contains the binary representation of an integer $$$n$$$ ($$$0 \\lt n \\lt 2^{200\\,000}$$$) without leading zeros."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the string "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" is the binary representation of the number $$$2$$$, while the string "},{"children":[{"kind":"text","text":"1010"}],"kind":"container"},{"kind":"text","text":" represents the number $$$10$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the number of triples $$$(a,b,c)$$$ satisfying the conditions described in the statement modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n101\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n12\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n780\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n11011111101010010\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n141427753\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, $$$101_2=5$$$."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The triple $$$(a, b, c) = (0, 3, 5)$$$ is valid because $$$(a\\oplus b, b\\oplus c, c\\oplus a) = (3, 6, 5)$$$ are the sides of a non-degenerate triangle. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The triple $$$(a, b, c) = (1, 2, 4)$$$ is valid because $$$(a\\oplus b, b\\oplus c, c\\oplus a) = (3, 6, 5)$$$ are the sides of a non-degenerate triangle. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The $$$6$$$ permutations of each of these two triples are all the valid triples, thus the answer is $$$12$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, $$$11\\,011\\,111\\,101\\,010\\,010_2=114\\,514$$$. The full answer (before taking the modulo) is $$$1\\,466\\,408\\,118\\,808\\,164$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1710C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1710/problem/C"}