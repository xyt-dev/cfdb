{"assets":["/statement-assets/f1e97aaeeeea00b4f425d9af0d162da5f50c938b12444d748fb7e43faa8504fe.png"],"contentKind":"statement","contestId":"847","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"L. Berland SU Computer Network"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In the computer network of the Berland State University there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" routers numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Some pairs of routers are connected by patch cords. Information can be transmitted over patch cords in both direction. The network is arranged in such a way that communication between any two routers (directly or through other routers) is possible. There are no cycles in the network, so there is only one path between each pair of routers over patch cords."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, the exact topology of the network was lost by administrators. In order to restore it, the following auxiliary information was collected."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each patch cord "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", directly connected to the router "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", list of routers located behind the patch cord "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" relatively "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is known. In other words, all routers path from which to the router "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" goes through "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" are known. So for each router "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" there are "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" lists, where "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" is the number of patch cords connected to "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, let the network consists of three routers connected in chain "},{"kind":"math_inline","text":"1 - 2 - 3"},{"kind":"text","text":". Then:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the router "},{"kind":"math_inline","text":"1"},{"kind":"text","text":": for the single patch cord connected to the first router there is a single list containing two routers: "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the router "},{"kind":"math_inline","text":"2"},{"kind":"text","text":": for each of the patch cords connected to the second router there is a list: one list contains the router "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and the other — the router "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the router "},{"kind":"math_inline","text":"3"},{"kind":"text","text":": for the single patch cord connected to the third router there is a single list containing two routers: "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is to help administrators to restore the network topology, i. e. to identify all pairs of routers directly connected by a patch cord."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 1000"},{"kind":"text","text":") — the number of routers in the network."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains a description of the lists for the router "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The description of each list begins with the number of routers in it. Then the symbol '"},{"children":[{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"' follows, and after that the numbers of routers from the list are given. This numbers are separated by comma. Lists are separated by symbol '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed, that for each router "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" the total number of routers in its lists equals to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" and all the numbers in lists of each router are distinct. For each router "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" lists do not contain the number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if no solution exists."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the other case print to the first line "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" — the total number of patch cords in the network. In each of the following "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines print two integers — the routers which are directly connected by a patch cord. Information about each patch cord must be printed exactly once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Patch cords and routers can be printed in arbitrary order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2:3,2\n1:1-1:3\n2:1,2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 1\n2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n4:2,5,3,4\n1:4-1:1-2:5,3\n4:4,5,2,1\n4:2,1,3,5\n1:3-3:4,2,1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 1\n2 4\n5 2\n3 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1:2-1:3\n1:1-1:3\n1:1-1:2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first example is analyzed in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer to the second example is shown on the picture."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f1e97aaeeeea00b4f425d9af0d162da5f50c938b12444d748fb7e43faa8504fe.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The first router has one list, which contains all other routers. The second router has three lists: the first — the single router "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", the second — the single router "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", the third — two routers "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". The third router has one list, which contains all other routers. The fourth router also has one list, which contains all other routers. The fifth router has two lists: the first — the single router "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", the second — three routers "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"L","problemCode":"847L","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/847/problem/L"}