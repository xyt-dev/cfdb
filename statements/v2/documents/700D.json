{"assets":[],"contentKind":"statement","contestId":"700","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Huffman Coding on Segment"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Alice wants to send an important message to Bob. Message "},{"kind":"math_inline","text":"a = (a1, ..., an)"},{"kind":"text","text":" is a sequence of positive integers ("},{"children":[{"kind":"text","text":"characters"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To compress the message Alice wants to use binary Huffman coding. We recall that "},{"children":[{"kind":"text","text":"binary Huffman code"}],"kind":"container"},{"kind":"text","text":", or "},{"children":[{"kind":"text","text":"binary prefix code"}],"kind":"container"},{"kind":"text","text":" is a function "},{"kind":"math_inline","text":"f"},{"kind":"text","text":", that maps each letter that appears in the string to some binary string (that is, string consisting of characters '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' only) such that for each pair of different characters "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"aj"},{"kind":"text","text":" string "},{"kind":"math_inline","text":"f(ai)"},{"kind":"text","text":" is not a prefix of "},{"kind":"math_inline","text":"f(aj)"},{"kind":"text","text":" (and vice versa). The result of the encoding of the message "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" is the concatenation of the encoding of each character, that is the string "},{"kind":"math_inline","text":"f(a1)f(a2)... f(an)"},{"kind":"text","text":". Huffman codes are very useful, as the compressed message can be easily and uniquely decompressed, if the function "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" is given. Code is usually chosen in order to minimize the total length of the compressed message, i.e. the length of the string "},{"kind":"math_inline","text":"f(a1)f(a2)... f(an)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Because of security issues Alice doesn't want to send the whole message. Instead, she picks some substrings of the message and wants to send them separately. For each of the given substrings "},{"kind":"math_inline","text":"ali... ari"},{"kind":"text","text":" she wants to know the minimum possible length of the Huffman coding. Help her solve this problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains the single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the length of the initial message. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 100 000"},{"kind":"text","text":") — characters of the message."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains the single integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 100 000"},{"kind":"text","text":") — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines with queries descriptions. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":") — the position of the left and right ends of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th substring respectively. Positions are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Substrings may overlap in any way. The same substring may appear in the input more than once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines. Each line should contain a single integer — the minimum possible length of the Huffman encoding of the substring "},{"kind":"math_inline","text":"ali... ari"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 2 1 3 1 2 1\n5\n1 7\n1 3\n3 5\n2 4\n4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n3\n3\n5\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first query, one of the optimal ways to encode the substring is to map "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to \""},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":"\" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" to \""},{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that it is correct to map the letter to the empty substring (as in the fifth query from the sample)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"700D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/700/problem/D"}