{"assets":[],"contentKind":"statement","contestId":"1873","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Short Sort"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are three cards with letters $$$\\texttt{a}$$$, $$$\\texttt{b}$$$, $$$\\texttt{c}$$$ placed in a row in some order. You can do the following operation "},{"children":[{"kind":"text","text":"at most once"}],"kind":"container"},{"kind":"text","text":": "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Pick two cards, and swap them. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" Is it possible that the row becomes $$$\\texttt{abc}$$$ after the operation? Output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if it is possible, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 6$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a single string consisting of each of the three characters $$$\\texttt{a}$$$, $$$\\texttt{b}$$$, and $$$\\texttt{c}$$$ exactly once, representing the cards."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if you can make the row $$$\\texttt{abc}$$$ with at most one operation, or \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output the answer in any case (for example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be recognized as a positive answer)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\nabc\nacb\nbac\nbca\ncab\ncba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nYES\nYES\nNO\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, we don't need to do any operations, since the row is already $$$\\texttt{abc}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, we can swap $$$\\texttt{c}$$$ and $$$\\texttt{b}$$$: $$$\\texttt{acb} \\to \\texttt{abc}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, we can swap $$$\\texttt{b}$$$ and $$$\\texttt{a}$$$: $$$\\texttt{bac} \\to \\texttt{abc}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, it is impossible to make $$$\\texttt{abc}$$$ using "},{"children":[{"kind":"text","text":"at most one"}],"kind":"container"},{"kind":"text","text":" operation."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1873A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1873/problem/A"}