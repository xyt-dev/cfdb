{"assets":[],"contentKind":"statement","contestId":"581","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Luxurious Houses"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The capital of Berland has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" multifloor buildings. The architect who built up the capital was very creative, so all the houses were built in one row."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's enumerate all the houses from left to right, starting with one. A house is considered to be "},{"children":[{"kind":"text","text":"luxurious"}],"kind":"container"},{"kind":"text","text":" if the number of floors in it is strictly greater than in all the houses with larger numbers. In other words, a house is luxurious if the number of floors in it is strictly greater than in all the houses, which are located to the right from it. In this task it is assumed that the heights of floors in the houses are the same."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The new architect is interested in "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" questions, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them is about the following: \"how many floors should be added to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th house to make it luxurious?\" (for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", inclusive). You need to help him cope with this task."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that all these questions are independent from each other — the answer to the question for house "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" does not affect other answers (i.e., the floors to the houses are not actually added)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of houses in the capital of Berland."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated positive integers "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ hi ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" equals the number of floors in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th house. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":", where number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the number of floors that need to be added to the house number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to make it luxurious. If the house is already luxurious and nothing needs to be added to it, then "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" should be equal to zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All houses are numbered from left to right, starting from one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 2 0 2 0 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n3 2 1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 3 4 0 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"581B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/581/problem/B"}