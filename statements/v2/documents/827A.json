{"assets":[],"contentKind":"statement","contestId":"827","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. String Reconstruction"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ivan had string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of small English letters. However, his friend Julia decided to make fun of him and hid the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Ivan preferred making a new string to finding the old one. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ivan knows some information about the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Namely, he remembers, that string "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" occurs in string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" at least "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" times or more, he also remembers exactly "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" positions where the string "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" occurs in string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":": these positions are "},{"kind":"math_inline","text":"xi, 1, xi, 2, ..., xi, ki"},{"kind":"text","text":". He remembers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" such strings "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are to reconstruct "},{"children":[{"kind":"text","text":"lexicographically minimal"}],"kind":"container"},{"kind":"text","text":" string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" such that it fits all the information Ivan remembers. Strings "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" and string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consist of small English letters only."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of strings Ivan remembers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain information about the strings. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains non-empty string "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", then positive integer "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":", which equal to the number of times the string "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" occurs in string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", and then "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" distinct positive integers "},{"kind":"math_inline","text":"xi, 1, xi, 2, ..., xi, ki"},{"kind":"text","text":" in increasing order — positions, in which occurrences of the string "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" in the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" start. It is guaranteed that the sum of lengths of strings "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" doesn't exceed "},{"kind":"math_inline","text":"106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ xi, j ≤ 106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ki ≤ 106"},{"kind":"text","text":", and the sum of all "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" doesn't exceed "},{"kind":"math_inline","text":"106"},{"kind":"text","text":". The strings "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" can coincide."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the input data is not self-contradictory, and thus at least one answer "},{"children":[{"kind":"text","text":"always"}],"kind":"container"},{"kind":"text","text":" exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print lexicographically minimal string that fits all the information Ivan remembers. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\na 4 1 3 5 7\nab 2 1 5\nca 1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"abacaba\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\na 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}]