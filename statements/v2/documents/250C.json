{"assets":[],"contentKind":"statement","contestId":"250","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Movie Critics"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A film festival is coming up in the city N. The festival will last for exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days and each day will have a premiere of exactly one film. Each film has a genre — an integer from 1 to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day the festival will show a movie of genre "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". We know that a movie of each of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" genres occurs in the festival programme at least once. In other words, each integer from 1 to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" occurs in the sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" at least once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valentine is a movie critic. He wants to watch some movies of the festival and then describe his impressions on his site."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As any creative person, Valentine is very susceptive. After he watched the movie of a certain genre, Valentine forms the "},{"children":[{"kind":"text","text":"mood"}],"kind":"container"},{"kind":"text","text":" he preserves until he watches the next movie. If the genre of the next movie is the same, it does not change Valentine's mood. If the genres are different, Valentine's mood changes according to the new genre and Valentine has a "},{"children":[{"kind":"text","text":"stress"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valentine can't watch all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" movies, so he decided to exclude from his to-watch list movies of one of the genres. In other words, Valentine is going to choose exactly one of the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" genres and will skip all the movies of this genre. He is sure to visit other movies."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valentine wants to choose such genre "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ k"},{"kind":"text","text":"), that the total number of after-movie stresses (after all movies of genre "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" are excluded) were minimum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ k ≤ n ≤ 105"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the number of movies and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is the number of genres."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ k"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the genre of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th movie. It is guaranteed that each number from 1 to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" occurs at least once in this sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the number of the genre (from 1 to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":") of the excluded films. If there are multiple answers, print the genre with the minimum number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 3\n1 1 2 3 2 3 3 1 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 3\n3 1 3 2 3 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample if we exclude the movies of the 1st genre, the genres "},{"kind":"math_inline","text":"2, 3, 2, 3, 3, 3"},{"kind":"text","text":" remain, that is 3 stresses; if we exclude the movies of the 2nd genre, the genres "},{"kind":"math_inline","text":"1, 1, 3, 3, 3, 1, 1, 3"},{"kind":"text","text":" remain, that is 3 stresses; if we exclude the movies of the 3rd genre the genres "},{"kind":"math_inline","text":"1, 1, 2, 2, 1, 1"},{"kind":"text","text":" remain, that is 2 stresses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample whatever genre Valentine excludes, he will have exactly 3 stresses."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"250C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/250/problem/C"}