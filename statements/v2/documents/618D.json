{"assets":["/statement-assets/d3c5083de44e8fbccb631d87348acda4e312e65d3b3db4e4864a45976e181820.png","/statement-assets/80c5279e3218320729b7d3180e1c5a3a79b81d76b8868750243a5af24dbd6514.png","/statement-assets/7eef32c80d1bdc987dd8df65a207b77e99762a306dfe4d32371da1b0f10525de.png"],"contentKind":"statement","contestId":"618","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Hamiltonian Spanning Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A group of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities is connected by a network of roads. There is an undirected road between every pair of cities, so there are "},{"attrs":{"alt":"","src":"/statement-assets/d3c5083de44e8fbccb631d87348acda4e312e65d3b3db4e4864a45976e181820.png"},"kind":"image"},{"kind":"text","text":" roads in total. It takes exactly "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" seconds to traverse "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" single road."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"spanning tree"}],"kind":"container"},{"kind":"text","text":" is a set of roads containing exactly "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" roads such that it's possible to travel between any two cities using only these roads."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some spanning tree of the initial network was chosen. For every road in this tree the time one needs to traverse this road was changed from "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" seconds. Note that it's not guaranteed that "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is smaller than "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You would like to travel through all the cities using the shortest path possible. Given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" and a description of the spanning tree that was chosen, find the cost of the shortest path that starts in any city, ends in any city and visits all cities "},{"children":[{"kind":"text","text":"exactly once"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 200 000, 1 ≤ x, y ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains a description of a road in the spanning tree. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains two integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":") — indices of the cities connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road. It is guaranteed that these roads form a spanning tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum number of seconds one needs to spend in order to visit all the cities exactly once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 3\n1 2\n1 3\n3 4\n5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3 2\n1 2\n1 3\n3 4\n5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, roads of the spanning tree have cost "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", while other roads have cost "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". One example of an optimal path is "},{"attrs":{"alt":"","src":"/statement-assets/80c5279e3218320729b7d3180e1c5a3a79b81d76b8868750243a5af24dbd6514.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, we have the same spanning tree, but roads in the spanning tree cost 3, while other roads cost 2. One example of an optimal path is "},{"attrs":{"alt":"","src":"/statement-assets/7eef32c80d1bdc987dd8df65a207b77e99762a306dfe4d32371da1b0f10525de.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"618D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/618/problem/D"}