{"assets":[],"contentKind":"statement","contestId":"838","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Future Failure"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Alice and Bob are playing a game with a string of characters, with Alice going first. The string consists "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters, each of which is one of the first "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" letters of the alphabet. On a player’s turn, they can either arbitrarily permute the characters in the words, or delete exactly one character in the word (if there is at least one character). In addition, their resulting word cannot have appeared before throughout the entire game. The player unable to make a valid move loses the game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given "},{"kind":"math_inline","text":"n, k, p"},{"kind":"text","text":", find the number of words with exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters consisting of the first "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" letters of the alphabet such that Alice will win if both Alice and Bob play optimally. Return this number modulo the prime number "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input will contain three integers "},{"kind":"math_inline","text":"n, k, p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 250 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 26"},{"kind":"text","text":", "},{"kind":"math_inline","text":"108 ≤ p ≤ 109 + 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" will be prime)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer, the number of winning words for Alice, modulo "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 100000007\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"There are 14 strings that that Alice can win with. For example, some strings are \"bbaa\" and \"baaa\". Alice will lose on strings like \"aaaa\" or \"bbbb\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"838C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/838/problem/C"}