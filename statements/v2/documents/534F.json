{"assets":["/statement-assets/90c8d91ca5761aabdc0f995e9f354ba9d0b7e282470a2268bd6c802659082f38.png"],"contentKind":"statement","contestId":"534","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Simplified Nonogram"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In this task you have to write a program dealing with nonograms on fields no larger than "},{"kind":"math_inline","text":"5 × 20"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Simplified nonogram is a task where you have to build such field (each cell is either white or black) that satisfies the given information about rows and columns. For each row and each column the number of contiguous black segments is specified. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example if size of the field is "},{"kind":"math_inline","text":"n = 3, m = 5"},{"kind":"text","text":", аnd numbers of contiguous black segments in rows are: "},{"kind":"math_inline","text":"[2, 3, 2]"},{"kind":"text","text":" and in columns are: "},{"kind":"math_inline","text":"[1, 0, 1, 2, 1]"},{"kind":"text","text":" then the solution may look like:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/90c8d91ca5761aabdc0f995e9f354ba9d0b7e282470a2268bd6c802659082f38.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"It is guaranteed that on each test in the testset there exists at least one solution."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line there follow two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5, 1 ≤ m ≤ 20"},{"kind":"text","text":") — number of rows and number of columns respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the number of contiguous black segments in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row of the field. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Similarly, third line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"b1, b2, ..., bm"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is the number of contiguous black segments in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th column of the field."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there exists at least one solution."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output any possible solution. Output should consist of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each containing "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters. Denote white cell as \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" and black cell as \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n2 3 2\n1 0 1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"*.**.\n*.*.*\n*..**"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n2 1 2\n2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"*.*\n.*.\n*.*\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 0 1\n2 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"***\n...\n***\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"534F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/534/problem/F"}