{"assets":[],"contentKind":"statement","contestId":"455","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. A Lot of Games"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Andrew, Fedor and Alex are inventive guys. Now they invent the game with strings for two players."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a group of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" non-empty strings. During the game two players build the word together, initially the word is empty. The players move in turns. On his step player must add a single letter in the end of the word, the resulting word must be prefix of at least one string from the group. A player loses if he cannot move."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Andrew and Alex decided to play this game "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" times. The player who is the loser of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th game makes the first move in the "},{"kind":"math_inline","text":"(i + 1)"},{"kind":"text","text":"-th game. Guys decided that the winner of all games is the player who wins the last ("},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th) game. Andrew and Alex already started the game. Fedor wants to know who wins the game if both players will play optimally. Help him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"1 ≤ k ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains a single non-empty string from the given group. The total length of all strings from the group doesn't exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":". Each string of the group consists only of lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the player who moves first wins, print \""},{"children":[{"kind":"text","text":"First"}],"kind":"container"},{"kind":"text","text":"\", otherwise print \""},{"children":[{"kind":"text","text":"Second"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\na\nb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"First\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\na\nb\nc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"First\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2\nab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Second\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"455B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/455/problem/B"}