{"assets":[],"contentKind":"statement","contestId":"543","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Writing Code"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Programmers working on a large project have just received a task to write exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines of code. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" programmers working on a project, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them makes exactly "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" bugs in every line of code that he writes. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a sequence of non-negative integers "},{"kind":"math_inline","text":"v1, v2, ..., vn"},{"kind":"text","text":" a "},{"children":[{"kind":"text","text":"plan"}],"kind":"container"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"v1 + v2 + ... + vn = m"},{"kind":"text","text":". The programmers follow the plan like that: in the beginning the first programmer writes the first "},{"kind":"math_inline","text":"v1"},{"kind":"text","text":" lines of the given task, then the second programmer writes "},{"kind":"math_inline","text":"v2"},{"kind":"text","text":" more lines of the given task, and so on. In the end, the last programmer writes the remaining lines of the code. Let's call a plan "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":", if all the written lines of the task contain at most "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" bugs in total."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine how many distinct "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" plans are there. As the number of plans can be large, print the remainder of this number modulo given positive integer "},{"kind":"math_inline","text":"mod"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"mod"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 500"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ b ≤ 500"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"1 ≤ mod ≤ 109 + 7"},{"kind":"text","text":") — the number of programmers, the number of lines of code in the task, the maximum total number of bugs respectively and the modulo you should use when printing the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 500"},{"kind":"text","text":") — the number of bugs per line for each programmer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the answer to the problem modulo "},{"kind":"math_inline","text":"mod"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 3 100\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6 5 1000000007\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5 6 11\n1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"543A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/543/problem/A"}