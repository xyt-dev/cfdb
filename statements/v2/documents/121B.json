{"assets":[],"contentKind":"statement","contestId":"121","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Lucky Transformation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Petya loves lucky numbers. Everybody knows that lucky numbers are positive integers whose decimal representation contains only the lucky digits "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":". For example, numbers "},{"children":[{"kind":"text","text":"47"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"744"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" are lucky and "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"17"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"467"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya has a number consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" digits without leading zeroes. He represented it as an array of digits without leading zeroes. Let's call it "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". The numeration starts with "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", starting from the most significant digit. Petya wants to perform the following "},{"children":[{"kind":"text","text":"operation"}],"kind":"container"},{"kind":"math_inline","text":"k"},{"kind":"text","text":" times: find the minimum "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"(1 ≤ x < n)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"dx = 4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"dx + 1 = 7"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is odd, then to assign "},{"kind":"math_inline","text":"dx = dx + 1 = 4"},{"kind":"text","text":", otherwise to assign "},{"kind":"math_inline","text":"dx = dx + 1 = 7"},{"kind":"text","text":". Note that if no "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" was found, then the operation counts as completed and the array doesn't change at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the initial number as an array of digits and the number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Help Petya find the result of completing "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105, 0 ≤ k ≤ 109)"},{"kind":"text","text":" — the number of digits in the number and the number of completed operations. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" digits without spaces representing the array of digits "},{"kind":"math_inline","text":"d"},{"kind":"text","text":", starting with "},{"kind":"math_inline","text":"d1"},{"kind":"text","text":". It is guaranteed that the first digit of the number does not equal zero."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the single line print the result without spaces — the number after the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" operations are fulfilled."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 4\n4727447\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4427477\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n4478\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4478\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the number changes in the following sequence: "},{"kind":"math_inline","text":"4727447 → 4427447 → 4427477 → 4427447 → 4427477"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample: "},{"kind"