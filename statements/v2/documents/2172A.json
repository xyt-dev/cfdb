{"assets":[],"contentKind":"statement","contestId":"2172","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. ASCII Art Contest"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Three leading AI-powered creative assistants—Gemini, ChatGPT, and Claude—enter the first ever ASCII Art Contest, where they must impress a panel of human judges with their text-based masterpieces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each participant receives a score between 80 and 100 (inclusive). The organizers want to announce the final standing only if the judges' opinions are \"close enough\"; otherwise, they will ask the judges to reconsider."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the three integer scores of Gemini, ChatGPT, and Claude, determine the contest result:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If the maximum score and the minimum score differ by at least 10 points, print "},{"children":[{"kind":"text","text":"check again"}],"kind":"container"},{"kind":"text","text":" (the judging seems inconsistent, so the panel must re-evaluate). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Otherwise, print "},{"children":[{"kind":"text","text":"final X"}],"kind":"container"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":" is the median of the three scores (the score that would be in t