{"assets":[],"contentKind":"statement","contestId":"776","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. The Door Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Moriarty has trapped "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people in "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct rooms in a hotel. Some rooms are locked, others are unlocked. But, there is a condition that the people in the hotel can only escape when all the doors are unlocked at the same time. There are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" switches. Each switch control doors of some rooms, but each door is controlled by "},{"children":[{"kind":"text","text":"exactly two"}],"kind":"container"},{"kind":"text","text":" switches."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the initial configuration of the doors. Toggling any switch, that is, turning it ON when it is OFF, or turning it OFF when it is ON, toggles the condition of the doors that this switch controls. Say, we toggled switch "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", which was connected to room "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" which were respectively locked, unlocked and unlocked. Then, after toggling the switch, they become unlocked, locked and locked."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to tell Sherlock, if there exists a way to unlock all doors at the same time."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ m ≤ 105"},{"kind":"text","text":") — the number of rooms and the number of switches."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"r1, r2, ..., rn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ri ≤ 1"},{"kind":"text","text":") which tell the status of room doors. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th room is locked if "},{"kind":"math_inline","text":"ri = 0"},{"kind":"text","text":", otherwise it is unlocked."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains an integer "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ xi ≤ n"},{"kind":"text","text":") followed by "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" distinct integers separated by space, denoting the number of rooms controlled by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th switch followed by the room numbers that this switch controls. It is guaranteed that the room numbers are in the range from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". It is guaranteed that each door is controlled by exactly two switches."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" without quotes, if it is possible to open all doors at the same time, otherwise output \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" without quotes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 0 1\n2 1 3\n2 1 2\n2 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 0 1\n3 1 2 3\n1 2\n2 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 0 1\n3 1 2 3\n2 1 2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second example input, the initial statuses of the doors are "},{"kind":"math_inline","text":"[1, 0, 1]"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0"},{"kind":"text","text":" means locked, "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" — unlocked)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After toggling switch "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", we get "},{"kind":"math_inline","text":"[0, 0, 0]"},{"kind":"text","text":" that means all doors are locked."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then, after toggling switch "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", we get "},{"kind":"math_inline","text":"[1, 1, 1]"},{"kind":"text","text":" that means all doors are unlocked."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It can be seen that for the first and for the third example inputs it is not possible to make all doors unlocked."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"776D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/776/problem/D"}