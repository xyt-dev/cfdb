{"assets":[],"contentKind":"statement","contestId":"1285","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Mezo Playing Zoma"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Today, Mezo is playing a game. Zoma, a character in that game, is initially at position $$$x = 0$$$. Mezo starts sending $$$n$$$ commands to Zoma. There are two possible commands:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" 'L' (Left) sets the position $$$x: =x - 1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 'R' (Right) sets the position $$$x: =x + 1$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Unfortunately, Mezo's controller malfunctions sometimes. Some commands are sent successfully and some are ignored. If the command is ignored then the position $$$x$$$ doesn't change and Mezo simply proceeds to the next command."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if Mezo sends commands \""},{"children":[{"kind":"text","text":"LRLR"}],"kind":"container"},{"kind":"text","text":"\", then here are some possible outcomes (underlined commands are sent successfully): "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"children":[{"kind":"text","text":"LRLR"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":"\" — Zoma moves to the left, to the right, to the left again and to the right for the final time, ending up at position $$$0$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"LRLR"}],"kind":"container"},{"kind":"text","text":"\" — Zoma recieves no commands, doesn't move at all and ends up at position $$$0$$$ as well; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"R"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\" — Zoma moves to the left, then to the left again and ends up in position $$$-2$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Mezo doesn't know which commands will be sent successfully beforehand. Thus, he wants to know how many different positions may Zoma end up at."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains $$$n$$$ $$$(1 \\le n \\le 10^5)$$$ — the number of commands Mezo sends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string $$$s$$$ of $$$n$$$ commands, each either 'L' (Left) or 'R' (Right)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the number of different positions Zoma may end up at."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nLRLR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the example, Zoma may end up anywhere between $$$-2$$$ and $$$2$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1285A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1285/problem/A"}