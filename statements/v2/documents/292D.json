{"assets":[],"contentKind":"statement","contestId":"292","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Connected Components"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"We already know of the large corporation where Polycarpus works as a system administrator. The computer network there consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" computers and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" cables that connect some pairs of computers. In other words, the computer network can be represented as some non-directed graph with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges. Let's index the computers with integers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", let's index the cables with integers from 1 to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus was given an important task — check the reliability of his company's network. For that Polycarpus decided to carry out a series of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" experiments on the computer network, where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th experiment goes as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Temporarily disconnect the cables with indexes from "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", inclusive (the other cables remain connected). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Count the number of connected components in the graph that is defining the computer network at that moment. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Re-connect the disconnected cables with indexes from "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" (that is, restore the initial network). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Polycarpus carry out all experiments and for each print the number of connected components in the graph that defines the computer network through the given experiment. Isolated vertex should be counted as single component."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(2 ≤ n ≤ 500; 1 ≤ m ≤ 104)"},{"kind":"text","text":" — the number of computers and the number of cables, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the cables' description. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains space-separated pair of integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"math_inline","text":"(1 ≤ xi, yi ≤ n; xi ≠ yi)"},{"kind":"text","text":" — the numbers of the computers that are connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th cable. Note that a pair of computers can be connected by multiple cables."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains integer "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ k ≤ 2·104)"},{"kind":"text","text":" — the number of experiments. Next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contain the experiments' descriptions. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains space-separated integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"math_inline","text":"(1 ≤ li ≤ ri ≤ m)"},{"kind":"text","text":" — the numbers of the cables that Polycarpus disconnects during the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th experiment. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" numbers, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number represents the number of connected components of the graph that defines the computer network during the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th experiment. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 5\n1 2\n5 4\n2 3\n3 1\n3 6\n6\n1 3\n2 5\n1 5\n5 5\n2 4\n3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n5\n6\n3\n4\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"292D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/292/problem/D"}