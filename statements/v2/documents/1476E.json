{"assets":[],"contentKind":"statement","contestId":"1476","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Pattern Matching"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given $$$n$$$ patterns $$$p_1, p_2, \\dots, p_n$$$ and $$$m$$$ strings $$$s_1, s_2, \\dots, s_m$$$. Each pattern $$$p_i$$$ consists of $$$k$$$ characters that are either lowercase Latin letters or wildcard characters (denoted by underscores). All patterns are pairwise distinct. Each string $$$s_j$$$ consists of $$$k$$$ lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string $$$a$$$ matches a pattern $$$b$$$ if for each $$$i$$$ from $$$1$$$ to $$$k$$$ either $$$b_i$$$ is a wildcard character or $$$b_i=a_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are asked to rearrange the patterns in such a way that the first pattern the $$$j$$$-th string matches is $$$p[mt_j]$$$. You are allowed to leave the order of the patterns unchanged."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Can you perform such a rearrangement? If you can, then print any valid order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers $$$n$$$, $$$m$$$ and $$$k$$$ ($$$1 \\le n, m \\le 10^5$$$, $$$1 \\le k \\le 4$$$) — the number of patterns, the number of strings and the length of each pattern and string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n$$$ lines contains a pattern — $$$k$$$ characters that are either lowercase Latin letters or underscores. All patterns are pairwise distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$m$$$ lines contains a string — $$$k$$$ lowercase Latin letters, and an integer $$$mt$$$ ($$$1 \\le mt \\le n$$$) — the index of the first pattern the corresponding string should match."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" if there is no way to rearrange the patterns in such a way that the first pattern that the $$$j$$$-th string matches is $$$p[mt_j]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" in the first line. The second line should contain $$$n$$$ distinct integers from $$$1$$$ to $$$n$$$ — the order of the patterns. If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 3 4\n_b_d\n__b_\naaaa\nab__\n_bcd\nabcd 4\nabba 2\ndbcd 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n3 2 4 5 1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1 1 3\n__c\ncba 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 2 2\na_\n_b\nab 1\nab 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The order of patterns after the rearrangement in the first example is the following: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"aaaa"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"__b_"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"ab__"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"_bcd"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"_b_d"}],"kind":"container"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Thus, the first string matches patterns "},{"children":[{"kind":"text","text":"ab__"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"_bcd"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"_b_d"}],"kind":"container"},{"kind":"text","text":" in that order, the first of them is "},{"children":[{"kind":"text","text":"ab__"}],"kind":"container"},{"kind":"text","text":", that is indeed $$$p[4]$$$. The second string matches "},{"children":[{"kind":"text","text":"__b_"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"ab__"}],"kind":"container"},{"kind":"text","text":", the first of them is "},{"children":[{"kind":"text","text":"__b_"}],"kind":"container"},{"kind":"text","text":", that is $$$p[2]$$$. The last string matches "},{"children":[{"kind":"text","text":"_bcd"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"_b_d"}],"kind":"container"},{"kind":"text","text":", the first of them is "},{"children":[{"kind":"text","text":"_bcd"}],"kind":"container"},{"kind":"text","text":", that is $$$p[5]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer to that test is not unique, other valid orders also exist."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example "},{"children":[{"kind":"text","text":"cba"}],"kind":"container"},{"kind":"text","text":" doesn't match "},{"children":[{"kind":"text","text":"__c"}],"kind":"container"},{"kind":"text","text":", thus, no valid order exists."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example the order ("},{"children":[{"kind":"text","text":"a_"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"_b"}],"kind":"container"},{"kind":"text","text":") makes both strings match pattern $$$1$$$ first and the order ("},{"children":[{"kind":"text","text":"_b"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a_"}],"kind":"container"},{"kind":"text","text":") makes both strings match pattern $$$2$$$ first. Thus, there is no order that produces the result $$$1$$$ and $$$2$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1476E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1476/problem/E"}