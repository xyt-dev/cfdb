{"assets":[],"contentKind":"statement","contestId":"439","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Devu, the Singer and Churu, the Joker"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Devu is a renowned classical singer. He is invited to many big functions/festivals. Recently he was invited to \"All World Classical Singing Festival\". Other than Devu, comedian Churu was also invited."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Devu has provided organizers a list of the songs and required time for singing them. He will sing "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" songs, "},{"kind":"math_inline","text":"ith"},{"kind":"text","text":" song will take "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" minutes exactly. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Comedian, Churu will crack jokes. All his jokes are of 5 minutes exactly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"People have mainly come to listen Devu. But you know that he needs rest of 10 minutes after each song. On the other hand, Churu being a very active person, doesn't need any rest."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You as one of the organizers should make an optimal sсhedule for the event. For some reasons you must follow the conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The duration of the event must be no more than "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" minutes; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Devu must complete all his songs; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" With satisfying the two previous conditions the number of jokes cracked by Churu should be as many as possible. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If it is not possible to find a way to conduct all the songs of the Devu, output -1. Otherwise find out maximum number of jokes that Churu can crack in the grand event."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"d"},{"kind":"math_inline","text":"(1 ≤ n ≤ 100; 1 ≤ d ≤ 10000)"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers: "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"math_inline","text":"(1 ≤ ti ≤ 100)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no way to conduct all the songs of Devu, output -1. Otherwise output the maximum number of jokes that Churu can crack in the grand event."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 30\n2 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 20\n2 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first example. The duration of the event is "},{"kind":"math_inline","text":"30"},{"kind":"text","text":" minutes. There could be maximum "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" jokes in the following way:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" First Churu cracks a joke in "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" minutes. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then Devu performs the first song for "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" minutes. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then Churu cracks "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" jokes in "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" minutes. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Now Devu performs second song for "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" minutes. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then Churu cracks "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" jokes in "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" minutes. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Now finally Devu will perform his last song in "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" minutes. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Total time spent is "},{"kind":"math_inline","text":"5 + 2 + 10 + 2 + 10 + 1 = 30"},{"kind":"text","text":" minutes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the second example. There is no way of organizing Devu's all songs. Hence the answer is -1. "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"439A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/439/problem/A"}