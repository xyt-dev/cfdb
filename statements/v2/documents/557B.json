{"assets":[],"contentKind":"statement","contestId":"557","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Pasha and Tea"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pasha decided to invite his friends to a tea party. For that occasion, he has a large teapot with the capacity of "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" milliliters and "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" tea cups, each cup is for one of Pasha's friends. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th cup can hold at most "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" milliliters of water."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It turned out that among Pasha's friends there are exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" boys and exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" girls and all of them are going to come to the tea party. To please everyone, Pasha decided to pour the water for the tea as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Pasha can boil the teapot exactly once by pouring there at most "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" milliliters of water; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Pasha pours the same amount of water to each girl; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Pasha pours the same amount of water to each boy; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if each girl gets "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" milliliters of water, then each boy gets "},{"kind":"math_inline","text":"2x"},{"kind":"text","text":" milliliters of water. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the other words, each boy should get two times more water than each girl does."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pasha is very kind and polite, so he wants to maximize the total amount of the water that he pours to his friends. Your task is to help him and determine the optimum distribution of cups between Pasha's friends."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ w ≤ 109"},{"kind":"text","text":") — the number of Pasha's friends that are boys (equal to the number of Pasha's friends that are girls) and the capacity of Pasha's teapot in milliliters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains the sequence of integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ i ≤ 2n"},{"kind":"text","text":") — the capacities of Pasha's tea cups in milliliters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single real number — the maximum total amount of water in milliliters that Pasha can pour to his friends without violating the given conditions. Your answer will be considered correct if its absolute or relative error doesn't exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4\n1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 18\n4 4 4 2 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"18"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 5\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4.5"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Pasha also has candies that he is going to give to girls but that is another task..."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"557B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/557/problem/B"}