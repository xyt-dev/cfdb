{"assets":["/statement-assets/23bd94dea7fbf8cd9c6a4869c4d4f1ba8783ab8c7094cd03014675b2d4422226.png"],"contentKind":"statement","contestId":"82","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Corridor"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider a house plan. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let the house be represented by an infinite horizontal strip defined by the inequality "},{"kind":"math_inline","text":" - h ≤ y ≤ h"},{"kind":"text","text":". Strictly outside the house there are two light sources at the points "},{"kind":"math_inline","text":"(0, f)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(0,  - f)"},{"kind":"text","text":". Windows are located in the walls, the windows are represented by segments on the lines "},{"kind":"math_inline","text":"y = h"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y =  - h"},{"kind":"text","text":". Also, the windows are arranged symmetrically about the line "},{"kind":"math_inline","text":"y = 0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the area of the floor at the home, which will be lighted by the sources of light. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/23bd94dea7fbf8cd9c6a4869c4d4f1ba8783ab8c7094cd03014675b2d4422226.png"},"kind":"image"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input file contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 500"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ h ≤ 10"},{"kind":"text","text":", "},{"kind":"math_inline","text":"h < f ≤ 1000"},{"kind":"text","text":"). Next, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain two integers each "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 5000 ≤ li < ri ≤ 5000"},{"kind":"text","text":"), each entry indicates two segments. Endpoints of the first segment are "},{"kind":"math_inline","text":"(li, h)"},{"kind":"text","text":"-"},{"kind":"math_inline","text":"(ri, h)"},{"kind":"text","text":", and endpoints of the second segment are "},{"kind":"math_inline","text":"(li,  - h)"},{"kind":"text","text":"-"},{"kind":"math_inline","text":"(ri,  - h)"},{"kind":"text","text":". These segments describe location of windows. Numbers in the lines are space-separated. It is guaranteed that no two distinct segments have common points. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the single real number — the area of the illuminated part of the floor with an absolute or relative error of no more than "},{"kind":"math_inline","text":"10 - 4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 2\n-1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10.0000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 4\n-1 0\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"23.3333333333\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The second sample test is shown on the figure. Green area is the desired area of the illuminated part of the floor. Violet segments indicate windows."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"82E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/82/problem/E"}