{"assets":[],"contentKind":"statement","contestId":"1043","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Lost Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bajtek, known for his unusual gifts, recently got an integer array $$$x_0, x_1, \\ldots, x_{k-1}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, after a huge array-party with his extraordinary friends, he realized that he'd lost it. After hours spent on searching for a new toy, Bajtek found on the arrays producer's website another array $$$a$$$ of length $$$n + 1$$$. As a formal description of $$$a$$$ says, $$$a_0 = 0$$$ and for all other $$$i$$$ ($$$1 \\le i \\le n$$$) $$$a_i = x_{(i-1)\\bmod k} + a_{i-1}$$$, where $$$p \\bmod q$$$ denotes the remainder of division $$$p$$$ by $$$q$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if the $$$x = [1, 2, 3]$$$ and $$$n = 5$$$, then:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a_0 = 0$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_1 = x_{0\\bmod 3}+a_0=x_0+0=1$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_2 = x_{1\\bmod 3}+a_1=x_1+1=3$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_3 = x_{2\\bmod 3}+a_2=x_2+3=6$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_4 = x_{3\\bmod 3}+a_3=x_0+6=7$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_5 = x_{4\\bmod 3}+a_4=x_1+7=9$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So, if the $$$x = [1, 2, 3]$$$ and $$$n = 5$$$, then $$$a = [0, 1, 3, 6, 7, 9]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now the boy hopes that he will be able to restore $$$x$$$ from $$$a$$$! Knowing that $$$1 \\le k \\le n$$$, help him and find all possible values of $$$k$$$ — possible lengths of the lost array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains exactly one integer $$$n$$$ ($$$1 \\le n \\le 1000$$$) — the length of the array $$$a$$$, excluding the element $$$a_0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\le a_i \\le 10^6$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that $$$a_0$$$ is always $$$0$$$ and is not given in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the output should contain one integer $$$l$$$ denoting the number of correct lengths of the lost array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the output should contain $$$l$$$ integers — possible lengths of the lost array in "},{"children":[{"kind":"text","text":"increasing"}],"kind":"container"},{"kind":"text","text":" order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 4 5 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 3 5 6 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n3 5 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n3 "}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, any $$$k$$$ is suitable, since $$$a$$$ is an arithmetic progression."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Possible arrays $$$x$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[1]$$$"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1, 1]$$$"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1, 1, 1]$$$"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1, 1, 1, 1]$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1, 1, 1, 1, 1]$$$"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second example, Bajtek's array can have three or five elements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Possible arrays $$$x$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[1, 2, 2]$$$"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1, 2, 2, 1, 2]$$$"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, $$$k = 4$$$ is bad, since it leads to $$$6 + x_0 = 8$$$ and $$$0 + x_0 = 1$$$, which is an obvious contradiction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, only $$$k = n$$$ is good."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Array $$$[1, 4, -2]$$$ satisfies the requirements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that $$$x_i$$$ may be negative."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1043B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1043/problem/B"}