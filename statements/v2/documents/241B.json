{"assets":["/statement-assets/ee0ae00c10dc4c6dea93a8067abbbcf044abc669438e4e5c0ecde8c3c980529f.png"],"contentKind":"statement","contestId":"241","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Friends"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"6 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" friends and you want to take "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" pictures of them. Exactly two of your friends should appear in each picture and no two pictures should contain the same pair of your friends. So if you have "},{"kind":"math_inline","text":"n = 3"},{"kind":"text","text":" friends you can take "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" different pictures, each containing a pair of your friends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of your friends has an attractiveness level which is specified by the integer number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th friend. You know that the attractiveness of a picture containing the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th and the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th friends is equal to the exclusive-or ("},{"kind":"math_inline","text":"xor"},{"kind":"text","text":" operation) of integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"aj"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You want to take pictures in a way that the total sum of attractiveness of your pictures is maximized. You have to calculate this value. Since the result may not fit in a 32-bit integer number, print it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"attrs":{"alt":"","src":"/statement-assets/ee0ae00c10dc4c6dea93a8067abbbcf044abc669438e4e5c0ecde8c3c980529f.png"},"kind":"image"},{"kind":"text","text":" — the number of friends and the number of pictures that you want to take. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 109"},{"kind":"text","text":") — the values of attractiveness of the friends."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of output should contain an integer — the optimal total sum of attractiveness of your pictures."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"tex