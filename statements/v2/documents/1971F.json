{"assets":["/statement-assets/c2ff30bd54236f711fd9792526a1b3bc6e9accd220c0ff7af36ea02371e17e68.png"],"contentKind":"statement","contestId":"1971","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Circle Perimeter"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Given an integer $$$r$$$, find the number of lattice points that have a Euclidean distance from $$$(0, 0)$$$ "},{"children":[{"kind":"text","text":"greater than or equal to"}],"kind":"container"},{"kind":"text","text":" $$$r$$$ but "},{"children":[{"kind":"text","text":"strictly less"}],"kind":"container"},{"kind":"text","text":" than $$$r+1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"lattice point"}],"kind":"container"},{"kind":"text","text":" is a point with integer coordinates. The "},{"children":[{"kind":"text","text":"Euclidean distance"}],"kind":"container"},{"kind":"text","text":" from $$$(0, 0)$$$ to the point $$$(x,y)$$$ is $$$\\sqrt{x^2 + y^2}$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 1000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a single integer $$$r$$$ ($$$1 \\leq r \\leq 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of $$$r$$$ over all test cases does not exceed $$$10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the number of lattice points that have an Euclidean distance $$$d$$$ from $$$(0, 0)$$$ such that $$$r \\leq d \\lt r+1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1\n2\n3\n4\n5\n1984\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n16\n20\n24\n40\n12504\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The points for the first three test cases are shown below. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c2ff30bd54236f711fd9792526a1b3bc6e9accd220c0ff7af36ea02371e17e68.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1971F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1971/problem/F"}