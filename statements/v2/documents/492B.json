{"assets":[],"contentKind":"statement","contestId":"492","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Vanya and Lanterns"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vanya walks late at night along a straight street of length "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", lit by "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lanterns. Consider the coordinate system with the beginning of the street corresponding to the point "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", and its end corresponding to the point "},{"kind":"math_inline","text":"l"},{"kind":"text","text":". Then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th lantern is at the point "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". The lantern lights all points of the street that are at the distance of at most "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" from it, where "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" is some positive number, common for all lanterns. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vanya wonders: what is the minimum light radius "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" should the lanterns have to light the whole street?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ l ≤ 109"},{"kind":"text","text":") — the number of lanterns and the length of the street respectively. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ l"},{"kind":"text","text":"). Multiple lanterns can be located at the same point. The lanterns may be located at the ends of the street."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum light radius "},{"kind":"math_inline","text":"d"},{"kind":"text","text":", needed to light the whole street. The answer will be considered correct if its absolute or relative error doesn't exceed "},{"kind":"math_inline","text":"10 - 9"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 15\n15 5 3 7 9 14 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2.5000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 5\n2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2.0000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the second sample. At "},{"kind":"math_inline","text":"d = 2"},{"kind":"text","text":" the first lantern will light the segment "},{"kind":"math_inline","text":"[0, 4]"},{"kind":"text","text":" of the street, and the second lantern will light segment "},{"kind":"math_inline","text":"[3, 5]"},{"kind":"text","text":". Thus, the whole street will be lit."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"492B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/492/problem/B"}