{"assets":[],"contentKind":"statement","contestId":"412","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. E-mail Addresses"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One of the most important products of the R1 company is a popular @r1.com mail service. The R1 mailboxes receive and send millions of emails every day."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Today, the online news thundered with terrible information. The R1 database crashed and almost no data could be saved except for one big string. The developers assume that the string contains the letters of some users of the R1 mail. Recovering letters is a tedious mostly manual work. So before you start this process, it was decided to estimate the difficulty of recovering. Namely, we need to calculate the number of different substrings of the saved string that form correct e-mail addresses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We assume that valid addresses are only the e-mail addresses which meet the following criteria:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the address should begin with a non-empty sequence of letters, numbers, characters '"},{"children":[{"kind":"text","text":"_"}],"kind":"container"},{"kind":"text","text":"', starting with a letter; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" then must go character '"},{"children":[{"kind":"text","text":"@"}],"kind":"container"},{"kind":"text","text":"'; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" then must go a non-empty sequence of letters or numbers; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" then must go character '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"'; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the address must end with a non-empty sequence of letters. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You got lucky again and the job was entrusted to you! Please note that the substring is several consecutive characters in a string. Two substrings, one consisting of the characters of the string with numbers "},{"kind":"math_inline","text":"l1, l1 + 1, l1 + 2, ..., r1"},{"kind":"text","text":" and the other one consisting of the characters of the string with numbers "},{"kind":"math_inline","text":"l2, l2 + 1, l2 + 2, ..., r2"},{"kind":"text","text":", are considered distinct if "},{"kind":"math_inline","text":"l1 ≠ l2"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"r1 ≠ r2"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and the only line contains the sequence of characters "},{"kind":"math_inline","text":"s1s2... sn"},{"kind":"math_inline","text":"(1 ≤ n ≤ 106)"},{"kind":"text","text":" — the saved string. It is guaranteed that the given string contains only small English letters, digits and characters '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"_"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"@"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print in a single line the number of substrings that are valid e-mail addresses."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"[email protected]\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"18\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"[email protected]@[email protected]\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"[email protected]\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":".asd123__..@\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case all the substrings that are correct e-mail addresses begin from one of the letters of the word agapov and end in one of the letters of the word com."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case note that the e-mail "},{"attrs":{"href":"https://codeforces.com/cdn-cgi/l/email-protection"},"children":[{"kind":"text","text":"[email protected]"}],"kind":"link"},{"kind":"text","text":" is considered twice in the answer. Note that in this example the e-mail entries overlap inside the string."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"412E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/412/problem/E"}