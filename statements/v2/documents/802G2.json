{"assets":[],"contentKind":"statement","contestId":"802","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G2. Fake News (medium)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Thanks to your help, Heidi is confident that no one can fool her. She has now decided to post some fake news on the HC"},{"kind":"math_inline","text":"2"},{"kind":"text","text":" Facebook page. However, she wants to be able to communicate to the HC"},{"kind":"math_inline","text":"2"},{"kind":"text","text":" committee that the post is fake, using some secret phrase hidden in the post as a subsequence. To make this method foolproof, she wants the phrase to appear "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" times in the post. She is asking you to design a post (string) "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and a hidden phrase "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" appears in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" as a subsequence exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" times."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and only line of input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1 000 000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The output should contain two nonempty strings "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" separated by a single space. Each string should be composed of letters ("},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"-"},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"-"},{"children":[{"kind":"text","text":"Z"}],"kind":"container"},{"kind":"text","text":": both lowercase and uppercase are allowed) and have length at most "},{"kind":"math_inline","text":"200"},{"kind":"text","text":". The number of occurrences of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" as a subsequence should be exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". If there are many possible solutions, output any of them. It is guaranteed that at least one solution exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"hHheidi Hei"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"bbbba ba"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"aaabb ab"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"An occurrence of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" as a subsequence in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" should be thought of as a set of positions in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" such that the letters at these positions, in order, form "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". The number of occurences is thus the number of such sets. For example, "},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":" appears 6 times as a subsequence in "},{"children":[{"kind":"text","text":"aaabb"}],"kind":"container"},{"kind":"text","text":", for the following sets of positions: "},{"kind":"math_inline","text":"{1, 4}, {1, 5}, {2, 4}, {2, 5}, {3, 4}, {3, 5}"},{"kind":"text","text":" (that is, we should choose one of the "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"'s and one of the "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"'s)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G2","problemCode":"802G2","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/802/problem/G2"}