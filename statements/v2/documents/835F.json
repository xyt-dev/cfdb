{"assets":[],"contentKind":"statement","contestId":"835","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Roads in the Kingdom"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In the Kingdom K., there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" towns numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The towns are connected by "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" bi-directional roads numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road connects the towns "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and its length is "},{"kind":"math_inline","text":"li"},{"kind":"text","text":". There is no more than one road between two towns. Also, there are no roads that connect the towns with itself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call the inconvenience of the roads the maximum of the shortest distances between all pairs of towns."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Because of lack of money, it was decided to close down one of the roads so that after its removal it is still possible to reach any town from any other. You have to find the minimum possible inconvenience of the roads after closing down one of the roads."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 2·105"},{"kind":"text","text":") — the number of towns and roads."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the roads description. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th from these lines contains three integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ li ≤ 109"},{"kind":"text","text":") — the numbers of towns connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road and the length of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road. No road connects a town to itself, no two roads connect the same towns."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"It's guaranteed that it's always possible to close down one of the roads so that all the towns are still reachable from each other."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum possible inconvenience of the roads after the refusal from one of the roads."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 4\n2 3 5\n1 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2 3 7\n3 1 9\n4 1 8\n3 5 4\n4 5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"18\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"835F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/835/problem/F"}