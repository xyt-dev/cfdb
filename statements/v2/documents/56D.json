{"assets":[],"contentKind":"statement","contestId":"56","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Changing a String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of capital Latin letters. Let's denote its current length as "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":". During one move it is allowed to apply one of the following operations to it: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"INSERT"}],"kind":"container"},{"kind":"math_inline","text":"pos"},{"kind":"math_inline","text":"ch"},{"kind":"text","text":" — insert a letter "},{"kind":"math_inline","text":"ch"},{"kind":"text","text":" in the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" in the position "},{"kind":"math_inline","text":"pos"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pos ≤ |s| + 1, A ≤ ch ≤ Z"},{"kind":"text","text":"). The letter "},{"kind":"math_inline","text":"ch"},{"kind":"text","text":" becomes the "},{"kind":"math_inline","text":"pos"},{"kind":"text","text":"-th symbol of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", at that the letters shift aside and the length of the string increases by 1. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"DELETE"}],"kind":"container"},{"kind":"math_inline","text":"pos"},{"kind":"text","text":" — delete a character number "},{"kind":"math_inline","text":"pos"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pos ≤ |s|"},{"kind":"text","text":") from the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". At that the letters shift together and the length of the string decreases by 1. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"REPLACE"}],"kind":"container"},{"kind":"math_inline","text":"pos"},{"kind":"math_inline","text":"ch"},{"kind":"text","text":" — the letter in the position "},{"kind":"math_inline","text":"pos"},{"kind":"text","text":" of the line "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is replaced by "},{"kind":"math_inline","text":"ch"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pos ≤ |s|, A ≤ ch ≤ Z"},{"kind":"text","text":"). At that the length of the string does not change. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is to find in which minimal number of moves one can get a "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" string from an "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" string. You should also find the sequence of actions leading to the required results."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", the second line contains "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". The lines consist only of capital Latin letters, their lengths are positive numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the number of moves "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" in the given sequence of operations. The number should be the minimal possible one. Then print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines containing one operation each. Print the operations in the format, described above. If there are several solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ABA\nABBBA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\nINSERT 3 B\nINSERT 4 B\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ACCEPTED\nWRONGANSWER\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\nREPLACE 1 W\nREPLACE 2 R\nREPLACE 3 O\nREPLACE 4 N\nREPLACE 5 G\nREPLACE 6 A\nINSERT 7 N\nINSERT 8 S\nINSERT 9 W\nREPLACE 11 R\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"56D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/56/problem/D"}