{"assets":[],"contentKind":"statement","contestId":"421","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Bug in Code"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recently a serious bug has been found in the FOS code. The head of the F company wants to find the culprit and punish him. For that, he set up an organizational meeting, the issue is: who's bugged the code? Each of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" coders on the meeting said: 'I know for sure that either "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" did it!'"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The head of the company decided to choose two suspects and invite them to his office. Naturally, he should consider the coders' opinions. That's why the head wants to make such a choice that at least "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" coders agreed with it. A coder agrees with the choice of two suspects if at least one of the two people that he named at the meeting was chosen as a suspect. In how many ways can the head of F choose two suspects?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that even if some coder was chosen as a suspect, he can agree with the head's choice if he named the other chosen coder at the meeting."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"math_inline","text":"(3 ≤ n ≤ 3·105; 0 ≤ p ≤ n)"},{"kind":"text","text":" — the number of coders in the F company and the minimum number of agreed people."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"math_inline","text":"(1 ≤ xi, yi ≤ n)"},{"kind":"text","text":" — the numbers of coders named by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th coder. It is guaranteed that "},{"kind":"math_inline","text":"xi ≠ i,  yi ≠ i,  xi ≠ yi"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of possible two-suspect sets. Note that the order of the suspects doesn't matter, that is, sets "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":" are considered identical."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n2 3\n1 4\n1 4\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 6\n5 6\n5 7\n5 8\n6 2\n2 1\n7 3\n1 3\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"421D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/421/problem/D"}