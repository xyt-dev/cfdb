th_inline","text":"5"},{"children":[{"kind":"text","text":"is not"}],"kind":"container"},{"kind":"text","text":" the next prime number for "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One cold April morning Panoramix predicted that soon Kakofonix will break free from his straitjacket, and this will be a black day for the residents of the Gallic countryside."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Panoramix's prophecy tells that if some day Asterix and Obelix beat exactly "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" Roman soldiers, where "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is a prime number, and next day they beat exactly "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" Roman soldiers, where "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"the next prime number"}],"kind":"container"},{"kind":"text","text":" after "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", then it's time to wait for Armageddon, for nothing can shut Kakofonix up while he sings his infernal song."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Yesterday the Gauls beat "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" Roman soldiers and it turned out that the number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" was prime! Today their victims were a troop of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" Romans ("},{"kind":"math_inline","text":"m > n"},{"kind":"text","text":"). Determine whether the Gauls should wait for the black day after today's victory of Asterix and Obelix?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and only input line 