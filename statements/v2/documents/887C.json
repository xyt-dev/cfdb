{"assets":["/statement-assets/79f92e6feaf2bc4076318112ab5df07c1c185167496093da97590e66b3c1231a.png","/statement-assets/8dec63051b60f5ec3487d56cbb786332050b0fc48e8b6708b201ccbb36bbf271.png"],"contentKind":"statement","contestId":"887","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Solution for Cube"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"During the breaks between competitions, top-model Izabella tries to develop herself and not to be bored. For example, now she tries to solve Rubik's cube 2x2x2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's too hard to learn to solve Rubik's cube instantly, so she learns to understand if it's possible to solve the cube in some state using 90-degrees rotation of one face of the cube in any direction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To check her answers she wants to use a program which will for some state of cube tell if it's possible to solve it using one rotation, described above."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Cube is called solved if for each face of cube all squares on it has the same color."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Rubik's_Cube"}],"kind":"link"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"