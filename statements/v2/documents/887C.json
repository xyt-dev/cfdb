:"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In first test case cube looks like this:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/79f92e6feaf2bc4076318112ab5df07c1c185167496093da97590e66b3c1231a.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In second test case cube looks like this: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/8dec63051b60f5ec3487d56cbb786332050b0fc48e8b6708b201ccbb36bbf271.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"It's possible to solve cube by rotating face with squares with numbers 13, 14, 15, 16."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"887C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/887/problem/C"}