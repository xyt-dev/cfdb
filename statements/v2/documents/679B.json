":"list_item"},{"children":[{"kind":"text","text":" Finally, Limak adds "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" blocks with side "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", one by one. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So, there are "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" blocks in the tower. The total volume is is "},{"kind":"math_inline","text":"33 + 23 + 7·13 = 27 + 8 + 7 = 42"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"679B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/679/problem/B"}