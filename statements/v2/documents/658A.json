"kind":"math_inline","text":"25"},{"kind":"text","text":" minutes on the "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-rd problem so he submits it "},{"kind":"math_inline","text":"10 + 15 + 25 = 50"},{"kind":"text","text":" minutes after the start. For this problem he gets "},{"kind":"math_inline","text":"250 - 2·50 = 150"},{"kind":"text","text":" points. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So, Limak got "},{"kind":"math_inline","text":"30 + 35 + 150 = 215"},{"kind":"text","text":" points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Radewoosh solves problem in the reversed order:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Radewoosh solves "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-rd problem after "},{"kind":"math_inline","text":"25"},{"kind":"text","text":" minutes so he gets "},{"kind":"math_inline","text":"250 - 2·25 = 200"},{"kind":"text","text":" points. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" He spends "},{"kind":"math_inline","text":"15"},{"kind":"text","text":" minutes on the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd problem so he submits it "},{"kind":"math_inline","text":"25 + 15 = 40"},{"kind":"text","text":" minutes after the start. He gets "},{"kind":"math_inline","text":"85 - 2·40 = 5"},{"kind":"text","text":" points for this problem. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" He spends "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" minutes on the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st problem so he submits it "},{"kind":"math_inline","text":"25 + 15 + 10 = 50"},{"kind":"text","text":" minutes after the start. He gets "},{"kind":"math_inline","text":"max(0, 50 - 2·50) = max(0,  - 50) = 0"},{"kind":"text","text":" points. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Radewoosh got "},{"kind":"math_inline","text":"200 + 5 + 0 = 205"},{"kind":"text","text":" points in total. Limak has "},{"kind":"math_inline","text":"215"},{"kind":"text","text":" points so Limak wins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, Limak will get "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" points for each problem and Radewoosh will first solve the hardest problem and he will get "},{"kind":"math_inline","text":"250 - 6·25 = 100"},{"kind":"text","text":" points for that. Radewoosh will get "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" points for other two problems but he is the winner anyway."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, Limak will get "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" points for the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st problem and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" points for the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd problem. Radewoosh will get "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" points for the "},{"kind":"math_inline","text":"8"},{"kind":"text","text":"-th problem. They won't get points for other problems and thus there is a tie because "},{"kind":"math_inline","text":"2 + 2 = 4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"658A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/658/problem/A"}