{"assets":[],"contentKind":"statement","contestId":"658","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Bear and Reverse Radewoosh"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Limak and Radewoosh are going to compete against each other in the upcoming algorithmic contest. They are equally skilled but they won't solve problems in the same order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There will be "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" problems. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th problem has initial score "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and it takes exactly "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" minutes to solve it. Problems are sorted by difficulty — it's guaranteed that "},{"kind":"math_inline","text":"pi < pi + 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ti < ti + 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A constant "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" is given too, representing the speed of loosing points. Then, submitting the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th problem at time "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":" minutes after the start of the contest) gives "},{"kind":"math_inline","text":"max(0,  pi - c·x)"},{"kind":"text","text":" points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak is going to solve problems in order "},{"kind":"math_inline","text":"1, 2, ..., n"},{"kind":"text","text":" (sorted increasingly by "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":"). Radewoosh is going to solve them in order "},{"kind":"math_inline","text":"n, n - 1, ..., 1"},{"kind":"text","text":" (sorted decreasingly by "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":"). Your task is to predict the outcome — print the name of the winner (person who gets more points at the end) or a word \""},{"children":[{"kind":"text","text":"Tie"}],"kind":"container"},{"kind":"text","text":"\" in case of a tie."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may assume that the duration of the competition is greater or equal than the sum of all "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":". That means both Limak and Radewoosh will accept all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" problems."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50, 1 ≤ c ≤ 1000"},{"kind":"text","text":") — the number of problems and the constant representing the speed of loosing points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ 1000, pi < pi + 1"},{"kind":"text","text":") — initial scores."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 1000, ti < ti + 1"},{"kind":"text","text":") where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" denotes the number of minutes one needs to solve the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"Limak"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if Limak will get more points in total. Print \""},{"children":[{"kind":"text","text":"Radewoosh"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if Radewoosh will get more points in total. Print \""},{"children":[{"kind":"text","text":"Tie"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if Limak and Radewoosh will get the same total number of points."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n50 85 250\n10 15 25\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Limak\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6\n