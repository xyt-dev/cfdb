{"assets":["/statement-assets/9adb65b3c9675424028a74977a346b698afc9f47d22c3bd7dae42871e21ed7b4.png"],"contentKind":"statement","contestId":"2038","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"K. Grid Walk"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have an $$$n \\times n$$$ grid and two integers $$$a$$$ and $$$b$$$. Both the rows and the columns are numbered from $$$1$$$ to $$$n$$$. Let's denote the cell at the intersection of the $$$i$$$-th row and the $$$j$$$-th column as $$$(i, j)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are standing in the cell $$$(1, 1)$$$ and want to move into the cell $$$(n, n)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Suppose you are in the cell $$$(i, j)$$$; in one step, you can move either into the cell $$$(i, j + 1)$$$ or into the cell $$$(i + 1, j)$$$ if the corresponding cells exist."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define the cost of the cell $$$(i, j)$$$ as $$$c(i, j) = \\gcd(i, a) + \\gcd(j, b)$$$ (here, $$$\\gcd(x,y)$$$ denotes the greatest common divisor of $$$x$$$ and $$$y$$$). The cost of the route from $$$(1, 1)$$$ to $$$(n, n)$$$ is the sum of costs of the visited cells (including the starting cell and the finishing cell)."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9adb65b3c9675424028a74977a346b698afc9f47d22c3bd7dae42871e21ed7b4.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Find the route with minimum possible cost and print its cost."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains three integers $$$n$$$, $$$a$$$, and $$$b$$$ ($$$2 \\le n \\le 10^6$$$; $$$1 \\le a, b \\le 10^6$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the cost of the cheapest route from $$$(1, 1)$$$ to $$$(n, n)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n21\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10 210 420\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n125\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first example is described in the picture above."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"K","problemCode":"2038K","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2038/problem/K"}