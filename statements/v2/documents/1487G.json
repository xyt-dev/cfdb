{"assets":[],"contentKind":"statement","contestId":"1487","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. String Counting"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"10 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have $$$c_1$$$ letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', $$$c_2$$$ letters '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"', ..., $$$c_{26}$$$ letters '"},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"'. You want to build a "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" string of length $$$n$$$ from them (obviously, you cannot use the $$$i$$$-th letter more than $$$c_i$$$ times). "},{"children":[{"kind":"text","text":"Each $$$c_i$$$ is greater than $$$\\frac{n}{3}$$$"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string is called "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if there are no palindromic contiguous substrings of odd length greater than $$$1$$$ in it. For example, the string \""},{"children":[{"kind":"text","text":"abacaba"}],"kind":"container"},{"kind":"text","text":"\" is not beautiful, it has several palindromic substrings of odd length greater than $$$1$$$ (for example, \""},{"children":[{"kind":"text","text":"aca"}],"kind":"container"},{"kind":"text","text":"\"). Another example: the string \""},{"children":[{"kind":"text","text":"abcaa"}],"kind":"container"},{"kind":"text","text":"\" is "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Calculate the number of different strings you can build, and print the answer modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$3 \\le n \\le 400$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$26$$$ integers $$$c_1$$$, $$$c_2$$$, ..., $$$c_{26}$$$ ($$$\\frac{n}{3} \\lt c_i \\le n$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the number of strings you can build, taken modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n422500\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text"