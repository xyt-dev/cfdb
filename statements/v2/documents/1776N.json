{"assets":[],"contentKind":"statement","contestId":"1776","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"N. Count Permutations"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ with length $$$n-1$$$ whose characters are either $$$\\texttt{ \\lt }$$$ or $$$\\texttt{ \\gt }$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Count the permutations $$$p_1, \\, p_2, \\, \\dots, \\, p_n$$$ of $$$1, \\, 2, \\, \\dots, \\, n$$$ such that, for all $$$i = 1, \\, 2, \\, \\dots, \\, n - 1$$$, if $$$s_i$$$ is $$$\\texttt{ \\lt }$$$ then $$$p_i \\lt p_{i+1}$$$ and if $$$s_i$$$ is $$$\\texttt{ \\gt }$$$ then $$$p_i \\gt p_{i+1}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since this number can be very large, compute its logarithm in base $$$2$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$2 \\le n \\le 100\\,000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string $$$s$$$ of length $$$n-1$$$; each character of $$$s$$$ is either $$$\\texttt{ \\lt }$$$ or $$$\\texttt{ \\gt }$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the logarithm in base $$$2$$$ of the number of permutations satisfying the constraints described in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your answer is considered correct if its absolute or relative error does not exceed $$$10^{-6}$$$. Formally, let your answer be $$$x$$$ and let the correct answer be $$$y$$$. Your answer is accepted if and only if $$$\\frac{|x - y|}{\\max{(1, |y|)}} \\le 10^{-6}$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n<\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0.0000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n<>\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1.0000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n><<<\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2.0000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n<><<<<<>>\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n9.8281364842\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"first sample"}],"kind":"container"},{"kind":"text","text":", there is only one valid permutation, that is $$$[2, 1]$$$. Since $$$\\log_2(1)=0$$$, the correct output is $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"second sample"}],"kind":"container"},{"kind":"text","text":", there are $$$2$$$ valid permutations, that are $$$[3, 1, 2]$$$ and $$$[2, 1, 3]$$$. Since $$$\\log_2(2)=1$$$, the correct output is $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"third sample"}],"kind":"container"},{"kind":"text","text":", there are $$$4$$$ valid permutations, that are $$$[1, 5, 4, 3, 2]$$$, $$$[2, 5, 4, 3, 1]$$$, $$$[3, 5, 4, 2, 1]$$$, $$$[4, 5, 3, 2, 1]$$$. Since $$$\\log_2(4)=2$$$, the correct output is $$$2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"fourth sample"}],"kind":"container"},{"kind":"text","text":", there are $$$909$$$ valid permutations. Notice that $$$\\log_2(909)=9.828136484194\\ldots$$$"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"N","problemCode":"1776N","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1776/problem/N"}