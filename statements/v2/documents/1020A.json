{"assets":["/statement-assets/8395c0ce9d12642e80381451a6a3270cc14e918d6a2f0b1a852ae02d60df768d.png"],"contentKind":"statement","contestId":"1020","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. New Building for SIS"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are looking at the floor plan of the Summer Informatics School's new building. You were tasked with SIS logistics, so you really care about travel time between different locations: it is important to know how long it would take to get from the lecture room to the canteen, or from the gym to the server room."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The building consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" towers, "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" floors each, where the towers are labeled from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", the floors are labeled from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"h"},{"kind":"text","text":". There is a passage between any two adjacent towers (two towers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":": "},{"kind":"math_inline","text":"1 ≤ i ≤ n - 1"},{"kind":"text","text":") on every floor "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"a ≤ x ≤ b"},{"kind":"text","text":". It takes exactly one minute to walk between any two adjacent floors of a tower, as well as between any two adjacent towers, provided that there is a passage on that floor. It is not permitted to leave the building."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/8395c0ce9d12642e80381451a6a3270cc14e918d6a2f0b1a852ae02d60df768d.png"},"kind":"image"},{"children":[{"children":[{"kind":"text","text":"The picture illustrates the first example."}],"kind":"container"}],"kind":"paragraph"}],"kind":"container"},{"children":[{"kind":"text","text":"You have given "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" pairs of locations "},{"kind":"math_inline","text":"(ta, fa)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(tb, fb)"},{"kind":"text","text":": floor "},{"kind":"math_inline","text":"fa"},{"kind":"text","text":" of tower "},{"kind":"math_inline","text":"ta"},{"kind":"text","text":" and floor "},{"kind":"math_inline","text":"fb"},{"kind":"text","text":" of tower "},{"kind":"math_inline","text":"tb"},{"kind":"text","text":". For each pair you need to determine the minimum walking time between these locations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains following integers:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"n"},{"kind":"text","text":": the number of towers in the building ("},{"kind":"math_inline","text":"1 ≤ n ≤ 108"},{"kind":"text","text":"), "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"h"},{"kind":"text","text":": the number of floors in each tower ("},{"kind":"math_inline","text":"1 ≤ h ≤ 108"},{"kind":"text","text":"), "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":": the lowest and highest floor where it's possible to move between adjacent towers ("},{"kind":"math_inline","text":"1 ≤ a ≤ b ≤ h"},{"kind":"text","text":"), "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"k"},{"kind":"text","text":": total number of queries ("},{"kind":"math_inline","text":"1 ≤ k ≤ 104"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contain description of the queries. Each description consists of four integers "},{"kind":"math_inline","text":"ta"},{"kind":"text","text":", "},{"kind":"math_inline","text":"fa"},{"kind":"text","text":", "},{"kind":"math_inline","text":"tb"},{"kind":"text","text":", "},{"kind":"math_inline","text":"fb"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ta, tb ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ fa, fb ≤ h"},{"kind":"text","text":"). This corresponds to a query to find the minimum travel time between "},{"kind":"math_inline","text":"fa"},{"kind":"text","text":"-th floor of the "},{"kind":"math_inline","text":"ta"},{"kind":"text","text":"-th tower and "},{"kind":"math_inline","text":"fb"},{"kind":"text","text":"-th floor of the "},{"kind":"math_inline","text":"tb"},{"kind":"text","text":"-th tower."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query print a single integer: the minimum walking time between the locations in minutes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6 2 3 3\n1 2 1 3\n1 4 3 4\n1 2 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n4\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1020A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1020/problem/A"}