{"assets":["/statement-assets/9268d048de21fbaf872db16275f55765bb10a45ab4a39c26ea27cd7df2588681.png","/statement-assets/49d1200a867bbdedeb3c33d67da2db76946448d8a85b1ae5530602d30e7444dc.png"],"contentKind":"statement","contestId":"1360","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Minimal Square"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Find the minimum area of a "},{"children":[{"kind":"text","text":"square"}],"kind":"container"},{"kind":"text","text":" land on which you can place two identical rectangular $$$a \\times b$$$ houses. The sides of the houses should be parallel to the sides of the desired square land."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" You are given two identical rectangles with side lengths $$$a$$$ and $$$b$$$ ($$$1 \\le a, b \\le 100$$$) — positive integers (you are given just the sizes, but "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" their positions). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Find the square of the minimum area that contains both given rectangles. Rectangles can be rotated (both or just one), moved, but the sides of the rectangles should be parallel to the sides of the desired square. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Two rectangles can touch each other (side or corner), but cannot intersect. Rectangles can also touch the sides of the square but must be completely inside it. You can rotate the rectangles. Take a look at the examples for a better understanding."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9268d048de21fbaf872db16275f55765bb10a45ab4a39c26ea27cd7df2588681.png"},"kind":"image"},{"children":[{"kind":"text","text":"The picture shows a square that contains red and green rectangles."}],"kind":"container"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\le t \\le 10\\,000$$$) —the number of test cases in the input. Then $$$t$$$ test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case is a line containing two integers $$$a$$$, $$$b$$$ ($$$1 \\le a, b \\le 100$$$) — side lengths of the rectangles."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$t$$$ answers to the test cases. Each answer must be a single integer — minimal area of square land, that contains two rectangles with dimensions $$$a \\times b$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n3 2\n4 2\n1 1\n3 1\n4 7\n1 3\n7 4\n100 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n16\n16\n4\n9\n64\n9\n64\n40000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Below are the answers for the first two test cases: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9268d048de21fbaf872db16275f55765bb10a45ab4a39c26ea27cd7df2588681.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/49d1200a867bbdedeb3c33d67da2db76946448d8a85b1ae5530602d30e7444dc.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1360A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1360/problem/A"}