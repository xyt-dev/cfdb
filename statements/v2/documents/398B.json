{"assets":[],"contentKind":"statement","contestId":"398","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Painting The Wall"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"User ainta decided to paint a wall. The wall consists of "},{"kind":"math_inline","text":"n2"},{"kind":"text","text":" tiles, that are arranged in an "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" table. Some tiles are painted, and the others are not. As he wants to paint it beautifully, he will follow the rules below."}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Firstly user ainta looks at the wall. If there is at least one painted cell on each row and at least one painted cell on each column, he stops coloring. Otherwise, he goes to step 2. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" User ainta choose any tile on the wall with uniform probability. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the tile he has chosen is not painted, he paints the tile. Otherwise, he ignores it. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then he takes a rest for one minute even if he doesn't paint the tile. And then ainta goes to step 1. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"However ainta is worried if it would take too much time to finish this work. So he wants to calculate the expected time needed to paint the wall by the method above. Help him find the expected time. You can assume that choosing and painting any tile consumes no time at all. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·103"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"0 ≤ m ≤ min(n2, 2·104)"},{"kind":"text","text":") — the size of the wall and the number of painted cells."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines goes, each contains two integers "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ri, ci ≤ n"},{"kind":"text","text":") — the position of the painted cell. It is guaranteed that the positions are all distinct. Consider the rows of the table are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Consider the columns of the table are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print the expected time to paint the wall in minutes. Your answer will be considered correct if it has at most "},{"kind":"math_inline","text":"10 - 4"},{"kind":"text","text":" absolute or relative error."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n2 3\n4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11.7669491886\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n1 1\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2.0000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.0000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"398B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/398/problem/B"}