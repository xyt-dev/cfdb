{"assets":[],"contentKind":"statement","contestId":"295","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Greg and Friends"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day Greg and his friends were walking in the forest. Overall there were "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people walking, including Greg. Soon he found himself in front of a river. The guys immediately decided to get across the river. Luckily, there was a boat by the river bank, just where the guys were standing. We know that the boat can hold people with the total weight of at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" kilograms."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Greg immediately took a piece of paper and listed there the weights of all people in his group (including himself). It turned out that each person weights either 50 or 100 kilograms. Now Greg wants to know what minimum number of times the boat needs to cross the river to transport the whole group to the other bank. The boat needs at least one person to navigate it from one bank to the other. As the boat crosses the river, it can have any non-zero number of passengers as long as their total weight doesn't exceed "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also Greg is wondering, how many ways there are to transport everybody to the other side in the minimum number of boat rides. Two ways are considered distinct if during some ride they have distinct sets of people on the boat."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Greg with this problem."}],"kind":"paragraph"},{"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n ≤ 50, 1 ≤ k ≤ 5000)"},{"kind":"text","text":" — the number of people, including Greg, and the boat's weight limit. The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers — the people's weights. A person's weight is either "},{"kind":"math_inline","text":"50"},{"kind":"text","text":" kilos or "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" kilos."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can consider Greg and his friends indexed in some way."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print an integer — the minimum number of rides. If transporting everyone to the other bank is impossible, print an integer "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print the remainder after dividing the number of ways to transport the people in the minimum number of rides by number "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":". If transporting everyone to the other bank is impossible, print integer "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 50\n50\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 100\n50 50 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 50\n50 50\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test Greg walks alone and consequently, he needs only one ride across the river."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test you should follow the plan:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" transport two "},{"kind":"math_inline","text":"50"},{"kind":"text","text":" kg. people; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" transport one "},{"kind":"math_inline","text":"50"},{"kind":"text","text":" kg. person back; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" transport one "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" kg. person; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" transport one "},{"kind":"math_inline","text":"50"},{"kind":"text","text":" kg. person back; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" transport two "},{"kind":"math_inline","text":"50"},{"kind":"text","text":" kg. people. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"That totals to "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" rides. Depending on which person to choose at step 2, we can get two distinct ways."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"295C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/295/problem/C"}