{"assets":[],"contentKind":"statement","contestId":"1354","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Graph Coloring"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an undirected graph without self-loops or multiple edges which consists of $$$n$$$ vertices and $$$m$$$ edges. Also you are given three integers $$$n_1$$$, $$$n_2$$$ and $$$n_3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Can you label each vertex with one of three numbers "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"3"}],"kind":"container"},{"kind":"text","text":" in such way, that: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Each vertex should be labeled by exactly one number "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"3"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The total number of vertices with label "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" should be equal to $$$n_1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The total number of vertices with label "},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":" should be equal to $$$n_2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The total number of vertices with label "},{"children":[{"kind":"text","text":"3"}],"kind":"container"},{"kind":"text","text":" should be equal to $$$n_3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$|col_u - col_v| = 1$$$ for each edge $$$(u, v)$$$, where $$$col_x$$$ is the label of vertex $$$x$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there are multiple valid labelings, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\le n \\le 5000$$$; $$$0 \\le m \\le 10^5$$$) — the number of vertices and edges in the graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains three integers $$$n_1$$$, $$$n_2$$$ and $$$n_3$$$ ($$$0 \\le n_1, n_2, n_3 \\le n$$$) — the number of labels "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"3"}],"kind":"container"},{"kind":"text","text":", respectively. It's guaranteed that $$$n_1 + n_2 + n_3 = n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$m$$$ lines contan description of edges: the $$$i$$$-th line contains two integers $$$u_i$$$, $$$v_i$$$ ($$$1 \\le u_i, v_i \\le n$$$; $$$u_i \\neq v_i$$$) — the vertices the $$$i$$$-th edge connects. It's guaranteed that the graph doesn't contain self-loops or multiple edges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If valid labeling exists then print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in the first line. In the second line print string of length $$$n$$$ consisting of "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"3"}],"kind":"container"},{"kind":"text","text":". The $$$i$$$-th letter should be equal to the label of the $$$i$$$-th vertex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is no valid labeling, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6 3\n2 2 2\n3 1\n5 4\n2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n112323\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 9\n0 2 3\n1 2\n1 3\n1 5\n2 3\n2 4\n2 5\n3 4\n3 5\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1354E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1354/problem/E"}