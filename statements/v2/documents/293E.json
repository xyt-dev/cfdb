{"assets":[],"contentKind":"statement","contestId":"293","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Close Vertices"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got a weighted tree, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. Each edge has a non-negative weight. The length of the path between any two vertices of the tree is the number of edges in the path. The weight of the path is the total weight of all edges it contains. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two vertices are close if there exists a path of length at most "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" between them and a path of weight at most "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" between them. Count the number of pairs of vertices "},{"kind":"math_inline","text":"v, u"},{"kind":"math_inline","text":"(v < u)"},{"kind":"text","text":", such that vertices "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" are close."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"w"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105, 1 ≤ l ≤ n, 0 ≤ w ≤ 109)"},{"kind":"text","text":". The next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain the descriptions of the tree edges. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two integers "},{"kind":"math_inline","text":"pi, wi"},{"kind":"math_inline","text":"(1 ≤ pi < (i + 1), 0 ≤ wi ≤ 104)"},{"kind":"text","text":", that mean that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge connects vertex "},{"kind":"math_inline","text":"(i + 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and has weight "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the tree vertices indexed from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in some way."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of close pairs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4 6\n1 3\n1 4\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2 17\n1 3\n2 5\n2 13\n1 6\n5 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"293E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/293/problem/E"}