{"assets":[],"contentKind":"statement","contestId":"241","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(1 ≤ ai ≤ n)"},{"kind":"text","text":". You want to remove some integers in such a way that the resulting sequence of integers satisfies the following three conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" the resulting sequence is not empty; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the exclusive or ("},{"kind":"math_inline","text":"xor"},{"kind":"text","text":" operation) of all the integers in the resulting sequence equals "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if you write all the integers of the resulting sequence (from beginning to the end) in a row in the decimal numeral system and without any spaces, the written number is divisible by "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given the sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and a prime number "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", find a way to satisfy the described conditions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"math_inline","text":"(1 ≤ n, p ≤ 50000)"},{"kind":"text","text":". Next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated distinct integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(1 ≤ ai ≤ n)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is a prime number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no solution for the given input, print \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in the only line of the output."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" in the first line of output. The second line should contain an integer "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(k > 0)"},{"kind":"text","text":" specifying the number of remaining elements and the third line should contain "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"x1, x2, ..., xk"},{"kind":"math_inline","text":"(1 ≤ xi ≤ n)"},{"kind":"text","text":". These integers mean that you should remove all integers from the sequence except integers "},{"kind":"math_inline","text":"ax1, ax2, ..., axk"},{"kind":"text","text":" to satisfy the described conditions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, any of them will be accepted."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n3\n1 2 3 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"241D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/241/problem/D"}