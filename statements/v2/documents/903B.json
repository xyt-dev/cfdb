{"assets":[],"contentKind":"statement","contestId":"903","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. The Modcrab"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vova is again playing some computer game, now an RPG. In the game Vova's character received a quest: to slay the fearsome monster called Modcrab."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After two hours of playing the game Vova has tracked the monster and analyzed its tactics. The Modcrab has "},{"kind":"math_inline","text":"h2"},{"kind":"text","text":" health points and an attack power of "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":". Knowing that, Vova has decided to buy a lot of strong healing potions and to prepare for battle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vova's character has "},{"kind":"math_inline","text":"h1"},{"kind":"text","text":" health points and an attack power of "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":". Also he has a large supply of healing potions, each of which increases his current amount of health points by "},{"kind":"math_inline","text":"c1"},{"kind":"text","text":" when Vova drinks a potion. All potions are identical to each other. It is guaranteed that "},{"kind":"math_inline","text":"c1 > a2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The battle consists of multiple phases. In the beginning of each phase, Vova can either attack the monster (thus reducing its health by "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":") or drink a healing potion (it increases Vova's health by "},{"kind":"math_inline","text":"c1"},{"kind":"text","text":"; "},{"children":[{"kind":"text","text":"Vova's health can exceed "},{"kind":"math_inline","text":"h1"}],"kind":"container"},{"kind":"text","text":"). Then, "},{"children":[{"kind":"text","text":"if the battle is not over yet"}],"kind":"container"},{"kind":"text","text":", the Modcrab attacks Vova, reducing his health by "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":". The battle ends when Vova's (or Modcrab's) health drops to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" or lower. It is possible that the battle ends in a middle of a phase after Vova's attack."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Of course, Vova wants to win the fight. But also he wants to do it as fast as possible. So he wants to make up a strategy that will allow him to win the fight after the minimum possible number of phases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Vova to make up a strategy! You may assume that Vova never runs out of healing potions, and that he can always win."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"h1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ h1, a1 ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ c1 ≤ 100"},{"kind":"text","text":") — Vova's health, Vova's attack power and the healing power of a potion."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains two integers "},{"kind":"math_inline","text":"h2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ h2 ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ a2 < c1"},{"kind":"text","text":") — the Modcrab's health and his attack power."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" denoting the minimum number of phases required to win the battle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line must be equal to "},{"children":[{"kind":"text","text":"HEAL"}],"kind":"container"},{"kind":"text","text":" if Vova drinks a potion in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th phase, or "},{"children":[{"kind":"text","text":"STRIKE"}],"kind":"container"},{"kind":"text","text":" if he attacks the Modcrab."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The strategy must be valid: Vova's character must not be defeated before slaying the Modcrab, and the monster's health must be "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" or lower after Vova's last action."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple optimal solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 6 100\n17 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\nSTRIKE\nHEAL\nSTRIKE\nSTRIKE\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11 6 100\n12 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\nSTRIKE\nSTRIKE\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Vova's character must heal before or after his first attack. Otherwise his health will drop to zero in "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" phases while he needs "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" strikes to win."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example no healing needed, two strikes are enough to get monster to zero health and win with "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" health left."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"903B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/903/problem/B"}