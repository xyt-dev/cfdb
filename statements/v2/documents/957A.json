{"assets":[],"contentKind":"statement","contestId":"957","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Tritonic Iridescence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Overlooking the captivating blend of myriads of vernal hues, Arkady the painter lays out a long, long canvas."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Arkady has a sufficiently large amount of paint of three colours: cyan, magenta, and yellow. On the one-dimensional canvas split into "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" consecutive segments, each segment needs to be painted in one of the colours."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Arkady has already painted some (possibly none or all) segments and passes the paintbrush to you. You are to determine whether there are at least two ways of colouring all the unpainted segments so that no two adjacent segments are of the same colour. Two ways are considered different if and only if a segment is painted in different colours in them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the length of the canvas."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of which is either '"},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"' (denoting a segment painted in cyan), '"},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":"' (denoting one painted in magenta), '"},{"children":[{"kind":"text","text":"Y"}],"kind":"container"},{"kind":"text","text":"' (one painted in yellow), or '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"' (an unpainted one)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there are at least two different ways of painting, output \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\"; otherwise output \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" (both without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print each character in any case (upper or lower)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nCY??Y\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nC?C?Y\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n?CYC?\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nC??MM\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nMMY\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first example, there are exactly two different ways of colouring: "},{"children":[{"kind":"text","text":"CYCMY"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"CYMCY"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second example, there are also exactly two different ways of colouring: "},{"children":[{"kind":"text","text":"CMCMY"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"CYCMY"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the third example, there are four ways of colouring: "},{"children":[{"kind":"text","text":"MCYCM"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"MCYCY"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"YCYCM"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"YCYCY"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the fourth example, no matter how the unpainted segments are coloured, the existing magenta segments will prevent the painting from satisfying the requirements. The similar is true for the fifth example."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"957A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/957/problem/A"}