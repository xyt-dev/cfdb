{"assets":[],"contentKind":"statement","contestId":"1307","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Cow and Message"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bessie the cow has just intercepted a text that Farmer John sent to Burger Queen! However, Bessie is sure that there is a secret message hidden inside."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The text is a string $$$s$$$ of lowercase Latin letters. She considers a string $$$t$$$ as hidden in string $$$s$$$ if $$$t$$$ exists as a subsequence of $$$s$$$ whose indices form an arithmetic progression. For example, the string "},{"children":[{"kind":"text","text":"aab"}],"kind":"container"},{"kind":"text","text":" is hidden in string "},{"children":[{"kind":"text","text":"aaabb"}],"kind":"container"},{"kind":"text","text":" because it occurs at indices $$$1$$$, $$$3$$$, and $$$5$$$, which form an arithmetic progression with a common difference of $$$2$$$. Bessie thinks that any hidden string that occurs the most times is the secret message. Two occurrences of a subsequence of $$$S$$$ are distinct if the sets of indices are different. Help her find the number of occurrences of the secret message!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, in the string "},{"children":[{"kind":"text","text":"aaabb"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" is hidden $$$3$$$ times, "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":" is hidden $$$2$$$ times, "},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":" is hidden $$$6$$$ times, "},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":" is hidden $$$3$$$ times, "},{"children":[{"kind":"text","text":"bb"}],"kind":"container"},{"kind":"text","text":" is hidden $$$1$$$ time, "},{"children":[{"kind":"text","text":"aab"}],"kind":"container"},{"kind":"text","text":" is hidden $$$2$$$ times, "},{"children":[{"kind":"text","text":"aaa"}],"kind":"container"},{"kind":"text","text":" is hidden $$$1$$$ time, "},{"children":[{"kind":"text","text":"abb"}],"kind":"container"},{"kind":"text","text":" is hidden $$$1$$$ time, "},{"children":[{"kind":"text","text":"aaab"}],"kind":"container"},{"kind":"text","text":" is hidden $$$1$$$ time, "},{"children":[{"kind":"text","text":"aabb"}],"kind":"container"},{"kind":"text","text":" is hidden $$$1$$$ time, and "},{"children":[{"kind":"text","text":"aaabb"}],"kind":"container"},{"kind":"text","text":" is hidden $$$1$$$ time. The number of occurrences of the secret message is $$$6$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a string $$$s$$$ of lowercase Latin letters ($$$1 \\le |s| \\le 10^5$$$) — the text that Bessie intercepted."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer  — the number of occurrences of the secret message."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"E