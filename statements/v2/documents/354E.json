{"assets":[],"contentKind":"statement","contestId":"354","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Lucky Number Representation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"We know that lucky digits are digits "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"7"},{"kind":"text","text":", however Vasya's got another favorite digit "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and he assumes it also is lucky! Lucky numbers are such "},{"children":[{"kind":"text","text":"non-negative"}],"kind":"container"},{"kind":"text","text":" integers whose decimal record only contains lucky digits. For example, numbers "},{"kind":"math_inline","text":"0, 47, 7074"},{"kind":"text","text":" are lucky, but "},{"kind":"math_inline","text":"1, 7377, 895, "},{"kind":"text","text":" -"},{"kind":"math_inline","text":"7"},{"kind":"text","text":" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya has "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" important positive integers he needs to remember. Vasya is quite superstitious and he wants to remember lucky numbers only, so he is asking you for each important number to represent it as a sum of exactly six lucky numbers (Vasya just can't remember more numbers). Then Vasya can just remember these six numbers and calculate the important number at any moment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each of "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" important integers represent it as the sum of six lucky numbers or state that this is impossible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"(1 ≤ t ≤ 5000)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines contain a single positive integer "},{"kind":"math_inline","text":"ni"},{"kind":"math_inline","text":"(1 ≤ ni ≤ 1018)"},{"kind":"text","text":" — the list of important numbers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" to read or write 64-bit integers С++. It is preferred to read the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line must contain the answer for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th important number: if the solution exists, the line must contain exactly six lucky numbers the sum of which equals "},{"kind":"math_inline","text":"ni"},{"kind":"text","text":", if the solution doesn't exist the string must contain a single integer "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n42\n17\n444\n7\n51\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7 7 7 7 7 7\n-1\n400 0 40 0 4 0\n7 0 0 0 0 0\n47 4 0 0 0 0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"354E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/354/problem/E"}