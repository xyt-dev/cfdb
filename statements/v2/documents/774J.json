{"assets":[],"contentKind":"statement","contestId":"774","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"J. Stepan's Series"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Well, the series which Stepan watched for a very long time, ended. In total, the series had "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" episodes. For each of them, Stepan remembers either that he definitely has watched it, or that he definitely hasn't watched it, or he is unsure, has he watched this episode or not. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Stepan's dissatisfaction is the "},{"children":[{"kind":"text","text":"maximum"}],"kind":"container"},{"kind":"text","text":" number of consecutive series that Stepan did not watch."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine according to Stepan's memories if his dissatisfaction could be exactly equal to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ n"},{"kind":"text","text":") — the number of episodes in the series and the dissatisfaction which should be checked. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the sequence which consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" symbols \""},{"children":[{"kind":"text","text":"Y"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"N"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\". If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th symbol equals \""},{"children":[{"kind":"text","text":"Y"}],"kind":"container"},{"kind":"text","text":"\", Stepan remembers that he has watched the episode number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th symbol equals \""},{"children":[{"kind":"text","text":"N"}],"kind":"container"},{"kind":"text","text":"\", Stepan remembers that he hasn't watched the epizode number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th symbol equals \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\", Stepan doesn't exactly remember if he has watched the episode number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" or not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If Stepan's dissatisfaction can be exactly equal to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", then print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without qoutes). Otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without qoutes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\nNYNNY\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 1\n????NN\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test Stepan remembers about all the episodes whether he has watched them or not. His dissatisfaction is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", because he hasn't watch two episodes in a row — the episode number "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and the episode number "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". The answer is \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\", because "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test "},{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":", Stepan's dissatisfaction is greater than or equal to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" (because he remembers that he hasn't watch at least two episodes in a row — number "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" and number "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"), even if he has watched the episodes from the first to the fourth, inclusive."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"J","problemCode":"774J","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/774/problem/J"}