{"assets":[],"contentKind":"statement","contestId":"672","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Different is Good"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A wise man told Kerem \"Different is good\" once, so Kerem wants all things in his life to be different. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Kerem recently got a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of lowercase English letters. Since Kerem likes it when things are different, he wants all "},{"children":[{"kind":"text","text":"substrings"}],"kind":"container"},{"kind":"text","text":" of his string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to be distinct. Substring is a string formed by some number of consecutive characters of the string. For example, string \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\" has substrings \"\" (empty substring), \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" has at least two equal substrings then Kerem will change characters at some positions to some other lowercase English letters. Changing characters is a very tiring job, so Kerem want to perform as few changes as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the minimum number of changes needed to make all the substrings of the given string distinct, or determine that it is impossible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the length of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" consisting of only lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it's impossible to change the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" such that all its substring are distinct print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". Otherwise print the minimum required number of changes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\naa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nkoko\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nmurat\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample one of the possible solutions is to change the first character to '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, one may change the first character to '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and second character to '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"', so the string becomes \""},{"children":[{"kind":"text","text":"abko"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"672B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/672/problem/B"}