{"assets":[],"contentKind":"statement","contestId":"926","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Endless Roses Most Beautiful"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Arkady decided to buy roses for his girlfriend."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A flower shop has white, orange and red roses, and the total amount of them is "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Arkady thinks that red roses are not good together with white roses, so he won't buy a bouquet containing both red and white roses. Also, Arkady won't buy a bouquet where all roses have the same color. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Arkady wants to buy exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" roses. For each rose in the shop he knows its beauty and color: the beauty of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th rose is "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", and its color is "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ('"},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"' for a white rose, '"},{"children":[{"kind":"text","text":"O"}],"kind":"container"},{"kind":"text","text":"' for an orange rose and '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"' for a red rose). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Compute the maximum possible total beauty of a bouquet of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" roses satisfying the constraints above or determine that it is not possible to make such a bouquet."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 200 000"},{"kind":"text","text":") — the number of roses in the show and the number of roses Arkady wants to buy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence of integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ 10 000"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" equals the beauty of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th rose."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a string "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", consisting of uppercase English letters '"},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"O"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"', where "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" denotes the color of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th rose: '"},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"' denotes white, '"},{"children":[{"kind":"text","text":"O"}],"kind":"container"},{"kind":"text","text":"'  — orange, '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"' — red."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum possible total beauty of a bouquet of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" roses that satisfies the constraints above. If it is not possible to make a single such bouquet, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n4 3 4 1 6\nRROWW\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n10 20 14 20 11\nRRRRR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11 5\n5 6 3 2 3 4 7 5 4 5 6\nRWOORW