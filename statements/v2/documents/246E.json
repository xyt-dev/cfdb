{"assets":[],"contentKind":"statement","contestId":"246","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Blood Cousins Return"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarpus got hold of a family tree. The found tree describes the family relations of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people, numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Every person in this tree has at most one direct ancestor. Also, each person in the tree has a name, the names are not necessarily unique."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We call the man with a number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" a 1-ancestor of the man with a number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", if the man with a number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is a direct ancestor of the man with a number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We call the man with a number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" a "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-ancestor "},{"kind":"math_inline","text":"(k > 1)"},{"kind":"text","text":" of the man with a number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", if the man with a number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" has a 1-ancestor, and the man with a number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is a "},{"kind":"math_inline","text":"(k - 1)"},{"kind":"text","text":"-ancestor of the 1-ancestor of the man with a number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the tree the family ties do not form cycles. In other words there isn't a person who is his own direct or indirect ancestor (that is, who is an "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-ancestor of himself, for some "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x > 0"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We call a man with a number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-son of the man with a number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", if the man with a number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is a "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-ancestor of the man with a number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus is very much interested in how many sons and which sons each person has. He took a piece of paper and wrote "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" pairs of numbers "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":". Help him to learn for each pair "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" the number of distinct names among all names of the "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":"-sons of the man with number "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":" — the number of people in the tree. Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the description of people in the tree. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains space-separated string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" and integer "},{"kind":"math_inline","text":"ri"},{"kind":"math_inline","text":"(0 ≤ ri ≤ n)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" is the name of the man with a number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" is either the number of the direct ancestor of the man with a number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", if the man with a number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has no direct ancestor. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains a single integer "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ m ≤ 105)"},{"kind":"text","text":" — the number of Polycarpus's records. Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain space-separated pairs of integers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains integers "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ki"},{"kind":"math_inline","text":"(1 ≤ vi, ki ≤ n)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the family relationships do not form cycles. The names of all people are non-empty strings, consisting of no more than 20 lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" whitespace-separated integers — the answers to Polycarpus's records. Print the answers to the records in the order, in which the records occur in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\npasha 0\ngerald 1\ngerald 1\nvalera 2\nigor 3\nolesya 1\n5\n1 1\n1 2\n1 3\n3 1\n6 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2\n0\n1\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\nvalera 0\nvalera 1\nvalera 1\ngerald 0\nvalera 4\nkolya 4\n7\n1 1\n1 2\n2 1\n2 2\n4 1\n5 1\n6 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n0\n0\n0\n2\n0\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"246E","schema":2,"sourceKind":