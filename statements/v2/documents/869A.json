{"assets":[],"contentKind":"statement","contestId":"869","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. The Artful Expedient"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Rock... Paper!"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After Karen have found the deterministic winning (losing?) strategy for rock-paper-scissors, her brother, Koyomi, comes up with a new game as a substitute. The game works as follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is decided first. Both Koyomi and Karen independently choose "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct positive integers, denoted by "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y1, y2, ..., yn"},{"kind":"text","text":" respectively. They reveal their sequences, and repeat until "},{"children":[{"kind":"text","text":"all of "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" integers become distinct"}],"kind":"container"},{"kind":"text","text":", which is the only final state to be kept and considered."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then they count the number of ordered pairs "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i, j ≤ n"},{"kind":"text","text":") such that the value "},{"kind":"math_inline","text":"xi"},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"math_inline","text":"yj"},{"kind":"text","text":" equals to one of the "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" integers. Here "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" means the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise exclusive or"}],"kind":"link"},{"kind":"text","text":" operation on two integers, and is denoted by operators "},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" in most programming languages."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Karen claims a win if the number of such pairs is even, and Koyomi does otherwise. And you're here to help determine the winner of their latest game."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2 000"},{"kind":"text","text":") — the length of both sequences."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ 2·106"},{"kind":"text","text":") — the integers finally chosen by Koyomi."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"y1, y2, ..., yn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ yi ≤ 2·106"},{"kind":"text","text":") — the integers finally chosen by Karen."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Input guarantees that "},{"children":[{"kind":"text","text":"the given "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" integers are pairwise distinct"}],"kind":"container"},{"kind":"text","text":", that is, no pair "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i, j ≤ n"},{"kind":"text","text":") exists such that one of the following holds: "},{"kind":"math_inline","text":"xi = yj"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"i ≠ j"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"xi = xj"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"i ≠ j"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi = yj"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one line — the name of the winner, that is, \""},{"children":[{"kind":"text","text":"Koyomi"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"Karen"}],"kind":"container"},{"kind":"text","text":"\" (without quotes). Please be aware of the capitalization."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n4 5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Karen\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2 4 6 8 10\n9 7 5 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Karen\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, there are "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" pairs satisfying the constraint: "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 2)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(3, 3)"},{"kind":"text","text":". Thus, Karen wins since "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" is an even number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, there are "},{"kind":"math_inline","text":"16"},{"kind":"text","text":" such pairs, and Karen wins again."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"869A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/869/problem/A"}