{"assets":[],"contentKind":"statement","contestId":"1954","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Unique Strings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's say that two strings $$$a$$$ and $$$b$$$ are "},{"children":[{"kind":"text","text":"equal"}],"kind":"container"},{"kind":"text","text":" if you can get the string $$$b$$$ by cyclically shifting string $$$a$$$. For example, the strings "},{"children":[{"kind":"text","text":"0100110"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1100100"}],"kind":"container"},{"kind":"text","text":" are equal, while "},{"children":[{"kind":"text","text":"1010"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1100"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a binary string $$$s$$$ of length $$$n$$$. Its first $$$c$$$ characters are "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"-s, and its last $$$n - c$$$ characters are "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"-s."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one operation, you can replace one "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" with "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Calculate the number of unique strings you can get using no more than $$$k$$$ operations. Since the answer may be too large, print it modulo $$$10^9 + 7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and only line contains three integers $$$n$$$, $$$c$$$ and $$$k$$$ ($$$1 \\le n \\le 3000$$$; $$$1 \\le c \\le n$$$; $$$0 \\le k \\le n - c$$$) — the length of string $$$s$$$, the length of prefix of "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"-s and the maximum number of operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the single integer — the number of "},{"children":[{"kind":"text","text":"unique"}],"kind":"container"},{"kind":"text","text":" strings you can achieve performing no more than $$$k$$$ operations, modulo $$$10^9 + 7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n