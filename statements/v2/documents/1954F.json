"100"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"110"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"111"}],"kind":"container"},{"kind":"text","text":". String "},{"children":[{"kind":"text","text":"101"}],"kind":"container"},{"kind":"text","text":" is equal to "},{"children":[{"kind":"text","text":"110"}],"kind":"container"},{"kind":"text","text":", so we don't count it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, the possible strings are: "},{"children":[{"kind":"text","text":"10000"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"11000"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"10100"}],"kind":"container"},{"kind":"text","text":". String "},{"children":[{"kind":"text","text":"10010"}],"kind":"container"},{"kind":"text","text":" is equal to "},{"children":[{"kind":"text","text":"10100"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"10001"}],"kind":"container"},{"kind":"text","text":" is equal to "},{"children":[{"kind":"text","text":"11000"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1954F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1954/problem/F"}