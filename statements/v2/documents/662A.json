{"assets":[],"contentKind":"statement","contestId":"662","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Gambling Nim"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As you know, the game of \"Nim\" is played with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" piles of stones, where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th pile initially contains "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" stones. Two players alternate the turns. During a turn a player picks any non-empty pile and removes any positive number of stones from it. The one who is not able to make a move loses the game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya and Vasya are tired of playing Nim, so they invented their own version of the game and named it the \"Gambling Nim\". They have "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" two-sided cards, one side of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th card has number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" written on it, while the other side has number "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". At the beginning of the game the players put all the cards on the table, each card only one of its sides up, and this side is chosen independently and uniformly. Thus they obtain a sequence "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". Then they take "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" piles of stones, with "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th pile containing exactly "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" stones and play Nim. Petya takes the first turn."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given that both players play optimally, find the probability of Petya's victory. Output the answer as an irreducible fraction."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 500 000"},{"kind":"text","text":") — the number of cards in the deck."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains the description of one card, consisting of two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai, bi ≤ 1018"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the answer as an irreducible fraction "},{"kind":"math_inline","text":"p / q"},{"kind":"text","text":". If the probability of Petya's victory is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", print "},{"children":[{"kind":"text","text":"0/1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0/1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1/2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n0 4\n1 5\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1/1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"662A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/662/problem/A"}