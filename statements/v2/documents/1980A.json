{"assets":[],"contentKind":"statement","contestId":"1980","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Problem Generator"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vlad is planning to hold $$$m$$$ rounds next month. Each round should contain one problem of difficulty levels '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"E"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"F"}],"kind":"container"},{"kind":"text","text":"', and '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vlad already has a bank of $$$n$$$ problems, where the $$$i$$$-th problem has a difficulty level of $$$a_i$$$. There may not be enough of these problems, so he may have to come up with a few more problems."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vlad wants to come up with as few problems as possible, so he asks you to find the minimum number of problems he needs to come up with in order to hold $$$m$$$ rounds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if $$$m=1$$$, $$$n = 10$$$, $$$a=$$$ '"},{"children":[{"kind":"text","text":"BGECDCBDED"}],"kind":"container"},{"kind":"text","text":"', then he needs to come up with two problems: one of difficulty level '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"' and one of difficulty level '"},{"children":[{"kind":"text","text":"F"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\le n \\le 50$$$, $$$1 \\le m \\le 5$$$) — the number of problems in the bank and the number of upcoming rounds, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$a$$$ of $$$n$$$ characters from '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"' — the difficulties of the problems in the bank."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the minimum number of problems that need to come up with to hold $$$m$$$ rounds."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n10 1\nBGECDCBDED\n10 2\nBGECDCBDED\n9 1\nBBCDEFFGG\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n5\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1980A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1980/problem/A"}