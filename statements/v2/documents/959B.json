{"assets":[],"contentKind":"statement","contestId":"959","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Mahmoud and Ehab and the message"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mahmoud wants to send a message to his friend Ehab. Their language consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" words numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Some words have the same meaning so there are "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" groups of words such that all the words in some group have the same meaning."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mahmoud knows that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th word can be sent with cost "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". For each word in his message, Mahmoud can either replace it with another word of the same meaning or leave it as it is. Can you help Mahmoud determine the minimum cost of sending the message?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The cost of sending the message is the sum of the costs of sending every word in it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ k ≤ n ≤ 105, 1 ≤ m ≤ 105)"},{"kind":"text","text":" — the number of words in their language, the number of groups of words, and the number of words in Mahmoud's message respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" strings consisting of lowercase English letters of length not exceeding 20 which represent the words. It's guaranteed that the words are "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"an"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 109)"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the cost of sending the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th word."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines describe the groups of words of same meaning. The next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines each start with an integer "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"(1 ≤ x ≤ n)"},{"kind":"text","text":" which means that there are "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" words in this group, followed by "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" integers which represent the indices of words in this group. It's guaranteed that each word appears in exactly one group."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space-separated words which represent Mahmoud's message. Each of these words appears in the list of language's words."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line should contain the minimum cost to send the message after replacing some words (maybe none) with some words of the same meaning."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4 4\ni loser am the second\n100 1 1 5 10\n1 1\n1 3\n2 2 5\n1 4\ni am the second\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"107"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4 4\ni loser am the second\n100 20 1 5 10\n1 1\n1 3\n2 2 5\n1 4\ni am the second\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"116"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Mahmoud should replace the word \""},{"children":[{"kind":"text","text":"second"}],"kind":"container"},{"kind":"text","text":"\" with the word \""},{"children":[{"kind":"text","text":"loser"}],"kind":"container"},{"kind":"text","text":"\" because it has less cost so the cost will be 100+1+5+1=107."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, Mahmoud shouldn't do any replacement so the cost will be 100+1+5+10=116."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"959B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/959/problem/B"}