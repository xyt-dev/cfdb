{"assets":[],"contentKind":"statement","contestId":"1879","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Make it Alternating"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a binary string $$$s$$$. A binary string is a string consisting of characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can perform the following operation on $$$s$$$ any number of times "},{"children":[{"kind":"text","text":"(even zero)"}],"kind":"container"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" choose an integer $$$i$$$ such that $$$1 \\le i \\le |s|$$$, then erase the character $$$s_i$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You have to make $$$s$$$ alternating, i. e. after you perform the operations, every two adjacent characters in $$$s$$$ should be different."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your goal is to calculate two values:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the minimum number of operations required to make $$$s$$$ alternating; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the number of different "},{"children":[{"kind":"text","text":"shortest"}],"kind":"container"},{"kind":"text","text":" sequences of operations that make $$$s$$$ alternating. Two sequences of operations are different if in at least one operation, the chosen integer $$$i$$$ is different in these two sequences. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of one line containing the string $$$s$$$ ($$$1 \\le |s| \\le 2 \\cdot 10^5$$$). The string $$$s$$$ consists of characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" only."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraint on the input:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the total length of strings $$$s$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print two integers: the minimum number of operations you have to perform, and the number of different shortest sequences of operations. Since the second number might be large, print its remainder modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n10010\n111\n0101\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 2\n2 6\n0 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case of the example, the shortest sequences of operations are:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[2]$$$ (delete the $$$2$$$-nd character); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[3]$$$ (delete the $$$3$$$-rd character). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second test case of the example, the shortest sequences of operations are: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[2, 1]$$$ (delete the $$$2$$$-nd character, then delete the $$$1$$$-st character); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2, 2]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1, 1]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1, 2]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[3, 1]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[3, 2]$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the third test case of the example, the only shortest sequence of operations is $$$[]$$$ (empty sequence)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1879C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1879/problem/C"}