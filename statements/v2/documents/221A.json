,"text":"-th elements of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The Little Elephant's teacher believes that this function does not work correctly. But that-be do not get an F, the Little Elephant wants to show the performance of its function. Help him, find a permutation of numbers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", such that after performing the Little Elephant's function (that is call "},{"kind":"math_inline","text":"f(n)"},{"kind":"text","text":"), the permutation will be sorted in ascending order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 1000)"},{"kind":"text","text":" — the size of permutation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the required permutation. Numbers in a line should be separated by spaces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the answer exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"},{"attrs":{"role":"sampl