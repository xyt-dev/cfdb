[{"kind":"text","text":"Consider the second example: these are the permutations of length $$$3$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[1,2,3]$$$, $$$f(p)=1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1,3,2]$$$, $$$f(p)=1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2,1,3]$$$, $$$f(p)=2$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2,3,1]$$$, $$$f(p)=2$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[3,1,2]$$$, $$$f(p)=2$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[3,2,1]$$$, $$$f(p)=2$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The maximum value $$$f_{max}(3) = 2$$$, and there are $$$4$$$ permutations $$$p$$$ such that $$$f(p)=2$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1174E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1174/problem/E"}