{"assets":[],"contentKind":"statement","contestId":"977","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Two-gram"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Two-gram is an ordered pair (i.e. string of length two) of capital Latin letters. For example, \""},{"children":[{"kind":"text","text":"AZ"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"AA"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ZA"}],"kind":"container"},{"kind":"text","text":"\" — three distinct two-grams."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string $$$s$$$ consisting of $$$n$$$ capital Latin letters. Your task is to find "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" two-gram contained in the given string "},{"children":[{"kind":"text","text":"as a substring"}],"kind":"container"},{"kind":"text","text":" (i.e. two consecutive characters of the string) maximal number of times. For example, for string $$$s$$$ = \""},{"children":[{"kind":"text","text":"BBAABBBA"}],"kind":"container"},{"kind":"text","text":"\" the answer is two-gram \""},{"children":[{"kind":"text","text":"BB"}],"kind":"container"},{"kind":"text","text":"\", which contained in $$$s$$$ three times. In other words, find any most frequent two-gram."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that occurrences of the two-gram can overlap with each other."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer number $$$n$$$ ($$$2 \\le n \\le 100$$$) — the length of string $$$s$$$. The second line of the input contains the string $$$s$$$ consisting of $$$n$$$ capital Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only line containing exactly two capital Latin letters — "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" two-gram contained in the given string $$$s$$$ "},{"children":[{"kind":"text","text":"as a substring"}],"kind":"container"},{"kind":"text","text":" (i.e. two consecutive characters of the string) maximal number of times."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\nABACABA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"AB\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nZZZAA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"ZZ\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example \""},{"children":[{"kind":"text","text":"BA"}],"kind":"container"},{"kind":"text","text":"\" is also valid answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the only two-gram \""},{"children":[{"kind":"text","text":"ZZ"}],"kind":"container"},{"kind":"text","text":"\" can be printed because it contained in the string \""},{"children":[{"kind":"text","text":"ZZZAA"}],"kind":"container"},{"kind":"text","text":"\" two times."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"977B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/977/problem/B"}