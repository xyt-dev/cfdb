{"assets":[],"contentKind":"statement","contestId":"1133","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. K Balanced Teams"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are a coach at your local university. There are $$$n$$$ students under your supervision, the programming skill of the $$$i$$$-th student is $$$a_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to form $$$k$$$ teams for yet another new programming competition. As you know, the more students are involved in competition the more probable the victory of your university is! So you have to form no more than $$$k$$$ (and at least one) "},{"children":[{"kind":"text","text":"non-empty"}],"kind":"container"},{"kind":"text","text":" teams so that the "},{"children":[{"kind":"text","text":"total"}],"kind":"container"},{"kind":"text","text":" number of students in them is maximized. But you also know that "},{"children":[{"kind":"text","text":"each"}],"kind":"container"},{"kind":"text","text":" team should be "},{"children":[{"kind":"text","text":"balanced"}],"kind":"container"},{"kind":"text","text":". It means that the programming skill of each pair of students in "},{"children":[{"kind":"text","text":"each"}],"kind":"container"},{"kind":"text","text":" team should differ by no more than $$$5$$$. Teams are independent from one another (it means that the difference between programming skills of two students from two different teams does not matter)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is possible that some students not be included in any team at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to report the maximum possible "},{"children":[{"kind":"text","text":"total"}],"kind":"container"},{"kind":"text","text":" number of students in no more than $$$k$$$ (and at least one) "},{"children":[{"kind":"text","text":"non-empty"}],"kind":"container"},{"children":[{"kind":"text","text":"balanced"}],"kind":"container"},{"kind":"text","text":" teams."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"If you are Python programmer, consider using PyPy instead of Python when you submit your code."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\le k \\le n \\le 5000$$$) — the number of students and the maximum number of teams, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$), where $$$a_i$$$ is a programming skill of the $$$i$$$-th student."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the maximum possible "},{"children":[{"kind":"text","text":"total"}],"kind":"container"},{"kind":"text","text":" number of students in no more than $$$k$$$ (and at least one) "},{"children":[{"kind":"text","text":"non-empty"}],"kind":"container"},{"children":[{"kind":"text","text":"balanced"}],"kind":"container"},{"kind":"text","text":" teams."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 2\n1 2 15 15 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6 1\n36 4 1 25 9 16\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 4\n1 10 100 1000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1133E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1133/problem/E"}