{"assets":["/statement-assets/45d23a366eb7ace947cd8bca115b6bc2d1aab1781386170d668651ae967cf831.png","/statement-assets/4fbcdbd293bd8223ad89219b7ce720a006b833a83054d7e601937dfd65bdd450.png","/statement-assets/a7ce0e4daa8cd2f7a56ac814f2df2a191bc1538c7ab8f97f80c6d5182224864e.png"],"contentKind":"statement","contestId":"1029","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Tree with Small Distances"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an undirected tree consisting of $$$n$$$ vertices. An undirected tree is a connected undirected graph with $$$n - 1$$$ edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to add the minimum number of edges in such a way that the length of the shortest path from the vertex $$$1$$$ to any other vertex is at most $$$2$$$. Note that you are not allowed to add loops and multiple edges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$2 \\le n \\le 2 \\cdot 10^5$$$) — the number of vertices in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following $$$n - 1$$$ lines contain edges: edge $$$i$$$ is given as a pair of vertices $$$u_i, v_i$$$ ($$$1 \\le u_i, v_i \\le n$$$). It is guaranteed that the given edges form a tree. "},{"children":[{"kind":"text","text":"It is guaranteed that there are no loops and multiple edges in the given edges."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum number of edges you have to add in order to make the shortest distance from the vertex $$$1$$$ to any other vertex at most $$$2$$$. Note that you are not allowed to add loops and multiple edges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 2\n2 3\n2 4\n4 5\n4 6\n5 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 2\n1 3\n2 4\n2 5\n3 6\n1 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 2\n2 3\n3 4\n3 5\n3 6\n3 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The tree corresponding to the first example: "},{"attrs":{"alt":"","src":"/statement-assets/45d23a366eb7ace947cd8bca115b6bc2d1aab1781386170d668651ae967cf831.png"},"kind":"image"},{"kind":"text","text":" The answer is $$$2$$$, some of the possible answers are the following: $$$[(1, 5), (1, 6)]$$$, $$$[(1, 4), (1, 7)]$$$, $$$[(1, 6), (1, 7)]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The tree corresponding to the second example: "},{"attrs":{"alt":"","src":"/statement-assets/4fbcdbd293bd8223ad89219b7ce720a006b833a83054d7e601937dfd65bdd450.png"},"kind":"image"},{"kind":"text","text":" The answer is $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The tree corresponding to the third example: "},{"attrs":{"alt":"","src":"/statement-assets/a7ce0e4daa8cd2f7a56ac814f2df2a191bc1538c7ab8f97f80c6d5182224864e.png"},"kind":"image"},{"kind":"text","text":" The answer is $$$1$$$, only one possible way to reach it is to add the edge $$$(1, 3)$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1029E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1029/problem/E"}