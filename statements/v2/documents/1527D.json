{"assets":["/statement-assets/5888bfad6974e966c9bead232544d8c02515ceb9fee32260920027c4e62132af.png","/statement-assets/658d3466ffc147e8c56f2588d820e20356ed0b7dab5605accb8d2861b5a39999.png"],"contentKind":"statement","contestId":"1527","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. MEX Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a tree with $$$n$$$ nodes, numerated from $$$0$$$ to $$$n-1$$$. For each $$$k$$$ between $$$0$$$ and $$$n$$$, inclusive, you have to count the number of unordered pairs $$$(u,v)$$$, $$$u \\neq v$$$, such that the "},{"children":[{"kind":"text","text":"MEX"}],"kind":"container"},{"kind":"text","text":" of all the node labels in the shortest path from $$$u$$$ to $$$v$$$ (including end points) is $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"MEX"}],"kind":"container"},{"kind":"text","text":" of a sequence of integers is the smallest non-negative integer that does not belong to the sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$2 \\le n \\le 2 \\cdot 10^{5}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n-1$$$ lines of each test case describe the tree that has to be constructed. These lines contain two integers $$$u$$$ and $$$v$$$ ($$$0 \\le u,v \\le n-1$$$) denoting an edge between $$$u$$$ and $$$v$$$ ($$$u \\neq v$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given edges form a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is also guaranteed that the sum of $$$n$$$ for all test cases does not exceed $$$2 \\cdot 10^{5}$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print $$$n+1$$$ integers: the number of paths in the tree, such that the MEX of all the node labels in that path is $$$k$$$ for each $$$k$$$ from $$$0$$$ to $$$n$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n4\n0 1\n0 2\n2 3\n2\n1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 2 1 1 1 \n0 0 1 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" In example case $$$1$$$, "},{"attrs":{"alt":"","src":"/statement-assets/5888bfad6974e966c9bead232544d8c02515ceb9fee32260920027c4e62132af.png"},"kind":"image"},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$k = 0$$$, there is $$$1$$$ path that is from $$$2$$$ to $$$3$$$ as $$$MEX([2, 3]) = 0$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$k = 1$$$, there are $$$2$$$ paths that is from $$$0$$$ to $$$2$$$ as $$$MEX([0, 2]) = 1$$$ and $$$0$$$ to $$$3$$$ as $$$MEX([0, 2, 3]) = 1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$k = 2$$$, there is $$$1$$$ path that is from $$$0$$$ to $$$1$$$ as $$$MEX([0, 1]) = 2$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$k = 3$$$, there is $$$1$$$ path that is from $$$1$$$ to $$$2$$$ as $$$MEX([1, 0, 2]) = 3$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$k = 4$$$, there is $$$1$$$ path that is from $$$1$$$ to $$$3$$$ as $$$MEX([1, 0, 2, 3]) = 4$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" In example case $$$2$$$, "},{"attrs":{"alt":"","src":"/statement-assets/658d3466ffc147e8c56f2588d820e20356ed0b7dab5605accb8d2861b5a39999.png"},"kind":"image"},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$k = 0$$$, there are no such paths. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$k = 1$$$, there are no such paths. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$k = 2$$$, there is $$$1$$$ path that is from $$$0$$$ to $$$1$$$ as $$$MEX([0, 1]) = 2$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1527D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1527/problem/D"}