{"assets":[],"contentKind":"statement","contestId":"253","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Table with Letters - 2"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"input_channel"},"children":[{"children":[{"kind":"text","text":"input"}],"kind":"container"},{"kind":"text","text":"input.txt"}],"kind":"container"},{"attrs":{"role":"output_channel"},"children":[{"children":[{"kind":"text","text":"output"}],"kind":"container"},{"kind":"text","text":"output.txt"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya has recently started to learn English. Now he needs to remember how to write English letters. He isn't sure about some of them, so he decided to train a little."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He found a sheet of squared paper and began writing arbitrary English letters there. In the end Vasya wrote "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines containing "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters each. Thus, he got a rectangular "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" table, each cell of the table contained some English letter. Let's number the table rows from top to bottom with integers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", and columns — from left to right with integers from 1 to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After that Vasya looked at the resulting rectangular table and wondered, how many subtables are there, that matches both following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the subtable contains at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" cells with \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" letter; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" all letters, located in all four corner cells of the subtable, are equal. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Formally, a subtable's definition is as follows. It is defined by four integers "},{"kind":"math_inline","text":"x1, y1, x2, y2"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"1 ≤ x1 < x2 ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ y1 < y2 ≤ m"},{"kind":"text","text":". Then the subtable contains all such cells "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is the row number, "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is the column number), for which the following inequality holds "},{"kind":"math_inline","text":"x1 ≤ x ≤ x2, y1 ≤ y ≤ y2"},{"kind":"text","text":". The corner cells of the table are cells "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x1, y2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x2, y1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya is already too tired after he's been writing letters to a piece of paper. That's why he asks you to count the value he is interested in."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n, m, k"},{"kind":"math_inline","text":"(2 ≤ n, m ≤ 400; 0 ≤ k ≤ n·m)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters each — the given table. Each character of the table is a lowercase English letter."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of required subtables."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4 4\naabb\nbaab\nbaab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5 1\nababa\nccaca\nccacb\ncbabc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"There are two suitable subtables in the first sample: the first one's upper left corner is cell "},{"kind":"math_inline","text":"(2, 2)"},{"kind":"text","text":" and lower right corner is cell "},{"kind":"math_inline","text":"(3, 3)"},{"kind":"text","text":", the second one's upper left corner is cell "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":" and lower right corner is cell "},{"kind":"math_inline","text":"(3, 4)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"253D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/253/problem/D"}