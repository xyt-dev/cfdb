t":"), that means that sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" meets the described property. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Obviously the sequence of sums will have "},{"kind":"math_inline","text":"n - k + 1"},{"kind":"text","text":" elements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Somebody (we won't say who) replaced some numbers in Arthur's sequence by question marks (if this number is replaced, it is replaced by exactly one question mark). We need to restore the sequence so that it meets the required property and also minimize the sum "},{"kind":"math_inline","text":"|ai|"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"|ai|"},{"kind":"text","text":" is the absolute value of "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 105"},{"kind":"text","text":"), showing how many numbers are in Arthur's sequence and the lengths of segments respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated elements "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"ai  =  ?"},{"kind":"text","text":", then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th element of Arthur's sequence was replaced by a question mark. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ ai ≤ 109"},{"kind":"text","text":") is the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th element of Arthur's sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If Arthur is wrong at some point and there is no sequence that could fit the given information, print a single string \""},{"children":[{"kind":"text","text":"Incorrect sequence"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers — Arthur's favorite sequence. If there are multiple such sequences, print the sequence with the minimum sum "},{"kind":"math_inline","text":"|ai|"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"|ai|"},{"kind":"text","text":" is the absolute value of "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". If there are still several such sequences, you are allowed to print any of them. Print the elements of the sequence without leading zeroes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n? 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 1 2 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{