{"assets":[],"contentKind":"statement","contestId":"584","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Anton and Ira"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Anton loves transforming one permutation into another one by swapping elements for money, and Ira doesn't like paying for stupid games. Help them obtain the required permutation by paying as little money as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, we have two permutations, "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". We can swap "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"pj"},{"kind":"text","text":", by paying "},{"kind":"math_inline","text":"|i - j|"},{"kind":"text","text":" coins for it. Find and print the smallest number of coins required to obtain permutation "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" from permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". Also print the sequence of swap operations at which we obtain a solution. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2000"},{"kind":"text","text":") — the length of the permutations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". Each number from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" occurs exactly once in this line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — permutation "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Each number from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" occurs once in this line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the minimum number of coins that you need to spend to transform permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" into permutation "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ k ≤ 2·106"},{"kind":"text","text":") — the number of operations needed to get the solution."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines print the operations. Each line must contain two numbers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i, j ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"i ≠ j"},{"kind":"text","text":"), which means that you need to swap "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"pj"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the solution exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n4 2 1 3\n3 2 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n2\n4 3\n3 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test we swap numbers on positions 3 and 4 and permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" becomes 4 2 3 1. We pay "},{"kind":"math_inline","text":"|3 - 4| = 1"},{"kind":"text","text":" coins for that. On second turn we swap numbers on positions 1 and 3 and get permutation "},{"kind":"math_inline","text":"3241"},{"kind":"text","text":" equal to "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". We pay "},{"kind":"math_inline","text":"|3 - 1| = 2"},{"kind":"text","text":" coins for that. In total we pay three coins."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"584E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/584/problem/E"}