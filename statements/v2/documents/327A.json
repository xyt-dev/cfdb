{"assets":[],"contentKind":"statement","contestId":"327","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Flipping Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Iahub got bored, so he invented a game to be played on paper. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He writes "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". Each of those integers can be either 0 or 1. He's allowed to do exactly one move: he chooses two indices "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ j ≤ n"},{"kind":"text","text":") and flips all values "},{"kind":"math_inline","text":"ak"},{"kind":"text","text":" for which their positions are in range "},{"kind":"math_inline","text":"[i, j]"},{"kind":"text","text":" (that is "},{"kind":"math_inline","text":"i ≤ k ≤ j"},{"kind":"text","text":"). Flip the value of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" means to apply operation "},{"kind":"math_inline","text":"x = 1"},{"kind":"text","text":" - "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The goal of the game is that after "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" one move to obtain the maximum number of ones. Write a program to solve the little game of Iahub."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":"). In the second line of the input there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". It is guaranteed that each of those "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" values is either 0 or 1."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print an integer — the maximal number of 1s that can be obtained after exactly one move. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 0 0 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 0 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first case, flip the segment from 2 to 5 "},{"kind":"math_inline","text":"(i = 2, j = 5)"},{"kind":"text","text":". That flip changes the sequence, it becomes: [1 1 1 0 1]. So, it contains four ones. There is no way to make the whole sequence equal to [1 1 1 1 1]."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second case, flipping only the second and the third element "},{"kind":"math_inline","text":"(i = 2, j = 3)"},{"kind":"text","text":" will turn all numbers into 1."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"327A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/327/problem/A"}