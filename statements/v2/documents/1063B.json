{"assets":[],"contentKind":"statement","contestId":"1063","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Labyrinth"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are playing some computer game. One of its levels puts you in a maze consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each of which contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" cells. Each cell either is free or is occupied by an obstacle. The starting cell is in the row "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and column "},{"kind":"math_inline","text":"c"},{"kind":"text","text":". In one step you can move one square up, left, down or right, if the target cell is not occupied by an obstacle. You can't move beyond the boundaries of the labyrinth."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, your keyboard is about to break, so you can move left no more than "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" times and move right no more than "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" times. There are no restrictions on the number of moves up and down since the keys used to move up and down are in perfect condition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now you would like to determine for each cell whether there exists a sequence of moves that will put you from the starting cell to this particular one. How many cells of the board have this property?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 2000"},{"kind":"text","text":") — the number of rows and the number columns in the labyrinth respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains two integers "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ r ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ c ≤ m"},{"kind":"text","text":") — index of the row and index of the column that define the starting cell."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ x, y ≤ 109"},{"kind":"text","text":") — the maximum allowed number of movements to the left and to the right respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines describe the labyrinth. Each of them has length of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and consists only of symbols '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"'. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th character of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line corresponds to the cell of labyrinth at row "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and column "},{"kind":"math_inline","text":"j"},{"kind":"text","text":". Symbol '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' denotes the free cell, while symbol '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"' denotes the cell with an obstacle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed, that the starting cell contains no obstacles."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print exactly one integer — the number of cells in the labyrinth, which are reachable from starting cell, including the starting cell itself."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n3 2\n1 2\n.....\n.***.\n...**\n*....\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n2 2\n0 1\n....\n..*.\n....\n....\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Cells, reachable in the corresponding example, are marked with '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First example: "}],"kind":"paragraph"},{"children":[{"kind":"code_block","text":"\n+++..\n+***.\n+++**\n*+++.\n"}],"kind":"container"},{"children":[{"kind":"text","text":"Second example: "}],"kind":"paragraph"},{"children":[{"kind":"code_block","text":"\n.++.\n.+*.\n.++.\n.++.\n"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1063B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1063/problem/B"}