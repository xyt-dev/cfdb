{"assets":[],"contentKind":"statement","contestId":"1519","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Maximum Sum of Products"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two integer arrays $$$a$$$ and $$$b$$$ of length $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can reverse "},{"children":[{"kind":"text","text":"at most one"}],"kind":"container"},{"kind":"text","text":" subarray (continuous subsegment) of the array $$$a$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to reverse such a subarray that the sum $$$\\sum\\limits_{i=1}^n a_i \\cdot b_i$$$ is "},{"children":[{"kind":"text","text":"maximized"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$1 \\le n \\le 5000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^7$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains $$$n$$$ integers $$$b_1, b_2, \\dots, b_n$$$ ($$$1 \\le b_i \\le 10^7$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kin