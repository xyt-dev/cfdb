{"assets":["/statement-assets/e240109f1a3d948608d7e67c09aced131848e5c47e1dbf09b1a6c4044a4c0eea.png"],"contentKind":"statement","contestId":"526","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. King of Thieves"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"In this problem you will meet the simplified model of game King of Thieves"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In a new ZeptoLab game called \"King of Thieves\" your aim is to reach a chest with gold by controlling your character, avoiding traps and obstacles on your way."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e240109f1a3d948608d7e67c09aced131848e5c47e1dbf09b1a6c4044a4c0eea.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"An interesting feature of the game is that you can design your own levels that will be available to other players. Let's consider the following simple design of a level."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A dungeon consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" segments located at a same vertical level, each segment is either a platform that character can stand on, or a pit with a trap that makes player lose if he falls into it. All segments have the same length, platforms on the scheme of the level are represented as "},{"children":[{"kind":"text","text":"'*'"}],"kind":"container"},{"kind":"text","text":" and pits are represented as "},{"children":[{"kind":"text","text":"'.'"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One of things that affects speedrun characteristics of the level is a possibility to perform a series of consecutive jumps of the same length. More formally, when the character is on the platform number "},{"kind":"math_inline","text":"i1"},{"kind":"text","text":", he can make a sequence of jumps through the platforms "},{"kind":"math_inline","text":"i1 < i2 < ... < ik"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"i2 - i1 = i3 - i2 = ... = ik - ik - 1"},{"kind":"text","text":". Of course, all segments "},{"kind":"math_inline","text":"i1, i2, ... ik"},{"kind":"text","text":" should be exactly the platforms, not pits. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a level to be "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if you can perform a sequence of "},{"children":[{"kind":"text","text":"four"}],"kind":"container"},{"kind":"text","text":" jumps of the same length or in the other words there must be a sequence "},{"kind":"math_inline","text":"i1, i2, ..., i5"},{"kind":"text","text":", consisting of "},{"children":[{"kind":"text","text":"five"}],"kind":"container"},{"kind":"text","text":" platforms so that the intervals between consecutive platforms are of the same length. Given the scheme of the level, check if it is good."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of segments on the level."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains the scheme of the level represented as a string of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters "},{"children":[{"kind":"text","text":"'*'"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"'.'"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the level is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":", print the word "},{"children":[{"kind":"text","text":"\"yes\""}],"kind":"container"},{"kind":"text","text":" (without the quotes), otherwise print the word "},{"children":[{"kind":"text","text":"\"no\""}],"kind":"container"},{"kind":"text","text":" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"16\n.**.*..*.***.**.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"yes"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11\n.*.*...*.*.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"no"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test you may perform a sequence of jumps through platforms "},{"kind":"math_inline","text":"2, 5, 8, 11, 14"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"526A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/526/problem/A"}