{"assets":[],"contentKind":"statement","contestId":"852","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"I. Dating"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"This story is happening in a town named BubbleLand. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" houses in BubbleLand. In each of these "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" houses lives a boy or a girl. People there really love numbers and everyone has their favorite number "},{"kind":"math_inline","text":"f"},{"kind":"text","text":". That means that the boy or girl that lives in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th house has favorite number equal to "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The houses are numerated with numbers "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The houses are connected with "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" bidirectional roads and you can travel from any house to any other house in the town. There is exactly one path between every pair of houses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A new dating had agency opened their offices in this mysterious town and the citizens were very excited. They immediately sent "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" questions to the agency and each question was of the following format: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"a b"},{"kind":"text","text":" — asking how many ways are there to choose a couple (boy and girl) that have the same favorite number and live in one of the houses on the unique path from house "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to house "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help the dating agency to answer the questions and grow their business."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":"), the number of houses in the town."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" if a boy lives in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th house or "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" if a girl lives in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th house."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number represents the favorite number "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ fi ≤ 109"},{"kind":"text","text":") of the girl or boy that lives in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th house."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain information about the roads and the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":") which means that there exists road between those two houses. It is guaranteed that it's possible to reach any house from any other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following line contains an integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 105"},{"kind":"text","text":"), the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines represents a question and consists of two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each of the "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" questions output a single number, the answer to the citizens question."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 0 0 1 0 1 0\n9 2 9 2 2 9 9\n2 6\n1 2\n4 2\n6 5\n3 6\n7 4\n2\n1 3\n7 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first question from house "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to house "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", the potential couples are "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(6, 3)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second question from house "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" to house "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", the potential couples are "},{"kind":"math_inline","text":"(7, 6)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(4, 2)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(4, 5)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"I","problemCode":"852I","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/852/problem/I"}