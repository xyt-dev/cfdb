{"assets":["/statement-assets/ce512e63043fbb0f548ba4881bd9fc5cc9d569661ec0e3e65f819905cdb5752c.png","/statement-assets/6bab689b43a37dc71ae9bae2bd79749ba5b2da6a61973f7caea39bdd21c4fc5c.png"],"contentKind":"statement","contestId":"560","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Gerald is into Art"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Gerald bought two very rare paintings at the Sotheby's auction and he now wants to hang them on the wall. For that he bought a special board to attach it to the wall and place the paintings on the board. The board has shape of an "},{"kind":"math_inline","text":"a1 × b1"},{"kind":"text","text":" rectangle, the paintings have shape of a "},{"kind":"math_inline","text":"a2 × b2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a3 × b3"},{"kind":"text","text":" rectangles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since the paintings are painted in the style of abstract art, it does not matter exactly how they will be rotated, but still, one side of both the board, and each of the paintings must be parallel to the floor. The paintings can touch each other and the edges of the board, but can not overlap or go beyond the edge of the board. Gerald asks whether it is possible to place the paintings on the board, or is the board he bought not large enough?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated numbers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b1"},{"kind":"text","text":" — the sides of the board. Next two lines contain numbers "},{"kind":"math_inline","text":"a2, b2, a3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b3"},{"kind":"text","text":" — the sides of the paintings. All numbers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"text","text":" in the input are integers and fit into the range from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the paintings can be placed on the wall, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), and if they cannot, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 3\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n3 3\n3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n2 3\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"That's how we can place the pictures in the first test:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ce512e63043fbb0f548ba4881bd9fc5cc9d569661ec0e3e65f819905cdb5752c.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"And that's how we can do it in the third one."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6bab689b43a37dc71ae9bae2bd79749ba5b2da6a61973f7caea39bdd21c4fc5c.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"560B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/560/problem/B"}