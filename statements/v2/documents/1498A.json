{"assets":[],"contentKind":"statement","contestId":"1498","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. GCD Sum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The $$$\\text{$$$gcdSum$$$}$$$ of a positive integer is the $$$gcd$$$ of that integer with its sum of digits. Formally, $$$\\text{$$$gcdSum$$$}(x) = gcd(x, \\text{ sum of digits of } x)$$$ for a positive integer $$$x$$$. $$$gcd(a, b)$$$ denotes the greatest common divisor of $$$a$$$ and $$$b$$$ — the largest integer $$$d$$$ such that both integers $$$a$$$ and $$$b$$$ are divisible by $$$d$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example: $$$\\text{$$$gcdSum$$$}(762) = gcd(762, 7 + 6 + 2)=gcd(762,15) = 3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given an integer $$$n$$$, find the smallest integer $$$x \\ge n$$$ such that $$$\\text{$$$gcdSum$$$}(x) \\gt 1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains one integer $$$t$$$ $$$(1 \\le t \\le 10^4)$$$ — the number of test cases. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$t$$$ lines follow, each containing a single integer $$$n$$$ $$$(1 \\le n \\le 10^{18})$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All test cases in one test are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output $$$t$$$ lines, where the $$$i$$$-th line is a single integer containing the answer to the $$$i$$$-th test case."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n11\n31\n75\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n12\n33\n75\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let us explain the three test cases in the sample."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Test case 1:"}],"kind":"container"},{"kind":"text","text":" $$$n = 11$$$: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{$$$gcdSum$$$}(11) = gcd(11, 1 + 1) = gcd(11,\\ 2) = 1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{$$$gcdSum$$$}(12) = gcd(12, 1 + 2) = gcd(12,\\ 3) = 3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So the smallest number $$$\\ge 11$$$ whose $$$gcdSum$$$ $$$ \\gt 1$$$ is $$$12$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Test case 2:"}],"kind":"container"},{"kind":"text","text":" $$$n = 31$$$: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{$$$gcdSum$$$}(31) = gcd(31, 3 + 1) = gcd(31,\\ 4) = 1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{$$$gcdSum$$$}(32) = gcd(32, 3 + 2) = gcd(32,\\ 5) = 1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{$$$gcdSum$$$}(33) = gcd(33, 3 + 3) = gcd(33,\\ 6) = 3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So the smallest number $$$\\ge 31$$$ whose $$$gcdSum$$$ $$$ \\gt 1$$$ is $$$33$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Test case 3:"}],"kind":"container"},{"kind":"text","text":" $$$\\ n = 75$$$: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{$$$gcdSum$$$}(75) = gcd(75, 7 + 5) = gcd(75,\\ 12) = 3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$\\text{$$$gcdSum$$$}$$$ of $$$75$$$ is already $$$ \\gt 1$$$. Hence, it is the answer."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1498A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1498/problem/A"}