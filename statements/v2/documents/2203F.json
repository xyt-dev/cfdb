{"assets":[],"contentKind":"statement","contestId":"2203","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Binary Search with One Swap"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider the following algorithm for searching for an integer $$$x$$$ in an array $$$a$$$ of length $$$n$$$, where the elements are numbered from $$$1$$$ to $$$n$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" initialize $$$l = 1$$$ and $$$r = n$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if $$$l \\gt r$$$, terminate the algorithm and report that the desired element was not found; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" compute $$$m = \\lfloor \\frac{l + r}{2} \\rfloor$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if $$$a_m = x$$$, terminate the algorithm and report that the desired element was found; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if $$$a_m \\lt x$$$, set $$$l = m + 1$$$, otherwise set $$$r = m - 1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" go to step $$$2$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It can be shown that if the array $$$a$$$ is sorted in non-decreasing order, then any element of $$$a$$$ will be successfully found by this algorithm."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is as follows: for a given number $$$n$$$, consider all pairs $$$(i, j)$$$ such that $$$1 \\le i \\lt j \\le n$$$. For each of these pairs, you need to calculate its "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" — the number of integers $$$x$$$ from $$$1$$$ to $$$n$$$ that can be successfully found by the described algorithm if we take the array $$$a = [1, 2, 3, \\dots, n]$$$ and swap the elements $$$a_i$$$ and $$$a_j$$$. After that, for each $$$k$$$ from $$$0$$$ to $$$n$$$, you need to output $$$p_k$$$ — the number of pairs with beauty $$$k$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains one integer $$$n$$$ ($$$3 \\le n \\le 5 \\cdot 10^6$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$n+1$$$ integers $$$p_0, p_1, \\dots, p_n$$$, where $$$p_k$$$ is the number of pairs $$$(i, j)$$$ with beauty $$$k$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0 0 3 3 0 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0 0 2 4 4 0 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0 1 2 0 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n13\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0 0 0 0 0 0 1 3 8 9 21 24 12 0 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider an example where $$$n = 4$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if we swap $$$a_1$$$ and $$$a_2$$$, then $$$1$$$, $$$3$$$, and $$$4$$$ can be successfully found; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if we swap $$$a_1$$$ and $$$a_3$$$, then $$$2$$$ and $$$4$$$ can be successfully found; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if we swap $$$a_2$$$ and $$$a_3$$$, then $$$1$$$, $$$3$$$, and $$$4$$$ can be successfully found; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if we swap $$$a_1$$$ and $$$a_4$$$, then $$$2$$$ and $$$3$$$ can be successfully found; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if we swap $$$a_2$$$ and $$$a_4$$$, then $$$1$$$ and $$$4$$$ can be successfully found; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if we swap $$$a_3$$$ and $$$a_4$$$, then $$$1$$$, $$$2$$$, and $$$4$$$ can be successfully found. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"2203F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2203/problem/F"}