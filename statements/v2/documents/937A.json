"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n42 0 0 42\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"There are three ways to choose a subset in sample case one."}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Only participants with 3 points will get diplomas. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Participants with 2 or 3 points will get diplomas. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Everyone will get a diploma! "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The only option in sample case two is to award everyone."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that in sample case three participants with zero scores cannot get anything."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"937A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/937/problem/A"}