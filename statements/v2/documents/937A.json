{"assets":[],"contentKind":"statement","contestId":"937","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Olympiad"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The recent All-Berland Olympiad in Informatics featured "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" participants with each scoring a certain amount of points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As the head of the programming committee, you are to determine the set of participants to be awarded with diplomas with respect to the following criteria: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" At least one participant should get a diploma. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" None of those with score equal to zero should get awarded. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" When someone is awarded, all participants with score "},{"children":[{"kind":"text","text":"not less"}],"kind":"container"},{"kind":"text","text":" than his score should also be awarded. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Determine the number of ways to choose a subset of participants that will receive the diplomas."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line con