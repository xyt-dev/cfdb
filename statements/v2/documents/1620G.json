{"assets":[],"contentKind":"statement","contestId":"1620","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Subsequences Galore"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"10 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"For a sequence of strings $$$[t_1, t_2, \\dots, t_m]$$$, let's define the function $$$f([t_1, t_2, \\dots, t_m])$$$ as the number of different strings ("},{"children":[{"kind":"text","text":"including the empty string"}],"kind":"container"},{"kind":"text","text":") that are subsequences of "},{"children":[{"kind":"text","text":"at least one"}],"kind":"container"},{"kind":"text","text":" string $$$t_i$$$. $$$f([]) = 0$$$ (i. e. the number of such strings for an empty sequence is $$$0$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a sequence of strings $$$[s_1, s_2, \\dots, s_n]$$$. Every string in this sequence consists of lowercase Latin letters and is "},{"children":[{"kind":"text","text":"sorted"}],"kind":"container"},{"kind":"text","text":" (i. e., each string begins with several (maybe zero) characters "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":", then several (maybe zero) characters "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":", ..., ends with several (maybe zero) characters "},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each of $$$2^n$$$ subsequences of $$$[s_1, s_2, \\dots, s_n]$$$, calculate the value of the function $$$f$$$ modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$1 \\le n \\le 23$$$) — the number of strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$n$$$ lines follow. The $$$i$$$-th line contains the string $$$s_i$$$ ($$$1 \\le |s_i| \\le 2 \\cdot 10^4$$$), consisting of lowercase Latin letters. Each string $$$s_i$$$ is sorted."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Since printing up to $$$2^{23}$$$ integers would be really slow, you should do the following:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each of the $$$2^n$$$ subsequences (which we denote as $$$[s_{i_1}, s_{i_2}, \\dots, s_{i_k}]$$$), calculate $$$f([s_{i_1}, s_{i_2}, \\dots, s_{i_k}])$$$, take it modulo $$$998244353$$$, then multiply it by $$$k \\cdot (i_1 + i_2 + \\dots + i_k)$$$. Print the XOR of all $$$2^n$$$ integers you get."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The indices $$$i_1, i_2, \\dots, i_k$$$ in the description of each subsequences are $$$1$$$-indexed (i. e. are from $$$1$$$ to $$$n$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\na\nb\nc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n92\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\naa\na\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n21\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\na\na\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\nabcd\naabb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n124\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\nddd\naaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\naaaaaaaabbbbbbbbbbbcccccccccccciiiiiiiiiiiiiiiiiiiiiiooooooooooqqqqqqqqqqqqqqqqqqvvvvvzzzzzzzzzzzz\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_b