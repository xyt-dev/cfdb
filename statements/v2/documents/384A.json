{"assets":[],"contentKind":"statement","contestId":"384","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Coder"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Iahub likes chess very much. He even invented a new chess piece named Coder. A Coder can move (and attack) one square horizontally or vertically. More precisely, if the Coder is located at position "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":", he can move to (or attack) positions "},{"kind":"math_inline","text":"(x + 1, y)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x–1, y)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x, y + 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(x, y–1)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Iahub wants to know how many Coders can be placed on an "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" chessboard, so that no Coder attacks any other Coder."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 1000)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first line print an integer, the maximum number of Coders that can be placed on the chessboard."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters, describing the configuration of the Coders. For an empty cell print an '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"', and for a Coder print a '"},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple correct answers, you can print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\nC.\n.C\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"384A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/384/problem/A"}