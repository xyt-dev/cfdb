{"assets":[],"contentKind":"statement","contestId":"2247","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Zero Sum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array $$$a$$$ of length $$$n$$$, consisting only of $$$-1$$$ and $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may perform the following operation on $$$a$$$ any number of times:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Choose an index $$$i$$$ satisfying $$$1 \\le i \\le n - 1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Assign $$$a_i = -a_i$$$ and $$$a_{i + 1} = -a_{i + 1}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Determine whether it is possible to make the sum of elements of $$$a$$$ equal to $$$0$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 200$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 100$$$) — the length of array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$a_i \\in \\{-1, 1\\}$$$) — the array $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if it is possible to make the sum of elements of $$$a$$$ equal to $$$0$$$, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output the answer in any case (upper or lower). For example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be recognized as positive responses."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1\n-1\n2\n1 -1\n2\n1 1\n5\n1 -1 1 -1 1\n6\n-1 1 -1 -1 -1 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\nYES\nNO\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, we cannot perform any operations, and the sum of elements of $$$a$$$ equals $$$-1 \\neq 0$$$, so the answer is \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, the sum of elements of $$$a$$$ is already $$$0$$$, so the answer is \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth example, we can perform an operation with $$$i = 3$$$, transforming $$$a$$$ as follows: $$$[-1, 1, \\color{red}{-1, -1}, -1, -1] \\rightarrow [-1, 1, \\color{red}{1, 1}, -1, -1]$$$. The sum of the resulting array is $$$0$$$, so the answer is \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2247A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2247/problem/A"}