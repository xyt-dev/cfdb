{"assets":[],"contentKind":"statement","contestId":"570","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Tree Requests"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Roman planted a tree consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. Each vertex contains a lowercase English letter. Vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is the root of the tree, each of the "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" remaining vertices has a "},{"children":[{"kind":"text","text":"parent"}],"kind":"container"},{"kind":"text","text":" in the tree. Vertex is connected with its parent by an edge. The parent of vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is vertex "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":", the parent index is always less than the index of the vertex (i.e., "},{"kind":"math_inline","text":"pi < i"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"depth"}],"kind":"container"},{"kind":"text","text":" of the vertex is the number of nodes on the path from the root to "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" along the edges. In particular, the depth of the root is equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We say that vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" is in the "},{"children":[{"kind":"text","text":"subtree"}],"kind":"container"},{"kind":"text","text":" of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", if we can get from "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", moving from the vertex to the parent. In particular, vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is in its subtree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Roma gives you "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of which consists of two numbers "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":". Let's consider the vertices in the subtree "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" located at depth "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":". Determine whether you can use the letters written at these vertices to make a string that is a "},{"children":[{"kind":"text","text":"palindrome"}],"kind":"container"},{"kind":"text","text":". The letters that are written in the vertexes, can be rearranged in any order to make a palindrome, but all letters should be used."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 500 000"},{"kind":"text","text":") — the number of nodes in the tree and queries, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following line contains "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"p2, p3, ..., pn"},{"kind":"text","text":" — the parents of vertices from the second to the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th ("},{"kind":"math_inline","text":"1 ≤ pi < i"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase English letters, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these letters is written on vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines describe the queries, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two numbers "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ vi, hi ≤ n"},{"kind":"text","text":") — the vertex and the depth that appear in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query you can make a palindrome from the letters written on the vertices, otherwise print \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 5\n1 1 1 3 3\nzacccd\n1 1\n3 3\n4 1\n6 1\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\nNo\nYes\nYes\nYes\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"String "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a "},{"children":[{"kind":"text","text":"palindrome"}],"kind":"container"},{"kind":"text","text":" if reads the same from left to right and from right to left. In particular, an empty string is a palindrome."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Clarification for the sample test."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first query there exists only a vertex 1 satisfying all the conditions, we can form a palindrome \""},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second query vertices 5 and 6 satisfy condititions, they contain letters \""},{"children":[{"kind":"text","text":"с"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":"\" respectively. It is impossible to form a palindrome of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third query there exist no vertices at depth 1 and in subtree of 4. We may form an empty palindrome."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth query there exist no vertices "},{"children":[{"kind":"text","text":"in subtree of 6 at depth 1"}],"kind":"container"},{"kind":"text","text":". We may form an empty palindrome."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth query there vertices 2, 3 and 4 satisfying all conditions above, they contain letters \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\". We may form a palindrome \""},{"children":[{"kind":"text","text":"cac"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"570D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/570/problem/D"}