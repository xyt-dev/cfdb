{"assets":[],"contentKind":"statement","contestId":"1499","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Chaotic Merge"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two strings $$$x$$$ and $$$y$$$, both consist only of lowercase Latin letters. Let $$$|s|$$$ be the length of string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a sequence $$$a$$$ a merging sequence if it consists of exactly $$$|x|$$$ zeros and exactly $$$|y|$$$ ones in some order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A merge $$$z$$$ is produced from a sequence $$$a$$$ by the following rules: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if $$$a_i=0$$$, then remove a letter from the beginning of $$$x$$$ and append it to the end of $$$z$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if $$$a_i=1$$$, then remove a letter from the beginning of $$$y$$$ and append it to the end of $$$z$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Two merging sequences $$$a$$$ and $$$b$$$ are different if there is some position $$$i$$$ such that $$$a_i \\neq b_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a string $$$z$$$ "},{"children":[{"kind":"text","text":"chaotic"}],"kind":"container"},{"kind":"text","text":" if for all $$$i$$$ from $$$2$$$ to $$$|z|$$$ $$$z_{i-1} \\neq z_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$s[l,r]$$$ for some $$$1 \\le l \\le r \\le |s|$$$ be a substring of consecutive letters of $$$s$$$, starting from position $$$l$$$ and ending at position $$$r$$$ inclusive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$f(l_1, r_1, l_2, r_2)$$$ be the number of different merging sequences of $$$x[l_1,r_1]$$$ and $$$y[l_2,r_2]$$$ that produce "},{"children":[{"kind":"text","text":"chaotic"}],"kind":"container"},{"kind":"text","text":" merges. Note that only non-empty substrings of $$$x$$$ and $$$y$$$ are considered."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Calculate $$$\\sum \\limits_{1 \\le l_1 \\le r_1 \\le |x| \\\\ 1 \\le l_2 \\le r_2 \\le |y|} f(l_1, r_1, l_2, r_2)$$$. Output the answer modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a string $$$x$$$ ($$$1 \\le |x| \\le 1000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string $$$y$$$ ($$$1 \\le |y| \\le 1000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Both strings consist only of lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the sum of $$$f(l_1, r_1, l_2, r_2)$$$ over $$$1 \\le l_1 \\le r_1 \\le |x|$$$ and $$$1 \\le l_2 \\le r_2 \\le |y|$$$ modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\naaa\nbb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n24\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\ncode\nforces\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1574\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\naaaaa\naaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\njustamassivetesttocheck\nhowwellyouhandlemodulooperations\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n667387032\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example there are: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$6$$$ pairs of substrings \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\", each with valid merging sequences \""},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$3$$$ pairs of substrings \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"bb"}],"kind":"container"},{"kind":"text","text":"\", each with a valid merging sequence \""},{"children":[{"kind":"text","text":"101"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$4$$$ pairs of substrings \""},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\", each with a valid merging sequence \""},{"children":[{"kind":"text","text":"010"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$2$$$ pairs of substrings \""},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"bb"}],"kind":"container"},{"kind":"text","text":"\", each with valid merging sequences \""},{"children":[{"kind":"text","text":"0101"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1010"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$2$$$ pairs of substrings \""},{"children":[{"kind":"text","text":"aaa"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\", each with no valid merging sequences; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$1$$$ pair of substrings \""},{"children":[{"kind":"text","text":"aaa"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"bb"}],"kind":"container"},{"kind":"text","text":"\" with a valid merging sequence \""},{"children":[{"kind":"text","text":"01010"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Thus, the answer is $$$6 \\cdot 2 + 3 \\cdot 1 + 4 \\cdot 1 + 2 \\cdot 2 + 2 \\cdot 0 + 1 \\cdot 1 = 24$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1499E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1499/problem/E"}