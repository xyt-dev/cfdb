{"assets":[],"contentKind":"statement","contestId":"600","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Make Palindrome"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A string is called palindrome if it reads the same from left to right and from right to left. For example \""},{"children":[{"kind":"text","text":"kazak"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"oo"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"mikhailrubinchikkihcniburliahkim"}],"kind":"container"},{"kind":"text","text":"\" are palindroms, but strings \""},{"children":[{"kind":"text","text":"abb"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"ij"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of lowercase Latin letters. At once you can choose any position in the string and change letter in that position to any other lowercase letter. So after each changing the length of the string doesn't change. At first you can change some letters in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Then you can permute the order of letters as you want. Permutation doesn't count as changes. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You should obtain palindrome with the minimal number of changes. If there are several ways to do that you should get the lexicographically (alphabetically) smallest palindrome. So firstly you should minimize the number of changes and then minimize the palindrome lexicographically."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 2·105"},{"kind":"text","text":") consisting of only lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the lexicographically smallest palindrome that can be obtained with the minimal number of changes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"aabc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"abba\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"aabcd\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"tex