{"assets":["/statement-assets/45abdb5c0174ca50d87f8be39e558fbf296f24510fed1fdbc764c69fee12b97e.png"],"contentKind":"statement","contestId":"507","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. The Maths Lecture"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Amr doesn't like Maths as he finds it really boring, so he usually sleeps in Maths lectures. But one day the teacher suspected that Amr is sleeping and asked him a question to make sure he wasn't."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First he gave Amr two positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Then he asked Amr, how many integer numbers "},{"kind":"math_inline","text":"x > 0"},{"kind":"text","text":" exist such that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Decimal representation of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" (without leading zeroes) consists of exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" digits; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There exists some integer "},{"kind":"math_inline","text":"y > 0"},{"kind":"text","text":" such that: "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/45abdb5c0174ca50d87f8be39e558fbf296f24510fed1fdbc764c69fee12b97e.png"},"kind":"image"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" decimal representation of "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is a "},{"children":[{"kind":"text","text":"suffix"}],"kind":"container"},{"kind":"text","text":" of decimal representation of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"As the answer to this question may be pretty huge the teacher asked Amr to output only its remainder modulo a number "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Can you help Amr escape this embarrassing situation?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Input consists of three integers "},{"kind":"math_inline","text":"n, k, m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the required number modulo "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2 1000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 1000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"45"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3 1103\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"590"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A suffix of a string "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" is a non-empty string that can be obtained by removing some number (possibly, zero) of first characters from "},{"kind":"math_inline","text":"S"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"507D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/507/problem/D"}