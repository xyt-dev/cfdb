{"assets":[],"contentKind":"statement","contestId":"811","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Vladik and Complicated Book"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vladik had started reading a complicated book about algorithms containing "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pages. To improve understanding of what is written, his friends advised him to read pages in some order given by permutation "},{"kind":"math_inline","text":"P = [p1, p2, ..., pn]"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" denotes the number of page that should be read "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th in turn."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sometimes Vladik’s mom sorted some subsegment of permutation "},{"kind":"math_inline","text":"P"},{"kind":"text","text":" from position "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to position "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" inclusive, because she loves the order. For every of such sorting Vladik knows number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" — what index of page in permutation he should read. He is wondered if the page, which he will read after sorting, has changed. In other words, has "},{"kind":"math_inline","text":"px"},{"kind":"text","text":" changed? After every sorting Vladik return permutation to initial state, so you can assume that each sorting is independent from each other."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 104"},{"kind":"text","text":") — length of permutation and number of times Vladik's mom sorted some subsegment of the book."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":") — permutation "},{"kind":"math_inline","text":"P"},{"kind":"text","text":". Note that elements in permutation are distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains three space-separated integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ xi ≤ ri ≤ n"},{"kind":"text","text":") — left and right borders of sorted subsegment in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th sorting and position that is interesting to Vladik."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each mom’s sorting on it’s own line print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\", if page which is interesting to Vladik hasn't changed, or \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n5 4 3 2 1\n1 5 3\n1 3 1\n2 4 3\n4 4 4\n2 5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\nNo\nYes\nYes\nNo\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 5\n1 4 3 2 5 6\n2 4 3\n1 6 2\n4 5 4\n1 3 3\n2 6 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\nNo\nYes\nNo\nYes\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Explanation of first test case: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"[1, 2, 3, 4, 5]"},{"kind":"text","text":" — permutation after sorting, "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-rd element hasn’t changed, so answer is \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"[3, 4,