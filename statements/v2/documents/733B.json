{"assets":[],"contentKind":"statement","contestId":"733","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Parade"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Very soon there will be a parade of victory over alien invaders in Berland. Unfortunately, all soldiers died in the war and now the army consists of entirely new recruits, many of whom do not even know from which leg they should begin to march. The civilian population also poorly understands from which leg recruits begin to march, so it is only important how many soldiers march in step."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There will be "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" columns participating in the parade, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th column consists of "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" soldiers, who start to march from left leg, and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" soldiers, who start to march from right leg."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The beauty of the parade is calculated by the following formula: if "},{"kind":"math_inline","text":"L"},{"kind":"text","text":" is the total number of soldiers on the parade who start to march from the left leg, and "},{"kind":"math_inline","text":"R"},{"kind":"text","text":" is the total number of soldiers on the parade who start to march from the right leg, so the beauty will equal "},{"kind":"math_inline","text":"|L - R|"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"No more than once"}],"kind":"container"},{"kind":"text","text":" you can choose one column and tell "},{"children":[{"kind":"text","text":"all the soldiers"}],"kind":"container"},{"kind":"text","text":" in this column to switch starting leg, i.e. everyone in this columns who starts the march from left leg will now start it from right leg, and vice versa. Formally, you can pick no more than one index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and swap values "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the index of the column, such that switching the starting leg for soldiers in it will maximize the the beauty of the parade, or determine, that no such operation can increase the current beauty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of columns. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the pairs of integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li, ri ≤ 500"},{"kind":"text","text":") — the number of soldiers in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th column which start to march from the left or the right leg respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of the column in which soldiers need to change the leg from which they start to march, or "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" if the maximum beauty is already reached."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider that columns are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in the order they are given in the input data."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n5 6\n8 9\n10 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n6 5\n5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n5 9\n1 3\n4 8\n4 5\n23 54\n12 32\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example if you don't give the order to change the leg, the number of soldiers, who start to march from the left leg, would equal "},{"kind":"math_inline","text":"5 + 8 + 10 = 23"},{"kind":"text","text":", and from the right leg — "},{"kind":"math_inline","text":"6 + 9 + 3 = 18"},{"kind":"text","text":". In this case the beauty of the parade will equal "},{"kind":"math_inline","text":"|23 - 18| = 5"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If you give the order to change the leg to the third column, so the number of soldiers, who march from the left leg, will equal "},{"kind":"math_inline","text":"5 + 8 + 3 = 16"},{"kind":"text","text":", and who march from the right leg — "},{"kind":"math_inline","text":"6 + 9 + 10 = 25"},{"kind":"text","text":". In this case the beauty equals "},{"kind":"math_inline","text":"|16 - 25| = 9"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is impossible to reach greater beauty by giving another orders. Thus, the maximum beauty that can be achieved is 9."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"733B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/733/problem/B"}