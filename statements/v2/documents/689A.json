{"assets":["/statement-assets/f9871d3143beff9164fad33415601389b25e6b6275ed409b81a3622f3df46c80.png","/statement-assets/7dafb5e40a30a2957ec94d91ff8d218a89a7a83d110a16c68cee2ddf8766fc18.png","/statement-assets/b3c27e706e9aa7a6e611ff70cdceff6556a4eec1dfc87354877544dd4eec5edd.png"],"contentKind":"statement","contestId":"689","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Mike and Cellphone"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"While swimming at the beach, Mike has accidentally dropped his cellphone into the water. There was no worry as he bought a cheap replacement phone with an old-fashioned keyboard. The keyboard has only ten digital equal-sized keys, located in the following way:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f9871d3143beff9164fad33415601389b25e6b6275ed409b81a3622f3df46c80.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Together with his old phone, he lost all his contacts and now he can only remember the way his fingers moved when he put some number in. One can formally consider "},{"children":[{"kind":"text","text":"finger movements"}],"kind":"container"},{"kind":"text","text":" as a sequence of vectors connecting centers of keys pressed consecutively to put in a number. For example, the finger movements for number \"586\" are the same as finger movements for number \"253\":"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/7dafb5e40a30a2957ec94d91ff8d218a89a7a83d110a16c68cee2ddf8766fc18.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b3c27e706e9aa7a6e611ff70cdceff6556a4eec1dfc87354877544dd4eec5edd.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Mike has already put in a number by his \"finger memory\" and started calling it, so he is now worrying, can he be sure that he is calling the correct number? In other words, is there any other number, that has the same finger movements?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains the only integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 9"},{"kind":"text","text":") — the number of digits in the phone number that Mike put in."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" digits (characters from '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"9"}],"kind":"container"},{"kind":"text","text":"') representing the number that Mike put in."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no other phone number with the same finger movements and Mike can be sure he is calling the correct number, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in the only line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in the first line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n586\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n09\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n123456789\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n911\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"You can find the picture clarifying the first sample case in the statement above."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"689A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/689/problem/A"}