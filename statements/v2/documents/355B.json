{"assets":[],"contentKind":"statement","contestId":"355","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Vasya and Public Transport"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya often uses public transport. The transport in the city is of two types: trolleys and buses. The city has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" buses and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" trolleys, the buses are numbered by integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", the trolleys are numbered by integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Public transport is not free. There are 4 types of tickets: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" A ticket for one ride on some bus or trolley. It costs "},{"kind":"math_inline","text":"c1"},{"kind":"text","text":" burles; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A ticket for an unlimited number of rides on some bus or on some trolley. It costs "},{"kind":"math_inline","text":"c2"},{"kind":"text","text":" burles; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A ticket for an unlimited number of rides on all buses or all trolleys. It costs "},{"kind":"math_inline","text":"c3"},{"kind":"text","text":" burles; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A ticket for an unlimited number of rides on all buses and trolleys. It costs "},{"kind":"math_inline","text":"c4"},{"kind":"text","text":" burles. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Vasya knows for sure the number of rides he is going to make and the transport he is going to use. He asked you for help to find the minimum sum of burles he will have to spend on the tickets."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four integers "},{"kind":"math_inline","text":"c1, c2, c3, c4"},{"kind":"math_inline","text":"(1 ≤ c1, c2, c3, c4 ≤ 1000)"},{"kind":"text","text":" — the costs of the tickets."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 1000)"},{"kind":"text","text":" — the number of buses and trolleys Vasya is going to use."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"(0 ≤ ai ≤ 1000)"},{"kind":"text","text":" — the number of times Vasya is going to use the bus number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fourth line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"bi"},{"kind":"math_inline","text":"(0 ≤ bi ≤ 1000)"},{"kind":"text","text":" — the number of times Vasya is going to use the trolley number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the minimum sum of burles Vasya will have to spend on the tickets."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 3 7 19\n2 3\n2 5\n4 4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 2 1\n1 3\n798\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"100 100 8 100\n3 5\n7 94 12\n100 1 47 0 42\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"16\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the profitable strategy is to buy two tickets of the first type (for the first bus), one ticket of the second type (for the second bus) and one ticket of the third type (for all trolleys). It totals to "},{"kind":"math_inline","text":"(2·1) + 3 + 7 = 12"},{"kind":"text","text":" burles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the profitable strategy is to buy one ticket of the fourth type."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample the profitable strategy is to buy two tickets of the third type: for all buses and for all trolleys."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"355B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/355/problem/B"}