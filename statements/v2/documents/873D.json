{"assets":["/statement-assets/ee477b6cff9efc18332a5b329c6a4314a1d4e3a02803b9c88b3403f240f22dd2.png"],"contentKind":"statement","contestId":"873","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Merge Sort"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Merge sort is a well-known sorting algorithm. The main function that sorts the elements of array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" with indices from "},{"kind":"math_inline","text":"[l, r)"},{"kind":"text","text":" can be implemented as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" If the segment "},{"kind":"math_inline","text":"[l, r)"},{"kind":"text","text":" is already sorted in non-descending order (that is, for any "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"l ≤ i < r - 1"},{"kind":"math_inline","text":"a[i] ≤ a[i + 1]"},{"kind":"text","text":"), then end the function call; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Let "},{"attrs":{"alt":"","src":"/statement-assets/ee477b6cff9efc18332a5b329c6a4314a1d4e3a02803b9c88b3403f240f22dd2.png"},"kind":"image"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Call "},{"kind":"math_inline","text":"mergesort(a, l, mid)"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Call "},{"kind":"math_inline","text":"mergesort(a, mid, r)"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Merge segments "},{"kind":"math_inline","text":"[l, mid)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"[mid, r)"},{"kind":"text","text":", making the segment "},{"kind":"math_inline","text":"[l, r)"},{"kind":"text","text":" sorted in non-descending order. The merge algorithm doesn't call any other functions. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The array in this problem is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"-indexed, so to sort the whole array, you need to call "},{"kind":"math_inline","text":"mergesort(a, 0, n)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The number of calls of function "},{"kind":"math_inline","text":"mergesort"},{"kind":"text","text":" is very important, so Ivan has decided to calculate it while sorting the array. For example, if "},{"kind":"math_inline","text":"a = {1, 2, 3, 4}"},{"kind":"text","text":", then there will be "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" call of "},{"kind":"math_inline","text":"mergesort"},{"kind":"text","text":" — "},{"kind":"math_inline","text":"mergesort(0, 4)"},{"kind":"text","text":", which will check that the array is sorted and then end. If "},{"kind":"math_inline","text":"a = {2, 1, 3}"},{"kind":"text","text":", then the number of calls is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":": first of all, you call "},{"kind":"math_inline","text":"mergesort(0, 3)"},{"kind":"text","text":", which then sets "},{"kind":"math_inline","text":"mid = 1"},{"kind":"text","text":" and calls "},{"kind":"math_inline","text":"mergesort(0, 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"mergesort(1, 3)"},{"kind":"text","text":", which do not perform any recursive calls because segments "},{"kind":"math_inline","text":"(0, 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":" are sorted."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ivan has implemented the program that counts the number of "},{"kind":"math_inline","text":"mergesort"},{"kind":"text","text":" calls, but now he needs to test it. To do this, he needs to find an array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is a permutation of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" (that is, the number of elements in "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", and every integer number from "},{"kind":"math_inline","text":"[1, n]"},{"kind":"text","text":" can be found in this array), and the number of "},{"kind":"math_inline","text":"mergesort"},{"kind":"text","text":" calls when sorting the array is exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Ivan to find an array he wants!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 200000"},{"kind":"text","text":") — the size of a desired permutation and the number of "},{"kind":"math_inline","text":"mergesort"},{"kind":"text","text":" calls required to sort it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If a permutation of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" such that there will be exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" calls of "},{"kind":"math_inline","text":"mergesort"},{"kind":"text","text":" while sorting it doesn't exist, output "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":". Otherwise output "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"a[0], a[1], ..., a[n - 1]"},{"kind":"text","text":" — the elements of a permutation that would meet the required conditions. If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1 3 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 3 4 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"873D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/873/problem/D"}