{"assets":["/statement-assets/410a97e77d302fd3aa8a59dfdcf2c7957631c16c3e29540d8857b6f4113577ab.png"],"contentKind":"statement","contestId":"771","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Bear and Rectangle Strips"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Limak has a grid that consists of "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" columns. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th cell in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row contains an integer "},{"kind":"math_inline","text":"ti, j"},{"kind":"text","text":" which can be positive, negative or zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A non-empty rectangle of cells is called "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":" if and only if the sum of numbers in its cells is equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak wants to choose some nice rectangles and give them to his friends, as gifts. No two chosen rectangles should share a cell. What is the maximum possible number of nice rectangles Limak can choose?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 300 000"},{"kind":"text","text":") — the number of columns in the grid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next two lines contain numbers in the grid. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of those two lines contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ti, 1, ti, 2, ..., ti, n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ ti, j ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer, denoting the maximum possible number of cell-disjoint nice rectangles."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n70 70 70 70 70 -15\n90 -60 -30 30 -30 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 -1 0 0\n0 0 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1000000000 999999999 -1000000000\n999999999 -1000000000 -999999998\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, there are four nice rectangles:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/410a97e77d302fd3aa8a59dfdcf2c7957631c16c3e29540d8857b6f4113577ab.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Limak can't choose all of them because they are not disjoint. He should take three nice rectangles: those denoted as blue frames on the drawings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, it's optimal to choose six nice rectangles, each consisting of one cell with a number "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, the only nice rectangle is the whole grid — the sum of all numbers is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". Clearly, Limak can choose at most one nice rectangle, so the answer is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"771E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/771/problem/E"}