{"assets":[],"contentKind":"statement","contestId":"1092","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Minimal Diameter Forest"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a forest — an undirected graph with $$$n$$$ vertices such that each its connected component is a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The diameter (aka \"longest shortest path\") of a connected undirected graph is the maximum number of edges in the "},{"children":[{"kind":"text","text":"shortest"}],"kind":"container"},{"kind":"text","text":" path between any pair of its vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You task is to add some edges (possibly zero) to the graph so that it becomes a tree and the diameter of the tree is minimal possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple correct answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\le n \\le 1000$$$, $$$0 \\le m \\le n - 1$$$) — the number of vertices of the graph and the number of edges, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$m$$$ lines contains two integers $$$v$$$ and $$$u$$$ ($$$1 \\le v, u \\le n$$$, $$$v \\ne u$$$) — the descriptions of the edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given graph is a forest."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the diameter of the resulting tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$(n - 1) - m$$$ lines should contain two integers $$$v$$$ and $$$u$$$ ($$$1 \\le v, u \\le n$$$, $$$v \\ne u$$$) — the descriptions of the "},{"children":[{"kind":"text","text":"added edges"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The resulting graph should be a tree and its diameter should be minimal possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For $$$m = n - 1$$$ no edges are added, thus the output consists of a single integer — diameter of the given tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple correct answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 2\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n4 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 2\n1 3\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example adding edges (1, 4) or (3, 4) will lead to a total diameter of 3. Adding edge (2, 4), however, will make it 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Edge (1, 2) is the only option you have for the second example. The diameter is 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can't add any edges in the third example. The diameter is already 2."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1092E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1092/problem/E"}