{"assets":[],"contentKind":"statement","contestId":"2052","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Expression Correction"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Eve is studying mathematics in school. They've already learned how to perform addition and subtraction of decimal numbers and are practicing it by solving fun puzzles. The specific type of the puzzle they are solving is described below. They are given an equality with addition and subtraction which may or may not be a correct one. They have to verify the equality, and if it is not a correct one, then they have to tell if it is possible to turn it into a correct one by moving one digit to a different place in the equality."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us formally define the equality in this puzzle: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"Number"}],"kind":"container"},{"kind":"text","text":" is a string of "},{"children":[{"kind":"text","text":"at least one and at most 10 decimal digits"}],"kind":"container"},{"kind":"text","text":" ('"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"9"}],"kind":"container"},{"kind":"text","text":"') that has no extra leading zeroes (the only number that is allowed to start with the zero digit is \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\"). "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Expression"}],"kind":"container"},{"kind":"text","text":" is a string composed of one or more numbers, as defined above, that are separated with addition ('"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"') or subtraction ('"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"') operators. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Equality"}],"kind":"container"},{"kind":"text","text":" is a string composed of an expression, as defined above, followed by an equals sign ('"},{"children":[{"kind":"text","text":"="}],"kind":"container"},{"kind":"text","text":"'), followed by another expression. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Correct equality"}],"kind":"container"},{"kind":"text","text":" is an equality where both expressions on the left and right hand sides of the equals sign evaluate to the same decimal number according to the standard arithmetic. Note that while all the numbers in the expression are positive, the evaluated number can be negative. Also, the evaluated number can be longer than 10 digits. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Moving a digit"}],"kind":"container"},{"kind":"text","text":" in an equality means removing a digit from any position in the string and inserting it into another position so that the resulting string is again an equality. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The puzzle is pretty straightforward once you know how to add and subtract decimal numbers, but it is tenuous. It is easy to get distracted and make a mistake while performing computation. Your task is to write a program that solves the expression correction puzzle to help Eve."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input file consists of a single line — an equality as defined in the problem statement. The total length of the input string does not exceed 100 characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Write a single line to the output. If the input contains a correct equality, output a single word \""},{"children":[{"kind":"text","text":"Correct"}],"kind":"container"},{"kind":"text","text":"\". Otherwise, if the input equality can be turned into a correct one by moving one digit, output the resulting correct equality. If there are multiple possible correct equalities after moving one digit, you may output any one of them. Otherwise, output a single word \""},{"children":[{"kind":"text","text":"Impossible"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2+2=4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nCorrect\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n123456789+9876543210=111111110+11-1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n123456789+987654321=1111111100+11-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10+9=10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nImpossible\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n24=55-13\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n42=55-13\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1000000000-10=9999999999\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nImpossible\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"2052E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2052/problem/E"}