{"assets":[],"contentKind":"statement","contestId":"56","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Bar"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"According to Berland laws it is only allowed to sell alcohol to people "},{"children":[{"kind":"text","text":"not younger than"}],"kind":"container"},{"kind":"text","text":" 18 years. Vasya's job is to monitor the law's enforcement. Tonight he entered a bar and saw "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people sitting there. For every one of them Vasya happened to determine either the age or the drink the person is having. Vasya can check any person, i.e. learn his age and the drink he is having at the same time. What minimal number of people should Vasya check additionally to make sure that there are no clients under 18 having alcohol drinks?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The list of all alcohol drinks in Berland is: "},{"children":[{"kind":"text","text":"ABSINTH"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"BEER"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"BRANDY"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"CHAMPAGNE"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"GIN"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"RUM"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"SAKE"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"TEQUILA"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"VODKA"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"WHISKEY"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"WINE"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") which is the number of the bar's clients. Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each describing one visitor. A line either contains his age (an integer from 0 to 1000) or his drink (a string of capital Latin letters from 1 to 100 in length). It is guaranteed that the input data does not contain spaces and other unnecessary separators."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Only the drinks from the list given above should be considered alcohol."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number which is the number of people Vasya should check to guarantee the law enforcement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n18\nVODKA\nCOKE\n19\n17\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the sample test the second and fifth clients should be checked."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"56A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/56/problem/A"}