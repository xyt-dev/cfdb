{"assets":["/statement-assets/0424bdadf6778cc34d625a27a4af459601ba8b507d45896de922b32c84e597a1.png"],"contentKind":"statement","contestId":"1773","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Dominoes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dora likes to play with dominoes. She takes $$$n \\times m$$$ table, marks some cells as occupied, and then tries to fill all unoccupied cells with $$$2 \\times 1$$$ dominoes."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0424bdadf6778cc34d625a27a4af459601ba8b507d45896de922b32c84e597a1.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Her little brother Dani loves to play pranks on his older sister. So when she is away, he marks two more unoccupied cells as occupied. He wants to do it in such a way that it will be impossible to fill all unoccupied cells with dominoes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Dani to count the number of ways he can select these two cells. Since Dani can only count to one million, if this number of ways is $$$x$$$, output $$$\\min(x, 10^6)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers $$$n$$$ and $$$m$$$ ($$$1\\le n, m\\le 1000$$$). Next $$$n$$$ lines contain $$$m$$$ characters each — the initial state of the table. Character \""},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"\" corresponds to an occupied cell, and character \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" corresponds to an unoccupied cell. It is guaranteed that there are at least two unoccupied cells, and that it is possible to fill all unoccupied cells with dominoes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let $$$x$$$ be the number of ways Dani can mark two cells in such a way that it will be impossible to fill all unoccupied cells with dominoes. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print one integer $$$\\min(x, 10^6)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 6\n...#..\n......\n#...##\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n52\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 2\n..\n..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 2\n#.\n#.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1773D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1773/problem/D"}