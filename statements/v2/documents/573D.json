{"assets":[],"contentKind":"statement","contestId":"573","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Bear and Cavalry"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Would you want to fight against bears riding horses? Me neither."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak is a grizzly bear. He is general of the dreadful army of Bearland. The most important part of an army is cavalry of course."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Cavalry of Bearland consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" warriors and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" horses. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th warrior has strength "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th horse has strength "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":". Warrior together with his horse is called a unit. Strength of a unit is equal to multiplied strengths of warrior and horse. Total strength of cavalry is equal to sum of strengths of all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" units. Good assignment of warriors and horses makes cavalry truly powerful."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th warrior has "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th horse. You are given "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries. In each query two warriors swap their horses with each other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"General Limak must be ready for every possible situation. What if warriors weren't allowed to ride their own horses? After each query find the maximum possible strength of cavalry if we consider assignments of all warriors to all horses that no warrior is assigned to his own horse (it can be proven that for "},{"kind":"math_inline","text":"n ≥ 2"},{"kind":"text","text":" there is always at least one correct assignment)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that we can't leave a warrior without a horse."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 30 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ q ≤ 10 000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers, "},{"kind":"math_inline","text":"w1, w2, ..., wn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ wi ≤ 106"},{"kind":"text","text":") — strengths of warriors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers, "},{"kind":"math_inline","text":"h1, h2, ..., hn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ hi ≤ 106"},{"kind":"text","text":") — strengths of horses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines describe queries. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains two space-separated integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":"), indices of warriors who swap their horses with each other."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines with answers to queries. In "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print the maximum possible strength of cavalry after first "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n1 10 100 1000\n3 7 2 5\n2 4\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5732\n7532\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n7 11 5\n3 2 1\n1 2\n1 3\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"44\n48\n52\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 4\n1 2 4 8 16 32 64\n87 40 77 29 50 11 18\n1 5\n2 7\n6 2\n5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9315\n9308\n9315\n9315\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Clarification for the first sample:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Warriors: 1 10 100 1000"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"Horses:   3  7  2    5 "}],"kind":"container"}],"kind":"paragraph"}],"kind":"container"},{"children":[{"kind":"text","text":"After first query situation looks like the following:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Warriors: 1 10 100 1000"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"Horses:   3  5  2    7 "}],"kind":"container"}],"kind":"paragraph"}],"kind":"container"},{"children":[{"kind":"text","text":"We can get "},{"kind":"math_inline","text":"1·2 + 10·3 + 100·7 + 1000·5 = 5732"},{"kind":"text","text":" (note that no hussar takes his own horse in this assignment)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After second query we get back to initial situation and optimal assignment is "},{"kind":"math_inline","text":"1·2 + 10·3 + 100·5 + 1000·7 = 7532"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Clarification for the second sample. After first query:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Warriors:  7 11 5"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"Horses:    2  3 1"}],"kind":"container"}],"kind":"paragraph"}],"kind":"container"},{"children":[{"kind":"text","text":"Optimal assignment is "},{"kind":"math_inline","text":"7·1 + 11·2 + 5·3 = 44"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then after second query "},{"kind":"math_inline","text":"7·3 + 11·2 + 5·1 = 48"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Finally "},{"kind":"math_inline","text":"7·2 + 11·3 + 5·1 = 52"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"573D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/573/problem/D"}