{"assets":[],"contentKind":"statement","contestId":"773","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Test Data Generation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Test data generation is not an easy task! Often, generating big random test cases is not enough to ensure thorough testing of solutions for correctness."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, consider a problem from an old Codeforces round. Its input format looks roughly as follows:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ maxn"},{"kind":"text","text":") — the size of the set. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ maxa"},{"kind":"text","text":") — the elements of the set "},{"children":[{"kind":"text","text":"in increasing order"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If you don't pay attention to the problem solution, it looks fairly easy to generate a good test case for this problem. Let "},{"kind":"math_inline","text":"n = maxn"},{"kind":"text","text":", take random distinct "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" from 1 to "},{"kind":"math_inline","text":"maxa"},{"kind":"text","text":", sort them... Soon you understand that it's not that easy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here is the actual problem solution. Let "},{"kind":"math_inline","text":"g"},{"kind":"text","text":" be the greatest common divisor of "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". Let "},{"kind":"math_inline","text":"x = an / g - n"},{"kind":"text","text":". Then the correct solution outputs \""},{"children":[{"kind":"text","text":"Alice"}],"kind":"container"},{"kind":"text","text":"\" if "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is odd, and \""},{"children":[{"kind":"text","text":"Bob"}],"kind":"container"},{"kind":"text","text":"\" if "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is even."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider two wrong solutions to this problem which differ from the correct one only in the formula for calculating "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first wrong solution calculates "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"x = an / g"},{"kind":"text","text":" (without subtracting "},{"kind":"math_inline","text":"n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second wrong solution calculates "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"x = an - n"},{"kind":"text","text":" (without dividing by "},{"kind":"math_inline","text":"g"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A test case is interesting if it makes "},{"children":[{"kind":"text","text":"both"}],"kind":"container"},{"kind":"text","text":" wrong solutions output an incorrect answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given "},{"kind":"math_inline","text":"maxn"},{"kind":"text","text":", "},{"kind":"math_inline","text":"maxa"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":", find the number of interesting test cases satisfying the constraints, and output it modulo "},{"kind":"math_inline","text":"q"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains three integers "},{"kind":"math_inline","text":"maxn"},{"kind":"text","text":", "},{"kind":"math_inline","text":"maxa"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ maxn ≤ 30 000"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"maxn ≤ maxa ≤ 109"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"104 ≤ q ≤ 105 + 129"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the number of test cases which satisfy the constraints and make both wrong solutions output an incorrect answer, modulo "},{"kind":"math_inline","text":"q"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6 100000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 21 100129\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"154\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"58 787788 50216\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"46009\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, interesting test cases look as follows: "}],"kind":"paragraph"},{"kind":"code_block","text":"\n1              1              1              3\n2              4              6              2 4 6\n"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"773F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/773/problem/F"}