{"assets":["/statement-assets/12792499e97667aedbec6121e91e9f4aaf59128c7ba745b0215b30c8af0d4c90.gif"],"contentKind":"statement","contestId":"36","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. New Game with a Chess Piece"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"input_channel"},"children":[{"children":[{"kind":"text","text":"input"}],"kind":"container"},{"kind":"text","text":"input.txt"}],"kind":"container"},{"attrs":{"role":"output_channel"},"children":[{"children":[{"kind":"text","text":"output"}],"kind":"container"},{"kind":"text","text":"output.txt"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya and Vasya are inventing a new game that requires a rectangular board and one chess piece. At the beginning of the game the piece stands in the upper-left corner of the board. Two players move the piece in turns. Each turn the chess piece can be moved either one square to the right or one square down or jump "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" squares diagonally down and to the right. The player who can’t move the piece loses. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/12792499e97667aedbec6121e91e9f4aaf59128c7ba745b0215b30c8af0d4c90.gif"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The guys haven’t yet thought what to call the game or the best size of the board for it. Your task is to write a program that can determine the outcome of the game depending on the board size."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains two integers "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 20"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 109"},{"kind":"text","text":"). Each of the following "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines contains two numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the board’s length and width ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines that can determine the outcomes of the game on every board. Write «+» if the first player is a winner, and «-» otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 2\n1 1\n1 2\n2 1\n2 2\n1 3\n2 3\n3 1\n3 2\n3 3\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-\n+\n+\n-\n-\n+\n-\n+\n+\n+\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"36D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/36/problem/D"}