{"assets":[],"contentKind":"statement","contestId":"418","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Tricky Password"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In order to ensure confidentiality, the access to the \"Russian Code Cup\" problems is password protected during the problem development process."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To select a password, the jury can generate a special table that contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" columns and the infinite number of rows. To construct a table, the first row is fixed, and all the others are obtained by the following rule:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the row "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" at position "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" there is a number equal to the number of times "},{"kind":"math_inline","text":"a[i - 1][p]"},{"kind":"text","text":" occurs on the prefix "},{"kind":"math_inline","text":"a[i - 1][1... p]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To ensure the required level of confidentiality, the jury must be able to perform the following operations: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Replace number "},{"kind":"math_inline","text":"a[1][p]"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and rebuild the table. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Find the number "},{"kind":"math_inline","text":"a[x][y]"},{"kind":"text","text":", which will be the new password. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Doing all these steps manually is very tedious, so the jury asks you to help him. Write a program that responds to the request of the jury."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100000"},{"kind":"text","text":") — the number of columns. The second line contains the description of the first row of the table, that is, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, which are not less than "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and do not exceed "},{"kind":"math_inline","text":"109"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line of the input contains an integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 100000"},{"kind":"text","text":") — the number of requests."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next, each row contains a description of the request, which consists of three integers: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If the first number is equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", then the remaining two numbers are "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v ≤ 109"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"1 ≤ p ≤ n"},{"kind":"text","text":"). So, you should put value "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" in the position "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" in the first row. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the first number is equal to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", then the remaining two numbers are "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ 105"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"1 ≤ y ≤ n"},{"kind":"text","text":") — the row and column of the table cell from which you want to get value. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print an answer for each request of the second type in the order you receive them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 2 2 2 3 1\n3\n2 2 3\n1 3 3\n2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"418E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/418/problem/E"}