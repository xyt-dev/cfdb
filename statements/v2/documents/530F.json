{"assets":[],"contentKind":"statement","contestId":"530","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Jumping frogs"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A rectangular swamp is inhabited by 10 species of frogs. Frogs of species "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" can jump from hillocks to hillock exactly "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" units along X-axis or Y-axis. Initially frogs of all types sit at the hillock at coordinates (0, 0). You are given coordinates of all other hillocks in the swamp. Find the largest Manhattan distance from (0, 0) to any hillock to which one of the frogs can travel by jumping between hillocks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Manhattan distance between "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"|x1 - x2| + |y1 - y2|"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ N ≤ 100"},{"kind":"text","text":") - the number of hillocks. The following "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" lines contain the coordinates of the hillocks, formatted as \"X Y\" ("},{"kind":"math_inline","text":" - 20 ≤ X, Y ≤ 20"},{"kind":"text","text":"). All hillocks are distinct, and none of them is located at (0, 0)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the largest Manhattan distance to any hillock reachable by one of the frogs by jumping between hillocks."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n0 1\n0 -2\n0 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 1\n0 2\n0 3\n2 2\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n18 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example frogs of species 1, 2 and 3 can jump as far as the first, the second and the third hillocks, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example frog of species 2 can jump to the second hillock, then to the fourth and finally to the fifth."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example no frog can reach the hillock."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"530F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/530/problem/F"}