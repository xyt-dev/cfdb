{"assets":["/statement-assets/bdd7872c81dbab548865c6116eb29112a9d6c1a6007d7c722ca01adb3f882454.png","/statement-assets/adfb9fc90b5374b9cbe1642fe84ab53c736bd360879f4b182f1b147212c2ee81.png","/statement-assets/42531af2338ca75174cd5b898b487381513154e14035d9d931bf3217716da123.png","/statement-assets/f5ae657318d11c242fdc01d365d5db1561f32344832e9ed2ce3f10cddac78e9d.png","/statement-assets/18839934245aeaf95b7d44625e43033d242ca293ea4ede87a0e3691dcf8e054b.png"],"contentKind":"statement","contestId":"689","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Mike and Geometry Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mike wants to prepare for IMO but he doesn't know geometry, so his teacher gave him an interesting geometry problem. Let's define "},{"kind":"math_inline","text":"f([l, r]) = r - l + 1"},{"kind":"text","text":" to be the number of integer points in the segment "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"l ≤ r"},{"kind":"text","text":" (say that "},{"attrs":{"alt":"","src":"/statement-assets/bdd7872c81dbab548865c6116eb29112a9d6c1a6007d7c722ca01adb3f882454.png"},"kind":"image"},{"kind":"text","text":"). You are given two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" closed intervals "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":" on "},{"kind":"math_inline","text":"OX"},{"kind":"text","text":" axis and you have to find:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/adfb9fc90b5374b9cbe1642fe84ab53c736bd360879f4b182f1b147212c2ee81.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In other words, you should find the sum of the number of integer points in the intersection of any "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" of the segments. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As the answer may be very large, output it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mike can't solve this problem so he needs your help. You will help him, won't you? "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 200 000"},{"kind":"text","text":") — the number of segments and the number of segments in intersection groups respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two integers "},{"kind":"math_inline","text":"li, ri"},{"kind":"math_inline","text":"( - 109 ≤ li ≤ ri ≤ 109)"},{"kind":"text","text":", describing "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th segment bounds."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer number — the answer to Mike's problem modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":") in the only line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 2\n1 3\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 3\n1 3\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n1 2\n2 3\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","te