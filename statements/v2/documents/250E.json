{"assets":["/statement-assets/b422e024020c968a81eee84b328cd596442c865677f1a3baba56e958302809c0.png"],"contentKind":"statement","contestId":"250","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Mad Joe"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Joe has been hurt on the Internet. Now he is storming around the house, destroying everything in his path."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Joe's house has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" floors, each floor is a segment of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" cells. Each cell either contains nothing (it is an empty cell), or has a brick or a concrete wall (always something one of three). It is believed that each floor is surrounded by a concrete wall on the left and on the right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Joe is on the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th floor and in the first cell, counting from left to right. At each moment of time, Joe has the direction of his gaze, to the right or to the left (always one direction of the two). Initially, Joe looks to the right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Joe moves by a particular algorithm. Every second he makes one of the following actions: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If the cell directly under Joe is empty, then Joe falls down. That is, he moves to this cell, the gaze direction is preserved. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Otherwise consider the next cell in the current direction of the gaze. "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the cell is empty, then Joe moves into it, the gaze direction is preserved. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If this cell has bricks, then Joe breaks them with his forehead (the cell becomes empty), and changes the direction of his gaze to the opposite. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If this cell has a concrete wall, then Joe just changes the direction of his gaze to the opposite (concrete can withstand any number of forehead hits). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Joe calms down as soon as he reaches "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" cell of the first floor."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The figure below shows an example Joe's movements around the house."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b422e024020c968a81eee84b328cd596442c865677f1a3baba56e958302809c0.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Determine how many seconds Joe will need to calm down."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 104"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the description of Joe's house. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains the description of the "},{"kind":"math_inline","text":"(n - i + 1)"},{"kind":"text","text":"-th floor of the house — a line that consists of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters: \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" means an empty cell, \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" means bricks and \""},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"\" means a concrete wall."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the first cell of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th floor is empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the number of seconds Joe needs to reach the first floor; or else, print word \""},{"children":[{"kind":"text","text":"Never"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if it can never happen."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n..+.#\n#+..+\n+.#+.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 10\n...+.##+.+\n+#++..+++#\n++.#++++..\n.+##.++#.+\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"42\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n..\n++\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Never"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"250E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/250/problem/E"}