{"assets":[],"contentKind":"statement","contestId":"842","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Ilya And The Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ilya is very fond of graphs, especially trees. During his last trip to the forest Ilya found a very interesting tree rooted at vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". There is an integer number written on each vertex of the tree; the number written on vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ilya believes that the beauty of the vertex "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is the greatest common divisor of all numbers written on the vertices on the path from the root to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", including this vertex itself. In addition, Ilya can change the number in one arbitrary vertex to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" or leave all vertices unchanged. Now for each vertex Ilya wants to know the maximum possible beauty it can have."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"For each vertex the answer must be considered independently."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"The beauty of the root equals to number written on it."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains one integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the number of vertices in tree ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ai ≤ 2·105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains two integer numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x, y ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x ≠ y"},{"kind":"text","text":"), which means that there is an edge "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" in the tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers separated by spaces, where "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number equals to maximum possible beauty of vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examp