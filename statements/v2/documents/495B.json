{"assets":["/statement-assets/9d56065a9d824fe2921f94f21e82adb7937a1b248529a6ba8325c6c35a03b067.png","/statement-assets/be9bb492ae5f7cda7729e7f6328eaaacda273a8949dadddaa888614d181d0ce5.png","/statement-assets/fdcab68c26997ba46d28d84867ffb83dc907c7c0d5b2fd824a21e20c60b97da8.png"],"contentKind":"statement","contestId":"495","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Modular Equations"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Last week, Hamed learned about a new type of equations in his math class called Modular Equations. Lets define "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" as the remainder of division of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" and denote it by "},{"attrs":{"alt":"","src":"/statement-assets/9d56065a9d824fe2921f94f21e82adb7937a1b248529a6ba8325c6c35a03b067.png"},"kind":"image"},{"kind":"text","text":". A Modular Equation, as Hamed's teacher described, is an equation of the form "},{"attrs":{"alt":"","src":"/statement-assets/be9bb492ae5f7cda7729e7f6328eaaacda273a8949dadddaa888614d181d0ce5.png"},"kind":"image"},{"kind":"text","text":" in which "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are two non-negative integers and "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is a variable. We call a positive integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" for which "},{"attrs":{"alt":"","src":"/statement-assets/be9bb492ae5f7cda7729e7f6328eaaacda273a8949dadddaa888614d181d0ce5.png"},"kind":"image"},{"kind":"text","text":" a "},{"children":[{"kind":"text","text":"solution"}],"kind":"container"},{"kind":"text","text":" of our equation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Hamed didn't pay much attention to the class since he was watching a movie. He only managed to understand the definitions of these equations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now he wants to write his math exercises but since he has no idea how to do that, he asked you for help. He has told you all he knows about Modular Equations and asked you to write a program which given two numbers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" determines how many answers the Modular Equation "},{"attrs":{"alt":"","src":"/statement-assets/be9bb492ae5f7cda7729e7f6328eaaacda273a8949dadddaa888614d181d0ce5.png"},"kind":"image"},{"kind":"text","text":" has."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line of the input two space-separated integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ a, b ≤ 109"},{"kind":"text","text":") are given."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is an infinite number of answers to our equation, print \"infinity\" (without the quotes). Otherwise print the number of solutions of the Modular Equation "},{"attrs":{"alt":"","src":"/statement-assets/be9bb492ae5f7cda7729e7f6328eaaacda273a8949dadddaa888614d181d0ce5.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"21 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9435152 272\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"282\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"infinity\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the answers of the Modular Equation are 8 and 16 since "},{"attrs":{"alt":"","src":"/statement-assets/fdcab68c26997ba46d28d84867ffb83dc907c7c0d5b2fd824a21e20c60b97da8.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"495B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/495/problem/B"}