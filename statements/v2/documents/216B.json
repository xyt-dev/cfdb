{"assets":[],"contentKind":"statement","contestId":"216","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Forming Teams"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students come to the stadium. They want to play football, and for that they need to split into teams, the teams must have an equal number of people."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We know that this group of people has archenemies. Each student has at most two archenemies. Besides, if student "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is an archenemy to student "},{"kind":"math_inline","text":"B"},{"kind":"text","text":", then student "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" is an archenemy to student "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The students want to split so as no two archenemies were in one team. If splitting in the required manner is impossible, some students will have to sit on the bench."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the minimum number of students you will have to send to the bench in order to form the two teams in the described manner and begin the game at last."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 100"},{"kind":"text","text":") — the number of students and the number of pairs of archenemies correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines describe enmity between students. Each enmity is described as two numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":") — the indexes of the students who are enemies to each other. Each enmity occurs in the list exactly once. It is guaranteed that each student has no more than two archenemies."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can consider the students indexed in some manner with distinct integers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum number of students you will have to send to the bench in order to start the game."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n1 2\n2 4\n5 3\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2\n1 4\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 6\n1 2\n2 3\n3 1\n4 5\n5 6\n6 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"216B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/216/problem/B"}