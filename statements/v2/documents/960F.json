{"assets":["/statement-assets/1abe0c45652aff2936765eac6843d37172a29b3577da3ba3610051ca1acc6222.png","/statement-assets/e210da9989fe2c3dcde358c07ae05a7fa0a93dace3a728879039207a975cdd08.png","/statement-assets/a1a14bbe080f750738cd5a155f33c4186ceac8f5203cb4d618beb925f59de207.png","/statement-assets/6d5def596ba18f4f32b578a17e0677a5eb48b1f64299971405b34ccc65cba56d.png"],"contentKind":"statement","contestId":"960","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Pathwalks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a directed graph with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges, with all edges having a certain weight. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There might be multiple edges and self loops, and the graph can also be disconnected. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to choose a path (possibly passing through same vertices multiple times) in the graph such that the weights of the edges are in strictly increasing order, and these edges come in the order of input. Among all such paths, you need to find the the path that has the maximum possible number of edges, and report this value."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please note that the edges picked don't have to be consecutive in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100000"},{"kind":"text","text":","},{"kind":"math_inline","text":"1 ≤ m ≤ 100000"},{"kind":"text","text":") — the number of vertices and edges in the graph, respectively. "}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains three space separated integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ wi ≤ 100000"},{"kind":"text","text":"), denoting an edge from vertex "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" having weight "},{"kind":"math_inline","text":"wi"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer in a single line — the maximum number of edges in the path."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n3 1 3\n1 2 1\n2 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n1 3 2\n3 2 3\n3 4 5\n5 4 0\n4 5 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The answer for the first sample input is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":": "},{"attrs":{"alt":"","src":"/statement-assets/1abe0c45652aff2936765eac6843d37172a29b3577da3ba3610051ca1acc6222.png"},"kind":"image"},{"kind":"text","text":". Note that you cannot traverse "},{"attrs":{"alt":"","src":"/statement-assets/e210da9989fe2c3dcde358c07ae05a7fa0a93dace3a728879039207a975cdd08.png"},"kind":"image"},{"kind":"text","text":" because edge "},{"attrs":{"alt":"","src":"/statement-assets/a1a14bbe080f750738cd5a155f33c4186ceac8f5203cb4d618beb925f59de207.png"},"kind":"image"},{"kind":"text","text":" appears earlier in the input than the other two edges and hence cannot be picked/traversed after either of the other two edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, it's optimal to pick "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st, "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-rd and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"-th edges to get the optimal answer: "},{"attrs":{"alt":"","src":"/statement-assets/6d5def596ba18f4f32b578a17e0677a5eb48b1f64299971405b34ccc65cba56d.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"960F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/960/problem/F"}