{"assets":[],"contentKind":"statement","contestId":"1830","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Bully Sort"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"10 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"On a permutation $$$p$$$ of length $$$n$$$, we define a bully swap as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Let $$$i$$$ be the index of the largest element $$$p_i$$$ such that $$$p_i \\neq i$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Let $$$j$$$ be the index of the smallest element $$$p_j$$$ such that $$$i \\lt j$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Swap $$$p_i$$$ and $$$p_j$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"We define $$$f(p)$$$ as the number of bully swaps we need to perform until $$$p$$$ becomes sorted. Note that if $$$p$$$ is the identity permutation, $$$f(p)=0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given $$$n$$$ and a permutation $$$p$$$ of length $$$n$$$. You need to process the following $$$q$$$ updates."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In each update, you are given two integers $$$x$$$ and $$$y$$$. You will swap $$$p_x$$$ and $$$p_y$$$ and then find the value of $$$f(p)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the updates are persistent. Changes made to the permutation $$$p$$$ will apply when processing future updates."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers $$$n$$$ and $$$q$$$ ($$$2 \\le n \\le 5 \\cdot 10^5$$$, $$$1 \\le q \\le 5 \\cdot 10^4$$$) — the length of the permutation and the number of updates."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of input contains $$$n$$$ integer $$$p_1,p_2,\\ldots,p_n$$$ ($$$1 \\leq p_i \\leq n$$$) — the permutation $$$p$$$. All elements of $$$p$$$ are distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the next $$$q$$$ lines of input contains two integers $$$x_i$$$ and $$$y_i$$$ ($$$1 \\le x_i \\lt y_i \\le n$$$) — describing the $$$i$$$-th update."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"After each update, output $$$f(p)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8 5\n6 2 1 5 3 4 7 8\n1 8\n2 3\n4 7\n7 8\n3 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n6\n9\n8\n7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"After the first update, we have $$$f(p)=5$$$. The $$$5$$$ bully swaps are illustrated below."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[\\mathbf{1}, 2, \\mathbf{8}, 5, 3, 4, 7, 6]$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1, 2, \\mathbf{3}, 5, \\mathbf{8}, 4, 7, 6]$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1, 2, 3, 5, \\mathbf{4}, \\mathbf{8}, 7, 6]$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1, 2, 3, 5, 4, \\mathbf{6}, 7, \\mathbf{8}]$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1, 2, 3, \\mathbf{4}, \\mathbf{5}, 6, 7, 8]$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1830E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1830/problem/E"}