{"assets":[],"contentKind":"statement","contestId":"439","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Devu and Birthday Celebration"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Today is Devu's birthday. For celebrating the occasion, he bought "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sweets from the nearby market. He has invited his "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" friends. He would like to distribute the sweets among them. As he is a nice guy and the occasion is great, he doesn't want any friend to be sad, so he would ensure to give at least one sweet to each friend. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He wants to celebrate it in a unique style, so he would like to ensure following condition for the distribution of sweets. Assume that he has distributed "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sweets to his friends such that "},{"kind":"math_inline","text":"ith"},{"kind":"text","text":" friend is given "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" sweets. He wants to make sure that there should not be any positive integer "},{"kind":"math_inline","text":"x > 1"},{"kind":"text","text":", which divides every "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please find the number of ways he can distribute sweets to his friends in the required way. Note that the order of distribution is important, for example [1, 2] and [2, 1] are distinct distributions. As the answer could be very large, output answer modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To make the problem more interesting, you are given "},{"kind":"math_inline","text":"q"},{"children":[{"kind":"text","text":"queries"}],"kind":"container"},{"kind":"text","text":". Each query contains an "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" pair. For each query please output the required number of ways modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" representing the number of queries "},{"kind":"math_inline","text":"(1 ≤ q ≤ 105)"},{"kind":"text","text":". Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains two space space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f"},{"kind":"math_inline","text":"(1 ≤ f ≤ n ≤ 105)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query, output a single integer in a line corresponding to the answer of each query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n6 2\n7 2\n6 3\n6 4\n7 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n6\n9\n10\n20\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For first query: "},{"kind":"math_inline","text":"n = 6, f = 2"},{"kind":"text","text":". Possible partitions are [1, 5] and [5, 1]."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For second query: "},{"kind":"math_inline","text":"n = 7, f = 2"},{"kind":"text","text":". Possible partitions are [1, 6] and [2, 5] and [3, 4] and [4, 3] and [5, 3] and [6, 1]. So in total there are 6 possible ways of partitioning."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"439E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/439/problem/E"}