{"assets":[],"contentKind":"statement","contestId":"1000","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Codehorses T-shirts"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Codehorses has just hosted the second Codehorses Cup. This year, the same as the previous one, organizers are giving T-shirts for the winners."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The valid sizes of T-shirts are either "},{"children":[{"kind":"text","text":"\"M\""}],"kind":"container"},{"kind":"text","text":" or from $$$0$$$ to $$$3$$$ "},{"children":[{"kind":"text","text":"\"X\""}],"kind":"container"},{"kind":"text","text":" followed by "},{"children":[{"kind":"text","text":"\"S\""}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"\"L\""}],"kind":"container"},{"kind":"text","text":". For example, sizes "},{"children":[{"kind":"text","text":"\"M\""}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"\"XXS\""}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"\"L\""}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"\"XXXL\""}],"kind":"container"},{"kind":"text","text":" are valid and "},{"children":[{"kind":"text","text":"\"XM\""}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"\"Z\""}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"\"XXXXL\""}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are $$$n$$$ winners to the cup for both the previous year and the current year. Ksenia has a list with the T-shirt sizes printed for the last year cup and is yet to send the new list to the printing office. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Organizers want to distribute the prizes as soon as possible, so now Ksenia is required not to write the whole list from the scratch but just make some changes to the list of the previous year. In one second she can choose arbitrary position in any word and replace its character with some uppercase Latin letter. Ksenia can't remove or add letters in any of the words."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimal number of seconds Ksenia is required to spend to change the last year list to the current one?"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"The lists are unordered"}],"kind":"container"},{"kind":"text","text":". That means, two lists are considered equal if and only if the number of occurrences of any string is the same in both lists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$1 \\le n \\le 100$$$) — the number of T-shirts."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the next $$$n$$$ lines contains $$$a_i$$$ — the size of the $$$i$$$-th T-shirt of the list for the previous year."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the next $$$n$$$ lines contains $$$b_i$$$ — the size of the $$$i$$$-th T-shirt of the list for the current year."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all the sizes in the input are valid. It is also guaranteed that Ksenia can produce list $$$b$$$ from the list $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimal number of seconds Ksenia is required to spend to change the last year list to the current one. If the lists are already equal, print "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nXS\nXS\nM\nXL\nS\nXS\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\nXXXL\nXXL\nXXL\nXXXS\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\nM\nXS\nXS\nM\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Ksenia can replace "},{"children":[{"kind":"text","text":"\"M\""}],"kind":"container"},{"kind":"text","text":" with "},{"children":[{"kind":"text","text":"\"S\""}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"\"S\""}],"kind":"container"},{"kind":"text","text":" in one of the occurrences of "},{"children":[{"kind":"text","text":"\"XS\""}],"kind":"container"},{"kind":"text","text":" with "},{"children":[{"kind":"text","text":"\"L\""}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example Ksenia should replace "},{"children":[{"kind":"text","text":"\"L\""}],"kind":"container"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"\"XXXL\""}],"kind":"container"},{"kind":"text","text":" with "},{"children":[{"kind":"text","text":"\"S\""}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example lists are equal."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1000A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1000/problem/A"}