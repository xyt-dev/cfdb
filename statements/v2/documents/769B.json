{"assets":[],"contentKind":"statement","contestId":"769","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. News About Credit"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp studies at the university in the group which consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students (including himself). All they are registrated in the social net \"TheContacnt!\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Not all students are equally sociable. About each student you know the value "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" — the maximum number of messages which the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th student is agree to send per day. The student can't send messages to himself. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In early morning Polycarp knew important news that the programming credit will be tomorrow. For this reason it is necessary to urgently inform all groupmates about this news using private messages. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to make a plan of using private messages, so that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the student "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" sends no more than "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" messages (for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" all students knew the news about the credit (initially only Polycarp knew it); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the student can inform the other student only if he knows it himself. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let's consider that all students are numerated by distinct numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", and Polycarp "},{"children":[{"kind":"text","text":"always"}],"kind":"container"},{"kind":"text","text":" has the number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In that task you shouldn't minimize the number of messages, the moment of time, when all knew about credit or some other parameters. Find any way how to use private messages which satisfies requirements above. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100"},{"kind":"text","text":") — the number of students. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 100"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" equals to the maximum number of messages which can the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th student agree to send. Consider that Polycarp "},{"children":[{"kind":"text","text":"always"}],"kind":"container"},{"kind":"text","text":" has the number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" to the first line if it is impossible to inform all students about credit. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, in the first line print the integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of messages which will be sent. In each of the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines print two "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", meaning that the student number "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" sent the message with news to the student number "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". All messages should be printed in chronological order. It means that the student, who is sending the message, must already know this news. It is assumed that students can receive repeated messages with news of the credit. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several answers, it is acceptable to print any of them. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n2 4\n2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n2 0 1 3 2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 3\n3 4\n1 2\n4 5\n5 6\n4 6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n0 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test Polycarp (the student number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":") can send the message to the student number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", who after that can send the message to students number "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". Thus, all students knew about the credit. "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"769B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/769/problem/B"}