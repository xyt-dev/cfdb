{"assets":[],"contentKind":"statement","contestId":"41","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Email address"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sometimes one has to spell email addresses over the phone. Then one usually pronounces a dot as "},{"children":[{"kind":"text","text":"dot"}],"kind":"container"},{"kind":"text","text":", an at sign as "},{"children":[{"kind":"text","text":"at"}],"kind":"container"},{"kind":"text","text":". As a result, we get something like "},{"children":[{"kind":"text","text":"vasyaatgmaildotcom"}],"kind":"container"},{"kind":"text","text":". Your task is to transform it into a proper email address ("},{"attrs":{"href":"https://codeforces.com/cdn-cgi/l/email-protection"},"children":[{"kind":"text","text":"[email protected]"}],"kind":"link"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is known that a proper email address contains only such symbols as "},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"children":[{"kind":"text","text":"@"}],"kind":"container"},{"kind":"text","text":" and lower-case Latin letters, doesn't start with and doesn't end with a dot. Also, a proper email address doesn't start with and doesn't end with an at sign. Moreover, an email address contains exactly one such symbol as "},{"children":[{"kind":"text","text":"@"}],"kind":"container"},{"kind":"text","text":", yet may contain any number (possible, zero) of dots. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to carry out a series of replacements so that the length of the result was as short as possible and it was a proper email address. If the lengths are equal, you should print the lexicographically minimal result. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Overall, two variants of replacement are possible: "},{"children":[{"kind":"text","text":"dot"}],"kind":"container"},{"kind":"text","text":" can be replaced by a dot, "},{"children":[{"kind":"text","text":"at"}],"kind":"container"},{"kind":"text","text":" can be replaced by an at. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the email address description. It is guaranteed that that is a proper email address with all the dots replaced by "},{"children":[{"kind":"text","text":"dot"}],"kind":"container"},{"kind":"text","text":" an the at signs replaced by "},{"children":[{"kind":"text","text":"at"}],"kind":"container"},{"kind":"text","text":". The line is not empty and its length does not exceed 100 symbols."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the shortest email address, from which the given line could be made by the described above replacements. If there are several solutions to that problem, print the lexicographically minimal one (the lexicographical comparison of the lines are implemented with an operator < in modern programming languages)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the ASCII table the symbols go in this order: "},{"children":[{"kind":"text","text":". @ ab"}],"kind":"container"},{"kind":"text","text":"..."},{"children":[{"kind":"text","text":"z"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"vasyaatgmaildotcom\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"[email protected]\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"dotdotdotatdotdotat\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"[email protected]\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"aatt\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"a@t\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"41C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/41/problem/C"}