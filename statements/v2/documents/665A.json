{"assets":[],"contentKind":"statement","contestId":"665","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Buses Between Cities"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Buses run between the cities "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":", the first one is at 05:00 AM and the last one departs not later than at 11:59 PM. A bus from the city "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" departs every "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" minutes and arrives to the city "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" in a "},{"kind":"math_inline","text":"ta"},{"kind":"text","text":" minutes, and a bus from the city "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" departs every "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" minutes and arrives to the city "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" in a "},{"kind":"math_inline","text":"tb"},{"kind":"text","text":" minutes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The driver Simion wants to make his job diverse, so he counts the buses going towards him. Simion doesn't count the buses he meet at the start and finish."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You know the time when Simion departed from the city "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" to the city "},{"kind":"math_inline","text":"B"},{"kind":"text","text":". Calculate the number of buses Simion will meet to be sure in his counting."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"a, ta"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, ta ≤ 120"},{"kind":"text","text":") — the frequency of the buses from the city "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" to the city "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" and the travel time. Both values are given in minutes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains two integers "},{"kind":"math_inline","text":"b, tb"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ b, tb ≤ 120"},{"kind":"text","text":") — the frequency of the buses from the city "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" to the city "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and the travel time. Both values are given in minutes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line contains the departure time of Simion from the city "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" in the format "},{"children":[{"kind":"text","text":"hh:mm"}],"kind":"container"},{"kind":"text","text":". It is guaranteed that there are a bus from the city "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" at that time. Note that the hours and the minutes are given with exactly two digits."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" — the number of buses Simion will meet on the way. Note that you should not count the encounters in cities "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 30\n10 35\n05:20\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"60 120\n24 100\n13:00\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Simion departs form the city "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" at 05:20 AM and arrives to the city "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" at 05:50 AM. He will meet the first "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" buses from the city "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" that departed in the period [05:00 AM - 05:40 AM]. Also Simion will meet a bus in the city "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" at 05:50 AM, but he will not count it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also note that the first encounter will be between 05:26 AM and 05:27 AM (if we suggest that the buses are go with the sustained speed)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"665A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/665/problem/A"}