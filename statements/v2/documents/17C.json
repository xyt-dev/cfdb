{"assets":[],"contentKind":"statement","contestId":"17","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Balance"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"128 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Nick likes strings very much, he likes to rotate them, sort them, rearrange characters within a string... Once he wrote a random string of characters "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":" on a piece of paper and began to perform the following operations: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" to take two adjacent characters and replace the second character with the first one, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" to take two adjacent characters and replace the first character with the second one "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"To understand these actions better, let's take a look at a string «"},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"». All of the following strings can be obtained by performing one of the described operations on «"},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"»: «"},{"children":[{"kind":"text","text":"bbc"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"abb"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"acc"}],"kind":"container"},{"kind":"text","text":"». Let's denote the "},{"children":[{"kind":"text","text":"frequency of a character"}],"kind":"container"},{"kind":"text","text":" for each of the characters "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":" as the number of occurrences of this character in the string. For example, for string «"},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"»: |"},{"kind":"math_inline","text":"a"},{"kind":"text","text":"| = 1, |"},{"kind":"math_inline","text":"b"},{"kind":"text","text":"| = 1, |"},{"kind":"math_inline","text":"c"},{"kind":"text","text":"| = 1, and for string «"},{"children":[{"kind":"text","text":"bbc"}],"kind":"container"},{"kind":"text","text":"»: |"},{"kind":"math_inline","text":"a"},{"kind":"text","text":"| = 0, |"},{"kind":"math_inline","text":"b"},{"kind":"text","text":"| = 2, |"},{"kind":"math_inline","text":"c"},{"kind":"text","text":"| = 1. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"While performing the described operations, Nick sometimes got "},{"children":[{"kind":"text","text":"balanced strings"}],"kind":"container"},{"kind":"text","text":". Let's say that a string is balanced, if the frequencies of each character differ by at most 1. That is "},{"kind":"math_inline","text":" - 1 ≤ |a| - |b| ≤ 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":" - 1 ≤ |a| - |c| ≤ 1"},{"kind":"text","text":" и "},{"kind":"math_inline","text":" - 1 ≤ |b| - |c| ≤ 1"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Would you help Nick find the number of different balanced strings that can be obtained by performing the operations described above, perhaps multiple times, on the given string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". This number should be calculated modulo "},{"kind":"math_inline","text":"51123987"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 150"},{"kind":"text","text":") — the length of the given string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Next line contains the given string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". The initial string can be balanced as well, in this case it should be counted too. The given string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consists only of characters "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the only number — the number of different balanced strings that can be obtained by performing the described operations, perhaps multiple times, on the given string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", modulo "},{"kind":"math_inline","text":"51123987"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nabca\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nabbc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\nab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample it is possible to get "},{"kind":"math_inline","text":"51"},{"kind":"text","text":" different strings through the described operations, but only "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" of them are balanced: «"},{"children":[{"kind":"text","text":"abca"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"bbca"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"bcca"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"bcaa"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"abcc"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"abbc"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"aabc"}],"kind":"container"},{"kind":"text","text":"». In the second sample: «"},{"children":[{"kind":"text","text":"abbc"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"aabc"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"abcc"}],"kind":"container"},{"kind":"text","text":"». In the third sample there is only one balanced string — «"},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"» itself."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"17C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/17/problem/C"}