{"assets":["/statement-assets/47dead2e8b211a81a711c5766b958718d1f7270d4767189bb71d2949f48f61f9.png"],"contentKind":"statement","contestId":"303","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Random Ranking"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Imagine a real contest or exam of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" participants. Every participant will get a particular score. We can predict the standings board more or less, if we do some statistics on their previous performance."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/47dead2e8b211a81a711c5766b958718d1f7270d4767189bb71d2949f48f61f9.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Let's say the score of the participants will be uniformly distributed in interval "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":" (the score can be a real number). Can you predict the standings board according to these data? In other words you should say for each participant the probability that he gets some fixed place in the scoreboard. "},{"children":[{"kind":"text","text":"The participants are sorted by increasing of their scores in the scoreboard. So, the participant with the largest score gets the last place."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤ n  ≤ 80"},{"kind":"text","text":"), showing how many participants we have. Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains our predictions, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains a pair of integers "},{"kind":"math_inline","text":"li, ri"},{"kind":"math_inline","text":"(0 ≤ li < ri ≤ 109)"},{"kind":"text","text":" as the distributed interval for participant "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the participants numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in some way."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a distributed matrix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of order "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The element "},{"kind":"math_inline","text":"aij"},{"kind":"text","text":" of the matrix is the probability that participant "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has rank "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your answer will considered correct if it has at most "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":" absolute or relative error."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 6\n4 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.9200000000 0.080 \n0.080 0.9200000000 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n0 2\n1 3\n2 4\n3 5\n4 6\n5 7\n6 8\n7 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.875 0.125 0 0 0 0 0 0 \n0.125 0.750 0.125 0 0 0 0 0 \n0 0.125 0.750 0.125 0 0 0 0 \n0 0 0.125 0.750 0.125 0 0 0 \n0 0 0 0.125 0.750 0.125 0 0 \n0 0 0 0 0.125 0.750 0.125 0 \n0 0 0 0 0 0.125 0.750 0.125 \n0 0 0 0 0 0 0.125 0.875 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The score probability distribution is continuous, which means, there is no possibility for a draw."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"303E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/303/problem/E"}