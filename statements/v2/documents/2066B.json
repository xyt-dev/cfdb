{"assets":[],"contentKind":"statement","contestId":"2066","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. White Magic"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"We call a sequence $$$a_1, a_2, \\ldots, a_n$$$ "},{"children":[{"kind":"text","text":"magical"}],"kind":"container"},{"kind":"text","text":" if for all $$$1 \\leq i \\leq n-1$$$ it holds that: $$$\\operatorname{min}(a_1, \\ldots, a_i) \\geq \\operatorname{mex}(a_{i+1}, \\ldots, a_n)$$$. In particular, any sequence of length $$$1$$$ is considered "},{"children":[{"kind":"text","text":"magical"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The minimum excluded (MEX) of a collection of integers $$$a_1, a_2, \\ldots, a_k$$$ is defined as the smallest non-negative integer $$$t$$$ which does not occur in the collection $$$a$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a sequence $$$a$$$ of $$$n$$$ non-negative integers. Find the maximum possible length of a "},{"children":[{"kind":"text","text":"magical"}],"kind":"container"},{"kind":"text","text":" subsequence$$$^{\\text{∗}}$$$ of the sequence $$$a$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$A sequence $$$a$$$ is a subsequence of a sequence $$$b$$$ if $$$a$$$ can be obtained from $$$b$$$ by the deletion of several (possibly, zero or all) element from arbitrary positions. "}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains an integer $$$n$$$ ($$$1 \\leq n \\leq 2 \\cdot 10^5$$$) — the length of the sequence $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$0 \\leq a_i \\leq 10^9$$$) — the elements of the sequence $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ across all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single number — the maximum possible length of a "},{"children":[{"kind":"text","text":"magical"}],"kind":"container"},{"kind":"text","text":" subsequence of the sequence $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n5\n4 3 2 1 0\n6\n4 3 3 2 1 0\n4\n2 0 1 2\n1\n777\n4\n1000000000 1 7 9\n2\n0 1\n2\n1 2\n4\n0 1 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n5\n3\n1\n4\n2\n2\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the sequence $$$[4, 3, 2, 1, 0]$$$ is "},{"children":[{"kind":"text","text":"magical"}],"kind":"container"},{"kind":"text","text":", since:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$\\operatorname{min}(4) = 4, \\operatorname{mex}(3, 2, 1, 0) = 4$$$. $$$4 \\geq 4$$$"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\operatorname{min}(4, 3) = 3, \\operatorname{mex}(2, 1, 0) = 3$$$. $$$3 \\geq 3$$$"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\operatorname{min}(4, 3, 2) = 2, \\operatorname{mex}(1, 0) = 2$$$. $$$2 \\geq 2$$$"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\operatorname{min}(4, 3, 2, 1) = 1, \\operatorname{mex}(0) = 1$$$. $$$1 \\geq 1$$$"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second test case, the sequence $$$[4, 3, 3, 2, 1, 0]$$$ is not "},{"children":[{"kind":"text","text":"magical"}],"kind":"container"},{"kind":"text","text":", since $$$\\operatorname{min}(4, 3) = 3, \\operatorname{mex}(3, 2, 1, 0) = 4$$$, $$$3 \\lt 4$$$. However, the subsequence $$$[4, 3, 2, 1, 0]$$$ of this sequence is "},{"children":[{"kind":"text","text":"magical"}],"kind":"container"},{"kind":"text","text":", so the answer is $$$5$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"2066B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2066/problem/B"}