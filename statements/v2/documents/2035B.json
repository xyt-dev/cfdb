{"assets":[],"contentKind":"statement","contestId":"2035","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Everyone Loves Tres"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"children":[{"kind":"text","text":"There are 3 heroes and 3 villains, so 6 people in total."}],"kind":"container"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Given a positive integer $$$n$$$. Find the "},{"children":[{"kind":"text","text":"smallest"}],"kind":"container"},{"kind":"text","text":" integer whose decimal representation has length $$$n$$$ and consists only of $$$3$$$s and $$$6$$$s such that it is divisible by both $$$33$$$ and $$$66$$$. If no such integer exists, print $$$-1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1\\le t\\le 500$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a single integer $$$n$$$ ($$$1\\le n\\le 500$$$) — the length of the decimal representation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the smallest required integer if such an integer exists and $$$-1$$$ otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1\n2\n3\n4\n5\n7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n66\n-1\n3366\n36366\n3336366\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For $$$n=1$$$, no such integer exists as neither $$$3$$$ nor $$$6$$$ is divisible by $$$33$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For $$$n=2$$$, $$$66$$$ consists only of $$$6$$$s and it is divisible by both $$$33$$$ and $$$66$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For $$$n=3$$$, no such integer exists. Only $$$363$$$ is divisible by $$$33$$$, but it is not divisible by $$$66$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For $$$n=4$$$, $$$3366$$$ and $$$6666$$$ are divisible by both $$$33$$$ and $$$66$$$, and $$$3366$$$ is the smallest."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"2035B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2035/problem/B"}