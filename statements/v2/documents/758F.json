{"assets":["/statement-assets/40ff488a7406e711d946f0732e221a463f0930c4ef24926c224357ae9562d33f.png"],"contentKind":"statement","contestId":"758","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Geometrical Progression"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"For given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" find the number of distinct geometrical progression, each of which contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers not less than "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and not greater than "},{"kind":"math_inline","text":"r"},{"kind":"text","text":". In other words, for each progression the following must hold: "},{"kind":"math_inline","text":"l ≤ ai ≤ r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ai ≠ aj"},{"kind":"text","text":" , where "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" is the geometrical progression, "},{"kind":"math_inline","text":"1 ≤ i, j ≤ n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"i ≠ j"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Geometrical progression is a sequence of numbers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" where each term after first is found by multiplyin