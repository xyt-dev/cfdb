{"assets":[],"contentKind":"statement","contestId":"161","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Polycarpus the Safecracker"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarpus has "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" safes. The password for each safe is a square matrix consisting of decimal digits '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' ... '"},{"children":[{"kind":"text","text":"9"}],"kind":"container"},{"kind":"text","text":"' (the sizes of passwords to the safes may vary). Alas, Polycarpus has forgotten all passwords, so now he has to restore them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus enjoys prime numbers, so when he chose the matrix passwords, he wrote a prime number in each row of each matrix. To his surprise, he found that all the matrices turned out to be symmetrical (that is, they remain the same after transposition). Now, years later, Polycarp was irritated to find out that he remembers only the prime numbers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":", written in the first lines of the password matrices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each safe find the number of matrices which can be passwords to it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The number of digits in "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" determines the number of rows and columns of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th matrix. One prime number can occur in several rows of the password matrix or in several matrices. The prime numbers that are written not in the first row of the matrix may have leading zeros."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 30"},{"kind":"text","text":") — the number of safes. Next "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines contain integers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"10 ≤ pi ≤ 99999"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" is a prime number written in the first row of the password matrix for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th safe. All "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":"'s are written without leading zeros."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" numbers, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should be the number of matrices that can be a password to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th safe. Print the numbers on separate lines."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n11\n239\n401\n9001\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n28\n61\n2834\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here is a possible password matrix for the second safe: "}],"kind":"paragraph"},{"kind":"code_block","text":"\n239\n307\n977\n"},{"children":[{"kind":"text","text":"Here is a possible password matrix for the fourth safe: "}],"kind":"paragraph"},{"kind":"code_block","text":"\n9001\n0002\n0002\n1223 \n"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"161E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/161/problem/E"}