{"assets":["/statement-assets/e3e2a853129241a28db74a967e8174d9d02285557f383e4ce8a8519a8ca74a77.png"],"contentKind":"statement","contestId":"630","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"P. Area of a Star"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"0.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"It was decided in IT City to distinguish successes of local IT companies by awards in the form of stars covered with gold from one side. To order the stars it is necessary to estimate order cost that depends on the area of gold-plating. Write a program that can calculate the area of a star."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A \"star\" figure having "},{"kind":"math_inline","text":"n ≥ 5"},{"kind":"text","text":" corners where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is a prime number is constructed the following way. On the circle of radius "},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"n"},{"kind":"text","text":" points are selected so that the distances between the adjacent ones are equal. Then every point is connected by a segment with two maximally distant points. All areas bounded by the segments parts are the figure parts."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e3e2a853129241a28db74a967e8174d9d02285557f383e4ce8a8519a8ca74a77.png"},"kind":"image"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"5 ≤ n < 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is prime) and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ r ≤ 109"},{"kind":"text","text":") — the number of the star corners and the radius of the circumcircle correspondingly."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one number — the star area. The relative error of your answer should not be greater than "},{"kind":"math_inline","text":"10 - 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"108.395919545675"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"P","problemCode":"630P","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/630/problem/P"}