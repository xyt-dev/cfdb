{"assets":[],"contentKind":"statement","contestId":"958","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E2. Guard Duty (medium)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Princess Heidi decided to give orders to all her "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" Rebel ship commanders in person. Unfortunately, she is currently travelling through hyperspace, and will leave it only at "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" specific moments "},{"kind":"math_inline","text":"t1, t2, ..., tN"},{"kind":"text","text":". The meetings with commanders must therefore start and stop at those times. Namely, each commander will board her ship at some time "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" and disembark at some later time "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":". Of course, Heidi needs to meet with all commanders, and no two meetings can be held during the same time. Two commanders cannot even meet at the beginnings/endings of the hyperspace jumps, because too many ships in one position could give out their coordinates to the enemy. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find minimum time that Princess Heidi has to spend on meetings, with her schedule satisfying the conditions above. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"K"},{"kind":"text","text":", "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ 2K ≤ N ≤ 500000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"K ≤ 5000"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"t1, t2, ..., tN"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 109"},{"kind":"text","text":") representing the times when Heidi leaves hyperspace."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output only one integer: the minimum time spent on meetings. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 5\n1 4 6 7 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6\n6 3 4 2 5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 12\n15 7 4 19 3 30 14 1 5 23 17 25\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, there are five valid schedules: "},{"kind":"math_inline","text":"[1, 4], [6, 7]"},{"kind":"text","text":" with total time 4, "},{"kind":"math_inline","text":"[1, 4], [6, 12]"},{"kind":"text","text":" with total time 9, "},{"kind":"math_inline","text":"[1, 4], [7, 12]"},{"kind":"text","text":" with total time 8, "},{"kind":"math_inline","text":"[1, 6], [7, 12]"},{"kind":"text","text":" with total time 10, and "},{"kind":"math_inline","text":"[4, 6], [7, 12]"},{"kind":"text","text":" with total time 7. So the answer is 4."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, there is only 1 valid schedule: "},{"kind":"math_inline","text":"[1, 2], [3, 4], [5, 6]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the third example, one possible schedule with total time 6 is: "},{"kind":"math_inline","text":"[1, 3], [4, 5], [14, 15], [23, 25]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E2","problemCode":"958E2","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/958/problem/E2"}