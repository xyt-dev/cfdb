{"assets":[],"contentKind":"statement","contestId":"219","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Special Offer! Super Price 999 Bourles!"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarpus is an amateur businessman. Recently he was surprised to find out that the market for paper scissors is completely free! Without further ado, Polycarpus decided to start producing and selling such scissors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycaprus calculated that the optimal celling price for such scissors would be "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" bourles. However, he read somewhere that customers are attracted by prices that say something like \"Special Offer! Super price 999 bourles!\". So Polycarpus decided to lower the price a little if it leads to the desired effect."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus agrees to lower the price by no more than "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" bourles so that the number of nines at the end of the resulting price is maximum. If there are several ways to do it, he chooses the maximum possible price."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note, Polycarpus counts only the "},{"children":[{"kind":"text","text":"trailing"}],"kind":"container"},{"kind":"text","text":" nines in a price."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"