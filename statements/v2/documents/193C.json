{"assets":["/statement-assets/a714d20f925dd171db4f34f141a95d0a8ab832df10ee366bacc29644bf8b073e.png"],"contentKind":"statement","contestId":"193","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Hamming Distance"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Hamming distance"}],"kind":"container"},{"kind":"text","text":" between strings "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" of equal length (denoted by "},{"kind":"math_inline","text":"h(a, b)"},{"kind":"text","text":") is equal to the number of distinct integers "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ |a|)"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th symbol of string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th symbol of string "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". For example, the Hamming distance between strings \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"bba"}],"kind":"container"},{"kind":"text","text":"\" equals "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", they have different first symbols. For strings \""},{"children":[{"kind":"text","text":"bbba"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"aaab"}],"kind":"container"},{"kind":"text","text":"\" the Hamming distance equals "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"John Doe had a paper on which four strings of equal length "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"s3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s4"},{"kind":"text","text":" were written. Each string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" consisted only of lowercase letters \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\". John found the Hamming distances between all pairs of strings he had. Then he lost the paper with the strings but he didn't lose the Hamming distances between all pairs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help John restore the strings; find some four strings "},{"kind":"math_inline","text":"s'1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"s'2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"s'3, s'4"},{"kind":"text","text":" of equal length that consist only of lowercase letters \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\", such that the pairwise Hamming distances between them are the same as between John's strings. More formally, set "},{"kind":"math_inline","text":"s'i"},{"kind":"text","text":" must satisfy the condition "},{"attrs":{"alt":"","src":"/statement-assets/a714d20f925dd171db4f34f141a95d0a8ab832df10ee366bacc29644bf8b073e.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To make the strings easier to put down on a piece of paper, you should choose among all suitable sets of strings the one that has strings of "},{"children":[{"kind":"text","text":"minimum length"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains space-separated integers "},{"kind":"math_inline","text":"h(s1, s2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"h(s1, s3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"h(s1, s4)"},{"kind":"text","text":". The second line contains space-separated integers "},{"kind":"math_inline","text":"h(s2, s3)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"h(s2, s4)"},{"kind":"text","text":". The third line contains the single integer "},{"kind":"math_inline","text":"h(s3, s4)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All given integers "},{"kind":"math_inline","text":"h(si, sj)"},{"kind":"text","text":" are non-negative and do not exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":". It is guaranteed that at least one number "},{"kind":"math_inline","text":"h(si, sj)"},{"kind":"text","text":" is positive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print -1 if there's no suitable set of strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print on the first line number "},{"kind":"math_inline","text":"len"},{"kind":"text","text":" — the length of each string. On the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the next four lines print string "},{"kind":"math_inline","text":"s'i"},{"kind":"text","text":". If there are multiple sets with the minimum length of the strings, print any of them. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4 4\n4 4\n4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\naaaabb\naabbaa\nbbaaaa\nbbbbbb\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"193C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/193/problem/C"}