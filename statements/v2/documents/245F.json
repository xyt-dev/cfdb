{"assets":[],"contentKind":"statement","contestId":"245","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Log Stream Analysis"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got a list of program warning logs. Each record of a log stream is a string in this format: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"2012-MM-DD HH:MM:SS:MESSAGE"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes). "}],"kind":"container"},{"children":[{"kind":"text","text":"String \""},{"children":[{"kind":"text","text":"MESSAGE"}],"kind":"container"},{"kind":"text","text":"\" consists of spaces, uppercase and lowercase English letters and characters \""},{"children":[{"kind":"text","text":"!"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":","}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\". String \""},{"children":[{"kind":"text","text":"2012-MM-DD"}],"kind":"container"},{"kind":"text","text":"\" determines a correct date in the year of 2012. String \""},{"children":[{"kind":"text","text":"HH:MM:SS"}],"kind":"container"},{"kind":"text","text":"\" determines a correct time in the 24 hour format."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The described record of a log stream means that at a certain time the record has got some program warning (string \""},{"children":[{"kind":"text","text":"MESSAGE"}],"kind":"container"},{"kind":"text","text":"\" contains the warning's description)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to print the first moment of time, when the number of warnings for the last "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" seconds was not less than "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 10000)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second and the remaining lines of the input represent the log stream. The second line of the input contains the first record of the log stream, the third line contains the second record and so on. Each record of the log stream has the above described format. All records are given in the chronological order, that is, the warning records are given in the order, in which the warnings appeared in the program. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the log has at least one record. It is guaranteed that the total length of all lines of the log stream doesn't exceed "},{"kind":"math_inline","text":"5·106"},{"kind":"text","text":" (in particular, this means that the length of some line does not exceed "},{"kind":"math_inline","text":"5·106"},{"kind":"text","text":" characters). It is guaranteed that all given dates and times are correct, and the string '"},{"children":[{"kind":"text","text":"MESSAGE"}],"kind":"container"},{"kind":"text","text":"\" in all records is non-empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no sought moment of time, print -1. Otherwise print a string in the format \""},{"children":[{"kind":"text","text":"2012-MM-DD HH:MM:SS"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) — the first moment of time when the number of warnings for the last "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" seconds got no less than "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"60 3\n2012-03-16 16:15:25: Disk size is\n2012-03-16 16:15:25: Network failute\n2012-03-16 16:16:29: Cant write varlog\n2012-03-16 16:16:42: Unable to start process\n2012-03-16 16:16:43: Disk size is too small\n2012-03-16 16:16:53: Timeout detected\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2012-03-16 16:16:43\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n2012-03-16 23:59:59:Disk size\n2012-03-17 00:00:00: Network\n2012-03-17 00:00:01:Cant write varlog\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n2012-03-16 23:59:59:Disk size is too sm\n2012-03-17 00:00:00:Network failute dete\n2012-03-17 00:00:01:Cant write varlogmysq\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2012-03-17 00:00:00\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"245F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/245/problem/F"}