{"assets":[],"contentKind":"statement","contestId":"1942","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Farmer John's Challenge"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"children":[{"attrs":{"href":"https://soundcloud.com/patrick-deng-392681004/trade-winds-ft-alex-zhu"},"children":[{"kind":"text","text":"Trade Winds - Patrick Deng"}],"kind":"link"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"⠀"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Let's call an array $$$a$$$ "},{"children":[{"kind":"text","text":"sorted"}],"kind":"container"},{"kind":"text","text":" if $$$a_1 \\leq a_2 \\leq \\ldots \\leq a_{n - 1} \\leq a_{n}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given two of Farmer John's favorite integers, $$$n$$$ and $$$k$$$. He challenges you to find any array $$$a_1, a_2, \\ldots, a_{n}$$$ satisfying the following requirements:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1 \\leq a_i \\leq 10^9$$$ for each $$$1 \\leq i \\leq n$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Out of the $$$n$$$ total cyclic shifts of $$$a$$$, exactly $$$k$$$ of them are sorted.$$$^\\dagger$$$ "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there is no such array $$$a$$$, output $$$-1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$^\\dagger$$$The $$$x$$$-th ($$$1 \\leq x \\leq n$$$) "},{"children":[{"kind":"text","text":"cyclic shift"}],"kind":"container"},{"kind":"text","text":" of the array $$$a$$$ is $$$a_x, a_{x+1} \\ldots a_n, a_1, a_2 \\ldots a_{x - 1}$$$. If $$$c_{x, i}$$$ denotes the $$$i$$$'th element of the $$$x$$$'th cyclic shift of $$$a$$$, exactly $$$k$$$ such $$$x$$$ should satisfy $$$c_{x,1} \\leq c_{x,2} \\leq \\ldots \\leq c_{x, n - 1} \\leq c_{x, n}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the cyclic shifts for $$$a = [1, 2, 3, 3]$$$ are the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$x = 1$$$: $$$[1, 2, 3, 3]$$$ (sorted); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$x = 2$$$: $$$[2, 3, 3, 1]$$$ (not sorted); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$x = 3$$$: $$$[3, 3, 1, 2]$$$ (not sorted); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$x = 4$$$: $$$[3, 1, 2, 3]$$$ (not sorted). "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains $$$t$$$ ($$$1 \\leq t \\leq 10^3$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\leq k \\leq n \\leq 10^3$$$) — the length of $$$a$$$ and the number of sorted cyclic shifts $$$a$$$ must have."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$10^3$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single line: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if there is a valid array $$$a$$$, output $$$n$$$ integers, representing $$$a_1, a_2, \\ldots, a_{n}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" otherwise, output $$$-1$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2 2\n3 1\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 1\n69420 69 420\n-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first testcase, $$$a = [1, 1]$$$ satisfies $$$n = 2, k = 2$$$:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The two cyclic shifts of $$$a$$$ are $$$[a_1, a_2]$$$ and $$$[a_2, a_1]$$$, which are both $$$[1, 1]$$$ and are sorted."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second testcase, $$$a = [69\\,420, 69, 420]$$$ satisfies $$$n = 3, k = 1$$$:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The three cyclic shifts of $$$a$$$ are $$$[a_1, a_2, a_3]$$$, $$$[a_2, a_3, a_1]$$$, $$$[a_3, a_1, a_2]$$$, which are $$$[69\\,420, 69, 420]$$$, $$$[69, 420, 69\\,420]$$$, and $$$[420, 69\\,420, 69]$$$, respectively. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Only $$$[69, 420, 69\\,420]$$$ is sorted."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1942A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1942/problem/A"}