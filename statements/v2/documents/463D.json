{"assets":[],"contentKind":"statement","contestId":"463","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Gargari and Permutations"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Gargari got bored to play with the bishops and now, after solving the problem about them, he is trying to do math homework. In a math book he have found "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" permutations. Each of them consists of numbers "},{"kind":"math_inline","text":"1, 2, ..., n"},{"kind":"text","text":" in some order. Now he should find the length of the longest common subsequence of these permutations. Can you help Gargari?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can read about longest common subsequence there: "},{"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Longest_common_subsequence_problem"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n ≤ 1000; 2 ≤ k ≤ 5)"},{"kind":"text","text":". Each of the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contains integers "},{"kind":"math_inline","text":"1, 2, ..., n"},{"kind":"text","text":" in some order — description of the current permutation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the length of the longest common subsequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n1 4 2 3\n4 1 2 3\n1 2 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The answer for the first test sample is subsequence [1, 2, 3]."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"463D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/463/problem/D"}