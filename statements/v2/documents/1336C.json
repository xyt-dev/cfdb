{"assets":["/statement-assets/4eb5e75572fc9d437e9eb9c25378f2769027a426c697e7184c75c1a0e7d8c0db.png","/statement-assets/c43d86cacadeb67bc6f28f53bfa57c7c34ee3f0991e5043252f50247f774187b.png"],"contentKind":"statement","contestId":"1336","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Kaavi and Magic Spell"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Kaavi, the mysterious fortune teller, deeply believes that one's fate is inevitable and unavoidable. Of course, she makes her living by predicting others' future. While doing divination, Kaavi believes that magic spells can provide great power for her to see the future. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/4eb5e75572fc9d437e9eb9c25378f2769027a426c697e7184c75c1a0e7d8c0db.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Kaavi has a string $$$T$$$ of length $$$m$$$ and all the strings with the prefix $$$T$$$ are magic spells. Kaavi also has a string $$$S$$$ of length $$$n$$$ and an empty string $$$A$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During the divination, Kaavi needs to perform a sequence of operations. There are two different operations:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Delete the first character of $$$S$$$ and add it at the "},{"children":[{"kind":"text","text":"front"}],"kind":"container"},{"kind":"text","text":" of $$$A$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" Delete the first character of $$$S$$$ and add it at the "},{"children":[{"kind":"text","text":"back"}],"kind":"container"},{"kind":"text","text":" of $$$A$$$."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Kaavi can perform "},{"children":[{"kind":"text","text":"no more than"}],"kind":"container"},{"kind":"text","text":" $$$n$$$ operations. To finish the divination, she wants to know the number of different operation sequences to make $$$A$$$ a magic spell (i.e. with the prefix $$$T$$$). As her assistant, can you help her? The answer might be huge, so Kaavi only needs to know the answer modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two operation sequences are considered different if they are different in length or there exists an $$$i$$$ that their $$$i$$$-th operation is different. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A substring is a contiguous sequence of characters within a string. A prefix of a string $$$S$$$ is a substring of $$$S$$$ that occurs at the beginning of $$$S$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a string $$$S$$$ of length $$$n$$$ ($$$1 \\leq n \\leq 3000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string $$$T$$$ of length $$$m$$$ ($$$1 \\leq m \\leq n$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Both strings contain only lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The output contains only one integer  — the answer modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nabab\nba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n12"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\ndefineintlonglong\nsignedmain\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nrotator\nrotator\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\ncacdcdbbbb\nbdcaccdbbb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n24"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c43d86cacadeb67bc6f28f53bfa57c7c34ee3f0991e5043252f50247f774187b.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The red ones are the magic spells. In the first operation, Kaavi can either add the first character \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" at the front or the back of $$$A$$$, although the results are the same, they are considered as different operations. So the answer is $$$6\\times2=12$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1336C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1336/problem/C"}