{"assets":[],"contentKind":"statement","contestId":"1714","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Minimum Varied Number"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Find the minimum number with the given sum of digits $$$s$$$ such that "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" digits in it are distinct (i.e. all digits are unique)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if $$$s=20$$$, then the answer is $$$389$$$. This is the minimum number in which all digits are different and the sum of the digits is $$$20$$$ ($$$3+8+9=20$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the given $$$s$$$ print the required number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\le t \\le 45$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case is specified by a line that contains the only integer $$$s$$$ ($$$1 \\le s \\le 45$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$t$$$ integers — the answers to the given test cases."}],"kind":"paragraph"}],"kind":"section"}