{"assets":[],"contentKind":"statement","contestId":"963","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Alternating Sum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two integers $$$a$$$ and $$$b$$$. Moreover, you are given a sequence $$$s_0, s_1, \\dots, s_{n}$$$. All values in $$$s$$$ are integers $$$1$$$ or $$$-1$$$. It's known that sequence is $$$k$$$-periodic and $$$k$$$ divides $$$n+1$$$. In other words, for each $$$k \\leq i \\leq n$$$ it's satisfied that $$$s_{i} = s_{i - k}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find out the "},{"children":[{"kind":"text","text":"non-negative"}],"kind":"container"},{"kind":"text","text":" remainder of division of $$$\\sum \\limits_{i=0}^{n} s_{i} a^{n - i} b^{i}$$$ by $$$10^{9} + 9$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note that the modulo is unusual!"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four integers $$$n, a, b$$$ and $$$k$$$ $$$(1 \\leq n \\leq 10^{9}, 1 \\leq a, b \\leq 10^{9}, 1 \\leq k \\leq 10^{5})$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence of length $$$k$$$ consisting of characters '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the $$$i$$$-th character (0-indexed) is '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"', then $$$s_{i} = 1$$$, otherwise $$$s_{i} = -1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that only the first $$$k$$$ members of the sequence are given, the rest can be obtained using the periodicity property."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — value of given expression modulo $$$10^{9} + 9$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 3 3\n+-+\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1 5 1\n-\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"999999228\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$(\\sum \\limits_{i=0}^{n} s_{i} a^{n - i} b^{i})$$$ = $$$2^{2} 3^{0} - 2^{1} 3^{1} + 2^{0} 3^{2}$$$ = 7"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$(\\sum \\limits_{i=0}^{n} s_{i} a^{n - i} b^{i}) = -1^{4} 5^{0} - 1^{3} 5^{1} - 1^{2} 5^{2} - 1^{1} 5^{3} - 1^{0} 5^{4} = -781 \\equiv 999999228 \\pmod{10^{9} + 9}$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"963A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/963/problem/A"}