{"assets":[],"contentKind":"statement","contestId":"847","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Packmen"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A game field is a strip of "},{"kind":"math_inline","text":"1 × n"},{"kind":"text","text":" square cells. In some cells there are Packmen, in some cells — asterisks, other cells are empty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Packman can move to neighboring cell in "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" time unit. If there is an asterisk in the target cell then Packman eats it. Packman doesn't spend any time to eat an asterisk."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the initial moment of time all Packmen begin to move. Each Packman can change direction of its move unlimited number of times, but it is not allowed to go beyond the boundaries of the game field. Packmen do not interfere with the movement of other packmen; in one cell there can be any number of packmen moving in any directions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine minimum possible time after which Packmen can eat all the asterisks."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":") — the length of the game field."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the description of the game field consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" symbols. If there is symbol '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' in position "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" — the cell "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is empty. If there is symbol '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"' in position "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" — in the cell "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" contains an asterisk. If there is symbol '"},{"children":[{"kind":"text","text":"P"}],"kind":"container"},{"kind":"text","text":"' in position "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" — Packman is in the cell "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that on the game field there is at least one Packman and at least one asterisk."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print minimum possible time after which Packmen can eat all asterisks."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n*..P*P*\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n.**PP.*P.*\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Packman in position "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" will move to the left and will eat asterisk in position "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". He will spend "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" time units on it. During the same "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" time units Packman in position "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" will eat both of neighboring with it asterisks. For example, it can move to the left and eat asterisk in position "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" (in "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" time unit) and then move from the position "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" to the right and eat asterisk in the position "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" (in "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" time units). So in "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" time units Packmen will eat all asterisks on the game field."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example Packman in the position "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" will move to the left and after "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" time units will eat asterisks in positions "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Packmen in positions "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" will move to the right and in "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" time units will eat asterisks in positions "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"10"},{"kind":"text","text":", respectively. So "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" time units is enough for Packmen to eat all asterisks on the game field."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"847E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/847/problem/E"}