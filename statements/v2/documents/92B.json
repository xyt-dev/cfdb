{"assets":[],"contentKind":"statement","contestId":"92","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Binary Number"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little walrus Fangy loves math very much. That's why when he is bored he plays with a number performing some operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Fangy takes some positive integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and wants to get a number one from it. While "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is not equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", Fangy repeats the following action: if "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is odd, then he adds "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to it, otherwise he divides "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Fangy knows that for any positive integer number the process ends in finite time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How many actions should Fangy perform to get a number one from number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a positive integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" in a "},{"children":[{"kind":"text","text":"binary system"}],"kind":"container"},{"kind":"text","text":". It is guaranteed that the first digit of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is different from a zero and the number of its digits does not exceed "},{"kind":"math_inline","text":"106"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the required number of actions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1001001\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"101110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's consider the third sample. Number "},{"kind":"math_inline","text":"101110"},{"kind":"text","text":" is even, which means that we should divide it by "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". After the dividing Fangy gets an odd number "},{"kind":"math_inline","text":"10111"},{"kind":"text","text":" and adds one to it. Number "},{"kind":"math_inline","text":"11000"},{"kind":"text","text":" can be divided by "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" three times in a row and get number "},{"kind":"math_inline","text":"11"},{"kind":"text","text":". All that's left is to increase the number by one (we get "},{"kind":"math_inline","text":"100"},{"kind":"text","text":"), and then divide it by "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" two times in a row. As a result, we get "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"92B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/92/problem/B"}