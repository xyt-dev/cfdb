{"assets":["/statement-assets/db9915bd513abba543595511f815c41f60b0ba3b3b10e61c0efb61c275dfb01b.png","/statement-assets/6f634f625746bd4e5c1a9dbb2927d853ac08ca5a833ae6dca321c727b6a3beb7.png","/statement-assets/545931c933485ad2ccddcd7980c05fbc7b987ab702598c1d4141fec4a9f0d0b1.png"],"contentKind":"statement","contestId":"400","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Dima and Bacteria"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dima took up the biology of bacteria, as a result of his experiments, he invented "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" types of bacteria. Overall, there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" bacteria at his laboratory right now, and the number of bacteria of type "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" equals "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":". For convenience, we will assume that all the bacteria are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The bacteria of type "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" are numbered from "},{"attrs":{"alt":"","src":"/statement-assets/db9915bd513abba543595511f815c41f60b0ba3b3b10e61c0efb61c275dfb01b.png"},"kind":"image"},{"kind":"text","text":" to "},{"attrs":{"alt":"","src":"/statement-assets/6f634f625746bd4e5c1a9dbb2927d853ac08ca5a833ae6dca321c727b6a3beb7.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"With the help of special equipment Dima can move energy from some bacteria into some other one. Of course, the use of such equipment is not free. Dima knows "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ways to move energy from some bacteria to another one. The way with number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" can be described with integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" mean that this way allows moving energy from bacteria with number "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" to bacteria with number "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" or vice versa for "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" dollars."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Dima's Chef (Inna) calls the type-distribution "},{"children":[{"kind":"text","text":"correct"}],"kind":"container"},{"kind":"text","text":" if there is a way (may be non-direct) to move energy from any bacteria of the particular type to any other bacteria of the same type (between any two bacteria of the same type) for zero cost."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As for correct type-distribution the cost of moving the energy depends only on the types of bacteria help Inna to determine is the type-distribution correct? If it is, print the matrix "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" with size "},{"kind":"math_inline","text":"k × k"},{"kind":"text","text":". Cell "},{"kind":"math_inline","text":"d[i][j]"},{"kind":"text","text":" of this matrix must be equal to the minimal possible cost of energy-moving from bacteria with type "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to bacteria with type "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n, m, k"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105; 0 ≤ m ≤ 105; 1 ≤ k ≤ 500)"},{"kind":"text","text":". The next line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"c1, c2, ..., ck"},{"kind":"math_inline","text":"(1 ≤ ci ≤ n)"},{"kind":"text","text":". Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains three integers "},{"kind":"math_inline","text":"ui, vi, xi"},{"kind":"math_inline","text":"(1 ≤ ui, vi ≤ 105; 0 ≤ xi ≤ 104)"},{"kind":"text","text":". It is guaranteed that "},{"attrs":{"alt":"","src":"/statement-assets/545931c933485ad2ccddcd7980c05fbc7b987ab702598c1d4141fec4a9f0d0b1.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If Dima's type-distribution is correct, print string «"},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"», and then "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines: in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print integers "},{"kind":"math_inline","text":"d[i][1], d[i][2], ..., d[i][k]"},{"kind":"math_inline","text":"(d[i][i] = 0)"},{"kind":"text","text":". If there is no way to move energy from bacteria "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to bacteria "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" appropriate "},{"kind":"math_inline","text":"d[i][j]"},{"kind":"text","text":" must equal to -1. If the type-distribution isn't correct print «"},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"»."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4 2\n1 3\n2 3 0\n3 4 0\n2 4 1\n2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n0 2\n2 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 2\n2 1\n1 2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n0 -1\n-1 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 2\n2 1\n1 2 0\n2 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n0 1\n1 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 0 2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"400D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/400/problem/D"}