{"assets":[],"contentKind":"statement","contestId":"2","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. The least round way"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a square matrix "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":", consisting of non-negative integer numbers. You should find such a way on it that "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" starts in the upper left cell of the matrix; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" each following cell is to the right or down from the current cell; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the way ends in the bottom right cell. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Moreover, if we multiply together all the numbers along the way, the result should be the least \"round\". In other words, it should end in the least possible number of zeros."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 1000"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the size of the matrix. Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines containing the matrix elements (non-negative integer numbers not exceeding "},{"kind":"math_inline","text":"109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the least number of trailing zeros. In the second line print the correspondent way itself."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n4 5 6\n7 8 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\nDDRR\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"2B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2/problem/B"}