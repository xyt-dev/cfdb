{"assets":[],"contentKind":"statement","contestId":"788","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Finding lines"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After some programming contest Roma decided to try himself in tourism. His home country Uzhlyandia is a Cartesian plane. He wants to walk along each of the Main Straight Lines in Uzhlyandia. It is known that each of these lines is a straight line parallel to one of the axes (i.e. it is described with the equation "},{"kind":"math_inline","text":"x = a"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"y = a"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is integer called the coordinate of this line)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Roma lost his own map, so he should find out the coordinates of all lines at first. Uncle Anton agreed to help him, using the following rules: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Initially Roma doesn't know the number of vertical and horizontal lines and their coordinates; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Roma can announce integer coordinates of some point in Uzhlandia, and Anton then will tell him the minimum among the distances from the chosen point to each of the lines. However, since the coordinates of the lines don't exceed "},{"kind":"math_inline","text":"108"},{"kind":"text","text":" by absolute value, Roma can't choose a point with coordinates exceeding "},{"kind":"math_inline","text":"108"},{"kind":"text","text":" by absolute value. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Uncle Anton is in a hurry to the UOI (Uzhlandian Olympiad in Informatics), so he can only answer no more than "},{"kind":"math_inline","text":"3·105"},{"kind":"text","text":" questions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The problem is that Roma doesn't know how to find out the coordinates of the lines. Write a program that plays Roma's role and finds the coordinates."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"There is no input initially. Your program should make queries to get information."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the number of horizontal and vertical lines is at least "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and less than or equal to "},{"kind":"math_inline","text":"104"},{"kind":"text","text":" for each type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom","title":"Interaction"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Interaction"}],"kind":"heading"},{"children":[{"kind":"text","text":"To make a query, print a line \""},{"children":[{"kind":"text","text":"0 x y"}],"kind":"container"},{"kind":"text","text":"\" (-"},{"kind":"math_inline","text":"108 ≤ x, y ≤ 108"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" are the coordinates of the point. After each query you need to print end-of-line, make \""},{"children":[{"kind":"text","text":"flush"}],"kind":"container"},{"kind":"text","text":"\" operation, and then read the answer to the query — the minimum among the distances prom this point to the Main Straight Lines of Uzhlyandia."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can do no more than "},{"kind":"math_inline","text":"3·105"},{"kind":"text","text":" queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When you are ready to print the answer, print three lines:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" In the first line print \""},{"children":[{"kind":"text","text":"1 n m"}],"kind":"container"},{"kind":"text","text":"\", where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the number of vertical lines (parallel to "},{"kind":"math_inline","text":"OY"},{"kind":"text","text":"), and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is the number of horizontal lines (parallel to "},{"kind":"math_inline","text":"OX"},{"kind":"text","text":"). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" In the second line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":" — the coordinates of the vertical lines. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" In the third line in the same format print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"y1, y2, ..., ym"},{"kind":"text","text":" — the coordinates of the horizontal lines. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You can print coordinates in arbitrary order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To make \""},{"children":[{"kind":"text","text":"flush"}],"kind":"container"},{"kind":"text","text":"\", you can use (just after printing a query/answer and end-of-line):"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"fflush(stdout)"}],"kind":"container"},{"kind":"text","text":" in C++; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"System.out.flush()"}],"kind":"container"},{"kind":"text","text":" in Java; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"stdout.flush()"}],"kind":"container"},{"kind":"text","text":" in Python; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"flush(output)"}],"kind":"container"},{"kind":"text","text":" in Pascal; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" see the documentation for other languages. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You will get "},{"children":[{"kind":"text","text":"Wrong Answer"}],"kind":"container"},{"kind":"text","text":" if you make more queries than allowed or make an invalid query. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can get "},{"children":[{"kind":"text","text":"Idleness Limit Exceeded"}],"kind":"container"},{"kind":"text","text":" if you don't print anything or if you forget to flush the output."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If at any moment your program reads "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" as an answer, it should immediately exit normally (for example, by calling "},{"children":[{"kind":"text","text":"exit(0)"}],"kind":"container"},{"kind":"text","text":"). You will get "},{"children":[{"kind":"text","text":"Wrong Answer"}],"kind":"container"},{"kind":"text","text":" in this case, it means that you made more queries than allowed, or made an invalid query. If you ignore this, you can get other verdicts since your program will continue to read from a closed stream."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Making test for hacking"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line should contain two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 104"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line should contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" (-"},{"kind":"math_inline","text":"108 ≤ xi ≤ 108"},{"kind":"text","text":") — the coordinates of the vertical lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line should contain "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" (-"},{"kind":"math_inline","text":"108 ≤ yi ≤ 108"},{"kind":"text","text":") — the coordinates of the horizontal lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can write coordinates in arbitrary order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can see the example case in the notes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n3\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 1 2\n0 -2 -2\n0 5 6\n0 -2 2\n1 1 2\n2\n0 -3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The example test is "}],"kind":"paragraph"},{"kind":"code_block","text":"\n1 2\n2\n0 -3\n"},{"children":[{"kind":"text","text":"The minimum distances are:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" from "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"x = 2"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" from "},{"kind":"math_inline","text":"( - 2,  - 2)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"y =  - 3"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" from "},{"kind":"math_inline","text":"(5, 6)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"x = 2"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" from "},{"kind":"math_inline","text":"( - 2, 2)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"y = 0"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"788D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/788/problem/D"}