{"assets":["/statement-assets/7a605dfc73c4cb2f9fa40b39d97ccda51e447363994ee15bd8571509dbc03ead.png","/statement-assets/c8b328a5e3d758bbf0808536b482a04981422a8863a019ba2f8eccee5952156a.png","/statement-assets/75bf96bc2297f691be7f9a817a0f6a66b4b84ae1279b506eeb3eb1096a710258.png"],"contentKind":"statement","contestId":"689","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Friends and Subsequences"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mike and !Mike are old childhood rivals, they are opposite in everything they do, except programming. Today they have a problem they cannot solve on their own, but together (with you) — who knows? "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Every one of them has an integer sequences "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Being given a query of the form of pair of integers "},{"kind":"math_inline","text":"(l, r)"},{"kind":"text","text":", Mike can instantly tell the value of "},{"attrs":{"alt":"","src":"/statement-assets/7a605dfc73c4cb2f9fa40b39d97ccda51e447363994ee15bd8571509dbc03ead.png"},"kind":"image"},{"kind":"text","text":" while !Mike can instantly tell the value of "},{"attrs":{"alt":"","src":"/statement-assets/c8b328a5e3d758bbf0808536b482a04981422a8863a019ba2f8eccee5952156a.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now suppose a robot (you!) asks them all possible different queries of pairs of integers "},{"kind":"math_inline","text":"(l, r)"},{"kind":"math_inline","text":"(1 ≤ l ≤ r ≤ n)"},{"kind":"text","text":" (so he will make exactly "},{"kind":"math_inline","text":"n(n + 1) / 2"},{"kind":"text","text":" queries) and counts how many times their answers coincide, thus for how many pairs "},{"attrs":{"alt":"","src":"/statement-assets/75bf96bc2297f691be7f9a817a0f6a66b4b84ae1279b506eeb3eb1096a710258.png"},"kind":"image"},{"kind":"text","text":" is satisfied."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How many occasions will the robot count?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains only integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ ai ≤ 109"},{"kind":"text","text":") — the sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ bi ≤ 109"},{"kind":"text","text":") — the sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer number — the number of occasions the robot will count, thus for how many pairs "},{"attrs":{"alt":"","src":"/statement-assets/75bf96bc2297f691be7f9a817a0f6a66b4b84ae1279b506eeb3eb1096a710258.png"},"kind":"image"},{"kind":"text","text":" is satisfied."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 2 3 2 1 4\n6 7 1 2 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 3 3\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The occasions in the first sample case are:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1."},{"kind":"math_inline","text":"l = 4"},{"kind":"text","text":","},{"kind":"math_inline","text":"r = 4"},{"kind":"text","text":" since "},{"kind":"math_inline","text":"max{2} = min{2}"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2."},{"kind":"math_inline","t