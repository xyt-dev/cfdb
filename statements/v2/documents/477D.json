{"assets":[],"contentKind":"statement","contestId":"477","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Dreamoon and Binary"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dreamoon saw a large integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" written on the ground and wants to print its binary form out. Dreamoon has accomplished the part of turning "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" into its binary format. Now he is going to print it in the following manner."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He has an integer "},{"kind":"math_inline","text":"n = 0"},{"kind":"text","text":" and can only perform the following two operations in any order for unlimited times each:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Print n in binary form without leading zeros, each print will append to the right of previous prints. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Increase n by 1. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let's define an "},{"children":[{"kind":"text","text":"ideal sequence"}],"kind":"container"},{"kind":"text","text":" as a sequence of operations that can successfully print binary representation of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" without leading zeros and ends with a print operation (i.e. operation 1). Dreamoon wants to know how many different ideal sequences are there and the length (in operations) of the shortest ideal sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answers might be large so please print them modulo 1000000007 ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define the string representation of an ideal sequence as a string of "},{"children":[{"kind":"text","text":"'1'"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"'2'"}],"kind":"container"},{"kind":"text","text":" where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character in the string matches the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th operation performed. Two ideal sequences are called different if their string representations are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line of the input contains a binary integer representing "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x < 25000"},{"kind":"text","text":") without leading zeros."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the output should contain an integer representing the number of different ideal sequences modulo 1000000007 ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the output contains an integer representing the minimal length of an ideal sequence modulo 1000000007 ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"101\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11010\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample, the shortest and the only ideal sequence is «"},{"children":[{"kind":"text","text":"222221"}],"kind":"container"},{"kind":"text","text":"» of length "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second sample, there are three ideal sequences «"},{"children":[{"kind":"text","text":"21211"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"212222222221"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"222222222222222222222222221"}],"kind":"container"},{"kind":"text","text":"». Among them the shortest one has length "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"477D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/477/problem/D"}