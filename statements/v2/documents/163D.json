{"assets":[],"contentKind":"statement","contestId":"163","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Large Refrigerator"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya wants to buy a new refrigerator. He believes that a refrigerator should be a rectangular parallelepiped with integer edge lengths. Vasya calculated that for daily use he will need a refrigerator with volume of at least "},{"kind":"math_inline","text":"V"},{"kind":"text","text":". Moreover, Vasya is a minimalist by nature, so the volume should be no more than "},{"kind":"math_inline","text":"V"},{"kind":"text","text":", either — why take up extra space in the apartment? Having made up his mind about the volume of the refrigerator, Vasya faced a new challenge — for a fixed volume of "},{"kind":"math_inline","text":"V"},{"kind":"text","text":" the refrigerator must have the minimum surface area so that it is easier to clean."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The volume and the surface area of a refrigerator with edges "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" are equal to "},{"kind":"math_inline","text":"V = abc"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"S = 2(ab + bc + ca)"},{"kind":"text","text":", correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the volume "},{"kind":"math_inline","text":"V"},{"kind":"text","text":", help Vasya find the integer lengths for the refrigerator's edges "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" so that the refrigerator's volume equals "},{"kind":"math_inline","text":"V"},{"kind":"text","text":" and its surface area "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" is minimized."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 500"},{"kind":"text","text":") — the number of data sets."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The description of "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" data sets follows. Each set consists of a single integer "},{"kind":"math_inline","text":"V"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ V ≤ 1018"},{"kind":"text","text":"), given by its factorization as follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"V"},{"kind":"text","text":" = "},{"kind":"math_inline","text":"p1a1p2a2... pkak"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" are different prime numbers and "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" are positive integer powers. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then the first line describing a data set contains a single positive integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of different prime divisors of "},{"kind":"math_inline","text":"V"},{"kind":"text","text":". Next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contain prime numbers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and their powers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", separated by spaces. All "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" are different, all "},{"kind":"math_inline","text":"ai > 0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines, on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print the answer to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th data set as four space-separated integers: the minimum possible surface area "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" and the corresponding edge lengths "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":". If there are multiple variants of the lengths of edges that give the minimum area, you are allowed to print any of them. You can print the lengths of the fridge's edges in any order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1\n2 3\n1\n17 1\n3\n3 1\n2 3\n5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"24 2 2 2\n70 1 1 17\n148 4 6 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first data set of the sample the fridge's volume "},{"kind":"math_inline","text":"V = 23 = 8"},{"kind":"text","text":", and the minimum surface area will be produced by the edges of equal length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second data set the volume "},{"kind":"math_inline","text":"V = 17"},{"kind":"text","text":", and it can be produced by only one set of integer lengths."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"163D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/163/problem/D"}