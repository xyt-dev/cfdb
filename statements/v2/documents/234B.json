{"assets":[],"contentKind":"statement","contestId":"234","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Reading"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"input_channel"},"children":[{"children":[{"kind":"text","text":"input"}],"kind":"container"},{"kind":"text","text":"input.txt"}],"kind":"container"},{"attrs":{"role":"output_channel"},"children":[{"children":[{"kind":"text","text":"output"}],"kind":"container"},{"kind":"text","text":"output.txt"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya is going to the Olympics in the city Ntown by train. The boy wants to read the textbook to prepare for the Olympics. He counted that he needed "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" hours for this. He also found that the light in the train changes every hour. The light is measured on a scale from 0 to 100, where 0 is very dark, and 100 is very light."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya has a train lighting schedule for all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" hours of the trip — "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers from 0 to 100 each (the light level in the first hour, the second hour and so on). During each of those hours he will either read the whole time, or not read at all. He wants to choose "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" hours to read a book, not necessarily consecutive, so that the minimum level of light among the selected hours were maximum. Vasya is very excited before the upcoming contest, help him choose reading hours."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000, 1 ≤ k ≤ n"},{"kind":"text","text":") — the number of hours on the train and the number of hours to read, correspondingly. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 100"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the light level at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th hour."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first output line print the minimum light level Vasya will read at. In the second line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" distinct space-separated integers "},{"kind":"math_inline","text":"b1, b2, ..., bk"},{"kind":"text","text":", — the indexes of hours Vasya will read at ("},{"kind":"math_inline","text":"1 ≤ bi ≤ n"},{"kind":"text","text":"). The hours are indexed starting from 1. If there are multiple optimal solutions, print any of them. Print the numbers "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" in an arbitrary order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n20 10 30 40 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20\n1 3 4 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 5\n90 20 35 40 60 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"35\n1 3 4 5 6 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Vasya should read at the first hour (light "},{"kind":"math_inline","text":"20"},{"kind":"text","text":"), third hour (light "},{"kind":"math_inline","text":"30"},{"kind":"text","text":") and at the fourth hour (light "},{"kind":"math_inline","text":"40"},{"kind":"text","text":"). The minimum light Vasya will have to read at is "},{"kind":"math_inline","text":"20"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"234B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/234/problem/B"}