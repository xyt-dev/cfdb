{"assets":[],"contentKind":"statement","contestId":"1144","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Diverse Strings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A string is called "},{"children":[{"kind":"text","text":"diverse"}],"kind":"container"},{"kind":"text","text":" if it contains consecutive (adjacent) letters of the Latin alphabet and each letter occurs exactly once. For example, the following strings are diverse: \""},{"children":[{"kind":"text","text":"fced"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"xyz"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"dabcef"}],"kind":"container"},{"kind":"text","text":"\". The following string are "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" diverse: \""},{"children":[{"kind":"text","text":"az"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"bad"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"babc"}],"kind":"container"},{"kind":"text","text":"\". Note that the letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"' are not adjacent."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, consider positions of all letters in the string in the alphabet. These positions should form contiguous segment, i.e. they should come one by one without any gaps. And all letters in the string should be distinct (duplicates are not allowed)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a sequence of strings. For each string, if it is diverse, print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\". Otherwise, print \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer $$$n$$$ ($$$1 \\le n \\le 100$$$), denoting the number of strings to process. The following $$$n$$$ lines contains strings, one string per line. Each string contains only lowercase Latin letters, its length is between $$$1$$$ and $$$100$$$, inclusive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$n$$$ lines, one line per a string in the input. The line should contain \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" if the corresponding string is diverse and \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" if the corresponding string is not diverse. You can print each letter in any case (upper or lower). For example, \""},{"children":[{"kind":"text","text":"YeS"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"no"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"yES"}],"kind":"container"},{"kind":"text","text":"\" are all acceptable."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8\nfced\nxyz\nr\ndabcef\naz\naa\nbad\nbabc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYes\nYes\nYes\nYes\nNo\nNo\nNo\nNo\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1144A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1144/problem/A"}