{"assets":["/statement-assets/ee26336fd4c7839b5e972559f0a29d943cbe9b7e7b82631c197100ae9c6bdfde.png","/statement-assets/a3beaaa05959cdf6d5b021cf128851f7e4a08d63dc6d4d23d93f011ad7c9f9a5.png"],"contentKind":"statement","contestId":"453","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Little Pony and Expected Maximum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Twilight Sparkle was playing Ludo with her friends Rainbow Dash, Apple Jack and Flutter Shy. But she kept losing. Having returned to the castle, Twilight Sparkle became interested in the dice that were used in the game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The dice has "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" faces: the first face of the dice contains a dot, the second one contains two dots, and so on, the "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-th face contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" dots. Twilight Sparkle is sure that when the dice is tossed, each face appears with probability "},{"attrs":{"alt":"","src":"/statement-assets/ee26336fd4c7839b5e972559f0a29d943cbe9b7e7b82631c197100ae9c6bdfde.png"},"kind":"image"},{"kind":"text","text":". Also she knows that each toss is independent from others. Help her to calculate the expected maximum number of dots she could get after tossing the dice "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" times."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line contains two integers "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m, n ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single real number corresponding to the expected maximum. The answer will be considered correct if its relative or absolute error doesn't exceed "},{"kind":"math_inline","text":"10  - 4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3.500000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4.958333333333\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.750000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the third test example. If you've made two tosses:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" You can get 1 in the first toss, and 2 in the second. Maximum equals to 2. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" You can get 1 in the first toss, and 1 in the second. Maximum equals to 1. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" You can get 2 in the first toss, and 1 in the second. Maximum equals to 2. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" You can get 2 in the first toss, and 2 in the second. Maximum equals to 2. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The probability of each outcome is 0.25, that is expectation equals to: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a3beaaa05959cdf6d5b021cf128851f7e4a08d63dc6d4d23d93f011ad7c9f9a5.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"You can read about expectation using the following link: "},{"children":[{"kind":"text","text":"http://en.wikipedia.org/wiki/Expected_value"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"453A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/453/problem/A"}