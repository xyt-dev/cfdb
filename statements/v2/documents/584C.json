{"assets":[],"contentKind":"statement","contestId":"584","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Marina and Vasya"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Marina loves strings of the same length and Vasya loves when there is a third string, different from them in exactly "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" characters. Help Vasya find at least one such string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, you are given two strings "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and number "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Let's denote as "},{"kind":"math_inline","text":"f(a, b)"},{"kind":"text","text":" the number of characters in which strings "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are different. Then your task will be to find any string "},{"kind":"math_inline","text":"s3"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"f(s1, s3) = f(s2, s3) = t"},{"kind":"text","text":". If there is no such string, print "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ t ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains string "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", consisting of lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contain string "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", consisting of lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a string of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", differing from string "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" and from "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" in exactly "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" characters. Your string should consist only from lowercase English letters. If such string doesn't exist, print -1."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\nabc\nxyc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"ayd"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 0\nc\nb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"584C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/584/problem/C"}