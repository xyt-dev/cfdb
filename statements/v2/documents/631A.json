{"assets":["/statement-assets/65667914dda464abbe5bc748a104bb6250da1baf28e381837f815891f58cefdd.png"],"contentKind":"statement","contestId":"631","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Interview"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Blake is a CEO of a large company called \"Blake Technologies\". He loves his company very much and he thinks that his company should be the best. That is why every candidate needs to pass through the interview that consists of the following problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We define function "},{"kind":"math_inline","text":"f(x, l, r)"},{"kind":"text","text":" as a bitwise OR of integers "},{"kind":"math_inline","text":"xl, xl + 1, ..., xr"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" is the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th element of the array "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". You are given two arrays "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". You need to determine the maximum value of sum "},{"kind":"math_inline","text":"f(a, l, r) + f(b, l, r)"},{"kind":"text","text":" among all possible "},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/65667914dda464abbe5bc748a104bb6250da1baf28e381837f815891f58cefdd.png"},"kind":"image"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":") — the length of the arrays."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ bi ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maximum value of sum "},{"kind":"math_inline","text":"f(a, l, r) + f(b, l, r)"},{"kind":"text","text":" among all possible "},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 4 3 2\n2 3 3 12 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"22"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n13 2 7 11 8 4 9 8 5 1\n5 7 18 9 2 3 0 11 8 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"46"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Bitwise OR of two non-negative integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is the number "},{"kind":"math_inline","text":"c = a OR b"},{"kind":"text","text":", such that each of its digits in binary notation is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" if and only if at least one of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" have "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" in the corresponding position in binary notation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample, one of the optimal answers is "},{"kind":"math_inline","text":"l = 2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r = 4"},{"kind":"text","text":", because "},{"kind":"math_inline","text":"f(a, 2, 4) + f(b, 2, 4) = (2 OR 4 OR 3) + (3 OR 3 OR 12) = 7 + 15 = 22"},{"kind":"text","text":". Other ways to get maximum value is to choose "},{"kind":"math_inline","text":"l = 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r = 4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l = 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r = 5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l = 2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r = 4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l = 2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r = 5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l = 3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r = 4"},{"kind":"text","text":", or "},{"kind":"math_inline","text":"l = 3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r = 5"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the maximum value is obtained for "},{"kind":"math_inline","text":"l = 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r = 9"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"631A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/631/problem/A"}