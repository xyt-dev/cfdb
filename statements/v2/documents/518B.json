{"assets":[],"contentKind":"statement","contestId":"518","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Tanya and Postcard"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Tanya decided to present her dad a postcard on his Birthday. She has already created a message — string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", consisting of uppercase and lowercase English letters. Tanya can't write yet, so she found a newspaper and decided to cut out the letters and glue them into the postcard to achieve string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". The newspaper contains string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", consisting of uppercase and lowercase English letters. We know that the length of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" greater or equal to the length of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The newspaper may possibly have too few of some letters needed to make the text and too many of some other letters. That's why Tanya wants to cut some "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" letters out of the newspaper and make a message of length exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", so that it looked as much as possible like "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". If the letter in some position has correct value and correct letter case (in the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and in the string that Tanya will make), then she shouts joyfully \""},{"children":[{"kind":"text","text":"YAY!"}],"kind":"container"},{"kind":"text","text":"\", and if the letter in the given position has only the correct value but it is in the wrong case, then the girl says \""},{"children":[{"kind":"text","text":"WHOOPS"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Tanya wants to make such message that lets her shout \""},{"children":[{"kind":"text","text":"YAY!"}],"kind":"container"},{"kind":"text","text":"\" as much as possible. If there are multiple ways to do this, then her second priority is to maximize the number of times she says \""},{"children":[{"kind":"text","text":"WHOOPS"}],"kind":"container"},{"kind":"text","text":"\". Your task is to help Tanya make the message."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains line "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 2·105"},{"kind":"text","text":"), consisting of uppercase and lowercase English letters — the text of Tanya's message."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains line "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|s| ≤ |t| ≤ 2·105"},{"kind":"text","text":"), consisting of uppercase and lowercase English letters — the text written in the newspaper."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here "},{"kind":"math_inline","text":"|a|"},{"kind":"text","text":" means the length of the string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two integers separated by a space:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the first number is the number of times Tanya shouts \""},{"children":[{"kind":"text","text":"YAY!"}],"kind":"container"},{"kind":"text","text":"\" while making the message, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the second number is the number of times Tanya says \""},{"children":[{"kind":"text","text":"WHOOPS"}],"kind":"container"},{"kind":"text","text":"\" while making the message. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"AbC\nDCbA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ABC\nabc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abacaba\nAbaCaBA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"518B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/518/problem/B"}