{"assets":["/statement-assets/a1599bcc8461d024f1a04c16003fa21fbfb0c5558d8e2512794d20daf75550ef.png","/statement-assets/49b9197810ae738ee4f1104147a688d68d1959685e624edaebe420f1d924c476.png","/statement-assets/281ea914e05cdf6fc7fe4bf60310e9b4c8f7e57346852c8be5fb8634113a1e86.png","/statement-assets/2e5dcd8a74e8b0c964529decc7a13e8f3d88d848f28fbc38e237cb17b329366a.png","/statement-assets/491dae29130e78c0864dda2a9b77b2a1f77ab4935ff973820262bba5d36202c2.png"],"contentKind":"statement","contestId":"297","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Color the Carpet"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Even polar bears feel cold when lying on the ice. Therefore, a polar bear Alice is going to make a carpet. The carpet can be viewed as a grid with height "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" and width "},{"kind":"math_inline","text":"w"},{"kind":"text","text":". Then the grid is divided into "},{"kind":"math_inline","text":"h × w"},{"kind":"text","text":" squares. Alice is going to assign one of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" different colors to each square. The colors are numbered from 1 to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". She may choose not to use all of the colors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, there are some restrictions. For every two adjacent squares (squares that shares an edge) "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", there is a "},{"children":[{"kind":"text","text":"color constraint"}],"kind":"container"},{"kind":"text","text":" in one of the forms: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"color(x) = color(y)"},{"kind":"text","text":", or "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"color(x) ≠ color(y)"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Example of the color constraints:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a1599bcc8461d024f1a04c16003fa21fbfb0c5558d8e2512794d20daf75550ef.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Ideally, Alice wants to satisfy all color constraints. But again, life in the Arctic is hard. It is not always possible to satisfy all color constraints. Fortunately, she will still be happy if at least "},{"attrs":{"alt":"","src":"/statement-assets/49b9197810ae738ee4f1104147a688d68d1959685e624edaebe420f1d924c476.png"},"kind":"image"},{"kind":"text","text":" of the color constraints are satisfied. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If she has "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" colors she can color the carpet in the following way:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/281ea914e05cdf6fc7fe4bf60310e9b4c8f7e57346852c8be5fb8634113a1e86.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"And she is happy because "},{"attrs":{"alt":"","src":"/statement-assets/2e5dcd8a74e8b0c964529decc7a13e8f3d88d848f28fbc38e237cb17b329366a.png"},"kind":"image"},{"kind":"text","text":" of the color constraints are satisfied, and "},{"attrs":{"alt":"","src":"/statement-assets/491dae29130e78c0864dda2a9b77b2a1f77ab4935ff973820262bba5d36202c2.png"},"kind":"image"},{"kind":"text","text":". Your task is to help her color the carpet."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"h, w, k"},{"kind":"math_inline","text":"(2 ≤ h, w ≤ 1000, 1 ≤ k ≤ w·h)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"2h - 1"},{"kind":"text","text":" lines describe the color constraints from top to bottom, left to right. They contain "},{"kind":"math_inline","text":"w - 1, w, w - 1, w, ..., w - 1"},{"kind":"text","text":" characters respectively. Each color constraint is represented by a character \""},{"children":[{"kind":"text","text":"E"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"N"}],"kind":"container"},{"kind":"text","text":"\", where \""},{"children":[{"kind":"text","text":"E"}],"kind":"container"},{"kind":"text","text":"\" means \""},{"kind":"math_inline","text":" = "},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"N"}],"kind":"container"},{"kind":"text","text":"\" means \""},{"kind":"math_inline","text":" ≠ "},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The color constraints listed in the order they are depicted on the picture."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is a coloring that satisfies at least "},{"attrs":{"alt":"","src":"/statement-assets/49b9197810ae738ee4f1104147a688d68d1959685e624edaebe420f1d924c476.png"},"kind":"image"},{"kind":"text","text":" of the color constraints, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in the first line. In each of the next "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" lines, print "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" integers describing the coloring."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4 4\nENE\nNNEE\nNEE\nENEN\nENN\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1 1 2 2\n3 4 1 1\n3 3 2 4"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"297D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/297/problem/D"}