{"assets":[],"contentKind":"statement","contestId":"175","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Geometry Horse"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya plays the Geometry Horse."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The game goal is to destroy geometric figures of the game world. A certain number of points is given for destroying each figure depending on the figure type and the current factor value. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" types of geometric figures. The number of figures of type "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" and figure cost "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" is known for each figure type. A player gets "},{"kind":"math_inline","text":"ci·f "},{"kind":"text","text":" points for destroying one figure of type "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" is the current factor. The factor value can be an integer number from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"t + 1"},{"kind":"text","text":", inclusive. At the beginning of the game the factor value is equal to 1. The factor is set to "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" after destruction of "},{"kind":"math_inline","text":"pi"},{"kind":"math_inline","text":"(1 ≤ i ≤ t)"},{"kind":"text","text":" figures, so the "},{"kind":"math_inline","text":"(pi + 1)"},{"kind":"text","text":"-th figure to be destroyed is considered with factor equal to "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine the maximum number of points Vasya can get after he destroys all figures. Take into account that Vasya is so tough that he can destroy figures in any order chosen by him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the only integer number "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 100)"},{"kind":"text","text":" — the number of figure types."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integer numbers "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci"},{"kind":"math_inline","text":"(1 ≤ ki ≤ 109, 0 ≤ ci ≤ 1000)"},{"kind":"text","text":", separated with space — the number of figures of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th type and the cost of one "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-type figure, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains the only integer number "},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"(1 ≤ t ≤ 100)"},{"kind":"text","text":" — the number that describe the factor's changes. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"pi"},{"kind":"math_inline","text":"(1 ≤ p1 < p2 < ... < pt ≤ 1012)"},{"kind":"text","text":", separated with spaces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specificator to read or write 64-bit integers in С++. It is preferred to use "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specificator."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only number — the maximum number of points Vasya can get."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n5 10\n2\n3 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"70"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n3 8\n5 10\n1\n20\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"74"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Vasya destroys three figures first and gets "},{"kind":"math_inline","text":"3·1·10 = 30"},{"kind":"text","text":" points. Then the factor will become equal to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and after destroying the last two figures Vasya will get "},{"kind":"math_inline","text":"2·2·10 = 40"},{"kind":"text","text":" points. As a result Vasya will get "},{"kind":"math_inline","text":"70"},{"kind":"text","text":" points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example all "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" figures will be destroyed with factor "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", so Vasya will get "},{"kind":"math_inline","text":"(3·8 + 5·10)·1 = 74"},{"kind":"text","text":" points."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"175C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/175/problem/C"}