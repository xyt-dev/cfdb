{"assets":[],"contentKind":"statement","contestId":"1858","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E1. Rollbacks (Easy Version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is an easy version of this problem. The only difference between the versions is that you have to solve the hard version in online mode. You can make hacks only if both versions of the problem are solved."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have an array $$$a$$$, which is initially empty. You need to process queries of the following types:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":" $$$x$$$ — add the integer $$$x$$$ to the end of the array $$$a$$$. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":" $$$k$$$ — remove the last $$$k$$$ numbers from the array $$$a$$$. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"!"}],"kind":"container"},{"kind":"text","text":" — roll back the last active change (i.e., make the array $$$a$$$ the way it was before the change). In this problem, only queries of the first two types ("},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":") are considered as changes. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":" — find the number of distinct numbers in the array $$$a$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$q$$$ ($$$1 \\leq q \\leq 10^6$$$) — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$q$$$ lines contain the queries as described above."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" in the queries of the first type, $$$1 \\le x \\le 10^6$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the queries of the second type, $$$k \\ge 1$$$ and $$$k$$$ does not exceed the current length of the array $$$a$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" at the moment of the queries of the third type, there is at least one query of the first or of the second type that can be rolled back. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is also guaranteed that the number of queries of the fourth type ("},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":") does not exceed $$$10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the fourth type output one integer — the number of distinct elements in array $$$a$$$ at the moment of query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n+ 1\n+ 2\n+ 2\n?\n!\n+ 3\n- 2\n?\n+ 1\n?\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n1\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n+ 1\n+ 1000000\n?\n!\n!\n?\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example array $$$a$$$ changes as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" After the first query, $$$a=[1]$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After the second query, $$$a=[1,2]$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After the third query, $$$a=[1,2,2]$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" At the moment of the fourth query, there are $$$2$$$ distinct intergers in the array $$$a$$$: $$$1$$$ and $$$2$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After the fifth query, $$$a=[1,2]$$$ (rolled back the change "},{"children":[{"kind":"text","text":"+ 2"}],"kind":"container"},{"kind":"text","text":"). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After the sixth query, $$$a=[1,2,3]$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After the seventh query, $$$a=[1]$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" At the moment of the eigth query, there is only one $$$1$$$ in the array $$$a$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After the ninth query, $$$a=[1,1]$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" At the moment of the tenth query, there are only two $$$1$$$ in the array $$$a$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second example array $$$a$$$ changes as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" After the first query, $$$a=[1]$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After the second query, $$$a=[1,1\\,000\\,000]$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" At the moment of the third query, there are $$$2$$$ distinct intergers in the array $$$a$$$: $$$1$$$ and $$$1\\,000\\,000$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After the fourth query, $$$a=[1]$$$ (rolled back the change "},{"children":[{"kind":"text","text":"+ 1000000"}],"kind":"container"},{"kind":"text","text":"). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After the fifth query, $$$a=[]$$$ (rolled back the change "},{"children":[{"kind":"text","text":"+ 1"}],"kind":"container"},{"kind":"text","text":"). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" At the moment of the sixth query, there are no integers in the array $$$a$$$, so the answer to this query is $$$0$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E1","problemCode":"1858E1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1858/problem/E1"}