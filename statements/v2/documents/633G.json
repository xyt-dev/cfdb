{"assets":[],"contentKind":"statement","contestId":"633","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Yash And Trees"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Yash loves playing with trees and gets especially excited when they have something to do with prime numbers. On his 20th birthday he was granted with a rooted tree of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes to answer queries on. Hearing of prime numbers on trees, Yash gets too intoxicated with excitement and asks you to help out and answer queries on trees for him. Tree is rooted at node "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Each node "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has some value "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" associated with it. Also, integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is given."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are queries of two types:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" for given node "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and integer value "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", increase all "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" in the subtree of node "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" by value "},{"kind":"math_inline","text":"x"}],"kind":"list_item"},{"children":[{"kind":"text","text":" for given node "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", find the number of prime numbers "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" less than "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", for which there exists a node "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" in the subtree of "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and a non-negative integer value "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"au = p + m·k"},{"kind":"text","text":"."}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000, 1 ≤ m ≤ 1000"},{"kind":"text","text":") — the number of nodes in the tree and value "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" from the problem statement, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 109"},{"kind":"text","text":") — initial values of the nodes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines that describe the tree. Each of them contains two integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":") — indices of nodes connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains a single integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 100 000"},{"kind":"text","text":") — the number of queries to proceed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the last "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines is either "},{"children":[{"kind":"text","text":"1 v x"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"2 v"}],"kind":"container"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v ≤ n, 0 ≤ x ≤ 109"},{"kind":"text","text":"), giving the query of the first or the second type, respectively. It's guaranteed that there will be at least one query of the second type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each of the queries of the second type print the number of suitable prime numbers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 20\n3 7 9 8 4 11 7 3\n1 2\n1 3\n3 4\n4 5\n4 6\n4 7\n5 8\n4\n2 1\n1 1 1\n2 5\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 10\n8 7 5 1 0\n1 2\n2 3\n1 5\n2 4\n3\n1 1 0\n1 1 2\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"633G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/633/problem/G"}