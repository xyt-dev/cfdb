{"assets":[],"contentKind":"statement","contestId":"1674","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Dictionary"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Berland language consists of words having "},{"children":[{"kind":"text","text":"exactly two letters"}],"kind":"container"},{"kind":"text","text":". Moreover, "},{"children":[{"kind":"text","text":"the first letter of a word is different from the second letter"}],"kind":"container"},{"kind":"text","text":". Any combination of two different Berland letters (which, by the way, are the same as the lowercase letters of Latin alphabet) is a correct word in Berland language."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Berland dictionary contains all words of this language. The words are listed in a way they are usually ordered in dictionaries. Formally, word $$$a$$$ comes earlier than word $$$b$$$ in the dictionary if one of the following conditions hold:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the first letter of $$$a$$$ is less than the first letter of $$$b$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the first letters of $$$a$$$ and $$$b$$$ are the same, and the second letter of $$$a$$$ is less than the second letter of $$$b$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So, the dictionary looks like that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Word $$$1$$$: "},{"children":[{"kind":"text","text":"ab"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Word $$$2$$$: "},{"children":[{"kind":"text","text":"ac"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" ... "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Word $$$25$$$: "},{"children":[{"kind":"text","text":"az"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Word $$$26$$$: "},{"children":[{"kind":"text","text":"ba"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Word $$$27$$$: "},{"children":[{"kind":"text","text":"bc"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" ... "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Word $$$649$$$: "},{"children":[{"kind":"text","text":"zx"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Word $$$650$$$: "},{"children":[{"kind":"text","text":"zy"}],"kind":"container"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given a word $$$s$$$ from the Berland language. Your task is to find its index in the dictionary."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 650$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of one line containing $$$s$$$ — a string consisting of "},{"children":[{"kind":"text","text":"exactly two different lowercase Latin letters"}],"kind":"container"},{"kind":"text","text":" (i. e. a correct word of the Berland language)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer — the index of the word $$$s$$$ in the dictionary."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\nab\nac\naz\nba\nbc\nzx\nzy\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n25\n26\n27\n649\n650\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1674B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1674/problem/B"}