{"assets":["/statement-assets/745a07562a91dfcd766714dd212ac37b7500f38f278eed477cfea6a36ccc0bc7.png"],"contentKind":"statement","contestId":"507","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Guess Your Way Out!"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Amr bought a new video game \"Guess Your Way Out!\". The goal of the game is to find an exit from the maze that looks like a perfect binary tree of height "},{"kind":"math_inline","text":"h"},{"kind":"text","text":". The player is initially standing at the root of the tree and the exit from the tree is located at some leaf node. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's index all the leaf nodes from the left to the right from 1 to "},{"kind":"math_inline","text":"2h"},{"kind":"text","text":". The exit is located at some node "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"1 ≤ n ≤ 2h"},{"kind":"text","text":", the player doesn't know where the exit is so he has to guess his way out!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Amr follows simple algorithm to choose the path. Let's consider infinite command string \""},{"children":[{"kind":"text","text":"LRLRLRLRL..."}],"kind":"container"},{"kind":"text","text":"\" (consisting of alternating characters '"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"'). Amr sequentially executes the characters of the string using following rules:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Character '"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"' means \"go to the left child of the current node\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Character '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"' means \"go to the right child of the current node\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the destination node is already visited, Amr skips current command, otherwise he moves to the destination node; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If Amr skipped two consecutive commands, he goes back to the parent of the current node before executing next command; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If he reached a leaf node that is not the exit, he returns to the parent of the current node; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If he reaches an exit, the game is finished. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Now Amr wonders, if he follows this algorithm, how many nodes he is going to visit before reaching the exit?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Input consists of two integers "},{"kind":"math_inline","text":"h, n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ h ≤ 50"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ n ≤ 2h"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer representing the number of nodes (excluding the exit node) Amr is going to visit before reaching the exit by following this algorithm."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 1024\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2046"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A perfect binary tree of height "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" is a binary tree consisting of "},{"kind":"math_inline","text":"h + 1"},{"kind":"text","text":" levels. Level "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" consists of a single node called "},{"children":[{"kind":"text","text":"root"}],"kind":"container"},{"kind":"text","text":", level "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" consists of "},{"kind":"math_inline","text":"2h"},{"kind":"text","text":" nodes called "},{"children":[{"kind":"text","text":"leaves"}],"kind":"container"},{"kind":"text","text":". Each node that is not a leaf has exactly two children, "},{"children":[{"kind":"text","text":"left"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"right"}],"kind":"container"},{"kind":"text","text":" one. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Following picture illustrates the sample test number "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". Nodes are labeled according to the order of visit."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/745a07562a91dfcd766714dd212ac37b7500f38f278eed477cfea6a36ccc0bc7.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"507C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/507/problem/C"}