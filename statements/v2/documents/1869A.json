{"assets":[],"contentKind":"statement","contestId":"1869","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Make It Zero"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"During Zhongkao examination, Reycloer met an interesting problem, but he cannot come up with a solution immediately. Time is running out! Please help him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially, you are given an array $$$a$$$ consisting of $$$n \\ge 2$$$ integers, and you want to change all elements in it to $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one operation, you select two indices $$$l$$$ and $$$r$$$ ($$$1\\le l\\le r\\le n$$$) and do the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Let $$$s=a_l\\oplus a_{l+1}\\oplus \\ldots \\oplus a_r$$$, where $$$\\oplus$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise XOR operation"}],"kind":"link"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then, for all $$$l\\le i\\le r$$$, replace $$$a_i$$$ with $$$s$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You can use the operation above in any order at most $$$8$$$ times in total."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find a sequence of operations, such that after performing the operations in order, all elements in $$$a$$$ are equal to $$$0$$$. It can be proven that the solution always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer $$$t$$$ ($$$1\\le t\\le 500$$$) — the number of test cases. The description of test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$2\\le n\\le 100$$$) — the length of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1,a_2,\\ldots,a_n$$$ ($$$0\\le a_i\\le 100$$$) — the elements of the array $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, in the first line output a single integer $$$k$$$ ($$$0\\le k\\le 8$$$) — the number of operations you use."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then print $$$k$$$ lines, in the $$$i$$$-th line output two integers $$$l_i$$$ and $$$r_i$$$ ($$$1\\le l_i\\le r_i\\le n$$$) representing that you select $$$l_i$$$ and $$$r_i$$$ in the $$$i$$$-th operation. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that you "},{"children":[{"kind":"text","text":"do not"}],"kind":"container"},{"kind":"text","text":" have to minimize $$$k$$$. If there are multiple solutions, you may output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n4\n1 2 3 0\n8\n3 1 4 1 5 9 2 6\n6\n1 5 4 1 4 7\n5\n0 0 0 0 0\n7\n1 1 9 9 0 1 8\n3\n100 100 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n1 4\n2\n4 7\n1 8\n6\n1 2\n3 4\n5 6\n1 3\n4 6\n1 6\n0\n4\n1 2\n6 7\n3 4\n6 7\n1\n1 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, since $$$1\\oplus2\\oplus3\\oplus0=0$$$, after performing the operation on segment $$$[1,4]$$$, all the elements in the array are equal to $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, after the first operation, the array becomes equal to $$$[3,1,4,15,15,15,15,6]$$$, after the second operation, the array becomes equal to $$$[0,0,0,0,0,0,0,0]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case:"}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"Operation"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$a$$$ before"}],"kind":"table_cell"},{"attrs":{"header":false},"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$a$$$ after"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$1$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$[\\underline{1,5},4,1,4,7]$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\rightarrow$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$[4,4,4,1,4,7]$$$"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$2$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$[4,4,\\underline{4,1},4,7]$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\rightarrow$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$[4,4,5,5,4,7]$$$"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$3$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$[4,4,5,5,\\underline{4,7}]$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\rightarrow$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$[4,4,5,5,3,3]$$$"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$4$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$[\\underline{4,4,5},5,3,3]$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\rightarrow$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$[5,5,5,5,3,3]$$$"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$5$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$[5,5,5,\\underline{5,3,3}]$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\rightarrow$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$[5,5,5,5,5,5]$$$"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$6$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$[\\underline{5,5,5,5,5,5}]$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\rightarrow$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$[0,0,0,0,0,0]$$$"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"}],"kind":"container"},{"children":[{"kind":"text","text":"In the fourth test case, the initial array contains only $$$0$$$, so we do not need to perform any operations with it."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1869A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1869/problem/A"}