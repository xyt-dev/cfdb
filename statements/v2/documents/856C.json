{"assets":[],"contentKind":"statement","contestId":"856","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Eleventh Birthday"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"It is Borya's eleventh birthday, and he has got a great present: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cards with numbers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th card has the number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" written on it. Borya wants to put his cards in a row to get one greater number. For example, if Borya has cards with numbers "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"31"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"12"},{"kind":"text","text":", and he puts them in a row in this order, he would get a number "},{"kind":"math_inline","text":"13112"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He is only 11, but he already knows that there are "},{"kind":"math_inline","text":"n!"},{"kind":"text","text":" ways to put his cards in a row. But today is a special day, so he is only interested in such ways that the resulting big number is divisible by eleven. So, the way from the previous paragraph is good, because "},{"kind":"math_inline","text":"13112 = 1192 × 11"},{"kind":"text","text":", but if he puts the cards in the following order: "},{"kind":"math_inline","text":"31"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"12"},{"kind":"text","text":", he would get a number "},{"kind":"math_inline","text":"31112"},{"kind":"text","text":", it is not divisible by "},{"kind":"math_inline","text":"11"},{"kind":"text","text":", so this way is not good for Borya. Help Borya to find out how many good ways to put the cards are there."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Borya considers all cards different, even if some of them contain the same number. For example, if Borya has two cards with 1 on it, there are two good ways."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Borya, find the number of good ways to put the cards. This number can be large, so output it modulo "},{"kind":"math_inline","text":"998244353"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Input data contains multiple test cases. The first line of the input data contains an integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — the number of test cases ("},{"kind":"math_inline","text":"1 ≤ t ≤ 100"},{"kind":"text","text":"). The descriptions of test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test is described by two lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2000"},{"kind":"text","text":") — the number of cards in Borya's present."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — numbers written on the cards."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the total number of cards in all tests of one input data doesn't exceed "},{"kind":"math_inline","text":"2000"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case output one line: the number of ways to put the cards to the table so that the resulting big number was divisible by 11, print the number modulo "},{"kind":"math_inline","text":"998244353"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2\n1 1\n3\n1 31 12\n3\n12345 67 84\n9\n1 2 3 4 5 6 7 8 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2\n2\n31680\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"856C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/856/problem/C"}