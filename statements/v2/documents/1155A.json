{"assets":[],"contentKind":"statement","contestId":"1155","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Reverse a Substring"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ consisting of $$$n$$$ lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define a substring as a contiguous subsegment of a string. For example, \""},{"children":[{"kind":"text","text":"acab"}],"kind":"container"},{"kind":"text","text":"\" is a substring of \""},{"children":[{"kind":"text","text":"abacaba"}],"kind":"container"},{"kind":"text","text":"\" (it starts in position $$$3$$$ and ends in position $$$6$$$), but \""},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":"\" aren't substrings of this string. So the substring of the string $$$s$$$ from position $$$l$$$ to position $$$r$$$ is $$$s[l; r] = s_l s_{l + 1} \\dots s_r$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to choose "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" one of the substrings of the given string and reverse it (i. e. make $$$s[l; r] = s_r s_{r - 1} \\dots s_l$$$) to obtain a string that is "},{"children":[{"kind":"text","text":"less"}],"kind":"container"},{"kind":"text","text":" lexicographically. Note that it "},{"children":[{"kind":"text","text":"is not necessary"}],"kind":"container"},{"kind":"text","text":" to obtain the minimum possible string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it is impossible to reverse some substring of the given string to obtain a string that is less, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\". Otherwise print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" and "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" suitable substring."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"String $$$x$$$ is lexicographically less than string $$$y$$$, if either $$$x$$$ is a prefix of $$$y$$$ (and $$$x \\ne y$$$), or there exists such $$$i$$$ ($$$1 \\le i \\le min(|x|, |y|)$$$), that $$$x_i \\lt y_i$$$, and for any $$$j$$$ ($$$1 \\le j \\lt i$$$) $$$x_j = y_j$$$. Here $$$|a|$$$ denotes the length of the string $$$a$$$. The lexicographic comparison of strings is implemented by operator "},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":" in modern programming languages​​."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$n$$$ ($$$2 \\le n \\le 3 \\cdot 10^5$$$) — the length of $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains the string $$$s$$$ of length $$$n$$$ consisting only of lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is impossible to reverse some substring of the given string to obtain a string which is lexicographically "},{"children":[{"kind":"text","text":"less"}],"kind":"container"},{"kind":"text","text":", print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\". Otherwise print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" and two indices $$$l$$$ and $$$r$$$ ($$$1 \\le l \\lt r \\le n$$$) denoting the substring you have to reverse. If there are multiple answers, you can print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\nabacaba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n2 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\naabcfg\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first testcase the resulting string is \""},{"children":[{"kind":"text","text":"aacabba"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1155A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1155/problem/A"}