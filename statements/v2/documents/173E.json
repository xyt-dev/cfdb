{"assets":[],"contentKind":"statement","contestId":"173","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Camping Groups"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A club wants to take its members camping. In order to organize the event better the club directors decided to partition the members into several groups. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Club member "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has a responsibility value "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and an age value "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". A "},{"children":[{"kind":"text","text":"group"}],"kind":"container"},{"kind":"text","text":" is a non-empty subset of club members with one member known as group leader. A group leader should be one of the most responsible members of the group (his responsibility value is not less than responsibility of any other group member) and his age absolute difference with any other group member should not exceed "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some club members are friends and want to be in the same group. They also like their group to be as large as possible. Now you should write a program that answers a series of questions like \"What's the largest size of a group containing club member "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and club member "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"?\". It's possible for "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" to be the group leader."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105, 0 ≤ k ≤ 109"},{"kind":"text","text":") — the number of club members and the age restriction for one group. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains integer numbers "},{"kind":"math_inline","text":"r1, r2, ..., rn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ri ≤ 109"},{"kind":"text","text":") separated by space: "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" denotes the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th club member's responsibility. In the same way there are integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") in the third line: "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" denotes the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th club member's age."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains an integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" denoting the number of questions that you should answer ("},{"kind":"math_inline","text":"1 ≤ q ≤ 105"},{"kind":"text","text":"). The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines describe the questions. Each line contains two space-separated integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ n, xi ≠ yi"},{"kind":"text","text":") — the indices of the club members that should end up in the same group. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each question print the maximum size of the group in a line. If making such a group is impossible print -1 instead."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1\n1 5 4 1 2\n4 4 3 2 2\n4\n5 3\n2 3\n2 5\n4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n3\n-1\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first query the largest group with members 3 and 5 is "},{"kind":"math_inline","text":"{1, 3, 4, 5}"},{"kind":"text","text":" where member 3 is the leader."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second query member 2 should be the leader so the group will be "},{"kind":"math_inline","text":"{1, 2, 3}"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third query the leader of the group should have age 3 so the only leader can be member 3, who is less responsible than member 2. So making a group is impossible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The group for the fourth query is the same as first query."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"173E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/173/problem/E"}