{"assets":[],"contentKind":"statement","contestId":"2092","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Mishkin Energizer"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In anticipation of a duel with his old friend Fernan, Edmond is preparing an energy drink called \""},{"children":[{"kind":"text","text":"Mishkin Energizer"}],"kind":"container"},{"kind":"text","text":"\". The drink consists of a string $$$s$$$ of length $$$n$$$, made up only of the characters "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"I"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":", which correspond to the content of three different substances in the drink."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We call the drink "},{"children":[{"kind":"text","text":"balanced"}],"kind":"container"},{"kind":"text","text":" if it contains an equal number of all substances. To boost his aura and ensure victory in the duel, Edmond must make the initial string balanced by applying the following operation: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Choose an index $$$i$$$ such that $$$s_i \\neq s_{i+1}$$$ (where $$$i + 1$$$ must not exceed the "},{"children":[{"kind":"text","text":"current"}],"kind":"container"},{"kind":"text","text":" size of the string). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Insert a character $$$x$$$, either "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"I"}],"kind":"container"},{"kind":"text","text":", or "},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":", between them such that $$$x \\neq s_i$$$ and $$$x \\neq s_{i+1}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Edmond make the drink balanced and win the duel by performing "},{"children":[{"kind":"text","text":"no more than $$$\\textbf{2n}$$$ operations"}],"kind":"container"},{"kind":"text","text":". If there are multiple solutions, any one of them can be output. If it is impossible, you must report this."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test consists of several test cases. The first line of the input data contains one integer $$$t$$$ ($$$1 \\le t \\le 100$$$) — the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains one integer $$$n$$$ ($$$1 \\le n \\le 100$$$) — the length of the string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$s$$$ of length $$$n$$$, consisting only of the characters "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"I"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output $$$-1$$$ if there is no solution. Otherwise, in the first line, output a single integer $$$m$$$ ($$$0 \\le m \\le 2n$$$) — the number of operations you performed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then the $$$l$$$-th of the following $$$m$$$ lines should contain a single integer $$$i$$$ ($$$1 \\le i \\lt n+l-1$$$), indicating the operation of inserting a character between $$$s_i$$$ and $$$s_{i+1}$$$. It must hold that $$$s_i \\neq s_{i+1}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, any one of them can be output. Note that you do not need to minimize the number of operations in this problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n5\nTILII\n1\nL\n3\nLIT\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1\n2\n3\n4\n-1\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the following sequence of operations can be performed: "},{"children":[{"kind":"text","text":"TILII"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"T"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"ILII"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"TL"},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"ILII"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"TLT"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"ILII"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"TLTL"},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"ILII"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, no operations can be performed, so the answer is $$$-1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, the initial string already has equal quantities of all substances."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"2092D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2092/problem/D"}