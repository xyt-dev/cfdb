{"assets":[],"contentKind":"statement","contestId":"13","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Letter A"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"0.5 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Petya learns how to write. The teacher gave pupils the task to write the letter "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" on the sheet of paper. It is required to check whether Petya really had written the letter "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given three segments on the plane. They form the letter "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" if the following conditions hold:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Two segments have a common endpoint (lets call these segments first and second), while the third segment connects two points on the different segments. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The angle between the first and the second segments is greater than "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and does not exceed "},{"kind":"math_inline","text":"90"},{"kind":"text","text":" degrees. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The third segment divides each of the first two segments in proportion not less than "},{"kind":"math_inline","text":"1 / 4"},{"kind":"text","text":" (i.e. the ratio of the length of the shortest part to the length of the longest part is not less than "},{"kind":"math_inline","text":"1 / 4"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 10000"},{"kind":"text","text":") — the number of test cases to solve. Each case consists of three lines. Each of these three lines contains four space-separated integers — coordinates of the endpoints of one of the segments. All coordinates do not exceed "},{"kind":"math_inline","text":"108"},{"kind":"text","text":" by absolute value. All segments have positive length."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one line for each test case. Print «"},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"» (without quotes), if the segments form the letter "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and «"},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"» otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n4 4 6 0\n4 1 5 2\n4 0 4 4\n0 0 0 6\n0 6 2 -4\n1 1 0 1\n0 0 0 5\n0 5 2 -1\n1 2 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"13B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/13/problem/B"}