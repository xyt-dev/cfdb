{"assets":["/statement-assets/fd796acbfbe9e0c9f243425ea81a020a906bfc8aa674106fc7f1f928bcc05a8e.png"],"contentKind":"statement","contestId":"79","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Security System"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Fox Ciel safely returned to her castle, but there was something wrong with the security system of the castle: sensors attached in the castle were covering her."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ciel is at point "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" of the castle now, and wants to move to point "},{"kind":"math_inline","text":"(n, n)"},{"kind":"text","text":", which is the position of her room. By one step, Ciel can move from point "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" to either "},{"kind":"math_inline","text":"(x + 1, y)"},{"kind":"text","text":" (rightward) or "},{"kind":"math_inline","text":"(x, y + 1)"},{"kind":"text","text":" (upward)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In her castle, "},{"kind":"math_inline","text":"c2"},{"kind":"text","text":" sensors are set at points "},{"kind":"math_inline","text":"(a + i, b + j)"},{"kind":"text","text":" (for every integer "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" such that: "},{"kind":"math_inline","text":"0 ≤ i < c, 0 ≤ j < c"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each sensor has a count value and decreases its count value every time Ciel moves. Initially, the count value of each sensor is "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Every time Ciel moves to point "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":", the count value of a sensor at point "},{"kind":"math_inline","text":"(u, v)"},{"kind":"text","text":" decreases by ("},{"kind":"math_inline","text":"|u - x| + |v - y|"},{"kind":"text","text":"). When the count value of some sensor becomes "},{"children":[{"kind":"text","text":"strictly less than"}],"kind":"container"},{"kind":"math_inline","text":"0"},{"kind":"text","text":", the sensor will catch Ciel as a suspicious individual!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine whether Ciel can move from "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(n, n)"},{"kind":"text","text":" without being caught by a sensor, and if it is possible, output her steps. Assume that Ciel can move to every point even if there is a censor on the point."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line there are five integers "},{"kind":"math_inline","text":"n, t, a, b, c"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2·105, "},{"kind":"math_inline","text":"0 ≤ t ≤ 1014, "},{"kind":"math_inline","text":"1 ≤ a ≤ n - c + 1, "},{"kind":"math_inline","text":"1 ≤ b ≤ n - c + 1, "},{"kind":"math_inline","text":"1 ≤ c ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specificator to read or write 64-bit integers in C++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":" stream (also you may use the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specificator)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If Ciel's objective is possible, output in first line "},{"kind":"math_inline","text":"2n - 2"},{"kind":"text","text":" characters that represent her feasible steps, where "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character is "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":" if "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th step is moving rightward, or "},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":" if moving upward. If there are several solution, output "},{"children":[{"kind":"text","text":"lexicographically first"}],"kind":"container"},{"kind":"text","text":" one. Character "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":" is lexicographically earlier than the character "},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If her objective is impossible, output "},{"children":[{"kind":"text","text":"Impossible"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 25 2 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"RRUURURU\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6 1 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"URUR\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5 1 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Impossible\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"20 492 11 4 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"RRRRRRRRRRRRRRRRUUUUURUUUUURRUUUUUUUUU\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The answers for the first sample and the second sample are shown on the picture: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/fd796acbfbe9e0c9f243425ea81a020a906bfc8aa674106fc7f1f928bcc05a8e.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" Here, a red point represents a point that contains a sensor."}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"79E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/79/problem/E"}