{"assets":["/statement-assets/a2c3459a1b27877f6ef3ae561d5a8d11c114c23eb6a10634c51e67860ad2e113.png"],"contentKind":"statement","contestId":"721","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. One-dimensional Japanese Crossword"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recently Adaltik discovered japanese crosswords. Japanese crossword is a picture, represented as a table sized "},{"kind":"math_inline","text":"a × b"},{"kind":"text","text":" squares, and each square is colored white or black. There are integers to the left of the rows and to the top of the columns, encrypting the corresponding row or column. The number of integers represents how many groups of black squares there are in corresponding row or column, and the integers themselves represents the number of consecutive black squares in corresponding group (you can find more detailed explanation in Wikipedia "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Japanese_crossword"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Japanese_crossword"}],"kind":"link"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Adaltik decided that the general case of japanese crossword is too complicated and drew a row consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" squares (e.g. japanese crossword sized "},{"kind":"math_inline","text":"1 × n"},{"kind":"text","text":"), which he wants to encrypt in the same way as in japanese crossword."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a2c3459a1b27877f6ef3ae561d5a8d11c114c23eb6a10634c51e67860ad2e113.png"},"kind":"image"},{"children":[{"kind":"text","text":"The example of encrypting of a single row of japanese crossword."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Help Adaltik find the numbers encrypting the row he drew."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the length of the row. The second line of the input contains a single string consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"', ('"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' corresponds to black square, '"},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"' — to white square in the row that Adaltik drew)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line should contain a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of integers encrypting the row, e.g. the number of groups of black squares in the row."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line should contain "},{"kind":"math_inline","text":"k"},{"kind":"text","t