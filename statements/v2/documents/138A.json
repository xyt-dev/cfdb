{"assets":[],"contentKind":"statement","contestId":"138","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Literature Lesson"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vera adores poems. All the poems Vera knows are divided into quatrains (groups of four lines) and in each quatrain some lines contain rhymes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's consider that all lines in the poems consist of lowercase Latin letters (without spaces). Letters \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"i"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"u"}],"kind":"container"},{"kind":"text","text":"\" are considered vowels."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two lines rhyme if their suffixes that start from the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th vowels (counting from the end) match. If a line has less than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" vowels, then such line can't rhyme with any other line. For example, if "},{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":", lines "},{"kind":"math_inline","text":"commit"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"hermit"},{"kind":"text","text":" rhyme (the corresponding suffixes equal "},{"kind":"math_inline","text":"it"},{"kind":"text","text":"), and if "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":", they do not rhyme ("},{"kind":"math_inline","text":"ommit ≠ ermit"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Today on a literature lesson Vera learned that quatrains can contain four different schemes of rhymes, namely the following ones (the same letters stand for rhyming lines): "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Clerihew ("},{"kind":"math_inline","text":"aabb"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Alternating ("},{"kind":"math_inline","text":"abab"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Enclosed ("},{"kind":"math_inline","text":"abba"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If all lines of a quatrain pairwise rhyme, then the quatrain can belong to any rhyme scheme (this situation is represented by "},{"kind":"math_inline","text":"aaaa"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If all quatrains of a poem belong to the same rhyme scheme, then we can assume that the whole poem belongs to this rhyme scheme. If in each quatrain all lines pairwise rhyme, then the rhyme scheme of the poem is "},{"kind":"math_inline","text":"aaaa"},{"kind":"text","text":". Let us note that it doesn't matter whether lines from different quatrains rhyme with each other or not. In other words, it is possible that different quatrains aren't connected by a rhyme."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vera got a long poem as a home task. The girl has to analyse it and find the poem rhyme scheme. Help Vera cope with the task."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2500"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 5"},{"kind":"text","text":") — the number of quatrains in the poem and the vowel's number, correspondingly. Next "},{"kind":"math_inline","text":"4n"},{"kind":"text","text":" lines contain the poem. Each line is not empty and only consists of small Latin letters. The total length of the lines does not exceed "},{"kind":"math_inline","text":"104"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If we assume that the lines are numbered starting from 1, then the first quatrain contains lines number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"; the second one contains lines number "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"6"},{"kind":"text","text":", "},{"kind":"math_inline","text":"7"},{"kind":"text","text":", "},{"kind":"math_inline","text":"8"},{"kind":"text","text":"; and so on."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the rhyme scheme of the poem as \""},{"children":[{"kind":"text","text":"aabb"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"aaaa"}],"kind":"container"},{"kind":"text","text":"\"; or \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" if the poem does not belong to any of the above mentioned schemes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\nday\nmay\nsun\nfun\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"aabb\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\nday\nmay\ngray\nway\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"aaaa\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\na\na\na\na\na\na\ne\ne\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"aabb\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\nday\nmay\nsun\nfun\ntest\nhill\nfest\nthrill\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the last sample both quatrains have rhymes but finding the common scheme is impossible, so the answer is \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"138A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/138/problem/A"}