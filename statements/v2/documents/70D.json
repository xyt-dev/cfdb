{"assets":[],"contentKind":"statement","contestId":"70","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Professor's task"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Once a walrus professor Plato asked his programming students to perform the following practical task. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The students had to implement such a data structure that would support a convex hull on some set of points "},{"kind":"math_inline","text":"S"},{"kind":"text","text":". The input to the program had "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries of two types: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1. Add a point with coordinates "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" into the set "},{"kind":"math_inline","text":"S"},{"kind":"text","text":". Note that in this case the convex hull of "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" could have changed, and could have remained the same. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2. Say whether a point with coordinates "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" belongs to an area limited by the convex hull, including the border. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the students coped with the task. What about you?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"4 ≤ q ≤ 105"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines in the following way: \""},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"y"},{"kind":"text","text":"\", where "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is the query type (1 or 2), and "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" are the coordinates of the point ("},{"kind":"math_inline","text":" - 106 ≤ x, y ≤ 106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" are integers). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is at least one query of type 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the three queries of the first type follow first and the points given in the queries form a non-degenerative triangle. Also all the points added in "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the second type print one string containing \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\", if the point lies inside the convex hull or on its border. Otherwise, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n1 0 0\n1 2 0\n1 2 2\n2 1 0\n1 0 2\n2 1 1\n2 2 1\n2 20 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nYES\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"70D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/70/problem/D"}