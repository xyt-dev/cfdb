{"assets":[],"contentKind":"statement","contestId":"1249","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C2. Good Numbers (hard version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"The only difference between easy and hard versions is the maximum value of $$$n$$$"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a positive integer number $$$n$$$. You really love "},{"children":[{"kind":"text","text":"good numbers"}],"kind":"container"},{"kind":"text","text":" so you want to find the smallest "},{"children":[{"kind":"text","text":"good number"}],"kind":"container"},{"kind":"text","text":" greater than or equal to $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The positive integer is called "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if it can be represented as a sum of "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" powers of $$$3$$$ (i.e. no duplicates of powers of $$$3$$$ are allowed)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$30$$$ is a "},{"children":[{"kind":"text","text":"good number"}],"kind":"container"},{"kind":"text","text":": $$$30 = 3^3 + 3^1$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$1$$$ is a "},{"children":[{"kind":"text","text":"good number"}],"kind":"container"},{"kind":"text","text":": $$$1 = 3^0$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$12$$$ is a "},{"children":[{"kind":"text","text":"good number"}],"kind":"container"},{"kind":"text","text":": $$$12 = 3^2 + 3^1$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" but $$$2$$$ is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" a "},{"children":[{"kind":"text","text":"good number"}],"kind":"container"},{"kind":"text","text":": you can't represent it as a sum of distinct powers of $$$3$$$ ($$$2 = 3^0 + 3^0$$$), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$19$$$ is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" a "},{"children":[{"kind":"text","text":"good number"}],"kind":"container"},{"kind":"text","text":": you can't represent it as a sum of distinct powers of $$$3$$$ (for example, the representations $$$19 = 3^2 + 3^2 + 3^0 = 3^2 + 3^1 + 3^1 + 3^1 + 3^0$$$ are invalid), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$20$$$ is also "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" a "},{"children":[{"kind":"text","text":"good number"}],"kind":"container"},{"kind":"text","text":": you can't represent it as a sum of distinct powers of $$$3$$$ (for example, the representation $$$20 = 3^2 + 3^2 + 3^0 + 3^0$$$ is invalid). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note, that there exist other representations of $$$19$$$ and $$$20$$$ as sums of powers of $$$3$$$ but none of them consists of "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" powers of $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the given positive integer $$$n$$$ find such smallest $$$m$$$ ($$$n \\le m$$$) that $$$m$$$ is a "},{"children":[{"kind":"text","text":"good number"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to answer $$$q$$$ independent queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$q$$$ ($$$1 \\le q \\le 500$$$) — the number of queries. Then $$$q$$$ queries follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of the query contains one integer $$$n$$$ ($$$1 \\le n \\le 10^{18}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query, print such smallest integer $$$m$$$ (where $$$n \\le m$$$) that $$$m$$$ is a "},{"children":[{"kind":"text","text":"good number"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n1\n2\n6\n13\n14\n3620\n10000\n1000000000000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n3\n9\n13\n27\n6561\n19683\n1350851717672992089\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C2","problemCode":"1249C2","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1249/problem/C2"}