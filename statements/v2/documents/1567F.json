{"assets":[],"contentKind":"statement","contestId":"1567","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. One-Four Overload"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Alice has an empty grid with $$$n$$$ rows and $$$m$$$ columns. Some of the cells are marked, and "},{"children":[{"kind":"text","text":"no marked cells are adjacent to the edge of the grid"}],"kind":"container"},{"kind":"text","text":". (Two squares are "},{"children":[{"kind":"text","text":"adjacent"}],"kind":"container"},{"kind":"text","text":" if they share a side.) "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Alice wants to fill each cell with a number such that the following statements are true: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" every "},{"children":[{"kind":"text","text":"unmarked"}],"kind":"container"},{"kind":"text","text":" cell contains either the number $$$1$$$ or $$$4$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" every "},{"children":[{"kind":"text","text":"marked"}],"kind":"container"},{"kind":"text","text":" cell contains the sum of the numbers in all "},{"children":[{"kind":"text","text":"unmarked"}],"kind":"container"},{"kind":"text","text":" cells adjacent to it (if a marked cell is not adjacent to any unmarked cell, this sum is $$$0$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" every "},{"children":[{"kind":"text","text":"marked"}],"kind":"container"},{"kind":"text","text":" cell contains a multiple of $$$5$$$. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" Alice couldn't figure it out, so she asks Bob to help her. Help Bob find any such grid, or state that no such grid exists."}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\leq n, m \\leq 500$$$) — the number of rows and the number of columns in the grid, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$n$$$ lines follow, each containing $$$m$$$ characters. Each of these characters is either '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"' — an unmarked and a marked cell, respectively. "},{"children":[{"kind":"text","text":"No marked cells are adjacent to the edge of the grid."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output \"'"},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" if no suitable grid exists. Otherwise, output \"'"},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\"'. Then output $$$n$$$ lines of $$$m$$$ space-separated integers — the integers in the grid."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"hea