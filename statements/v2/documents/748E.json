{"assets":[],"contentKind":"statement","contestId":"748","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Santa Claus and Tangerines"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Santa Claus has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" tangerines, and the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them consists of exactly "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" slices. Santa Claus came to a school which has "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" pupils. Santa decided to treat them with tangerines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, there can be too few tangerines to present at least one tangerine to each pupil. So Santa decided to divide tangerines into parts so that no one will be offended. In order to do this, he can divide a tangerine or any existing part into two smaller equal parts. If the number of slices in the part he wants to split is odd, then one of the resulting parts will have one slice more than the other. It's forbidden to divide a part consisting of only one slice."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Santa Claus wants to present to everyone either a whole tangerine or exactly one part of it"}],"kind":"container"},{"kind":"text","text":" (that also means that everyone must get a positive number of slices). One or several tangerines or their parts may stay with Santa."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" be the number of slices the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th pupil has in the end. Let Santa's "},{"children":[{"kind":"text","text":"joy"}],"kind":"container"},{"kind":"text","text":" be the minimum among all "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":"'s."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the maximum possible "},{"children":[{"kind":"text","text":"joy"}],"kind":"container"},{"kind":"text","text":" Santa can have after he treats everyone with tangerines (or their parts)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 2·109"},{"kind":"text","text":") denoting the number of tangerines and the number of pupils, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 107"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" stands for the number of slices the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th tangerine consists of."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there's no way to present a tangerine or a part of tangerine to everyone, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". Otherwise, print the maximum possible "},{"children":[{"kind":"text","text":"joy"}],"kind":"container"},{"kind":"text","text":" that Santa can have."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n5 9 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4\n12 14\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Santa should divide the second tangerine into two parts with "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" slices. After that he can present the part with "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" slices to the first pupil and the whole first tangerine (with "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" slices, too) to the second pupil."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example Santa should divide both tangerines, so that he'll be able to present two parts with "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" slices and two parts with "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" slices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example Santa Claus can't present "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" slices to "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" pupils in such a way that everyone will have anything."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"748E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/748/problem/E"}