{"assets":[],"contentKind":"statement","contestId":"1692","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. The Clock"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Victor has a "},{"attrs":{"href":"https://en.wikipedia.org/wiki/24-hour_clock"},"children":[{"kind":"text","text":"24-hour clock"}],"kind":"link"},{"kind":"text","text":" that shows the time in the format \""},{"children":[{"kind":"text","text":"HH:MM"}],"kind":"container"},{"kind":"text","text":"\" ("},{"children":[{"kind":"text","text":"00"}],"kind":"container"},{"kind":"text","text":" $$$\\le$$$ "},{"children":[{"kind":"text","text":"HH"}],"kind":"container"},{"kind":"text","text":" $$$\\le$$$ "},{"children":[{"kind":"text","text":"23"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"00"}],"kind":"container"},{"kind":"text","text":" $$$\\le$$$ "},{"children":[{"kind":"text","text":"MM"}],"kind":"container"},{"kind":"text","text":" $$$\\le$$$ "},{"children":[{"kind":"text","text":"59"}],"kind":"container"},{"kind":"text","text":"). He looks at the clock every $$$x$$$ minutes, and the clock is currently showing time $$$s$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How many "},{"children":[{"kind":"text","text":"different"}],"kind":"container"},{"kind":"text","text":" palindromes will Victor see in total after looking at the clock every $$$x$$$ minutes, the first time being at time $$$s$$$?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if the clock starts out as "},{"children":[{"kind":"text","text":"03:12"}],"kind":"container"},{"kind":"text","text":" and Victor looks at the clock every $$$360$$$ minutes (i.e. every $$$6$$$ hours), then he will see the times "},{"children":[{"kind":"text","text":"03:12"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"09:12"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"15:12"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"21:12"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"03:12"}],"kind":"container"},{"kind":"text","text":", and the times will continue to repeat. Here the time "},{"children":[{"kind":"text","text":"21:12"}],"kind":"container"},{"kind":"text","text":" is the only palindrome he will ever see, so the answer is $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A palindrome is a string that reads the same backward as forward. For example, the times "},{"children":[{"kind":"text","text":"12:21"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"05:50"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"11:11"}],"kind":"container"},{"kind":"text","text":" are palindromes but "},{"children":[{"kind":"text","text":"13:13"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"22:10"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"02:22"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer $$$t$$$ ($$$1 \\leq t \\leq 100$$$) — the number of test cases. The description of each test case follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a string $$$s$$$ of length $$$5$$$ with the format \""},{"children":[{"kind":"text","text":"HH:MM"}],"kind":"container"},{"kind":"text","text":"\" where \""},{"children":[{"kind":"text","text":"HH"}],"kind":"container"},{"kind":"text","text":"\" is from \""},{"children":[{"kind":"text","text":"00"}],"kind":"container"},{"kind":"text","text":"\" to \""},{"children":[{"kind":"text","text":"23"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"MM"}],"kind":"container"},{"kind":"text","text":"\" is from \""},{"children":[{"kind":"text","text":"00"}],"kind":"container"},{"kind":"text","text":"\" to \""},{"children":[{"kind":"text","text":"59"}],"kind":"container"},{"kind":"text","text":"\" (both \""},{"children":[{"kind":"text","text":"HH"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"MM"}],"kind":"container"},{"kind":"text","text":"\" have exactly two digits) and an integer $$$x$$$ ($$$1 \\leq x \\leq 1440$$$) — the number of minutes Victor takes to look again at the clock."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the number of different palindromes Victor will see if he looks at the clock every $$$x$$$ minutes starting from time $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n03:12 360\n00:00 1\n13:22 2\n15:15 10\n11:11 1440\n22:30 27\n"}],"kind":"section"},{