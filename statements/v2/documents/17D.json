{"assets":[],"contentKind":"statement","contestId":"17","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Notepad"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Nick is attracted by everything unconventional. He doesn't like decimal number system any more, and he decided to study other number systems. A number system with base "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" caught his attention. Before he starts studying it, he wants to write in his notepad all the numbers of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" without leading zeros in this number system. Each page in Nick's notepad has enough space for "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" numbers exactly. Nick writes every suitable number only once, starting with the first clean page and leaving no clean spaces. Nick never writes number "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" as he has unpleasant memories about zero divide."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Would you help Nick find out how many numbers will be written on the last page."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only input line contains three space-separated integers "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ b < 10106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ n < 10106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ c ≤ 109"},{"kind":"text","text":"). You may consider that Nick has infinite patience, endless amount of paper and representations of digits as characters. The numbers doesn't contain leading zeros."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line output the amount of numbers written on the same page as the last number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In both samples there are exactly "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" numbers of length "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" in binary number system. In the first sample Nick writes "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" numbers on the first page and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" on the second page. In the second sample all the "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" numbers can be written on the first page."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"17D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/17/problem/D"}