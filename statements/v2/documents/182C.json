{"assets":["/statement-assets/9a5eda4feb9767181886f1664e4e767eb961015134b056414c8129caecc9673b.png","/statement-assets/447933c95c99f463d27e27f5d9fbe19a618b35a764b22332204150ee037a973f.png"],"contentKind":"statement","contestId":"182","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Optimal Sum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"And here goes another problem on arrays. You are given positive integer "},{"kind":"math_inline","text":"len"},{"kind":"text","text":" and array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" which consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"text","text":". Let's introduce two characteristics for the given array."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Let's consider an arbitrary interval of the array with length "},{"kind":"math_inline","text":"len"},{"kind":"text","text":", starting in position "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". Value "},{"attrs":{"alt":"","src":"/statement-assets/9a5eda4feb9767181886f1664e4e767eb961015134b056414c8129caecc9673b.png"},"kind":"image"},{"kind":"text","text":", is the "},{"children":[{"kind":"text","text":"modular sum"}],"kind":"container"},{"kind":"text","text":" on the chosen interval. In other words, the modular sum is the sum of integers on the chosen interval with length "},{"kind":"math_inline","text":"len"},{"kind":"text","text":", taken in its absolute value."}],"kind":"list_item"},{"children":[{"kind":"text","text":" Value "},{"attrs":{"alt":"","src":"/statement-assets/447933c95c99f463d27e27f5d9fbe19a618b35a764b22332204150ee037a973f.png"},"kind":"image"},{"kind":"text","text":" is the "},{"children":[{"kind":"text","text":"optimal sum"}],"kind":"container"},{"kind":"text","text":" of the array. In other words, the optimal sum of an array is the maximum of all modular sums on various intervals of array with length "},{"kind":"math_inline","text":"len"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is to calculate the optimal sum of the given array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". However, before you do the calculations, you are allowed to produce "},{"children":[{"kind":"text","text":"no more"}],"kind":"container"},{"kind":"text","text":" than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" consecutive operations of the following form with this array: one operation means taking an arbitrary number from array "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and multiply it by -1. In other words, no more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" times you are allowed to take an arbitrary number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" from the array and replace it with "},{"kind":"math_inline","text":" - ai"},{"kind":"text","text":". Each number of the array is allowed to choose an arbitrary number of times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to calculate the maximum possible optimal sum of the array after at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" operations described above are completed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"len"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ len ≤ n ≤ 105"},{"kind":"text","text":") — the number of elements in the array and the length of the chosen subinterval of the array, correspondingly. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"math_inline","text":"(|ai| ≤ 109)"},{"kind":"text","text":" — the original array. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ k ≤ n"},{"kind":"text","text":") — the maximum allowed number of operations. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All numbers in lines are separated by a single space."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print the maximum possible optimal sum after no more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" acceptable operations are fulfilled. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n0 -2 3 -5 1\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n1 -3 -10 4 1\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n-2 -5 4\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"182C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/182/problem/C"}