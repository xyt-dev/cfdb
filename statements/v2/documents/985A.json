{"assets":["/statement-assets/7881a7507b1455e1eeccbaf09616abc04ee2f6dbd7de0866a194155a07e2b963.png","/statement-assets/f7fcca62b9af54bd680029cef6b4134b7a48f78411c9f981a63eb0118b6a4ffb.png","/statement-assets/bcb7656c8b21a021ec1886f377cc66c3b5cdbbce3dc2385123abea22d66bf512.png","/statement-assets/055a7eeda7751b95e245d683ec02b7dd2627af66b861fc29af3802497cfd827a.png","/statement-assets/f13d8cfd5057fe9bf01a676fb44849c9a1690c1c13fbc8052b1242c3bcc60c4c.png","/statement-assets/598b8c8e1923fce28ce1ec72fe7c4d6b01f6cc9b6ed8a184e910ea6038837781.png"],"contentKind":"statement","contestId":"985","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Chess Placing"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a chessboard of size "},{"kind":"math_inline","text":"1 × n"},{"kind":"text","text":". It is guaranteed that "},{"children":[{"kind":"math_inline","text":"n"},{"kind":"text","text":" is even"}],"kind":"container"},{"kind":"text","text":". The chessboard is painted like this: \""},{"children":[{"kind":"text","text":"BWBW"}],"kind":"container"},{"kind":"math_inline","text":"..."},{"children":[{"kind":"text","text":"BW"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some cells of the board are occupied by the chess pieces. Each cell contains no more than one chess piece. It is known that the total number of pieces equals to "},{"attrs":{"alt":"","src":"/statement-assets/7881a7507b1455e1eeccbaf09616abc04ee2f6dbd7de0866a194155a07e2b963.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one step you can move one of the pieces one cell to the left or to the right. You cannot move pieces beyond the borders of the board. You also cannot move pieces to the cells that are already occupied."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to place all the pieces in the cells of the same color "},{"children":[{"kind":"text","text":"using the minimum number of moves"}],"kind":"container"},{"kind":"text","text":" (all the pieces must occupy only the black cells or only the white cells after all the moves are made)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100"},{"kind":"text","text":", "},{"children":[{"kind":"math_inline","text":"n"},{"kind":"text","text":" is even"}],"kind":"container"},{"kind":"text","text":") — the size of the chessboard. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains "},{"attrs":{"alt":"","src":"/statement-assets/7881a7507b1455e1eeccbaf09616abc04ee2f6dbd7de0866a194155a07e2b963.png"},"kind":"image"},{"kind":"text","text":" integer numbers "},{"attrs":{"alt":"","src":"/statement-assets/f7fcca62b9af54bd680029cef6b4134b7a48f78411c9f981a63eb0118b6a4ffb.png"},"kind":"image"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":") — initial positions of the pieces. It is guaranteed that all the positions are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — "},{"children":[{"kind":"text","text":"the minimum number of moves"}],"kind":"container"},{"kind":"text","text":" you have to make to place all the pieces in the cells of the same color."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 2 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n1 2 3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the only possible strategy is to move the piece at the position "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" to the position "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" and move the piece at the position "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to the position "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". Notice that if you decide to place the pieces in the white cells the minimum number of moves will be "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the possible strategy is to move "},{"attrs":{"alt":"","src":"/statement-assets/bcb7656c8b21a021ec1886f377cc66c3b5cdbbce3dc2385123abea22d66bf512.png"},"kind":"image"},{"kind":"text","text":" in 4 moves, then "},{"attrs":{"alt":"","src":"/statement-assets/055a7eeda7751b95e245d683ec02b7dd2627af66b861fc29af3802497cfd827a.png"},"kind":"image"},{"kind":"text","text":" in 3 moves, "},{"attrs":{"alt":"","src":"/statement-assets/f13d8cfd5057fe9bf01a676fb44849c9a1690c1c13fbc8052b1242c3bcc60c4c.png"},"kind":"image"},{"kind":"text","text":" in 2 moves and "},{"attrs":{"alt":"","src":"/statement-assets/598b8c8e1923fce28ce1ec72fe7c4d6b01f6cc9b6ed8a184e910ea6038837781.png"},"kind":"image"},{"kind":"text","text":" in 1 move."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"985A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/985/problem/A"}