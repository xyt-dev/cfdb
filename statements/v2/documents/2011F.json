{"assets":[],"contentKind":"statement","contestId":"2011","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Good Subarray"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an integer array $$$a$$$ of size $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call an array "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if it can be obtained using the following algorithm: create an array consisting of any single integer; and then perform the following operation an arbitrary number of times: choose an element from the already existing array (let's call it $$$x$$$) and add $$$x$$$, $$$(x-1)$$$, or $$$(x+1)$$$ to the end of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the arrays $$$[1, 2, 1]$$$, $$$[5]$$$ and $$$[3, 2, 1, 4]$$$ are good, while $$$[2, 4]$$$ and $$$[3, 1, 2]$$$ are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to count the number of good "},{"children":[{"kind":"text","text":"contiguous"}],"kind":"container"},{"kind":"text","text":" subarrays of the array $$$a$$$. Two subarrays that have the same elements but are in different positions of the array $$$a$$$ are considered different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 3 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$ 1 \\le a_i \\le n)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraint on the input: the sum of $$$n$$$ over all test cases does not exceed $$$3 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single integer — the number of good "},{"children":[{"kind":"text","text":"contiguous"}],"kind":"container"},{"kind":"text","text":" subarrays of the array $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n3\n1 1 3\n4\n3 2 3 1\n1\n1\n8\n4 5 6 5 3 2 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n9\n1\n23\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the following four subarrays are good:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" from the $$$1$$$-st to the $$$1$$$-st element; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" from the $$$1$$$-st to the $$$2$$$-nd element; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" from the $$$2$$$-nd to the $$$2$$$-nd element; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" from the $$$3$$$-rd to the $$$3$$$-rd element. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second example, the only subarray which is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" good is the subarray from the $$$3$$$-rd element to the $$$4$$$-th element."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"2011F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2011/problem/F"}