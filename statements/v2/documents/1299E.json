{"assets":[],"contentKind":"statement","contestId":"1299","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. So Mean"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This problem is interactive"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We have hidden a permutation $$$p_1, p_2, \\dots, p_n$$$ of numbers from $$$1$$$ to $$$n$$$ from you, where $$$n$$$ "},{"children":[{"kind":"text","text":"is even"}],"kind":"container"},{"kind":"text","text":". You can try to guess it using the following queries:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$?$$$ $$$k$$$ $$$a_1$$$ $$$a_2$$$ $$$\\dots$$$ $$$a_k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In response, you will learn if the average of elements with indexes $$$a_1, a_2, \\dots, a_k$$$ is an integer. In other words, you will receive $$$1$$$ if $$$\\frac{p_{a_1} + p_{a_2} + \\dots + p_{a_k}}{k}$$$ is integer, and $$$0$$$ otherwise. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to guess the permutation. You can ask "},{"children":[{"kind":"text","text":"not more than $$$18n$$$ queries"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that permutations $$$[p_1, p_2, \\dots, p_k]$$$ and $$$[n + 1 - p_1, n + 1 - p_2, \\dots, n + 1 - p_k]$$$ are indistinguishable. Therefore, "},{"children":[{"kind":"text","text":"you are guaranteed that $$$p_1 \\le \\frac{n}{2}$$$"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the permutation $$$p$$$ is fixed before the start of the interaction and doesn't depend on your queries. In other words, "},{"children":[{"kind":"text","text":"interactor is not adaptive"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that you don't have to minimize the number of queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$2 \\le n \\le 800$$$, $$$n$$$ "},{"children":[{"kind":"text","text":"is even"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom","title":"Interaction"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Interaction"}],"kind":"heading"},{"children":[{"kind":"text","text":"You begin the interaction by reading $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To ask a question about elements on positions $$$a_1, a_2, \\dots, a_k$$$, in a separate line output"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$?$$$ $$$k$$$ $$$a_1$$$ $$$a_2$$$ ... $$$a_k$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Numbers in the query have to satisfy $$$1 \\le a_i \\le n$$$, and all $$$a_i$$$ have to be different. Don't forget to 'flush', to get the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In response, you will receive $$$1$$$ if $$$\\frac{p_{a_1} + p_{a_2} + \\dots + p_{a_k}}{k}$$$ is integer, and $$$0$$$ otherwise. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In case your query is invalid or you asked more than $$$18n$$$ queries, the program will print $$$-1$$$ and will finish interaction. You will receive a "},{"children":[{"kind":"text","text":"Wrong answer"}],"kind":"container"},{"kind":"text","text":" verdict. Make sure to exit immediately to avoid getting other verdicts."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When you determine permutation, output "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$!$$$ $$$p_1$$$ $$$p_2$$$ ... $$$p_n$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After printing a query do not forget to output end of line and flush the output. Otherwise, you will get "},{"children":[{"kind":"text","text":"Idleness limit exceeded"}],"kind":"container"},{"kind":"text","text":". To do this, use:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"fflush(stdout)"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"cout.flush()"}],"kind":"container"},{"kind":"text","text":" in C++;"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"System.out.flush()"}],"kind":"container"},{"kind":"text","text":" in Java;"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"flush(output)"}],"kind":"container"},{"kind":"text","text":" in Pascal;"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"stdout.flush()"}],"kind":"container"},{"kind":"text","text":" in Python;"}],"kind":"list_item"},{"children":[{"kind":"text","text":" see documentation for other languages."}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"Hack format"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the hacks use the following format:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line has to contain a single integer $$$n$$$ ($$$2 \\le n \\le 800$$$, $$$n$$$ "},{"children":[{"kind":"text","text":"is even"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next line output $$$n$$$ integers $$$p_1, p_2, \\dots, p_n$$$ — the valid permutation of numbers from $$$1$$$ to $$$n$$$. $$$p_1 \\le \\frac{n}{2}$$$ must hold."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n? 1 2\n? 1 1\n! 1 2 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1299E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1299/problem/E"}