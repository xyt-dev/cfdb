{"assets":[],"contentKind":"statement","contestId":"794","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Labelling Cities"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Oleg the bank client lives in Bankopolia. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities in Bankopolia and some pair of cities are connected directly by bi-directional roads. The cities are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". There are a total of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" roads in Bankopolia, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road connects cities "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":". It is guaranteed that from each city it is possible to travel to any other city using some of the roads."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Oleg wants to give a label to each city. Suppose the label of city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". Then, it must hold that for all pairs of cities "},{"kind":"math_inline","text":"(u, v)"},{"kind":"text","text":" the condition "},{"kind":"math_inline","text":"|xu - xv| ≤ 1"},{"kind":"text","text":" holds if and only if there is a road connecting "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Oleg wonders if such a labeling is possible. Find an example of such labeling if the task is possible and state that it is impossible otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 3·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 3·105"},{"kind":"text","text":") — the number of cities and the number of roads."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next, "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follow. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two space-separated integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ui ≠ vi"},{"kind":"text","text":") — the cities connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road. It is guaranteed that there is at most one road between each pair of cities and it is possible to travel from any city to any other city using some roads."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the required labeling is not possible, output a single line containing the string \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, output the string \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) on the first line. On the next line, output "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers, "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":". The condition "},{"kind":"math_inline","text":"1 ≤ xi ≤ 109"},{"kind":"text","text":" must hold for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", and for all pairs of cities "},{"kind":"math_inline","text":"(u, v)"},{"kind":"text","text":" the condition "},{"kind":"math_inline","text":"|xu - xv| ≤ 1"},{"kind":"text","text":" must hold if and only if there is a road connecting "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n1 2\n1 3\n1 4\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n2 3 1 1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 10\n1 2\n1 3\n1 4\n1 5\n2 3\n2 4\n2 5\n3 4\n3 5\n5 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1 1 1 1 1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n1 2\n1 3\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample, "},{"kind":"math_inline","text":"x1 = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2 = 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x3 = x4 = 1"},{"kind":"text","text":" is a valid labeling. Indeed, "},{"kind":"math_inline","text":"(3, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 4)"},{"kind":"text","text":" are the only pairs of cities with difference of labels not greater than "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", and these are precisely the roads of Bankopolia."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second sample, all pairs of cities have difference of labels not greater than "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and all pairs of cities have a road connecting them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the last sample, it is impossible to construct a labeling satisfying the given constraints."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"794D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/794/problem/D"}