{"assets":[],"contentKind":"statement","contestId":"386","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Game with Points"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are playing the following game. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" points on a plane. They are the vertices of a regular "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-polygon. Points are labeled with integer numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Each pair of distinct points is connected by a diagonal, which is colored in one of 26 colors. Points are denoted by lowercase English letters. There are three stones positioned on three distinct vertices. All stones are the same. With one move you can move the stone to another free vertex along some diagonal. The color of this diagonal must be the same as the color of the diagonal, connecting another two stones. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your goal is to move stones in such way that the only vertices occupied by stones are "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". You must achieve such position using minimal number of moves. Write a program which plays this game in an optimal way."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line there is one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 70"},{"kind":"text","text":") — the number of points. In the second line there are three space-separated integer from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — numbers of vertices, where stones are initially located."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" symbols — the matrix denoting the colors of the diagonals. Colors are denoted by lowercase English letters. The symbol "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" of line "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" denotes the color of diagonal between points "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":". Matrix is symmetric, so "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th symbol of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line is equal to "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th symbol of "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th line. Main diagonal is filled with '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"' symbols because there is no diagonal, connecting point to itself."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no way to put stones on vertices "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" on a single line. Otherwise, on the first line print minimal required number of moves and in the next lines print the description of each move, one move per line. To describe a move print two integers. The point from which to remove the stone, and the point to which move the stone. If there are several optimal solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 3 4\n*aba\na*ab\nba*b\nabb*\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n4 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 3 4\n*abc\na*ab\nba*b\ncbb*\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example we can move stone from point "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" to point "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" because this points are connected by the diagonal of color '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and the diagonal connection point "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", where the other stones are located, are connected by the diagonal of the same color. After that stones will be on the points "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"386D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/386/problem/D"}