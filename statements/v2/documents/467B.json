{"assets":[],"contentKind":"statement","contestId":"467","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Fedor and New Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After you had helped George and Alex to move in the dorm, they went to help their friend Fedor play a new computer game «Call of Soldiers 3»."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The game has "},{"kind":"math_inline","text":"(m + 1)"},{"kind":"text","text":" players and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" types of soldiers in total. Players «Call of Soldiers 3» are numbered form "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(m + 1)"},{"kind":"text","text":". Types of soldiers are numbered from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":". Each player has an army. Army of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th player can be described by non-negative integer "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". Consider binary representation of "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":": if the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th bit of number "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" equal to one, then the army of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th player has soldiers of the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th type. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Fedor is the "},{"kind":"math_inline","text":"(m + 1)"},{"kind":"text","text":"-th player of the game. He assume that two players can become friends if their armies differ in at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" types of soldiers (in other words, binary representations of the corresponding numbers differ in at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" bits). Help Fedor and count how many players can become his friends."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ k ≤ n ≤ 20; 1 ≤ m ≤ 1000)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the next "},{"kind":"math_inline","text":"(m + 1)"},{"kind":"text","text":" lines contains a single integer "},{"kind":"math_inline","text":"xi"},{"kind":"math_inline","text":"(1 ≤ xi ≤ 2n - 1)"},{"kind":"text","text":", that describes the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th player's army. We remind you that Fedor is the "},{"kind":"math_inline","text":"(m + 1)"},{"kind":"text","text":"-th player."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of Fedor's potential friends."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 3 1\n8\n5\n111\n17\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 3\n1\n2\n3\n4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"467B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/467/problem/B"}