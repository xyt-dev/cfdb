{"assets":[],"contentKind":"statement","contestId":"638","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Three-dimensional Turtle Super Computer "}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A super computer has been built in the Turtle Academy of Sciences. The computer consists of "},{"kind":"math_inline","text":"n·m·k"},{"kind":"text","text":" CPUs. The architecture was the paralellepiped of size "},{"kind":"math_inline","text":"n × m × k"},{"kind":"text","text":", split into "},{"kind":"math_inline","text":"1 × 1 × 1"},{"kind":"text","text":" cells, each cell contains exactly one CPU. Thus, each CPU can be simultaneously identified as a group of three numbers from the layer number from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", the line number from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and the column number from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the process of the Super Computer's work the CPUs can send each other messages by the famous turtle scheme: CPU "},{"kind":"math_inline","text":"(x, y, z)"},{"kind":"text","text":" can send messages to CPUs "},{"kind":"math_inline","text":"(x + 1, y, z)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x, y + 1, z)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(x, y, z + 1)"},{"kind":"text","text":" (of course, if they exist), there is no feedback, that is, CPUs "},{"kind":"math_inline","text":"(x + 1, y, z)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x, y + 1, z)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(x, y, z + 1)"},{"kind":"text","text":" cannot send messages to CPU "},{"kind":"math_inline","text":"(x, y, z)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Over time some CPUs broke down and stopped working. Such CPUs cannot send messages, receive messages or serve as intermediates in transmitting messages. We will say that CPU "},{"kind":"math_inline","text":"(a, b, c)"},{"children":[{"kind":"text","text":"controls"}],"kind":"container"},{"kind":"text","text":" CPU "},{"kind":"math_inline","text":"(d, e, f)"},{"kind":"text","text":" , if there is a chain of CPUs "},{"kind":"math_inline","text":"(xi, yi, zi)"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"(x1 = a, y1 = b, z1 = c)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(xp = d, yp = e, zp = f)"},{"kind":"text","text":" (here and below "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is the length of the chain) and the CPU in the chain with number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"i < p"},{"kind":"text","text":") can send messages to CPU "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Turtles are quite concerned about the denial-proofness of the system of communication between the remaining CPUs. For that they want to know the number of critical CPUs. A CPU "},{"kind":"math_inline","text":"(x, y, z)"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"critical"}],"kind":"container"},{"kind":"text","text":", if turning it off will disrupt some control, that is, if there are two distinctive from "},{"kind":"math_inline","text":"(x, y, z)"},{"kind":"text","text":" CPUs: "},{"kind":"math_inline","text":"(a, b, c)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(d, e, f)"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"(a, b, c)"},{"kind":"text","text":" controls "},{"kind":"math_inline","text":"(d, e, f)"},{"kind":"text","text":" before "},{"kind":"math_inline","text":"(x, y, z)"},{"kind":"text","text":" is turned off and stopped controlling it after the turning off."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m, k ≤ 100"},{"kind":"text","text":") — the dimensions of the Super Computer. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" blocks follow, describing the current state of the processes. The blocks correspond to the layers of the Super Computer in the order from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Each block consists of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines, "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" characters in each — the description of a layer in the format of an "},{"kind":"math_inline","text":"m × k"},{"kind":"text","text":" table. Thus, the state of the CPU "},{"kind":"math_inline","text":"(x, y, z)"},{"kind":"text","text":" is corresponded to the "},{"kind":"math_inline","text":"z"},{"kind":"text","text":"-th character of the "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"-th line of the block number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". Character \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" corresponds to a working CPU and character \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" corresponds to a malfunctioning one. The blocks are separated by exactly one empty line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of critical CPUs, that is, such that turning only this CPU off will disrupt some control."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 3\n000\n000\n\n111\n111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 3\n111\n111\n111\n\n111\n111\n111\n\n111\n111\n111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"19\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 10\n0101010101\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the whole first layer of CPUs is malfunctional. In the second layer when CPU "},{"kind":"math_inline","text":"(2, 1, 2)"},{"kind":"text","text":" turns off, it disrupts the control by CPU "},{"kind":"math_inline","text":"(2, 1, 3)"},{"kind":"text","text":" over CPU "},{"kind":"math_inline","text":"(2, 1, 1)"},{"kind":"text","text":", and when CPU "},{"kind":"math_inline","text":"(2, 2, 2)"},{"kind":"text","text":" is turned off, it disrupts the control over CPU "},{"kind":"math_inline","text":"(2, 2, 3)"},{"kind":"text","text":" by CPU "},{"kind":"math_inline","text":"(2, 2, 1)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample all processors except for the corner ones are critical."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample there is not a single processor controlling another processor, so the answer is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"638D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/638/problem/D"}