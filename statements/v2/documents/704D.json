{"assets":[],"contentKind":"statement","contestId":"704","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Captain America"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Steve Rogers is fascinated with new vibranium shields S.H.I.E.L.D gave him. They're all uncolored. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" shields in total, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th shield is located at point "},{"kind":"math_inline","text":"(xi, yi)"},{"kind":"text","text":" of the coordinate plane. It's possible that two or more shields share the same location."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Steve wants to paint all these shields. He paints each shield in either red or blue. Painting a shield in red costs "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" dollars while painting it in blue costs "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" dollars."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additionally, there are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" constraints Steve wants to be satisfied. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th constraint is provided by three integers "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"di"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"ti = 1"},{"kind":"text","text":", then the absolute difference between the number of red and blue shields on line "},{"kind":"math_inline","text":"x = li"},{"kind":"text","text":" should not exceed "},{"kind":"math_inline","text":"di"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"ti = 2"},{"kind":"text","text":", then the absolute difference between the number of red and blue shields on line "},{"kind":"math_inline","text":"y = li"},{"kind":"text","text":" should not exceed "},{"kind":"math_inline","text":"di"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Steve gave you the task of finding the painting that satisfies all the condition and the total cost is minimum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100 000"},{"kind":"text","text":") — the number of shields and the number of constraints respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains two integers "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ r, b ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the shields coordinates. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the constrains. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th of these lines contains three integers "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":", "},{"kind":"math_inline","text":"lj"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"dj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ tj ≤ 2, 1 ≤ lj ≤ 109, 0 ≤ dj ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If satisfying all the constraints is impossible print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" in first and only line of the output."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print the minimum total cost in the first line of output. In the second line print a string of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" consisting of letters '"},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' only. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character should be '"},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"' if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th shield should be painted red in the optimal answer and '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' if it should be painted blue. The cost of painting shields in these colors should be equal the minimum cost you printed on the first line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there exist more than one optimal solution, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6\n8 3\n2 10\n1 5\n9 10\n9 10\n2 8\n1 9 1\n1 2 1\n2 10 3\n2 10 2\n1 1 1\n2 5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"25\nrbrbb\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n7 3\n10 3\n9 8\n10 3\n2 8\n2 8 0\n2 8 0\n1 2 0\n1 9 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"704D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/704/problem/D"}