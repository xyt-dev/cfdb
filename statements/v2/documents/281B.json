{"assets":["/statement-assets/3c80e524e2b2c4f7c5fbf67937404409843214d81604b3865c4cbf6cf97dcf3f.png","/statement-assets/42249662e79c5e8330814f20cf7e7dbc463dbb70101508fd4b48edd2554abbef.png"],"contentKind":"statement","contestId":"281","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Nearest Fraction"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given three positive integers "},{"kind":"math_inline","text":"x, y, n"},{"kind":"text","text":". Your task is to find the nearest fraction to fraction "},{"attrs":{"alt":"","src":"/statement-assets/3c80e524e2b2c4f7c5fbf67937404409843214d81604b3865c4cbf6cf97dcf3f.png"},"kind":"image"},{"kind":"text","text":" whose denominator is no more than "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, you should find such pair of integers "},{"kind":"math_inline","text":"a, b"},{"kind":"math_inline","text":"(1 ≤ b ≤ n; 0 ≤ a)"},{"kind":"text","text":" that the value "},{"attrs":{"alt":"","src":"/statement-assets/42249662e79c5e8330814f20cf7e7dbc463dbb70101508fd4b48edd2554abbef.png"},"kind":"image"},{"kind":"text","text":" is as minimal as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple \"nearest\" fractions, choose the one with the minimum denominator. If there are multiple \"nearest\" fractions with the minimum denominator, choose the one with the minimum numerator."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line contains three integers "},{"kind":"math_inline","text":"x, y, n"},{"kind":"math_inline","text":"(1 ≤ x, y, n ≤ 105)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the required fraction in the format \""},{"kind":"math_inline","text":"a"},{"kind":"text","text":"/"},{"kind":"math_inline","text":"b"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 7 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2/5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7/2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"281B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/281/problem/B"}