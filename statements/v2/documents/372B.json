{"assets":["/statement-assets/a27e92e893224bd5f72abf55285f771d1b4e9967c9a4009e1a7905becc44f62d.png"],"contentKind":"statement","contestId":"372","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Counting Rectangles is Fun"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" rectangular grid, each cell of the grid contains a single integer: zero or one. Let's call the cell on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column as "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define a \"rectangle\" as four integers "},{"kind":"math_inline","text":"a, b, c, d"},{"kind":"math_inline","text":"(1 ≤ a ≤ c ≤ n; 1 ≤ b ≤ d ≤ m)"},{"kind":"text","text":". Rectangle denotes a set of cells of the grid "},{"kind":"math_inline","text":"{(x, y) :  a ≤ x ≤ c, b ≤ y ≤ d}"},{"kind":"text","text":". Let's define a \"good rectangle\" as a rectangle that includes only the cells with zeros."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You should answer the following "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries: calculate the number of good rectangles all of which cells are in the given rectangle."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"There are three integers in the first line: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 40, 1 ≤ q ≤ 3·105"},{"kind":"text","text":"). Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters — the grid. Consider grid rows are numbered from top to bottom, and grid columns are numbered from left to right. Both columns and rows are numbered starting from 1. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains a query — four integers that describe the current rectangle, "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", "},{"kind":"math_inline","text":"d"},{"kind":"math_inline","text":"(1 ≤ a ≤ c ≤ n; 1 ≤ b ≤ d ≤ m)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query output an answer — a single integer in a separate line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5 5\n00101\n00000\n00001\n01000\n00001\n1 2 2 4\n4 5 4 5\n1 2 5 2\n2 2 4 5\n4 2 5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n1\n7\n34\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 7 5\n0000100\n0000010\n0011000\n0000000\n1 7 2 7\n3 1 3 1\n2 3 4 5\n1 2 2 7\n2 2 4 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1\n16\n27\n52\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first example, there is a "},{"kind":"math_inline","text":"5 × 5"},{"kind":"text","text":" rectangular grid, and the first, the second, and the third queries are represented in the following image."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a27e92e893224bd5f72abf55285f771d1b4e9967c9a4009e1a7905becc44f62d.png"},"kind":"image"}],"kind":"container"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" For the first query, there are "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" good rectangles, five "},{"kind":"math_inline","text":"1 × 1"},{"kind":"text","text":", two "},{"kind":"math_inline","text":"2 × 1"},{"kind":"text","text":", two "},{"kind":"math_inline","text":"1 × 2"},{"kind":"text","text":", and one "},{"kind":"math_inline","text":"1 × 3"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For the second query, there is only one "},{"kind":"math_inline","text":"1 × 1"},{"kind":"text","text":" good rectangle. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For the third query, there are "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" good rectangles, four "},{"kind":"math_inline","text":"1 × 1"},{"kind":"text","text":", two "},{"kind":"math_inline","text":"2 × 1"},{"kind":"text","text":", and one "},{"kind":"math_inline","text":"3 × 1"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"372B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/372/problem/B"}