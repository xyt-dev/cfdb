{"assets":[],"contentKind":"statement","contestId":"373","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Collecting Beats is Fun"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Cucumber boy is fan of Kyubeat, a famous music game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Kyubeat has "},{"kind":"math_inline","text":"16"},{"kind":"text","text":" panels for playing arranged in "},{"kind":"math_inline","text":"4 × 4"},{"kind":"text","text":" table. When a panel lights up, he has to press that panel."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each panel has a "},{"children":[{"kind":"text","text":"timing"}],"kind":"container"},{"kind":"text","text":" to press (the preffered time when a player should press it), and Cucumber boy is able to press at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" panels in a time with his one hand. Cucumber boy is trying to press all panels in perfect timing, that is he wants to press each panel exactly in its preffered time. If he cannot press the panels with his "},{"children":[{"kind":"text","text":"two hands"}],"kind":"container"},{"kind":"text","text":" in perfect timing, his challenge to press all the panels in perfect timing will fail."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given one scene of Kyubeat's panel from the music Cucumber boy is trying. Tell him is he able to press all the panels in perfect timing."}],"kind":"paragraph"}],"kin