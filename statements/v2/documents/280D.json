{"assets":[],"contentKind":"statement","contestId":"280","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. k-Maximum Subsequence Sum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider integer sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". You should run queries of two types:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The query format is \""},{"kind":"math_inline","text":"0"},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"val"},{"kind":"text","text":"\". In reply to this query you should make the following assignment: "},{"kind":"math_inline","text":"ai = val"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The query format is \""},{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"l"},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"k"},{"kind":"text","text":"\". In reply to this query you should print the maximum sum of at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" non-intersecting subsegments of sequence "},{"kind":"math_inline","text":"al, al + 1, ..., ar"},{"kind":"text","text":". Formally, you should choose at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" pairs of integers "},{"kind":"math_inline","text":"(x1, y1), (x2, y2), ..., (xt, yt)"},{"kind":"math_inline","text":"(l ≤ x1 ≤ y1 < x2 ≤ y2 < ... < xt ≤ yt ≤ r; t ≤ k)"},{"kind":"text","text":" such that the sum "},{"kind":"math_inline","text":"ax1 + ax1 + 1 + ... + ay1 + ax2 + ax2 + 1 + ... + ay2 + ... + axt + axt + 1 + ... + ayt"},{"kind":"text","text":" is as large as possible. Note that you should choose at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" subsegments. Particularly, you can choose 0 subsegments. In this case the described sum considered equal to zero. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":", showing how many numbers the sequence has. The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(|ai| ≤ 500)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains integer "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ m ≤ 105)"},{"kind":"text","text":" — the number of queries. The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the queries in the format, given in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All changing queries fit into limits: "},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"|val| ≤ 500"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All queries to count the maximum sum of at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" non-intersecting subsegments fit into limits: "},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 20"},{"kind":"text","text":". It is guaranteed that the number of the queries to count the maximum sum of at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" non-intersecting subsegments doesn't exceed "},{"kind":"math_inline","text":"10000"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query to count the maximum sum of at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" non-intersecting subsegments print the reply — the maximum sum. Print the answers to the queries in the order, in which the queries follow in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n9 -8 9 -1 -1 -1 9 -8 9\n3\n1 1 9 1\n1 1 9 2\n1 4 6 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"17\n25\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"15\n-4 8 -3 -10 10 4 -7 -7 0 -6 3 8 -10 7 2\n15\n1 3 9 2\n1 6 12 1\n0 6 5\n0 10 -7\n1 4 9 1\n1 7 9 1\n0 10 -3\n1 4 10 2\n1 3 13 2\n1 4 11 2\n0 15 -9\n0 13 -9\n0 11 -10\n1 5 14 2\n1 6 12 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n11\n15\n0\n15\n26\n18\n23\n8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first query of the first example you can select a single pair "},{"kind":"math_inline","text":"(1, 9)"},{"kind":"text","text":". So the described sum will be 17."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Look at the second query of the first example. How to choose two subsegments? (1, 3) and (7, 9)? Definitely not, the sum we could get from (1, 3) and (7, 9) is 20, against the optimal configuration (1, 7) and (9, 9) with 25."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer to the third query is 0, we prefer select nothing if all of the numbers in the given interval are negative."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"280D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/280/problem/D"}