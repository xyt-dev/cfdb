{"assets":[],"contentKind":"statement","contestId":"1732","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D1. Balance (Easy version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is the easy version of the problem. The only difference is that in this version there are no \"remove\" queries."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially you have a set containing one element — $$$0$$$. You need to handle $$$q$$$ queries of the following types:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":" $$$x$$$ — add the integer $$$x$$$ to the set. It is guaranteed that this integer is not contained in the set;"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":" $$$k$$$ — find the $$$k\\text{-mex}$$$ of the set. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In our problem, we define the $$$k\\text{-mex}$$$ of a set of integers as the smallest non-negative integer $$$x$$$ that is divisible by $$$k$$$ and which is not contained in the set."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$q$$$ ($$$