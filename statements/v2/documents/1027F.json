{"assets":[],"contentKind":"statement","contestId":"1027","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Session in BSU"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp studies in Berland State University. Soon he will have to take his exam. He has to pass exactly $$$n$$$ exams."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the each exam $$$i$$$ there are known two days: $$$a_i$$$ — day of the first opportunity to pass the exam, $$$b_i$$$ — day of the second opportunity to pass the exam ($$$a_i \\lt b_i$$$). Polycarp "},{"children":[{"kind":"text","text":"can pass at most one exam"}],"kind":"container"},{"kind":"text","text":" during each day. For each exam Polycarp chooses by himself which day he will pass this exam. He has to pass all the $$$n$$$ exams."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp wants to pass all the exams as soon as possible. Print the minimum index of day by which Polycarp can pass all the $$$n$$$ exams, or print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if he cannot pass all the exams at all."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$n$$$ ($$$1 \\le n \\le 10^6$$$) — the number of exams."}],"kind":"paragraph"