{"assets":["/statement-assets/6f467206508684f8ae468d799431b96ed0ff8c2164af967e42200abefbcf9fbc.png"],"contentKind":"statement","contestId":"283","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Cows and Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bessie and the cows are playing with sequences and need your help. They start with a sequence, initially containing just the number 0, and perform "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" operations. Each operation is one of the following:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Add the integer "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" to the first "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" elements of the sequence. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Append an integer "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" to the end of the sequence. (And hence the size of the sequence increases by 1) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Remove the last element of the sequence. So, the size of the sequence decreases by one. Note, that this operation can only be done if there are at least two elements in the sequence. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"After each operation, the cows would like to know the average of all the numbers in the sequence. Help them!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n (1 ≤ n ≤ 2·105)"},{"kind":"text","text":" — the number of operations. The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines describe the operations. Each line will start with an integer "},{"kind":"math_inline","text":"ti"},{"kind":"math_inline","text":"(1 ≤ ti ≤ 3)"},{"kind":"text","text":", denoting the type of the operation (see above). If "},{"kind":"math_inline","text":"ti = 1"},{"kind":"text","text":", it will be followed by two integers "},{"kind":"math_inline","text":"ai, xi"},{"kind":"math_inline","text":"(|xi| ≤ 103; 1 ≤ ai)"},{"kind":"text","text":". If "},{"kind":"math_inline","text":"ti = 2"},{"kind":"text","text":", it will be followed by a single integer "},{"kind":"math_inline","text":"ki"},{"kind":"math_inline","text":"(|ki| ≤ 103)"},{"kind":"text","text":". If "},{"kind":"math_inline","text":"ti = 3"},{"kind":"text","text":", it will not be followed by anything."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all operations are correct (don't touch nonexistent elements) and that there will always be at least one element in the sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each containing the average of the numbers in the sequence after the corresponding operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer will be considered correct if its absolute or relative error doesn't exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2 1\n3\n2 3\n2 1\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.500000\n0.000000\n1.500000\n1.333333\n1.500000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n2 1\n1 2 20\n2 2\n1 2 -3\n3\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.500000\n20.500000\n14.333333\n12.333333\n17.500000\n17.000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second sample, the sequence becomes "},{"attrs":{"alt":"","src":"/statement-assets/6f467206508684f8ae468d799431b96ed0ff8c2164af967e42200abefbcf9fbc.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"283A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/283/problem/A"}