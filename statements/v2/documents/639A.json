{"assets":[],"contentKind":"statement","contestId":"639","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Bear and Displayed Friends"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Limak is a little polar bear. He loves connecting with other bears via social networks. He has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" friends and his relation with the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them is described by a unique integer "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":". The bigger this value is, the better the friendship is. No two friends have the same value "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Spring is starting and the Winter sleep is over for bears. Limak has just woken up and logged in. All his friends still sleep and thus none of them is online. Some (maybe all) of them will appear online in the next hours, one at a time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The system displays friends who are online. On the screen there is space to display at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" friends. If there are more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" friends online then the system displays only "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" best of them — those with biggest "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to handle queries of two types:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"1 id"}],"kind":"container"},{"kind":"text","text":"\" — Friend "},{"kind":"math_inline","text":"id"},{"kind":"text","text":" becomes online. It's guaranteed that he wasn't online before. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"2 id"}],"kind":"container"},{"kind":"text","text":"\" — Check whether friend "},{"kind":"math_inline","text":"id"},{"kind":"text","text":" is displayed by the system. Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" in a separate line. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Are you able to help Limak and answer all queries of the second type?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, q ≤ 150 000, 1 ≤ k ≤ min(6, n)"},{"kind":"text","text":") — the number of friends, the maximum number of displayed online friends and the number of queries, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 109"},{"kind":"text","text":") where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" describes how good is Limak's relation with the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th friend."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the following "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"typei"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"idi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ typei ≤ 2, 1 ≤ idi ≤ n"},{"kind":"text","text":") — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query. If "},{"kind":"math_inline","text":"typei = 1"},{"kind":"text","text":" then a friend "},{"kind":"math_inline","text":"idi"},{"kind":"text","text":" becomes online. If "},{"kind":"math_inline","text":"typei = 2"},{"kind":"text","text":" then you should check whether a friend "},{"kind":"math_inline","text":"idi"},{"kind":"text","text":" is displayed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that no two queries of the first type will have the same "},{"kind":"math_inline","text":"idi"},{"kind":"text","text":" becuase one friend can't become online twice. Also, it's guaranteed that at least one query will be of the second type ("},{"kind":"math_inline","text":"typei = 2"},{"kind":"text","text":") so the output won't be empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the second type print one line with the answer — \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if the given friend is displayed and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 8\n300 950 500 200\n1 3\n2 4\n2 3\n1 1\n1 2\n2 1\n2 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\nYES\nNO\nYES\nYES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3 9\n50 20 51 17 99 24\n1 3\n1 4\n1 5\n1 2\n2 4\n2 2\n1 1\n2 4\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\nYES\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Limak has "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" friends who all sleep initially. At first, the system displays nobody because nobody is online. There are the following "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" queries:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"1 3"}],"kind":"container"},{"kind":"text","text":"\" — Friend "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" becomes online. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"2 4"}],"kind":"container"},{"kind":"text","text":"\" — We should check if friend "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" is displayed. He isn't even online and thus we print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"2 3"}],"kind":"container"},{"kind":"text","text":"\" — We should check if friend "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" is displayed. Right now he is the only friend online and the system displays him. We should print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"1 1"}],"kind":"container"},{"kind":"text","text":"\" — Friend "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" becomes online. The system now displays both friend "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and friend "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"1 2"}],"kind":"container"},{"kind":"text","text":"\" — Friend "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" becomes online. There are "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" friends online now but we were given "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":" so only two friends can be displayed. Limak has worse relation with friend "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" than with other two online friends ("},{"kind":"math_inline","text":"t1 < t2, t3"},{"kind":"text","text":") so friend "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" won't be displayed "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"2 1"}],"kind":"container"},{"kind":"text","text":"\" — Print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"2 2"}],"kind":"container"},{"kind":"text","text":"\" — Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"2 3"}],"kind":"container"},{"kind":"text","text":"\" — Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"639A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/639/problem/A"}