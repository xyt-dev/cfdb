{"assets":[],"contentKind":"statement","contestId":"1217","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Forced Online Queries Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an undirected graph with $$$n$$$ vertices numbered from $$$1$$$ to $$$n$$$. Initially there are no edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are asked to perform some queries on the graph. Let $$$last$$$ be the answer to the latest query of the second type, it is set to $$$0$$$ before the first such query. Then the queries are the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1~x~y$$$ ($$$1 \\le x, y \\le n$$$, $$$x \\ne y$$$) — add an undirected edge between the vertices $$$(x + last - 1)~mod~n + 1$$$ and $$$(y + last - 1)~mod~n + 1$$$ if it doesn't exist yet, otherwise remove it; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$2~x~y$$$ ($$$1 \\le x, y \\le n$$$, $$$x \\ne y$$$) — check if there exists a path between the vertices $$$(x + last - 1)~mod~n + 1$$$ and $$$(y + last - 1)~mod~n + 1$$$, which goes only through currently existing edges, and set $$$last$$$ to $$$1$$$ if so and $$$0$$$ otherwise. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Good luck!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integer numbers $$$n$$$ and $$$m$$$ ($$$2 \\le n, m \\le 2 \\cdot 10^5$$$) — the number of vertices and the number of queries, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following $$$m$$$ lines contains a query of one of two aforementioned types. It is guaranteed that there is at least one query of the second type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a string, consisting of characters '0' and '1'. The $$$i$$$-th character should be the answer to the $$$i$$$-th query of the second type. Therefore the length of the string should be equal to the number of queries of the second type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 9\n1 1 2\n1 1 3\n2 3 2\n1 2 4\n2 3 4\n1 2 4\n2 3 4\n1 1 3\n2 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1010\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 9\n1 1 2\n1 2 3\n1 3 1\n2 1 3\n1 3 2\n2 2 3\n1 1 2\n2 1 2\n2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1101\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The converted queries in the first example are:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" 1 1 2 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 1 1 3 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 2 3 2 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 1 3 5 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 2 4 5 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 1 2 4 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 2 3 4 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 1 2 4 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 2 5 4 "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The converted queries in the second example are:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" 1 1 2 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 1 2 3 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 1 3 1 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 2 1 3 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 1 1 3 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 2 3 1 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 1 2 3 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 2 2 3 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 2 1 2 "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1217F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1217/problem/F"}