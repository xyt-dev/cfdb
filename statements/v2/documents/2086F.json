{"assets":[],"contentKind":"statement","contestId":"2086","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Online Palindrome"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is an interactive problem."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The jury has a string $$$s$$$ consisting of lowercase Latin letters. The following constraints apply to this string:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the string has an odd length that does not exceed $$$99$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the string consists only of the characters \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"There is also a string $$$t$$$, which is initially empty. Then, $$$|s|$$$ steps happen. During the $$$i$$$-th step, the following events occur:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" first, the jury tells you the character $$$s_i$$$ and appends it to the end of the string $$$t$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" then, you may swap any two characters in $$$t$$$, or do nothing. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is to ensure that after the $$$|s|$$$-th step, the string $$$t$$$ is a palindrome."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom","title":"Interaction"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Interaction"}],"kind":"heading"},{"children":[{"kind":"text","text":"The interactive interaction starts immediately."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During each step, your program will receive one character — the next character of the string $$$s$$$ or \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" (zero) if the string has ended. If the character \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" is received, your program must terminate immediately."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After receiving $$$s_{i}$$$, you must output the positions of the characters to be swapped, that is, two integers $$$l$$$ and $$$r$$$ ($$$1 \\le l,r \\le i$$$) or, if you do not want to swap characters, then \""},{"children":[{"kind":"text","text":"0 0"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If your program makes an invalid operation, for example, by trying to swap characters from non-existing positions, or the resulting string $$$t$$$ is not a palindrome, the jury program will print one character \""},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"\" on a separate line. If your program receives \""},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"\" as the response, "},{"children":[{"kind":"text","text":"it should terminate immediately"}],"kind":"container"},{"kind":"text","text":"; otherwise, the verdict of your submission will be undefined. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The interactor in this problem "},{"children":[{"kind":"text","text":"is not adaptive"}],"kind":"container"},{"kind":"text","text":", meaning that the string $$$s$$$ does not change during the interaction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After each output request, do not forget to output a newline and flush the output buffer. Otherwise, you will receive a verdict of \""},{"children":[{"kind":"text","text":"Idleness limit exceeded"}],"kind":"container"},{"kind":"text","text":"\". To do this, use:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"fflush(stdout)"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"cout.flush()"}],"kind":"container"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"C++"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"System.out.flush()"}],"kind":"container"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"Java"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"sys.stdout.flush()"}],"kind":"container"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"Python"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" refer to the documentation for other languages. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"Hack format"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For hacks, use the following format."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line should contain a single integer $$$|s|$$$ — the length of the string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line should contain the $$$s$$$ itself ($$$1 \\le |s| \\le 99, |s| \\bmod 2 = 1$$$), consisting of lowercase Latin letters \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\na\n\na\n\nb\n\n0"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n\n0 0\n\n1 2\n\n2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\na\n\na\n\nb\n\na\n\nb\n\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n\n0 0\n\n2 1\n\n3 2\n\n4 4\n\n4 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"2086F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2086/problem/F"}