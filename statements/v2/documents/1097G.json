{"assets":[],"contentKind":"statement","contestId":"1097","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Vladislav and a Great Legend"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A great legend used to be here, but some troll hacked Codeforces and erased it. Too bad for us, but in the troll society he earned a title of an ultimate-greatest-over troll. At least for them, it's something good. And maybe a formal statement will be even better for us?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a tree $$$T$$$ with $$$n$$$ vertices numbered from $$$1$$$ to $$$n$$$. For every "},{"children":[{"kind":"text","text":"non-empty"}],"kind":"container"},{"kind":"text","text":" subset $$$X$$$ of vertices of $$$T$$$, let $$$f(X)$$$ be the minimum number of edges in the smallest connected subtree of $$$T$$$ which contains every vertex from $$$X$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You're also given an integer $$$k$$$. You need to compute the sum of $$$(f(X))^k$$$ among all non-empty subsets of vertices, that is:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$ \\sum\\limits_{X \\subseteq \\{1, 2,\\: \\dots \\:, n\\},\\, X \\neq \\varnothing} (f(X))^k. $$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As the result might be very large, output it modulo $$$10^9 + 7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$k$$$ ($$$2 \\leq n \\leq 10^5$$$, $$$1 \\leq k \\leq 200$$$) — the size of the tree and the exponent in the sum above."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following $$$n - 1$$$ lines contains two integers $$$a_i$$$ and $$$b_i$$$ ($$$1 \\leq a_i,b_i \\leq n$$$) — the indices of the vertices connected by the corresponding edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed, that the edges form a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the requested sum modulo $$$10^9 + 7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 1\n1 2\n2 3\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n21\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 2\n1 2\n2 3\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n45\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 3\n1 2\n2 3\n3 4\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n780\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first two examples, the values of $$$f$$$ are as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(\\{1\\}) = 0$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(\\{2\\}) = 0$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(\\{1, 2\\}) = 1$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(\\{3\\}) = 0$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(\\{1, 3\\}) = 2$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(\\{2, 3\\}) = 1$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(\\{1, 2, 3\\}) = 2$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(\\{4\\}) = 0$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(\\{1, 4\\}) = 2$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(\\{2, 4\\}) = 1$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(\\{1, 2, 4\\}) = 2$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(\\{3, 4\\}) = 2$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(\\{1, 3, 4\\}) = 3$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(\\{2, 3, 4\\}) = 2$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$f(\\{1, 2, 3, 4\\}) = 3$$$"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1097G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1097/problem/G"}