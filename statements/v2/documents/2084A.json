{"assets":[],"contentKind":"statement","contestId":"2084","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Max and Mod"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an integer $$$n$$$. Find any permutation $$$p$$$ of length $$$n$$$$$$^{\\text{∗}}$$$ such that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" For all $$$2 \\le i \\le n$$$, $$$\\max(p_{i - 1}, p_i) \\bmod i$$$ $$$^{\\text{†}}$$$ $$$= i - 1$$$ is satisfied. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If it is impossible to find such a permutation $$$p$$$, output $$$-1$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$A permutation of length $$$n$$$ is an array consisting of $$$n$$$ distinct integers from $$$1$$$ to $$$n$$$ in arbitrary order. For example, $$$[2,3,1,5,4]$$$ is a permutation, but $$$[1,2,2]$$$ is not a permutation ($$$2$$$ appears twice in the array), and $$$[1,3,4]$$$ is also not a permutation ($$$n=3$$$ but there is $$$4$$$ in the array). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$^{\\text{†}}$$$$$$x \\bmod y$$$ denotes the remainder from dividing $$$x$$$ by $$$y$$$. "}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 99$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$2 \\le n \\le 100$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If such a permutation $$$p$$$ doesn't exist, output a single integer $$$-1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Otherwise, output $$$n$$$ integers $$$p_1, p_2, \\ldots, p_n$$$ — the permutation $$$p$$$ you've found. If there are multiple answers, output any of them. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n2\n3\n4\n5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n3 2 1\n-1\n1 5 2 3 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, it is impossible to find such a permutation $$$p$$$, so you should output $$$-1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, $$$p = [1, 5, 2, 3, 4]$$$ satisfies the condition:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" For $$$i = 2$$$, $$$\\max(p_1, p_2) = 5$$$ and $$$5 \\bmod 2 = 1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$i = 3$$$, $$$\\max(p_2, p_3) = 5$$$ and $$$5 \\bmod 3 = 2$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$i = 4$$$, $$$\\max(p_3, p_4) = 3$$$ and $$$3 \\bmod 4 = 3$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$i = 5$$$, $$$\\max(p_4, p_5) = 4$$$ and $$$4 \\bmod 5 = 4$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2084A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2084/problem/A"}