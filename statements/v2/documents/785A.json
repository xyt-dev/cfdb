{"assets":["/statement-assets/18f3679a15ced9197ff7acf9d97b4bfe27b28bdcd029e0dafca8564d00dd1c07.png"],"contentKind":"statement","contestId":"785","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Anton and Polyhedrons"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Anton's favourite geometric figures are regular polyhedrons. Note that there are five kinds of regular polyhedrons: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"Tetrahedron"}],"kind":"container"},{"kind":"text","text":". Tetrahedron has "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" triangular faces. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Cube"}],"kind":"container"},{"kind":"text","text":". Cube has "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" square faces. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Octahedron"}],"kind":"container"},{"kind":"text","text":". Octahedron has "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" triangular faces. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Dodecahedron"}],"kind":"container"},{"kind":"text","text":". Dodecahedron has "},{"kind":"math_inline","text":"12"},{"kind":"text","text":" pentagonal faces. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Icosahedron"}],"kind":"container"},{"kind":"text","text":". Icosahedron has "},{"kind":"math_inline","text":"20"},{"kind":"text","text":" triangular faces. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"All five kinds of polyhedrons are shown on the picture below:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/18f3679a15ced9197ff7acf9d97b4bfe27b28bdcd029e0dafca8564d00dd1c07.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Anton has a collection of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" polyhedrons. One day he decided to know, how many faces his polyhedrons have in total. Help Anton and find this number!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 200 000)"},{"kind":"text","text":" — the number of polyhedrons in Anton's collection."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines of the input contains a string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" — the name of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th polyhedron in Anton's collection. The string can look like this:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"Tetrahedron"}],"kind":"container"},{"kind":"text","text":"\" (without quotes), if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th polyhedron in Anton's collection is a tetrahedron. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"Cube"}],"kind":"container"},{"kind":"text","text":"\" (without quotes), if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th polyhedron in Anton's collection is a cube. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"Octahedron"}],"kind":"container"},{"kind":"text","text":"\" (without quotes), if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th polyhedron in Anton's collection is an octahedron. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"Dodecahedron"}],"kind":"container"},{"kind":"text","text":"\" (without quotes), if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th polyhedron in Anton's collection is a dodecahedron. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"Icosahedron"}],"kind":"container"},{"kind":"text","text":"\" (without quotes), if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th polyhedron in Anton's collection is an icosahedron. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one number — the total number of faces in all the polyhedrons in Anton's collection."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nIcosahedron\nCube\nTetrahedron\nDodecahedron\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"42\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nDodecahedron\nOctahedron\nOctahedron\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"28\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Anton has one icosahedron, one cube, one tetrahedron and one dodecahedron. Icosahedron has "},{"kind":"math_inline","text":"20"},{"kind":"text","text":" faces, cube has "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" faces, tetrahedron has "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" faces and dodecahedron has "},{"kind":"math_inline","text":"12"},{"kind":"text","text":" faces. In total, they have "},{"kind":"math_inline","text":"20 + 6 + 4 + 12 = 42"},{"kind":"text","text":" faces."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"785A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/785/problem/A"}