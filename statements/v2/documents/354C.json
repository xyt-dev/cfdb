{"assets":[],"contentKind":"statement","contestId":"354","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Vasya and Beautiful Arrays"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya's got a birthday coming up and his mom decided to give him an array of positive integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya thinks that an array's beauty is the greatest common divisor of all its elements. His mom, of course, wants to give him as beautiful an array as possible (with largest possible beauty). Unfortunately, the shop has only one array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" left. On the plus side, the seller said that he could decrease some numbers in the array (no more than by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" for each number)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The seller can obtain array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" from array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" if the following conditions hold: "},{"kind":"math_inline","text":"bi > 0; 0 ≤ ai - bi ≤ k"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help mom find the maximum possible beauty of the array she will give to Vasya (that seller can obtain)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n ≤ 3·105; 1 ≤ k ≤ 106)"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 106)"},{"kind":"text","text":" — array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the single line print a single number — the maximum possible beauty of the resulting array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 1\n3 6 10 12 13 16\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n8 21 52 15 77\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample we can obtain the array:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"3 6 9 12 12 15"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample we can obtain the next array:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"7 21 49 14 77"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"354C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/354/problem/C"}