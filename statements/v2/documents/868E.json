kind":"math_inline","text":"4"},{"kind":"text","text":" — to vertex "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". The policeman goes to vertex "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and catches two criminals. After that the criminal number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" moves to the vertex "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". The policeman goes to vertex "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and catches criminal "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", then goes to the vertex "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and catches the remaining criminal."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"868E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/868/problem/E"}