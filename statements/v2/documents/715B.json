{"assets":["/statement-assets/b9ba4e3317e7f9098a0b5c93e37d04d499a77f970df61e419893d7bf08b66f76.png"],"contentKind":"statement","contestId":"715","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Complete The Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"ZS the Coder has drawn an undirected graph of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices numbered from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges between them. Each edge of the graph is weighted, each weight is a "},{"children":[{"kind":"text","text":"positive integer"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next day, ZS the Coder realized that some of the weights were erased! So he wants to reassign "},{"children":[{"kind":"text","text":"positive integer"}],"kind":"container"},{"kind":"text","text":" weight to each of the edges which weights were erased, so that the length of the shortest path between vertices "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in the resulting graph is exactly "},{"kind":"math_inline","text":"L"},{"kind":"text","text":". Can you help him?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains five integers "},{"kind":"math_inline","text":"n, m, L, s, t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 1000,  1 ≤ m ≤ 10 000,  1 ≤ L ≤ 109,  0 ≤ s, t ≤ n - 1,  s ≠ t"},{"kind":"text","text":") — the number of vertices, number of edges, the desired length of shortest path, starting vertex and ending vertex respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then, "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines describing the edges of the graph follow. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains three integers, "},{"kind":"math_inline","text":"ui, vi, wi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ui, vi ≤ n - 1,  ui ≠ vi,  0 ≤ wi ≤ 109"},{"kind":"text","text":"). "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" denote the endpoints of the edge and "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" denotes its weight. If "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" then the weight of the corresponding edge was erased."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there is at most one edge between any pair of vertices."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in the only line if it's not possible to assign the weights in a required way."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" in the first line. Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines should contain the edges of the resulting graph, with weights assigned to edges which weights were erased. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should contain three integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":", denoting an edge between vertices "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" of weight "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":". The edges of the new graph must coincide with the ones in the graph from the input. The weights that were not erased must remain unchanged whereas the new weights can be any "},{"children":[{"kind":"text","text":"positive integer"}],"kind":"container"},{"kind":"text","text":" not exceeding "},{"kind":"math_inline","text":"1018"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The order of the edges in the output doesn't matter. The length of the shortest path between "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" must be equal to "},{"kind":"math_inline","text":"L"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5 13 0 4\n0 1 5\n2 1 2\n3 2 3\n1 4 0\n4 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n0 1 5\n2 1 2\n3 2 3\n1 4 8\n4 3 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 123456789 0 1\n0 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n0 1 123456789\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 999999999 1 0\n0 1 1000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here's how the graph in the first sample case looks like :"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b9ba4e3317e7f9098a0b5c93e37d04d499a77f970df61e419893d7bf08b66f76.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the first sample case, there is only one missing edge weight. Placing the weight of "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" gives a shortest path from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"13"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample case, there is only a single edge. Clearly, the only way is to replace the missing weight with "},{"kind":"math_inline","text":"123456789"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the last sample case, there is no weights to assign but the length of the shortest path doesn't match the required value, so the answer is \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"715B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/715/problem/B"}