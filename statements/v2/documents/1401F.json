{"assets":[],"contentKind":"statement","contestId":"1401","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Reverse and Swap"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array $$$a$$$ of length $$$2^n$$$. You should process $$$q$$$ queries on it. Each query has one of the following $$$4$$$ types: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" $$$Replace(x, k)$$$ — change $$$a_x$$$ to $$$k$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$Reverse(k)$$$ — reverse each subarray $$$[(i-1) \\cdot 2^k+1, i \\cdot 2^k]$$$ for all $$$i$$$ ($$$i \\ge 1$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$Swap(k)$$$ — swap subarrays $$$[(2i-2) \\cdot 2^k+1, (2i-1) \\cdot 2^k]$$$ and $$$[(2i-1) \\cdot 2^k+1, 2i \\cdot 2^k]$$$ for all $$$i$$$ ($$$i \\ge 1$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$Sum(l, r)$$$ — print the sum of the elements of subarray $$$[l, r]$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Write a program that can quickly process given queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$, $$$q$$$ ($$$0 \\le n \\le 18$$$; $$$1 \\le q \\le 10^5$$$) — the length of array $$$a$$$ and the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$2^n$$$ integers $$$a_1, a_2, \\ldots, a_{2^n}$$$ ($$$0 \\le a_i \\le 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$q$$$ lines contains queries — one per line. Each query has one of $$$4$$$ types: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \"$$$1$$$ $$$x$$$ $$$k$$$\" ($$$1 \\le x \\le 2^n$$$; $$$0 \\le k \\le 10^9$$$) — $$$Replace(x, k)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \"$$$2$$$ $$$k$$$\" ($$$0 \\le k \\le n$$$) — $$$Reverse(k)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \"$$$3$$$ $$$k$$$\" ($$$0 \\le k \\lt n$$$) — $$$Swap(k)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \"$$$4$$$ $$$l$$$ $$$r$$$\" ($$$1 \\le l \\le r \\le 2^n$$$) — $$$Sum(l, r)$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is guaranteed that there is at least one $$$Sum$$$ query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the answer for each $$$Sum$$$ query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 3\n7 4 9 9\n1 2 8\n3 1\n4 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n24\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 8\n7 0 8 8 7 1 5 2\n4 3 7\n2 1\n3 2\n4 1 6\n2 3\n1 5 16\n4 8 8\n3 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n29\n22\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, initially, the array $$$a$$$ is equal to $$$\\{7,4,9,9\\}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After processing the first query. the array $$$a$$$ becomes $$$\\{7,8,9,9\\}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After processing the second query, the array $$$a_i$$$ becomes $$$\\{9,9,7,8\\}$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Therefore, the answer to the third query is $$$9+7+8=24$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, initially, the array $$$a$$$ is equal to $$$\\{7,0,8,8,7,1,5,2\\}$$$. What happens next is: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" $$$Sum(3, 7)$$$ $$$\\to$$$ $$$8 + 8 + 7 + 1 + 5 = 29$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$Reverse(1)$$$ $$$\\to$$$ $$$\\{0,7,8,8,1,7,2,5\\}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$Swap(2)$$$ $$$\\to$$$ $$$\\{1,7,2,5,0,7,8,8\\}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$Sum(1, 6)$$$ $$$\\to$$$ $$$1 + 7 + 2 + 5 + 0 + 7 = 22$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$Reverse(3)$$$ $$$\\to$$$ $$$\\{8,8,7,0,5,2,7,1\\}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$Replace(5, 16)$$$ $$$\\to$$$ $$$\\{8,8,7,0,16,2,7,1\\}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$Sum(8, 8)$$$ $$$\\to$$$ $$$1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$Swap(0)$$$ $$$\\to$$$ $$$\\{8,8,0,7,2,16,1,7\\}$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1401F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1401/problem/F"}