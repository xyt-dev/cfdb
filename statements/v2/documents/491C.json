{"assets":[],"contentKind":"statement","contestId":"491","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Deciphering"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day Maria Ivanovna found a Sasha's piece of paper with a message dedicated to Olya. Maria Ivanovna wants to know what is there in a message, but unfortunately the message is ciphered. Maria Ivanovna knows that her students usually cipher their messages by replacing each letter of an original message by some another letter. Replacement works in such way that same letters are always replaced with some fixed letter, and different letters are always replaced by different letters. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Maria Ivanovna supposed that the message contains answers to the final exam (since its length is equal to the number of final exam questions). On the other hand she knows that Sasha's answer are not necessary correct. There are "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" possible answers for each questions. Of course, Maria Ivanovna knows correct answers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Maria Ivanovna decided to decipher message in such way that the number of Sasha's correct answers is maximum possible. She is very busy now, so your task is to help her."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains length of both strings "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ N ≤ 2 000 000"},{"kind":"text","text":") and an integer "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" — number of possible answers for each of the questions ("},{"kind":"math_inline","text":"1 ≤ K ≤ 52"},{"kind":"text","text":"). Answers to the questions are denoted as Latin letters "},{"children":[{"kind":"text","text":"abcde...xyzABCDE...XYZ"}],"kind":"container"},{"kind":"text","text":" in the order. For example for "},{"kind":"math_inline","text":"K = 6"},{"kind":"text","text":", possible answers are "},{"children":[{"kind":"text","text":"abcdef"}],"kind":"container"},{"kind":"text","text":" and for "},{"kind":"math_inline","text":"K = 30"},{"kind":"text","text":" possible answers are "},{"children":[{"kind":"text","text":"abcde...xyzABCD"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second line contains a ciphered message string consisting of Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Third line contains a correct answers string consisting of Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line output maximum possible number of correct Sasha's answers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line output cipher rule as the string of length "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" where for each letter from the students' cipher (starting from "},{"children":[{"kind":"text","text":"'a'"}],"kind":"container"},{"kind":"text","text":" as mentioned above) there is specified which answer does it correspond to."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several ways to produce maximum answer, output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 2\naaabbbaaab\nbbbbabbbbb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\nba\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 2\naaaaaaabbb\nbbbbaaabbb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\nab\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9 4\ndacbdacbd\nacbdacbda\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\ncdba\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"491C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/491/problem/C"}