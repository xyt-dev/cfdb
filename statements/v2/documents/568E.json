{"assets":[],"contentKind":"statement","contestId":"568","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Longest Increasing Subsequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"128 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Note that the memory limit in this problem is less than usual"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's consider an array consisting of positive integers, some positions of which contain gaps."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We have a collection of numbers that can be used to fill the gaps. Each number from the given collection can be used at most once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine such way of filling gaps that the longest increasing subsequence in the formed array has a maximum size."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the length of the array ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers — the elements of the sequence. A gap is marked as \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\". The elements that are not gaps are positive integers not exceeding "},{"kind":"math_inline","text":"109"},{"kind":"text","text":". It is guaranteed that the sequence contains "},{"kind":"math_inline","text":"0 ≤ k ≤ 1000"},{"kind":"text","text":" gaps."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a single positive integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the number of elements to fill the gaps ("},{"kind":"math_inline","text":"k ≤ m ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fourth line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" positive integers — the numbers to fill gaps. Each number is a positive integer not exceeding "},{"kind":"math_inline","text":"109"},{"kind":"text","text":". Some numbers may be equal. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated numbers in a single line — the resulting sequence. If there are multiple possible answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n1\n10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 3 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 -1 3\n3\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 3 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n-1 2\n2\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 2 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n-1 -1 -1\n5\n1 1 1 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1 2 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n-1 -1 -1 2\n4\n1 1 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 1 2 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample there are no gaps, so the correct answer is the initial sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample there is only one way to get an increasing subsequence of length "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample answer "},{"children":[{"kind":"text","text":"\"4 2\""}],"kind":"container"},{"kind":"text","text":" would also be correct. Note that only strictly increasing subsequences are considered."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth sample the answer "},{"children":[{"kind":"text","text":"\"1 1 1 2\""}],"kind":"container"},{"kind":"text","text":" is not considered correct, as number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" can be used in replacing only two times."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"568E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/568/problem/E"}