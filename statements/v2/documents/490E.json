{"assets":[],"contentKind":"statement","contestId":"490","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Restoring Increasing Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Peter wrote on the board a strictly increasing sequence of positive integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". Then Vasil replaced some digits in the numbers of this sequence by question marks. Thus, each question mark corresponds to exactly one lost digit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Restore the the original sequence knowing digits remaining on the board."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the length of the sequence. Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain one element of the sequence each. Each element consists only of digits and question marks. No element starts from digit "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":". Each element has length from 1 to 8 characters, inclusive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"c