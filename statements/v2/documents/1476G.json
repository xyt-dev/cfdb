"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$m$$$ lines contain queries (one per line). Each query has one of two types: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \"$$$1$$$ $$$l$$$ $$$r$$$ $$$k$$$\" ($$$1 \\le l \\le r \\le n; 1 \\le k \\le 10^5$$$) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \"$$$2$$$ $$$p$$$ $$$x$$$\" ($$$1 \\le p \\le n; 1 \\le x \\le 10^5$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It's guaranteed that there is at least one query of the first type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the first type, print the minimum value of $$$dif$$$ that satisfies all required conditions, or $$$-1$$$ if it is impossible to choose $$$k$$$ distinct integers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n12 11\n2 1 1 2 1 1 3 2 1 1 3 3\n1 2 10 3\n1 2 11 3\n2 7 2\n1 3 9 2\n1 1 12 1\n1 1 12 4\n2 12 4\n1 1 12 4\n2 1 5\n1 3 12 2\n1 1 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n4\n1\n0\n-1\n5\n0\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1476G","schema":2,"sourceKind":"html","sourceUrl":"https://code