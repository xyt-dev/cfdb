{"assets":[],"contentKind":"statement","contestId":"2195","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Absolute Cinema"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a hidden sequence $$$a_1,a_2,\\ldots,a_n$$$ of $$$n$$$ "},{"children":[{"kind":"text","text":"integers"}],"kind":"container"},{"kind":"text","text":" ($$$n \\ge 2$$$). It is guaranteed that $$$|a_i| \\le 1000$$$ for all $$$1 \\le i \\le n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define a function $$$f(x)$$$ as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$f(x)=\\sum_{i=1}^n a_i \\cdot |i-x|$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given $$$n$$$ values $$$f(1),f(2),\\ldots,f(n)$$$, please determine the values of $$$a_1,a_2,\\ldots,a_n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the values $$$a_1,a_2,\\ldots,a_n$$$ can be determined uniquely."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$\\color{red}{2} \\le n \\le 300\\,000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$f(1),f(2),\\ldots,f(n)$$$ ($$$-10^{14} \\le f(i) \\le 10^{14}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$300\\,000$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output $$$n$$$ "},{"children":[{"kind":"text","text":"integers"}],"kind":"container"},{"kind":"text","text":" $$$a_1,a_2,\\ldots,a_n$$$ on a separate line ($$$|a_i| \\le 1000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the values $$$a_1,a_2,\\ldots,a_n$$$ can be determined uniquely."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n4\n17 9 9 13\n6\n-37 -32 -15 4 27 42\n5\n-26 -32 -24 -4 2\n2\n420 -69\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 4 2 3\n3 6 1 2 -4 -7\n-6 7 6 -7 -6\n-69 420\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the hidden sequence is $$$a=[1,4,2,3]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The values $$$f(1),f(2),\\ldots,f(n)$$$ are as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$f(1) = 1 \\cdot |1-1| + 4 \\cdot |2-1| + 2 \\cdot |3-1| + 3 \\cdot |4-1| = 0+4+4+9 = 17$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$f(2) = 1 \\cdot |1-2| + 4 \\cdot |2-2| + 2 \\cdot |3-2| + 3 \\cdot |4-2| = 1+0+2+6 = 9$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$f(3) = 1 \\cdot |1-3| + 4 \\cdot |2-3| + 2 \\cdot |3-3| + 3 \\cdot |4-3| = 2+4+0+3 = 9$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$f(4) = 1 \\cdot |1-4| + 4 \\cdot |2-4| + 2 \\cdot |3-4| + 3 \\cdot |4-4| = 3+8+2+0 = 13$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"2195D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2195/problem/D"}