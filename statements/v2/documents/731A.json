{"assets":["/statement-assets/0c42b4a5f3698511e55f7dfb90b90e344fb2857545c83d18ee3a132606f9b7ec.png","/statement-assets/a02e3b55a8b4163649def80cf4ca21ec0799b4911c1f2e073f20cdb8ec6bd1fd.png"],"contentKind":"statement","contestId":"731","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Night at the Museum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Grigoriy, like the hero of one famous comedy film, found a job as a night security guard at the museum. At first night he received "},{"children":[{"kind":"text","text":"embosser"}],"kind":"container"},{"kind":"text","text":" and was to take stock of the whole exposition."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Embosser"}],"kind":"container"},{"kind":"text","text":" is a special devise that allows to \"print\" the text of a plastic tape. Text is printed sequentially, character by character. The device consists of a wheel with a lowercase English letters written in a circle, static pointer to the current letter and a button that print the chosen letter. At one move it's allowed to rotate the alphabetic wheel one step clockwise or counterclockwise. Initially, static pointer points to letter '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"'. Other letters are located as shown on the picture:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0c42b4a5f3698511e55f7dfb90b90e344fb2857545c83d18ee3a132606f9b7ec.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"After Grigoriy add new item to the base he has to print its name on the plastic tape and attach it to the corresponding exhibit. It's not required to return the wheel to its initial position with pointer on the letter '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Our hero is afraid that some exhibits may become alive and start to attack him, so he wants to print the names as fast as possible. Help him, for the given string find the minimum number of rotations of the wheel required to print it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of input contains the name of some exhibit — the non-empty string consisting of no more than "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" characters. It's guaranteed that the string consists of only lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the minimum number of rotations of the wheel, required to print the name given in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"zeus\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"18\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"map\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"35\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ares\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"34\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a02e3b55a8b4163649def80cf4ca21ec0799b4911c1f2e073f20cdb8ec6bd1fd.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"To print the string from the first sample it would be optimal to perform the following sequence of rotations: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" from '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"' ("},{"kind":"math_inline","text":"1"},{"kind":"text","text":" rotation counterclockwise), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" from '"},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"' ("},{"kind":"math_inline","text":"5"},{"kind":"text","text":" clockwise rotations), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" from '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"u"}],"kind":"container"},{"kind":"text","text":"' ("},{"kind":"math_inline","text":"10"},{"kind":"text","text":" rotations counterclockwise), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" from '"},{"children":[{"kind":"text","text":"u"}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":"' ("},{"kind":"math_inline","text":"2"},{"kind":"text","text":" counterclockwise rotations). "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" In total, "},{"kind":"math_inline","text":"1 + 5 + 10 + 2 = 18"},{"kind":"text","text":" rotations are required."}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"731A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/731/problem/A"}