{"assets":[],"contentKind":"statement","contestId":"1351","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Skier"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Skier rides on a snowy field. Its movements can be described by a string of characters '"},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"N"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"E"}],"kind":"container"},{"kind":"text","text":"' (which correspond to $$$1$$$ meter movement in the south, north, west or east direction respectively)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is known that if he moves along a previously unvisited segment of a path (i.e. this segment of the path is visited the first time), then the time of such movement is $$$5$$$ seconds. If he rolls along previously visited segment of a path (i.e., this segment of the path has been covered by his path before), then it takes $$$1$$$ second."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the skier's time to roll all the path."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases in the input. Then $$$t$$$ test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each set is given by one nonempty string of the characters '"},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"N"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"E"}],"kind":"container"},{"kind":"text","text":"'. The length of the string does not exceed $$$10^5$$$ characters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sum of the lengths of $$$t$$$ given lines over all test cases in the input does not exceed $$$10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the desired path time in seconds."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\nNNN\nNS\nWWEN\nWWEE\nNWNWS\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n15\n6\n16\n12\n25\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1351C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1351/problem/C"}