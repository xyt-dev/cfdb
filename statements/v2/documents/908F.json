{"assets":[],"contentKind":"statement","contestId":"908","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. New Year and Rainbow Roads"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Roy and Biv have a set of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" points on the infinite number line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each point has one of 3 colors: red, green, or blue."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Roy and Biv would like to connect all the points with some edges. Edges can be drawn between any of the two of the given points. The cost of an edge is equal to the distance between the two points it connects."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"They want to do this in such a way that they will both see that all the points are connected (either directly or indirectly)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, there is a catch: Roy cannot see the color red and Biv cannot see the color blue."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Therefore, they have to choose the edges in such a way that if all the red points are removed, the remaining blue and green points are connected (and similarly, if all the blue points are removed, the remaining red and green points are connected)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help them compute the minimum cost way to choose edges to satisfy the above constraints."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line will contain an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 300 000"},{"kind":"text","text":"), the number of points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines will contain two tokens "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" is an integer, "},{"kind":"math_inline","text":"1 ≤ pi ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" is a uppercase English letter '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"'), denoting the position of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th point and the color of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th point. '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"' means red, '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"' denotes green, and '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' means blue. The positions will be in strictly increasing order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer, the minimum cost way to solve the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 G\n5 R\n10 B\n15 G\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"23\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 G\n2 R\n3 B\n10 G\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, it is optimal to draw edges between the points (1,2), (1,4), (3,4). These have costs 4, 14, 5, respectively."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"908F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/908/problem/F"}