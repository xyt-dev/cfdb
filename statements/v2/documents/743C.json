{"assets":["/statement-assets/b28d6b55e1a5efbc707774d77e85ad1921d4fd5acfaa2afb240a3f6dbc377a99.png","/statement-assets/a85653776b0360b6f1e9ac2ca5e31fb7944a828cfbe6ecd2231840e73e10f3d0.png","/statement-assets/e69ab96809b7ae7213bb40746f5186a097b520f5a1f1fa8ee0cbe65d7b200960.png"],"contentKind":"statement","contestId":"743","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Vladik and fractions"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vladik and Chloe decided to determine who of them is better at math. Vladik claimed that for any positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" he can represent fraction "},{"attrs":{"alt":"","src":"/statement-assets/b28d6b55e1a5efbc707774d77e85ad1921d4fd5acfaa2afb240a3f6dbc377a99.png"},"kind":"image"},{"kind":"text","text":" as a sum of three distinct positive fractions in form "},{"attrs":{"alt":"","src":"/statement-assets/a85653776b0360b6f1e9ac2ca5e31fb7944a828cfbe6ecd2231840e73e10f3d0.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Vladik with that, i.e for a given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" find three distinct positive integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" such that "},{"attrs":{"alt":"","src":"/statement-assets/e69ab96809b7ae7213bb40746f5186a097b520f5a1f1fa8ee0cbe65d7b200960.png"},"kind":"image"},{"kind":"text","text":". Because Chloe can't check Vladik's answer if the numbers are large, he asks you to print numbers not exceeding "},{"kind":"math_inline","text":"109"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is no such answer, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 104"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the answer exists, print "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" distinct numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x, y, z ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x ≠ y"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x ≠ z"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y ≠ z"},{"kind":"text","text":"). Otherwise print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind"