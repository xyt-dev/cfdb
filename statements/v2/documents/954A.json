{"assets":[],"contentKind":"statement","contestId":"954","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Diagonal Walking"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mikhail walks on a 2D plane. He can go either up or right. You are given a sequence of Mikhail's moves. He thinks that this sequence is too long and he wants to make it as short as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the given sequence moving up is described by character "},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":" and moving right is described by character "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":". Mikhail can replace any pair of consecutive moves "},{"children":[{"kind":"text","text":"RU"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"UR"}],"kind":"container"},{"kind":"text","text":" with a diagonal move (described as character "},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"). After that, he can go on and do some other replacements, until there is no pair of consecutive moves "},{"children":[{"kind":"text","text":"RU"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"UR"}],"kind":"container"},{"kind":"text","text":" left."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your problem is to print the minimum possible length of the sequence of moves after the replacements."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the length of the sequence. The second line contains the sequence consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters "},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum possible length of the sequence of moves after all replacements are done."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nRUURU\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"17\nUUURRRRRUUURURUUU\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test the shortened sequence of moves may be "},{"children":[{"kind":"text","text":"DUD"}],"kind":"container"},{"kind":"text","text":" (its length is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test the shortened sequence of moves can be "},{"children":[{"kind":"text","text":"UUDRRRDUDDUUU"}],"kind":"container"},{"kind":"text","text":" (its length is "},{"kind":"math_inline","text":"13"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"954A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/954/problem/A"}