{"assets":[],"contentKind":"statement","contestId":"441","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Valera and Fruits"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Valera loves his garden, where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" fruit trees grow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This year he will enjoy a great harvest! On the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th tree "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" fruit grow, they will ripen on a day number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". Unfortunately, the fruit on the tree get withered, so they can only be collected on day "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and day "},{"kind":"math_inline","text":"ai + 1"},{"kind":"text","text":" (all fruits that are not collected in these two days, become unfit to eat)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valera is not very fast, but there are some positive points. Valera is ready to work every day. In one day, Valera can collect no more than "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" fruits. The fruits may be either from the same tree, or from different ones. What is the maximum amount of fruit Valera can collect for all time, if he operates optimally well?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"math_inline","text":"(1 ≤ n, v ≤ 3000)"},{"kind":"text","text":" — the number of fruit trees in the garden and the number of fruits that Valera can collect in a day. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the description of trees in the garden. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two space-separated integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"math_inline","text":"(1 ≤ ai, bi ≤ 3000)"},{"kind":"text","text":" — the day the fruits ripen on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th tree and the number of fruits on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maximum number of fruit that Valera can collect. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n1 5\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 10\n3 20\n2 20\n1 20\n4 20\n5 20\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"60\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, in order to obtain the optimal answer, you should act as follows. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" On the first day collect "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" fruits from the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st tree. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" On the second day collect "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" fruit from the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd tree and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" fruits from the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st tree. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" On the third day collect the remaining fruits from the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd tree. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second sample, you can only collect "},{"kind":"math_inline","text":"60"},{"kind":"text","text":" fruits, the remaining fruit will simply wither."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"441B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/441/problem/B"}