{"assets":[],"contentKind":"statement","contestId":"194","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Exams"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day the Codeforces round author sat exams. He had "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" exams and he needed to get an integer from "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" for each exam. He will have to re-sit each failed exam, i.e. the exam that gets mark "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The author would need to spend too much time and effort to make the sum of his marks strictly more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". That could have spoilt the Codeforces round. On the other hand, if the sum of his marks is strictly less than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", the author's mum won't be pleased at all. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Codeforces authors are very smart and they always get the mark they choose themselves. Also, the Codeforces authors just hate re-sitting exams. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the author and find the minimum number of exams he will have to re-sit if he passes the exams in the way that makes the sum of marks for all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" exams equal exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single input line contains space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 250"},{"kind":"text","text":") — the number of exams and the required sum of marks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there exists a way to pass "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" exams in the way that makes the sum of marks equal exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the single number — the minimum number of exams that the author will get a "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" for, considering that the sum of marks for all exams must equal "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the author has to get a "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" for all his exams."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample he should get a "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" for two exams and a "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" for two more."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample he should get a "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" for one exam."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"194A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/194/problem/A"}