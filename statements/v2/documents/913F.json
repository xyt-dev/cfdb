{"assets":["/statement-assets/2091fdbacaac7bff862f3689d3674b8b928ccbc0035ced7bb8e22a77e3b7b5bd.png","/statement-assets/605738d52242c6a62cf07a8d98ef7d540b0087f3d7a3905faf89d227f15eb177.png","/statement-assets/6b9879b708dee83d6e21755d823e2b71ea18ff41e7f2d611027b4fea4923d607.png","/statement-assets/ce9e36e0c1499fff629990952ec0045d9f3eb758069dcada5f5381ecf75efc7c.png","/statement-assets/824b3adb963befafc1763baee74caacf7f0cc853c89c7f89827a51606b563bb4.png","/statement-assets/9a19552af58140e4c9e3e2ea7d886b91696b35bb60b65e8a85412c5430ba9c87.png","/statement-assets/8592f9e473d3a765c38e90997a7eec8b155495255313307d27bf62619a6ce00a.png"],"contentKind":"statement","contestId":"913","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Strongly Connected Tournament"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a chess tournament in All-Right-City. "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" players were invited to take part in the competition. The tournament is held by the following rules:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Initially, each player plays one game with every other player. There are no ties; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After that, the organizers build a complete directed graph with players as vertices. For every pair of players there is exactly one directed edge between them: the winner of their game is the startpoint of this edge and the loser is the endpoint; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After that, the organizers build a condensation of this graph. The condensation of this graph is an acyclic complete graph, therefore it has the only Hamiltonian path which consists of strongly connected components of initial graph "},{"kind":"math_inline","text":"A1 → A2 → ... → Ak"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The players from the first component "},{"kind":"math_inline","text":"A1"},{"kind":"text","text":" are placed on the first "},{"attrs":{"alt":"","src":"/statement-assets/2091fdbacaac7bff862f3689d3674b8b928ccbc0035ced7bb8e22a77e3b7b5bd.png"},"kind":"image"},{"kind":"text","text":" places, the players from the component "},{"kind":"math_inline","text":"A2"},{"kind":"text","text":" are placed on the next "},{"attrs":{"alt":"","src":"/statement-assets/605738d52242c6a62cf07a8d98ef7d540b0087f3d7a3905faf89d227f15eb177.png"},"kind":"image"},{"kind":"text","text":" places, and so on. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" To determine exact place of each player in a strongly connected component, all the procedures from 1 to 5 are repeated recursively inside each component, i.e. for every "},{"kind":"math_inline","text":"i = 1, 2, ..., k"},{"kind":"text","text":" players from the component "},{"kind":"math_inline","text":"Ai"},{"kind":"text","text":" play games with each other again, and so on; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If a component consists of a single player, then he has no more rivals, his place is already determined and the process stops. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The players are enumerated with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The enumeration was made using results of a previous tournament. It is known that player "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" wins player "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"i < j"},{"kind":"text","text":") with probability "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to help to organize the tournament. Find the expected value of total number of games played by all the players. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It can be shown that the answer can be represented as "},{"attrs":{"alt":"","src":"/statement-assets/6b9879b708dee83d6e21755d823e2b71ea18ff41e7f2d611027b4fea4923d607.png"},"kind":"image"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"P"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Q"},{"kind":"text","text":" are coprime integers and "},{"attrs":{"alt":"","src":"/statement-assets/ce9e36e0c1499fff629990952ec0045d9f3eb758069dcada5f5381ecf75efc7c.png"},"kind":"image"},{"kind":"text","text":". Print the value of "},{"kind":"math_inline","text":"P·Q - 1"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"998244353"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If you are not familiar with any of the terms above, you can read about them "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Strongly_connected_component"},"children":[{"kind":"text","text":"here"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2000"},{"kind":"text","text":") — the number of players."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a < b ≤ 100"},{"kind":"text","text":") — the numerator and the denominator of fraction "},{"attrs":{"alt":"","src":"/statement-assets/824b3adb963befafc1763baee74caacf7f0cc853c89c7f89827a51606b563bb4.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line print the expected value of total number of games played by all the players. Print the answer using the format above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n4 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"142606340\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"598946623\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the expected value is "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the expected value is "},{"attrs":{"alt":"","src":"/statement-assets/9a19552af58140e4c9e3e2ea7d886b91696b35bb60b65e8a85412c5430ba9c87.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example the expected value is "},{"attrs":{"alt":"","src":"/statement-assets/8592f9e473d3a765c38e90997a7eec8b155495255313307d27bf62619a6ce00a.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"913F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/913/problem/F"}