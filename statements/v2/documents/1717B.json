{"assets":[],"contentKind":"statement","contestId":"1717","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Madoka and Underground Competitions"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Madoka decided to participate in an underground sports programming competition. And there was exactly one task in it:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A square table of size $$$n \\times n$$$, where "},{"children":[{"kind":"text","text":"$$$n$$$ is a multiple of $$$k$$$"}],"kind":"container"},{"kind":"text","text":", is called "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if only the characters "},{"children":[{"kind":"text","text":"'.'"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"'X'"}],"kind":"container"},{"kind":"text","text":" are written in it, as well as in any subtable of size $$$1 \\times k$$$ or $$$k \\times 1$$$, there is at least one character "},{"children":[{"kind":"text","text":"'X'"}],"kind":"container"},{"kind":"text","text":". In other words, among any $$$k$$$ consecutive vertical or horizontal cells, there must be at least one containing the character "},{"children":[{"kind":"text","text":"'X'"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Output any "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" table that has the "},{"children":[{"kind":"text","text":"minimum"}],"kind":"container"},{"kind":"text","text":" possible number of characters "},{"children":[{"kind":"text","text":"'X'"}],"kind":"container"},{"kind":"text","text":", and also the symbol "},{"children":[{"kind":"text","text":"'X'"}],"kind":"container"},{"kind":"text","text":" is written in the cell $$$(r, c)$$$. Rows are numbered from $$$1$$$ to $$$n$$$ from top to bottom, columns are numbered from $$$1$$$ to $$$n$$$ from left to right."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of multiple test cases. The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 100$$$) — the number of test cases. Description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first and the only line of each test case contains four integers $$$n$$$, $$$k$$$, $$$r$$$, $$$c$$$ ($$$1 \\le n \\le 500, 1 \\le k \\le n, 1 \\le r, c \\le n$$$) — the size of the table, the integer $$$k$$$ and the coordinates of the cell, which must contain the character "},{"children":[{"kind":"text","text":"'X'"}],"kind":"container"},{"kind":"text","text":". It is guaranteed that $$$n$$$ is a multiple of $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$500$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output $$$n$$$ lines, each consisting of $$$n$$$ characters "},{"children":[{"kind":"text","text":"'.'"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"'X'"}],"kind":"container"},{"kind":"text","text":", — the desired table. If there are several answers, then you can output anyone."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n3 3 3 2\n2 1 1 2\n6 3 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nX..\n..X\n.X.\nXX\nXX\n.X..X.\nX..X..\n..X..X\n.X..X.\nX..X..\n..X..X\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's analyze the first test case."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following tables can be printed as the correct answer:"}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"X.."}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"..X"}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":".X."}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"},{"kind":"text","text":" or "},{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"..X"}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"X.."}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"heade