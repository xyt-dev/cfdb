{"assets":[],"contentKind":"statement","contestId":"1475","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. New Year's Number"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp remembered the $$$2020$$$-th year, and he is happy with the arrival of the new $$$2021$$$-th year. To remember such a wonderful moment, Polycarp wants to represent the number $$$n$$$ as the sum of a certain number of $$$2020$$$ and a certain number of $$$2021$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$n=4041$$$, then the number $$$n$$$ can be represented as the sum $$$2020 + 2021$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$n=4042$$$, then the number $$$n$$$ can be represented as the sum $$$2021 + 2021$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$n=8081$$$, then the number $$$n$$$ can be represented as the sum $$$2020 + 2020 + 2020 + 2021$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$n=8079$$$, then the number $$$n$$$ cannot be represented as the sum of the numbers $$$2020$$$ and $$$2021$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Polycarp to find out whether the number $$$n$$$ can be represented as the sum of a certain number of numbers $$$2020$$$ and a certain number of numbers $$$2021$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"chi