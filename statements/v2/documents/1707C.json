{"assets":["/statement-assets/eec393f3e453df452d190a57652f4729c18f015843896880535ec572f908eae3.png"],"contentKind":"statement","contestId":"1707","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. DFS Trees"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a connected undirected graph consisting of $$$n$$$ vertices and $$$m$$$ edges. The weight of the $$$i$$$-th edge is $$$i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here is a wrong algorithm of finding a "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Minimum_spanning_tree"},"children":[{"kind":"text","text":"minimum spanning tree"}],"kind":"link"},{"kind":"text","text":" (MST) of a graph:"}],"kind":"paragraph"},{"kind":"code_block","text":"\nvis := an array of length n\ns := a set of edges\n\nfunction dfs(u):\n    vis[u] := true\n    iterate through each edge (u, v) in the order from smallest to largest edge weight\n        if vis[v] = false\n            add edge (u, v) into the set (s)\n            dfs(v)\n\nfunction findMST(u):\n    reset all elements of (vis) to false\n    reset the edge set (s) to empty\n    dfs(u)\n    return the edge set (s)\n"},{"children":[{"kind":"text","text":"Each of the calls "},{"children":[{"kind":"text","text":"findMST(1)"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"findMST(2)"}],"kind":"container"},{"kind":"text","text":", ..., "},{"children":[{"kind":"text","text":"findMST(n)"}],"kind":"container"},{"kind":"text","text":" gives you a spanning tree of the graph. Determine which of these trees are minimum spanning trees."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers $$$n$$$, $$$m$$$ ($$$2\\le n\\le 10^5$$$, $$$n-1\\le m\\le 2\\cdot 10^5$$$) — the number of vertices and the number of edges in the graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following $$$m$$$ lines contains two integers $$$u_i$$$ and $$$v_i$$$ ($$$1\\le u_i, v_i\\le n$$$, $$$u_i\\ne v_i$$$), describing an undirected edge $$$(u_i,v_i)$$$ in the graph. The $$$i$$$-th edge in the input has weight $$$i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the graph is connected and there is at most one edge between any pair of vertices."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"You need to output a binary string $$$s$$$, where $$$s_i=1$$$ if "},{"children":[{"kind":"text","text":"findMST(i)"}],"kind":"container"},{"kind":"text","text":" creates an MST, and $$$s_i = 0$$$ otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 5\n1 2\n3 5\n1 3\n3 2\n4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n01111\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10 11\n1 2\n2 5\n3 4\n4 2\n8 1\n4 5\n10 5\n9 5\n8 2\n5 7\n4 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0011111011\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here is the graph given in the first example."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/eec393f3e453df452d190a57652f4729c18f015843896880535ec572f908eae3.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"There is only one minimum spanning tree in this graph. A minimum spanning tree is $$$(1,2),(3,5),(1,3),(2,4)$$$ which has weight $$$1+2+3+5=11$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here is a part of the process of calling "},{"children":[{"kind":"text","text":"findMST(1)"}],"kind":"container"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" reset the array "},{"children":[{"kind":"text","text":"vis"}],"kind":"container"},{"kind":"text","text":" and the edge set "},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" calling "},{"children":[{"kind":"text","text":"dfs(1)"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"vis[1] := true"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" iterate through each edge $$$(1,2),(1,3)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" add edge $$$(1,2)$$$ into the edge set "},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":", calling "},{"children":[{"kind":"text","text":"dfs(2)"}],"kind":"container"},{"kind":"text","text":": "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"vis[2] := true"}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"text","text":" iterate through each edge $$$(2,1),(2,3),(2,4)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" because "},{"children":[{"kind":"text","text":"vis[1] = true"}],"kind":"container"},{"kind":"text","text":", ignore the edge $$$(2,1)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" add edge $$$(2,3)$$$ into the edge set "},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":", calling "},{"children":[{"kind":"text","text":"dfs(3)"}],"kind":"container"},{"kind":"text","text":": "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"text","text":" ... "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the end, it will select edges $$$(1,2),(2,3),(3,5),(2,4)$$$ with total weight $$$1+4+2+5=12 \\gt 11$$$, so "},{"children":[{"kind":"text","text":"findMST(1)"}],"kind":"container"},{"kind":"text","text":" does not find a minimum spanning tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It can be shown that the other trees are all MSTs, so the answer is "},{"children":[{"kind":"text","text":"01111"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1707C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1707/problem/C"}