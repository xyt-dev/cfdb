{"assets":["/statement-assets/96db0fe0b336702962ad5b5402374d1599590c26d604447a0f14e37a5b4e59fd.png","/statement-assets/b09298793221a249ffcb1eb535ee78665ead7661416dfcb867637bc74ba5b2ea.png","/statement-assets/42022762d40bc7ce01415c73af769aa99387756dd7b458d8f9f8815d8bbe8aa1.png","/statement-assets/ce68d7f49264867d152fab5bd144cb179978b4b3e174b7d45db5d456877ba546.png","/statement-assets/708a483384869d3cf5cb3f9bc5ac94d5dccf0e1b99ad54621f801fbad3681038.png","/statement-assets/7eece282f105b4bf0cd1d96f11e051c72f3277ed12c449cc98f006724cfdd76a.png","/statement-assets/0731f502fcbfa320e239917c900b01f4a597ffda314e6000e665a45a532c7b35.png","/statement-assets/b545d01867ccb0470f3cd2737493d5352dcba473535eaac7cdedf25b2ba85cd8.png","/statement-assets/824d703eb2aec6418104a16eb942ece6aff07a83a0c4ae51589e01ddeed72e5f.png","/statement-assets/6c403dc50f3f9966dff7e48a7a94ff9b31f29c7b1e1c86aef41921b056c6b10f.png"],"contentKind":"statement","contestId":"821","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Okabe and El Psy Kongroo"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Okabe likes to take walks but knows that spies from the Organization could be anywhere; that's why he wants to know how many different walks he can take in his city safely. Okabe's city can be represented as all points "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" are non-negative. Okabe starts at the origin (point "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":"), and needs to reach the point "},{"kind":"math_inline","text":"(k, 0)"},{"kind":"text","text":". If Okabe is currently at the point "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":", in one step he can go to "},{"kind":"math_inline","text":"(x + 1, y + 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(x + 1, y)"},{"kind":"text","text":", or "},{"kind":"math_inline","text":"(x + 1, y - 1)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additionally, there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" horizontal line segments, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of which goes from "},{"kind":"math_inline","text":"x = ai"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"x = bi"},{"kind":"text","text":" inclusive, and is at "},{"kind":"math_inline","text":"y = ci"},{"kind":"text","text":". It is guaranteed that "},{"kind":"math_inline","text":"a1 = 0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"an ≤ k ≤ bn"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"ai = bi - 1"},{"kind":"text","text":" for "},{"kind":"math_inline","text":"2 ≤ i ≤ n"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line segment forces Okabe to walk with "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"-value in the range "},{"kind":"math_inline","text":"0 ≤ y ≤ ci"},{"kind":"text","text":" when his "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" value satisfies "},{"kind":"math_inline","text":"ai ≤ x ≤ bi"},{"kind":"text","text":", or else he might be spied on. This also means he is required to be under two line segments when one segment ends and another begins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Okabe now wants to know how many walks there are from the origin to the point "},{"kind":"math_inline","text":"(k, 0)"},{"kind":"text","text":" satisfying these conditions, modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains the integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 1018"},{"kind":"text","text":") — the number of segments and the destination "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" coordinate."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain three space-separated integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai < bi ≤ 1018"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ ci ≤ 15"},{"kind":"text","text":") — the left and right ends of a segment, and its "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" coordinate."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that "},{"kind":"math_inline","text":"a1 = 0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"an ≤ k ≤ bn"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"ai = bi - 1"},{"kind":"text","text":" for "},{"kind":"math_inline","text":"2 ≤ i ≤ n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of walks satisfying the conditions, modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n0 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 6\n0 3 0\n3 10 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/96db0fe0b336702962ad5b5402374d1599590c26d604447a0f14e37a5b4e59fd.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The graph above corresponds to sample 1. The possible walks are:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"alt":"","src":"/statement-assets/b09298793221a249ffcb1eb535ee78665ead7661416dfcb867637bc74ba5b2ea.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"attrs":{"