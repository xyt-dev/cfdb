{"assets":[],"contentKind":"statement","contestId":"685","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Optimal Point"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"When the river brought Gerda to the house of the Old Lady who Knew Magic, this lady decided to make Gerda her daughter. She wants Gerda to forget about Kay, so she puts all the roses from the garden underground."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mole, who lives in this garden, now can watch the roses without going up to the surface. Typical mole is blind, but this mole was granted as special vision by the Old Lady. He can watch any underground objects on any distance, even through the obstacles and other objects. However, the quality of the picture depends on the Manhattan distance to object being observed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mole wants to find an "},{"children":[{"kind":"text","text":"optimal"}],"kind":"container"},{"kind":"text","text":" point to watch roses, that is such point with "},{"children":[{"kind":"text","text":"integer coordinates"}],"kind":"container"},{"kind":"text","text":" that the maximum Manhattan distance to the rose is minimum possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As usual, he asks you to help."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Manhattan distance"}],"kind":"container"},{"kind":"text","text":" between points "},{"kind":"math_inline","text":"(x1,  y1,  z1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(x2,  y2,  z2)"},{"kind":"text","text":" is defined as "},{"kind":"math_inline","text":"|x1 - x2| + |y1 - y2| + |z1 - z2|"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 100 000"},{"kind":"text","text":") — the number of test cases. Then follow exactly "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" blocks, each containing the description of exactly one test."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each block contains an integer "},{"kind":"math_inline","text":"ni"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ni ≤ 100 000"},{"kind":"text","text":") — the number of roses in the test. Then follow "},{"kind":"math_inline","text":"ni"},{"kind":"text","text":" lines, containing three integers each — the coordinates of the corresponding rose. Note that two or more roses may share the same position."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the sum of all "},{"kind":"math_inline","text":"ni"},{"kind":"text","text":" doesn't exceed "},{"kind":"math_inline","text":"100 000"},{"kind":"text","text":" and all coordinates are not greater than "},{"kind":"math_inline","text":"1018"},{"kind":"text","text":" by their absolute value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each of "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" test cases print three integers — the coordinates of the optimal point to watch roses. If there are many optimal answers, print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The coordinates of the optimal point may coincide with the coordinates of any rose."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n5\n0 0 4\n0 0 -4\n0 4 0\n4 0 0\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 0 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n3 5 9\n2\n3 5 9\n3 5 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 5 9\n3 5 9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the maximum Manhattan distance from the point to the rose is equal to "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the maximum possible distance is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". Note that the positions of the roses may coincide with each other and with the position of the optimal point."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"685C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/685/problem/C"}