{"assets":[],"contentKind":"statement","contestId":"327","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Magic Five"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a long plate "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" containing "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" digits. Iahub wants to delete some digits (possibly none, but he is not allowed to delete all the digits) to form his \"magic number\" on the plate, a number that is divisible by "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". Note that, the resulting number may contain leading zeros."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Iahub wants to count the number of ways he can obtain magic number, modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"). Two ways are different, if the set of deleted positions in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" differs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Look at the input part of the statement, "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is given in a special form."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line you're given a string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |a| ≤ 105"},{"kind":"text","text":"), containing digits only. In the second line you're given an integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 109"},{"kind":"text","text":"). The plate "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is formed by concatenating "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" copies of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" together. That is "},{"kind":"math_inline","text":"n = |a|·k"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the required number of ways modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1256\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"13990\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"528\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"555\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"63\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first case, there are four possible ways to make a number that is divisible by 5: 5, 15, 25 and 125."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second case, remember to concatenate the copies of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". The actual plate is 1399013990."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third case, except deleting all digits, any choice will do. Therefore there are "},{"kind":"math_inline","text":"26 - 1 = 63"},{"kind":"text","text":" possible ways to delete digits."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"327C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/327/problem/C"}