{"assets":[],"contentKind":"statement","contestId":"372","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Choosing Subtree is Fun"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a tree consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. The vertices are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define the length of an interval "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":" as the value "},{"kind":"math_inline","text":"r - l + 1"},{"kind":"text","text":". The score of a subtree of this tree is the maximum length of such an interval "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":" that, the vertices with numbers "},{"kind":"math_inline","text":"l, l + 1, ..., r"},{"kind":"text","text":" belong to the subtree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Considering all subtrees of the tree whose size is at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", return the maximum score of the subtree. Note, that in this problem tree is not rooted, so a subtree — is an arbitrary connected subgraph of the tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"There are two integers in the first line, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 105"},{"kind":"text","text":"). Each of the next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n, ai ≠ bi"},{"kind":"text","text":"). That means "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" are connected by a tree edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the input represents a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output should contain a single integer — the maximum possible score."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 6\n4 10\n10 6\n2 9\n9 6\n8 5\n7 1\n4 7\n7 3\n1 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"16 7\n13 11\n12 11\n2 14\n8 6\n9 15\n16 11\n5 14\n6 15\n4 3\n11 15\n15 14\n10 1\n3 14\n14 7\n1 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first case, there is some subtree whose size is at most "},{"kind":"math_inline","text":"6"},{"kind":"text","text":", including "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" consecutive numbers of vertices. For example, the subtree that consists of "},{"kind":"math_inline","text":"{1, 3, 4, 5, 7, 8}"},{"kind":"text","text":" or of "},{"kind":"math_inline","text":"{1, 4, 6, 7, 8, 10}"},{"kind":"text","text":" includes "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" consecutive numbers of vertices. But there is no subtree whose size is at most "},{"kind":"math_inline","text":"6"},{"kind":"text","text":", which includes "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" or more consecutive numbers of vertices."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"372D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/372/problem/D"}