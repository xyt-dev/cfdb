{"assets":["/statement-assets/b5bb2fad08c1c52c479438b4c270b063efac273d81ac294e7fed1cb5741ca779.png"],"contentKind":"statement","contestId":"761","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Dasha and Very Difficult Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dasha logged into the system and began to solve problems. One of them is as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given two sequences "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" each you need to write a sequence "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th element of which is calculated as follows: "},{"kind":"math_inline","text":"ci = bi - ai"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"About sequences "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" we know that their elements are in the range from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":". More formally, elements satisfy the following conditions: "},{"kind":"math_inline","text":"l ≤ ai ≤ r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"l ≤ bi ≤ r"},{"kind":"text","text":". About sequence "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" we know that all its elements are distinct."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b5bb2fad08c1c52c479438b4c270b063efac273d81ac294e7fed1cb5741ca779.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Dasha wrote a solution to that problem quickly, but checking her work on the standard test was not so easy. Due to an error in the test system only the sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and the "},{"children":[{"kind":"text","text":"compressed sequence"}],"kind":"container"},{"kind":"text","text":" of the sequence "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" were known from that test."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's give the definition to a "},{"children":[{"kind":"text","text":"compressed sequence"}],"kind":"container"},{"kind":"text","text":". A "},{"children":[{"kind":"text","text":"compressed sequence"}],"kind":"container"},{"kind":"text","text":" of sequence "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is a sequence "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", so that "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" equals to the number of integers which are less than or equal to "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" in the sequence "},{"kind":"math_inline","text":"c"},{"kind":"text","text":". For example, for the sequence "},{"kind":"math_inline","text":"c = [250, 200, 300, 100, 50]"},{"kind":"text","text":" the compressed sequence will be "},{"kind":"math_inline","text":"p = [4, 3, 5, 2, 1]"},{"kind":"text","text":". Pay attention that in "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" all integers are distinct. Consequently, the "},{"children":[{"kind":"text","text":"compressed sequence"}],"kind":"container"},{"kind":"text","text":" contains all integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" inclusively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Dasha to find any sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" for which the calculated "},{"children":[{"kind":"text","text":"compressed sequence"}],"kind":"container"},{"kind":"text","text":" of sequence "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" is correct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105, 1 ≤ l ≤ r ≤ 109)"},{"kind":"text","text":" — the length of the sequence and boundaries of the segment where the elements of sequences "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1,  a2,  ...,  an"},{"kind":"math_inline","text":"(l ≤ ai ≤ r)"},{"kind":"text","text":" — the elements of the sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"p1,  p2,  ...,  pn"},{"kind":"math_inline","text":"(1 ≤ pi ≤ n)"},{"kind":"text","text":" — the "},{"children":[{"kind":"text","text":"compressed sequence"}],"kind":"container"},{"kind":"text","text":" of the sequence "},{"kind":"math_inline","text":"c"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no the suitable sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", then in the only line print \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, in the only line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers — the elements of any suitable sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1 5\n1 1 1 1 1\n3 1 5 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 1 5 4 2 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 9\n3 4 8 9\n3 2 1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 2 2 9 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 1 5\n1 1 1 1 1 1\n2 3 5 4 1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" which was found in the second sample is suitable, because calculated sequence "},{"kind":"math_inline","text":"c = [2 - 3, 2 - 4, 2 - 8, 9 - 9] = [ - 1,  - 2,  - 6, 0]"},{"kind":"text","text":" (note that "},{"kind":"math_inline","text":"ci = bi - ai"},{"kind":"text","text":") has compressed sequence equals to "},{"kind":"math_inline","text":"p = [3, 2, 1, 4]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"761D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/761/problem/D"}