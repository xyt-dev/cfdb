{"assets":["/statement-assets/fe17e556bb0253d5f473e53785feb9ebbe84b5e89bfd0c55af024510f064e658.png"],"contentKind":"statement","contestId":"371","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. K-Periodic Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"This task will exclusively concentrate only on the arrays where all elements equal 1 and/or 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-period if its length is divisible by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and there is such array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is represented by array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" written exactly "},{"attrs":{"alt":"","src":"/statement-assets/fe17e556bb0253d5f473e53785feb9ebbe84b5e89bfd0c55af024510f064e658.png"},"kind":"image"},{"kind":"text","text":" times consecutively. In other words, array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-periodic, if it has period of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, any array is "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-periodic, where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the array length. Array "},{"kind":"math_inline","text":"[2, 1, 2, 1, 2, 1]"},{"kind":"text","text":" is at the same time 2-periodic and 6-periodic and array "},{"kind":"math_inline","text":"[1, 2, 1, 1, 2, 1, 1, 2, 1]"},{"kind":"text","text":" is at the same time 3-periodic and 9-periodic."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the given array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", consisting only of numbers one and two, find the minimum number of elements to change to make the array "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-periodic. If the array already is "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-periodic, then the required value equals "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a pair of integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 100)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the length of the array and the value "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is divisible by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". The second line contains the sequence of elements of the given array "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 2"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th element of the array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of array elements we need to change to make the array "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-periodic. If the array already is "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-periodic, then print "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2\n2 1 2 2 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 4\n1 1 2 1 1 1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9 3\n2 1 1 1 2 1 1 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample it is enough to change the fourth element from "},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", then the array changes to "},{"kind":"math_inline","text":"[2, 1, 2, 1, 2, 1]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the given array already is 4-periodic."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample it is enough to replace each occurrence of number two by number one. In this case the array will look as "},{"kind":"math_inline","text":"[1, 1, 1, 1, 1, 1, 1, 1, 1]"},{"kind":"text","text":" — this array is simultaneously 1-, 3- and 9-periodic."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"371A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/371/problem/A"}