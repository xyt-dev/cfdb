{"assets":[],"contentKind":"statement","contestId":"293","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Weird Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Yaroslav, Andrey and Roman can play cubes for hours and hours. But the game is for three, so when Roman doesn't show up, Yaroslav and Andrey play another game. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Roman leaves a word for each of them. Each word consists of "},{"kind":"math_inline","text":"2·n"},{"kind":"text","text":" binary characters \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\". After that the players start moving in turns. Yaroslav moves first. During a move, a player must choose an integer from 1 to "},{"kind":"math_inline","text":"2·n"},{"kind":"text","text":", which hasn't been chosen by anybody up to that moment. Then the player takes a piece of paper and writes out the corresponding character from his string. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's represent Yaroslav's word as "},{"kind":"math_inline","text":"s = s1s2... s2n"},{"kind":"text","text":". Similarly, let's represent Andrey's word as "},{"kind":"math_inline","text":"t = t1t2... t2n"},{"kind":"text","text":". Then, if Yaroslav choose number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" during his move, then he is going to write out character "},{"kind":"math_inline","text":"sk"},{"kind":"text","text":" on the piece of paper. Similarly, if Andrey choose number "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" during his move, then he is going to write out character "},{"kind":"math_inline","text":"tr"},{"kind":"text","text":" on the piece of paper."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The game finishes when no player can make a move. After the game is over, Yaroslav makes some integer from the characters written on his piece of paper (Yaroslav can arrange these characters as he wants). Andrey does the same. The resulting numbers can contain leading zeroes. The person with the largest number wins. If the numbers are equal, the game ends with a draw."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given two strings "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Determine the outcome of the game provided that Yaroslav and Andrey play optimally well."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":"). The second line contains string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" — Yaroslav's word. The third line contains string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — Andrey's word."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that both words consist of "},{"kind":"math_inline","text":"2·n"},{"kind":"text","text":" characters \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"First"}],"kind":"container"},{"kind":"text","text":"\", if both players play optimally well and Yaroslav wins. If Andrey wins, print \""},{"children":[{"kind":"text","text":"Second"}],"kind":"container"},{"kind":"text","text":"\" and if the game ends with a draw, print \""},{"children":[{"kind":"text","text":"Draw"}],"kind":"container"},{"kind":"text","text":"\". Print the words without the quotes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n0111\n0001\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"First\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n110110\n001001\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"First\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n111000\n000111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Draw\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n01010110\n00101101\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"First\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n01100000\n10010011\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Second\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"293A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/293/problem/A"}