{"assets":[],"contentKind":"statement","contestId":"893","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Subtree Minimum Query"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"6 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a rooted tree consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. Each vertex has a number written on it; number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is written on vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's denote "},{"kind":"math_inline","text":"d(i, j)"},{"kind":"text","text":" as the distance between vertices "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" in the tree (that is, the number of edges in the shortest path from "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"). Also let's denote the "},{"children":[{"kind":"math_inline","text":"k"},{"kind":"text","text":"-blocked subtree"}],"kind":"container"},{"kind":"text","text":" of vertex "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" as the set of vertices "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" such that both these conditions are met:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"x"},{"kind":"text","text":" is an ancestor of "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" (every vertex is an ancestor of itself); "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"d(x, y) ≤ k"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries to the tree. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query is represented by two numbers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":", and the answer to this query is the minimum value of "},{"kind":"math_inline","text":"aj"},{"kind":"text","text":" among such vertices "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" belongs to "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":"-blocked subtree of "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Write a program that would process these queries quickly!"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note that the queries are given in a modified way"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ r ≤ n ≤ 100000"},{"kind":"text","text":") — the number of vertices in the tree and the index of the root, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — the numbers written on the vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines follow, each containing two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x, y ≤ n"},{"kind":"text","text":") and representing an edge between vertices "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". It is guaranteed that these edges form a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains one integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 106"},{"kind":"text","text":") — the number of queries to process."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follow, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line containing two numbers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"qi"},{"kind":"text","text":", which can be used to restore "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query ("},{"kind":"math_inline","text":"1 ≤ pi, qi ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query can be restored as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"last"},{"kind":"text","text":" be the answer for previous query (or "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" if "},{"kind":"math_inline","text":"i = 1"},{"kind":"tex