{"assets":["/statement-assets/07e0531b910aac07815eb683ce14dfd8e8cc737150d2bed311398a90cfe628f8.png","/statement-assets/e0c91f416fa69331a16e3884d471db4171c91f832efbd5c501e20753fcc2b774.png"],"contentKind":"statement","contestId":"268","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Beautiful Sets of Points"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Manao has invented a new mathematical term — a beautiful set of points. He calls a set of points on a plane "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if it meets the following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The coordinates of each point in the set are integers. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For any two points from the set, the distance between them is a non-integer. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Consider all points "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" which satisfy the inequations: "},{"kind":"math_inline","text":"0 ≤ x ≤ n"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"0 ≤ y ≤ m"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"x + y > 0"},{"kind":"text","text":". Choose their subset of maximum size such that it is also a beautiful set of points."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single integer — the size "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" of the found beautiful set. In each of the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines print a pair of space-separated integers — the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"- and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"- coordinates, respectively, of a point from the set."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several optimal solutions, you may print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n0 1\n1 2\n2 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 3\n2 1\n3 0\n4 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first sample. The distance between points (0, 1) and (1, 2) equals "},{"attrs":{"alt":"","src":"/statement-assets/07e0531b910aac07815eb683ce14dfd8e8cc737150d2bed311398a90cfe628f8.png"},"kind":"image"},{"kind":"text","text":", between (0, 1) and (2, 0) — "},{"attrs":{"alt":"","src":"/statement-assets/e0c91f416fa69331a16e3884d471db4171c91f832efbd5c501e20753fcc2b774.png"},"kind":"image"},{"kind":"text","text":", between (1, 2) and (2, 0) — "},{"attrs":{"alt":"","src":"/statement-assets/e0c91f416fa69331a16e3884d471db4171c91f832efbd5c501e20753fcc2b774.png"},"kind":"image"},{"kind":"text","text":". Thus, these points form a beautiful set. You cannot form a beautiful set with more than three points out of the given points. Note that this is not the only solution."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"268C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/268/problem/C"}