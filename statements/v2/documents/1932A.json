{"assets":["/statement-assets/3a8e90ccca0fd40c3fe33ea704809b8f06e7ad09a0c134693e66d2891eaae118.png","/statement-assets/28c78ef56a9554b71dccaf45b320937b1fe2e261633ec49a182709b1d3e77bf9.png","/statement-assets/7de129405763d7a465fc2b8333d7302042ede5095fac24c8b765d1d5e7edf380.png"],"contentKind":"statement","contestId":"1932","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Thorns and Coins"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"During your journey through computer universes, you stumbled upon a very interesting world. It is a path with $$$n$$$ consecutive cells, each of which can either be empty, contain thorns, or a coin. In one move, you can move one or two cells along the path, provided that the destination cell does not contain thorns (and belongs to the path). If you move to the cell with a coin, you pick it up."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/3a8e90ccca0fd40c3fe33ea704809b8f06e7ad09a0c134693e66d2891eaae118.png"},"kind":"image"},{"children":[{"kind":"text","text":"Here, green arrows correspond to legal moves, and the red arrow corresponds to an illegal move."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"You want to collect as many coins as possible. Find the maximum number of coins you can collect in the discovered world if you start in the leftmost cell of the path."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases. Then the descriptions of the test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 50$$$) — the length of the path."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string of $$$n$$$ characters, the description of the path. The character "},{"children":[{"kind":"text","text":"'.'"}],"kind":"container"},{"kind":"text","text":" denotes an empty cell, "},{"children":[{"kind":"text","text":"'@'"}],"kind":"container"},{"kind":"text","text":" denotes a cell with a coin, and "},{"children":[{"kind":"text","text":"'*'"}],"kind":"container"},{"kind":"text","text":" denotes a cell with thorns. It is guaranteed that the first cell is empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer, the maximum number of coins you can collect."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n10\n.@@*@.**@@\n5\n.@@@@\n15\n.@@..@***..@@@*\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n4\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The picture for the first example is in the problem statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here is the picture for the second example:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/28c78ef56a9554b71dccaf45b320937b1fe2e261633ec49a182709b1d3e77bf9.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"And here is the picture for the third example:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/7de129405763d7a465fc2b8333d7302042ede5095fac24c8b765d1d5e7edf380.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1932A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1932/problem/A"}