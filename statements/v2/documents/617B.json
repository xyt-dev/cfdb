{"assets":[],"contentKind":"statement","contestId":"617","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Chocolate"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bob loves everything sweet. His favorite chocolate bar consists of pieces, each piece may contain a nut. Bob wants to break the bar of chocolate into multiple pieces so that each part would contain "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" one nut and any break line goes between two adjacent pieces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are asked to calculate the number of ways he can do it. Two ways to break chocolate are considered distinct if one of them contains a break between some two adjacent pieces and the other one doesn't. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please note, that if Bob doesn't make any breaks, all the bar will form one piece and it still has to have exactly one nut."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of pieces in the chocolate bar."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second 