{"assets":[],"contentKind":"statement","contestId":"691","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Couple Cover"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Couple Cover, a wildly popular luck-based game, is about to begin! Two players must work together to construct a rectangle. A bag with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" balls, each with an integer written on it, is placed on the table. The first player reaches in and grabs a ball randomly (all balls have equal probability of being chosen) — the number written on this ball is the rectangle's width in meters. This ball is not returned to the bag, and the second player reaches into the bag and grabs another ball — the number written on this ball is the rectangle's height in meters. If the area of the rectangle is greater than or equal some threshold "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" square meters, the players win. Otherwise, they lose."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The organizers of the game are trying to select an appropriate value for "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" so that the probability of a couple winning is not too high and not too low, but they are slow at counting, so they have hired you to answer some questions for them. You are given a list of the numbers written on the balls, the organizers would like to know how many winning pairs of balls exist for different values of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". Note that two pairs are different if either the first or the second ball is different between the two in pair, and two different balls with the same number are considered different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input begins with a single positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in its own line ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number in this line is equal to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 3·106"},{"kind":"text","text":"), the number written on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ball."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains an integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 106"},{"kind":"text","text":"), the number of questions you are being asked."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then, the following line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" positive integers — the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th number in this line is equal to the value of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ p ≤ 3·106"},{"kind":"text","text":") in the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th question you are being asked."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each question, print the number of winning pairs of balls that exist for the given value of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" in the separate line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n4 2 6 1 3\n4\n1 3 5 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20\n18\n14\n10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n5 6\n2\n30 31\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"691F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/691/problem/F"}