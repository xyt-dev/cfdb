{"assets":[],"contentKind":"statement","contestId":"199","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Hexadecimal's theorem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recently, a chaotic virus Hexadecimal advanced a new theorem which will shake the Universe. She thinks that each Fibonacci number can be represented as sum of three not necessary different Fibonacci numbers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's remember how Fibonacci numbers can be calculated. "},{"kind":"math_inline","text":"F0 = 0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"F1 = 1"},{"kind":"text","text":", and all the next numbers are "},{"kind":"math_inline","text":"Fi = Fi - 2 + Fi - 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, Fibonacci numbers make a sequence of numbers: "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"8"},{"kind":"text","text":", "},{"kind":"math_inline","text":"13"},{"kind":"text","text":", ..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If you haven't run away from the PC in fear, you have to help the virus. Your task is to divide given Fibonacci number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" by three not necessary different Fibonacci numbers or say that it is impossible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input contains of a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(0 ≤ n < 109)"},{"kind":"text","text":" — the number that should be represented by the rules described above. It is guaranteed that "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is a Fibonacci number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output three required numbers: "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":". If there is no answer for the test you have to print \""},{"children":[{"kind":"text","text":"I'm too stupid to solve this problem"}],"kind":"container"},{"kind":"text","text":"\" without the quotes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"13\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 3 8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"199A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/199/problem/A"}