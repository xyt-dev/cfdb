{"assets":[],"contentKind":"statement","contestId":"1660","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Get an Even String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A string $$$a=a_1a_2\\dots a_n$$$ is called "},{"children":[{"kind":"text","text":"even"}],"kind":"container"},{"kind":"text","text":" if it consists of a concatenation (joining) of strings of length $$$2$$$ consisting of the same characters. In other words, a string $$$a$$$ is even if two conditions are satisfied "},{"children":[{"kind":"text","text":"at the same time"}],"kind":"container"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" its length $$$n$$$ is even; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for all odd $$$i$$$ ($$$1 \\le i \\le n - 1$$$), $$$a_i = a_{i+1}$$$ is satisfied. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, the following strings are even: \""},{"kind":"container"},{"kind":"text","text":"\" (empty string), \""},{"children":[{"kind":"text","text":"tt"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"aabb"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"oooo"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"ttrrrroouuuuuuuukk"}],"kind":"container"},{"kind":"text","text":"\". The following strings are not even: \""},{"children":[{"kind":"text","text":"aaa"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abab"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"abba"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a string $$$s$$$ consisting of lowercase Latin letters. Find the minimum number of characters to remove from the string $$$s$$$ to make it even. The deleted characters do not have to be consecutive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input data contains an integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) —the number of test cases in the test."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The descriptions of the test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of one string $$$s$$$ ($$$1 \\le |s| \\le 2 \\cdot 10^5$$$), where $$$|s|$$$ — the length of the string $$$s$$$. The string consists of lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$|s|$$$ on all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single number — the minimum number of characters that must be removed to make $$$s$$$ even."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\naabbdabdccc\nzyx\naaababbb\naabbcc\noaoaaaoo\nbmefbmuyw\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n3\n2\n0\n2\n7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case you can remove the characters with indices $$$6$$$, $$$7$$$, and $$$9$$$ to get an even string \""},{"children":[{"kind":"text","text":"aabbddcc"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, each character occurs exactly once, so in order to get an even string, you must remove all characters from the string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, you can get an even string \""},{"children":[{"kind":"text","text":"aaaabb"}],"kind":"container"},{"kind":"text","text":"\" by removing, for example, $$$4$$$-th and $$$6$$$-th characters, or a string \""},{"children":[{"kind":"text","text":"aabbbb"}],"kind":"container"},{"kind":"text","text":"\" by removing the $$$5$$$-th character and any of the first three."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1660C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1660/problem/C"}