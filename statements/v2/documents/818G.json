{"assets":[],"contentKind":"statement","contestId":"818","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Four Melodies"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Author note: I think some of you might remember the problem \"Two Melodies\" from Eductational Codeforces Round 22. Now it's time to make it a bit more difficult!"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Alice is a composer, and recently she had recorded two tracks that became very popular. Now she has got a lot of fans who are waiting for new tracks. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This time Alice wants to form four melodies for her tracks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Alice has a sheet with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" notes written on it. She wants to take four such non-empty non-intersecting subsequences that all of them form a "},{"children":[{"kind":"text","text":"melody"}],"kind":"container"},{"kind":"text","text":" and sum of their lengths is maximal."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Subsequence is a sequence that can be derived from another sequence by deleting some elements without changing the order of the remaining elements."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Subsequence forms a melody when each two adjacent notes either differ by "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" or are congruent modulo "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You should write a program which will calculate maximum sum of lengths of such four non-empty non-intersecting subsequences that all of them form a melody."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"4 ≤ n ≤ 3000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 105"},{"kind":"text","text":") — notes written on a sheet."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print maximum sum of lengths of such four non-empty non-intersecting subsequences that all of them form a melody."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 3 5 7 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 3 5 7 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example it is possible to compose "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" melodies by choosing any "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" notes (and each melody will consist of only one note)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example it is possible to compose one melody with "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" notes — "},{"kind":"math_inline","text":"{1, 2}"},{"kind":"text","text":". Remaining notes are used in other three melodies (one note per each melody)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"818G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/818/problem/G"}