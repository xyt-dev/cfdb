,{"kind":"text","text":" becomes the leader. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"792B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/792/problem/B"}