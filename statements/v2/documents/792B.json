{"assets":[],"contentKind":"statement","contestId":"792","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Counting-out Rhyme"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"math_inline","text":"n"},{"kind":"text","text":" children are standing in a circle and playing the counting-out game. Children are numbered clockwise from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". In the beginning, the first child is considered the leader. The game is played in "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" steps. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th step the leader counts out "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" people in clockwise order, starting from the next person. The last one to be pointed at by the leader is eliminated, and the next player after him becomes the new leader."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if there are children with numbers "},{"kind":"math_inline","text":"[8, 10, 13, 14, 16]"},{"kind":"text","text":" currently in the circle, the leader is child "},{"kind":"math_inline","text":"13"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ai = 12"},{"kind":"text","text":", then counting-out rhyme ends on child "},{"kind":"math_inline","text":"16"},{"kind":"text","text":", who is eliminated. Child "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" becomes the leader."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to write a program which prints the number of the child to be eliminated on every step."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ n - 1"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"a1, a2, ..., ak"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" numbers, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th one corresponds to the number of child to be eliminated at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th step."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 5\n10 4 11 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind"