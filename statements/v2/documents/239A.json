{"assets":[],"contentKind":"statement","contestId":"239","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Two Bags of Potatoes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"0.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Valera had two bags of potatoes, the first of these bags contains $$$x$$$ $$$(x \\ge 1)$$$ potatoes, and the second — $$$y$$$ $$$(y \\ge 1)$$$ potatoes. Valera — a very scattered boy, so the first bag of potatoes (it contains $$$x$$$ potatoes) Valera lost. Valera remembers that the total amount of potatoes $$$(x + y)$$$ in the two bags, firstly, was not greater than $$$n$$$, and, secondly, was divisible by $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Valera to determine how many potatoes could be in the first bag. Print all such possible numbers in ascending order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains three integers $$$y$$$, $$$k$$$, $$$n$$$ ($$$1 \\le y, k, n \\le 10^9;$$$ $$$\\frac{n}{k}$$$ $$$\\le 10^5$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the list of whitespace-separated integers — all possible values of $$$x$$$ in ascending order. You should print each possible value of $$$x$$$ exactly once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are no such values of $$$x$$$, print a single integer $$$-1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 1 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 6 40\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 8 14 20 26 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"239A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/239/problem/A"}