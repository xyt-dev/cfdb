{"assets":[],"contentKind":"statement","contestId":"778","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Selling Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Boris really likes numbers and even owns a small shop selling interesting numbers. He has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" decimal numbers "},{"kind":"math_inline","text":"Bi"},{"kind":"text","text":". Cost of the number in his shop is equal to the sum of costs of its digits. You are given the values "},{"kind":"math_inline","text":"cd"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"cd"},{"kind":"text","text":" is the cost of the digit "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". Of course, Boris is interested in that numbers he owns have the maximum cost possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Recently Boris got hold of the magical artifact "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", which can allow him to increase the cost of his collection. Artifact is a string, consisting of digits and '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"' symbols. To use the artifact, Boris must replace all '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"' with digits to get a decimal number without leading zeros (it is also not allowed to get number 0). After that, the resulting number is added to all numbers "},{"kind":"math_inline","text":"Bi"},{"kind":"text","text":" in Boris' collection. He uses the artifact exactly once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the maximum cost of the collection Boris can achieve after using the artifact?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains artifact "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", consisting of digits '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"'–'"},{"children":[{"kind":"text","text":"9"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"' symbols ("},{"kind":"math_inline","text":"1 ≤ |A| ≤ 1000"},{"kind":"text","text":"). Next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the amount of numbers in Boris' collection ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":"). Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain integers "},{"kind":"math_inline","text":"Bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ Bi < 101000"},{"kind":"text","text":"). "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" doesn't start with '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Last line contains ten integers — costs of digits "},{"kind":"math_inline","text":"c0, c1, ..., c9"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ci ≤ 1000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one integer — the maximum possible cost of the collection after using the artifact."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"42\n3\n89\n1\n958\n0 0 1 1 2 2 3 3 4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"?5?\n4\n2203\n5229\n276\n6243\n2 1 6 1 1 2 5 2 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"62\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second sample input, the optimal way is to compose the number "},{"children":[{"kind":"text","text":"453"}],"kind":"container"},{"kind":"text","text":". After adding this number, Boris will have numbers "},{"children":[{"kind":"text","text":"2656"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"5682"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"729"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"6696"}],"kind":"container"},{"kind":"text","text":". The total cost of all digits in them is equal to "},{"kind":"math_inline","text":"18 + 15 + 11 + 18 = 62"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"778E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/778/problem/E"}