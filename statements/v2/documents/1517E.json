{"assets":[],"contentKind":"statement","contestId":"1517","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Group Photo"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In the 2050 Conference, some people from the competitive programming community meet together and are going to take a photo. The $$$n$$$ people form a line. They are numbered from $$$1$$$ to $$$n$$$ from left to right. Each of them either holds a cardboard with the letter '"},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"' or a cardboard with the letter '"},{"children":[{"kind":"text","text":"P"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$C=\\{c_1,c_2,\\dots,c_m\\}$$$ $$$(c_1 \\lt c_2 \\lt \\ldots \\lt c_m)$$$ be the set of people who hold cardboards of '"},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"'. Let $$$P=\\{p_1,p_2,\\dots,p_k\\}$$$ $$$(p_1 \\lt p_2 \\lt \\ldots \\lt p_k)$$$ be the set of people who hold cardboards of '"},{"children":[{"kind":"text","text":"P"}],"kind":"container"},{"kind":"text","text":"'. The photo is good if and only if it satisfies the following constraints: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" $$$C\\cup P=\\{1,2,\\dots,n\\}$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$C\\cap P =\\emptyset $$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$c_i-c_{i-1}\\leq c_{i+1}-c_i(1 \\lt i \\lt m)$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$p_i-p_{i-1}\\geq p_{i+1}-p_i(1 \\lt i \\lt k)$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Given an array $$$a_1,\\ldots, a_n$$$, please find the number of good photos satisfying the following condition: $$$$$$\\sum\\limits_{x\\in C} a_x \\lt \\sum\\limits_{y\\in P} a_y.$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer can be large, so output it modulo $$$998\\,244\\,353$$$. Two photos are different if and only if there exists at least one person who holds a cardboard of '"},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"' in one photo but holds a cardboard of '"},{"children":[{"kind":"text","text":"P"}],"kind":"container"},{"kind":"text","text":"' in the other."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 200\\,000$$$). Description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1\\leq n\\leq 200\\,000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$200\\,000$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the answer modulo $$$998\\,244\\,353$$$ in a separate line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n5\n2 1 2 1 1\n4\n9 2 2 2\n1\n998244353\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n7\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first test case, there are $$$10$$$ possible good photos satisfying the condition: "},{"children":[{"kind":"text","text":"PPPPP"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"CPPPP"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"PCPPP"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"CCPPP"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"PCCPP"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"PCPCP"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"PPPPC"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"CPPPC"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"PCPPC"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"PPPCC"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second test case, there are $$$7$$$ possible good photos satisfying the condition