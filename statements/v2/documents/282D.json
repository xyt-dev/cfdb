{"assets":["/statement-assets/6a69308474be1553ff84e4170b456b1c739565acb571aef6aca16ad4d70ccf3a.png"],"contentKind":"statement","contestId":"282","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Yet Another Number Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Since most contestants do not read this part, I have to repeat that Bitlandians are quite weird. They have their own jobs, their own working method, their own lives, their own sausages and their own games!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since you are so curious about Bitland, I'll give you the chance of peeking at one of these games."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"BitLGM and BitAryo are playing yet another of their crazy-looking genius-needed Bitlandish games. They've got a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" non-negative integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". The players make moves in turns. BitLGM moves first. Each player can and must do one of the two following actions in his turn:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Take one of the integers (we'll denote it as "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"). Choose integer "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"(1 ≤ x ≤ ai)"},{"kind":"text","text":". And then decrease "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", that is, apply assignment: "},{"kind":"math_inline","text":"ai = ai - x"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Choose integer "},{"kind":"math_inline","text":"x"},{"attrs":{"alt":"","src":"/statement-assets/6a69308474be1553ff84e4170b456b1c739565acb571aef6aca16ad4d70ccf3a.png"},"kind":"image"},{"kind":"text","text":". And then decrease all "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", that is, apply assignment: "},{"kind":"math_inline","text":"ai = ai - x"},{"kind":"text","text":", for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The player who cannot make a move loses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You're given the initial sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". Determine who wins, if both players plays optimally well and if BitLGM and BitAryo start playing the described game in this sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 3"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(0 ≤ ai < 300)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Write the name of the winner (provided that both players play optimally well). Either \""},{"children":[{"kind":"text","text":"BitLGM"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"BitAryo"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"BitLGM\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"BitAryo\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"BitLGM\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"282D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/282/problem/D"}