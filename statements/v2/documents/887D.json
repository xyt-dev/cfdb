{"assets":[],"contentKind":"statement","contestId":"887","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Ratings and Reality Shows"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are two main kinds of events in the life of top-model: fashion shows and photo shoots. Participating in any of these events affects the rating of appropriate top-model. After each photo shoot model's rating increases by "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and after each fashion show decreases by "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" (designers do too many experiments nowadays). Moreover, sometimes top-models participates in talk shows. After participating in talk show model becomes more popular and increasing of her rating after photo shoots become "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" and decreasing of her rating after fashion show becomes "},{"kind":"math_inline","text":"d"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Izabella wants to participate in a talk show, but she wants to do it in such a way that her rating will never become negative. Help her to find a suitable moment for participating in the talk show. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's assume that model's career begins in moment 0. At that moment Izabella's rating was equal to "},{"kind":"math_inline","text":"start"},{"kind":"text","text":". If talk show happens in moment "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" if will affect all events in model's life in interval of time "},{"kind":"math_inline","text":"[t..t + len)"},{"kind":"text","text":" (including "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" and not including "},{"kind":"math_inline","text":"t + len"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"len"},{"kind":"text","text":" is duration of influence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Izabella wants to participate in a talk show, but she wants to do it in such a way that her rating will not become become negative before talk show or during period of influence of talk show. Help her to find a suitable moment for participating in the talk show. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In first line there are 7 positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", "},{"kind":"math_inline","text":"d"},{"kind":"text","text":", "},{"kind":"math_inline","text":"start"},{"kind":"text","text":", "},{"kind":"math_inline","text":"len"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 3·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ start ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ a, b, c, d, len ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is a number of fashion shows and photo shoots, "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" are rating changes described above, "},{"kind":"math_inline","text":"start"},{"kind":"text","text":" is an initial rating of model and "},{"kind":"math_inline","text":"len"},{"kind":"text","text":" is a duration of influence of talk show."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines descriptions of events are given. Each of those lines contains two integers "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"qi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ q ≤ 1"},{"kind":"text","text":") — moment, in which event happens and type of this event. Type 0 corresponds to the fashion show and type 1 — to photo shoot. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Events are given in order of increasing "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", all "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one non-negative integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — the moment of time in which talk show should happen to make Izabella's rating non-negative before talk show and during period of influence of talk show. If there are multiple answers print smallest of them. If there are no such moments, print "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1 1 1 4 0 5\n1 1\n2 1\n3 1\n4 0\n5 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 2 1 2 1 2\n1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"887D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/887/problem/D"}