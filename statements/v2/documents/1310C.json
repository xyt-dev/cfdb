{"assets":["/statement-assets/eb0d85ad67af16f62db29707191d50ea7439a2c8c8b83b67d4dc1c9307c50b8a.png"],"contentKind":"statement","contestId":"1310","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Au Pont Rouge"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"VK just opened its second HQ in St. Petersburg! Side of its office building has a huge string $$$s$$$ written on its side. This part of the office is supposed to be split into $$$m$$$ meeting rooms in such way that meeting room walls are strictly between letters on the building. Obviously, meeting rooms should not be of size 0, but can be as small as one letter wide. Each meeting room will be named after the substring of $$$s$$$ written on its side."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/eb0d85ad67af16f62db29707191d50ea7439a2c8c8b83b67d4dc1c9307c50b8a.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"For each possible arrangement of $$$m$$$ meeting rooms we ordered a test meeting room label for the meeting room with lexicographically "},{"children":[{"kind":"text","text":"minimal"}],"kind":"container"},{"kind":"text","text":" name. When delivered, those labels got sorted "},{"children":[{"kind":"text","text":"backward"}],"kind":"container"},{"kind":"text","text":" lexicographically."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is printed on $$$k$$$th label of the delivery?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, you are given three integer numbers $$$n, m, k$$$ — length of string $$$s$$$, number of planned meeting rooms to split $$$s$$$ into and number of the interesting label ($$$2 \\le n \\le 1\\,000; 1 \\le m \\le 1\\,000; 1 \\le k \\le 10^{18}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second input line has string $$$s$$$, consisting of $$$n$$$ lowercase english letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For given $$$n, m, k$$$ there are at least $$$k$$$ ways to split $$$s$$$ into $$$m$$$ substrings."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output single string – name of meeting room printed on $$$k$$$-th label of the delivery."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 2 1\nabac\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\naba\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n19 5 1821\naupontrougevkoffice\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nau\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, delivery consists of the labels \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, delivery consists of $$$3060$$$ labels. The first label is \""},{"children":[{"kind":"text","text":"aupontrougevkof"}],"kind":"container"},{"kind":"text","text":"\" and the last one is \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1310C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1310/problem/C"}