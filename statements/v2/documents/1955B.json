{"assets":[],"contentKind":"statement","contestId":"1955","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Progressive Square"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"progressive square"}],"kind":"container"},{"kind":"text","text":" of size $$$n$$$ is an $$$n \\times n$$$ matrix. Maxim chooses three integers $$$a_{1,1}$$$, $$$c$$$, and $$$d$$$ and constructs a "},{"children":[{"kind":"text","text":"progressive square"}],"kind":"container"},{"kind":"text","text":" according to the following rules:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$a_{i+1,j} = a_{i,j} + c$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$a_{i,j+1} = a_{i,j} + d$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if $$$n = 3$$$, $$$a_{1,1} = 1$$$, $$$c=2$$$, and $$$d=3$$$, then the "},{"children":[{"kind":"text","text":"progressive square"}],"kind":"container"},{"kind":"text","text":" looks as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$ \\begin{pmatrix} 1 & 4 & 7 \\\\ 3 & 6 & 9 \\\\ 5 & 8 & 11 \\end{pmatrix} $$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Last month Maxim constructed a "},{"children":[{"kind":"text","text":"progressive square"}],"kind":"container"},{"kind":"text","text":" and remembered the values of $$$n$$$, $$$c$$$, and $$$d$$$. Recently, he found an array $$$b$$$ of $$$n^2$$$ integers in random order and wants to make sure that these elements are the elements of "},{"children":[{"kind":"text","text":"that specific"}],"kind":"container"},{"kind":"text","text":" square."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It can be shown that for any values of $$$n$$$, $$$a_{1,1}$$$, $$$c$$$, and $$$d$$$, there exists exactly one "},{"children":[{"kind":"text","text":"progressive square"}],"kind":"container"},{"kind":"text","text":" that satisfies all the rules."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\le t \\le {10} ^ 4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains three integers $$$n$$$, $$$c$$$, and $$$d$$$ ($$$2 \\le n \\le 500$$$, $$$1 \\le c, d \\le 10^6$$$) — the size of the square and the values of $$$c$$$ and $$$d$$$ as described in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n \\cdot n$$$ integers $$$b_1, b_2, \\dots, b_{n \\cdot n}$$$ ($$$1 \\le b_i \\le 10^9$$$) — the elements found by Maxim."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n ^ 2$$$ over all test cases does not exceed $$$25 \\cdot {10} ^ 4$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" in a separate line if a "},{"children":[{"kind":"text","text":"progressive square"}],"kind":"container"},{"kind":"text","text":" for the given $$$n$$$, $$$c$$$, and $$$d$$$ can be constructed from the array elements $$$a$$$, otherwise output \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output each letter in any case (lowercase or uppercase). For example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be accepted as a positive answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n3 2 3\n3 9 6 5 7 1 10 4 8\n3 2 3\n3 9 6 5 7 1 11 4 8\n2 100 100\n400 300 400 500\n3 2 3\n3 9 6 6 5 1 11 4 8\n4 4 4\n15 27 7 19 23 23 11 15 7 3 19 23 11 15 11 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\nYES\nYES\nNO\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1955B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1955/problem/B"}