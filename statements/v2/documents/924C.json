{"assets":["/statement-assets/e0278744a930b09dfbbc02f9c512c085f0d0284d89d279dcc8c9b43b2c0f505d.png","/statement-assets/85fb8bb640caa932e63924909bdb34ce3c7c3e956ebc86c693deddac7fa98a5a.png"],"contentKind":"statement","contestId":"924","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Riverside Curio"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Arkady decides to observe a river for "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" consecutive days. The river's water level on each day is equal to some real value."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Arkady goes to the riverside each day and makes a mark on the side of the channel at the height of the water level, but if it coincides with a mark made before, no new mark is created. The water does not wash the marks away. Arkady writes down the number of marks strictly above the water level each day, on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day this value is equal to "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Define "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" as the number of marks strictly under the water level on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day. You are to find out the minimum possible sum of "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" over all days. There are no marks on the channel before the first day."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of days."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"m1, m2, ..., mn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ mi < i"},{"kind":"text","text":") — the number of marks strictly above the water on each day."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one single integer — the minimum possible sum of the number of marks strictly below the water level among all days."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n0 1 0 3 0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 1 2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 1 1 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the following figure shows an optimal case."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e0278744a930b09dfbbc02f9c512c085f0d0284d89d279dcc8c9b43b2c0f505d.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Note that on day "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", a new mark should be created because if not, there cannot be "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" marks above water on day "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". The total number of marks underwater is "},{"kind":"math_inline","text":"0 + 0 + 2 + 0 + 3 + 1 = 6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, the following figure shows an optimal case."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/85fb8bb640caa932e63924909bdb34ce3c7c3e956ebc86c693deddac7fa98a5a.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"924C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/924/problem/C"}