{"assets":["/statement-assets/3a4e49dfa2f5cfe51d21d1e58010b2649dc98f557c1353fc0490dbad8a9f85d4.png","/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"],"contentKind":"statement","contestId":"288","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Polo the Penguin and XOR operation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little penguin Polo likes permutations. But most of all he likes permutations of integers from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", inclusive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For permutation "},{"kind":"math_inline","text":"p = p0, p1, ..., pn"},{"kind":"text","text":", Polo has defined its beauty — number "},{"attrs":{"alt":"","src":"/statement-assets/3a4e49dfa2f5cfe51d21d1e58010b2649dc98f557c1353fc0490dbad8a9f85d4.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Expression "},{"attrs":{"alt":"","src":"/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"},"kind":"image"},{"kind":"text","text":" means applying the operation of bitwise excluding \"OR\" to numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". This operation exists in all modern programming languages, for example, in language "},{"children":[{"kind":"text","text":"C++"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"Java"}],"kind":"container"},{"kind":"text","text":" it is represented as \""},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":"\" and in "},{"children":[{"kind":"text","text":"Pascal"}],"kind":"container"},{"kind":"text","text":" — as \""},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help him find among all permutations of integers from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" the permutation with the maximum beauty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" the maximum possible beauty. In the second line print any permutation of integers from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" with the beauty equal to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several suitable permutations, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20\n0 2 1 4 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"288C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/288/problem/C"}