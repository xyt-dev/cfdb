{"assets":["/statement-assets/aa74c293cf2b61b856b3e7a79a97442aa3e3ef724901a32d41e6c6f3e769ed0a.png"],"contentKind":"statement","contestId":"56","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Corporation Mail"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Beroil corporation structure is hierarchical, that is it can be represented as a tree. Let's examine the presentation of this structure as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"employee"},{"kind":"text","text":" ::= "},{"kind":"math_inline","text":"name"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" | "},{"kind":"math_inline","text":"name"},{"children":[{"kind":"text","text":":"}],"kind":"container"},{"kind":"math_inline","text":"employee1"},{"children":[{"kind":"text","text":","}],"kind":"container"},{"kind":"math_inline","text":"employee2"},{"children":[{"kind":"text","text":","}],"kind":"container"},{"kind":"text","text":" ... "},{"children":[{"kind":"text","text":","}],"kind":"container"},{"kind":"math_inline","text":"employeek"},{"children":[{"kind":"text","text":"."}],"kind":"container"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"name"},{"kind":"text","text":" ::= name of an employee "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"That is, the description of each employee consists of his name, a colon ("},{"children":[{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"), the descriptions of all his subordinates separated by commas, and, finally, a dot. If an employee has no subordinates, then the colon is not present in his description."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, line "},{"children":[{"kind":"text","text":"MIKE:MAX.,ARTEM:MIKE..,DMITRY:DMITRY.,DMITRY..."}],"kind":"container"},{"kind":"text","text":" is the correct way of recording the structure of a corporation where the director "},{"children":[{"kind":"text","text":"MIKE"}],"kind":"container"},{"kind":"text","text":" has subordinates "},{"children":[{"kind":"text","text":"MAX"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"ARTEM"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"DMITRY"}],"kind":"container"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"ARTEM"}],"kind":"container"},{"kind":"text","text":" has a subordinate whose name is "},{"children":[{"kind":"text","text":"MIKE"}],"kind":"container"},{"kind":"text","text":", just as the name of his boss and two subordinates of "},{"children":[{"kind":"text","text":"DMITRY"}],"kind":"container"},{"kind":"text","text":" are called "},{"children":[{"kind":"text","text":"DMITRY"}],"kind":"container"},{"kind":"text","text":", just like himself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the Beroil corporation every employee can only correspond with his subordinates, at that the subordinates are not necessarily direct. Let's call an uncomfortable situation the situation when a person whose name is "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" writes a letter to another person whose name is also "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". In the example given above are two such pairs: a pair involving "},{"children":[{"kind":"text","text":"MIKE"}],"kind":"container"},{"kind":"text","text":", and two pairs for "},{"children":[{"kind":"text","text":"DMITRY"}],"kind":"container"},{"kind":"text","text":" (a pair for each of his subordinates)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is by the given structure of the corporation to find the number of uncomfortable pairs in it."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/aa74c293cf2b61b856b3e7a79a97442aa3e3ef724901a32d41e6c6f3e769ed0a.png"},"kind":"image"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and single line contains the corporation structure which is a string of length from 1 to 1000 characters. It is guaranteed that the description is correct. Every name is a string consisting of capital Latin letters from 1 to 10 symbols in length."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the number of uncomfortable situations in the company."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"MIKE:MAX.,ARTEM:MIKE..,DMITRY:DMITRY.,DMITRY...\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"A:A..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"A:C:C:C:C.....\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"56C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/56/problem/C"}