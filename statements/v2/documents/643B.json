{"assets":["/statement-assets/5b30d3ee445278a36bb5328c1bb6049ed72d6f54e3b10bd87e26d6ee5f1f6d0b.png","/statement-assets/9a2834dafcfc817a7d843a359b106b4d9d7414ab8bd157a072763fd0ee7e2271.png"],"contentKind":"statement","contestId":"643","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Bear and Two Paths"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bearland has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities, numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Cities are connected via bidirectional roads. Each road connects two distinct cities. No two roads connect the same pair of cities."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Bear Limak was once in a city "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and he wanted to go to a city "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". There was no direct connection so he decided to take a long walk, visiting each city "},{"children":[{"kind":"text","text":"exactly once"}],"kind":"container"},{"kind":"text","text":". Formally: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" There is no road between "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There exists a sequence (path) of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct cities "},{"kind":"math_inline","text":"v1, v2, ..., vn"},{"kind":"text","text":" that "},{"kind":"math_inline","text":"v1 = a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vn = b"},{"kind":"text","text":" and there is a road between "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi + 1"},{"kind":"text","text":" for "},{"attrs":{"alt":"","src":"/statement-assets/5b30d3ee445278a36bb5328c1bb6049ed72d6f54e3b10bd87e26d6ee5f1f6d0b.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"On the other day, the similar thing happened. Limak wanted to travel between a city "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" and a city "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". There is no road between them but there exists a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct cities "},{"kind":"math_inline","text":"u1, u2, ..., un"},{"kind":"text","text":" that "},{"kind":"math_inline","text":"u1 = c"},{"kind":"text","text":", "},{"kind":"math_inline","text":"un = d"},{"kind":"text","text":" and there is a road between "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ui + 1"},{"kind":"text","text":" for "},{"attrs":{"alt":"","src":"/statement-assets/5b30d3ee445278a36bb5328c1bb6049ed72d6f54e3b10bd87e26d6ee5f1f6d0b.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, Limak thinks that there are at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" roads in Bearland. He wonders whether he remembers everything correctly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and four distinct cities "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", "},{"kind":"math_inline","text":"d"},{"kind":"text","text":", can you find possible paths "},{"kind":"math_inline","text":"(v1, ..., vn)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(u1, ..., un)"},{"kind":"text","text":" to satisfy all the given conditions? Find any solution or print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if it's impossible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"4 ≤ n ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n - 1 ≤ k ≤ 2n - 2"},{"kind":"text","text":") — the number of cities and the maximum allowed number of roads, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains four "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b, c, d ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if it's impossible to satisfy all the given conditions. Otherwise, print two lines with paths descriptions. The first of these two lines should contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"v1, v2, ..., vn"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"v1 = a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vn = b"},{"kind":"text","text":". The second line should contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"u1, u2, ..., un"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"u1 = c"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"un = d"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two paths generate at most "},{"kind":"math_inline","text":"2n - 2"},{"kind":"text","text":" roads: "},{"kind":"math_inline","text":"(v1, v2), (v2, v3), ..., (vn - 1, vn), (u1, u2), (u2, u3), ..., (un - 1, un)"},{"kind":"text","text":". Your answer will be considered wrong if contains more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" distinct roads or any other condition breaks. Note that "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(y, x)"},{"kind":"text","text":" are the same road."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 11\n2 4 7 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 7 1 3 6 5 4\n7 1 5 4 6 2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1000 999\n10 20 30 40\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test, there should be "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" cities and at most "},{"kind":"math_inline","text":"11"},{"kind":"text","text":" roads. The provided sample solution generates "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" roads, as in the drawing. You can also see a simple path of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" between "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", and a path between "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9a2834dafcfc817a7d843a359b106b4d9d7414ab8bd157a072763fd0ee7e2271.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"643B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/643/problem/B"}