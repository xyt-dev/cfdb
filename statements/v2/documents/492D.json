{"assets":[],"contentKind":"statement","contestId":"492","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Vanya and Computer Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vanya and his friend Vova play a computer game where they need to destroy "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" monsters to pass a level. Vanya's character performs attack with frequency "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" hits per second and Vova's character performs attack with frequency "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" hits per second. Each character spends fixed time to raise a weapon and then he hits (the time to raise the weapon is "},{"kind":"math_inline","text":"1 / x"},{"kind":"text","text":" seconds for the first character and "},{"kind":"math_inline","text":"1 / y"},{"kind":"text","text":" seconds for the second one). The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th monster dies after he receives "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" hits. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vanya and Vova wonder who makes the last hit on each monster. If Vanya and Vova make the last hit at the same time, we assume that both of them have made the last hit."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":","},{"kind":"math_inline","text":"x"},{"kind":"text","text":","},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ x, y ≤ 106"},{"kind":"text","text":") — the number of monsters, the frequency of Vanya's and Vova's attack, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — the number of hits needed do destroy the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th monster."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print word \""},{"children":[{"kind":"text","text":"Vanya"}],"kind":"container"},{"kind":"text","text":"\", if the last hit on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th monster was performed by Vanya, \""},{"children":[{"kind":"text","text":"Vova"}],"kind":"container"},{"kind":"text","text":"\", if Vova performed the last hit, or \""},{"children":[{"kind":"text","text":"Both"}],"kind":"container"},{"kind":"text","text":"\", if both boys performed it at the same time."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 2\n1\n2\n3\n4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Vanya\nVova\nVanya\nBoth\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 1\n1\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Both\nBoth\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Vanya makes the first hit at time "},{"kind":"math_inline","text":"1 / 3"},{"kind":"text","text":", Vova makes the second hit at time "},{"kind":"math_inline","text":"1 / 2"},{"kind":"text","text":", Vanya makes the third hit at time "},{"kind":"math_inline","text":"2 / 3"},{"kind":"text","text":", and both boys make the fourth and fifth hit simultaneously at the time "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample Vanya and Vova make the first and second hit simultaneously at time "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"492D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/492/problem/D"}