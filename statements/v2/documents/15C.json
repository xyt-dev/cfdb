task is to find out which oligarch will win, provided that both of them play optimally. The oligarchs asked you not to reveal their names. So, let's call the one who takes the first stone «"},{"children":[{"kind":"text","text":"tolik"}],"kind":"container"},{"kind":"text","text":"» and the other one «"},{"children":[{"kind":"text","text":"bolik"}],"kind":"container"},{"kind":"text","text":"»."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the amount of quarries. Then there follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each of them contains two space-separated integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, mi ≤ 1016"},{"kind":"text","text":") — the amount of stones in the first dumper of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th quarry and the number of dumpers at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th quarry."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output «"},{"children":[{"kind":"text","text":"tolik"}],"kind":"container"},{"kind":"text","text":"» if the oligarch who takes a stone first wins, and «"},{"children":[{"kind":"text","text":"bolik"}],"kind":"container"},{"kind":"text","text":"» otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 1\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"tolik\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1\n1 1\n1 1\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"bolik\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"15C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/15/problem/C"}