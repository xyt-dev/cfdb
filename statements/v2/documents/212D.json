{"assets":["/statement-assets/22fb0a6bc8debe177cc82965195dfabf4197b22d93a2d7c06d3b181076ba6cf0.png","/statement-assets/25c20dd4649a5850863c09b01d2e5bb18c739df6b160de71324297e60e04865e.png"],"contentKind":"statement","contestId":"212","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Cutting a Fence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya the carpenter has an estate that is separated from the wood by a fence. The fence consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" planks put in a line. The fence is not closed in a circle. The planks are numbered from left to right from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th plank is of height "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". All planks have the same width, the lower edge of each plank is located at the ground level."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Recently a local newspaper \"Malevich and Life\" wrote that the most fashionable way to decorate a fence in the summer is to draw a fuchsia-colored rectangle on it, the lower side of the rectangle must be located at the lower edge of the fence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya is delighted with this idea! He immediately bought some fuchsia-colored paint and began to decide what kind of the rectangle he should paint. Vasya is sure that the rectangle should cover "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" consecutive planks. In other words, he will paint planks number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x + 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"x + k - 1"},{"kind":"text","text":" for some "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"(1 ≤ x ≤ n - k + 1)"},{"kind":"text","text":". He wants to paint the rectangle of maximal area, so the rectangle height equals "},{"kind":"math_inline","text":"min ai"},{"kind":"text","text":" for "},{"kind":"math_inline","text":"x ≤ i ≤ x + k - 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is the number of the first colored plank."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya has already made up his mind that the rectangle width can be equal to one of numbers of the sequence "},{"kind":"math_inline","text":"k1, k2, ..., km"},{"kind":"text","text":". For each "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" he wants to know the expected height of the painted rectangle, provided that he selects "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" for such fence uniformly among all "},{"kind":"math_inline","text":"n - ki + 1"},{"kind":"text","text":" possible values. Help him to find the expected heights."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 106)"},{"kind":"text","text":" — the number of planks in the fence. The second line contains a sequence of integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the height of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th plank of the fence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains an integer "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ m ≤ 106)"},{"kind":"text","text":" and the next line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"k1, k2, ..., km"},{"kind":"math_inline","text":"(1 ≤ ki ≤ n)"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" is the width of the desired fuchsia-colored rectangle in planks."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" whitespace-separated real numbers, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number equals the expected value of the rectangle height, if its width in planks equals "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":". The value will be considered correct if its absolute or relative error doesn't exceed "},{"kind":"math_inline","text":"10 - 9"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 2 1\n3\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2.000000000000000\n1.500000000000000\n1.000000000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1\n3\n1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.000000000000000\n1.000000000000000\n1.000000000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's consider the first sample test. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" There are three possible positions of the fence for "},{"kind":"math_inline","text":"k1 = 1"},{"kind":"text","text":". For the first position "},{"kind":"math_inline","text":"(x = 1)"},{"kind":"text","text":" the height is 3, for the second one "},{"kind":"math_inline","text":"(x = 2)"},{"kind":"text","text":" the height is 2, for the third one "},{"kind":"math_inline","text":"(x = 3)"},{"kind":"text","text":" the height is 1. As the fence position is chosen uniformly, the expected height of the fence equals "},{"attrs":{"alt":"","src":"/statement-assets/22fb0a6bc8debe177cc82965195dfabf4197b22d93a2d7c06d3b181076ba6cf0.png"},"kind":"image"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There are two possible positions of the fence for "},{"kind":"math_inline","text":"k2 = 2"},{"kind":"text","text":". For the first position "},{"kind":"math_inline","text":"(x = 1)"},{"kind":"text","text":" the height is 2, for the second one "},{"kind":"math_inline","text":"(x = 2)"},{"kind":"text","text":" the height is 1. The expected height of the fence equals "},{"attrs":{"alt":"","src":"/statement-assets/25c20dd4649a5850863c09b01d2e5bb18c739df6b160de71324297e60e04865e.png"},"kind":"image"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There is the only possible position of the fence for "},{"kind":"math_inline","text":"k3 = 3"},{"kind":"text","text":". The expected height of the fence equals 1. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"212D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/212/problem/D"}