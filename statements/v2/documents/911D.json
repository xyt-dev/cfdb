:"math_inline","text":"(4, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(4, 3)"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"a = [1, 2, 4, 3]"},{"kind":"text","text":", inversion: "},{"kind":"math_inline","text":"(4, 3)"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"a = [1, 4, 2, 3]"},{"kind":"text","text":", inversions: "},{"kind":"math_inline","text":"(3, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(4, 2)"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"911D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/911/problem/D"}