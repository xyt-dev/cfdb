{"assets":[],"contentKind":"statement","contestId":"911","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Inversion Counting"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A permutation of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is an array of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" such that each integer from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" occurs exactly once in this array. An inversion in a permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is a pair of indices "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"i > j"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ai < aj"},{"kind":"text","text":". For example, a permutation "},{"kind":"math_inline","text":"[4, 1, 3, 2]"},{"kind":"text","text":" contains "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" inversions: "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(4, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(4, 3)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a permutation "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries to it. Each query is represented by two indices "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" denoting that you have to reverse the segment "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":" of the permutation. For example, if "},{"kind":"math_inline","text":"a = [1, 2, 3, 4]"},{"kind":"text","text":" and a query "},{"kind":"math_inline","text":"l = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r = 4"},{"kind":"text","text":" is applied, then the resulting permutation is "},{"kind":"math_inline","text":"[1, 4, 3, 2]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After each query you have to determine whether the number of inversions is odd or even."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1500"},{"kind":"text","text":") — the size of the permutation. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ n"},{"kind":"text","text":") — the elements of the permutation. These integers are pairwise distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains one integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 2·105"},{"kind":"text","text":") — the number of queries to process."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follow, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line containing two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":") denoting that "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query is to reverse a segment "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":" of the permutation. All queries are performed one after another."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them must be equal to "},{"children":[{"kind":"text","text":"odd"}],"kind":"container"},{"kind":"text","text":" if the number of inversions in the permutation after "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query is odd, and "},{"children":[{"kind":"text","text":"even"}],"kind":"container"},{"kind":"text","text":" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n2\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}