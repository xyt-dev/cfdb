{"assets":[],"contentKind":"statement","contestId":"2111","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Changing the String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Given a string $$$s$$$ that consists only of the first three letters of the Latin alphabet, meaning each character of the string is either "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":", or "},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also given are $$$q$$$ operations that need to be performed on the string. In each operation, two letters $$$x$$$ and $$$y$$$ from the set of the first three letters of the Latin alphabet are provided, and for each operation, one of the following two actions must be taken:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" change any (one) occurrence of the letter $$$x$$$ in the string $$$s$$$ to the letter $$$y$$$ (if at least one occurrence of the letter $$$x$$$ exists); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" do nothing. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The goal is to perform all operations in the given order in such a way that the string $$$s$$$ becomes lexicographically minimal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Recall that a string $$$a$$$ is lexicographically less than a string $$$b$$$ if and only if one of the following conditions holds:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a$$$ is a prefix of $$$b$$$, but $$$a \\neq b$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" at the first position where $$$a$$$ and $$$b$$$ differ, the string $$$a$$$ has a letter that comes earlier in the alphabet than the corresponding letter in $$$b$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test consists of several test cases. The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^{3}$$$) — the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first line of each test case, there are two integers $$$n$$$ and $$$q$$$ ($$$1 \\le n, q \\le 2 \\cdot 10^{5}$$$) — the length of the string $$$s$$$ and the number of operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line of each test case, the string $$$s$$$ is given — a string of exactly $$$n$$$ characters, each of which is "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":", or "},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$q$$$ lines of each test case contain the description of the operations. Each line contains two characters $$$x$$$ and $$$y$$$, each of which is "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":", or "},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraints on the input:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the sum of $$$n$$$ across all test cases does not exceed $$$2 \\cdot 10^{5}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the sum of $$$q$$$ across all test cases does not exceed $$$2 \\cdot 10^{5}$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the lexicographically minimal string that can be obtained from $$$s$$$ using the given operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2 2\ncb\nc b\nb a\n10 10\nbbbbbbbbbb\nb a\nb c\nc b\nb a\nc a\nb c\nb c\nb a\na b\nc a\n30 20\nabcaababcbbcabcbbcabcbabbbbabc\nb c\nb c\nc a\nb c\nb c\nb a\nb c\nb c\nb a\nb a\nb a\nb a\nc a\nb c\nc a\nb c\nc a\nc a\nb c\nc b\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nab\naaaaabbbbb\naaaaaaaaaaaaaaabbbabcbabbbbabc\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, both operations need to be applied to the first letter:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" after the first operation, $$$s = $$$ \""},{"children":[{"kind":"text","text":"bb"}],"kind":"container"},{"kind":"text","text":"\" "}],"kind":"list_item"},{"children":[{"kind":"text","text":" after the second operation, $$$s = $$$ \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\" "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second test case, the string could change as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"bbbbabbbbb"}],"kind":"container"},{"kind":"text","text":"\" (changed the $$$5$$$-th letter) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"cbbbabbbbb"}],"kind":"container"},{"kind":"text","text":"\" (changed the $$$1$$$-st letter) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"cbbbabbbbb"}],"kind":"container"},{"kind":"text","text":"\" (did nothing) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"cbbaabbbbb"}],"kind":"container"},{"kind":"text","text":"\" (changed the $$$4$$$-th letter) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"abbaabbbbb"}],"kind":"container"},{"kind":"text","text":"\" (changed the $$$1$$$-st letter) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"abcaabbbbb"}],"kind":"container"},{"kind":"text","text":"\" (changed the $$$3$$$-rd letter) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"abcaabbbbb"}],"kind":"container"},{"kind":"text","text":"\" (did nothing) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"aacaabbbbb"}],"kind":"container"},{"kind":"text","text":"\" (changed the $$$2$$$-nd letter) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"aacaabbbbb"}],"kind":"container"},{"kind":"text","text":"\" (did nothing) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"aaaaabbbbb"}],"kind":"container"},{"kind":"text","text":"\" (changed the $$$3$$$-rd letter) "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"2111E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2111/problem/E"}