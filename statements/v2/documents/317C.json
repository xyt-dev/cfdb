{"assets":[],"contentKind":"statement","contestId":"317","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Balance"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A system of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vessels with water is given. Several pairs of vessels are connected by tubes with transfusion mechanisms. One may transfer an integer amount of liters of water between two vessels connected by such tube (tube works in both directions). There might be multiple tubes between two vessels. Total number of tubes equals "},{"kind":"math_inline","text":"e"},{"kind":"text","text":". Volume of each vessel equals "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" liters. Of course, the amount of the water in any vessel cannot exceed "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" liters in the process of transfusions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the initial amounts "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" of water in the vessels and the desired amounts "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" find a sequence of transfusions that deals with the task. Total number of transfusions must not exceed "},{"kind":"math_inline","text":"2·n2"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of the input contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", "},{"kind":"math_inline","text":"e"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 300"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ v ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ e ≤ 50000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next two lines contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers each: initial "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and the desired amounts "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" of water in corresponding vessels ("},{"kind":"math_inline","text":"0 ≤ ai, bi ≤ v"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"e"},{"kind":"text","text":" lines describe one tube each in the format "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x, y ≤ n, x ≠ y"},{"kind":"text","text":") for a tube between vessels number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". There might be multiple tubes between two vessels. You may assume that vessels are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in some way."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes), if such sequence of transfusions does not exist."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print any suitable sequence in the following format. On the first line print the total number of transfusions "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"k"},{"kind":"text","text":" should not exceed "},{"kind":"math_inline","text":"2·n2"},{"kind":"text","text":"). In the following "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines print transfusions in the format "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"y"},{"kind":"math_inline","text":"d"},{"kind":"text","text":" (transfusion of "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" liters from the vessel number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to the vessel number "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" must be distinct). For all transfusions "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" must be a non-negative integer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 10 1\n1 9\n5 5\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2 1 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 10 0\n5 2\n4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_out