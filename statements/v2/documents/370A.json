{"assets":["/statement-assets/a5f1df07ec39ec7702b9dc1ba7635e4cc068107e05c0d4dea265e07383036f12.png"],"contentKind":"statement","contestId":"370","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Rook, Bishop and King"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Petya is learning to play chess. He has already learned how to move a king, a rook and a bishop. Let us remind you the rules of moving chess pieces. A chessboard is 64 square fields organized into an "},{"kind":"math_inline","text":"8 × 8"},{"kind":"text","text":" table. A field is represented by a pair of integers "},{"kind":"math_inline","text":"(r, c)"},{"kind":"text","text":" — the number of the row and the number of the column (in a classical game the columns are traditionally indexed by letters). Each chess piece takes up exactly one field. To make a move is to move a chess piece, the pieces move by the following rules:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" A rook moves any number of fields horizontally or vertically. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A bishop moves any number of fields diagonally. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A king moves one field in any direction — horizontally, vertically or diagonally. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a5f1df07ec39ec7702b9dc1ba7635e4cc068107e05c0d4dea265e07383036f12.png"},"kind":"image"},{"children":[{"kind":"text","text":"The pieces move like that"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Petya is thinking about the following problem: what minimum number of moves is needed for each of these pieces to move from field "},{"kind":"math_inline","text":"(r1, c1)"},{"kind":"text","text":" to field "},{"kind":"math_inline","text":"(r2, c2)"},{"kind":"text","text":"? At that, we assume that there are no more pieces besides this one on the board. Help him solve this problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input contains four integers "},{"kind":"math_inline","text":"r1, c1, r2, c2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ r1, c1, r2, c2 ≤ 8"},{"kind":"text","text":") — the coordinates of the starting and the final field. The starting field doesn't coincide with the final one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can assume that the chessboard rows are numbered from top to bottom 1 through 8, and the columns are numbered from left to right 1 through 8."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print three space-separated integers: the minimum number of moves the rook, the bishop and the king (in this order) is needed to move from field "},{"kind":"math_inline","text":"(r1, c1)"},{"kind":"text","text":" to field "},{"kind":"math_inline","text":"(r2, c2)"},{"kind":"text","text":". If a piece cannot make such a move, print a 0 instead of the corresponding number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5 5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 0 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"370A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/370/problem/A"}