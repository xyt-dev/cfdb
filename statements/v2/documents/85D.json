{"assets":["/statement-assets/96be1107362ee5b2e189ae4879c7d1858d41030a689f4ef87e84bd24a0ba6010.png","/statement-assets/34a22e799a873e12c2b81d117d75af654b88e8d618995b91578f6ba652b621bd.png","/statement-assets/b1cff6afc1ccd1b23cc2fd822f4af1730bc7b8b654e67c67d691ba07d52eb0c9.png"],"contentKind":"statement","contestId":"85","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Sum of Medians"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In one well-known algorithm of finding the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th order statistics we should divide all elements into groups of five consecutive elements and find the median of each five. A median is called the middle element of a sorted array (it's the third largest element for a group of five). To increase the algorithm's performance speed on a modern video card, you should be able to find a sum of medians in each five of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"sum of medians"}],"kind":"container"},{"kind":"text","text":" of a sorted "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-element set "},{"kind":"math_inline","text":"S = {a1, a2, ..., ak}"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"a1 < a2 < a3 < ... < ak"},{"kind":"text","text":", will be understood by as "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/96be1107362ee5b2e189ae4879c7d1858d41030a689f4ef87e84bd24a0ba6010.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The "},{"attrs":{"alt":"","src":"/statement-assets/34a22e799a873e12c2b81d117d75af654b88e8d618995b91578f6ba652b621bd.png"},"kind":"image"},{"kind":"text","text":" operator stands for taking the remainder, that is "},{"attrs":{"alt":"","src":"/statement-assets/b1cff6afc1ccd1b23cc2fd822f4af1730bc7b8b654e67c67d691ba07d52eb0c9.png"},"kind":"image"},{"kind":"text","text":" stands for the remainder of dividing "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To organize exercise testing quickly calculating "},{"children":[{"kind":"text","text":"the sum of medians"}],"kind":"container"},{"kind":"text","text":" for a changing set was needed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":"), the number of operations performed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then each of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains the description of one of the three operations: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"add "},{"kind":"math_inline","text":"x"}],"kind":"container"},{"kind":"text","text":" — add the element "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to the set; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"del "},{"kind":"math_inline","text":"x"}],"kind":"container"},{"kind":"text","text":" — delete the element "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" from the set; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"sum"}],"kind":"container"},{"kind":"text","text":" — find the "},{"children":[{"kind":"text","text":"sum of medians"}],"kind":"container"},{"kind":"text","text":" of the set. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For any "},{"children":[{"kind":"text","text":"add "},{"kind":"math_inline","text":"x"}],"kind":"container"},{"kind":"text","text":" operation it is true that the element "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is not included in the set directly before the operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For any "},{"children":[{"kind":"text","text":"del "},{"kind":"math_inline","text":"x"}],"kind":"container"},{"kind":"text","text":" operation it is true that the element "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is included in the set directly before the operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the numbers in the input are positive integers, not exceeding "},{"kind":"math_inline","text":"109"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each operation "},{"children":[{"kind":"text","text":"sum"}],"kind":"container"},{"kind":"text","text":" print on the single line "},{"children":[{"kind":"text","text":"the sum of medians"}],"kind":"container"},{"kind":"text","text":" of the current set. If the set is empty, print 0."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specificator to read or write 64-bit integers in C++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams (also you may use the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specificator)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\nadd 4\nadd 5\nadd 1\nadd 2\nadd 3\nsum\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"14\nadd 1\nadd 7\nadd 2\nadd 5\nsum\nadd 6\nadd 8\nadd 9\nadd 3\nadd 4\nadd 10\nsum\ndel 1\nsum\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n11\n13\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"85D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/85/problem/D"}