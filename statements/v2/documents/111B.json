{"assets":["/statement-assets/1aa031f674fbd5e42892820b55f6fd9c97db1a0d86556aca8aa156439fc5e7a3.png"],"contentKind":"statement","contestId":"111","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Petya and Divisors"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Petya loves looking for numbers' divisors. One day Petya came across the following problem:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" queries in the form \""},{"kind":"math_inline","text":"xi"},{"kind":"math_inline","text":"yi"},{"kind":"text","text":"\". For each query Petya should count how many divisors of number "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" divide none of the numbers "},{"kind":"math_inline","text":"xi - yi, xi - yi + 1, ..., xi - 1"},{"kind":"text","text":". Help him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":"). Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain two space-separated integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ yi ≤ i - 1"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is the query's ordinal number; the numeration starts with "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"yi = 0"},{"kind":"text","text":" for the query, then the answer to the query will be the number of divisors of the number "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". In this case you do not need to take the previous numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" into consideration."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query print the answer on a single line: the number of positive integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" such that "},{"attrs":{"alt":"","src":"/statement-assets/1aa031f674fbd5e42892820b55f6fd9c97db1a0d86556aca8aa156439fc5e7a3.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n4 0\n3 1\n5 2\n6 2\n18 4\n10000 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1\n1\n2\n2\n22\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's write out the divisors that give answers for the first 5 queries:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1) 1, 2, 4 "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2) 3"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"3) 5"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"4) 2, 6"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"5) 9, 18"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"111B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/111/problem/B"}