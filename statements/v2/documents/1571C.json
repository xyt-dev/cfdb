{"assets":[],"contentKind":"statement","contestId":"1571","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Rhyme"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's say that two strings $$$s$$$ and $$$t$$$ "},{"children":[{"kind":"text","text":"rhyme"}],"kind":"container"},{"kind":"text","text":" if both strings have length at least $$$k$$$, and their last $$$k$$$ characters are equal. For example, if $$$k = 3$$$, the strings "},{"children":[{"kind":"text","text":"abcd"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"cebcd"}],"kind":"container"},{"kind":"text","text":" rhyme, the strings "},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":" don't rhyme, the strings "},{"children":[{"kind":"text","text":"aaaa"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"aaaaa"}],"kind":"container"},{"kind":"text","text":" rhyme, the strings "},{"children":[{"kind":"text","text":"abcd"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"abce"}],"kind":"container"},{"kind":"text","text":" don't rhyme."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have $$$n$$$ pairs of strings $$$(s_i, t_i)$$$, and for each pair of strings you know, should they rhyme or should not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find all possible non-negative integer values for $$$k$$$ such that pairs that have to rhyme, rhyme and pairs that must not rhyme, don't rhyme."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 1000$$$). Description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 10^5$$$) — the number of string pairs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$n$$$ lines contains descriptions of pairs — one per line. The $$$i$$$-th line contains space-separated strings $$$s_i$$$ and $$$t_i$$$ and marker $$$r_i$$$. Strings are non-empty, consist of lowercase Latin letters and each have length at most $$$2 \\cdot 10^5$$$. The marker $$$r_i$$$ equals to $$$1$$$ if strings have to rhyme, or $$$0$$$ if they must not rhyme."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that for each test case there is at least one pair with $$$r_i$$$ equal to $$$1$$$ and that the total length of all strings over all test cases doesn't exceed $$$4 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, firstly print integer $$$m$$$ — the number of possible non-negative integer values of $$$k$$$ such that pairs that have to rhyme, rhyme and pairs that must not rhyme, don't rhyme. Next, print all these values of $$$k$$$ (without repetitions). You can print them in any order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1\nkotlin heroes 1\n2\njoin kotlin 1\nepisode eight 0\n4\nabc abcdef 0\nxyz zzz 1\naaa bba 0\nc d 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n0\n2\n1 2\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, if $$$k$$$ is at least $$$1$$$ then "},{"children":[{"kind":"text","text":"kotli"},{"children":[{"kind":"text","text":"n"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"heroe"},{"children":[{"kind":"text","text":"s"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" don't rhyme."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, for $$$k = 2$$$ "},{"children":[{"kind":"text","text":"jo"},{"children":[{"kind":"text","text":"in"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"kotl"},{"children":[{"kind":"text","text":"in"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" rhyme, and "},{"children":[{"kind":"text","text":"episo"},{"children":[{"kind":"text","text":"de"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"eig"},{"children":[{"kind":"text","text":"ht"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" don't rhyme."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1571C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1571/problem/C"}