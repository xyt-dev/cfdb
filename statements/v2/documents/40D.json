{"assets":[],"contentKind":"statement","contestId":"40","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Interesting Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Berland scientists noticed long ago that the world around them depends on Berland population. Due to persistent research in this area the scientists managed to find out that the Berland chronology starts from the moment when the first two people came to that land (it is considered to have happened in the first year). After one Berland year after the start of the chronology the population had already equaled 13 people (the second year). However, tracing the population number during the following years was an ultimately difficult task, still it was found out that if "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" — the number of people in Berland in the year of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", then either "},{"kind":"math_inline","text":"di = 12di - 2"},{"kind":"text","text":", or "},{"kind":"math_inline","text":"di = 13di - 1 - 12di - 2"},{"kind":"text","text":". Of course no one knows how many people are living in Berland at the moment, but now we can tell if there could possibly be a year in which the country population equaled "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". That's what we ask you to determine. Also, if possible, you have to find out in which years it could be (from the beginning of Berland chronology). Let's suppose that it could be in the years of "},{"kind":"math_inline","text":"a1, a2, ..., ak"},{"kind":"text","text":". Then you have to define how many residents could be in the country during those years apart from the "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" variant. Look at the examples for further explanation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ A < 10300"},{"kind":"text","text":"). It is guaranteed that the number doesn't contain leading zeros."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first output line print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":", if there could be a year in which the total population of the country equaled "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", otherwise print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the answer is "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":", then you also have to print number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of years in which the population could equal "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". On the next line you have to output precisely "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" space-separated numbers — "},{"kind":"math_inline","text":"a1, a2, ..., ak"},{"kind":"text","text":". Those numbers have to be output in the increasing order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the next line you should output number "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" — how many variants of the number of people could be in the years of "},{"kind":"math_inline","text":"a1, a2, ..., ak"},{"kind":"text","text":", apart from the "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" variant. On each of the next "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" lines you have to print one number — the sought number of residents. Those number also have to go in the increasing order. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If any number (or both of them) "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" exceeds "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":", then you have to print "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":" instead of it and only the first "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":" possible answers in the increasing order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The numbers should have no leading zeros."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1\n1\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"13\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1\n2\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1729\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1\n4\n1\n156\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"40D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/40/problem/D"}