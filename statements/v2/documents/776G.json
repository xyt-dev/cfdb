{"assets":["/statement-assets/397d4994d8dd419918b44286ed91b6f51142a2b782bbf11a207b0ea8b4b37e6f.png","/statement-assets/3301ae14dbea822c24a9893fd3ebba7acea0f4c43f8d25ccc3189c4b112781d4.png"],"contentKind":"statement","contestId":"776","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Sherlock and the Encrypted Data"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sherlock found a piece of encrypted data which he thinks will be useful to catch Moriarty. The encrypted data consists of two integer "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":". He noticed that these integers were in hexadecimal form."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He takes each of the integers from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", and performs the following operations:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" He lists the distinct digits present in the given number. For example: for "},{"kind":"math_inline","text":"101416"},{"kind":"text","text":", he lists the digits as "},{"kind":"math_inline","text":"1, 0, 4"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then he sums respective powers of two for each digit listed in the step above. Like in the above example "},{"kind":"math_inline","text":"sum = 21 + 20 + 24 = 1910"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" He changes the initial number by applying bitwise "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" of the initial number and the sum. Example: "},{"attrs":{"alt":"","src":"/statement-assets/397d4994d8dd419918b44286ed91b6f51142a2b782bbf11a207b0ea8b4b37e6f.png"},"kind":"image"},{"kind":"text","text":". Note that "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" is done in binary notation. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"One more example: for integer "},{"children":[{"kind":"text","text":"1e"}],"kind":"container"},{"kind":"text","text":" the sum is "},{"kind":"math_inline","text":"sum = 21 + 214"},{"kind":"text","text":". Letters "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"f"}],"kind":"container"},{"kind":"text","text":" denote hexadecimal digits "},{"kind":"math_inline","text":"10"},{"kind":"text","text":", "},{"kind":"math_inline","text":"11"},{"kind":"text","text":", "},{"kind":"math_inline","text":"12"},{"kind":"text","text":", "},{"kind":"math_inline","text":"13"},{"kind":"text","text":", "},{"kind":"math_inline","text":"14"},{"kind":"text","text":", "},{"kind":"math_inline","text":"15"},{"kind":"text","text":", respertively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sherlock wants to count the numbers in the range from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" (both inclusive) which decrease on application of the above four steps. He wants you to answer his "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries for different "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains the integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 10000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain two hexadecimal integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ l ≤ r < 1615"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The hexadecimal integers are written using digits from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" and/or lowercase English letters "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"f"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The hexadecimal integers do not contain extra leading zeros."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains answer to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query (in decimal notation)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n1014 1014\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1e\n1 f\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 abc\nd0e fe23\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"412\n28464\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the second input,"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"1416 = 2010"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"sum = 21 + 24 = 18"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/3301ae14dbea822c24a9893fd3ebba7acea0f4c43f8d25ccc3189c4b112781d4.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus, it reduces. And, we can verify that it is the only number in range "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"1e"},{"kind":"text","text":" that reduces."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"776G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/776/problem/G"}