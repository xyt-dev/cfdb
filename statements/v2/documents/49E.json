{"assets":[],"contentKind":"statement","contestId":"49","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Common ancestor"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The DNA sequence for every living creature in Berland can be represented as a non-empty line consisting of lowercase Latin letters. Berland scientists found out that all the creatures evolve by stages. During one stage exactly one symbol of the DNA line is replaced by exactly two other ones. At that overall there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" permissible substitutions. The substitution "},{"children":[{"kind":"math_inline","text":"ai"},{"kind":"text","text":"->"},{"kind":"math_inline","text":"bici"}],"kind":"container"},{"kind":"text","text":" means that any "},{"children":[{"kind":"text","text":"one"}],"kind":"container"},{"kind":"text","text":" symbol "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" can be replaced with two symbols "},{"kind":"math_inline","text":"bici"},{"kind":"text","text":". Every substitution could happen an unlimited number of times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"They say that two creatures with DNA sequences "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" can have a common ancestor if there exists such a DNA sequence "},{"kind":"math_inline","text":"s3"},{"kind":"text","text":" that throughout evolution it can result in "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":", perhaps after a different number of stages. Your task is to find out by the given "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" whether the creatures possessing such DNA sequences can have a common ancestor. If the answer is positive, you have to find the length of the shortest sequence of the common ancestor’s DNA."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a non-empty DNA sequence "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":", the second line contains a non-empty DNA sequence "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":". The lengths of these lines do not exceed 50, the lines contain only lowercase Latin letters. The third line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ n ≤ 50"},{"kind":"text","text":") — the number of permissible substitutions. Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each of which describes a substitution in the format "},{"children":[{"kind":"math_inline","text":"ai"},{"kind":"text","text":"->"},{"kind":"math_inline","text":"bici"}],"kind":"container"},{"kind":"text","text":". The characters "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" are lowercase Latin letters. Lines "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" can coincide, the list of substitutions can contain similar substitutions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" cannot have a common ancestor, print -1. Otherwise print the length of the shortest sequence "},{"kind":"math_inline","text":"s3"},{"kind":"text","text":", from which "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" could have evolved."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ababa\naba\n2\nc->ba\nc->cc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ababa\naba\n7\nc->ba\nc->cc\ne->ab\nz->ea\nb->ba\nd->dd\nd->ab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ababa\naba\n1\nc->ba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"49E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/49/problem/E"}