{"assets":[],"contentKind":"statement","contestId":"288","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Polo the Penguin and Strings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little penguin Polo adores strings. But most of all he adores strings of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One day he wanted to find a string that meets the following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The string consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase English letters (that is, the string's length equals "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"), exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" of these letters are distinct. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" No two neighbouring letters of a string coincide; that is, if we represent a string as "},{"kind":"math_inline","text":"s = s1s2... sn"},{"kind":"text","text":", then the following inequality holds, "},{"kind":"math_inline","text":"si ≠ si + 1(1 ≤ i < n)"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Among all strings that meet points 1 and 2, the required string is lexicographically smallest. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help him find such string or state that such string doesn't exist."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"String "},{"kind":"math_inline","text":"x = x1x2... xp"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"lexicographically less"}],"kind":"container"},{"kind":"text","text":" than string "},{"kind":"math_inline","text":"y = y1y2... yq"},{"kind":"text","text":", if either "},{"kind":"math_inline","text":"p < q"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x1 = y1, x2 = y2, ... , xp = yp"},{"kind":"text","text":", or there is such number "},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"(r < p, r < q)"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"x1 = y1, x2 = y2, ... , xr = yr"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"xr + 1 < yr + 1"},{"kind":"text","text":". The characters of the strings are compared by their ASCII codes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line contains two positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n ≤ 106, 1 ≤ k ≤ 26)"},{"kind":"text","text":" — the string's length and the number of distinct letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print the required string. If there isn't such string, print \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"at