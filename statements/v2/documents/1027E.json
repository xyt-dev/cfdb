{"assets":["/statement-assets/5782bb812fe0b388e083d2bf2a7ee33d9644bf1901e9296e108f8713a5ba7b00.png","/statement-assets/eeca7ce4f6b4de9b9bf388474f6009a58bce44556f8f169080a281997b341f3f.png"],"contentKind":"statement","contestId":"1027","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Inverse Coloring"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a square board, consisting of $$$n$$$ rows and $$$n$$$ columns. Each tile in it should be colored either white or black."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call some coloring "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if each pair of adjacent rows are either the same or different in every position. The same condition should be held for the columns as well."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call some coloring "},{"children":[{"kind":"text","text":"suitable"}],"kind":"container"},{"kind":"text","text":" if it is "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" and there is no "},{"children":[{"kind":"text","text":"rectangle"}],"kind":"container"},{"kind":"text","text":" of the single color, consisting of at least $$$k$$$ tiles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to count the number of "},{"children":[{"kind":"text","text":"suitable"}],"kind":"container"},{"kind":"text","text":" colorings of the board of the given size."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since the answer can be very large, print it modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\le n \\le 500$$$, $$$1 \\le k \\le n^2$$$) — the number of rows and columns of the board and the maximum number of tiles inside the rectangle of the single color, respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of "},{"children":[{"kind":"text","text":"suitable"}],"kind":"container"},{"kind":"text","text":" colorings of the board of the given size modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"49 1808\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"359087121\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Board of size $$$1 \\times 1$$$ is either a single black tile or a single white tile. Both of them include a rectangle of a single color, consisting of $$$1$$$ tile."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here are the "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" colorings of a board of size $$$2 \\times 2$$$ that don't include rectangles of a single color, consisting of at least $$$3$$$ tiles:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5782bb812fe0b388e083d2bf2a7ee33d9644bf1901e9296e108f8713a5ba7b00.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The rest of "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" colorings of a board of size $$$2 \\times 2$$$ are the following:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/eeca7ce4f6b4de9b9bf388474f6009a58bce44556f8f169080a281997b341f3f.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1027E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1027/problem/E"}