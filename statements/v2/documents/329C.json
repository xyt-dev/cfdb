{"assets":["/statement-assets/680671e8e2a70767b4ee6c27d7cadff442cc93d77ba6088b7457a008885a9469.png","/statement-assets/2ed6dc7a6fe0d3cb5093e22308fa45f0da3f959084ff14315b0b8a0809cf141b.png","/statement-assets/19241cc0db4a05715e649c8e93efa792b0a273249394551aadc65884b2eac62f.png","/statement-assets/5454b4a13e85fd24df105ba2693dac612b5bbf7bf9e528d1e96c63dee342632b.png"],"contentKind":"statement","contestId":"329","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Graph Reconstruction"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"I have an undirected graph consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes, numbered 1 through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Each node has at most two incident edges. For each pair of nodes, there is at most an edge connecting them. No edge connects a node to itself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"I would like to create a new graph in such a way that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The new graph consists of the same number of nodes and edges as the old graph. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The properties in the first paragraph still hold. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For each two nodes "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", if there is an edge connecting them in the old graph, there is no edge connecting them in the new graph. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help me construct the new graph, or tell me if it is impossible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line consists of two space-separated integers: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ n ≤ 105"},{"kind":"text","text":"), denoting the number of nodes and edges, respectively. Then "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follow. Each of the "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines consists of two space-separated integers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ u, v ≤ n; u ≠ v"},{"kind":"text","text":"), denoting an edge between nodes "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is not possible to construct a new graph with the mentioned properties, output a single line consisting of -1. Otherwise, output exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines. Each line should contain a description of edge in the same way as used in the input format."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 7\n1 2\n2 3\n4 5\n5 6\n6 8\n8 7\n7 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 4\n4 6\n1 6\n2 7\n7 5\n8 5\n2 8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n1 2\n2 3\n3 4\n4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n3 5\n5 2\n2 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The old graph of the first example:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/680671e8e2a70767b4ee6c27d7cadff442cc93d77ba6088b7457a008885a9469.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A possible new graph for the first example:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/2ed6dc7a6fe0d3cb509