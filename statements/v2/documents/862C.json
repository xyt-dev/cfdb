{"assets":["/statement-assets/652465b1dee356944fb286c06341e71a9689fe28ed2040c8963b8b557bd9ddb3.png","/statement-assets/94db6f75431a3e37634f3cfc7e6fbd54c169e5ac359a8d535c5556b05ed29ccf.png"],"contentKind":"statement","contestId":"862","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Mahmoud and Ehab and the xor"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mahmoud and Ehab are on the third stage of their adventures now. As you know, Dr. Evil likes sets. This time he won't show them any set from his large collection, but will ask them to create a new set to replenish his beautiful collection of sets."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Dr. Evil has his favorite evil integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". He asks Mahmoud and Ehab to find a set of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct non-negative integers such the bitwise-xor sum of the integers in it is exactly "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". Dr. Evil doesn't like big numbers, so any number in the set shouldn't be greater than "},{"kind":"math_inline","text":"106"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ x ≤ 105"},{"kind":"text","text":") — the number of elements in the set and the desired bitwise-xor, respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no such set, print \"NO\" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, on the first line print \"YES\" (without quotes) and on the second line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers, denoting the elements in the set is any order. If there are multiple solutions you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1 2 4 5 7"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1 2 5"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"You can read more about the bitwise-xor operation here: "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the first sample "},{"attrs":{"alt":"","src":"/statement-assets/652465b1dee356944fb286c06341e71a9689fe28ed2040c8963b8b557bd9ddb3.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second sample "},{"attrs":{"alt":"","src":"/statement-assets/94db6f75431a3e37634f3cfc7e6fbd54c169e5ac359a8d535c5556b05ed29ccf.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"862C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/862/problem/C"}