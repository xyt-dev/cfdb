{"assets":[],"contentKind":"statement","contestId":"997","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Roman Digits"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's introduce a number system which is based on a roman digits. There are digits "},{"children":[{"kind":"text","text":"I"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"V"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":" which correspond to the numbers $$$1$$$, $$$5$$$, $$$10$$$ and $$$50$$$ respectively. The use of other roman digits is not allowed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Numbers in this system are written as a sequence of one or more digits. We define the value of the sequence simply as the sum of digits in it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the number "},{"children":[{"kind":"text","text":"XXXV"}],"kind":"container"},{"kind":"text","text":" evaluates to $$$35$$$ and the number "},{"children":[{"kind":"text","text":"IXI"}],"kind":"container"},{"kind":"text","text":" — to $$$12$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pay attention to the difference to the traditional roman system — in our system any sequence of digits is valid, moreover the order of digits doesn't matter, for example "},{"children":[{"kind":"text","text":"IX"}],"kind":"container"},{"kind":"text","text":" means $$$11$$$, not $$$9$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One can notice that this system is ambiguous, and some numbers can be written in many different ways. Your goal is to determine how many distinct integers can be represented by "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" $$$n$$$ roman digits "},{"children":[{"kind":"text","text":"I"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"V"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input file contains a single integer $$$n$$$ ($$$1 \\le n \\le 10^9$$$) — the number of roman digits to use."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the number of distinct integers which can be represented using $$$n$$$ roman digits "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"244\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample there are exactly $$$4$$$ integers which can be represented — "},{"children":[{"kind":"text","text":"I"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"V"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample it is possible to represent integers $$$2$$$ ("},{"children":[{"kind":"text","text":"II"}],"kind":"container"},{"kind":"text","text":"), $$$6$$$ ("},{"children":[{"kind":"text","text":"VI"}],"kind":"container"},{"kind":"text","text":"), $$$10$$$ ("},{"children":[{"kind":"text","text":"VV"}],"kind":"container"},{"kind":"text","text":"), $$$11$$$ ("},{"children":[{"kind":"text","text":"XI"}],"kind":"container"},{"kind":"text","text":"), $$$15$$$ ("},{"children":[{"kind":"text","text":"XV"}],"kind":"container"},{"kind":"text","text":"), $$$20$$$ ("},{"children":[{"kind":"text","text":"XX"}],"kind":"container"},{"kind":"text","text":"), $$$51$$$ ("},{"children":[{"kind":"text","text":"IL"}],"kind":"container"},{"kind":"text","text":"), $$$55$$$ ("},{"children":[{"kind":"text","text":"VL"}],"kind":"container"},{"kind":"text","text":"), $$$60$$$ ("},{"children":[{"kind":"text","text":"XL"}],"kind":"container"},{"kind":"text","text":") and $$$100$$$ ("},{"children":[{"kind":"text","text":"LL"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"997B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/997/problem/B"}