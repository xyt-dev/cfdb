{"assets":[],"contentKind":"statement","contestId":"271","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Good Substrings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of small English letters. Some of the English letters are "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":", the rest are "},{"children":[{"kind":"text","text":"bad"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A substring "},{"kind":"math_inline","text":"s[l...r]"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ |s|"},{"kind":"text","text":") of string "},{"kind":"math_inline","text":"s  =  s1s2...s|s|"},{"kind":"text","text":" (where "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":" is the length of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":") is string "},{"kind":"math_inline","text":" slsl + 1...sr"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The substring "},{"kind":"math_inline","text":"s[l...r]"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":", if among the letters "},{"kind":"math_inline","text":" sl, sl + 1, ..., sr"},{"kind":"text","text":" there are "},{"children":[{"kind":"text","text":"at most"}],"kind":"container"},{"kind":"math_inline","text":"k"},{"children":[{"kind":"text","text":"bad"}],"kind":"container"},{"kind":"text","text":" ones (look at the sample's explanation to understand it more clear)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the number of distinct good substrings of the given string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Two substrings "},{"kind":"math_inline","text":"s[x...y]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s[p...q]"},{"kind":"text","text":" are considered distinct if their content is different, i.e. "},{"kind":"math_inline","text":"s[x...y] ≠ s[p...q]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input is the non-empty string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of small English letters, the string's length is at most "},{"kind":"math_inline","text":"1500"},{"kind":"text","text":" characters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input is the string of characters \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\", the length is exactly 26 characters. If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character of this string equals \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\", then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th English letter is good, otherwise it's bad. That is, the first character of this string corresponds to letter \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", the second one corresponds to letter \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\" and so on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line of the input consists a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ k ≤ |s|"},{"kind":"text","text":") — the maximum acceptable number of bad characters in a good substring."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of distinct good substrings of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ababab\n01000000000000000000000000\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"acbacbacaa\n00000000000000000000000000\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"k