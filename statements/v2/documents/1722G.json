{"assets":[],"contentKind":"statement","contestId":"1722","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Even-Odd XOR"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Given an integer $$$n$$$, find any array $$$a$$$ of $$$n$$$ "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" nonnegative integers less than $$$2^{31}$$$ such that the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise XOR"}],"kind":"link"},{"kind":"text","text":" of the elements on odd indices equals the bitwise XOR of the elements on even indices."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer $$$t$$$ ($$$1 \\leq t \\leq 629$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$t$$$ lines follow, each containing a single integer $$$n$$$ $$$(3 \\leq n \\leq 2\\cdot10^5)$$$ — the length of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2\\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output one line containing $$$n$$$ distinct integers that satisfy the conditions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, you can output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n8\n3\n4\n5\n6\n7\n9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4 2 1 5 0 6 7 3\n2 1 3\n2 1 3 0\n2 0 4 5 3\n4 1 2 12 3 8\n1 2 3 4 5 6 7\n8 2 3 7 4 0 5 6 9"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case the XOR on odd indices is $$$4 \\oplus 1 \\oplus 0 \\oplus 7 = 2$$$ and the XOR on even indices is $$$2 \\oplus 5 \\oplus 6 \\oplus 3= 2$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1722G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1722/problem/G"}