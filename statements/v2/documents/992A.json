kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example you can add "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":" to all non-zero elements in one second and make them equal to zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example you can add "},{"kind":"math_inline","text":" - 2"},{"kind":"text","text":" on the first second, then the array becomes equal to "},{"kind":"math_inline","text":"[0, 0,  - 3]"},{"kind":"text","text":". On the second second you can add "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" to the third (the only non-zero) element."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"992A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/992/problem/A"}