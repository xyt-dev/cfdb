{"assets":[],"contentKind":"statement","contestId":"992","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Nastya and an Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Nastya owns too many arrays now, so she wants to delete the least important of them. However, she discovered that this array is magic! Nastya now knows that the array has the following properties:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" In one second we can add an arbitrary (possibly negative) integer to all elements of the array that are not equal to zero. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" When all elements of the array become equal to zero, the array explodes. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Nastya is always busy, so she wants to explode the array as fast as possible. Compute the minimum time in which the array can be exploded."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the size of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":