{"assets":["/statement-assets/bc21c877db8f77a1ce34435cfaf98c32e6b05ea0da90b0afff0edd80ff0e0fb6.png"],"contentKind":"statement","contestId":"30","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Tricky and Clever Password"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In his very young years the hero of our story, king Copa, decided that his private data was hidden not enough securely, what is unacceptable for the king. That's why he invented tricky and clever password (later he learned that his password is a palindrome of odd length), and coded all his data using it. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Copa is afraid to forget his password, so he decided to write it on a piece of paper. He is aware that it is insecure to keep password in such way, so he decided to cipher it the following way: he cut "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" characters from the start of his password and from the end of it ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":" can be "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"2x"},{"kind":"text","text":" is strictly less than the password length). He obtained 3 "},{"children":[{"children":[{"kind":"text","text":"parts of the password"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":". Let's call it "},{"kind":"math_inline","text":"prefix"},{"kind":"text","text":", "},{"kind":"math_inline","text":"middle"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"suffix"},{"kind":"text","text":" correspondingly, both "},{"kind":"math_inline","text":"prefix"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"suffix"},{"kind":"text","text":" having equal length and "},{"kind":"math_inline","text":"middle"},{"kind":"text","text":" always having odd length. From these parts he made a string "},{"kind":"math_inline","text":"A + prefix + B + middle + C + suffix"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" are some (possibly empty) strings invented by Copa, and «"},{"kind":"math_inline","text":" + "},{"kind":"text","text":"» means concatenation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Many years have passed, and just yesterday the king Copa found the piece of paper where his ciphered password was written. The password, as well as the strings "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"C"},{"kind":"text","text":", was completely forgotten by Copa, so he asks you to find a password of maximum possible length, which could be invented, ciphered and written by Copa."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input contains single string of small Latin letters with length from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"105"},{"kind":"text","text":" characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line should contain integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — amount of "},{"children":[{"children":[{"kind":"text","text":"nonempty parts of the password"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" in your answer ("},{"attrs":{"alt":"","src":"/statement-assets/bc21c877db8f77a1ce34435cfaf98c32e6b05ea0da90b0afff0edd80ff0e0fb6.png"},"kind":"image"},{"kind":"text","text":"). In each of the following "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines output two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" — start and length of the corresponding part of the password. Output pairs in order of increasing "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". Separate the numbers in pairs by a single space."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Starting position "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" should be an integer from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to the length of the input string. All "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" must be positive, because you should output only non-empty parts. The middle part must have odd length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several solutions, output any. Note that your goal is to maximize the sum of "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", but not to maximize "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abacaba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1 7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"axbya\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1\n2 1\n5 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"xabyczba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 2\n4 1\n7 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"30E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/30/problem/E"}