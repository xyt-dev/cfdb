{"assets":[],"contentKind":"statement","contestId":"279","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Ladder"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got an array, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". Also, you've got "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query is described by two integers "},{"kind":"math_inline","text":"li, ri"},{"kind":"text","text":". Numbers "},{"kind":"math_inline","text":"li, ri"},{"kind":"text","text":" define a subsegment of the original array, that is, the sequence of numbers "},{"kind":"math_inline","text":"ali, ali + 1, ali + 2, ..., ari"},{"kind":"text","text":". For each query you should check whether the corresponding segment is a ladder. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"ladder"}],"kind":"container"},{"kind":"text","text":" is a sequence of integers "},{"kind":"math_inline","text":"b1, b2, ..., bk"},{"kind":"text","text":", such that it first doesn't decrease, then doesn't increase. In other words, there is such integer "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"(1 ≤ x ≤ k)"},{"kind":"text","text":", that the following inequation fulfills: "},{"kind":"math_inline","text":"b1 ≤ b2 ≤ ... ≤ bx ≥ bx + 1 ≥ bx + 2... ≥ bk"},{"kind":"text","text":". Note that the non-decreasing and the non-increasing sequences are also considered ladders."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 105)"},{"kind":"text","text":" — the number of array elements and the number of queries. The second line contains the sequence of integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 109"},{"kind":"text","text":"), where number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" stands for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th array element."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the description of the queries. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains the description of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query, consisting of two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"math_inline","text":"(1 ≤ li ≤ ri ≤ n)"},{"kind":"text","text":" — the boundaries of the subsegment of the initial array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The numbers in the lines are separated by single spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines, in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print word \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if the subsegment that corresponds to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query is the ladder, or word \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) otherwise. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 6\n1 2 1 3 3 5 2 1\n1 3\n2 3\n2 4\n8 8\n1 4\n5 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\nYes\nNo\nYes\nNo\nYes\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"279C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/279/problem/C"}