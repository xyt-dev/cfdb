{"assets":[],"contentKind":"statement","contestId":"958","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B2. Maximum Control (medium)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Resistance is trying to take control over as many planets of a particular solar system as possible. Princess Heidi is in charge of the fleet, and she must send ships to some planets in order to maximize the number of controlled planets."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Galaxy contains "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" planets, connected by bidirectional hyperspace tunnels in such a way that there is a unique path between every pair of the planets."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A planet is controlled by the Resistance if there is a Resistance ship in its orbit, or if the planet lies on the shortest path between some two planets that have Resistance ships in their orbits."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Heidi has not yet made up her mind as to how many ships to use. Therefore, she is asking you to compute, for every "},{"kind":"math_inline","text":"K = 1, 2, 3, ..., N"},{"kind":"text","text":", the maximum number of planets that can be controlled with a fleet consisting of "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" ships."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ N ≤ 105"},{"kind":"text","text":") – the number of planets in the galaxy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"N - 1"},{"kind":"text","text":" lines describe the hyperspace tunnels between the planets. Each of the "},{"kind":"math_inline","text":"N - 1"},{"kind":"text","text":" lines contains two space-separated integers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ u, v ≤ N"},{"kind":"text","text":") indicating that there is a bidirectional hyperspace tunnel between the planets "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". It is guaranteed that every two planets are connected by a path of tunnels, and that each tunnel connects a different pair of planets."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On a single line, print "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" space-separated integers. The "},{"kind":"math_inline","text":"K"},{"kind":"text","text":"-th number should correspond to the maximum number of planets that can be controlled by the Resistance using a fleet of "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" ships."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3 3 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2\n3 2\n4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3 4 4 "}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first example. If "},{"kind":"math_inline","text":"K = 1"},{"kind":"text","text":", then Heidi can only send one ship to some planet and control it. However, for "},{"kind":"math_inline","text":"K ≥ 2"},{"kind":"text","text":", sending ships to planets 1 and 3 will allow the Resistance to control all planets."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B2","problemCode":"958B2","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/958/problem/B2"}