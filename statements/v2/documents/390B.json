{"assets":[],"contentKind":"statement","contestId":"390","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Inna, Dima and Song"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Inna is a great piano player and Dima is a modest guitar player. Dima has recently written a song and they want to play it together. Of course, Sereja wants to listen to the song very much. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A song is a sequence of notes. Dima and Inna want to play each note at the same time. At that, they can play the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th note at volume "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v ≤ ai"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is an integer) both on the piano and the guitar. They should retain harmony, so the total volume with which the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th note was played on the guitar and the piano must equal "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". If Dima and Inna cannot play a note by the described rules, they skip it and Sereja's joy drops by 1. But if Inna and Dima play the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th note at volumes "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"math_inline","text":"(xi + yi = bi)"},{"kind":"text","text":" correspondingly, Sereja's joy rises by "},{"kind":"math_inline","text":"xi·yi"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sereja has just returned home from the university and his current joy is 0. Help Dima and Inna play the song so as to maximize Sereja's total joy after listening to the whole song!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":" — the number of notes in the song. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 106)"},{"kind":"text","text":". The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"bi"},{"kind":"math_inline","text":"(1 ≤ bi ≤ 106)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print an integer — the maximum possible joy Sereja feels after he listens to a song."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 2\n2 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Dima and Inna play the first two notes at volume "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 + 1 = 2"},{"kind":"text","text":", the condition holds), they should play the last note at volumes "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Sereja's total joy equals: "},{"kind":"math_inline","text":"1·1 + 1·1 + 1·2 = 4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, there is no such pair "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"1 ≤ x, y ≤ 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x + y = 5"},{"kind":"text","text":", so Dima and Inna skip a note. Sereja's total joy equals -1."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"390B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/390/problem/B"}