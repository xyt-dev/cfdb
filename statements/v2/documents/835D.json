{"assets":[],"contentKind":"statement","contestId":"835","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Palindromic characteristics"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Palindromic characteristics of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" with length "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":" is a sequence of "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":" integers, where "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th number is the total number of non-empty substrings of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" which are "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-palindromes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-palindrome if and only if it reads the same backward as forward."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string is "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-palindrome ("},{"kind":"math_inline","text":"k > 1"},{"kind":"text","text":") if and only if: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Its left half equals to its right half. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Its left and right halfs are non-empty ("},{"kind":"math_inline","text":"k - 1"},{"kind":"text","text":")-palindromes. "}],"kind":"l