{"assets":[],"contentKind":"statement","contestId":"1281","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Suffix Three"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"We just discovered a new data structure in our research group: a "},{"children":[{"kind":"text","text":"suffix three"}],"kind":"container"},{"kind":"text","text":"!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's very useful for natural language processing. Given three languages and three suffixes, a suffix three can determine which language a sentence is written in."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's super simple, 100% accurate, and doesn't involve advanced machine learning algorithms."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us tell you how it works."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If a sentence ends with \""},{"children":[{"kind":"text","text":"po"}],"kind":"container"},{"kind":"text","text":"\" the language is Filipino. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If a sentence ends with \""},{"children":[{"kind":"text","text":"desu"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"masu"}],"kind":"container"},{"kind":"text","text":"\" the language is Japanese. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If a sentence ends with \""},{"children":[{"kind":"text","text":"mnida"}],"kind":"container"},{"kind":"text","text":"\" the language is Korean. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Given this, we need you to implement a suffix three that can differentiate Filipino, Japanese, and Korean."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Oh, did I say three suffixes? I meant four."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 30$$$) denoting the number of test cases. The next lines contain descriptions of the test cases. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of a single line containing a single string denoting the sentence. Spaces are represented as underscores (the symbol \""},{"children":[{"kind":"text","text":"_"}],"kind":"container"},{"kind":"text","text":"\") for ease of reading. The sentence has at least $$$1$$$ and at most $$$1000$$$ characters, and consists only of lowercase English letters and underscores. The sentence has no leading or trailing underscores and no two consecutive underscores. It is guaranteed that the sentence ends with one of the four suffixes mentioned above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single line containing either \""},{"children":[{"kind":"text","text":"FILIPINO"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"JAPANESE"}],"kind":"container"},{"kind":"text","text":"\", or \""},{"children":[{"kind":"text","text":"KOREAN"}],"kind":"container"},{"kind":"text","text":"\" (all in uppercase, without quotes), depending on the detected language."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8\nkamusta_po\ngenki_desu\nohayou_gozaimasu\nannyeong_hashimnida\nhajime_no_ippo\nbensamu_no_sentou_houhou_ga_okama_kenpo\nang_halaman_doon_ay_sarisari_singkamasu\nsi_roy_mustang_ay_namamasu\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nFILIPINO\nJAPANESE\nJAPANESE\nKOREAN\nFILIPINO\nFILIPINO\nJAPANESE\nJAPANESE\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first sentence ends with \""},{"children":[{"kind":"text","text":"po"}],"kind":"container"},{"kind":"text","text":"\", so it is written in Filipino."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second and third sentences end with \""},{"children":[{"kind":"text","text":"desu"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"masu"}],"kind":"container"},{"kind":"text","text":"\", so they are written in Japanese."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fourth sentence ends with \""},{"children":[{"kind":"text","text":"mnida"}],"kind":"container"},{"kind":"text","text":"\", so it is written in Korean."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1281A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1281/problem/A"}