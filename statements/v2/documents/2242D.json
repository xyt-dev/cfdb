{"assets":[],"contentKind":"statement","contestId":"2242","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Two Digit Strings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two strings $$$a$$$ and $$$b$$$, consisting only of digits. In one operation, you can choose two adjacent characters in either of these two strings and replace them with their sum modulo $$$10$$$. For example, from the string $$$57246$$$ you can obtain the following strings in one operation: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$\\mathbf{57}246 \\rightarrow 2246$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$5\\mathbf{72}46 \\rightarrow 5946$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$57\\mathbf{24}6 \\rightarrow 5766$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$572\\mathbf{46} \\rightarrow 5720$$$; "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that after such an operation, the length of the string always decreases by exactly $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can perform any number of such operations (even zero). You have to make these strings equal ($$$|a| = |b|$$$ and $$$a_i = b_i$$$ for all $$$i$$$ from $$$1$$$ to $$$|a|$$$). Calculate the maximum possible length of the resulting equal strings. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 2 \\cdot 10^3$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a string $$$a$$$ ($$$1 \\le |a| \\le 5 \\cdot 10^3$$$), consisting only of digits."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$b$$$ ($$$1 \\le |b| \\le 5 \\cdot 10^3$$$), consisting only of digits."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraint on the input: $$$\\sum (|a| + |b|) $$$ across all test cases does not exceed $$$10^4$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer — the maximum possible length of the resulting equal strings. If you can't make the strings equal, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n5147\n44441\n2194\n5602\n123450\n012345\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n-1\n5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example from the statement, the maximum length you can obtain is "},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":": "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$\\mathbf{51}47 \\rightarrow 6\\mathbf{47} \\rightarrow 61$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\mathbf{44}441 \\rightarrow \\mathbf{84}41 \\rightarrow \\mathbf{24}1 \\rightarrow 61$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second example from the statement, you can't make strings $$$a$$$ and $$$b$$$ equal, so the answer is "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example from the statement, the maximum length you can obtain is "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":": "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1234\\mathbf{50} \\rightarrow 12345$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\mathbf{01}2345 \\rightarrow 12345$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"2242D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2242/problem/D"}