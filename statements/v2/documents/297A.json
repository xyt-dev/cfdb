{"assets":["/statement-assets/b69e55ce6a2d52a7d6bc2fd2870bee56e7b1bdc47393a7c70fa69f2353854439.png","/statement-assets/022e351caac16b4dbb4c3f8bd130027387c4bb169eefd8006297d601ded42fa1.png"],"contentKind":"statement","contestId":"297","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Parity Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are fishing with polar bears Alice and Bob. While waiting for the fish to bite, the polar bears get bored. They come up with a game. First Alice and Bob each writes a 01-string (strings that only contain character \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\") "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Then you try to turn "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" using two types of operations:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Write "},{"kind":"math_inline","text":"parity(a)"},{"kind":"text","text":" to the end of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". For example, "},{"attrs":{"alt":"","src":"/statement-assets/b69e55ce6a2d52a7d6bc2fd2870bee56e7b1bdc47393a7c70fa69f2353854439.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Remove the first character of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". For example, "},{"attrs":{"alt":"","src":"/statement-assets/022e351caac16b4dbb4c3f8bd130027387c4bb169eefd8006297d601ded42fa1.png"},"kind":"image"},{"kind":"text","text":". You cannot perform this operation if "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is empty. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You can use as many operations as you want. The problem is, is it possible to turn "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"parity"},{"kind":"text","text":" of a 01-string is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" if there is an odd number of \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\"s in the string, and "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and the second line contains the string "},{"kind":"math_inline","text":"b"},{"kind":"math_inline","text":"(1 ≤ |a|, |b| ≤ 1000)"},{"kind":"text","text":". Both strings contain only the characters \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\". Here "},{"kind":"math_inline","text":"|x|"},{"kind":"text","text":" denotes the length of the string "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if it is possible to turn "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"01011\n0110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0011\n1110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the steps are as follows: "},{"kind":"math_inline","text":"01011 → 1011 → 011 → 0110"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"in