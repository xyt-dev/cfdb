{"assets":[],"contentKind":"statement","contestId":"858","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Wizard's Tour"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"All Berland residents are waiting for an unprecedented tour of wizard in his Blue Helicopter over the cities of Berland!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is well-known that there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities in Berland, some pairs of which are connected by bidirectional roads. Each pair of cities is connected by no more than one road. It is not guaranteed that the road network is "},{"children":[{"kind":"text","text":"connected"}],"kind":"container"},{"kind":"text","text":", i.e. it is possible that you can't reach some city from some other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The tour will contain several episodes. In each of the episodes:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the wizard will disembark at some city "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" from the Helicopter; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" he will give a performance and show a movie for free at the city "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" he will drive to some neighboring city "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" using a road; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" he will give a performance and show a movie for free at the city "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" he will drive to some neighboring to "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" city "},{"kind":"math_inline","text":"z"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" he will give a performance and show a movie for free at the city "},{"kind":"math_inline","text":"z"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" he will embark the Helicopter and fly away from the city "},{"kind":"math_inline","text":"z"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is known that the wizard doesn't like to use roads, so he agrees to use each road at most once (regardless of direction). In other words, for road between "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" he only can drive once from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", or drive once from "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", or do not use this road at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The wizards wants to plan as many episodes as possible without violation the above rules. Help the wizard!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please note that the wizard can visit the same city multiple times, the restriction is on roads only."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ m ≤ 2·105"},{"kind":"text","text":") — the number of cities and the number of roads in Berland, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The roads description follow, one in each line. Each description is a pair of two integers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" are the ids of the cities connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road. It is guaranteed that there are no two roads connecting the same pair of cities. Every road is bidirectional. The cities are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is possible that the road network in Berland is not connected."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" — the maximum possible number of episodes. The next "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" lines should contain the episodes in format "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" — the three integers denoting the ids of the cities in the order of the wizard's visits."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n1 2\n3 2\n2 4\n3 4\n4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 4 2\n4 3 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 8\n5 3\n1 2\n4 5\n5 1\n2 5\n4 3\n1 4\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 4 5\n2 3 4\n1 5 3\n5 2 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"858F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/858/problem/F"}