{"assets":[],"contentKind":"statement","contestId":"1396","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Distance Matching"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an integer $$$k$$$ and a "},{"children":[{"kind":"text","text":"tree"}],"kind":"container"},{"kind":"text","text":" $$$T$$$ with $$$n$$$ nodes ($$$n$$$ is even)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$dist(u, v)$$$ be the number of edges on the shortest path from node $$$u$$$ to node $$$v$$$ in $$$T$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us define a "},{"children":[{"kind":"text","text":"undirected weighted complete graph"}],"kind":"container"},{"kind":"text","text":" $$$G = (V, E)$$$ as following: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$V = \\{x \\mid 1 \\le x \\le n \\}$$$ i.e. the set of integers from $$$1$$$ to $$$n$$$"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$E = \\{(u, v, w) \\mid 1 \\le u, v \\le n, u \\neq v, w = dist(u, v) \\}$$$ i.e. there is an edge between every pair of distinct nodes, the weight being the distance between their respective nodes in $$$T$$$ "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is simple, find a "},{"children":[{"kind":"text","text":"perfect matching"}],"kind":"container"},{"kind":"text","text":" in $$$G$$$ with total edge weight $$$k$$$ $$$(1 \\le k \\le n^2)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers $$$n$$$, $$$k$$$ ($$$2 \\le n \\le 100\\,000$$$, $$$n$$$ is even, $$$1 \\le k \\le n^2$$$): number of nodes and the total edge weight of the perfect matching you need to find."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the following $$$n - 1$$$ lines contains two integers $$$v_i$$$, $$$u_i$$$ ($$$1 \\le v_i, u_i \\le n$$$) denoting an edge between $$$v_i$$$ and $$$u_i$$$ in $$$T$$$. It is guaranteed that the given graph is a tree. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there are no matchings that satisfy the above condition, output \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) on a single line. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, you should output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) on the first line of output."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You should then output $$$\\frac{n}{2}$$$ lines, the $$$i$$$-th line containing $$$p_i, q_i$$$ ($$$1 \\le p_i, q_i \\le n$$$): the $$$i$$$-th pair of the matching."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 2\n1 2\n2 3\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n2 1\n3 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 4\n1 2\n2 3\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n3 1\n2 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"tree"}],"kind":"container"},{"kind":"text","text":" is a connected acyclic undirected graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"matching"}],"kind":"container"},{"kind":"text","text":" is set of pairwise non-adjacent edges, none of which are loops; that is, no two edges share a common vertex. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"perfect matching"}],"kind":"container"},{"kind":"text","text":" is a matching which matches all vertices of the graph; that is, every vertex of the graph is incident to exactly one edge of the matching."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1396E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1396/problem/E"}