xt","text":" Add some integer $$$y$$$ ($$$-10^{18} \\le y \\le 10^{18}$$$) to $$$x$$$."},{"children":[{"kind":"text","text":" The jury will output "},{"children":[{"kind":"text","text":"\"1\""}],"kind":"container"},{"kind":"text","text":" if $$$x + y$$$ is within $$$[1, 10^{18}]$$$ ("},{"children":[{"kind":"text","text":"successful"}],"kind":"container"},{"kind":"text","text":"), and "},{"children":[{"kind":"text","text":"\"0\""}],"kind":"container"},{"kind":"text","text":" otherwise. If successful, update $$$x \\leftarrow x + y$$$."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"\"mul $$$y$$$\""}],"kind":"container"},{"kind":"text","text":" Multiply $$$x$$$ by a positive integer $$$y$$$ ($$$1 \\le y \\le 10^{18}$$$)."},{"children":[{"kind":"text","text":" The jury will output "},{"children":[{"kind":"text","text":"\"1\""}],"kind":"container"},{"kind":"text","text":" if $$$x \\cdot y$$$ is within $$$[1, 10^{18}]$$$ ("},{"children":[{"kind":"text","text":"successful"}],"kind":"container"},{"kind":"text","text":"), and "},{"children":[{"kind":"text","text":"\"0\""}],"kind":"container"},{"kind":"text","text":" otherwise. If successful, update $$$x \\leftarrow x \\cdot y$$$."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"\"div $$$y$$$\""}],"kind":"container"},{"kind":"text","text":" Divide $$$x$$$ by a positive integer $$$y$$$ ($$$1 \\le y \\le 10^{18}$$$)."},{"children":[{"kind":"text","text":" The jury will output "},{"children":[{"kind":"text","text":"\"1\""}],"kind":"container"},{"kind":"text","text":" if $$$y$$$ is a divisor of $$$x$$$ ("},{"children":[{"kind":"text","text":"successful"}],"kind":"container"},{"kind":"text","text":"), and "},{"children":[{"kind":"text","text":"\"0\""}],"kind":"container"},{"kind":"text","text":" otherwise. If successful, update $$$x \\leftarrow \\frac{x}{y}$$$."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"\"digit\""}],"kind":"container"},{"kind":"text","text":" Make $$$x$$$ equal to the sum of its digits."},{"children":[{"kind":"text","text":" The jury will always output "},{"children":[{"kind":"text","text":"\"1\""}],"kind":"container"},{"kind":"text","text":" and update $$$x \\leftarrow S(x)$$$."}],"kind":"paragraph"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that commands are "},{"children":[{"kind":"text","text":"case sensitive"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When you have determined that $$$x$$$ is equal to $$$n$$$, output a line in the following format:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"\"!\""}],"kind":"container"},{"kind":"text","text":" — where the jury will output a "},{"children":[{"kind":"text","text":"\"1\""}],"kind":"container"},{"kind":"text","text":" if $$$n$$$ is equal to $$$x$$$, and "},{"children":[{"kind":"text","text":"\"-1\""}],"kind":"container"},{"kind":"text","text":" otherwise. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that answering "},{"children":[{"kind":"text","text":"does not count"}],"kind":"container"},{"kind":"text","text":" toward your limit of $$$\\mathbf{4}$$$ commands."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If your program makes more than $$$\\mathbf{4}$$$ commands for one test case, or makes an invalid command, then the response to the command will be "},{"children":[{"kind":"text","text":"\"-1\""}],"kind":"container"},{"kind":"text","text":". After receiving such a response, your program should immediately terminate to receive the verdict "},{"children":[{"kind":"text","text":"Wrong Answer"}],"kind":"container"},{"kind":"text","text":". Otherwise, it may receive any other verdict."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After printing a command, do not forget to output the end of the line and flush the output. Otherwise, you will get "},{"children":[{"kind":"text","text":"Idleness limit exceeded"}],"kind":"container"},{"kind":"text","text":". To do this, use:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"fflush(stdout)"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"cout.flush()"}],"kind":"container"},{"kind":"text","text":" in C++; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"System.out.flush()"}],"kind":"container"},{"kind":"text","text":" in Java; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"sys.stdout.flush()"}],"kind":"container"},{"kind":"text","text":" in Python; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"std::io::stdout().flush()"}],"kind":"container"},{"kind":"text","text":" in Rust; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" see the documentation for other languages. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The interactor is "},{"children":[{"kind":"text","text":"non-adaptive"}],"kind":"container"},{"kind":"text","text":". The unknown integer $$$x$$$ "},{"children":[{"kind":"text","text":"does not change"}],"kind":"container"},{"kind":"text","text":" during the interaction."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Hacks"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To hack, use the following format."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line should contain a single integer $$$t$$$ ($$$1 \\leq t \\leq 5000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case should contain two positive integers $$$n$$$ and $$$x$$$ ($$$1 \\leq n,x \\leq 10^9$$$) — denoting the unknown integer and the target value to which 