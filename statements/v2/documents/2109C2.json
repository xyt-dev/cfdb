"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"Jury's response"}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"\"add $$$y$$$\""}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$-10^{18} \\le y \\le 10^{18}$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\mathrm{res} = x + y$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\text{if } 1 \\le \\mathrm{res} \\le 10^{18}$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$x \\leftarrow \\mathrm{res}$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"\"1\""}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\mathrm{else}$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$x \\leftarrow x$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"\"0\""}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"\"mul $$$y$$$\""}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$1 \\le y \\le 10^{18}$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\mathrm{res} = x \\cdot y$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$\\text{if } 1 \\le \\mathrm{res} \\le 10^{18}$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$x \\leftarrow \\mathrm{res}$$$"}],"kind":"table_cell"},{"attrs"