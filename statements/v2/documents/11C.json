{"assets":[],"contentKind":"statement","contestId":"11","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. How Many Squares?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a 0-1 rectangular matrix. What is the number of squares in it? A square is a solid square frame (border) with linewidth equal to 1. A square should be at least "},{"kind":"math_inline","text":"2 × 2"},{"kind":"text","text":". We are only interested in two types of squares: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" squares with each side parallel to a side of the matrix; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" squares with each side parallel to a diagonal of the matrix. "}],"kind":"list_item"}],"kind":"list"},{"kind":"code_block","text":"\nFor example the following matrix contains only one square of the first type: \n0000000 \n0111100 \n0100100 \n0100100 \n0111100\n"},{"kind":"code_block","text":"\nThe following matrix contains only one square of the second type:\n0000000\n0010000\n0101000\n0010000\n0000000\n"},{"children":[{"kind":"text","text":"Regardless of type, a square must contain at least one "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" and can't touch (by side or corner) any foreign "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". Of course, the lengths of the sides of each square should be equal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How many squares are in the given matrix?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 10000"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is the number of test cases in the input. Then test cases follow. Each case starts with a line containing integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n, m ≤ 250"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the number of rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is the number of columns. The following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters each ("},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The total number of characters in all test cases doesn't exceed "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" for any input file."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"You should output exactly "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines, with the answer to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th test case on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n8 8\n00010001\n00101000\n01000100\n10000010\n01000100\n00101000\n11010011\n11000011\n10 10\n1111111000\n1000001000\n1011001000\n1011001010\n1000001101\n1001001010\n1010101000\n1001001000\n1000001000\n1111111000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n12 11\n11111111111\n10000000001\n10111111101\n10100000101\n10101100101\n10101100101\n10100000101\n10100000101\n10111111101\n10000000001\n11111111111\n00000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"11C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/11/problem/C"}