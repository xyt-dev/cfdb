{"assets":[],"contentKind":"statement","contestId":"644","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Parliament of Berland"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" parliamentarians in Berland. They are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". It happened that all parliamentarians with odd indices are Democrats and all parliamentarians with even indices are Republicans."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"New parliament assembly hall is a rectangle consisting of "},{"kind":"math_inline","text":"a × b"},{"kind":"text","text":" chairs — "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" rows of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" chairs each. Two chairs are considered neighbouring if they share as side. For example, chair number "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" in row number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" is neighbouring to chairs number "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" in this row and chairs with number "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" in rows "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". Thus, chairs have four neighbours in general, except for the chairs on the border of the hall"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We know that if two parliamentarians from one political party (that is two Democrats or two Republicans) seat nearby they spent all time discussing internal party issues."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Write the program that given the number of parliamentarians and the sizes of the hall determine if there is a way to find a seat for any parliamentarian, such that no two members of the same party share neighbouring seats."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ a, b ≤ 100"},{"kind":"text","text":") — the number of parliamentarians, the number of rows in the assembly hall and the number of seats in each row, respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no way to assigns seats to parliamentarians in a proper way print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print the solution in "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" lines, each containing "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" integers. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th integer of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line should be equal to the index of parliamentarian occupying this seat, or "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" if this seat should remain empty. If there are multiple possible solution, you may print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 3\n1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7 8 3\n0 1 4\n6 0 5\n0 2 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample there are many other possible solutions. For example, "}],"kind":"paragraph"},{"kind":"code_block","text":"3 2\n0 1\n"},{"children":[{"kind":"text","text":"and "}],"kind":"paragraph"},{"kind":"code_block","text":"2 1\n3 0\n"},{"children":[{"kind":"text","text":"The following assignment "}],"kind":"paragraph"},{"kind":"code_block","text":"3 2\n1 0\n"},{"children":[{"kind":"text","text":"is incorrect, because parliamentarians "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" are both from Democrats party but will occupy neighbouring seats."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"644A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/644/problem/A"}