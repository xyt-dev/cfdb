{"assets":["/statement-assets/7426515302ce9271b6d47758074b17b8ae5914396e4d7ad22e1121b991bff83e.png"],"contentKind":"statement","contestId":"613","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Necklace"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ivan wants to make a necklace as a present to his beloved girl. A "},{"children":[{"kind":"text","text":"necklace"}],"kind":"container"},{"kind":"text","text":" is a cyclic sequence of beads of different colors. Ivan says that necklace is "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" relative to the cut point between two adjacent beads, if the chain of beads remaining after this cut is a palindrome (reads the same forward and backward)."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/7426515302ce9271b6d47758074b17b8ae5914396e4d7ad22e1121b991bff83e.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Ivan has beads of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" colors. He wants to make a necklace, such that it's beautiful relative to as many cuts as possible. He certainly wants to use all the beads. Help him to make the most beautiful necklace."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 26"},{"kind":"text","text":") — the number of colors of beads. The second line contains after "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"   — the quantity of beads of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th color. It is guaranteed that the sum of "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is at least 2 and does not exceed "},{"kind":"math_inline","text":"100 000"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single number — the maximum number of beautiful cuts that a necklace composed from given beads may have. In the second line print any example of such necklace."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each color of the beads should be represented by the corresponding lowercase English letter (starting with "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"). As the necklace is cyclic, print it starting from any point."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n4 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\nabacaba"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\naaaa\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\nab\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample a necklace can have at most one beautiful cut. The example of such a necklace is shown on the picture."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample there is only one way to compose a necklace."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"613C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/613/problem/C"}