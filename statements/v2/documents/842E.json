{"assets":[],"contentKind":"statement","contestId":"842","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Nikita and game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Nikita plays a new computer game. There are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" levels in this game. In the beginning of each level a new class appears in the game; this class is a child-class of the class "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" (and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" is called parent-class for this new class). Thus, the classes form a tree. Initially there is only one class with index "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Changing the class to its neighbour (child-class or parent-class) in the tree costs "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" coin. You can not change the class back. The cost of changing the class "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to the class "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is equal to the total cost of class changes on the path from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" in the class tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Suppose that at "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" -th level the maximum cost of changing one class to another is "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". For each level output the number of classes such that for each of these classes there exists some other class "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", and the distance from this class to "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is exactly "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains one integer number "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — number of queries ("},{"kind":"math_inline","text":"1 ≤ m ≤ 3·105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain description of queries. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" -th line ("},{"kind":"math_inline","text":"1 ≤ i ≤ m"},{"kind":"text","text":") describes the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" -th level and contains an integer "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" — the index of the parent-class of class with index "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ yi ≤ i"},{"kind":"text","text":"). "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Suppose that at "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" -th level the maximum cost of changing one class to another is "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". For each level output the number of classes such that for each of these classes there exists some other class "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", and the distance from this class to "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is exactly "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1\n1\n2\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2\n2\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1\n1\n2\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2\n2\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"842E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/842/problem/E"}