{"assets":[],"contentKind":"statement","contestId":"555","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Case of Computer Network"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Andrewid the Android is a galaxy-known detective. Now he is preparing a defense against a possible attack by hackers on a major computer network."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this network are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices, some pairs of vertices are connected by "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" undirected channels. It is planned to transfer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" important messages via this network, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of which must be sent from vertex "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" via one or more channels, perhaps through some intermediate vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To protect against attacks a special algorithm was developed. Unfortunately it can be applied only to the network containing directed channels. Therefore, as new channels can't be created, it was decided for each of the existing undirected channels to enable them to transmit data only in one of the two directions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine whether it is possible so to choose the direction for each channel so that each of the "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" messages could be successfully transmitted."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m, q ≤ 2·105"},{"kind":"text","text":") — the number of nodes, channels and important messages."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain two integers each, "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ vi, ui ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi ≠ ui"},{"kind":"text","text":"), that means that between nodes "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" is a channel. Between a pair of nodes can exist more than one channel."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain two integers "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ si, di ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"si ≠ di"},{"kind":"text","text":") — the numbers of the nodes of the source and destination of the corresponding message."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is not guaranteed that in it initially possible to transmit all the messages."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If a solution exists, print on a single line \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes). Otherwise, print \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4 2\n1 2\n1 3\n2 3\n3 4\n1 3\n4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 2\n1 2\n3 2\n1 3\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 2\n1 2\n1 2\n3 2\n1 3\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test you can assign directions, for example, as follows: "},{"kind":"math_inline","text":"1 → 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 → 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3 → 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4 → 3"},{"kind":"text","text":". Then the path for for the first message will be "},{"kind":"math_inline","text":"1 → 3"},{"kind":"text","text":", and for the second one — "},{"kind":"math_inline","text":"4 → 3 → 2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample test you can assign directions, for example, as follows: "},{"kind":"math_inline","text":"1 → 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 → 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 → 3"},{"kind":"text","text":". Then the path for the first message will be "},{"kind":"math_inline","text":"1 → 2 → 3"},{"kind":"text","text":", and for the second one — "},{"kind":"math_inline","text":"2 → 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"555E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/555/problem/E"}