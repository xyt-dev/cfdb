{"assets":["/statement-assets/5c29d8a156bb445bfa7e85fa706e03817c38eabe3fcb53227beafa0dd9364ab3.png","/statement-assets/523b24da653410b34729f48e535174d639263bb0f69891b3cc9ce8fa5245c8c9.png","/statement-assets/199afa6793b70db61281e8faf6d6d4bc87d89060c59f77ab660deade5a5c0a1c.png"],"contentKind":"statement","contestId":"954","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Matrix Walk"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a matrix "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"x × y"},{"kind":"text","text":" filled with integers. For every "},{"attrs":{"alt":"","src":"/statement-assets/5c29d8a156bb445bfa7e85fa706e03817c38eabe3fcb53227beafa0dd9364ab3.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/523b24da653410b34729f48e535174d639263bb0f69891b3cc9ce8fa5245c8c9.png"},"kind":"image"},{"kind":"math_inline","text":"Ai, j = y(i - 1) + j"},{"kind":"text","text":". Obviously, every integer from "},{"kind":"math_inline","text":"[1..xy]"},{"kind":"text","text":" occurs exactly once in this matrix. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have traversed some path in this matrix. Your path can be described as a sequence of visited cells "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" denoting that you started in the cell containing the number "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", then moved to the cell with the number "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", and so on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"From the cell located in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column (we denote this cell as "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":") you can move into one of the following cells:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"(i + 1, j)"},{"kind":"text","text":" — only if "},{"kind":"math_inline","text":"i < x"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"(i, j + 1)"},{"kind":"text","text":" — only if "},{"kind":"math_inline","text":"j < y"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"(i - 1, j)"},{"kind":"text","text":" — only if "},{"kind":"math_inline","text":"i > 1"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"(i, j - 1)"},{"kind":"text","text":" — only if "},{"kind":"math_inline","text":"j > 1"},{"kind":"text","text":"."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Notice that making a move requires you to go to an adjacent cell. It is not allowed to stay in the same cell. You don't know "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" exactly, but you have to find any possible values for these numbers such that you could start in the cell containing the integer "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", then move to the cell containing "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":" (in one step), then move to the cell containing "},{"kind":"math_inline","text":"a3"},{"kind":"text","text":" (also in one step) and so on. Can you choose "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" so that they don't contradict with your sequence of moves?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200000"},{"kind":"text","text":") — the number of cells you visited on your path (if some cell is visited twice, then it's listed twice)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — the integers in the cells on your path."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If all possible values of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"1 ≤ x, y ≤ 109"},{"kind":"text","text":" contradict with the information about your path, print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" in the first line, and in the second line print the values "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" such that your path was possible with such number of lines and columns in the matrix. Remember that they must be positive integers not exceeding "},{"kind":"math_inline","text":"109"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n1 2 3 6 9 8 5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n3 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 2 1 2 5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n4 9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The matrix and the path on it in the first test looks like this:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/199afa6793b70db61281e8faf6d6d4bc87d89060c59f77ab660deade5a5c0a1c.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Also there exist multiple correct answers for both the first and the third examples."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"954C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/954/problem/C"}