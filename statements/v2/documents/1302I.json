{"assets":[],"contentKind":"statement","contestId":"1302","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"I. Deja vu"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is an unusual problem in an unusual contest, here is the announcement: "},{"attrs":{"href":"https://codeforces.com/blog/entry/73543"},"children":[{"kind":"text","text":"http://codeforces.com/blog/entry/73543"}],"kind":"link"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You run a string shop. During a day your customers want to buy strings of certain lengths and sometimes satisfying other properties."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Today your first customer asked you if you have a string of length $$$k$$$. In fact, you have a string of length $$$n$$$ and can cut a string of length $$$k$$$ starting at any position out of it. You wonder how many distinct values this string can equal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please note that in your shop strings are over an alphabet of size $$$2$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$k$$$ ($$$1\\leq k\\leq n\\leq 200\\,000$$$). The second line contains a binary string $$$s$$$ of length $$$n$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line print the number of distinct substrings of length $$$k$$$ of the string $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 2\n01101\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10 3\n1110001011\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The second sample test represents the de Bruijn sequence of order 3."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"I","problemCode":"1302I","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1302/problem/I"}