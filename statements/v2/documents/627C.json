{"assets":[],"contentKind":"statement","contestId":"627","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Package Delivery"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Johnny drives a truck and must deliver a package from his hometown to the district center. His hometown is located at point "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" on a number line, and the district center is located at the point "},{"kind":"math_inline","text":"d"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Johnny's truck has a gas tank that holds exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" liters, and his tank is initially full. As he drives, the truck consumes exactly one liter per unit distance traveled. Moreover, there are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" gas stations located at various points along the way to the district center. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th station is located at the point "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" on the number line and sells an unlimited amount of fuel at a price of "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" dollars per liter. Find the minimum cost Johnny must pay for fuel to successfully complete the delivery."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains three space separated integers "},{"kind":"math_inline","text":"d"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ d ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 200 000"},{"kind":"text","text":") — the total distance to the district center, the volume of the gas tank, and the number of gas stations, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ d - 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ pi ≤ 106"},{"kind":"text","text":") — the position and cost of gas at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th gas station. It is guaranteed that the positions of the gas stations are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum cost to complete the delivery. If there is no way to complete the delivery, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 4 4\n3 5\n5 8\n6 3\n8 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"22\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"16 5 2\n8 2\n5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Johnny's truck holds "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" liters. He can drive "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" units to the first gas station, buy "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" liters of gas there (bringing the tank to "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" liters total), drive "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" more units to the third gas station, buy "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" liters there to fill up his tank, and then drive straight to the district center. His total cost is "},{"kind":"math_inline","text":"2·5 + 4·3 = 22"},{"kind":"text","text":" dollars."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, there is no way for Johnny to make it to the district center, as his tank cannot hold enough gas to take him from the latest gas station to the district center."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"627C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/627/problem/C"}