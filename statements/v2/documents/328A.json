{"assets":[],"contentKind":"statement","contestId":"328","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. IQ Test"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya is preparing for IQ test and he has noticed that there many problems like: "},{"children":[{"kind":"text","text":"you are given a sequence, find the next number."}],"kind":"container"},{"kind":"text","text":" Now Petya can solve only problems with arithmetic or geometric progressions."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Arithmetic progression"}],"kind":"container"},{"kind":"text","text":" is a sequence "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a1 + d"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a1 + 2d"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"a1 + (n - 1)d"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" are any numbers."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Geometric progression"}],"kind":"container"},{"kind":"text","text":" is a sequence "},{"kind":"math_inline","text":"b1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b2 = b1q"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"bn = bn - 1q"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"b1 ≠ 0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"q ≠ 0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"q ≠ 1"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Petya and write a program to determine if the given sequence is arithmetic or geometric. Also it should found the next number. If the sequence is neither arithmetic nor geometric, print 42 (he thinks it is impossible to find better answer). You should also print 42 if the next element of progression is not integer. So answer is always integer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains exactly four integer numbers between 1 and 1000, inclusively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the required number. If the given sequence is arithmetic progression, print the next progression element. Similarly, if the given sequence is geometric progression, print the next progression element."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print 42 if the given sequence is not an arithmetic or geometric progression."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"836 624 412 200\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"childr