{"assets":["/statement-assets/81b6cfc04725aaacb21f20485b7d01bf372669f657e4751603a7290e9738ca1d.png","/statement-assets/5d1a1bcc3c05cb528475db5abf7fd36cfce626627eaabcd3c51cb7d11986a273.png"],"contentKind":"statement","contestId":"1857","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Counting Graphs"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Given a tree consisting of $$$n$$$ vertices. A tree is a connected undirected graph without cycles. Each edge of the tree has its weight, $$$w_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to count the number of different graphs that satisfy all four conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The graph does not have self-loops and multiple edges. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The weights on the edges of the graph are integers and do not exceed $$$S$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The graph has "},{"children":[{"kind":"text","text":"exactly one"}],"kind":"container"},{"attrs":{"href":"http://tiny.cc/30g9vz"},"children":[{"kind":"text","text":"minimum spanning tree"}],"kind":"link"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The minimum spanning tree of the graph is the given tree. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Two graphs are considered different if their sets of edges are different, taking into account the weights of the edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer can be large, output it modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1\\le t\\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$S$$$ ($$$2 \\le n \\le 2 \\cdot 10^5, 1\\le S\\le 10^9$$$) — the number of vertices and the upper bound of the weights."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow $$$n-1$$$ lines describing the tree, the $$$i$$$-th line contains three integers $$$u_i$$$, $$$v_i$$$, and $$$w_i$$$ ($$$1\\le u_i,v_i\\le n, u_i \\ne v_i, 1\\le w_i\\le S$$$) — an edge in the tree with weight $$$w_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ for all tests does not exceed $$$2\\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test, output the number of different graphs that satisfy the conditions, modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n2 5\n1 2 4\n4 5\n1 2 2\n2 3 4\n3 4 3\n5 6\n1 2 3\n1 3 2\n3 4 6\n3 5 1\n10 200\n1 2 3\n2 3 33\n3 4 200\n1 5 132\n5 6 1\n5 7 29\n7 8 187\n7 9 20\n7 10 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n8\n80\n650867886\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, there is only one graph, which is the given tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second samle, the given tree looks like this: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/81b6cfc04725aaacb21f20485b7d01bf372669f657e4751603a7290e9738ca1d.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" All possible graphs for the second sample are shown below, the minimum spanning tree is highlighted in red:"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5d1a1bcc3c05cb528475db5abf7fd36cfce626627eaabcd3c51cb7d11986a273.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1857G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1857/problem/G"}