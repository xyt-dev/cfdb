{"assets":[],"contentKind":"statement","contestId":"706","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Interesting drink"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasiliy likes to rest after a hard work, so you may often meet him in some bar nearby. As all programmers do, he loves the famous drink \""},{"children":[{"kind":"text","text":"Beecola"}],"kind":"container"},{"kind":"text","text":"\", which can be bought in "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different shops in the city. It's known that the price of one bottle in the shop "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" coins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasiliy plans to buy his favorite drink for "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" consecutive days. He knows, that on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day he will be able to spent "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":" coins. Now, for each of the days he want to know in how many different shops he can buy a bottle of \""},{"children":[{"kind":"text","text":"Beecola"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of shops in the city that sell Vasiliy's favourite drink."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ 100 000"},{"kind":"text","text":") — prices of the bottles of the drink in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th shop."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a single integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 100 000"},{"kind":"text","text":") — the number of days Vasiliy plans to buy the drink."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines each containing one integer "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ mi ≤ 109"},{"kind":"text","text":") — the number of coins Vasiliy can spent on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" integers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should be equal to the number of shops where Vasiliy will be able to buy a bottle of the drink on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n3 10 8 6 11\n4\n1\n10\n3\n11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n4\n1\n5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first day, Vasiliy won't be able to buy a drink in any of the shops."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the second day, Vasiliy can buy a drink in the shops "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the third day, Vasiliy can buy a drink only in the shop number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Finally, on the last day Vasiliy can buy a drink in any shop."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"706B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/706/problem/B"}