{"assets":["/statement-assets/39626e575e7b525a8ebcae5ebe7d7a6efbc872332e6d4cf50eabf6b225afcdb9.png","/statement-assets/5902520f2e970cc67b1161d506c4f1fe8ce63fd76c93e6cdbc90d2714cd7f27a.png"],"contentKind":"statement","contestId":"1152","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Neko and Aki's Prank"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Neko is playing with his toys on the backyard of Aki's house. Aki decided to play a prank on him, by secretly putting catnip into Neko's toys. Unfortunately, he went overboard and put an entire bag of catnip into the toys..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It took Neko an entire day to turn back to normal. Neko reported to Aki that he saw a lot of weird things, including a "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Trie"},"children":[{"kind":"text","text":"trie"}],"kind":"link"},{"kind":"text","text":" of all correct bracket sequences of length $$$2n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The definition of correct bracket sequence is as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The empty sequence is a correct bracket sequence, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If $$$s$$$ is a correct bracket sequence, then $$$(\\,s\\,)$$$ is a correct bracket sequence, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If $$$s$$$ and $$$t$$$ are a correct bracket sequence, then $$$st$$$ is also a correct bracket sequence. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, the strings \""},{"children":[{"kind":"text","text":"(())"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"()()"}],"kind":"container"},{"kind":"text","text":"\" form a correct bracket sequence, while \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(("}],"kind":"container"},{"kind":"text","text":"\" not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Aki then came up with an interesting problem: What is the size of the maximum matching (the largest set of edges such that there are no two edges with a common vertex) in this trie? Since the answer can be quite large, print it modulo $$$10^9 + 7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains a single integer $$$n$$$ ($$$1 \\le n \\le 1000$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print exactly one integer — the size of the maximum matching in the trie. Since the answer can be quite large, print it modulo $$$10^9 + 7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The pictures below illustrate tries in the first two examples (for clarity, the round brackets are replaced with angle brackets). The maximum matching is highlighted with blue."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/39626e575e7b525a8ebcae5ebe7d7a6efbc872332e6d4cf50eabf6b225afcdb9.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/5902520f2e970cc67b1161d506c4f1fe8ce63fd76c93e6cdbc90d2714cd7f27a.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1152D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1152/problem/D"}