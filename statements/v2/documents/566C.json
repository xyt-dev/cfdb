{"assets":["/statement-assets/4bc8ef05e24655cbd22cc667e1bc310044c3c5cb52a3f2e9cbab81a98a1920d5.png","/statement-assets/ec149b6aec2b1199c65eb9aacca7cca5279fa1d926cf02029dbdd3e04a1c3598.png","/statement-assets/2ee6ac2147980043a6a2a3c7b34f66a866d0cc9fcf38a1bb3c0f35517d21a5ee.png"],"contentKind":"statement","contestId":"566","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Logistical Questions"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Some country consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities, connected by a railroad network. The transport communication of the country is so advanced that the network consists of a minimum required number of "},{"kind":"math_inline","text":"(n - 1)"},{"kind":"text","text":" bidirectional roads (in the other words, the graph of roads is a tree). The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road that directly connects cities "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", has the length of "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" kilometers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The transport network is served by a state transporting company FRR (Fabulous Rail Roads). In order to simplify the price policy, it offers a single ride fare on the train. In order to follow the route of length "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" kilometers, you need to pay "},{"attrs":{"alt":"","src":"/statement-assets/4bc8ef05e24655cbd22cc667e1bc310044c3c5cb52a3f2e9cbab81a98a1920d5.png"},"kind":"image"},{"kind":"text","text":" burles. Note that it is forbidden to split a long route into short segments and pay them separately (a special railroad police, or RRP, controls that the law doesn't get violated)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A Large Software Company decided to organize a programming tournament. Having conducted several online rounds, the company employees determined a list of finalists and sent it to the logistical department to find a place where to conduct finals. The Large Software Company can easily organize the tournament finals in any of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities of the country, so the the main factor in choosing the city for the last stage of the tournament is the total cost of buying tickets for all the finalists. We know that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th city of the country has "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" cup finalists living there."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the company employees find the city such that the total cost of travel of all the participants to it is minimum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000"},{"kind":"text","text":") — the number of cities in the country."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"w1, w2, ..., wn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ wi ≤ 108"},{"kind":"text","text":") — the number of finalists living in each city of the country."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"(n - 1)"},{"kind":"text","text":" lines contain the descriptions of the railroad, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains three integers, "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ li ≤ 1000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two numbers — an integer "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" that is the number of the optimal city to conduct the competition, and the real number "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", equal to the minimum total cost of transporting all the finalists to the competition. Your answer will be considered correct if two conditions are fulfilled at the same time: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The absolute or relative error of the printed number "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" in comparison with the cost of setting up a final in city "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" doesn't exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Absolute or relative error of the printed number "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" in comparison to the answer of the jury doesn't exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there are multiple answers, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n3 1 2 6 5\n1 2 3\n2 3 1\n4 3 9\n5 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 192.0"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n5 5\n1 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 14.142135623730951000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the sample test an optimal variant of choosing a city to conduct the finals of the competition is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". At such choice the cost of conducting is "},{"attrs":{"alt":"","src":"/statement-assets/ec149b6aec2b1199c65eb9aacca7cca5279fa1d926cf02029dbdd3e04a1c3598.png"},"kind":"image"},{"kind":"text","text":" burles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test, whatever city you would choose, you will need to pay for the transport for five participants, so you will need to pay "},{"attrs":{"alt":"","src":"/statement-assets/2ee6ac2147980043a6a2a3c7b34f66a866d0cc9fcf38a1bb3c0f35517d21a5ee.png"},"kind":"image"},{"kind":"text","text":" burles for each one of them."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"566C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/566/problem/C"}