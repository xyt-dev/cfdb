{"assets":["/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png","/statement-assets/67436067494c1ab71c4a90b601ae9be3ccd49bcc5c4b87ff0972eeff684d87ac.png","/statement-assets/b192405393773cbf34db571d4e557aa9fec10672544cb283ad68872afcfb000d.png","/statement-assets/6a8ffc587d48d16fd5250a47efaede72e0401bfce4ccc1ea949381cbfe109013.png","/statement-assets/a7800e938e952bc1b5e91b2d42a13e6ef77a60f3a96efeaf16c2b01fc24b6584.png","/statement-assets/bf973c1e4f0b39c5b14c1008cb6f800bd55afcedbacb149e1cc5266237a89da8.png","/statement-assets/108da1a9781421d97ff60d34351fe8b9866b316937c26f37050f33936b538e2d.png","/statement-assets/9735c3f74c5d408a18f20862702dadb927f0970a47c03ade4c1c96ba44831eb5.png","/statement-assets/a0f351a7daf520581953e7a19bc1dd650d31e80bbd264a351a03e0655d596313.png"],"contentKind":"statement","contestId":"550","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Brackets in Implications"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Implication is a function of two logical arguments, its value is false if and only if the value of the first argument is true and the value of the second argument is false. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Implication is written by using character '"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":"', and the arguments and the result of the implication are written as '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' ("},{"kind":"math_inline","text":"false"},{"kind":"text","text":") and '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' ("},{"kind":"math_inline","text":"true"},{"kind":"text","text":"). According to the definition of the implication: "}],"kind":"paragraph"},{"children":[{"children":[{"attrs":{"alt":"","src":"/statement-assets/67436067494c1ab71c4a90b601ae9be3ccd49bcc5c4b87ff0972eeff684d87ac.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b192405393773cbf34db571d4e557aa9fec10672544cb283ad68872afcfb000d.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6a8ffc587d48d16fd5250a47efaede72e0401bfce4ccc1ea949381cbfe109013.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a7800e938e952bc1b5e91b2d42a13e6ef77a60f3a96efeaf16c2b01fc24b6584.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"container"},{"children":[{"kind":"text","text":"When a logical expression contains multiple implications, then when there are no brackets, it will be calculated from left to fight. For example,"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/bf973c1e4f0b39c5b14c1008cb6f800bd55afcedbacb149e1cc5266237a89da8.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When there are brackets, we first calculate the expression in brackets. For example,"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/108da1a9781421d97ff60d34351fe8b9866b316937c26f37050f33936b538e2d.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the given logical expression "},{"attrs":{"alt":"","src":"/statement-assets/9735c3f74c5d408a18f20862702dadb927f0970a47c03ade4c1c96ba44831eb5.png"},"kind":"image"},{"kind":"text","text":" determine if it is possible to place there brackets so that the value of a logical expression is false. If it is possible, your task is to find such an arrangement of brackets."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of arguments in a logical expression."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/a0f351a7daf520581953e7a19bc1dd650d31e80bbd264a351a03e0655d596313.png"},"kind":"image"},{"kind":"text","text":"), which means the values of arguments in the expression in the order they occur."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if it is impossible to place brackets in the expression so that its value was equal to 0."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" in the first line and the logical expression with the required arrangement of brackets in the second line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The expression should only contain characters '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"' (character with ASCII code 45), '"},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":"' (character with ASCII code 62), '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"'. Characters '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":"' can occur in an expression only paired like that: (\""},{"children":[{"kind":"text","text":"->"}],"kind":"container"},{"kind":"text","text":"\") and represent implication. The total number of logical arguments (i.e. digits '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"') in the expression must be equal to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The order in which the digits follow in the expression from left to right must coincide with "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The expression should be "},{"children":[{"kind":"text","text":"correct"}],"kind":"container"},{"kind":"text","text":". More formally, a "},{"children":[{"kind":"text","text":"correct"}],"kind":"container"},{"kind":"text","text":" expression is determined as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Expressions \""},{"kind":"math_inline","text":"0"},{"kind":"text","text":"\", \""},{"kind":"math_inline","text":"1"},{"kind":"text","text":"\" (without the quotes) are correct. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"v1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v2"},{"kind":"text","text":" are correct, then "},{"kind":"math_inline","text":"v1"},{"children":[{"kind":"text","text":"->"}],"kind":"container"},{"kind":"math_inline","text":"v2"},{"kind":"text","text":" is a correct expression. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is a correct expression, then "},{"kind":"math_inline","text":"(v)"},{"kind":"text","text":" is a correct expression. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The total number of characters in the resulting expression mustn't exceed "},{"kind":"math_inline","text":"106"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple possible answers, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 1 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n(((0)->1)->(1->0))\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"550E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/550/problem/E"}