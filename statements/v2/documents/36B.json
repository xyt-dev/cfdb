{"assets":["/statement-assets/1960fa423a73acc1b14d67cf389436383204390212775b9920f3a2b0db751380.gif"],"contentKind":"statement","contestId":"36","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Fractal"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"input_channel"},"children":[{"children":[{"kind":"text","text":"input"}],"kind":"container"},{"kind":"text","text":"input.txt"}],"kind":"container"},{"attrs":{"role":"output_channel"},"children":[{"children":[{"kind":"text","text":"output"}],"kind":"container"},{"kind":"text","text":"output.txt"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ever since Kalevitch, a famous Berland abstractionist, heard of fractals, he made them the main topic of his canvases. Every morning the artist takes a piece of graph paper and starts with making a model of his future canvas. He takes a square as big as "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" squares and paints some of them black. Then he takes a clean square piece of paper and paints the fractal using the following algorithm: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Step 1. The paper is divided into "},{"kind":"math_inline","text":"n2"},{"kind":"text","text":" identical squares and some of them are painted black according to the model."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Step 2. Every square that remains white is divided into "},{"kind":"math_inline","text":"n2"},{"kind":"text","text":" smaller squares and some of them are painted black according to the model."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Every following step repeats step 2."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1960fa423a73acc1b14d67cf389436383204390212775b9920f3a2b0db751380.gif"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Unfortunately, this tiresome work demands too much time from the painting genius. Kalevitch has been dreaming of making the process automatic to move to making 3D or even 4D fractals."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 5"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is the amount of steps of the algorithm. Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" symbols that determine the model. Symbol «.» stands for a white square, whereas «*» stands for a black one. It is guaranteed that the model has at least one white square. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a matrix "},{"kind":"math_inline","text":"nk × nk"},{"kind":"text","text":" which is what a picture should look like after "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" steps of the algorithm."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n.*\n..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":".*******\n..******\n.*.*****\n....****\n.***.***\n..**..**\n.*.*.*.*\n........\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n.*.\n***\n.*.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":".*.***.*.\n*********\n.*.***.*.\n*********\n*********\n*********\n.*.***.*.\n*********\n.*.***.*.\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"36B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/36/problem/B"}