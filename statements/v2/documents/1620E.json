{"assets":[],"contentKind":"statement","contestId":"1620","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Replace the Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have an array of integers (initially empty)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to perform $$$q$$$ queries. Each query is of one of two types: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \"$$$1$$$ $$$x$$$\" — add the element $$$x$$$ to the end of the array; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \"$$$2$$$ $$$x$$$ $$$y$$$\" — replace all occurrences of $$$x$$$ in the array with $$$y$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Find the resulting array after performing all the queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$q$$$ ($$$1 \\le q \\le 5 \\cdot 10^5$$$) — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$q$$$ lines contain queries (one per line). Each query is of one of two types: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \"$$$1$$$ $$$x$$$\" ($$$1 \\le x \\le 5 \\cdot 10^5$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \"$$$2$$$ $$$x$$$ $$$y$$$\" ($$$1 \\le x, y \\le 5 \\cdot 10^5$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It's guaranteed that there is at least one query of the first type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line, print $$$k$$$ integers — the resulting array after performing all the queries, where $$$k$$$ is the number of queries of the first type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n1 3\n1 1\n2 1 2\n1 2\n1 1\n1 2\n2 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3 2 2 3 2 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 1\n1 2\n1 1\n2 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 2 1 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n2 1 4\n1 1\n1 4\n1 2\n2 2 4\n2 4 3\n1 2\n2 2 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 3 3 7 "}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the array changes as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$[]$$$ $$$\\rightarrow$$$ $$$[3]$$$ $$$\\rightarrow$$$ $$$[3, 1]$$$ $$$\\rightarrow$$$ $$$[3, 2]$$$ $$$\\rightarrow$$$ $$$[3, 2, 2]$$$ $$$\\rightarrow$$$ $$$[3, 2, 2, 1]$$$ $$$\\rightarrow$$$ $$$[3, 2, 2, 1, 2]$$$ $$$\\rightarrow$$$ $$$[3, 2, 2, 3, 2]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, the array changes as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$[]$$$ $$$\\rightarrow$$$ $$$[1]$$$ $$$\\rightarrow$$$ $$$[1, 2]$$$ $$$\\rightarrow$$$ $$$[1, 2, 1]$$$ $$$\\rightarrow$$$ $$$[1, 2, 1]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, the array changes as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$[]$$$ $$$\\rightarrow$$$ $$$[]$$$ $$$\\rightarrow$$$ $$$[1]$$$ $$$\\rightarrow$$$ $$$[1, 4]$$$ $$$\\rightarrow$$$ $$$[1, 4, 2]$$$ $$$\\rightarrow$$$ $$$[1, 4, 4]$$$ $$$\\rightarrow$$$ $$$[1, 3, 3]$$$ $$$\\rightarrow$$$ $$$[1, 3, 3, 2]$$$ $$$\\rightarrow$$$ $$$[1, 3, 3, 7]$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1620E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1620/problem/E"}