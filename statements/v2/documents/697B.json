{"assets":["/statement-assets/69007a212a9478ebd9083888b87b1395ab40e8d44e32b5b4d7c3e2737e8b8f70.png"],"contentKind":"statement","contestId":"697","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Barnicle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Barney is standing in a bar and starring at a pretty girl. He wants to shoot her with his heart arrow but he needs to know the distance between him and the girl to make his shot accurate."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/69007a212a9478ebd9083888b87b1395ab40e8d44e32b5b4d7c3e2737e8b8f70.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Barney asked the bar tender Carl about this distance value, but Carl was so busy talking to the customers so he wrote the distance value (it's a real number) on a napkin. The problem is that he wrote it in scientific notation. The scientific notation of some real number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is the notation of form "},{"kind":"math_inline","text":"AeB"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is a real number and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" is an integer and "},{"kind":"math_inline","text":"x = A × 10B"},{"kind":"text","text":" is true. In our case "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is between "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" is non-negative."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Barney doesn't know anything about scientific notation (as well as anything scientific at all). So he asked you to tell him the distance value in usual decimal representation with minimal number of digits after the decimal point (and no decimal point if it is an integer). See the output format for better understanding."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and only line of input contains a single string of form "},{"kind":"math_inline","text":"a.deb"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are integers and "},{"kind":"math_inline","text":"e"},{"kind":"text","text":" is usual character 'e' ("},{"kind":"math_inline","text":"0 ≤ a ≤ 9, 0 ≤ d < 10100, 0 ≤ b ≤ 100"},{"kind":"text","text":") — the scientific notation of the desired distance value."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" contain no leading zeros and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" contains no trailing zeros (but may be equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"). Also, "},{"children":[{"kind":"math_inline","text":"b"},{"kind":"text","text":" can not be non-zero if "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is zero."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only real number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" (the desired distance value) in the only line in its decimal notation. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus if "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is an integer, print it's integer value without decimal part and decimal point and without leading zeroes. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" in a form of "},{"kind":"math_inline","text":"p.q"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is an integer that have no leading zeroes (but may be equal to zero), and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" is an integer that have no trailing zeroes (and may not be equal to zero)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8.549e2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"854.9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8.549e3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8549\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0.33e0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.33\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"697B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/697/problem/B"}