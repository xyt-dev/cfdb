{"assets":[],"contentKind":"statement","contestId":"2095","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Would It Be Unrated?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"It's a disaster. During the last April fools round, Codeforces crashed and consequentially, the round was unrated. No one knows what happened to some of the poor authors afterwards. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After careful investigation, the Codeforces team has found out the reason behind this catastrophe. Apparently, authors added too many tests as they forgot the pretests were equal to system tests."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We don't want to repeat this unfortunate incident and cause this round to be unrated as well. That's why we ask you for your help. Could you please help us check how many tests this problem has?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The question — how many tests does the problem have?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single integer. The right one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nHello! Can you please tell me how many tests does this problem have?\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n25"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"I'll forgive you for lying this time, but you better tell me the right answer next time I ask!"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"2095C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2095/problem/C"}