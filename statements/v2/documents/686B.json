{"assets":[],"contentKind":"statement","contestId":"686","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Little Robber Girl's Zoo"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Robber Girl likes to scare animals in her zoo for fun. She decided to arrange the animals in a row in the order of non-decreasing height. However, the animals were so scared that they couldn't stay in the right places."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The robber girl was angry at first, but then she decided to arrange the animals herself. She repeatedly names numbers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"r - l + 1"},{"kind":"text","text":" is even. After that animals that occupy positions between "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" inclusively are rearranged as follows: the animal at position "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" swaps places with the animal at position "},{"kind":"math_inline","text":"l + 1"},{"kind":"text","text":", the animal "},{"kind":"math_inline","text":"l + 2"},{"kind":"text","text":" swaps with the animal "},{"kind":"math_inline","text":"l + 3"},{"kind":"text","text":", ..., finally, the animal at position "},{"kind":"math_inline","text":"r - 1"},{"kind":"text","text":" swaps with the animal "},{"kind":"math_inline","text":"r"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the robber girl to arrange the animals in the order of non-decreasing height. You should name at most "},{"kind":"math_inline","text":"20 000"},{"kind":"text","text":" segments, since otherwise the robber girl will become bored and will start scaring the animals again."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — number of animals in the robber girl's zoo."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the height of the animal occupying the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th place."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the sequence of operations that will rearrange the animals by non-decreasing height."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The output should contain several lines, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the lines should contain two space-separated integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li < ri ≤ n"},{"kind":"text","text":") — descriptions of segments the robber girl should name. The segments should be described in the order the operations are performed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The number of operations should not exceed "},{"kind":"math_inline","text":"20 000"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the animals are arranged correctly from the start, you are allowed to output nothing."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 1 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n36 28 57 39 66 69 68\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 4\n6 7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 5\n3 4\n1 4\n1 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Note that you don't have to minimize the number of operations. Any solution that performs at most "},{"kind":"math_inline","text":"20 000"},{"kind":"text","text":" operations is allowed."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"686B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/686/problem/B"}