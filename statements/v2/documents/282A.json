{"assets":[],"contentKind":"statement","contestId":"282","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Bit++"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The classic programming language of Bitland is Bit++. This language is so peculiar and complicated."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The language is that peculiar as it has exactly one variable, called "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". Also, there are two operations:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Operation "},{"children":[{"kind":"text","text":"++"}],"kind":"container"},{"kind":"text","text":" increases the value of variable "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by 1. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Operation "},{"children":[{"kind":"text","text":"--"}],"kind":"container"},{"kind":"text","text":" decreases the value of variable "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by 1. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A statement in language Bit++ is a sequence, consisting of exactly one operation and one variable "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". The statement is written without spaces, that is, it can only contain characters \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"\". Executing a statement means applying the operation it contains."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A programme in Bit++ is a sequence of statements, each of them needs to be executed. Executing a programme means executing all the statements it contains."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You're given a programme in language Bit++. The initial value of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". Execute the programme and find its final value (the value of the variable when this programme is executed)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 150)"},{"kind":"text","text":" — the number of statements in the programme."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain a statement each. Each statement contains exactly one operation ("},{"children":[{"kind":"text","text":"++"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"--"}],"kind":"container"},{"kind":"text","text":") and exactly one variable "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" (denoted as letter «"},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"»). Thus, there are no empty statements. The operation and the variable can be written in any order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the final value of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n++X\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\nX++\n--X\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"282A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/282/problem/A"}