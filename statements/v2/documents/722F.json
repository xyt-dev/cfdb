{"assets":[],"contentKind":"statement","contestId":"722","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Cyclic Cipher"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sequences. Each sequence consists of positive integers, not exceeding "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". All integers in one sequence are distinct, but the same integer may appear in multiple sequences. The length of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th sequence is "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each second integers in each of the sequences are shifted by one to the left, i.e. integers at positions "},{"kind":"math_inline","text":"i > 1"},{"kind":"text","text":" go to positions "},{"kind":"math_inline","text":"i - 1"},{"kind":"text","text":", while the first integers becomes the last."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each second we take the first integer of each sequence and write it down to a new array. Then, for each value "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" we compute the longest "},{"children":[{"kind":"text","text":"segment"}],"kind":"container"},{"kind":"text","text":" of the array consisting of element "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" only."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The above operation is performed for "},{"kind":"math_inline","text":"10100"},{"kind":"text","text":" seconds. For each integer from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" find out the longest segment found at this time."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100 000"},{"kind":"text","text":") — the number of sequences and the maximum integer that can appear in the sequences. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines providing the sequences. Each of them starts with an integer "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ki ≤ 40"},{"kind":"text","text":") — the number of integers in the sequence, proceeded by "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" positive integers — elements of the sequence. It's guaranteed that all integers in each sequence are pairwise distinct and do not exceed "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"The total length"}],"kind":"container"},{"kind":"text","text":" of all sequences doesn't exceed "},{"kind":"math_inline","text":"200 000"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should be equal to the length of the longest segment of the array with all its values equal to "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" during the first "},{"kind":"math_inline","text":"10100"},{"kind":"text","text":" seconds."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n3 3 4 1\n4 1 3 4 2\n3 3 1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n3\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n2 3 1\n4 5 1 3 2\n4 2 1 3 5\n1 3\n2 5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1\n4\n0\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 6\n3 4 5 3\n2 6 3\n2 3 6\n3 3 6 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n0\n2\n1\n1\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"722F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/722/problem/F"}