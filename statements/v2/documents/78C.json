{"assets":[],"contentKind":"statement","contestId":"78","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Beaver Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Two beavers, Timur and Marsel, play the following game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" logs, each of exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" meters in length. The beavers move in turns. For each move a beaver chooses a log and gnaws it into some number (more than one) of "},{"children":[{"kind":"text","text":"equal"}],"kind":"container"},{"kind":"text","text":" parts, the length of each one is expressed by an integer and is no less than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" meters. Each resulting part is also a log which can be gnawed in future by any beaver. The beaver that can't make a move loses. Thus, the other beaver wins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Timur makes the first move. The players play in the optimal way. Determine the winner."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m, k ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"Timur"}],"kind":"container"},{"kind":"text","text":"\", if Timur wins, or \""},{"children":[{"kind":"text","text":"Marsel"}],"kind":"container"},{"kind":"text","text":"\", if Marsel wins. You should print everything without the quotes. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 15 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Timur"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 9 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Marsel"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the beavers only have one log, of "},{"kind":"math_inline","text":"15"},{"kind":"text","text":" meters in length. Timur moves first. The only move he can do is to split the log into "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" parts each "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" meters in length. Then Marsel moves but he can't split any of the resulting logs, as "},{"kind":"math_inline","text":"k = 4"},{"kind":"text","text":". Thus, the winner is Timur."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the beavers have "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" logs "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" meters in length. Timur can't split any of them, so that the resulting parts possessed the length of not less than "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" meters, that's why he loses instantly."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"78C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/78/problem/C"}