{"assets":[],"contentKind":"statement","contestId":"379","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. New Year Letter"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Many countries have such a New Year or Christmas tradition as writing a letter to Santa including a wish list for presents. Vasya is an ordinary programmer boy. Like all ordinary boys, he is going to write the letter to Santa on the New Year Eve (we Russians actually expect Santa for the New Year, not for Christmas). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya has come up with an algorithm he will follow while writing a letter. First he chooses two strings, "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" anf "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":", consisting of uppercase English letters. Then the boy makes string "},{"kind":"math_inline","text":"sk"},{"kind":"text","text":", using a recurrent equation "},{"kind":"math_inline","text":"sn = sn - 2 + sn - 1"},{"kind":"text","text":", operation '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' means a concatenation (that is, the sequential record) of strings in the given order. Then Vasya writes down string "},{"kind":"math_inline","text":"sk"},{"kind":"text","text":" on a piece of paper, puts it in the envelope and sends in to Santa. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya is absolutely sure that Santa will bring him the best present if the resulting string "},{"kind":"math_inline","text":"sk"},{"kind":"text","text":" has exactly "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" occurrences of substring "},{"children":[{"kind":"text","text":"AC"}],"kind":"container"},{"kind":"text","text":" (the short-cut reminds him оf accepted problems). Besides, Vasya decided that string "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" should have length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", and string "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" should have length "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Vasya hasn't decided anything else."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At the moment Vasya's got urgent New Year business, so he asks you to choose two strings for him, "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" in the required manner. Help Vasya."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four integers "},{"kind":"math_inline","text":"k, x, n, m"},{"kind":"math_inline","text":"(3 ≤ k ≤ 50; 0 ≤ x ≤ 109; 1 ≤ n, m ≤ 100)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print string "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" uppercase English letters. In the second line print string "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" uppercase English letters. If there are multiple valid strings, print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the required pair of strings doesn't exist, print \""},{"children":[{"kind":"text","text":"Happy new year!"}],"kind":"container"},{"kind":"text","text":"\" without the quotes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"AC\nAC\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Happy new year!\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 0 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"AA\nAA\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Happy new year!\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Happy new year!\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"379D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/379/problem/D"}