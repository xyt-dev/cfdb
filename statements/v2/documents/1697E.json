{"assets":[],"contentKind":"statement","contestId":"1697","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Coloring"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given $$$n$$$ points on the plane, the coordinates of the $$$i$$$-th point are $$$(x_i, y_i)$$$. No two points have the same coordinates."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The distance between points $$$i$$$ and $$$j$$$ is defined as $$$d(i,j) = |x_i - x_j| + |y_i - y_j|$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each point, you have to choose a color, represented by an integer from $$$1$$$ to $$$n$$$. For every ordered triple of different points $$$(a,b,c)$$$, the following constraints should be met:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if $$$a$$$, $$$b$$$ and $$$c$$$ have the same color, then $$$d(a,b) = d(a,c) = d(b,c)$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if $$$a$$$ and $$$b$$$ have the same color, and the color of $$$c$$$ is different from the color of $$$a$$$, then $$$d(a,b) \\lt d(a,c)$$$ and $$$d(a,b) \\lt d(b,c)$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Calculate the number of different ways to choose the colors that meet these constraints."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$2 \\le n \\le 100$$$) — the number of points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$n$$$ lines follow. The $$$i$$$-th of them contains two integers $$$x_i$$$ and $$$y_i$$$ ($$$0 \\le x_i, y_i \\le 10^8$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"No two points have the same coordinates (i. e. if $$$i \\ne j$$$, then either $$$x_i \\ne x_j$$$ or $$$y_i \\ne y_j$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the number of ways to choose the colors for the points. Since it can be large, print it modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 0\n3 0\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 2\n2 4\n3 4\n4 4\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n240\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 0\n3 0\n2 1\n2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n24\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test, the following ways to choose the colors are suitable:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[1, 1, 1]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2, 2, 2]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[3, 3, 3]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1, 2, 3]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1, 3, 2]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2, 1, 3]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2, 3, 1]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[3, 1, 2]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[3, 2, 1]$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1697E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1697/problem/E"}