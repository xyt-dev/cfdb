{"assets":["/statement-assets/592e1fad8357bed6baf48466b40bf09978e49d5fd807741e29cd0e15315a2e60.png"],"contentKind":"statement","contestId":"298","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Snow Footprints"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a straight snowy road, divided into "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" blocks. The blocks are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right. If one moves from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th block to the "},{"kind":"math_inline","text":"(i + 1)"},{"kind":"text","text":"-th block, he will leave a right footprint on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th block. Similarly, if one moves from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th block to the "},{"kind":"math_inline","text":"(i - 1)"},{"kind":"text","text":"-th block, he will leave a left footprint on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th block. If there already is a footprint on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th block, the new footprint will cover the old one."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/592e1fad8357bed6baf48466b40bf09978e49d5fd807741e29cd0e15315a2e60.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"At the beginning, there were no footprints. Then polar bear Alice starts from the "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"-th block, makes a sequence of moves and ends in the "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"-th block. It is known that Alice never moves outside of the road. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the description of Alice's footprints. Your task is to find a pair of possible values of "},{"kind":"math_inline","text":"s, t"},{"kind":"text","text":" by looking at the footprints."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(3 ≤ n ≤ 1000)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the description of the road — the string that consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters. Each character will be either \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" (a block without footprint), or \""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\" (a block with a left footprint), \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\" (a block with a right footprint)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the given string contains at least one character not equal to \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\". Also, the first and the last character will always be \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\". It's guaranteed that a solution exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two space-separated integers — the values of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". If there are several possible solutions you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n..RRLL...\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11\n.RRRLLLLL..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test sample is the one in the picture."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"298A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/298/problem/A"}