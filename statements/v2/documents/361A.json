{"assets":[],"contentKind":"statement","contestId":"361","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Levko and Table"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Levko loves tables that consist of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" columns very much. He especially loves beautiful tables. A table is "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" to Levko if the sum of elements in each row and column of the table equals "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, he doesn't know any such table. Your task is to help him to find at least one of them. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 1000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print any beautiful table. Levko doesn't like too big numbers, so all elements of the table mustn't exceed "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":" in their absolute value."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple suitable tables, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n3 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1 0 4\n4 0 2 1\n1 3 3 0\n0 3 2 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the sum in the first row is "},{"kind":"math_inline","text":"1 + 3 = 4"},{"kind":"text","text":", in the second row — "},{"kind":"math_inline","text":"3 + 1 = 4"},{"kind":"text","text":", in the first column — "},{"kind":"math_inline","text":"1 + 3 = 4"},{"kind":"text","text":" and in the second column — "},{"kind":"math_inline","text":"3 + 1 = 4"},{"kind":"text","text":". There are other beautiful tables for this sample."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the sum of elements in each row and each column equals "},{"kind":"math_inline","text":"7"},{"kind":"text","text":". Besides, there are other tables that meet the statement requirements."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"361A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/361/problem/A"}