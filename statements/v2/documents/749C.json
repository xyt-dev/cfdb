{"assets":[],"contentKind":"statement","contestId":"749","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Voting"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" employees in Alternative Cake Manufacturing (ACM). They are now voting on some very important question and the leading world media are trying to predict the outcome of the vote."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the employees belongs to one of two fractions: depublicans or remocrats, and these two fractions have opposite opinions on what should be the outcome of the vote. The voting procedure is rather complicated: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Each of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" employees makes a statement. They make statements one by one starting from employees "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and finishing with employee "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". If at the moment when it's time for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th employee to make a statement he no longer has the right to vote, he just skips his turn (and no longer takes part in this voting). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" When employee makes a statement, he can do nothing or declare that one of the other employees no longer has a right to vote. It's allowed to deny from voting people who already made the statement or people who are only waiting to do so. If someone is denied from voting he no longer participates in the voting till the very end. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" When all employees are done with their statements, the procedure repeats: again, each employees starting from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and finishing with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" who are still eligible to vote make their statements. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The process repeats until there is only one employee eligible to vote remaining and he determines the outcome of the whole voting. Of course, he votes for the decision suitable for his fraction. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You know the order employees are going to vote and that they behave optimal (and they also know the order and who belongs to which fraction). Predict the outcome of the vote."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000"},{"kind":"text","text":") — the number of employees. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character is '"},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"' if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th employee is from depublicans fraction or '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"' if he is from remocrats."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print '"},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"' if the outcome of the vote will be suitable for depublicans and '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"' if remocrats will win."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nDDRRR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"D\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\nDDRRRR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"R\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider one of the voting scenarios for the first sample: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Employee "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" denies employee "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" to vote. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Employee "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" denies employee "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" to vote. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Employee "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" has no right to vote and skips his turn (he was denied by employee "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Employee "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" denies employee "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to vote. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Employee "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" has no right to vote and skips his turn (he was denied by employee "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Employee "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" denies employee "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Only employee "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" now has the right to vote so the voting ends with the victory of depublicans. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"749C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/749/problem/C"}