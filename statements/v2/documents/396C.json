{"assets":[],"contentKind":"statement","contestId":"396","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. On Changing Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a rooted tree consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The root of the tree is a vertex number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially all vertices contain number "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". Then come "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries, each query has one of the two types:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The format of the query: "},{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"v"},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"k"},{"kind":"text","text":". In response to the query, you need to add to the number at vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"; to the numbers at the "},{"children":[{"kind":"text","text":"descendants"}],"kind":"container"},{"kind":"text","text":" of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" at distance "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", add "},{"kind":"math_inline","text":"x - k"},{"kind":"text","text":"; and so on, to the numbers written in the descendants of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" at distance "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", you need to add "},{"kind":"math_inline","text":"x - (i·k)"},{"kind":"text","text":". The distance between two vertices is the number of edges in the shortest path between these vertices. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The format of the query: "},{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"v"},{"kind":"text","text":". In reply to the query you should print the number written in vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Process the queries given in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 3·105"},{"kind":"text","text":") — the number of vertices in the tree. The second line contains "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"p2, p3, ... pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi < i"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" is the number of the vertex that is the parent of vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 3·105"},{"kind":"text","text":") — the number of queries. Next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain the queries, one per line. The first number in the line is "},{"kind":"math_inline","text":"type"},{"kind":"text","text":". It represents the type of the query. If "},{"kind":"math_inline","text":"type = 1"},{"kind":"text","text":", then next follow space-separated integers "},{"kind":"math_inline","text":"v, x, k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v ≤ n"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"0 ≤ x < 109 + 7"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"0 ≤ k < 109 + 7"},{"kind":"text","text":"). If "},{"kind":"math_inline","text":"type = 2"},{"kind":"text","text":", then next follows integer "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v ≤ n"},{"kind":"text","text":") — the vertex where you need to find the value of the number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the second type print on a single line the number written in the vertex from the query. Print the number modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1\n3\n1 1 2 1\n2 1\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"You can read about a rooted tree here: "},{"children":[{"kind":"text","text":"http://en.wikipedia.org/wiki/Tree_(graph_theory)"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"396C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/396/problem/C"}