{"assets":["/statement-assets/57fc980dbd888bb1984c4f4aeefb38f9188b4ec3807713663e05dc19eaa40619.png"],"contentKind":"statement","contestId":"774","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Maximum Number"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Stepan has the newest electronic device with a display. Different digits can be shown on it. Each digit is shown on a seven-section indicator like it is shown on the picture below."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/57fc980dbd888bb1984c4f4aeefb38f9188b4ec3807713663e05dc19eaa40619.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"So, for example, to show the digit "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" on the display, "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" sections must be highlighted; and for the digit "},{"kind":"math_inline","text":"6"},{"kind":"text","text":", "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" sections must be highlighted. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The battery of the newest device allows to highlight at most "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sections on the display. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Stepan wants to know the maximum possible integer number which can be shown on the display of his newest device. Your task is to determine this number. Note that this number must not contain leading zeros. Assume that the size of the display is enough to show any integer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100 000"},{"kind":"text","text":") — the maximum number of sections which can be highlighted on the display."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum integer which can be shown on the display of Stepan's newest device."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"774C","schema":2,"sourceKind":"html","sourceUrl":"