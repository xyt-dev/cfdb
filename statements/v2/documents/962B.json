{"assets":[],"contentKind":"statement","contestId":"962","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Students in Railway Carriage"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are $$$n$$$ consecutive seat places in a railway carriage. Each place is either empty or occupied by a passenger."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The university team for the Olympiad consists of $$$a$$$ student-programmers and $$$b$$$ student-athletes. Determine the largest number of students from all $$$a+b$$$ students, which you can put in the railway carriage so that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" no student-programmer is sitting next to the student-programmer; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" and no student-athlete is sitting next to the student-athlete. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the other words, there should not be two consecutive (adjacent) places where two student-athletes or two student-programmers are sitting."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider that initially occupied seat places are occupied by jury members (who obviously are not students at all)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contain three integers $$$n$$$, $$$a$$$ and $$$b$$$ ($$$1 \\le n \\le 2\\cdot10^{5}$$$, $$$0 \\le a, b \\le 2\\cdot10^{5}$$$, $$$a + b \\gt 0$$$) — total number of seat places in the railway carriage, the number of student-programmers and the number of student-athletes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string with length $$$n$$$, consisting of characters \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\". The dot means that the corresponding place is empty. The asterisk means that the corresponding place is occupied by the jury member."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the largest number of students, which you can put in the railway carriage so that no student-programmer is sitting next to a student-programmer and no student-athlete is sitting next to a student-athlete."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1 1\n*...*\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2 3\n*...*.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11 3 10\n.*....**.*.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 3\n***\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example you can put all student, for example, in the following way: "},{"children":[{"kind":"text","text":"*.AB*"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example you can put four students, for example, in the following way: "},{"children":[{"kind":"text","text":"*BAB*B"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example you can put seven students, for example, in the following way: "},{"children":[{"kind":"text","text":"B*ABAB**A*B"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The letter "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" means a student-programmer, and the letter "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" — student-athlete."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"962B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/962/problem/B"}