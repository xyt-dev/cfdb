{"assets":[],"contentKind":"statement","contestId":"894","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Ralph and Mushrooms"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ralph is going to collect mushrooms in the Mushroom Forest. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" directed paths connecting "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" trees in the Mushroom Forest. On each path grow some mushrooms. When Ralph passes a path, he collects all the mushrooms on the path. The Mushroom Forest has a magical fertile ground where mushrooms grow at a fantastic speed. New mushrooms regrow as soon as Ralph finishes mushroom collection on a path. More specifically, after Ralph passes a path the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th time, there regrow "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" mushrooms less than there was before this pass. That is, if there is initially "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" mushrooms on a path, then Ralph will collect "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" mushrooms for the first time, "},{"kind":"math_inline","text":"x - 1"},{"kind":"text","text":" mushrooms the second time, "},{"kind":"math_inline","text":"x - 1 - 2"},{"kind":"text","text":" mushrooms the third time, and so on. However, the number of mushrooms can never be less than "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, let there be "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" mushrooms on a path initially. The number of mushrooms that can be collected from the path is "},{"kind":"math_inline","text":"9"},{"kind":"text","text":", "},{"kind":"math_inline","text":"8"},{"kind":"text","text":", "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" when Ralph passes by from first to fourth time. From the fifth time and later Ralph can't collect any mushrooms from the path (but still can pass it)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ralph decided to start from the tree "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". How many mushrooms can he collect using only described paths?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ m ≤ 106"},{"kind":"text","text":"), representing the number of trees and the number of directed paths in the Mushroom Forest, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains three integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x, y ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ w ≤ 108"},{"kind":"text","text":"), denoting a path that leads from tree "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to tree "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" mushrooms initially. There can be paths that lead from a tree to itself, and multiple paths between the same pair of trees."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line contains a single integer "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ s ≤ n"},{"kind":"text","text":") — the starting position of Ralph. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print an integer denoting the maximum number of the mushrooms Ralph can collect during his route. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n1 2 4\n2 1 4\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"16"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2 4\n2 3 3\n1 3 8\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Ralph can pass three times on the circle and collect "},{"kind":"math_inline","text":"4 + 4 + 3 + 3 + 1 + 1 = 16"},{"kind":"text","text":" mushrooms. After that there will be no mushrooms for Ralph to collect."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, Ralph can go to tree "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and collect "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" mushrooms on the path from tree "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to tree "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"894E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/894/problem/E"}