{"assets":["/statement-assets/eb54d918d8c1e06053fb921c5775a52c2f6e24229c1d65afc4d66b3ec10dc13b.png"],"contentKind":"statement","contestId":"659","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Fence Divercity"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Long ago, Vasily built a good fence at his country house. Vasily calls a fence "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":", if it is a series of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" consecutively fastened vertical boards of centimeter width, the height of each in centimeters is "},{"children":[{"kind":"text","text":"a positive integer"}],"kind":"container"},{"kind":"text","text":". The house owner remembers that the height of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th board to the left is "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Today Vasily decided to change the design of the fence he had built, by cutting his top connected part so that the fence remained good. The cut part should consist of only the upper parts of the boards, while the adjacent parts must be interconnected (share a non-zero length before cutting out of the fence)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You, as Vasily's curious neighbor, will count the number of possible ways to cut exactly one part as is described above. Two ways to cut a part are called distinct, if for the remaining fences there is such "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", that the height of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th boards vary."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As Vasily's fence can be very high and long, get the remainder after dividing the required number of ways by "},{"kind":"math_inline","text":"1 000 000 007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1 000 000"},{"kind":"text","text":") — the number of boards in Vasily's fence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated numbers "},{"kind":"math_inline","text":"h1, h2, ..., hn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ hi ≤ 109"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" equals the height of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th board to the left."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the remainder after dividing "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"1 000 000 007"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" is the number of ways to cut exactly one connected part so that the part consisted of the upper parts of the boards and the remaining fence was "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"From the fence from the first example it is impossible to cut exactly one piece so as the remaining fence was "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the possible variants of the resulting fence from the second sample look as follows (the grey shows the cut out part): "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/eb54d918d8c1e06053fb921c5775a52c2f6e24229c1d65afc4d66b3ec10dc13b.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"659G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/659/problem/G"}