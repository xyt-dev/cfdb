{"assets":["/statement-assets/aaf245aa69ccd77372a789b55028ecf507cad1630d096e3daaf47477a731eb08.png","/statement-assets/65721f3656ad3705048058c03f689d12a32dd41bb1418d5c2c5c20a5102d4377.png","/statement-assets/0b3318bb3227d125a3f0a4f72fe3a88c81606398797d29cec8211a0fe69c1fdd.png"],"contentKind":"statement","contestId":"388","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Fox and Box Accumulation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Fox Ciel has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" boxes in her room. They have the same size and weight, but they might have different strength. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th box can hold at most "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" boxes on its top (we'll call "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" the strength of the box). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since all the boxes have the same size, Ciel cannot put more than one box directly on the top of some box. For example, imagine Ciel has three boxes: the first has strength 2, the second has strength 1 and the third has strength 1. She cannot put the second and the third box simultaneously directly on the top of the first one. But she can put the second box directly on the top of the first one, and then the third box directly on the top of the second one. We will call such a construction of boxes a "},{"children":[{"kind":"text","text":"pile"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/aaf245aa69ccd77372a789b55028ecf507cad1630d096e3daaf47477a731eb08.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Fox Ciel wants to construct piles from all the boxes. Each pile will contain some boxes from top to bottom, and there cannot be more than "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" boxes on the top of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th box. What is the minimal number of piles she needs to construct?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":"). The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ xi ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the minimal possible number of piles."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n0 0 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 1 2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 0 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n0 1 0 2 0 1 1 2 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In example 1, one optimal way is to build 2 piles: the first pile contains boxes 1 and 3 (from top to bottom), the second pile contains only box 2."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/65721f3656ad3705048058c03f689d12a32dd41bb1418d5c2c5c20a5102d4377.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In example 2, we can build only 1 pile that contains boxes 1, 2, 3, 4, 5 (from top to bottom)."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0b3318bb3227d125a3f0a4f72fe3a88c81606398797d29cec8211a0fe69c1fdd.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"388A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/388/problem/A"}