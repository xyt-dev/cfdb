{"assets":[],"contentKind":"statement","contestId":"1450","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Avoid Trygub"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A string $$$b$$$ is a subsequence of a string $$$a$$$ if $$$b$$$ can be obtained from $$$a$$$ by deletion of several (possibly, zero or all) characters. For example, \""},{"children":[{"kind":"text","text":"xy"}],"kind":"container"},{"kind":"text","text":"\" is a subsequence of \""},{"children":[{"kind":"text","text":"xzyw"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"xy"}],"kind":"container"},{"kind":"text","text":"\", but not \""},{"children":[{"kind":"text","text":"yx"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string $$$a$$$. Your task is to reorder the characters of $$$a$$$ so that \""},{"children":[{"kind":"text","text":"trygub"}],"kind":"container"},{"kind":"text","text":"\" is not a subsequence of the resulting string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In other words, you should find a string $$$b$$$ which is a permutation of symbols of the string $$$a$$$ and \""},{"children":[{"kind":"text","text":"trygub"}],"kind":"container"},{"kind":"text","text":"\" is not a subsequence of $$$b$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We have a truly marvelous proof that any string can be arranged not to contain \""},{"children":[{"kind":"text","text":"trygub"}],"kind":"container"},{"kind":"text","text":"\" as a subsequence, but this problem statement is too short to contain it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1\\le t\\le 100$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1\\le n\\le 200$$$) — the length of $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains the string $$$a$$$ of length $$$n$$$, consisting of lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a string $$$b$$$ of length $$$n$$$ which is a permutation of characters of the string $$$a$$$, and such that \""},{"children":[{"kind":"text","text":"trygub"}],"kind":"container"},{"kind":"text","text":"\" is not a subsequence of it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there exist multiple possible strings $$$b$$$, you can print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n11\nantontrygub\n15\nbestcoordinator\n19\ntrywatchinggurabruh\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nbugyrtnotna\nbestcoordinator\nbruhtrywatchinggura\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, \""},{"children":[{"kind":"text","text":"bugyrtnotna"}],"kind":"container"},{"kind":"text","text":"\" does not contain \""},{"children":[{"kind":"text","text":"trygub"}],"kind":"container"},{"kind":"text","text":"\" as a subsequence. It does contain the letters of \""},{"children":[{"kind":"text","text":"trygub"}],"kind":"container"},{"kind":"text","text":"\", but not in the correct order, so it is not a subsequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, we did not change the order of characters because it is not needed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, \""},{"children":[{"kind":"text","text":"bruhtrywatchinggura"}],"kind":"container"},{"kind":"text","text":"\" does contain \""},{"children":[{"kind":"text","text":"trygu"}],"kind":"container"},{"kind":"text","text":"\" as a subsequence, but not \""},{"children":[{"kind":"text","text":"trygub"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1450A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1450/problem/A"}