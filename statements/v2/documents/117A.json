{"assets":[],"contentKind":"statement","contestId":"117","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Elevator"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"And now the numerous qualifying tournaments for one of the most prestigious Russian contests "},{"children":[{"kind":"text","text":"Russian Codec Cup"}],"kind":"container"},{"kind":"text","text":" are over. All "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" participants who have made it to the finals found themselves in a huge "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-floored "},{"kind":"math_inline","text":"108"},{"kind":"text","text":"-star hotel. Of course the first thought to come in a place like this is \"How about checking out the elevator?\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The hotel's elevator moves between floors according to one never changing scheme. Initially (at the moment of time "},{"kind":"math_inline","text":"0"},{"kind":"text","text":") the elevator is located on the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st floor, then it moves to the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd floor, then — to the "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-rd floor and so on until it reaches the "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-th floor. After that the elevator moves to floor "},{"kind":"math_inline","text":"m - 1"},{"kind":"text","text":", then to floor "},{"kind":"math_inline","text":"m - 2"},{"kind":"text","text":", and so on until it reaches the first floor. This process is repeated infinitely. We know that the elevator has infinite capacity; we also know that on every floor people get on the elevator immediately. Moving between the floors takes a unit of time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" participant you are given "},{"kind":"math_inline","text":"si"},{"kind":"text","text":", which represents the floor where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th participant starts, "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":", which represents the floor the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th participant wants to reach, and "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", which represents the time when the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th participant starts on the floor "},{"kind":"math_inline","text":"si"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each participant print the minimum time of his/her arrival to the floor "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the elevator stops on the floor "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" at the time "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th participant can enter the elevator immediately. If the participant starts on the floor "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" and that's the floor he wanted to reach initially ("},{"kind":"math_inline","text":"si = fi"},{"kind":"text","text":"), then the time of arrival to the floor "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":" for this participant is considered equal to "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105, 2 ≤ m ≤ 108"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain information about the participants in the form of three space-separated integers "},{"kind":"math_inline","text":"si"},{"kind":"math_inline","text":"fi"},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ si, fi ≤ m, 0 ≤ ti ≤ 108"},{"kind":"text","text":"), described in the problem statement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each containing one integer — the time of the arrival for each participant to the required floor."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 4\n2 4 3\n1 2 0\n2 2 0\n1 2 1\n4 3 5\n1 2 2\n4 2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n1\n0\n7\n10\n7\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n1 5 4\n1 3 1\n1 3 4\n3 1 5\n4 2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n10\n10\n8\n7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's consider the first sample. The first participant starts at floor "},{"kind":"math_inline","text":"s = 2"},{"kind":"text","text":" by the time equal to "},{"kind":"math_inline","text":"t = 3"},{"kind":"text","text":". To get to the floor "},{"kind":"math_inline","text":"f = 4"},{"kind":"text","text":", he has to wait until the time equals "},{"kind":"math_inline","text":"7"},{"kind":"text","text":", that's the time when the elevator will go upwards for the second time. Then the first participant should get on the elevator and go two floors up. In this case the first participant gets to the floor "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" at time equal to "},{"kind":"math_inline","text":"9"},{"kind":"text","text":". The second participant starts at the time "},{"kind":"math_inline","text":"t = 0"},{"kind":"text","text":" on the floor "},{"kind":"math_inline","text":"s = 1"},{"kind":"text","text":", enters the elevator immediately, and arrives to the floor "},{"kind":"math_inline","text":"f = 2"},{"kind":"text","text":". The third participant doesn't wait for the elevator, because he needs to arrive to the same floor where he starts."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"117A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/117/problem/A"}