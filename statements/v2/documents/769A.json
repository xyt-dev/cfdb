{"assets":[],"contentKind":"statement","contestId":"769","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Year of University Entrance"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is the faculty of Computer Science in Berland. In the social net \"TheContact!\" for each course of this faculty there is the special group whose name equals the year of university entrance of corresponding course of students at the university. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of students joins the group of his course and joins all groups for which the year of student's university entrance differs by no more than "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" from the year of university entrance of this student, where "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" — some non-negative integer. A value "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is not given, but it can be uniquely determined from the available data. Note that students don't join other groups. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the list of groups which the student Igor joined. According to this information you need to determine the year of Igor's university entrance."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the positive odd integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5"},{"kind":"text","text":") — the number of groups which Igor joined. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2010 ≤ ai ≤ 2100"},{"kind":"text","text":") — years of student's university entrance for each group in which Igor is the member."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the input data is correct and the answer always exists. Groups are given randomly."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the year of Igor's university entrance. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2014 2016 2015\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2015\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n2050\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2050\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test the value "},{"kind":"math_inline","text":"x = 1"},{"kind":"text","text":". Igor entered the university in 2015. So he joined groups members of which are students who entered the university in 2014, 2015 and 2016."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test the value "},{"kind":"math_inline","text":"x = 0"},{"kind":"text","text":". Igor entered only the group which corresponds to the year of his university entrance. "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"769A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/769/problem/A"}