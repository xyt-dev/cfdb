{"assets":[],"contentKind":"statement","contestId":"113","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Double Happiness"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"128 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"On the math lesson a teacher asked each pupil to come up with his own lucky numbers. As a fan of number theory Peter chose prime numbers. Bob was more original. He said that number "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is his lucky number, if it can be represented as: "}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"t = a2 + b2, "}],"kind":"container"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"a, b"},{"kind":"text","text":" are arbitrary positive integers."},{"children":[{"kind":"text","text":"Now, the boys decided to find out how many days of the interval "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"l ≤ r"},{"kind":"text","text":") are suitable for pair programming. They decided that the day "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"l ≤ i ≤ r"},{"kind":"text","text":") is suitable for pair programming if and only if the number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is lucky for Peter and lucky for Bob at the same time. Help the boys to find the number of such days."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer numbers "},{"kind":"math_inline","text":"l, r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l, r ≤ 3·108"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line print the number of days on the segment "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":", which are lucky for Peter and Bob at the same time."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 66\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"113C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/113/problem/C"}