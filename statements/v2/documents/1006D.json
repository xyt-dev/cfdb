d":"text","text":" to make $$$a$$$ and $$$b$$$ equal: $$$swap(b_1, b_5)$$$, $$$swap(a_2, a_4)$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1006D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1006/problem/D"}