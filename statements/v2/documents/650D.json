{"assets":[],"contentKind":"statement","contestId":"650","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Zip-line"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya has decided to build a zip-line on trees of a nearby forest. He wants the line to be as long as possible but he doesn't remember exactly the heights of all trees in the forest. He is sure that he remembers correct heights of all trees except, possibly, one of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is known that the forest consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" trees staying in a row numbered from left to right with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". According to Vasya, the height of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th tree is equal to "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":". The zip-line of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" should hang over "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":") trees "},{"kind":"math_inline","text":"i1, i2, ..., ik"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"i1 < i2 < ... < ik"},{"kind":"text","text":") such that their heights form an increasing sequence, that is "},{"kind":"math_inline","text":"hi1 < hi2 < ... < hik"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya had been in this forest together with Vasya, and he now has "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" assumptions about the mistake in Vasya's sequence "},{"kind":"math_inline","text":"h"},{"kind":"text","text":". His "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th assumption consists of two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" indicating that, according to Petya, the height of the tree numbered "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is actually equal to "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". Note that Petya's assumptions are "},{"children":[{"kind":"text","text":"independent"}],"kind":"container"},{"kind":"text","text":" from each other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the maximum length of a zip-line that can be built over the trees under each of the "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" assumptions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem the length of a zip line is considered equal to the number of trees that form this zip-line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 400 000"},{"kind":"text","text":") — the number of the trees in the forest and the number of Petya's assumptions, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ hi ≤ 109"},{"kind":"text","text":") — the heights of trees according to Vasya."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ bi ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each of the Petya's assumptions output one integer, indicating the maximum length of a zip-line that can be built under this assumption."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n1 2 3 4\n1 1\n1 4\n4 3\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n3\n3\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n1 3 2 6\n3 5\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first sample. The first assumption actually coincides with the height remembered by Vasya. In the second assumption the heights of the trees are "},{"kind":"math_inline","text":"(4, 2, 3, 4)"},{"kind":"text","text":", in the third one they are "},{"kind":"math_inline","text":"(1, 2, 3, 3)"},{"kind":"text","text":" and in the fourth one they are "},{"kind":"math_inline","text":"(1, 2, 3, 5)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"650D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/650/problem/D"}