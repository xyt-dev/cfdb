{"assets":[],"contentKind":"statement","contestId":"1264","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D1. Beautiful Bracket Sequence (easy version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is the easy version of this problem. The only difference is the limit of $$$n$$$ - the length of the input string. In this version, $$$1 \\leq n \\leq 2000$$$. The hard version of this challenge is not offered in the round for the second division. "}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define a correct bracket sequence and its depth as follow:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" An empty string is a correct bracket sequence with depth $$$0$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If \""},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":"\" is a correct bracket sequence with depth $$$d$$$ then \""},{"children":[{"kind":"text","text":"(s)"}],"kind":"container"},{"kind":"text","text":"\" is a correct bracket sequence with depth $$$d + 1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If \""},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"t"}],"kind":"container"},{"kind":"text","text":"\" are both correct bracket sequences then their concatenation \""},{"children":[{"kind"