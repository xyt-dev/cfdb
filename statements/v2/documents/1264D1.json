_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"()()))"}],"kind":"container"},{"kind":"text","text":"\". Its depth is $$$2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"((()))"}],"kind":"container"},{"kind":"text","text":"\". Its depth is $$$3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"()(())"}],"kind":"container"},{"kind":"text","text":"\". Its depth is $$$2$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So, the answer is $$$9 = 2 + 2 + 3 + 2$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D1","problemCode":"1264D1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1264/problem/D1"}