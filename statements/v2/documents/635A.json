{"assets":[],"contentKind":"statement","contestId":"635","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Orchestra"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Paul is at the orchestra. The string section is arranged in an "},{"kind":"math_inline","text":"r × c"},{"kind":"text","text":" rectangular grid and is filled with violinists with the exception of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" violists. Paul really likes violas, so he would like to take a picture including at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" of them. Paul can take a picture of any axis-parallel rectangle in the orchestra. Count the number of possible pictures that Paul can take."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two pictures are considered to be different if the coordinates of corresponding rectangles are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains four space-separated integers "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ r, c, n ≤ 10"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":") — the number of rows and columns of the string section, the total number of violas, and the minimum number of violas Paul would like in his photograph, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each contain two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ r"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ yi ≤ c"},{"kind":"text","text":"): the position of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th viola. It is guaranteed that no location appears more than once in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of photographs Paul can take which include at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" violas. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 1 1\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 3 3\n1 1\n3 1\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 3 2\n1 1\n3 1\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"We will use '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"' to denote violinists and '"},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"' to denote violists."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample, the orchestra looks as follows "}],"kind":"paragraph"},{"kind":"code_block","text":"\n*#\n**\n"},{"kind":"text","text":" Paul can take a photograph of just the viola, the "},{"kind":"math_inline","text":"1 × 2"},{"kind":"text","text":" column containing the viola, the "},{"kind":"math_inline","text":"2 × 1"},{"kind":"text","text":" row containing the viola, or the entire string section, for "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" pictures total."},{"children":[{"kind":"text","text":"In the second sample, the orchestra looks as follows "}],"kind":"paragraph"},{"kind":"code_block","text":"\n#*\n*#\n#*\n"},{"kind":"text","text":" Paul must take a photograph of the entire section."},{"children":[{"kind":"text","text":"In the third sample, the orchestra looks the same as in the second sample."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"635A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/635/problem/A"}