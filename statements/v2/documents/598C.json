{"assets":[],"contentKind":"statement","contestId":"598","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Nearest vectors"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given the set of vectors on the plane, each of them starting at the origin. Your task is to find a pair of vectors with the minimal non-oriented angle between them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Non-oriented angle is non-negative value, minimal between clockwise and counterclockwise direction angles. Non-oriented angle is always between "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"π"},{"kind":"text","text":". For example, opposite directions vectors have angle equals to "},{"kind":"math_inline","text":"π"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of vectors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|x|, |y| ≤ 10 000, x2 + y2 > 0"},{"kind":"text","text":") — the coordinates of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vector. Vectors are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in order of appearing in the input. It is guaranteed that no two vectors in the input share the same direction (but they still can have opposite directions)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two integer numbers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"a ≠ b"},{"kind":"text","text":") — a pair of indices of vectors with the minimal non-oriented angle. You can print the numbers in any order. If there are many possible answers, print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n-1 0\n0 -1\n1 0\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n-1 0\n0 -1\n1 0\n1 1\n-4 -5\n-4 -6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6 5"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"598C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/598/problem/C"}