{"assets":["/statement-assets/c59c3ed6c740f50d09745fc1ed4922e9f968b7522d658ce6d59631870b0c3449.png"],"contentKind":"statement","contestId":"697","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Pineapple Incident"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ted has a pineapple. This pineapple is able to bark like a bulldog! At time "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" (in seconds) it barks for the first time. Then every "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" seconds after it, it barks twice with "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" second interval. Thus it barks at times "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t + s"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t + s + 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t + 2s"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t + 2s + 1"},{"kind":"text","text":", etc."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c59c3ed6c740f50d09745fc1ed4922e9f968b7522d658ce6d59631870b0c3449.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Barney woke up in the morning and wants to eat the pineapple, but he can't eat it when it's barking. Barney plans to eat it at time "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" (in seconds), so he asked you to tell him if it's gonna bark at that time."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and only line of input contains three integers "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ t, x ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ s ≤ 109"},{"kind":"text","text":") — the time the pineapple barks for the first time, the pineapple barking interval, and the time Barney wants to eat the pineapple respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single \"YES\" (without quotes) if the pineapple will bark at time "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" or a single \"NO\" (without quotes) otherwise in the only line of output."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 10 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 10 3\n"}],"kind"