{"assets":["/statement-assets/eea6e5d40ebe920453c49af7cea66013600371b589e724ac8dc7908f1c3dfbc1.png"],"contentKind":"statement","contestId":"272","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Dima and Staircase"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dima's got a staircase that consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" stairs. The first stair is at height "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", the second one is at "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", the last one is at "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a1 ≤ a2 ≤ ... ≤ an"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Dima decided to play with the staircase, so he is throwing rectangular boxes at the staircase from above. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th box has width "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" and height "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":". Dima throws each box vertically down on the first "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" stairs of the staircase, that is, the box covers stairs with numbers "},{"kind":"math_inline","text":"1, 2, ..., wi"},{"kind":"text","text":". Each thrown box flies vertically down until at least one of the two following events happen:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the bottom of the box touches the top of a stair; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the bottom of the box touches the top of a box, thrown earlier. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"We only consider touching of the horizontal sides of stairs and boxes, at that touching with the corners isn't taken into consideration. Specifically, that implies that a box with width "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" cannot touch the stair number "},{"kind":"math_inline","text":"wi + 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the description of the staircase and the sequence in which Dima threw the boxes at it. For each box, determine how high the bottom of the box after landing will be. Consider a box to fall after the previous one lands."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":" — the number of stairs in the staircase. The second line contains a non-decreasing sequence, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 109; ai ≤ ai + 1)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains integer "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ m ≤ 105)"},{"kind":"text","text":" — the number of boxes. Each of the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains a pair of integers "},{"kind":"math_inline","text":"wi, hi"},{"kind":"math_inline","text":"(1 ≤ wi ≤ n; 1 ≤ hi ≤ 109)"},{"kind":"text","text":" — the size of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th thrown box."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The numbers in the lines are separated by spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers — for each box the height, where the bottom of the box will be after landing. Print the answers for the boxes in the order, in which the boxes are given in the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in "},{"children":[{"kind":"text","text":"C++"}],"kind":"container"},{"kind":"text","text":". It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 6 6\n4\n1 1\n3 1\n1 1\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n3\n4\n6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n2\n1 1\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n5\n1 2\n1 10\n1 10\n1 10\n1 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n3\n13\n23\n33\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first sample are shown on the picture."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/eea6e5d40ebe920453c49af7cea66013600371b589e724ac8dc7908f1c3dfbc1.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"272C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/272/problem/C"}