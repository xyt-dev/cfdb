{"assets":[],"contentKind":"statement","contestId":"1619","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Square String?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A string is called "},{"children":[{"kind":"text","text":"square"}],"kind":"container"},{"kind":"text","text":" if it is some string written twice in a row. For example, the strings \""},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abcabc"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abab"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"baabaa"}],"kind":"container"},{"kind":"text","text":"\" are square. But the strings \""},{"children":[{"kind":"text","text":"aaa"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abaaab"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"abcdabc"}],"kind":"container"},{"kind":"text","text":"\" are not square."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a given string $$$s$$$ determine if it is square."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input data contains an integer $$$t$$$ ($$$1 \\le t \\le 100$$$) —the number of test cases."}],"kind":"