{"assets":[],"contentKind":"statement","contestId":"2209","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Ghostfires"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"OtterZ decided to make a weapon using ghostfires. He collected several ghostfires in colors red, green, and blue. He will put some of the ghostfires in a row to build the weapon. To make the weapon more powerful, OtterZ will use as many ghostfires as possible, but the weapon will be out of control if there are two ghostfires of the same color adjacent or separated by exactly two ghostfires in the row."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, OtterZ collected $$$r$$$ red ghostfires, $$$g$$$ green ghostfires, and $$$b$$$ blue ghostfires. He wants to construct a string $$$s$$$ consisting of the characters '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"', and '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' that satisfies the following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The number of occurrences of '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"', and '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' in $$$s$$$ does not exceed $$$r$$$, $$$g$$$, and $$$b$$$, respectively."}],"kind":"list_item"},{"children":[{"kind":"text","text":" For all $$$1 \\le i \\le |s|-1$$$, $$$s_i \\ne s_{i+1}$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" For all $$$1 \\le i \\le |s|-3$$$, $$$s_i \\ne s_{i+3}$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" The length of $$$s$$$ is the maximum possible. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help OtterZ to construct the row. Although there may be several possible rows, OtterZ just requires one of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains three integers $$$r$$$, $$$g$$$, and $$$b$$$ ($$$0\\le r,g,b \\le 10 ^ 6$$$, $$$r+g+b \\gt 0$$$), representing the number of red, green, and blue ghostfires, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$r + g + b$$$ over all test cases does not exceed $$$10 ^ 6$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query, output a string $$$s$$$ consisting of the characters '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"', and '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"', where $$$s_i$$$ equals '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' indicates that the $$$i$$$-th ghostfire is colored red, green, or blue, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, output any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n0 0 1\n1 1 1\n0 3 0\n2 2 2\n2 7 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nB\nRGB\nG\nGBRBRG\nGRGRGBGBGBG\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first test case, \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\" is the only valid construction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second test case, \""},{"children":[{"kind":"text","text":"RGB"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"RBG"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"GRB"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"GRB"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"BRG"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"BGR"}],"kind":"container"},{"kind":"text","text":"\" are all correct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the third test case, \""},{"children":[{"kind":"text","text":"GG"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"GGG"}],"kind":"container"},{"kind":"text","text":"\" are invalid because $$$s_1=s_2$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"2209D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2209/problem/D"}