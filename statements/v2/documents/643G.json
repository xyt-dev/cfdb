{"assets":["/statement-assets/f1937a4ab103149fd16d11a4f3092bf5ee01433f5afd2801c1f876c92549f9fc.png","/statement-assets/b4a885689ca620581fcbdf4628ba95bc270bcb15e4ea1cf812ba758e634e0a9b.png","/statement-assets/7c11dcf8794a46a9f25d8a17cc6e2f04d4c098aa7e2225998cd181d11e2bdc2a.png"],"contentKind":"statement","contestId":"643","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Choosing Ads"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One social network developer recently suggested a new algorithm of choosing ads for users."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" slots which advertisers can buy. It is possible to buy a segment of consecutive slots at once. The more slots you own, the bigger are the chances your ad will be shown to users."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Every time it is needed to choose ads to show, some segment of slots is picked by a secret algorithm. Then some advertisers are chosen. The only restriction is that it should be guaranteed for advertisers which own at least "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"% of slots composing this segment that their ad will be shown."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"From the other side, users don't like ads. So it was decided to show no more than "},{"attrs":{"alt":"","src":"/statement-assets/f1937a4ab103149fd16d11a4f3092bf5ee01433f5afd2801c1f876c92549f9fc.png"},"kind":"image"},{"kind":"text","text":" ads at once. You are asked to develop a system to sell segments of slots and choose ads in accordance with the rules described above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 150 000, 20 ≤ p ≤ 100"},{"kind":"text","text":") — the number of slots, the number of queries to your system and threshold for which display of the ad is guaranteed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 150 000)"},{"kind":"text","text":", where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number means id of advertiser who currently owns the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th slot."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain queries descriptions. Each description is of one of the following forms: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"1 l r id"}],"kind":"container"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n, 1 ≤ id ≤ 150 000"},{"kind":"text","text":") — advertiser "},{"kind":"math_inline","text":"id"},{"kind":"text","text":" bought all slots in a range from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" inclusive; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"2 l r"}],"kind":"container"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r"},{"kind":"text","text":") — you need to choose advertisers for segment "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the second type answer should be printed in a separate line. First integer of the answer should be the number of advertisements that will be shown "},{"attrs":{"alt":"","src":"/statement-assets/b4a885689ca620581fcbdf4628ba95bc270bcb15e4ea1cf812ba758e634e0a9b.png"},"kind":"image"},{"kind":"text","text":". Next "},{"kind":"math_inline","text":"cnt"},{"kind":"text","text":" integers should be advertisers' ids. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is allowed to print one advertiser more than once, but each advertiser that owns at least "},{"attrs":{"alt":"","src":"/statement-assets/7c11dcf8794a46a9f25d8a17cc6e2f04d4c098aa7e2225998cd181d11e2bdc2a.png"},"kind":"image"},{"kind":"text","text":" slots of the segment from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" should be in your answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 9 33\n1 2 1 3 3\n2 1 5\n2 1 5\n2 1 3\n2 3 3\n1 2 4 5\n2 1 5\n2 3 5\n1 4 5 1\n2 1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 1 2 3\n2 1 3\n2 2 1\n3 1 1000 1000\n1 5\n2 5 3\n2 1 5"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Samples demonstrate that you actually have quite a lot of freedom in choosing advertisers."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"643G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/643/problem/G"}