{"assets":[],"contentKind":"statement","contestId":"2089","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Conditional Operators"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In C++, the conditional operator "},{"children":[{"kind":"text","text":"?:"}],"kind":"container"},{"kind":"text","text":" is used as the value of "},{"children":[{"kind":"text","text":"x?y:z"}],"kind":"container"},{"kind":"text","text":" is $$$y$$$ if $$$x$$$ is true; otherwise, the value is $$$z$$$. $$$x$$$, $$$y$$$, and $$$z$$$ may also be expressions. It is right-associated; that is, "},{"children":[{"kind":"text","text":"a?b:c?d:e"}],"kind":"container"},{"kind":"text","text":" is equivalent to "},{"children":[{"kind":"text","text":"a?b:(c?d:e)"}],"kind":"container"},{"kind":"text","text":". $$$0$$$ means false and $$$1$$$ means true."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a binary string with length $$$2n+1$$$, you need to show whether the value of the expression can be $$$1$$$ after inserting $$$n$$$ conditional operators into the string. You can use parentheses. For example, the string "},{"children":[{"kind":"text","text":"10101"}],"kind":"container"},{"kind":"text","text":" can be transformed into "},{"children":[{"kind":"text","text":"(1?0:1)?0:1"}],"kind":"container"},{"kind":"text","text":", whose value is $$$1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10\\,000)$$$, the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first line of each test case, there is a single integer $$$n$$$ ($$$1 \\le n \\le 1.5 \\cdot 10^5)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line of each test case, there is a binary string of length $$$2n + 1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ across all test cases does not exceed $$$1.5 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, on the first line, output "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" if the string can be transformed into an expression of value $$$1$$$; otherwise, output "},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the answer is "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":", output the expression on the second line. You can use parentheses, but the order of the characters in the original string must remain the same. The length of your expression must be no more than $$$10n+1000$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n2\n10101\n2\n00000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYes\n(1?0:1)?(0):1\nNo\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test case — is the one mentioned in the problem description."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, it is clear that regardless of how the conditional operator is used, the result will always be zero."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"2089D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2089/problem/D"}