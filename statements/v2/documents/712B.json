{"assets":[],"contentKind":"statement","contestId":"712","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Memory and Trident"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Memory is performing a walk on the two-dimensional plane, starting at the origin. He is given a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" with his directions for motion:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" An '"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"' indicates he should move one unit left. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" An '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"' indicates he should move one unit right. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A '"},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":"' indicates he should move one unit up. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A '"},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"' indicates he should move one unit down."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"But now Memory wants to end at the origin. To do this, he has a special trident. This trident can replace any character in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" with any of '"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":"', or '"},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"'. However, because he doesn't want to wear out the trident, he wants to make the minimum number of edits possible. Please tell Memory what is the minimum number of changes he needs to make to produce a string that, when walked, will end at the origin, or if there is no such string."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and only line contains the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 100 000"},{"kind":"text","text":") — the instructions Memory is given."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is a string satisfying the conditions, output a single integer — the minimum number of edits required. In case it's not possible to change the sequence in such a way that it will bring Memory to to the origin, output "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"RRU\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"UDUR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"RUUR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test, Memory is told to walk right, then right, then up. It is easy to see that it is impossible to edit these instructions to form a valid walk."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test, Memory is told to walk up, then down, then up, then right. One possible solution is to change "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to \""},{"children":[{"kind":"text","text":"LDUR"}],"kind":"container"},{"kind":"text","text":"\". This string uses 1 edit, which is the minimum possible. It also ends at the origin."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"712B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/712/problem/B"}