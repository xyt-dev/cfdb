{"assets":[],"contentKind":"statement","contestId":"131","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Yet Another Task with Queens"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A queen is the strongest chess piece. In modern chess the queen can move any number of squares in any horizontal, vertical or diagonal direction (considering that there're no other pieces on its way). The queen combines the options given to the rook and the bishop."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queens on a square "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" chessboard. You know each queen's positions, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th queen is positioned in the square "},{"kind":"math_inline","text":"(ri, ci)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" is the board row number (numbered from the top to the bottom from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"), and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" is the board's column number (numbered from the left to the right from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"). No two queens share the same position."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each queen one can count "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" — the number of other queens that the given queen threatens (attacks). For a fixed attack direction only the first queen in this direction is under attack if there are many queens are on the ray of the attack. Obviously, for any queen "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" is between 0 and 8, inclusive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print the sequence "},{"kind":"math_inline","text":"t0, t1, ..., t8"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" is the number of queens that threaten exactly "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" other queens, i.e. the number of queens that their "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" equals "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a pair of integers "},{"kind":"math_inline","text":"n, m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the size of the board and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is the number of queens on the board. Then "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" following lines contain positions of the queens, one per line. Each line contains a pair of integers "},{"kind":"math_inline","text":"ri, ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ri, ci ≤ n"},{"kind":"text","text":") — the queen's position. No two queens stand on the same square."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the required sequence "},{"kind":"math_inline","text":"t0, t1, ..., t8"},{"kind":"text","text":", separating the numbers with spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 4\n4 3\n4 8\n6 5\n1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 3 0 1 0 0 0 0 0 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 3\n1 1\n1 2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 2 1 0 0 0 0 0 0 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"131E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/131/problem/E"}