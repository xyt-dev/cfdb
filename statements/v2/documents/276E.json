{"assets":[],"contentKind":"statement","contestId":"276","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Little Girl and Problem on Trees"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A little girl loves problems on trees very much. Here's one of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A tree is an undirected connected graph, not containing cycles. The degree of node "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" in the tree is the number of nodes "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" of the tree, such that each of them is connected with node "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by some edge of the tree. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's consider a tree that consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes. We'll consider the tree's nodes indexed from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The cosidered tree has the following property: each node except for node number 1 has the degree of at most 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially, each node of the tree contains number 0. Your task is to quickly process the requests of two types:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Request of form: "},{"kind":"math_inline","text":"0"},{"kind":"math_inline","text":"v"},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"d"},{"kind":"text","text":". In reply to the request you should add "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to all numbers that are written in the nodes that are located at the distance of at most "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" from node "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". The distance between two nodes is the number of edges on the shortest path between them. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Request of form: "},{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"v"},{"kind":"text","text":". In reply to the request you should print the current number that is written in node "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 105"},{"kind":"text","text":") — the number of tree nodes and the number of requests, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n  -  1"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ui ≠ vi"},{"kind":"text","text":"), that show that there is an edge between nodes "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":". Each edge's description occurs in the input exactly once. It is guaranteed that the given graph is a tree that has the property that is described in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines describe the requests."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The request to add has the following format: "},{"kind":"math_inline","text":"0"},{"kind":"math_inline","text":"v"},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ x ≤ 104"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ d < n"},{"kind":"text","text":"). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The request to print the node value has the following format: "},{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v ≤ n"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The numbers in the lines are separated by single spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each request to print the node value print an integer — the reply to the request."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6\n1 2\n1 3\n0 3 1 2\n0 2 3 1\n0 1 5 2\n1 1\n1 2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n9\n6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 11\n1 2\n2 5\n5 4\n1 6\n1 3\n0 3 1 3\n0 3 4 5\n0 2 1 4\n0 1 5 5\n0 4 6 2\n1 1\n1 2\n1 3\n1 4\n1 5\n1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n17\n11\n16\n17\n11\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"276E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/276/problem/E"}