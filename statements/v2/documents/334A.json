{"assets":[],"contentKind":"statement","contestId":"334","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Candy Bags"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Gerald has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" younger brothers and their number happens to be even. One day he bought "},{"kind":"math_inline","text":"n2"},{"kind":"text","text":" candy bags. One bag has one candy, one bag has two candies, one bag has three candies and so on. In fact, for each integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n2"},{"kind":"text","text":" he has exactly one bag with "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" candies. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help him give "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" bags of candies to each brother so that all brothers got the same number of candies."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is even, "},{"kind":"math_inline","text":"2 ≤ n ≤ 100"},{"kind":"text","text":") — the number of Gerald's brothers."}],"kind":"paragraph"}],"ki