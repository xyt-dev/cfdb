{"assets":[],"contentKind":"statement","contestId":"232","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Quick Tortoise"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"John Doe has a field, which is a rectangular table of size "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":". We assume that the field rows are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from top to bottom, and the field columns are numbered from 1 to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" from left to right. Then the cell of the field at the intersection of the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-th row and the "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"-th column has coordinates ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"y"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We know that some cells of John's field are painted white, and some are painted black. Also, John has a tortoise, which can move along the white cells of the field. The tortoise can get from a white cell with coordinates ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"y"},{"kind":"text","text":") into cell ("},{"kind":"math_inline","text":"x + 1"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"y"},{"kind":"text","text":") or ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"y + 1"},{"kind":"text","text":"), if the corresponding cell is painted white. In other words, the turtle can move only along the white cells of the field to the right or down. The turtle can not go out of the bounds of the field."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In addition, John has "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries, each of them is characterized by four numbers "},{"kind":"math_inline","text":"x1, y1, x2, y2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"x1 ≤ x2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1 ≤ y2"},{"kind":"text","text":"). For each query John wants to know whether the tortoise can start from the point with coordinates ("},{"kind":"math_inline","text":"x1"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":"), and reach the point with coordinates ("},{"kind":"math_inline","text":"x2"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":"), moving only along the white squares of the field."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 500"},{"kind":"text","text":") — the field sizes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters \""},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\": the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th character of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line equals \""},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"\", if the cell ("},{"kind":"math_inline","text":"i"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"j"},{"kind":"text","text":") is painted black and \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\", if it is painted white."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 6·105)"},{"kind":"text","text":" — the number of queries. Next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain four space-separated integers "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x1 ≤ x2 ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ y1 ≤ y2 ≤ m"},{"kind":"text","text":") — the coordinates of the starting and the finishing cells. It is guaranteed that cells ("},{"kind":"math_inline","text":"x1"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":") and ("},{"kind":"math_inline","text":"x2"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":") are white."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each of "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries print on a single line \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\", if there is a way from cell ("},{"kind":"math_inline","text":"x1"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":") to cell ("},{"kind":"math_inline","text":"x2"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":"), that meets the requirements, and \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" otherwise. Print the answers to the queries in the order, in which the queries are given in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n...\n.##\n.#.\n5\n1 1 3 3\n1 1 1 3\n1 1 3 1\n1 1 1 2\n1 1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\nYes\nYes\nYes\nYes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n.....\n.###.\n.....\n.###.\n.....\n5\n1 1 5 5\n1 1 1 5\n1 1 3 4\n2 1 2 5\n1 1 2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\nYes\nYes\nNo\nYes\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"232E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/232/problem/E"}