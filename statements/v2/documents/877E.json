{"assets":["/statement-assets/f8cb21f6b839754bdbde812b748c1857ca338b43a67f6dbfa5e9a7bebcc715cf.png","/statement-assets/a4c67822c3b3f47799a29672aefc349d80bf2274c3b47404dfa0d7aa758bff26.png"],"contentKind":"statement","contestId":"877","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Danil and a Part-time Job"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Danil decided to earn some money, so he had found a part-time job. The interview have went well, so now he is a light switcher."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Danil works in a rooted tree (undirected connected acyclic graph) with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices, vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is the root of the tree. There is a room in each vertex, light can be switched on or off in each room. Danil's duties include switching light in all rooms of the subtree of the vertex. It means that if light is switched on in some room of the subtree, he should switch it off. Otherwise, he should switch it on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately (or fortunately), Danil is very lazy. He knows that his boss is not going to personally check the work. Instead, he will send Danil tasks using "},{"children":[{"kind":"text","text":"Workforces"}],"kind":"container"},{"kind":"text","text":" personal messages."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are two types of tasks: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"children":[{"kind":"text","text":"pow v"}],"kind":"container"},{"kind":"text","text":" describes a task to switch lights in the subtree of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"get v"}],"kind":"container"},{"kind":"text","text":" describes a task to count the number of rooms in the subtree of "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", in which the light is turned on. Danil should send the answer to his boss using "},{"children":[{"kind":"text","text":"Workforces"}],"kind":"container"},{"kind":"text","text":" messages."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A subtree of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is a set of vertices for which the shortest path from them to the root passes through "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". In particular, the vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is in the subtree of "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Danil is not going to perform his duties. He asks you to write a program, which answers the boss instead of him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000"},{"kind":"text","text":") — the number of vertices in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"p2, p3, ..., pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi < i"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" is the ancestor of vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ti ≤ 1"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", if the light is turned on in vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fourth line contains a single integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 200 000"},{"kind":"text","text":") — the number of tasks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines are "},{"children":[{"kind":"text","text":"get v"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"pow v"}],"kind":"container"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v ≤ n"},{"kind":"text","text":") — the tasks described above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each task "},{"children":[{"kind":"text","text":"get v"}],"kind":"container"},{"kind":"text","text":" print the number of rooms in the subtree of "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", in which the light is turned on."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1 1\n1 0 0 1\n9\nget 1\nget 2\nget 3\nget 4\npow 1\nget 1\nget 2\nget 3\nget 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n0\n0\n1\n2\n1\n1\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f8cb21f6b839754bdbde812b748c1857ca338b43a67f6dbfa5e9a7bebcc715cf.png"},"kind":"image"},{"children":[{"kind":"text","text":"The tree before the task "},{"children":[{"kind":"text","text":"pow 1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a4c67822c3b3f47799a29672aefc349d80bf2274c3b47404dfa0d7aa758bff26.png"},"kind":"image"},{"children":[{"kind":"text","text":"The tree after the task "},{"children":[{"kind":"text","text":"pow 1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"container"}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"877E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/877/problem/E"}