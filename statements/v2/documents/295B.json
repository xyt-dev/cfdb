{"assets":["/statement-assets/53a3803e3b563f7f8f2a881343b60ef310e96fcf99dcebe9c2a639152f1404b7.png"],"contentKind":"statement","contestId":"295","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Greg and Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Greg has a weighed directed graph, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. In this graph any pair of distinct vertices has an edge between them in both directions. Greg loves playing with the graph and now he has invented a new game:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The game consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" steps. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" On the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th step Greg removes vertex number "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" from the graph. As Greg removes a vertex, he also removes all the edges that go in and out of this vertex. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Before executing each step, Greg wants to know the sum of lengths of the shortest paths between all pairs of the remaining vertices. The shortest path can go through any remaining vertex. In other words, if we assume that "},{"kind":"math_inline","text":"d(i, v, u)"},{"kind":"text","text":" is the shortest path between vertices "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" in the graph that formed before deleting vertex "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", then Greg wants to know the value of the following sum: "},{"attrs":{"alt":"","src":"/statement-assets/53a3803e3b563f7f8f2a881343b60ef310e96fcf99dcebe9c2a639152f1404b7.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Greg, print the value of the required sum before each step."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 500)"},{"kind":"text","text":" — the number of vertices in the graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers each — the graph adjacency matrix: the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th number in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line "},{"kind":"math_inline","text":"aij"},{"kind":"math_inline","text":"(1 ≤ aij ≤ 105, aii = 0)"},{"kind":"text","text":" represents the weight of the edge that goes from vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers: "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"math_inline","text":"(1 ≤ xi ≤ n)"},{"kind":"text","text":" — the vertices that Greg deletes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number equals the required sum before the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th step."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in "},{"children":[{"kind":"text","text":"C++"}],"kind":"container"},{"kind":"text","text":". It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams of the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n0\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n0 5\n4 0\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"childre