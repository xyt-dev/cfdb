{"assets":["/statement-assets/a4eb8eefa4f82e68c34a14a3ef15bd6b2f1540cbe06f6f1b0d017e57435042c9.png","/statement-assets/71de4deefb923f9143410e19a1b5d6b7f1705d8c183d0520b82cb3969ae54da7.png"],"contentKind":"statement","contestId":"336","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Vasily the Bear and Painting Square"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasily the bear has two favorite integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and a pencil. Besides, he's got "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" jars with different water color paints. All jars are numbered in some manner from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", inclusive. The jar number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" contains the paint of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th color. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially the bear took a pencil and drew four segments on the coordinate plane. All of them end at point "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":". They begin at: "},{"kind":"math_inline","text":"(0, 2n)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(0,  - 2n)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2n, 0)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"( - 2n, 0)"},{"kind":"text","text":". Then for each "},{"kind":"math_inline","text":"i = 1, 2, ..., n"},{"kind":"text","text":", the bear drew two squares. The first square has the following vertex coordinates: "},{"kind":"math_inline","text":"(2i, 0)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"( - 2i, 0)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(0,  - 2i)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(0, 2i)"},{"kind":"text","text":". The second square has the following vertex coordinates: "},{"kind":"math_inline","text":"( - 2i - 1,  - 2i - 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"( - 2i - 1, 2i - 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2i - 1,  - 2i - 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2i - 1, 2i - 1)"},{"kind":"text","text":". After that, the bear drew another square: "},{"kind":"math_inline","text":"(1, 0)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"( - 1, 0)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(0,  - 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(0, 1)"},{"kind":"text","text":". All points mentioned above form the set of points "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a4eb8eefa4f82e68c34a14a3ef15bd6b2f1540cbe06f6f1b0d017e57435042c9.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"The sample of the final picture at "},{"kind":"math_inline","text":"n = 0"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/71de4deefb923f9143410e19a1b5d6b7f1705d8c183d0520b82cb3969ae54da7.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"The sample of the final picture at "},{"kind":"math_inline","text":"n = 2"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The bear decided to paint the resulting picture in "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" moves. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th move consists of the following stages: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The bear chooses 3 distinct points in set "},{"kind":"math_inline","text":"А"},{"kind":"text","text":" so that any pair of the chosen points has a segment on the picture between them. The chosen points and segments mark the area that mustn't contain any previously painted points. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The bear paints the area bounded by the chosen points and segments the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th color. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that after the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th move some parts of the picture can stay unpainted."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The bear asked you to calculate, how many distinct ways there are to paint his picture. A way to paint the picture is a sequence of three-element sets of points he chose on each step. Two sequences are considered distinct if there is such number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ k)"},{"kind":"text","text":", that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th members of these sequences do not coincide as sets. As the sought number can be rather large, you only need to calculate the remainder after dividing it by number "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", separated by a space ("},{"kind":"math_inline","text":"0 ≤ n, k ≤ 200"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print exactly one integer — the answer to the problem modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"32\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"32\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"336E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/336/problem/E"}