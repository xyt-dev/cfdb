{"assets":[],"contentKind":"statement","contestId":"1601","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Two Sorts"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Integers from $$$1$$$ to $$$n$$$ (inclusive) were sorted lexicographically (considering integers as strings). As a result, array $$$a_1, a_2, \\dots, a_n$$$ was obtained."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Calculate value of $$$(\\sum_{i = 1}^n ((i - a_i) \\mod 998244353)) \\mod 10^9 + 7$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$x \\mod y$$$ here means the remainder after division $$$x$$$ by $$$y$$$. This remainder is always non-negative and doesn't exceed $$$y - 1$$$. For example, $$$5 \\mod 3 = 2$$$, $$$(-1) \\mod 6 = 5$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the single integer $$$n$$$ ($$$1 \\leq n \\leq 10^{12}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the required sum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n994733045\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n21\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n978932159\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1000000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n289817887\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A string $$$a$$$ is lexicographically smaller than a string $$$b$$$ if and only if one of the following holds:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a$$$ is a prefix of $$$b$$$, but $$$a \\ne b$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the first position where $$$a$$$ and $$$b$$$ differ, the string $$$a$$$ has a letter that appears earlier in the alphabet than the corresponding letter in $$$b$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, $$$42$$$ is lexicographically smaller than $$$6$$$, because they differ in the first digit, and $$$4 \\lt 6$$$; $$$42 \\lt 420$$$, because $$$42$$$ is a prefix of $$$420$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's denote $$$998244353$$$ as $$$M$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first example, array $$$a$$$ is equal to $$$[1, 2, 3]$$$. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$(1 - 1) \\mod M = 0 \\mod M = 0$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(2 - 2) \\mod M = 0 \\mod M = 0$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(3 - 3) \\mod M = 0 \\mod M = 0$$$ "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"As a result, $$$(0 + 0 + 0) \\mod 10^9 + 7 = 0$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, array $$$a$$$ is equal to $$$[1, 10, 11, 12, 2, 3, 4, 5, 6, 7, 8, 9]$$$. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$(1 - 1) \\mod M = 0 \\mod M = 0$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(2 - 10) \\mod M = (-8) \\mod M = 998244345$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(3 - 11) \\mod M = (-8) \\mod M = 998244345$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(4 - 12) \\mod M = (-8) \\mod M = 998244345$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(5 - 2) \\mod M = 3 \\mod M = 3$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(6 - 3) \\mod M = 3 \\mod M = 3$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(7 - 4) \\mod M = 3 \\mod M = 3$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(8 - 5) \\mod M = 3 \\mod M = 3$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(9 - 6) \\mod M = 3 \\mod M = 3$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(10 - 7) \\mod M = 3 \\mod M = 3$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(11 - 8) \\mod M = 3 \\mod M = 3$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$(12 - 9) \\mod M = 3 \\mod M = 3$$$ "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"As a result, $$$(0 + 998244345 + 998244345 + 998244345 + 3 + 3 + 3 + 3 + 3 + 3 + 3 + 3) \\mod 10^9 + 7$$$ $$$=$$$ $$$2994733059 \\mod 10^9 + 7$$$ $$$=$$$ $$$994733045$$$"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1601F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1601/problem/F"}