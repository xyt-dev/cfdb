{"assets":["/statement-assets/0fc1995d019db4b8d64f727db74d33d8410cabac68538895691c8bd96747c72c.png"],"contentKind":"statement","contestId":"748","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Santa Claus and a Place in a Class"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Santa Claus is the first who came to the Christmas Olympiad, and he is going to be the first to take his place at a desk! In the classroom there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lanes of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" desks each, and there are two working places at each of the desks. The lanes are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from the left to the right, the desks in a lane are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" starting from the blackboard. Note that the lanes go perpendicularly to the blackboard, not along it (see picture)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The organizers numbered all the working places from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"2nm"},{"kind":"text","text":". The places are numbered by lanes (i. e. all the places of the first lane go first, then all the places of the second lane, and so on), in a lane the places are numbered starting from the nearest to the blackboard (i. e. from the first desk in the lane), at each desk, the place on the left is numbered before the place on the right."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0fc1995d019db4b8d64f727db74d33d8410cabac68538895691c8bd96747c72c.png"},"kind":"image"},{"children":[{"kind":"text","text":"The picture illustrates the first and the second samples."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Santa Clause knows that his place has number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Help him to determine at which lane at which desk he should sit, and whether his place is on the left or on the right!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 10 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 2nm"},{"kind":"text","text":") — the number of lanes, the number of desks in each lane and the number of Santa Claus' place."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two integers: the number of lane "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", the number of desk "},{"kind":"math_inline","text":"d"},{"kind":"text","text":", and a character "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", which stands for the side of the desk Santa Claus. The character "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" should be \""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\", if Santa Clause should sit on the left, and \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\" if his place is on the right."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 2 L\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 24\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 3 R\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 R\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and the second samples are shown on the picture. The green place corresponds to Santa Claus' place in the first example, the blue place corresponds to Santa Claus' place in the second example."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample there are two lanes with four desks in each, and Santa Claus has the fourth place. Thus, his place is in the first lane at the second desk on the right."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"748A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/748/problem/A"}