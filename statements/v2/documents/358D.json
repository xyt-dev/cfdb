{"assets":[],"contentKind":"statement","contestId":"358","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Dima and Hares"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dima liked the present he got from Inna very much. He liked the present he got from Seryozha even more. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Dima felt so grateful to Inna about the present that he decided to buy her "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" hares. Inna was very happy. She lined up the hares in a row, numbered them from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right and started feeding them with carrots. Inna was determined to feed each hare exactly once. But in what order should she feed them?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Inna noticed that each hare radiates joy when she feeds it. And the joy of the specific hare depends on whether Inna fed its adjacent hares before feeding it. Inna knows how much joy a hare radiates if it eats when either both of his adjacent hares are hungry, or one of the adjacent hares is full (that is, has been fed), or both of the adjacent hares are full. Please note that hares number 1 and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" don't have a left and a right-adjacent hare correspondingly, so they can never have two full adjacent hares."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Inna maximize the total joy the hares radiate. :)"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 3000)"},{"kind":"text","text":" — the number of hares. Then three lines follow, each line has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. The first line contains integers "},{"kind":"math_inline","text":"a1"},{"kind":"math_inline","text":"a2"},{"kind":"math_inline","text":"..."},{"kind":"math_inline","text":"an"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":". The third line contains "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"text","text":". The following limits are fulfilled: "},{"kind":"math_inline","text":"0 ≤ ai, bi, ci ≤ 105"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" in the first line shows the joy that hare number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" gets if his adjacent hares are both hungry. Number "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" in the second line shows the joy that hare number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" radiates if he has exactly one full adjacent hare. Number "},{"kind":"math_inline","text":"сi"},{"kind":"text","text":" in the third line shows the joy that hare number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" radiates if both his adjacent hares are full."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line, print the maximum possible total joy of the hares Inna can get by feeding them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 3 4\n4 3 2 1\n0 1 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n8 5 7 6 1 8 9\n2 7 9 5 4 3 1\n2 3 3 4 1 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"44\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 1\n1 2 1\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"358D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/358/problem/D"}