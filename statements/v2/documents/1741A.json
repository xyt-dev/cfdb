{"assets":[],"contentKind":"statement","contestId":"1741","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Compare T-Shirt Sizes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Two T-shirt sizes are given: $$$a$$$ and $$$b$$$. The T-shirt size is either a string "},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":" or a string consisting of several (possibly zero) characters "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":" and one of the characters "},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, strings "},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"XXL"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"XXXXXXXS"}],"kind":"container"},{"kind":"text","text":" could be the size of some T-shirts. And the strings "},{"children":[{"kind":"text","text":"XM"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"LL"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"SX"}],"kind":"container"},{"kind":"text","text":" are not sizes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The letter "},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":" stands for medium, "},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":" for small, "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":" for large. The letter "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":" refers to the degree of size (from eXtra). For example, "},{"children":[{"kind":"text","text":"XXL"}],"kind":"container"},{"kind":"text","text":" is extra-extra-large (bigger than "},{"children":[{"kind":"text","text":"XL"}],"kind":"container"},{"kind":"text","text":", and smaller than "},{"children":[{"kind":"text","text":"XXXL"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to compare two given sizes of T-shirts $$$a$$$ and $$$b$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The T-shirts are compared as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" any small size (no matter how many letters "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":") is smaller than the medium size and any large size; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" any large size (regardless of the number of letters "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":") is larger than the medium size and any small size; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the more letters "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":" before "},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":", the smaller the size; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the more letters "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":" in front of "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":", the larger the size. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"XXXS"}],"kind":"container"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"XS"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"XXXL"}],"kind":"container"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"XL"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"XL"}],"kind":"container"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"M"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"XXL"}],"kind":"container"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"XXL"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"XXXXXS"}],"kind":"container"},{"kind":"text","text":" < "},{"children":[{"kind":"text","text":"M"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"XL"}],"kind":"container"},{"kind":"text","text":" > "},{"children":[{"kind":"text","text":"XXXS"}],"kind":"container"}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of one line, in which $$$a$$$ and $$$b$$$ T-shirt sizes are written. The lengths of the strings corresponding to the T-shirt sizes do not exceed $$$50$$$. It is guaranteed that all sizes are correct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print on a separate line the result of comparing $$$a$$$ and $$$b$$$ T-shirt sizes (lines \""},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"="}],"kind":"container"},{"kind":"text","text":"\" without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\nXXXS XS\nXXXL XL\nXL M\nXXL XXL\nXXXXXS M\nL M\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n<\n>\n>\n=\n<\n>\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1741A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1741/problem/A"}