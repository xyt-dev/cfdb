{"assets":[],"contentKind":"statement","contestId":"2196","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Double Bracket Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Given a string $$$s$$$ of even length, consisting of the characters \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"["}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"]"}],"kind":"container"},{"kind":"text","text":"\", which are brackets of two types (round and square)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We call a string $$$t$$$ "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if it satisfies two conditions simultaneously:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The subsequence of "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" round brackets forms a correct bracket sequence$$$^{\\text{∗}}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The subsequence of "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" square brackets forms a correct bracket sequence. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, the string \""},{"children":[{"kind":"text","text":"[(][)[]]()"}],"kind":"container"},{"kind":"text","text":"\" is "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":", as the subsequence of all round brackets in it \""},{"children":[{"kind":"text","text":"()()"}],"kind":"container"},{"kind":"text","text":"\" forms a correct bracket sequence and the subsequence of all square brackets in it \""},{"children":[{"kind":"text","text":"[][[]]"}],"kind":"container"},{"kind":"text","text":"\" forms a correct bracket sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You would like to turn $$$s$$$ into any "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" string; for this, you can change the characters: in one operation, you can choose a position $$$i$$$, such that $$$1 \\le i \\le n$$$ and change the character $$$s_{i}$$$ to any round or square bracket."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of operations required to transform $$$s$$$ into any "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" string?"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$A bracket sequence is called correct if by inserting the symbols \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" into it, one can obtain a valid mathematical expression. For example, the sequences \""},{"children":[{"kind":"text","text":"(())()"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"[]"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(()(()))"}],"kind":"container"},{"kind":"text","text":"\" are correct, while \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"[[]"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(()))("}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains one integer $$$n$$$ ($$$2 \\le n \\le 2 \\cdot 10^{5}$$$) — the length of the string $$$s$$$. It is guaranteed that $$$n$$$ is even."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$s$$$ of length $$$n$$$, consisting only of the characters \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"["}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"]"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ across all test cases does not exceed $$$2 \\cdot 10^5$$$"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n2\n[)\n4\n[)[(\n4\n))[[\n4\n([)]\n6\n[)]](]\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n2\n0\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, from $$$s$$$ you can obtain \""},{"children":[{"kind":"text","text":"[]"}],"kind":"container"},{"kind":"text","text":"\" by changing the second character."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, from $$$s$$$, in $$$2$$$ operations, you can obtain \""},{"children":[{"kind":"text","text":"[][]"}],"kind":"container"},{"kind":"text","text":"\", by changing the characters at positions $$$2$$$ and $$$4$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, from $$$s$$$, in $$$2$$$ operations, you can obtain \""},{"children":[{"kind":"text","text":"()[]"}],"kind":"container"},{"kind":"text","text":"\", by changing the characters at positions $$$1$$$ and $$$4$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, $$$s$$$ is already "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":", as it can be divided into the subsequences \""},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"[]"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"2196D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2196/problem/D"}