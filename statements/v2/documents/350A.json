{"assets":[],"contentKind":"statement","contestId":"350","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. TL"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Valera wanted to prepare a Codesecrof round. He's already got one problem and he wants to set a time limit (TL) on it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valera has written "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" correct solutions. For each correct solution, he knows its running time (in seconds). Valera has also wrote "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" wrong solutions and for each wrong solution he knows its running time (in seconds)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's suppose that Valera will set "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" seconds TL in the problem. Then we can say that a solution passes the system testing if its running time is at most "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" seconds. We can also say that a solution passes the system testing with some \"extra\" time if for its running time, "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" seconds, an inequality "},{"kind":"math_inline","text":"2a ≤ v"},{"kind":"text","text":" holds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As a result, Valera decided to set "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" seconds TL, that the following conditions are met:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"v"},{"kind":"text","text":" is a positive integer; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" all correct solutions pass the system testing; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" at least one correct solution passes the system testing with some \"extra\" time; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" all wrong solutions do not pass the system testing; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" value "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is minimum among all TLs, for which points "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" hold. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Valera and find the most suitable TL or else state that such TL doesn't exist."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated positive integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 100"},{"kind":"text","text":") — the running time of each of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" correct solutions in seconds. The third line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space-separated positive integers "},{"kind":"math_inline","text":"b1, b2, ..., bm"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ 100"},{"kind":"text","text":") — the running time of each of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" wrong solutions in seconds. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is a valid TL value, print it. Otherwise, print -1."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6\n4 5 2\n8 9 6 10 7 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n3 4 5\n6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"350A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/350/problem/A"}