{"assets":[],"contentKind":"statement","contestId":"884","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Bertown Subway"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The construction of subway in Bertown is almost finished! The President of Berland will visit this city soon to look at the new subway himself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" stations in the subway. It was built according to the "},{"children":[{"kind":"text","text":"Bertown Transport Law"}],"kind":"container"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" For each station "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" there exists exactly one train that goes from this station. Its destination station is "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":", possibly "},{"kind":"math_inline","text":"pi = i"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For each station "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" there exists exactly one station "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"pj = i"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The President will consider the "},{"children":[{"kind":"text","text":"convenience"}],"kind":"container"},{"kind":"text","text":" of subway after visiting it. The "},{"children":[{"kind":"text","text":"convenience"}],"kind":"container"},{"kind":"text","text":" is the number of ordered pairs "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" such that person can start at station "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and, after taking some subway trains (possibly zero), arrive at station "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x, y ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The mayor of Bertown thinks that if the subway is not "},{"children":[{"kind":"text","text":"convenient"}],"kind":"container"},{"kind":"text","text":" enough, then the President might consider installing a new mayor (and, of course, the current mayor doesn't want it to happen). Before President visits the city mayor has enough time to rebuild some paths of subway, thus changing the values of "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" for "},{"children":[{"kind":"text","text":"not more than two subway stations"}],"kind":"container"},{"kind":"text","text":". Of course, breaking the "},{"children":[{"kind":"text","text":"Bertown Transport Law"}],"kind":"container"},{"kind":"text","text":" is really bad, so the subway must be built according to the "},{"children":[{"kind":"text","text":"Law"}],"kind":"container"},{"kind":"text","text":" even after changes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The mayor wants to do these changes in such a way that the "},{"children":[{"kind":"text","text":"convenience"}],"kind":"container"},{"kind":"text","text":" of the subway is maximized. Help him to calculate the maximum possible "},{"children":[{"kind":"text","text":"convenience"}],"kind":"container"},{"kind":"text","text":" he can get! "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100000"},{"kind":"text","text":") — the number of stations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":") — the current structure of the subway. All these numbers are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one number — the maximum possible value of "},{"children":[{"kind":"text","text":"convenience"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 5 4 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"17\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the mayor can change "},{"kind":"math_inline","text":"p2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p3"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", so there will be "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" pairs: "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 3)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the mayor can change "},{"kind":"math_inline","text":"p2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p3"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"884C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/884/problem/C"}