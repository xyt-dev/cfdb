{"assets":["/statement-assets/19931f9ab08e8fb0da03c7704728a1ac2020ac7893a59ad1cbb84104b62a1ebb.png","/statement-assets/f7f97eddb227fbb67f1f77f2240530b846a2cccb7ddbb56934e54d6cebf343f2.png","/statement-assets/162a19da38f74795313317e54a8da6540822c4e97c4ab0aebbce5e30a0e9d789.png"],"contentKind":"statement","contestId":"1002","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A4. Generate W state"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"N = 2k"},{"kind":"text","text":" qubits ("},{"kind":"math_inline","text":"0 ≤ k ≤ 4"},{"kind":"text","text":") in zero state "},{"attrs":{"alt":"","src":"/statement-assets/19931f9ab08e8fb0da03c7704728a1ac2020ac7893a59ad1cbb84104b62a1ebb.png"},"kind":"image"},{"kind":"text","text":". Your task is to create a generalized "},{"attrs":{"href":"https://en.wikipedia.org/wiki/W_state"},"children":[{"kind":"text","text":"W state"}],"kind":"link"},{"kind":"text","text":" on them. Generalized W state is an equal superposition of all basis states on "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" qubits that have Hamming weight equal to 1:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f7f97eddb227fbb67f1f77f2240530b846a2cccb7ddbb56934e54d6cebf343f2.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"For example, for "},{"kind":"math_inline","text":"N = 1"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/162a19da38f74795313317e54a8da6540822c4e97c4ab0aebbce5e30a0e9d789.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to implement an operation which takes an array of "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" qubits as an input and has no output. The \"output\" of the operation is the state in which it leaves the qubits."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your code should have the following signature:"}],"kind":"paragraph"},{"kind":"code_block","text":"namespace Solution {\n    open Microsoft.Quantum.Primitive;\n    open Microsoft.Quantum.Canon;\n\n    operation Solve (qs : Qubit[]) : ()\n    {\n        body\n        {\n            // your code here\n        }\n    }\n}"}],"kind":"section"}],"kind":"document"},"index":"A4","problemCode":"1002A4","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1002/problem/A4"}