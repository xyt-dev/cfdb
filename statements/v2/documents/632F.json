{"assets":[],"contentKind":"statement","contestId":"632","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Magic Matrix"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You're given a matrix "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call the matrix with nonnegative elements magic if it is symmetric (so "},{"kind":"math_inline","text":"aij = aji"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"aii = 0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"aij ≤ max(aik, ajk)"},{"kind":"text","text":" for all triples "},{"kind":"math_inline","text":"i, j, k"},{"kind":"text","text":". Note that "},{"kind":"math_inline","text":"i, j, k"},{"kind":"text","text":" do not need to be distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine if the matrix is magic."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As the input/output can reach very huge size it is recommended to use fast input/output methods: for example, prefer to use "},{"children":[{"kind":"text","text":"scanf/printf"}],"kind":"container"},{"kind":"text","text":" instead of "},{"children":[{"kind":"text","text":"cin/cout"}],"kind":"container"},{"kind":"text","text":" in C++, prefer to use "},{"children":[{"kind":"text","text":"BufferedReader/PrintWriter"}],"kind":"container"},{"kind":"text","text":" instead of "},{"children":[{"kind":"text","text":"Scanner/System.out"}],"kind":"container"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"Java"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2500"},{"kind":"text","text":") — the size of the matrix "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"aij"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ aij < 109"},{"kind":"text","text":") — the elements of the matrix "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the given matrix not necessarily is symmetric and can be arbitrary."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print ''"},{"children":[{"kind":"text","text":"MAGIC"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if the given matrix "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is magic. Otherwise print ''"},{"children":[{"kind":"text","text":"NOT MAGIC"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs"