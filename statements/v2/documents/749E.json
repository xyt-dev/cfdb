{"assets":["/statement-assets/f71332e5223f127f8dbb736a511ae0eee5265f9c0e5d35b29d7888da45b0a95f.png","/statement-assets/1ae22f61db293cf2e07fdc3922dfc629fe50424264f74918ab55686a373077bc.png"],"contentKind":"statement","contestId":"749","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Inversions After Shuffle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a permutation of integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Exactly once you apply the following operation to this permutation: pick a random segment and shuffle its elements. Formally:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Pick a random segment (continuous subsequence) from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":". All "},{"attrs":{"alt":"","src":"/statement-assets/f71332e5223f127f8dbb736a511ae0eee5265f9c0e5d35b29d7888da45b0a95f.png"},"kind":"image"},{"kind":"text","text":" segments are equiprobable. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Let "},{"kind":"math_inline","text":"k = r - l + 1"},{"kind":"text","text":", i.e. the length of the chosen segment. Pick a random permutation of integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p1, p2, ..., pk"},{"kind":"text","text":". All "},{"kind":"math_inline","text":"k!"},{"kind":"text","text":" permutation are equiprobable. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" This permutation is applied to elements of the chosen segment, i.e. permutation "},{"kind":"math_inline","text":"a1, a2, ..., al - 1, al, al + 1, ..., ar - 1, ar, ar + 1, ..., an"},{"kind":"text","text":" is transformed to "},{"kind":"math_inline","text":"a1, a2, ..., al - 1, al - 1 + p1, al - 1 + p2, ..., al - 1 + pk - 1, al - 1 + pk, ar + 1, ..., an"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"Inversion"}],"kind":"container"},{"kind":"text","text":" if a pair of elements (not necessary neighbouring) with the wrong relative order. In other words, the number of inversion is equal to the number of pairs "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"i < j"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ai > aj"},{"kind":"text","text":". Find the expected number of inversions after we apply exactly one operation mentioned above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the length of the permutation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — elements of the permutation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one real value — the expected number of inversions. Your answer will be considered correct if its absolute or relative error does not exceed "},{"kind":"math_inline","text":"10 - 9"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Namely: let's assume that your answer is "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and the answer of the jury is "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The checker program will consider your answer correct, if "},{"attrs":{"alt":"","src":"/statement-assets/1ae22f61db293cf2e07fdc3922dfc629fe50424264f74918ab55686a373077bc.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.916666666666666666666666666667\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"749E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/749/problem/E"}