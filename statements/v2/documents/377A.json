{"assets":[],"contentKind":"statement","contestId":"377","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Maze"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pavel loves grid mazes. A grid maze is an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" rectangle maze where each cell is either empty, or is a wall. You can go from one cell to another only if both cells are empty and have a common side."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pavel drew a grid maze with all empty cells forming a connected area. That is, you can go from any empty cell to any other one. Pavel doesn't like it when his maze has too little walls. He wants to turn exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" empty cells into walls so that all the remaining cells still formed a connected area. Help him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 500"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k < s"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" are the maze's height and width, correspondingly, "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is the number of walls Pavel wants to add and letter "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" represents the number of empty cells in the original maze."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters. They describe the original maze. If a character on a line equals \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\", then the corresponding cell is empty and if the character equals \""},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"\", then the cell is a wall."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines containing "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters each: the new maze that fits Pavel's requirements. Mark the empty cells that you transformed into walls as \""},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"\", the other cells must be left without changes (that is, \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"\")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that a solution exists. If there are multiple solutions you can output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4 2\n#..#\n..#.\n#...\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"#.X#\nX.#.\n#...\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4 5\n#...\n#.#.\n.#..\n...#\n.#.#\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"#XXX\n#X#.\nX#..\n...#\n.#.#\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"377A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/377/problem/A"}