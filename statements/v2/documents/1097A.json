{"assets":[],"contentKind":"statement","contestId":"1097","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Gennady and a Card Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Gennady owns a small hotel in the countryside where he lives a peaceful life. He loves to take long walks, watch sunsets and play cards with tourists staying in his hotel. His favorite game is called \"Mau-Mau\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To play Mau-Mau, you need a pack of $$$52$$$ cards. Each card has a suit (Diamonds — "},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":", Clubs — "},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":", Spades — "},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":", or Hearts — "},{"children":[{"kind":"text","text":"H"}],"kind":"container"},{"kind":"text","text":"), and a rank ("},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"3"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"6"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"8"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"9"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"J"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"Q"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"K"}],"kind":"container"},{"kind":"text","text":", or "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At the start of the game, there is one card on the table and you have five cards in your hand. You can play a card from your hand if and only if it has the same rank or the same suit as the card on the table."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In order to check if you'd be a good playing partner, Gennady has prepared a task for you. Given the card on the table and five cards in your hand, check if you can play at least one card."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one string which describes the card on the table. The second line contains five strings which describe the cards in your hand."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each string is two characters long. The first character denotes the rank and belongs to the set $$$\\{{\\tt 2}, {\\tt 3}, {\\tt 4}, {\\tt 5}, {\\tt 6}, {\\tt 7}, {\\tt 8}, {\\tt 9}, {\\tt T}, {\\tt J}, {\\tt Q}, {\\tt K}, {\\tt A}\\}$$$. The second character denotes the suit and belongs to the set $$$\\{{\\tt D}, {\\tt C}, {\\tt S}, {\\tt H}\\}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the cards in the input are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is possible to play a card from your hand, print one word \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\". Otherwise, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print each letter in any case (upper or lower)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nAS\n2H 4C TH JH AD\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2H\n3D 4C AC KD AS\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4D\nAS AC AD AH 5H\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, there is an Ace of Spades ("},{"children":[{"kind":"text","text":"AS"}],"kind":"container"},{"kind":"text","text":") on the table. You can play an Ace of Diamonds ("},{"children":[{"kind":"text","text":"AD"}],"kind":"container"},{"kind":"text","text":") because both of them are Aces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, you cannot play any card."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, you can play an Ace of Diamonds ("},{"children":[{"kind":"text","text":"AD"}],"kind":"container"},{"kind":"text","text":") because it has the same suit as a Four of Diamonds ("},{"children":[{"kind":"text","text":"4D"}],"kind":"container"},{"kind":"text","text":"), which lies on the table."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1097A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1097/problem/A"}