{"assets":["/statement-assets/6feb86da9ec9799a2b782d6801cba895d9e4e8596f1f22c40b360322fab818e3.png"],"contentKind":"statement","contestId":"639","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Bear and Forgotten Tree 3"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A tree is a connected undirected graph consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"n  -  1"},{"kind":"text","text":" edges. Vertices are numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak is a little polar bear and Radewoosh is his evil enemy. Limak once had a tree but Radewoosh stolen it. Bear is very sad now because he doesn't remember much about the tree — he can tell you only three values "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"h"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The tree had exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The tree had diameter "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". In other words, "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" was the biggest distance between two vertices. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Limak also remembers that he once rooted the tree in vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and after that its height was "},{"kind":"math_inline","text":"h"},{"kind":"text","text":". In other words, "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" was the biggest distance between vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and some other vertex. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The distance between two vertices of the tree is the number of edges on the simple path between them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Limak to restore his tree. Check whether there exists a tree satisfying the given conditions. Find any such tree and print its edges in any order. It's also possible that Limak made a mistake and there is no suitable tree – in this case print \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100 000, 1 ≤ h ≤ d ≤ n - 1"},{"kind":"text","text":") — the number of vertices, diameter, and height after rooting in vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no tree matching what Limak remembers, print the only line with \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, describe any tree matching Limak's description. Print "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines, each with two space-separated integers – indices of vertices connected by an edge. If there are many valid trees, print any of them. You can print edges in any order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n1 3\n3 4\n3 5"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 8\n5 7\n2 3\n8 1\n2 1\n5 6\n1 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Below you can see trees printed to the output in the first sample and the third sample."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6feb86da9ec9799a2b782d6801cba895d9e4e8596f1f22c40b360322fab818e3.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"639B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/639/problem/B"}