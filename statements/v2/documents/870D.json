{"assets":["/statement-assets/3cbcc9e794199c97c322f10b0913b628e1566fedfc6e59c40d3fdc21ffa972e9.png","/statement-assets/bae470416b2d4c1bdcca806a615bde794e912c8e8af4a13b097d9cad45e71c81.png","/statement-assets/b1a63fdd728456567b7eb2ff4f953a9b328133146ca93f06d860da6b6add598f.png","/statement-assets/49d0f6537bb8c14ea2d467866facfdc7d77debb385f578362490ecaf0dba8268.png","/statement-assets/6dfa3509feb8bd851feb43cfb4713389b980973b973ed01e2d8fc32f38982202.png","/statement-assets/87fb632f4a788b2493932d6b15dd988dfb0a83a06b4cb624d3719602f47d849e.png","/statement-assets/9d5f3a223914dd237deedb38ed3d8cd5a80bd3a7344068be6abbd91de6755189.png","/statement-assets/5f7d93e25b3386ee959fd17341ac826cddfcb60ab968e2c002e5da2762a282d5.png"],"contentKind":"statement","contestId":"870","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Something with XOR Queries"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is an interactive problem."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Jury has hidden a permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" of integers from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":". You know only the length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Remind that in permutation all integers are distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" be the inverse permutation for "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", i.e. "},{"kind":"math_inline","text":"pbi = i"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". The only thing you can do is to ask "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" of elements "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bj"},{"kind":"text","text":", printing two indices "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" (not necessarily distinct). As a result of the query with indices "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" you'll get the value "},{"attrs":{"alt":"","src":"/statement-assets/3cbcc9e794199c97c322f10b0913b628e1566fedfc6e59c40d3fdc21ffa972e9.png"},"kind":"image"},{"kind":"text","text":", where "},{"attrs":{"alt":"","src":"/statement-assets/bae470416b2d4c1bdcca806a615bde794e912c8e8af4a13b097d9cad45e71c81.png"},"kind":"image"},{"kind":"text","text":" denotes the "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" operation. You can find the description of "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" operation in notes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that some permutations can remain indistinguishable from the hidden one, even if you make all possible "},{"kind":"math_inline","text":"n2"},{"kind":"text","text":" queries. You have to compute the number of permutations indistinguishable from the hidden one, and print one of such permutations, making no more than "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The hidden permutation does not depend on your queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5000"},{"kind":"text","text":") — the length of the hidden permutation. You should read this integer first."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"When your program is ready to print the answer, print three lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first line print \""},{"children":[{"kind":"text","text":"!"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print single integer "},{"kind":"math_inline","text":"answers_cnt"},{"kind":"text","text":" — the number of permutations indistinguishable from the hidden one, including the hidden one. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"p0, p1, ..., pn - 1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ pi < n"},{"kind":"text","text":", all "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" should be distinct) — one of the permutations indistinguishable from the hidden one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your program should terminate after printing the answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom","title":"Interaction"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Interaction"}],"kind":"heading"},{"children":[{"kind":"text","text":"To ask about "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" of two elements, print a string \""},{"children":[{"kind":"text","text":"? i j"}],"kind":"container"},{"kind":"text","text":"\", where "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" — are integers from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" — the index of the permutation element and the index of the inverse permutation element you want to know the "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":"-sum for. After that print a line break and make "},{"children":[{"kind":"text","text":"flush"}],"kind":"container"},{"kind":"text","text":" operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After printing the query your program should read single integer — the value of "},{"attrs":{"alt":"","src":"/statement-assets/3cbcc9e794199c97c322f10b0913b628e1566fedfc6e59c40d3fdc21ffa972e9.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a permutation of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" your program should make no more than "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" queries about "},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":"-sum. Note that printing answer doesn't count as a query. Note that you can't ask more than "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" questions. If you ask more than "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" questions or at least one incorrect question, your solution will get \""},{"children":[{"kind":"text","text":"Wrong answer"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If at some moment your program reads "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" as an answer, it should immediately exit (for example, by calling "},{"children":[{"kind":"text","text":"exit(0)"}],"kind":"container"},{"kind":"text","text":"). You will get \""},{"children":[{"kind":"text","text":"Wrong answer"}],"kind":"container"},{"kind":"text","text":"\" in this case, it means that you asked more than "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" questions, or asked an invalid question. If you ignore this, you can get other verdicts since your program will continue to read from a closed stream."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your solution will get \""},{"children":[{"kind":"text","text":"Idleness Limit Exceeded"}],"kind":"container"},{"kind":"text","text":"\", if you don't print anything or forget to flush the output, including for the final answer ."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To flush you can use (just after printing line break): "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"fflush(stdout)"}],"kind":"container"},{"kind":"text","text":" in C++; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"System.out.flush()"}],"kind":"container"},{"kind":"text","text":" in Java; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"stdout.flush()"}],"kind":"container"},{"kind":"text","text":" in Python; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"flush(output)"}],"kind":"container"},{"kind":"text","text":" in Pascal; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For other languages see the documentation. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"Hacking"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For hacking use the following format:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"n"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"p0"},{"kind":"math_inline","text":"p1"},{"kind":"text","text":" ... "},{"kind":"math_inline","text":"pn - 1"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Contestant programs will not be able to see this input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n0\n0\n3\n2\n3\n2"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"? 0 0\n? 1 1\n? 1 2\n? 0 2\n? 2 1\n? 2 0\n!\n1\n0 1 2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2\n3\n2\n0\n2\n3\n2\n0"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"? 0 1\n? 1 2\n? 2 3\n? 3 3\n? 3 2\n? 2 1\n? 1 0\n? 0 0\n!\n2\n3 1 2 0"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":" operation, or bitwise exclusive OR, is an operation performed over two integers, in which the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th digit in binary representation of the result is equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" if and only if exactly one of the two integers has the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th digit in binary representation equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". For more information, see "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"here"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first example "},{"kind":"math_inline","text":"p = [0, 1, 2]"},{"kind":"text","text":", thus "},{"kind":"math_inline","text":"b = [0, 1, 2]"},{"kind":"text","text":", the values "},{"attrs":{"alt":"","src":"/statement-assets/3cbcc9e794199c97c322f10b0913b628e1566fedfc6e59c40d3fdc21ffa972e9.png"},"kind":"image"},{"kind":"text","text":" are correct for the given "},{"kind":"math_inline","text":"i, j"},{"kind":"text","text":". There are no other permutations that give the same answers for the given queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answers for the queries are: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"alt":"","src":"/statement-assets/b1a63fdd728456567b7eb2ff4f953a9b328133146ca93f06d860da6b6add598f.png"},"kind":"image"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/49d0f6537bb8c14ea2d467866facfdc7d77debb385f578362490ecaf0dba8268.png"},"kind":"image"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6dfa3509feb8bd851feb43cfb4713389b980973b973ed01e2d8fc32f38982202.png"},"kind":"image"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/87fb632f4a788b2493932d6b15dd988dfb0a83a06b4cb624d3719602f47d849e.png"},"kind":"image"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9d5f3a223914dd237deedb38ed3d8cd5a80bd3a7344068be6abbd91de6755189.png"},"kind":"image"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5f7d93e25b3386ee959fd17341ac826cddfcb60ab968e2c002e5da2762a282d5.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second example "},{"kind":"math_inline","text":"p = [3, 1, 2, 0]"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"b = [3, 1, 2, 0]"},{"kind":"text","text":", the values "},{"attrs":{"alt":"","src":"/statement-assets/3cbcc9e794199c97c322f10b0913b628e1566fedfc6e59c40d3fdc21ffa972e9.png"},"kind":"image"},{"kind":"text","text":" match for all pairs "},{"kind":"math_inline","text":"i, j"},{"kind":"text","text":". But there is one more suitable permutation "},{"kind":"math_inline","text":"p = [0, 2, 1, 3]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b = [0, 2, 1, 3]"},{"kind":"text","text":" that matches all "},{"kind":"math_inline","text":"n2"},{"kind":"text","text":" possible queries as well. All other permutations do not match even the shown queries."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"870D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/870/problem/D"}