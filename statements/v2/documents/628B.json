{"assets":[],"contentKind":"statement","contestId":"628","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. New Skateboard"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Max wants to buy a new skateboard. He has calculated the amount of money that is needed to buy a new skateboard. He left a calculator on the floor and went to ask some money from his parents. Meanwhile his little brother Yusuf came and started to press the keys randomly. Unfortunately Max has forgotten the number which he had calculated. The only thing he knows is that the number is divisible by "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of digits (the number on the display of the calculator after Yusuf randomly pressed the keys). Your task is to find the number of substrings which are divisible by "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". A substring can start with a zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A substring of a string is a nonempty sequence of consecutive characters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example if string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"124"}],"kind":"container"},{"kind":"text","text":" then we have four substrings that are divisible by "},{"kind":"math_inline","text":"4"},{"kind":"text","text":": "},{"children":[{"kind":"text","text":"12"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"24"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"124"}],"kind":"container"},{"kind":"text","text":". For the string "},{"children":[{"kind":"text","text":"04"}],"kind":"container"},{"kind":"text","text":" the answer is three: "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"04"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As input/output can reach huge size it is recommended to use fast input/output methods: for example, prefer to use "},{"children":[{"kind":"text","text":"gets/scanf/printf"}],"kind":"container"},{"kind":"text","text":" instead of "},{"children":[{"kind":"text","text":"getline/cin/cout"}],"kind":"container"},{"kind":"text","text":" in C++, prefer to use "},{"children":[{"kind":"text","text":"BufferedReader/PrintWriter"}],"kind":"container"},{"kind":"text","text":" instead of "},{"children":[{"kind":"text","text":"Scanner/System.out"}],"kind":"container"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"Java"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 3·105"},{"kind":"text","text":"). The string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" contains only digits from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"9"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print integer "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" — the number of substrings of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" that are divisible by "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the answer can be huge, so you should use "},{"kind":"math_inline","text":"64"},{"kind":"text","text":"-bit integer type to store it. In "},{"children":[{"kind":"text","text":"C++"}],"kind":"container"},{"kind":"text","text":" you can use the "},{"children":[{"kind":"text","text":"long long"}],"kind":"container"},{"kind":"text","text":" integer type and in "},{"children":[{"kind":"text","text":"Java"}],"kind":"container"},{"kind":"text","text":" you can use "},{"children":[{"kind":"text","text":"long"}],"kind":"container"},{"kind":"text","text":" integer type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"124\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":