{"assets":["/statement-assets/e1545e2b59c4f4d0cc1dc3335826c8a8659bcea03dbdc02035c96730e1445107.png"],"contentKind":"statement","contestId":"741","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Arpa’s letter-marked tree and Mehrdad’s Dokhtar-kosh paths"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Just in case somebody missed it: we have wonderful girls in Arpa’s land."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Arpa has a rooted tree (connected acyclic graph) consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. The vertices are numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", the vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is the root. There is a letter written on each edge of this tree. Mehrdad is a fan of "},{"children":[{"kind":"text","text":"Dokhtar-kosh"}],"kind":"container"},{"kind":"text","text":" things. He call a string Dokhtar-kosh, if we can shuffle the characters in string such that it becomes palindrome."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e1545e2b59c4f4d0cc1dc3335826c8a8659bcea03dbdc02035c96730e1445107.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"He asks Arpa, for each vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", what is the length of the longest simple path in subtree of "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" that form a Dokhtar-kosh string."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤  n  ≤  5·105"},{"kind":"text","text":") — the number of vertices in the tree."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"(n  -  1)"},{"kind":"text","text":" lines follow, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contain an integer "},{"kind":"math_inline","text":"pi + 1"},{"kind":"text","text":" and a letter "},{"kind":"math_inline","text":"ci + 1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤  pi + 1  ≤  i"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ci + 1"},{"kind":"text","text":" is lowercase English letter, between "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"v"}],"kind":"container"},{"kind":"text","text":", inclusively), that mean that there is an edge between nodes "},{"kind":"math_inline","text":"pi + 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" and there is a letter "},{"kind":"math_inline","text":"ci + 1"},{"kind":"text","text":" written on this edge."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should be the length of the longest simple path in subtree of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex that form a Dokhtar-kosh string."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 s\n2 a\n3 s\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 1 1 0 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 a\n2 h\n1 a\n4 h\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 1 0 1 0 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"741D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/741/problem/D"}