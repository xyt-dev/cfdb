{"assets":[],"contentKind":"statement","contestId":"430","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Points and Segments (easy)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Iahub isn't well prepared on geometry problems, but he heard that this year there will be a lot of geometry problems on the IOI selection camp. Scared, Iahub locked himself in the basement and started thinking of new problems of this kind. One of them is the following."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Iahub wants to draw "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct points and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" segments on the "},{"kind":"math_inline","text":"OX"},{"kind":"text","text":" axis. He can draw each point with either red or blue. The drawing is good if and only if the following requirement is met: for each segment "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":" consider all the red points belong to it ("},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" points), and all the blue points belong to it ("},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" points); each segment "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" should satisfy the inequality "},{"kind":"math_inline","text":"|ri - bi| ≤ 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Iahub thinks that point "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" belongs to segment "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":", if inequality "},{"kind":"math_inline","text":"l ≤ x ≤ r"},{"kind":"text","text":" holds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Iahub gives to you all coordinates of points and segments. Please, help him to find any good drawing."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 100"},{"kind":"text","text":"). The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ xi ≤ 100"},{"kind":"text","text":") — the coordinates of the points. The following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the descriptions of the "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" segments. Each line contains two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ li ≤ ri ≤ 100"},{"kind":"text","text":") — the borders of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that all the points are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no good drawing for a given test, output a single integer -1. Otherwise output "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, each integer must be 0 or 1. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number denotes the color of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th point (0 is red, and 1 is blue)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple good drawings you can output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n3 7 14\n1 5\n6 10\n11 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 0 0"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n1 2 3\n1 2\n2 3\n5 6\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 0 1 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"430A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/430/problem/A"}