{"assets":["/statement-assets/433ee263650f25f7229da0c4cd56bc2df6d63ef139a943e71c171ffd0f20614c.png","/statement-assets/f634756d28d0494e820e2adc9f304bc8d28891d815a55c0615b1e8daabdeaa89.png"],"contentKind":"statement","contestId":"1510","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Hard Optimization"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a set of $$$n$$$ segments on a line $$$[L_i; R_i]$$$. All $$$2n$$$ segment endpoints are pairwise distinct integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The set is "},{"children":[{"kind":"text","text":"laminar"}],"kind":"container"},{"kind":"text","text":" — any two segments are either disjoint or one of them contains the other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Choose a non-empty subsegment $$$[l_i, r_i]$$$ with integer endpoints in each segment ($$$L_i \\le l_i \\lt r_i \\le R_i$$$) in such a way that no two subsegments intersect (they are allowed to have common endpoints though) and the sum of their lengths ($$$\\sum_{i=1}^n r_i - l_i$$$) is maximized."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^3$$$) — the number of segments."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the next $$$n$$$ lines contains two integers $$$L_i$$$ and $$$R_i$$$ ($$$0 \\le L_i \\lt R_i \\le 10^9$$$) — the endpoints of the $$$i$$$-th segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the given $$$2n$$$ segment endpoints are distinct. The set of segments is laminar."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first line, output the maximum possible sum of subsegment lengths."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the $$$i$$$-th of the next $$$n$$$ lines, output two integers $$$l_i$$$ and $$$r_i$$$ ($$$L_i \\le l_i \\lt r_i \\le R_i$$$), denoting the chosen subsegment of the $$$i$$$-th segment."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 10\n2 3\n5 9\n6 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n3 6\n2 3\n7 9\n6 7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The example input and the example output are illustrated below. "},{"attrs":{"alt":"","src":"/statement-assets/433ee263650f25f7229da0c4cd56bc2df6d63ef139a943e71c171ffd0f20614c.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/f634756d28d0494e820e2adc9f304bc8d28891d815a55c0615b1e8daabdeaa89.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"1510H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1510/problem/H"}