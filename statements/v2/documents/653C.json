xt","text":"Bear Limak has a sequence of positive integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":". This sequence "},{"children":[{"kind":"text","text":"is not nice"}],"kind":"container"},{"kind":"text","text":" now and Limak wants to fix it by a single swap. He is going to choose two indices "},{"kind":"math_inline","text":"i < j"},{"kind":"text","text":" and swap elements "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":" in order to get a nice sequence. Count the number of ways to do so. Two ways are considered different if indices of elements chosen for a swap are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 150 000"},{"kind":"text","text":") — the length of the sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 150 000"},{"kind":"text","text":") — the initial sequence. It's guaranteed that the given sequence is not nice."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of ways to swap two elements exactly once in order to get a nice sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"ro