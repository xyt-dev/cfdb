{"assets":[],"contentKind":"statement","contestId":"873","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Awards For Contestants"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Alexey recently held a programming contest for students from Berland. "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students participated in a contest, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them solved "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" problems. Now he wants to award some contestants. Alexey can award the students with diplomas of three different degrees. Each student either will receive one diploma of some degree, or won't receive any diplomas at all. Let "},{"kind":"math_inline","text":"cntx"},{"kind":"text","text":" be the number of students that are awarded with diplomas of degree "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ 3"},{"kind":"text","text":"). The following conditions must hold:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" For each "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ 3"},{"kind":"text","text":") "},{"kind":"math_inline","text":"cntx > 0"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For any two degrees "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"k