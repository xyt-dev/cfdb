"text":"d1 - c2"},{"kind":"text","text":" is maximum possible; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Among all ways that maximize the previous expression, "},{"kind":"math_inline","text":"d2 - c3"},{"kind":"text","text":" is maximum possible; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Among all ways that correspond to the two previous conditions, "},{"kind":"math_inline","text":"d3 - c - 1"},{"kind":"text","text":" is maximum possible, where "},{"kind":"math_inline","text":"c - 1"},{"kind":"text","text":" is the maximum number of problems solved by a student that doesn't receive any diploma (or "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" if each student is awarded with some diploma). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Alexey to find a way to award the contestants!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 3000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 5000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number must be equal to the degree of diploma "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th contestant will receive (or "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":" if he doesn't receive any diploma)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple optimal solutions, print any of them. It is guaranteed that the answer always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 3 2 1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 4 3 1 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1 1 2 -1 -1 3 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"873E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/873/problem/E"}