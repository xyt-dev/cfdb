{"assets":[],"contentKind":"statement","contestId":"161","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Distance in Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"tree"}],"kind":"container"},{"kind":"text","text":" is a connected graph that doesn't contain any cycles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"distance"}],"kind":"container"},{"kind":"text","text":" between two vertices of a tree is the length (in edges) of the shortest path between these vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and a positive number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Find the number of distinct pairs of the vertices which have a distance of exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" between them. Note that pairs ("},{"kind":"math_inline","text":"v"},{"kind":"text","text":", "},{"kind":"math_inline","text":"u"},{"kind":"text","text":") and ("},{"kind":"math_inline","text":"u"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v"},{"kind":"text","text":") are considered to be the same pair."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 500"},{"kind":"text","text":") — the number of vertices and the required distance between the vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines describe the edges as \""},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"bi"},{"kind":"text","text":"\" (without the quotes) ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" are the vertices connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge. All given edges are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of distinct pairs of the tree's vertices which have a distance of exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" between them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n1 2\n2 3\n3 4\n2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n1 2\n2 3\n3 4\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the pairs of vertexes at distance 2 from each other are (1, 3), (1, 5), (3, 5) and (2, 4)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"161D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/161/problem/D"}