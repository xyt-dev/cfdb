{"assets":[],"contentKind":"statement","contestId":"739","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Alyona and towers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Alyona has built "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" towers by putting small cubes some on the top of others. Each cube has size "},{"kind":"math_inline","text":"1 × 1 × 1"},{"kind":"text","text":". A tower is a non-zero amount of cubes standing on the top of each other. The towers are next to each other, forming a row."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sometimes Alyona chooses some segment towers, and put on the top of each tower several cubes. Formally, Alyouna chooses some segment of towers from "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and adds "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" cubes on the top of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let the sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" be the heights of the towers from left to right. Let's call as a segment of towers "},{"kind":"math_inline","text":"al, al + 1, ..., ar"},{"kind":"text","text":" a hill if the following condition holds: there is integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"l ≤ k ≤ r"},{"kind":"text","text":") such that "},{"kind":"math_inline","text":"al < al + 1 < al + 2 < ... < ak > ak + 1 > ak + 2 > ... > ar"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After each addition of "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" cubes on the top of the towers from "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", Alyona wants to know the maximum width among all hills. The width of a hill is the number of towers in it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contain single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 3·105"},{"kind":"text","text":") — the number of towers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — the number of cubes in each tower. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contain single integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 3·105"},{"kind":"text","text":") — the number of additions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" integers each. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ di ≤ 109"},{"kind":"text","text":"), that mean that Alyona puts "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" cubes on the tio of each of the towers from "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines. In "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print the maximum width of the hills after the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th addition."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n5 5 5 5 5\n3\n1 3 2\n2 2 1\n4 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n4\n5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first sample is as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After addition of "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" cubes on the top of each towers from the first to the third, the number of cubes in the towers become equal to "},{"kind":"math_inline","text":"[7, 7, 7, 5, 5]"},{"kind":"text","text":". The hill with maximum width is "},{"kind":"math_inline","text":"[7, 5]"},{"kind":"text","text":", thus the maximum width is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After addition of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" cube on the second tower, the number of cubes in the towers become equal to "},{"kind":"math_inline","text":"[7, 8, 7, 5, 5]"},{"kind":"text","text":". The hill with maximum width is now "},{"kind":"math_inline","text":"[7, 8, 7, 5]"},{"kind":"text","text":", thus the maximum width is "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After addition of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" cube on the fourth tower, the number of cubes in the towers become equal to "},{"kind":"math_inline","text":"[7, 8, 7, 6, 5]"},{"kind":"text","text":". The hill with maximum width is now "},{"kind":"math_inline","text":"[7, 8, 7, 6, 5]"},{"kind":"text","text":", thus the maximum width is "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"739C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/739/problem/C"}