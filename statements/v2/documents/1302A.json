{"assets":[],"contentKind":"statement","contestId":"1302","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Nash equilibrium"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is an unusual problem in an unusual contest, here is the announcement: "},{"attrs":{"href":"https://codeforces.com/blog/entry/73543"},"children":[{"kind":"text","text":"http://codeforces.com/blog/entry/73543"}],"kind":"link"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a table $$$A$$$ of integers $$$n \\times m$$$. The cell $$$(x, y)$$$ is called "},{"children":[{"kind":"text","text":"Nash equilibrium"}],"kind":"container"},{"kind":"text","text":" if both of the following conditions hold: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" for each $$$x_1 \\neq x$$$ $$$A_{xy} \\gt A_{x_1y}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for each $$$y_1 \\neq y$$$ $$$A_{xy} \\lt A_{xy_1}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Find a Nash equilibrium in $$$A$$$. If there exist several equilibria, print the one with minimum $$$x$$$. If still there are several possible answers, print the one with minimum $$$y$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text