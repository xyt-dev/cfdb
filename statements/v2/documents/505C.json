{"assets":[],"contentKind":"statement","contestId":"505","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Mr. Kitayuta, the Treasure Hunter"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Shuseki Islands are an archipelago of "},{"kind":"math_inline","text":"30001"},{"kind":"text","text":" small islands in the Yutampo Sea. The islands are evenly spaced along a line, numbered from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"30000"},{"kind":"text","text":" from the west to the east. These islands are known to contain many treasures. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" gems in the Shuseki Islands in total, and the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th gem is located on island "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mr. Kitayuta has just arrived at island "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". With his great jumping ability, he will repeatedly perform jumps between islands to the east according to the following process: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" First, he will jump from island "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to island "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After that, he will continue jumping according to the following rule. Let "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" be the length of the previous jump, that is, if his previous jump was from island "},{"kind":"math_inline","text":"prev"},{"kind":"text","text":" to island "},{"kind":"math_inline","text":"cur"},{"kind":"text","text":", let "},{"kind":"math_inline","text":"l = cur - prev"},{"kind":"text","text":". He will perform a jump of length "},{"kind":"math_inline","text":"l - 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"l + 1"},{"kind":"text","text":" to the east. That is, he will jump to island "},{"kind":"math_inline","text":"(cur + l - 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(cur + l)"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"(cur + l + 1)"},{"kind":"text","text":" (if they exist). The length of a jump must be positive, that is, he cannot perform a jump of length "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" when "},{"kind":"math_inline","text":"l = 1"},{"kind":"text","text":". If there is no valid destination, he will stop jumping. "}],"kind":"list_item"}],"kind":"list"},{"kind":"paragraph"},{"children":[{"kind":"text","text":"Mr. Kitayuta will collect the gems on the islands visited during the process. Find the maximum number of gems that he can collect."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom"},"kind":"section"},{"attrs":{"role":"custom"},"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of the input contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, d ≤ 30000"},{"kind":"text","text":"), denoting the number of the gems in the Shuseki Islands and the length of the Mr. Kitayuta's first jump, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines describe the location of the gems. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") contains a integer "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"d ≤ p1 ≤ p2 ≤ ... ≤ pn ≤ 30000"},{"kind":"text","text":"), denoting the number of the island that contains the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th gem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom"},"kind":"section"},{"attrs":{"role":"custom"},"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"paragraph"},{"children":[{"kind":"text","text":"Print the maximum number of gems that Mr. Kitayuta can collect."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom"},"kind":"section"},{"attrs":{"role":"custom"},"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"kind":"paragraph"},{"kind":"paragraph"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 10\n10\n21\n27\n27\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 8\n9\n19\n28\n36\n45\n55\n66\n78\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"13 7\n8\n8\n9\n16\n17\n17\n18\n21\n23\n24\n24\n26\n30\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"custom"},"kind":"section"},{"attrs":{"role":"custom"},"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample, the optimal route is 0 "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 10 (+1 gem) "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 19 "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 27 (+2 gems) "},{"kind":"math_inline","text":" → ..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the optimal route is 0 "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 8 "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 15 "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 21"},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 28 (+1 gem) "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 36 (+1 gem) "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 45 (+1 gem) "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 55 (+1 gem) "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 66 (+1 gem) "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 78 (+1 gem) "},{"kind":"math_inline","text":" → ..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, the optimal route is 0 "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 7 "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 13 "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 18 (+1 gem) "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 24 (+2 gems) "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" 30 (+1 gem) "},{"kind":"math_inline","text":" → ..."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"505C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/505/problem/C"}