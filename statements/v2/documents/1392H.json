{"assets":[],"contentKind":"statement","contestId":"1392","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. ZS Shuffles Cards"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"zscoder"}],"kind":"container"},{"kind":"text","text":" has a deck of $$$n+m$$$ custom-made cards, which consists of $$$n$$$ cards labelled from $$$1$$$ to $$$n$$$ and $$$m$$$ jokers. Since "},{"children":[{"kind":"text","text":"zscoder"}],"kind":"container"},{"kind":"text","text":" is lonely, he wants to play a game with himself using those cards. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially, the deck is shuffled uniformly randomly and placed on the table. "},{"children":[{"kind":"text","text":"zscoder"}],"kind":"container"},{"kind":"text","text":" has a set $$$S$$$ which is initially empty. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Every second, "},{"children":[{"kind":"text","text":"zscoder"}],"kind":"container"},{"kind":"text","text":" draws the top card from the deck. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If the card has a number $$$x$$$ written on it, "},{"children":[{"kind":"text","text":"zscoder"}],"kind":"container"},{"kind":"text","text":" removes the card and adds $$$x$$$ to the set $$$S$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the card drawn is a joker, "},{"children":[{"kind":"text","text":"zscoder"}],"kind":"container"},{"kind":"text","text":" places all the cards back into the deck and reshuffles (uniformly randomly) the $$$n+m$$$ cards to form a new deck (hence the new deck now contains all cards from $$$1$$$ to $$$n$$$ and the $$$m$$$ jokers). Then, if $$$S$$$ currently contains all the elements from $$$1$$$ to $$$n$$$, the game ends. Shuffling the deck doesn't take time at all. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"What is the expected number of seconds before the game ends? We can show that the answer can be written in the form $$$\\frac{P}{Q}$$$ where $$$P, Q$$$ are relatively prime integers and $$$Q \\neq 0 \\bmod 998244353$$$. Output the value of $$$(P \\cdot Q^{-1})$$$ modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\le n, m \\le 2 \\cdot 10^{6}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer, the value of $$$(P \\cdot Q^{-1})$$$ modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n332748127\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n14 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n969862773\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample, it can be proven that the expected time before the game ends is $$$5$$$ seconds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second sample, it can be proven that the expected time before the game ends is $$$\\frac{28}{3}$$$ seconds."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"1392H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1392/problem/H"}