{"assets":[],"contentKind":"statement","contestId":"345","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Chain Letter"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A chain letter is a kind of a message which urges the recipient to forward it to as many contacts as possible, usually with some kind of mystic explanation. Of course, this is only a superstition, and you don't believe in it, but all your friends do. You know that today there will be one of these letters going around, and you want to know how many times you'll receive it — of course, not that you'll be sending it yourself!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array of strings "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" elements which describes the contacts between you and "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" of your friends: "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th character of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th string ("},{"kind":"math_inline","text":"f"},{"kind":"text","text":"["},{"kind":"math_inline","text":"i"},{"kind":"text","text":"]["},{"kind":"math_inline","text":"j"},{"kind":"text","text":"]) is \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" if people "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" will send messages to each other, and \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" otherwise. Person 1 starts sending the letter to all his contacts; every person who receives the letter for the first time sends it to all his contacts. You are person "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", and you don't forward the letter when you receive it. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Calculate the number of copies of this letter you'll receive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(2 ≤ n ≤ 50)"},{"kind":"text","text":" — the number of people involved. Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" following lines contain elements of "},{"kind":"math_inline","text":"f"},{"kind":"text","text":", strings of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Each character in "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" is either \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\". It's guaranteed that two following equations hold: "},{"kind":"math_inline","text":"f"},{"kind":"text","text":"["},{"kind":"math_inline","text":"i"},{"kind":"text","text":"]["},{"kind":"math_inline","text":"j"},{"kind":"text","text":"] = "},{"kind":"math_inline","text":"f"},{"kind":"text","text":"["},{"kind":"math_inline","text":"j"},{"kind":"text","text":"]["},{"kind":"math_inline","text":"i"},{"kind":"text","text":"], "},{"kind":"math_inline","text":"f"},{"kind":"text","text":"["},{"kind":"math_inline","text":"i"},{"kind":"text","text":"]["},{"kind":"math_inline","text":"i"},{"kind":"text","text":"] = 0, for all "},{"kind":"math_inline","text":"i, j"},{"kind":"math_inline","text":"(1 ≤ i, j ≤ n)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the number of copies of the letter you will receive eventually."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0111\n1011\n1101\n1110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0110\n1010\n1100\n0000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0101\n1001\n0001\n1110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first case, everybody sends letters to everyone, so you get copies from all three of your friends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second case, you don't know any of these people, so they don't bother you with their superstitious stuff."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third case, two of your friends send you copies of the letter but the third friend doesn't know them so he is unaffected."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"345D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/345/problem/D"}