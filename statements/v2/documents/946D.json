{"assets":[],"contentKind":"statement","contestId":"946","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Timetable"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ivan is a student at Berland State University (BSU). There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days in Berland week, and each of these days Ivan might have some classes at the university."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" working hours during each Berland day, and each lesson at the university lasts exactly one hour. If at some day Ivan's first lesson is during "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th hour, and last lesson is during "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th hour, then he spends "},{"kind":"math_inline","text":"j - i + 1"},{"kind":"text","text":" hours in the university during this day. If there are no lessons during some day, then Ivan stays at home and therefore spends "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" hours in the university."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ivan doesn't like to spend a lot of time in the university, so he has decided to skip some lessons. He cannot skip more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lessons during the week. After deciding which lessons he should skip and which he should attend, every day Ivan will enter the university right before the start of the first lesson he does not skip, and leave it after the end of the last lesson he decides to attend. If Ivan skips all lessons during some day, he doesn't go to the university that day at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and Ivan's timetable, can you determine the minimum number of hours he has to spend in the university during one week, if he cannot skip more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lessons?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 500"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ 500"},{"kind":"text","text":") — the number of days in the Berland week, the number of working hours during each day, and the number of lessons Ivan can skip, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line containing a binary string of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters. If "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th character in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line is "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", then Ivan has a lesson on "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day during "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th hour (if it is "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", there is no such lesson)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of hours Ivan has to spend in the university during the week if he skips not more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lessons."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 5 1\n01001\n10110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 5 0\n01001\n10110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Ivan can skip any of two lessons during the first day, so he spends "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" hour during the first day and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" hours during the second day."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example Ivan can't skip any lessons, so he spends "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" hours every day."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"946D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/946/problem/D"}