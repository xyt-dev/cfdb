{"assets":[],"contentKind":"statement","contestId":"255","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Code Parsing"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Vitaly loves different algorithms. Today he has invented a new algorithm just for you. Vitaly's algorithm works with string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of characters \""},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":"\", and uses two following operations at runtime:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Find two consecutive characters in the string, such that the first of them equals \""},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":"\", and the second one equals \""},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":"\" and swap them. If there are several suitable pairs of characters, we choose the pair of characters that is located closer to the beginning of the string. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Find in the string two consecutive characters, such that the first of them equals \""},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":"\" and the second one equals \""},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":"\". Remove these characters from the string. If there are several suitable pairs of characters, we choose the pair of characters that is located closer to the beginning of the string. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The input for the new algorithm is string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", and the algorithm works as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" If you can apply at least one of the described operations to the string, go to step 2 of the algorithm. Otherwise, stop executing the algorithm and print the current string. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If you can apply operation 1, then apply it. Otherwise, apply operation 2. After you apply the operation, go to step 1 of the algorithm. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Now Vitaly wonders, what is going to be printed as the result of the algorithm's work, if the input receives string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a non-empty string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the string only consists of characters \""},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":"\". It is guaranteed that the string consists of at most "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" characters. It is guaranteed that as the result of the algorithm's execution won't be an empty string."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line print the string that is printed as the result of the algorithm's work, if the input of the algorithm input receives string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"x\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"x\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"yxyxy\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"y\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"xxxxxy\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"xxxx\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test the algorithm will end after the first step of the algorithm, as it is impossible to apply any operation. Thus, the string won't change."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test the transformation will be like this:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" string \""},{"children":[{"kind":"text","text":"yxyxy"}],"kind":"container"},{"kind":"text","text":"\" transforms into string \""},{"children":[{"kind":"text","text":"xyyxy"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" string \""},{"children":[{"kind":"text","text":"xyyxy"}],"kind":"container"},{"kind":"text","text":"\" transforms into string \""},{"children":[{"kind":"text","text":"xyxyy"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" string \""},{"children":[{"kind":"text","text":"xyxyy"}],"kind":"container"},{"kind":"text","text":"\" transforms into string \""},{"children":[{"kind":"text","text":"xxyyy"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" string \""},{"children":[{"kind":"text","text":"xxyyy"}],"kind":"container"},{"kind":"text","text":"\" transforms into string \""},{"children":[{"kind":"text","text":"xyy"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" string \""},{"children":[{"kind":"text","text":"xyy"}],"kind":"container"},{"kind":"text","text":"\" transforms into string \""},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"As a result, we've got string \""},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case only one transformation will take place: string \""},{"children":[{"kind":"text","text":"xxxxxy"}],"kind":"container"},{"kind":"text","text":"\" transforms into string \""},{"children":[{"kind":"text","text":"xxxx"}],"kind":"container"},{"kind":"text","text":"\". Thus, the answer will be string \""},{"children":[{"kind":"text","text":"xxxx"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"255B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/255/problem/B"}