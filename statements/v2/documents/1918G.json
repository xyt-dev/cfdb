{"assets":[],"contentKind":"statement","contestId":"1918","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Permutation of Given"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You were given only one number, $$$n$$$. It didn't seem interesting to you, so you wondered if it's possible to come up with an array of length $$$n$$$ consisting of non-zero integers, such that if each element of the array is replaced by the sum of its neighbors (the elements on the ends are replaced by their only neighbors), you obtain a permutation of the numbers in the original array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test case contains only one number, $$$n$$$ ($$$2 \\leq n \\leq 10^6$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If a solution exists, output "},{"children":[{"kind":"text","text":"\"YES\""}],"kind":"container"},{"kind":"text","text":" (without quotes), followed by an array $$$a$$$ ($$$-10^9 \\leq a_i \\leq 10^9, a_i \\neq 0$$$) that satisfies the condition of the problem. If there are multiple possible answers, output any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is no suitable array, output "},{"children":[{"kind":"text","text":"\"NO\""}],"kind":"container"},{"kind":"text","text":" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The words "},{"children":[{"kind":"text","text":"\"YES\""}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"\"NO\""}],"kind":"container"},{"kind":"text","text":" can be output in any case, for example, "},{"children":[{"kind":"text","text":"\"YES\""}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"\"Yes\""}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"\"yEs\""}],"kind":"container"},{"kind":"text","text":", and so on."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n1 2 -2 -1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test, the array [$$$1, 2, -2, -1$$$] is suitable, because if each element is replaced by the sum of its neighbors, the resulting array is [$$$2, -1, 1, -2$$$], which is a permutation of the original array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test, it can be shown that there is no solution."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1918G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1918/problem/G"}