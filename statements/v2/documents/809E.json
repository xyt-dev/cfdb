{"assets":["/statement-assets/6b9879b708dee83d6e21755d823e2b71ea18ff41e7f2d611027b4fea4923d607.png","/statement-assets/96a0a2de23e8ee53a96efb768842349e63344262f555b4fabd96d06d85ab1e0a.png","/statement-assets/dc6732cc9c8a0df1dace86cce2d42f10726409685f91638bc32442daa99cb2e2.png","/statement-assets/26dc3ed08e453787872ee49085307f52da539629533a0c6dde6c30b65050f35a.png","/statement-assets/62476ecca5b340f82cd64571f87cbbeae075c82442a0cd6a6bc0362b16aa340e.png"],"contentKind":"statement","contestId":"809","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Surprise me!"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"8 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Tired of boring dates, Leha and Noora decided to play a game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Leha found a tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". We remind you that tree is an undirected graph without cycles. Each vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" of a tree has a number "},{"kind":"math_inline","text":"av"},{"kind":"text","text":" written on it. Quite by accident it turned out that all values written on vertices are distinct and are natural numbers between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The game goes in the following way. Noora chooses some vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" of a tree uniformly at random and passes a move to Leha. Leha, in his turn, chooses (also uniformly at random) some vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" from remaining vertices of a tree "},{"kind":"math_inline","text":"(v ≠ u)"},{"kind":"text","text":". As you could guess there are "},{"kind":"math_inline","text":"n(n - 1)"},{"kind":"text","text":" variants of choosing vertices by players. After that players calculate the value of a function "},{"kind":"math_inline","text":"f(u, v) = φ(au·av)"},{"kind":"math_inline","text":"·"},{"kind":"math_inline","text":"d(u, v)"},{"kind":"text","text":" of the chosen vertices where "},{"kind":"math_inline","text":"φ(x)"},{"kind":"text","text":" is Euler's totient function and "},{"kind":"math_inline","text":"d(x, y)"},{"kind":"text","text":" is the shortest distance between vertices "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" in a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Soon the game became boring for Noora, so Leha decided to defuse the situation and calculate expected value of function "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" over all variants of choosing vertices "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", hoping of at least somehow surprise the girl."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Leha asks for your help in calculating this expected value. Let this value be representable in the form of an irreducible fraction "},{"attrs":{"alt":"","src":"/statement-assets/6b9879b708dee83d6e21755d823e2b71ea18ff41e7f2d611027b4fea4923d607.png"},"kind":"image"},{"kind":"text","text":". To further surprise Noora, he wants to name her the value "},{"attrs":{"alt":"","src":"/statement-assets/96a0a2de23e8ee53a96efb768842349e63344262f555b4fabd96d06d85ab1e0a.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Leha!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains one integer number "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(2 ≤ n ≤ 2·105)"},{"kind":"text","text":"  — number of vertices in a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different numbers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(1 ≤ ai ≤ n)"},{"kind":"text","text":" separated by spaces, denoting the values written on a tree vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains two integer numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"math_inline","text":"(1 ≤ x, y ≤ n)"},{"kind":"text","text":", describing the next edge of a tree. It is guaranteed that this set of edges describes a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print a number equal to "},{"kind":"math_inline","text":"P·Q - 1"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"333333338\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n5 4 3 1 2\n3 5\n1 2\n4 3\n2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Euler's totient function "},{"kind":"math_inline","text":"φ(n)"},{"kind":"text","text":" is the number of such "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" that "},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":",and "},{"kind":"math_inline","text":"gcd(i, n) = 1"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"gcd(x, y)"},{"kind":"text","text":" is the greatest common divisor of numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" variants of choosing vertices by Leha and Noora in the first testcase:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"u = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f(1, 2) = φ(a1·a2)·d(1, 2) = φ(1·2)·1 = φ(2) = 1"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"u = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f(2, 1) = f(1, 2) = 1"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"u = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v = 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f(1, 3) = φ(a1·a3)·d(1, 3) = φ(1·3)·2 = 2φ(3) = 4"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"u = 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f(3, 1) = f(1, 3) = 4"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"u = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v = 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f(2, 3) = φ(a2·a3)·d(2, 3) = φ(2·3)·1 = φ(6) = 2"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"u = 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f(3, 2) = f(2, 3) = 2"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Expected value equals to "},{"attrs":{"alt":"","src":"/statement-assets/dc6732cc9c8a0df1dace86cce2d42f10726409685f91638bc32442daa99cb2e2.png"},"kind":"image"},{"kind":"text","text":". The value Leha wants to name Noora is "},{"kind":"math_inline","text":"7·3 - 1 = 7·333333336 = 333333338"},{"attrs":{"alt":"","src":"/statement-assets/26dc3ed08e453787872ee49085307f52da539629533a0c6dde6c30b65050f35a.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second testcase expected value equals to "},{"attrs":{"alt":"","src":"/statement-assets/62476ecca5b340f82cd64571f87cbbeae075c82442a0cd6a6bc0362b16aa340e.png"},"kind":"image"},{"kind":"text","text":", so Leha will have to surprise Hoora by number "},{"kind":"math_inline","text":"8·1 - 1 = 8"},{"attrs":{"alt":"","src":"/statement-assets/26dc3ed08e453787872ee49085307f52da539629533a0c6dde6c30b65050f35a.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"809E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/809/problem/E"}