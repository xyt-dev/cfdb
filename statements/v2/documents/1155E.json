{"assets":[],"contentKind":"statement","contestId":"1155","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Guess the Root"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Jury picked a polynomial $$$f(x) = a_0 + a_1 \\cdot x + a_2 \\cdot x^2 + \\dots + a_k \\cdot x^k$$$. $$$k \\le 10$$$ and all $$$a_i$$$ are integer numbers and $$$0 \\le a_i \\lt 10^6 + 3$$$. It's guaranteed that there is at least one $$$i$$$ such that $$$a_i \\gt 0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now jury wants you to find such an integer $$$x_0$$$ that $$$f(x_0) \\equiv 0 \\mod (10^6 + 3)$$$ or report that there is not such $$$x_0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can ask no more than $$$50$$$ queries: you ask value $$$x_q$$$ and jury tells you value $$$f(x_q) \\mod (10^6 + 3)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that printing the answer doesn't count as a query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom","title":"Interaction"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Interaction"}],"kind":"heading"},{"children":[{"kind":"text","text":"To ask a question, print \""},{"children":[{"kind":"text","text":"? $$$x_q$$$"}],"kind":"container"},{"kind":"text","text":"\" $$$(0 \\le x_q \\lt 10^6 + 3)$$$. The judge will respond with a single integer $$$f(x_q) \\mod (10^6 + 3)$$$. If you ever get a result of $$$−1$$$ (because you printed an invalid query), exit immediately to avoid getting other verdicts."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After printing a query do not forget to output end of line and flush the output. Otherwise, you will get "},{"children":[{"kind":"text","text":"Idleness limit exceeded"}],"kind":"container"},{"kind":"text","text":". To do this, use: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"fflush(stdout)"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"cout.flush()"}],"kind":"container"},{"kind":"text","text":" in C++; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"System.out.flush()"}],"kind":"container"},{"kind":"text","text":" in Java; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"flush(output)"}],"kind":"container"},{"kind":"text","text":" in Pascal; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"stdout.flush()"}],"kind":"container"},{"kind":"text","text":" in Python; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" see documentation for other languages. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"When you are ready to answer, print \""},{"children":[{"kind":"text","text":"! $$$x_0$$$"}],"kind":"container"},{"kind":"text","text":"\" where $$$x_0$$$ is the answer or $$$-1$$$ if there is no such $$$x_0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can ask at most $$$50$$$ questions per test case."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Hack Format"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To hack, use the following format."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line should contain $$$11$$$ integers $$$a_0, a_1, \\dots, a_{10}$$$ ($$$0 \\le a_i \\lt 10^6 + 3$$$, $$$\\max\\limits_{0 \\le i \\le 10}{a_i} \\gt 0$$$) — corresponding coefficients of the polynomial."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n \n1000002\n\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n? 0\n\n? 1\n\n! 1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n \n5\n\n2\n\n1\n\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n? 2\n\n? 1\n\n? 0\n\n! -1"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The polynomial in the first sample is $$$1000002 + x^2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The polynomial in the second sample is $$$1 + x^2$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1155E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1155/problem/E"}