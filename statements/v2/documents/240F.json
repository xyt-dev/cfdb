{"assets":[],"contentKind":"statement","contestId":"240","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. TorCoder"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"input_channel"},"children":[{"children":[{"kind":"text","text":"input"}],"kind":"container"},{"kind":"text","text":"input.txt"}],"kind":"container"},{"attrs":{"role":"output_channel"},"children":[{"children":[{"kind":"text","text":"output"}],"kind":"container"},{"kind":"text","text":"output.txt"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A boy named Leo doesn't miss a single TorCoder contest round. On the last TorCoder round number 100666 Leo stumbled over the following problem. He was given a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase English letters, and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries. Each query is characterised by a pair of integers "},{"kind":"math_inline","text":"li, ri"},{"kind":"math_inline","text":"(1 ≤ li ≤ ri ≤ n)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We'll consider the letters in the string numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right, that is, "},{"kind":"math_inline","text":"s = s1s2... sn"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After each query he must swap letters with indexes from "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" inclusive in string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" so as to make substring "},{"kind":"math_inline","text":"(li, ri)"},{"kind":"text","text":" a palindrome. If there are multiple such letter permutations, you should choose the one where string "},{"kind":"math_inline","text":"(li, ri)"},{"kind":"text","text":" will be lexicographically minimum. If no such permutation exists, you should ignore the query (that is, not change string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Everybody knows that on TorCoder rounds input line and array size limits never exceed "},{"kind":"math_inline","text":"60"},{"kind":"text","text":", so Leo solved this problem easily. Your task is to solve the problem on a little bit larger limits. Given string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries, print the string that results after applying all "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries to string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 105)"},{"kind":"text","text":" — the string length and the number of the queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains a pair of integers "},{"kind":"math_inline","text":"li, ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":") — a query to apply to the string. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print the result of applying "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries to string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Print the queries in the order in which they are given in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 2\naabcbaa\n1 3\n5 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"abacaba\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\nabc\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"abc\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"math_inline","text":"(li, ri)"},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n)"},{"kind":"text","text":" of string "},{"kind":"math_inline","text":"s = s1s2... sn"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is a sequence of characters "},{"kind":"math_inline","text":"slisli + 1...sri"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string is a "},{"children":[{"kind":"text","text":"palindrome"}],"kind":"container"},{"kind":"text","text":", if it reads the same from left to right and from right to left."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"String "},{"kind":"math_inline","text":"x1x2... xp"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"lexicographically smaller"}],"kind":"container"},{"kind":"text","text":" than string "},{"kind":"math_inline","text":"y1y2... yq"},{"kind":"text","text":", if either "},{"kind":"math_inline","text":"p < q"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x1 = y1, x2 = y2, ... , xp = yp"},{"kind":"text","text":", or exists such number "},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"(r < p, r < q)"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"x1 = y1, x2 = y2, ... , xr = yr"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"xr + 1 < yr + 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"240F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/240/problem/F"}