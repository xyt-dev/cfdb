{"assets":[],"contentKind":"statement","contestId":"739","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Gosha is hunting"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Gosha is hunting. His goal is to catch as many Pokemons as possible. Gosha has "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" Poke Balls and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" Ultra Balls. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" Pokemons. They are numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Gosha knows that if he throws a Poke Ball at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th Pokemon he catches it with probability "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":". If he throws an Ultra Ball at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th Pokemon he catches it with probability "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":". He can throw at most one Ball of each type at any Pokemon."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The hunting proceeds as follows: at first, Gosha chooses no more than "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" Pokemons at which he will throw Poke Balls and no more than "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" Pokemons at which he will throw Ultra Balls. After that, he throws the chosen Balls at the chosen Pokemons. If he throws both Ultra Ball and Poke Ball at some Pokemon, he is caught if and only if he is caught by any of these Balls. The outcome of a throw doesn't depend on the other throws."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Gosha would like to know what is the expected number of the Pokemons he catches if he acts in an optimal way. In other words, he would like to know the maximum possible expected number of Pokemons can catch."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ a, b ≤ n"},{"kind":"text","text":") — the number of Pokemons, the number of Poke Balls and the number of Ultra Balls."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" real values "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ pi ≤ 1"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" is the probability of catching the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th Pokemon if Gosha throws a Poke Ball to it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" real values "},{"kind":"math_inline","text":"u1, u2, ..., un"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ui ≤ 1"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" is the probability of catching the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th Pokemon if Gosha throws an Ultra Ball to it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the probabilities are given with exactly three digits after the decimal separator."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum possible expected number of Pokemons Gosha can catch. The answer is considered correct if it's absolute or relative error doesn't exceed "},{"kind":"math_inline","text":"10 - 4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 2\n1.000 0.000 0.500\n0.000 1.000 0.500\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2.75\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1 3\n0.100 0.500 0.500 0.600\n0.100 0.500 0.900 0.400\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2.16\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 0\n0.412 0.198 0.599\n0.612 0.987 0.443\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.011"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"739E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/739/problem/E"}