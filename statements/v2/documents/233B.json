,"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case "},{"kind":"math_inline","text":"x = 1"},{"kind":"text","text":" is the minimum root. As "},{"kind":"math_inline","text":"s(1) = 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"12 + 1·1 - 2 = 0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case "},{"kind":"math_inline","text":"x = 10"},{"kind":"text","text":" is the minimum root. As "},{"kind":"math_inline","text":"s(10) = 1 + 0 = 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"102 + 1·10 - 110 = 0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case the equation has no roots."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"233B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/233/problem/B"}