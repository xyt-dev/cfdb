{"assets":[],"contentKind":"statement","contestId":"233","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Non-square Equation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's consider equation:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"x2 + s(x)·x - n = 0, "}],"kind":"container"},{"children":[{"kind":"text","text":"where "},{"kind":"math_inline","text":"x, n"},{"kind":"text","text":" are positive integers, "},{"kind":"math_inline","text":"s(x)"},{"kind":"text","text":" is the function, equal to the sum of digits of number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" in the decimal number system."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", find the smallest positive integer root of equation "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", or else determine that there are no such roots."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 1018)"},{"kind":"text","text":" — the equation parameter."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"