{"assets":["/statement-assets/b1cff6afc1ccd1b23cc2fd822f4af1730bc7b8b654e67c67d691ba07d52eb0c9.png"],"contentKind":"statement","contestId":"285","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Permutation Sum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"children":[{"kind":"text","text":"Permutation"}],"kind":"container"},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is an ordered set of integers "},{"kind":"math_inline","text":"p1,  p2,  ...,  pn"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct positive integers, each of them doesn't exceed "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". We'll denote the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th element of permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":". We'll call number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" the size or the length of permutation "},{"kind":"math_inline","text":"p1,  p2,  ...,  pn"},{"kind":"text","text":"."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya decided to introduce the sum operation on the set of permutations of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Let's assume that we are given two permutations of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":": "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":". Petya calls the sum of permutations "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" such permutation "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ci = ((ai - 1 + bi - 1) mod n) + 1"},{"kind":"math_inline","text":"(1 ≤ i ≤ n)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Operation "},{"attrs":{"alt":"","src":"/statement-assets/b1cff6afc1ccd1b23cc2fd822f4af1730bc7b8b654e67c67d691ba07d52eb0c9.png"},"kind":"image"},{"kind":"text","text":" means taking the remainder after dividing number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by number "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Obviously, not for all permutations "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" exists permutation "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" that is sum of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". That's why Petya got sad and asked you to do the following: given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", count the number of such pairs of permutations "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", that exists permutation "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" that is sum of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The pair of permutations "},{"kind":"math_inline","text":"x, y"},{"kind":"math_inline","text":"(x ≠ y)"},{"kind":"text","text":" and the pair of permutations "},{"kind":"math_inline","text":"y, x"},{"kind":"text","text":" are considered distinct pairs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As the answer can be rather large, print the remainder after dividing it by "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains integer "},{"kind":"math_inline","text":"n (1 ≤ n ≤ 16)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the single line print a single non-negative integer — the number of such pairs of permutations "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", that exists permutation "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" that is sum of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"18\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1800\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"285D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/285/problem/D"}