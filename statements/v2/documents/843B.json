{"assets":["/statement-assets/215b6493b466f4c19de7aebbf91b35a8650cb22b081716718b2ba0fd5963ee7d.png"],"contentKind":"statement","contestId":"843","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Interactive LowerBound"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is an interactive problem."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a "},{"children":[{"kind":"text","text":"sorted"}],"kind":"container"},{"kind":"text","text":" in increasing order singly linked list. You should find the minimum integer in the list which is greater than or equal to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, there is a singly liked list built on an array of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" elements. Element with index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" contains two integers: "},{"kind":"math_inline","text":"valuei"},{"kind":"text","text":" is the integer value in this element, and "},{"kind":"math_inline","text":"nexti"},{"kind":"text","text":" that is the index of the next element of the singly linked list (or "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":", if the current element is the last). The list is sorted, i.e. if "},{"kind":"math_inline","text":"nexti ≠  - 1"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"valuenexti > valuei"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the number of elements in the list "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", the index of the first element "},{"kind":"math_inline","text":"start"},{"kind":"text","text":", and the integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can make up to "},{"kind":"math_inline","text":"2000"},{"kind":"text","text":" queries of the following two types:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"? i"}],"kind":"container"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") — ask the values "},{"kind":"math_inline","text":"valuei"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"nexti"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"! ans"}],"kind":"container"},{"kind":"text","text":" — give the answer for the problem: the minimum integer, greater than or equal to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", or "},{"children":[{"kind":"text","text":"! -1"}],"kind":"container"},{"kind":"text","text":", if there are no such integers. Your program should terminate after this query. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Write a program that solves this problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"start"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ start ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ x ≤ 109"},{"kind":"text","text":") — the number of elements in the list, the index of the first element and the integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"To print the answer for the problem, print "},{"children":[{"kind":"text","text":"! ans"}],"kind":"container"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"ans"}],"kind":"container"},{"kind":"text","text":" is the minimum integer in the list greater than or equal to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", or "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":", if there is no such integer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom","title":"Interaction"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Interaction"}],"kind":"heading"},{"children":[{"kind":"text","text":"To make a query of the first type, print "},{"children":[{"kind":"text","text":"? i"}],"kind":"container"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":"), where "},{"children":[{"kind":"text","text":"i"}],"kind":"container"},{"kind":"text","text":" is the index of element you want to know information about."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After each query of type "},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":" read two integers "},{"kind":"math_inline","text":"valuei"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"nexti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ valuei ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":" - 1 ≤ nexti ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"nexti ≠ 0"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that if "},{"kind":"math_inline","text":"nexti ≠  - 1"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"valuenexti > valuei"},{"kind":"text","text":", and that the array values give a valid singly linked list with "},{"kind":"math_inline","text":"start"},{"kind":"text","text":" being the first element."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that you can't ask more than "},{"kind":"math_inline","text":"1999"},{"kind":"text","text":" queries of the type "},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"nexti =  - 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"valuei =  - 1"},{"kind":"text","text":", then it means that you asked more queries than allowed, or asked an invalid query. Your program should immediately terminate (for example, by calling "},{"children":[{"kind":"text","text":"exit(0)"}],"kind":"container"},{"kind":"text","text":"). You will receive \""},{"children":[{"kind":"text","text":"Wrong Answer"}],"kind":"container"},{"kind":"text","text":"\", it means that you asked more queries than allowed, or asked an invalid query. If you ignore this, you can get other verdicts since your program will continue to read from a closed stream."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your solution will get \"Idleness Limit Exceeded\", if you don't print anything or forget to "},{"children":[{"kind":"text","text":"flush"}],"kind":"container"},{"kind":"text","text":" the output, including the final answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To "},{"children":[{"kind":"text","text":"flush"}],"kind":"container"},{"kind":"text","text":" you can use (just after printing a query and line end):"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"fflush(stdout)"}],"kind":"container"},{"kind":"text","text":" in C++; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"System.out.flush()"}],"kind":"container"},{"kind":"text","text":" in Java; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"stdout.flush()"}],"kind":"container"},{"kind":"text","text":" in Python; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"flush(output)"}],"kind":"container"},{"kind":"text","text":" in Pascal; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For other languages see documentation. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"children":[{"kind":"text","text":"Hacks format"}],"kind":"container"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For hacks, use the following format:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first line print three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"start"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ start ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ x ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines print the description of the elements of the list: in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print two integers "},{"kind":"math_inline","text":"valuei"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"nexti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ valuei ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":" - 1 ≤ nexti ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"nexti ≠ 0"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The printed structure should be a valid singly linked list. In particular, it should be possible to reach all elements from "},{"kind":"math_inline","text":"start"},{"kind":"text","text":" by following links "},{"kind":"math_inline","text":"nexti"},{"kind":"text","text":", and the last element "},{"kind":"math_inline","text":"end"},{"kind":"text","text":" should have "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" in the "},{"kind":"math_inline","text":"nextend"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3 80\n97 -1\n58 5\n16 2\n81 1\n79 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"? 1\n? 2\n? 3\n? 4\n? 5\n! 81"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"You can read more about singly linked list by the following link: "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Linked_list#Singly_linked_list"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Linked_list#Singly_linked_list"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"The illustration for the fi