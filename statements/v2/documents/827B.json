{"assets":["/statement-assets/1cc58b69d2b47bcd7807da5b3fe0bc2efa6680a42755c7dd78645c6d0b1af965.png"],"contentKind":"statement","contestId":"827","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. High Load"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Arkady needs your help again! This time he decided to build his own high-speed Internet exchange point. It should consist of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes connected with minimum possible number of wires into one network (a wire directly connects two nodes). Exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" of the nodes should be exit-nodes, that means that each of them should be connected to exactly one other node of the network, while all other nodes should be connected to at least two nodes in order to increase the system stability."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Arkady wants to make the system as fast as possible, so he wants to minimize the maximum distance between two exit-nodes. The distance between two nodes is the number of wires a package needs to go through between those two nodes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Arkady to find such a way to build the network that the distance between the two most distant exit-nodes is as small as possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 2·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ k ≤ n - 1"},{"kind":"text","text":") — the total number of nodes and the number of exit-nodes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that it is always possible to build at least one network with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" exit-nodes within the given constraints."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the minimum possible distance between the two most distant exit-nodes. In each of the next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines print two integers: the ids of the nodes connected by a wire. The description of each wire should be printed exactly once. You can print wires and wires' ends in arbitrary order. The nodes should be numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Exit-nodes can have any ids."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n2 3\n3 4\n3 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the only network is shown on the left picture."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example one of optimal networks is shown on the right picture."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Exit-nodes are highlighted."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1cc58b69d2b47bcd7807da5b3fe0bc2efa6680a42755c7dd78645c6d0b1af965.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"827B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/827/problem/B"}