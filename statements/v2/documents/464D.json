{"assets":[],"contentKind":"statement","contestId":"464","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. World of Darkraft - 2"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Roma found a new character in the game \"World of Darkraft - 2\". In this game the character fights monsters, finds the more and more advanced stuff that lets him fight stronger monsters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The character can equip himself with "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" distinct types of items. Power of each item depends on its level (positive integer number). Initially the character has one "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-level item of each of the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" types."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the victory over the monster the character finds exactly one new randomly generated item. The generation process looks as follows. Firstly the type of the item is defined; each of the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" types has the same probability. Then the level of the new item is defined. Let's assume that the level of player's item of the chosen type is equal to "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" at the moment. Level of the new item will be chosen uniformly among integers from segment ["},{"kind":"math_inline","text":"1"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"t + 1"},{"kind":"text","text":"]."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"From the new item and the current player's item of the same type Roma chooses the best one (i.e. the one with greater level) and equips it (if both of them has the same level Roma choses any). The remaining item is sold for coins. Roma sells an item of level "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" of any type for "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" coins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Roma determine the expected number of earned coins after the victory over "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" monsters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"1 ≤ k ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a real number — expected number of earned coins after victory over "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" monsters. The answer is considered correct if its relative or absolute error doesn't exceed "},{"kind":"math_inline","text":"10 - 9"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.0000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2.3333333333\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"15.9380768924\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"464D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/464/problem/D"}