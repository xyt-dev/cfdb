{"assets":["/statement-assets/6f9aa068ec680a1f8ea86536ca062cf142839f9cc92b632a614978631d8ba7d0.png","/statement-assets/8ab0f655efd4e02745a451635f45b6efe14d2689cce2bf4df6af93f04afc5aef.png","/statement-assets/c3fe769b2808a5ed0b848a749ffa4f4e9f45dada1d074342275467b688057287.png","/statement-assets/67ab9022a135f2e0e2cc2aae16b507b079b5a7ce2bef24f556dcb6ad3d9d7ca2.png","/statement-assets/5365407a91a3cf9c451b13737297eb4a90307263ad041e58c55bba5a626bcec1.png"],"contentKind":"statement","contestId":"924","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Mystical Mosaic"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a rectangular grid of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" initially-white cells each."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Arkady performed a certain number (possibly zero) of operations on it. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th operation, a non-empty subset of rows "},{"kind":"math_inline","text":"Ri"},{"kind":"text","text":" and a non-empty subset of columns "},{"kind":"math_inline","text":"Ci"},{"kind":"text","text":" are chosen. For each row "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"Ri"},{"kind":"text","text":" and each column "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"Ci"},{"kind":"text","text":", the intersection of row "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and column "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" is coloured black."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There's another constraint: a row or a column can only be chosen at most once among all operations. In other words, it means that no pair of "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"i < j"},{"kind":"text","text":") exists such that "},{"attrs":{"alt":"","src":"/statement-assets/6f9aa068ec680a1f8ea86536ca062cf142839f9cc92b632a614978631d8ba7d0.png"},"kind":"image"},{"kind":"text","text":" or "},{"attrs":{"alt":"","src":"/statement-assets/8ab0f655efd4e02745a451635f45b6efe14d2689cce2bf4df6af93f04afc5aef.png"},"kind":"image"},{"kind":"text","text":", where "},{"attrs":{"alt":"","src":"/statement-assets/c3fe769b2808a5ed0b848a749ffa4f4e9f45dada1d074342275467b688057287.png"},"kind":"image"},{"kind":"text","text":" denotes intersection of sets, and "},{"attrs":{"alt":"","src":"/statement-assets/67ab9022a135f2e0e2cc2aae16b507b079b5a7ce2bef24f556dcb6ad3d9d7ca2.png"},"kind":"image"},{"kind":"text","text":" denotes the empty set."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are to determine whether a valid sequence of operations exists that produces a given final grid."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 50"},{"kind":"text","text":") — the number of rows and columns of the grid, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains a string of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters, each being either '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' (denoting a white cell) or '"},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"' (denoting a black cell), representing the desired setup."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the given grid can be achieved by any valid sequence of operations, output \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\"; otherwise output \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" (both without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print each character in any case (upper or lower)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 8\n.#.#..#.\n.....#..\n.#.#..#.\n#.#....#\n.....#..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n..#..\n..#..\n#####\n..#..\n..#..\n"}],"kind":"section"},{"attrs":{"role":"sample_