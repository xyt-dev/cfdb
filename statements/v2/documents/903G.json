{"assets":["/statement-assets/141282477e5ca99635f265535de1c7c6a0cd7baa9617b4b603a4575e061108e5.png"],"contentKind":"statement","contestId":"903","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Yet Another Maxflow Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In this problem you will have to deal with a very special network."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The network consists of two parts: part "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and part "},{"kind":"math_inline","text":"B"},{"kind":"text","text":". Each part consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices; "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex of part "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is denoted as "},{"kind":"math_inline","text":"Ai"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex of part "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" is denoted as "},{"kind":"math_inline","text":"Bi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i < n"},{"kind":"text","text":") there is a directed edge from vertex "},{"kind":"math_inline","text":"Ai"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"Ai + 1"},{"kind":"text","text":", and from "},{"kind":"math_inline","text":"Bi"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"Bi + 1"},{"kind":"text","text":", respectively. Capacities of these edges are given in the input. Also there might be several directed edges going from part "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" to part "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" (but never from "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"A"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to calculate the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Maximum_flow_problem"},"children":[{"kind":"text","text":"maximum flow value"}],"kind":"link"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"A1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"Bn"},{"kind":"text","text":" in this network. Capacities of edges connecting "},{"kind":"math_inline","text":"Ai"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"Ai + 1"},{"kind":"text","text":" might sometimes change, and you also have to maintain the maximum flow value after these changes. Apart from that, the network is fixed (there are no changes in part "},{"kind":"math_inline","text":"B"},{"kind":"text","text":", no changes of edges going from "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"B"},{"kind":"text","text":", and no edge insertions or deletions)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Take a look at the example and the notes to understand the structure of the network better."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n, m ≤ 2·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ q ≤ 2·105"},{"kind":"text","text":") — the number of vertices in each part, the number of edges going from "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" and the number of changes, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines follow, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" denoting that the edge from "},{"kind":"math_inline","text":"Ai"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"Ai + 1"},{"kind":"text","text":" has capacity "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and the edge from "},{"kind":"math_inline","text":"Bi"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"Bi + 1"},{"kind":"text","text":" has capacity "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follow, describing the edges from "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"B"},{"kind":"text","text":". Each line contains three integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" denoting an edge from "},{"kind":"math_inline","text":"Ax"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"By"},{"kind":"text","text":" with capacity "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x, y ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ z ≤ 109"},{"kind":"text","text":"). There might be multiple edges from "},{"kind":"math_inline","text":"Ax"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"By"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"And then "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines follow, describing a sequence of changes to the network. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two integers "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":", denoting that the capacity of the edge from "},{"kind":"math_inline","text":"Avi"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"Avi + 1"},{"kind":"text","text":" is set to "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ vi < n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ wi ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Firstly, print the maximum flow value in the original network. Then print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" integers, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them must be equal to the maximum flow value after "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th change."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 2\n1 2\n3 4\n5 6\n2 2 7\n1 4 8\n4 3 9\n1 100\n2 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n14\n14\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"This is the original network in the example:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/141282477e5ca99635f265535de1c7c6a0cd7baa9617b4b603a4575e061108e5.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"903G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/903/problem/G"}