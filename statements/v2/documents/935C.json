{"assets":[],"contentKind":"statement","contestId":"935","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Fifa and Fafa"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Fifa and Fafa are sharing a flat. Fifa loves video games and wants to download a new soccer game. Unfortunately, Fafa heavily uses the internet which consumes the quota. Fifa can access the internet through his Wi-Fi access point. This access point can be accessed within a range of "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" meters (this range can be chosen by Fifa) from its position. Fifa must put the access point inside the flat which has a circular shape of radius "},{"kind":"math_inline","text":"R"},{"kind":"text","text":". Fifa wants to minimize the area that is not covered by the access point inside the flat without letting Fafa or anyone outside the flat to get access to the internet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The world is represented as an infinite 2D plane. The flat is centered at "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":" and has radius "},{"kind":"math_inline","text":"R"},{"kind":"text","text":" and Fafa's laptop is located at "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":", not necessarily inside the flat. Find the position and the radius chosen by Fifa for his access point which minimizes the uncovered area."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line of the input contains 5 space-separated integers "},{"kind":"math_inline","text":"R, x1, y1, x2, y2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ R ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"|x1|, |y1|, |x2|, |y2| ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print three space-separated numbers "},{"kind":"math_inline","text":"xap, yap, r"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"(xap, yap)"},{"kind":"text","text":" is the position which Fifa chose for the access point and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" is the radius of its range. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your answer will be considered correct if the radius does not differ from optimal more than "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":" absolutely or relatively, and also the radius you printed can be changed by no more than "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":" (absolutely or relatively) in such a way that all points outside the flat and Fafa's laptop position are outside circle of the access point range."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3 3 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3.7677669529663684 3.7677669529663684 3.914213562373095\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 5 5 5 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5.0 5.0 10.0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"935C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/935/problem/C"}