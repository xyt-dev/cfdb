{"assets":["/statement-assets/f25a3850866cd86a3ce76b46ad52a5ea67ae631169b3a2dc8e4e295345e94657.png","/statement-assets/3f2fcc295199a076fc54f385e52e5224ef0e70fc25d88bc4f4640e92ac92aa8f.png","/statement-assets/4b31dd3f2c8464bf1694cf9fb3b9a77458f7723b598e74c2e006469a3ae3bda3.png"],"contentKind":"statement","contestId":"1515","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Phoenix and Puzzle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Phoenix is playing with a new puzzle, which consists of $$$n$$$ identical puzzle pieces. Each puzzle piece is a right isosceles triangle as shown below."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f25a3850866cd86a3ce76b46ad52a5ea67ae631169b3a2dc8e4e295345e94657.png"},"kind":"image"},{"children":[{"kind":"text","text":"A puzzle piece"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"The goal of the puzzle is to create a "},{"children":[{"kind":"text","text":"square"}],"kind":"container"},{"kind":"text","text":" using the $$$n$$$ pieces. He is allowed to rotate and move the pieces around, but none of them can overlap and all $$$n$$$ pieces must be used (of course, the square shouldn't contain any holes as well). Can he do it?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of multiple test cases. The first line contains an integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains an integer $$$n$$$ ($$$1 \\le n \\le 10^9$$$) — the number of puzzle pieces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, if Phoenix can create a square with the $$$n$$$ puzzle pieces, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":". Otherwise, print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2\n4\n6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For $$$n=2$$$, Phoenix can create a square like this:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/3f2fcc295199a076fc54f385e52e5224ef0e70fc25d88bc4f4640e92ac92aa8f.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"For $$$n=4$$$, Phoenix can create a square like this:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/4b31dd3f2c8464bf1694cf9fb3b9a77458f7723b598e74c2e006469a3ae3bda3.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"For $$$n=6$$$, it is impossible for Phoenix to create a square."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1515B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1515/problem/B"}