{"assets":[],"contentKind":"statement","contestId":"525","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Anya and Cubes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Anya loves to fold and stick. Today she decided to do just that."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Anya has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cubes lying in a line and numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right, with natural numbers written on them. She also has "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" stickers with exclamation marks. We know that the number of stickers does not exceed the number of cubes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Anya can stick an exclamation mark on the cube and get the factorial of the number written on the cube. For example, if a cube reads "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", then after the sticking it reads "},{"kind":"math_inline","text":"5!"},{"kind":"text","text":", which equals "},{"kind":"math_inline","text":"120"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to help Anya count how many ways there are to choose some of the cubes and stick on some of the chosen cubes at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" exclamation marks so that the sum of the numbers written on the chosen cubes after the sticking becomes equal to "},{"kind":"math_inline","text":"S"},{"kind":"text","text":". Anya can stick at most one exclamation mark on each cube. Can you do it?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two ways are considered the same if they have the same set of chosen cubes and the same set of cubes with exclamation marks."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 25"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ S ≤ 1016"},{"kind":"text","text":") — the number of cubes and the number of stickers that Anya has, and the sum that she needs to get. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — the numbers, written on the cubes. The cubes in the input are described in the order from left to right, starting from the first one. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Multiple cubes can contain the same numbers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the number of ways to choose some number of cubes and stick exclamation marks on some of them so that the sum of the numbers became equal to the given number "},{"kind":"math_inline","text":"S"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 30\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 7\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 1\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the only way is to choose both cubes and stick an exclamation mark on each of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the only way is to choose both cubes but don't stick an exclamation mark on any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample it is possible to choose any of the cubes in three ways, and also we may choose to stick or not to stick the exclamation mark on it. So, the total number of ways is six."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"525E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/525/problem/E"}