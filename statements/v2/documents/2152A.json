{"assets":[],"contentKind":"statement","contestId":"2152","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Increase or Smash"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Geumjae has an array $$$a$$$ consisting of $$$n$$$ zeros. His goal is to transform it into a given target array using a minimum number of operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He can perform the following two types of operations any number of times, in any order:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"children":[{"kind":"text","text":"Increase"}],"kind":"container"},{"kind":"text","text":": Choose any positive integer $$$x$$$. Increase "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" elements of the array $$$a$$$ by $$$x$$$. In other words, he chooses a positive integer $$$x$$$, and for each $$$i$$$ ($$$1 \\le i \\le n$$$), he replaces $$$a_i$$$ with $$$a_i + x$$$. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Smash"}],"kind":"container"},{"kind":"text","text":": Set "},{"children":[{"kind":"text","text":"some"}],"kind":"container"},{"kind":"text","text":" elements (possibly none or all) of the array $$$a$$$ to $$$0$$$. In other words, for each $$$i$$$ ($$$1 \\le i \\le n$$$), he either replaces $$$a_i$$$ with $$$0$$$ or leaves it as before. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Given the final target state of the array $$$a$$$, find the minimum total number of operations (both "},{"children":[{"kind":"text","text":"Increase"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"Smash"}],"kind":"container"},{"kind":"text","text":") Geumjae needs to perform."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It can be shown that for any given final array, a sequence of operations always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 1000$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$1 \\le n \\le 100$$$) — the number of elements in the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\le a_i \\le 100$$$) — the elements of the target array $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the minimum number of operations required."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n3\n1 1 3\n1\n100\n9\n9 9 3 2 4 4 8 5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1\n11\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Explanation of the first test case:"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The target array is $$$[1, 1, 3]$$$. A possible sequence of 3 operations (which is the minimum) is:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Initially, the array is $$$[0, 0, 0]$$$. After an "},{"children":[{"kind":"text","text":"Increase"}],"kind":"container"},{"kind":"text","text":" operation with $$$x = 2$$$, the array becomes $$$[2, 2, 2]$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Next, after a "},{"children":[{"kind":"text","text":"Smash"}],"kind":"container"},{"kind":"text","text":" operation on the first two elements, the array becomes $$$[0, 0, 2]$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Finally, after an "},{"children":[{"kind":"text","text":"Increase"}],"kind":"container"},{"kind":"text","text":" operation with $$$x = 1$$$, the array becomes $$$[1, 1, 3]$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"We used $$$2$$$ "},{"children":[{"kind":"text","text":"Increase"}],"kind":"container"},{"kind":"text","text":" operations and $$$1$$$ "},{"children":[{"kind":"text","text":"Smash"}],"kind":"container"},{"kind":"text","text":" operation for a total of $$$3$$$ operations."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Explanation of the second test case:"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The target array is $$$[100]$$$. A single "},{"children":[{"kind":"text","text":"Increase"}],"kind":"container"},{"kind":"text","text":" operation with $$$x = 100$$$ gives the target array."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2152A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2152/problem/A"}