{"assets":[],"contentKind":"statement","contestId":"1494","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. ABC String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$a$$$, consisting of $$$n$$$ characters, $$$n$$$ is even. For each $$$i$$$ from $$$1$$$ to $$$n$$$ $$$a_i$$$ is one of '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A bracket sequence is a string containing only characters \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\". A regular bracket sequence is a bracket sequence that can be transformed into a correct arithmetic expression by inserting characters \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" between the original characters of the sequence. For example, bracket sequences \""},{"children":[{"kind":"text","text":"()()"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(())"}],"kind":"container"},{"kind":"text","text":"\" are regular (the resulting expressions are: \""},{"children":[{"kind":"text","text":"(1)+(1)"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"((1+1)+1)"}],"kind":"container"},{"kind":"text","text":"\"), and \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You want to find a string $$$b$$$ that consists of $$$n$$$ characters such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$b$$$ is a regular bracket sequence; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if for some $$$i$$$ and $$$j$$$ ($$$1 \\le i, j \\le n$$$) $$$a_i=a_j$$$, then $$$b_i=b_j$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In other words, you want to replace all occurrences of '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"' with the same type of bracket, then all occurrences of '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' with the same type of bracket and all occurrences of '"},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"' with the same type of bracket."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine if such a string $$$b$$$ exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of testcases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then the descriptions of $$$t$$$ testcases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each testcase contains a string $$$a$$$. $$$a$$$ consists only of uppercase letters '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"C"}],"kind":"container"},{"kind":"text","text":"'. Let $$$n$$$ be the length of $$$a$$$. It is guaranteed that $$$n$$$ is even and $$$2 \\le n \\le 50$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if there exists such a string $$$b$$$ that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$b$$$ is a regular bracket sequence; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if for some $$$i$$$ and $$$j$$$ ($$$1 \\le i, j \\le n$$$) $$$a_i=a_j$$$, then $$$b_i=b_j$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Otherwise, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may print every letter in any case you want (so, for example, the strings "},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" are all recognized as positive answer)."}],"kind":"paragraph"}],"kind":"sec