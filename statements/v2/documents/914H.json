{"assets":[],"contentKind":"statement","contestId":"914","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Ember and Storm's Tree Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ember and Storm play a game. First, Ember picks a labelled tree "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices, such that the degree of every vertex is at most "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". Then, Storm picks two distinct vertices "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" in this tree and writes down the labels of the vertices in the path from "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" in a sequence "},{"kind":"math_inline","text":"a1, a2... ak"},{"kind":"text","text":". Finally, Ember picks any index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i < k"},{"kind":"text","text":") in the array. Now he performs one of the following two operations exactly once:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" flip the subrange "},{"kind":"math_inline","text":"[i + 1, k]"},{"kind":"text","text":" and add "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" to it. After this, the sequence becomes "},{"kind":"math_inline","text":"a1, ... ai, ak + ai, ak - 1 + ai, ... ai + 1 + ai"}],"kind":"list_item"},{"children":[{"kind":"text","text":" negate the subrange "},{"kind":"math_inline","text":"[i + 1, k]"},{"kind":"text","text":" and add "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" to it. i.e., the array becomes "},{"kind":"math_inline","text":"a1, ... ai,  - ai + 1 + ai,  - ai + 2 + ai, ... - ak + ai"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Ember wins if the array is monotonically increasing or decreasing after this. Otherwise Storm wins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The game can be described by the tuple "},{"kind":"math_inline","text":"(T, u, v, i, op)"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"op"},{"kind":"text","text":" is «flip» or «negate» depending on the action Ember chose in the last turn. Find the number of tuples that can occur if Ember and Storm play optimally. When they play optimally, if there are multiple moves by which they are guaranteed to win, then they may play any of the winning moves. Otherwise, if someone loses no matter what they play, then they may play any of the possible moves."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Report the answer modulo "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of a single line containing three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 200, 1 ≤ d < n, 1 ≤ m ≤ 2·109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number  — the number of possible tuples if Ember and Storm play as described, modulo "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 1000000007\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 250\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"36\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case, there is only one possible tree. There are two possible paths, "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". For both paths, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" can only be "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"op"},{"kind":"text","text":" can take both possibilities. Therefore, the answer is "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, there are no possible trees."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, there are three possible trees. "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"914H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/914/problem/H"}