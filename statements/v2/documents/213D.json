{"assets":["/statement-assets/71b34a7fea406f25c24854384fe33ca2d7975278ff216030fb5525e26624ea8a.png","/statement-assets/42954aed189143711d8739f9fd595e3a4787854ed258cfe6d50e2b2a96d8b682.png","/statement-assets/9434a41208fb7bac832c0a6bc66c0020fd3378569881b1c093ec381e01ae5f7d.png"],"contentKind":"statement","contestId":"213","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Stars"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Furik loves painting stars. A star is a shape that results if we take a regular pentagon and paint all diagonals in it. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/71b34a7fea406f25c24854384fe33ca2d7975278ff216030fb5525e26624ea8a.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Recently he decided to teach Rubik to paint stars. After many years of training Rubik could paint stars easily. But now Furik decided to test Rubik and complicated the task. Rubik must paint "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" stars, observing the following rules:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" all stars must be painted in a single move (i.e. it is forbidden to take the pen away from the paper); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" it is forbidden to paint the same segment of non-zero length more than once; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the stars can intersect only in their vertexes; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the length of a side of the regular pentagon, in which Rubik paints each star, must equal 10. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Rubik to cope with this hard task."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line contains an integer "},{"kind":"math_inline","text":"(1 ≤ n ≤ 100)"},{"kind":"text","text":" — the number of stars to paint."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first line print an integer "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ m ≤ 5·n)"},{"kind":"text","text":". On the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines print coordinates of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" distinct points with accuracy of at least "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" and at most "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" digits after decimal point. All coordinates should not exceed "},{"kind":"math_inline","text":"5000"},{"kind":"text","text":" in their absolute value. On each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines print "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" integers — the indexes of the points that form the given star in the clockwise or counterclockwise order. On the next line print "},{"kind":"math_inline","text":"5·n + 1"},{"kind":"text","text":" integers — the numbers of points in the order, in which Rubik paints stars. That is, if number with index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", and number with index "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"ai + 1"},{"kind":"text","text":", then points with indexes "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ai + 1"},{"kind":"text","text":" will have a segment painted between them. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can consider all "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" printed points indexed from 1 to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" in the order, in which they occur in the output. Separate the numbers on the lines with whitespaces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the answer has an imprecise validation. Try to obtain as accurate a solution as possible. The validator performs all calculations considering that the absolute error of a participant's answer is not more than "},{"kind":"math_inline","text":"10 - 8"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n3.830127018922193 3.366025403784439\n-3.601321235851749 10.057331467373021\n0.466045194906253 19.192786043799030\n10.411264148588986 18.147501411122495\n12.490381056766580 8.366025403784439\n1 2 3 4 5\n1 3 5 2 4 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The initial position of points in the sample is:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/42954aed189143711d8739f9fd595e3a4787854ed258cfe6d50e2b2a96d8b682.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The order in which Rubik can paint segments is:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9434a41208fb7bac832c0a6bc66c0020fd3378569881b1c093ec381e01ae5f7d.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"213D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/213/problem/D"}