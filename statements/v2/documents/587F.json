{"assets":["/statement-assets/c578546865a126b860e3e3fa4cf364289cc4be5e8ce9a6b1cd5c042ad62c3943.png","/statement-assets/50e60129ebe7726aa0e806200dffecfdef9d804ebbb3153c8395ef068c55189a.png","/statement-assets/966307e899790b5263136d018da5c918b3fccb359924bfd3e670470e09cf6790.png"],"contentKind":"statement","contestId":"587","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Duff is Mad"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Duff is mad at her friends. That's why she sometimes makes Malek to take candy from one of her friends for no reason!"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c578546865a126b860e3e3fa4cf364289cc4be5e8ce9a6b1cd5c042ad62c3943.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"She has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" friends. Her "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th friend's name is "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" (their names are not necessarily unique). "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" times, she asks Malek to take candy from her friends. She's angry, but also she acts with rules. When she wants to ask Malek to take candy from one of her friends, like "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", she chooses two numbers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and tells Malek to take exactly "},{"attrs":{"alt":"","src":"/statement-assets/50e60129ebe7726aa0e806200dffecfdef9d804ebbb3153c8395ef068c55189a.png"},"kind":"image"},{"kind":"text","text":" candies from him/her, where "},{"kind":"math_inline","text":"occur(t, s)"},{"kind":"text","text":" is the number of occurrences of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Malek is not able to calculate how many candies to take in each request from Duff. That's why she asked for your help. Please tell him how many candies to take in each request."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, q ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the names. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains an string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":", consisting of lowercase English letters ("},{"attrs":{"alt":"","src":"/statement-assets/966307e899790b5263136d018da5c918b3fccb359924bfd3e670470e09cf6790.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain the requests. Each of them contains three integers, "},{"kind":"math_inline","text":"l, r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" (says that Malek should take "},{"attrs":{"alt":"","src":"/statement-assets/50e60129ebe7726aa0e806200dffecfdef9d804ebbb3153c8395ef068c55189a.png"},"kind":"image"},{"kind":"text","text":" candies from Duff's "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th friend)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the answer to each request in one line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\na\nab\nabab\nababab\nb\n1 5 4\n3 5 4\n1 5 2\n1 5 3\n1 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n6\n3\n7\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"587F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/587/problem/F"}