{"assets":[],"contentKind":"statement","contestId":"2145","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Monocarp's String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Monocarp has a string $$$s$$$ of length $$$n$$$, consisting of the letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"'. He wants to remove some (possibly zero) number of "},{"children":[{"kind":"text","text":"consecutive"}],"kind":"container"},{"kind":"text","text":" letters from his string in such a way that the number of letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' in the resulting string becomes equal. Monocarp can start removing letters from any position in the string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Monocarp really likes his string $$$s$$$, so he wants to remove as few consecutive letters from it as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine the minimum number of consecutive letters from the string $$$s$$$ that need to be removed so that the number of letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' in the resulting string becomes equal. If it is necessary to remove all letters from the string $$$s$$$ (i.e., make it empty), report this."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two lines:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the first line contains one integer $$$n$$$ ($$$2 \\le n \\le 2 \\cdot 10^5$$$) — the number of characters in the string $$$s$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the second line contains the string $$$s$$$ of length $$$n$$$, consisting of the letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and/or '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Additional constraint on the input: the sum of values of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the answer as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If in order to make the number of letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' equal, it is necessary to remove all letters from the string $$$s$$$, output $$$-1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, output the minimum number of consecutive letters that Monocarp needs to remove from his string $$$s$$$ so that the number of letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' becomes equal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n5\nbbbab\n6\nbbaaba\n4\naaaa\n12\naabbaaabbaab\n5\naabaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n0\n-1\n2\n-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, Monocarp needs to remove the first three letters from his string. After that, his string will become \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\". In this string, there is one letter '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and one letter '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, the given string has three letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and three letters '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"', so nothing needs to be removed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, all letters of the string need to be removed, as there are no letters '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"', so $$$-1$$$ should be printed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example, Monocarp can, for example, remove the fifth and sixth letters from his string. Then his string will become \""},{"children":[{"kind":"text","text":"aabbabbaab"}],"kind":"container"},{"kind":"text","text":"\". In this string, there are five letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and five letters '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth example, all letters of the string need to be removed to make the number of letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' equal, so $$$-1$$$ should be printed."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"2145C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2145/problem/C"}