{"assets":["/statement-assets/098eb9878f4b18d11eab5b434a8f39d28cef5a92b14b752cbf7028b728e3ef24.png"],"contentKind":"statement","contestId":"938","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Constructing Tests"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's denote a "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-free matrix as a binary (that is, consisting of only "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"'s and "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"'s) matrix such that every square submatrix of size "},{"kind":"math_inline","text":"m × m"},{"kind":"text","text":" of this matrix contains at least one zero. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the following problem:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"You are given two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". You have to construct an "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-free square matrix of size "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" such that "},{"children":[{"kind":"text","text":"the number of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"'s in this matrix is maximum possible"}],"kind":"container"},{"kind":"text","text":". Print the maximum possible number of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"'s in such matrix."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You don't have to solve this problem. Instead, you have to construct a few tests for it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You will be given "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" numbers "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"xt"},{"kind":"text","text":". For every "},{"attrs":{"alt":"","src":"/statement-assets/098eb9878f4b18d11eab5b434a8f39d28cef5a92b14b752cbf7028b728e3ef24.png"},"kind":"image"},{"kind":"text","text":", find two integers "},{"kind":"math_inline","text":"ni"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"ni ≥ mi"},{"kind":"text","text":") such that the answer for the aforementioned problem is exactly "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" if we set "},{"kind":"math_inline","text":"n = ni"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m = mi"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 100"},{"kind":"text","text":") — the number of tests you have to construct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines follow, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line containing one integer "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ xi ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note that in hacks you have to set "},{"kind":"math_inline","text":"t = 1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test you have to construct, output two positive numbers "},{"kind":"math_inline","text":"ni"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ mi ≤ ni ≤ 109"},{"kind":"text","text":") such that the maximum number of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"'s in a "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":"-free "},{"kind":"math_inline","text":"ni × ni"},{"kind":"text","text":" matrix is exactly "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". If there are multiple solutions, you may output any of them; and if this is impossible to construct a test, output a single integer "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n21\n0\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n1 1\n-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"938C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/938/problem/C"}