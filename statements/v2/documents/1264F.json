{"assets":[],"contentKind":"statement","contestId":"1264","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Beautiful Fibonacci Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The well-known Fibonacci sequence $$$F_0, F_1, F_2,\\ldots $$$ is defined as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$F_0 = 0, F_1 = 1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For each $$$i \\geq 2$$$: $$$F_i = F_{i - 1} + F_{i - 2}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Given an increasing arithmetic sequence of positive integers with $$$n$$$ elements: $$$(a, a + d, a + 2\\cdot d,\\ldots, a + (n - 1)\\cdot d)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to find another increasing arithmetic sequence of positive integers with $$$n$$$ elements $$$(b, b + e, b + 2\\cdot e,\\ldots, b + (n - 1)\\cdot e)$$$ such that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$0 \\lt b, e \\lt 2^{64}$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for all $$$0\\leq i \\lt n$$$, the decimal representation of $$$a + i \\cdot d$$$ appears as substring in the last $$$18$$$ digits of the decimal representation of $$$F_{b + i \\cdot e}$$$ (if this number has less than $$$18$$$ digits, then we consider all its digits). "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three positive integers $$$n$$$, $$$a$$$, $$$d$$$ ($$$1 \\leq n, a, d, a + (n - 1) \\cdot d \\lt 10^6$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If no such arithmetic sequence exists, print $$$-1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print two integers $$$b$$$ and $$$e$$$, separated by space in a single line ($$$0 \\lt b, e \\lt 2^{64}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are many answers, you can output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2 1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n19 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, we can choose $$$(b, e) = (2, 1)$$$, because $$$F_2 = 1, F_3 = 2, F_4 = 3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, we can choose $$$(b, e) = (19, 5)$$$ because:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$F_{19} = 4181$$$ contains $$$1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$F_{24} = 46368$$$ contains $$$3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$F_{29} = 514229$$$ contains $$$5$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$F_{34} = 5702887$$$ contains $$$7$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$F_{39} = 63245986$$$ contains $$$9$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1264F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1264/problem/F"}