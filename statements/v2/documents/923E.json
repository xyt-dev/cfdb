{"assets":["/statement-assets/66cabc929e137df33b8b480b61e429138c983cba6de92a0bd4cfe7aed232c48d.png","/statement-assets/30b45464bb23e6d2f84992302e3f52da5c9fcecece2650c6c73c1b123ce49ce3.png"],"contentKind":"statement","contestId":"923","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Perpetual Subtraction"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" initially written on a blackboard. You repeat the following action a fixed amount of times: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" take the number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" currently written on a blackboard and erase it "}],"kind":"list_item"},{"children":[{"kind":"text","text":" select an integer uniformly at random from the range "},{"kind":"math_inline","text":"[0, x]"},{"kind":"text","text":" inclusive, and write it on the blackboard "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Determine the distribution of final number given the distribution of initial number and the number of steps."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers, "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ N ≤ 105"},{"kind":"text","text":") — the maximum number written on the blackboard — and "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ M ≤ 1018"},{"kind":"text","text":") — the number of steps to perform."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"N + 1"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"P0, P1, ..., PN"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ Pi < 998244353"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"Pi"},{"kind":"text","text":" describes the probability that the starting number is "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". We can express this probability as irreducible fraction "},{"kind":"math_inline","text":"P / Q"},{"kind":"text","text":", then "},{"attrs":{"alt":"","src":"/statement-assets/66cabc929e137df33b8b480b61e429138c983cba6de92a0bd4cfe7aed232c48d.png"},"kind":"image"},{"kind":"text","text":". It is guaranteed that the sum of all "},{"kind":"math_inline","text":"Pi"},{"kind":"text","text":"s equals "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" (modulo "},{"kind":"math_inline","text":"998244353"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single line of "},{"kind":"math_inline","text":"N + 1"},{"kind":"text","text":" integers, where "},{"kind":"math_inline","text":"Ri"},{"kind":"text","text":" is the probability that the final number after "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" steps is "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". It can be proven that the probability may always be expressed as an irreducible fraction "},{"kind":"math_inline","text":"P / Q"},{"kind":"text","text":". You are asked to output "},{"attrs":{"alt":"","src":"/statement-assets/30b45464bb23e6d2f84992302e3f52da5c9fcecece2650c6c73c1b123ce49ce3.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n0 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"332748118 332748118 332748118\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n0 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"942786334 610038216 443664157\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9 350\n3 31 314 3141 31415 314159 3141592 31415926 314159265 649178508\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"822986014 12998613 84959018 728107923 939229297 935516344 27254497 413831286 583600448 442738326\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first case, we start with number 2. After one step, it will be 0, 1 or 2 with probability 1/3 each."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second case, the number will remain 2 with probability 1/9. With probability 1/9 it stays 2 in the first round and changes to 1 in the next, and with probability 1/6 changes to 1 in the first round and stays in the second. In all other cases the final integer is 0."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"923E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/923/problem/E"}