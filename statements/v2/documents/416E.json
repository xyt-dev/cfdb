{"assets":["/statement-assets/ed4fe4309f5dc0ffea4fa3681f03d5d601d658b9c1a8aff22a91534f7cfc315c.png"],"contentKind":"statement","contestId":"416","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. President's Path"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Good old Berland has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" roads. Each road connects a pair of distinct cities and is bidirectional. Between any pair of cities, there is at most one road. For each road, we know its length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We also know that the President will soon ride along the Berland roads from city "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Naturally, he will choose one of the shortest paths from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", but nobody can say for sure which path he will choose."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Minister for Transport is really afraid that the President might get upset by the state of the roads in the country. That is the reason he is planning to repair the roads in the possible President's path."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Making the budget for such an event is not an easy task. For all possible distinct pairs "},{"kind":"math_inline","text":"s, t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"s < t"},{"kind":"text","text":") find the number of roads that lie on at least one shortest path from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integers "},{"kind":"math_inline","text":"n, m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 500"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ m ≤ n·(n - 1) / 2"},{"kind":"text","text":") — the number of cities and roads, correspondingly. Then "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follow, containing the road descriptions, one description per line. Each description contains three integers "},{"kind":"math_inline","text":"xi, yi, li"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ n, xi ≠ yi, 1 ≤ li ≤ 106"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"xi, yi"},{"kind":"text","text":" are the numbers of the cities connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road and "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" is its length."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the sequence of "},{"attrs":{"alt":"","src":"/statement-assets/ed4fe4309f5dc0ffea4fa3681f03d5d601d658b9c1a8aff22a91534f7cfc315c.png"},"kind":"image"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"c12, c13, ..., c1n, c23, c24, ..., c2n, ..., cn - 1, n"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"cst"},{"kind":"text","text":" is the number of roads that can lie on the shortest path from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Print the elements of sequence "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" in the described order. If the pair of cities "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" don't have a path between them, then "},{"kind":"math_inline","text":"cst = 0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6\n1 2 1\n2 3 1\n3 4 1\n4 1 1\n2 4 2\n4 5 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 4 1 2 1 5 6 1 2 1 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"416E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/416/problem/E"}