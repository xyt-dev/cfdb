{"assets":["/statement-assets/6b9879b708dee83d6e21755d823e2b71ea18ff41e7f2d611027b4fea4923d607.png","/statement-assets/55da88f9a2455e6117b3f6c53dc41caba8b3c602926c05f1251775567944934d.png","/statement-assets/b3bc94067e08e79af791507adde54680d17d1231bf1d7cc7835d5c8ff79ea43f.png"],"contentKind":"statement","contestId":"850","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Rainbow Balls"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a bag of balls of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different colors. You have "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" balls of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th color."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"While there are at least two different colored balls in the bag, perform the following steps: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Take out two random balls without replacement one by one. These balls might be the same color. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Color the second ball to the color of the first ball. You are not allowed to switch the order of the balls in this step. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Place both balls back in the bag. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" All these actions take exactly one second. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"M = 109 + 7"},{"kind":"text","text":". It can be proven that the expected amount of time needed before you stop can be represented as a rational number "},{"attrs":{"alt":"","src":"/statement-assets/6b9879b708dee83d6e21755d823e2b71ea18ff41e7f2d611027b4fea4923d607.png"},"kind":"image"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"P"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Q"},{"kind":"text","text":" are coprime integers and where "},{"kind":"math_inline","text":"Q"},{"kind":"text","text":" is not divisible by "},{"kind":"math_inline","text":"M"},{"kind":"text","text":". Return the value "},{"attrs":{"alt":"","src":"/statement-assets/55da88f9a2455e6117b3f6c53dc41caba8b3c602926c05f1251775567944934d.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input will contain a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2 500"},{"kind":"text","text":") — the number of colors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line of input will contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 105"},{"kind":"text","text":") — the number of balls of each color."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer, the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"750000026\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, no matter what happens, the balls will become the same color after one step."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second sample, we have 6 balls. Let’s label the balls from 1 to 6, and without loss of generality, let’s say balls 1,2,3 are initially color 1, balls 4,5 are color 2, and ball 6 are color 3."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here is an example of how these steps can go: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" We choose ball 5 and ball 6. Ball 6 then becomes color 2. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" We choose ball 4 and ball 5. Ball 5 remains the same color (color 2). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" We choose ball 1 and ball 5. Ball 5 becomes color 1. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" We choose ball 6 and ball 5. Ball 5 becomes color 2. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" We choose ball 3 and ball 4. Ball 4 becomes color 1. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" We choose ball 4 and ball 6. Ball 6 becomes color 1. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" We choose ball 2 and ball 5. Ball 5 becomes color 1. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" At this point, the game ends since all the balls are the same color. This particular sequence took 7 seconds."},{"children":[{"kind":"text","text":"It can be shown that the answer to this case is "},{"attrs":{"alt":"","src":"/statement-assets/b3bc94067e08e79af791507adde54680d17d1231bf1d7cc7835d5c8ff79ea43f.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"850F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/850/problem/F"}