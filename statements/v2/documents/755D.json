{"assets":["/statement-assets/8d2b75018d540b9dc77fe6fe61a03fa1ee4a6cf0db33870026b22b75f2efa393.png","/statement-assets/ccb331334c0601336f5f9537a570598353f73cc4ede9da97c21bddd498a306a4.png","/statement-assets/b0766a2d65ab8b1d65aa633a8fc76e6bd0fdb62886daa0c76de9087e061ce8d4.png","/statement-assets/41077863f3cb9d9c8545250eb9f54bbe37a6c3ef5793c0de02bed5d98bbddbc4.png","/statement-assets/95980ada604efbab9ed3b29c3026a8e8c384504e398d7b9e2bf5db9bb8fc5535.png","/statement-assets/083fe39b38e758a6ac025841422811c2bb7c4a9a012b0b7281e4964057376e81.png"],"contentKind":"statement","contestId":"755","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. PolandBall and Polygon"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"PolandBall has such a convex polygon with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" veritces that no three of its diagonals intersect at the same point. PolandBall decided to improve it and draw some red segments. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He chose a number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"gcd(n, k) = 1"},{"kind":"text","text":". Vertices of the polygon are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in a clockwise way. PolandBall repeats the following process "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" times, starting from the vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":": "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Assume you've ended last operation in vertex "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" (consider "},{"kind":"math_inline","text":"x = 1"},{"kind":"text","text":" if it is the first operation). Draw a new segment from vertex "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th next vertex in clockwise direction. This is a vertex "},{"kind":"math_inline","text":"x + k"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"x + k - n"},{"kind":"text","text":" depending on which of these is a valid index of polygon's vertex."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to calculate number of polygon's sections after each drawing. A section is a clear area inside the polygon bounded with drawn diagonals or the polygon's sides."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"There are only two numbers in the input: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"5 ≤ n ≤ 106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ k ≤ n - 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"gcd(n, k) = 1"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"You should print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" values separated by spaces. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th value should represent number of polygon's sections after drawing first "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" lines."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 3 5 8 11 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 3 4 6 9 12 16 21 26 31 "}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The greatest common divisor (gcd) of two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is the largest positive integer that divides both "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" without a remainder."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the first sample testcase, you should output \""},{"children":[{"kind":"text","text":"2 3 5 8 11"}],"kind":"container"},{"kind":"text","text":"\". Pictures below correspond to 