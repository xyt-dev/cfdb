{"assets":[],"contentKind":"statement","contestId":"2206","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"K. Time Display Stickers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a collection of $$$n$$$ digit stickers, represented by a string $$$S$$$ of length $$$n$$$. Each character of $$$S$$$ is a digit "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" through "},{"children":[{"kind":"text","text":"9"}],"kind":"container"},{"kind":"text","text":", representing one sticker of that digit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You want to create "},{"children":[{"kind":"text","text":"time displays"}],"kind":"container"},{"kind":"text","text":" using these stickers. Each time display shows a time in the format "},{"children":[{"kind":"text","text":"HH:MM"}],"kind":"container"},{"kind":"text","text":", where: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"HH"}],"kind":"container"},{"kind":"text","text":" is a two-digit hour between $$$00$$$ and $$$11$$$ (inclusive), and "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"MM"}],"kind":"container"},{"kind":"text","text":" is a two-digit minute between $$$00$$$ and $$$59$$$ (inclusive). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In other words, each time display requires exactly four stickers: two for the hours and two for the minutes. Each sticker can only be used for at 