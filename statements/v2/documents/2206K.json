ext","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n2\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Explanation for the sample input/output #1"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the first test case, you can create one time display "},{"children":[{"kind":"text","text":"10:59"}],"kind":"container"},{"kind":"text","text":". It can be shown that you cannot create two displays for a given collection of stickers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second test case, you can create two time displays: "},{"children":[{"kind":"text","text":"10:59"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"04:27"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the third test case, you can create two time displays: "},{"children":[{"kind":"text","text":"11:19"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"11:19"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the fourth test case, you cannot create any time displays."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"K","problemCode":"2206K","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2206/problem/K"}