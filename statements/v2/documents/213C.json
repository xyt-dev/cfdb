{"assets":["/statement-assets/93aaf2990852e274356b8e494250e594cc3eaf146f9609962a1da7c9cc55a295.png"],"contentKind":"statement","contestId":"213","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Relay Race"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Furik and Rubik take part in a relay race. The race will be set up on a large square with the side of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" meters. The given square is split into "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" cells (represented as unit squares), each cell has some number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At the beginning of the race Furik stands in a cell with coordinates "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":", and Rubik stands in a cell with coordinates "},{"kind":"math_inline","text":"(n, n)"},{"kind":"text","text":". Right after the start Furik runs towards Rubik, besides, if Furik stands at a cell with coordinates "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":", then he can move to cell "},{"kind":"math_inline","text":"(i + 1, j)"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"(i, j + 1)"},{"kind":"text","text":". After Furik reaches Rubik, Rubik starts running from cell with coordinates "},{"kind":"math_inline","text":"(n, n)"},{"kind":"text","text":" to cell with coordinates "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":". If Rubik stands in cell "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":", then he can move to cell "},{"kind":"math_inline","text":"(i - 1, j)"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"(i, j - 1)"},{"kind":"text","text":". Neither Furik, nor Rubik are allowed to go beyond the boundaries of the field; if a player goes beyond the boundaries, he will be disqualified. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To win the race, Furik and Rubik must earn as many points as possible. The number of points is the sum of numbers from the cells Furik and Rubik visited. "},{"children":[{"kind":"text","text":"Each cell counts only once in the sum"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print the maximum number of points Furik and Rubik can earn on the relay race."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"(1 ≤ n ≤ 300)"},{"kind":"text","text":". The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers each: the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th number on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line "},{"kind":"math_inline","text":"ai, j"},{"kind":"math_inline","text":"( - 1000 ≤ ai, j ≤ 1000)"},{"kind":"text","text":" is the number written in the cell with coordinates "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On a single line print a single number — the answer to the problem. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n11 14\n16 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"53\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n25 16 25\n12 18 19\n11 13 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"136\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Comments to the second sample: The profitable path for Furik is: "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 2)"},{"kind":"text","text":", and for Rubik: "},{"kind":"math_inline","text":"(2, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Comments to the third sample: The optimal path for Furik is: "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 3)"},{"kind":"text","text":", and for Rubik: "},{"kind":"math_inline","text":"(3, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":". The figure to the sample: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/93aaf2990852e274356b8e494250e594cc3eaf146f9609962a1da7c9cc55a295.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" Furik's path is marked with yellow, and Rubik's path is marked with pink."}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"213C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/213/problem/C"}