{"assets":[],"contentKind":"statement","contestId":"180","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Name"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Everything got unclear to us in a far away constellation Tau Ceti. Specifically, the Taucetians choose names to their children in a very peculiar manner."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two young parents "},{"children":[{"kind":"text","text":"abac"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"bbad"}],"kind":"container"},{"kind":"text","text":" think what name to give to their first-born child. They decided that the name will be the permutation of letters of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". To keep up with the neighbours, they decided to call the baby so that the name was lexicographically strictly larger than the neighbour's son's name "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the other hand, they suspect that a name tax will be introduced shortly. According to it, the Taucetians with lexicographically "},{"children":[{"kind":"text","text":"larger"}],"kind":"container"},{"kind":"text","text":" names will pay "},{"children":[{"kind":"text","text":"larger"}],"kind":"container"},{"kind":"text","text":" taxes. That's the reason "},{"children":[{"kind":"text","text":"abac"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"bbad"}],"kind":"container"},{"kind":"text","text":" want to call the newborn so that the name was lexicographically strictly larger than name "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" and lexicographically minimum at that."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The lexicographical order of strings is the order we are all used to, the \"dictionary\" order. Such comparison is used in all modern programming languages to compare strings. Formally, a string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is lexicographically less than string "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", if one of the two statements is correct:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"n < m"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is the beginning (prefix) of string "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" (for example, \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\" is less than string \""},{"children":[{"kind":"text","text":"abaa"}],"kind":"container"},{"kind":"text","text":"\"), "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"p1 = q1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p2 = q2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"pk - 1 = qk - 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"pk < qk"},{"kind":"text","text":" for some "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ min(n, m)"},{"kind":"text","text":"), here characters in strings are numbered starting from 1. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Write a program that, given string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and the heighbours' child's name "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" determines the string that is the result of permutation of letters in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". The string should be lexicographically strictly more than "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" and also, lexicographically minimum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a non-empty string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 5000"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":" is its length. The second line contains a non-empty string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |t| ≤ 5000"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"|t|"},{"kind":"text","text":" is its length. Both strings consist of lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the sought name or "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if it doesn't exist."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"aad\naac\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"aad\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abad\nbob\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"daab\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abc\ndefg\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"czaaab\nabcdef\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"abczaa\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the given string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is the sought one, consequently, we do not need to change the letter order there."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"180D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/180/problem/D"}