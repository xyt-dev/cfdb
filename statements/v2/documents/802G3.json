{"assets":["/statement-assets/1f85faed2793bbcbc0b4474c16a911abb6ceb648146c2e22cac2ab3d52af9122.png","/statement-assets/d1eea87111e194adb254cefafb857b0b814997ab1d1aaba99d096b5d6b5768dc.png"],"contentKind":"statement","contestId":"802","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G3. Fake News (hard)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Now that you have proposed a fake post for the HC"},{"kind":"math_inline","text":"2"},{"kind":"text","text":" Facebook page, Heidi wants to measure the quality of the post before actually posting it. She recently came across a (possibly fake) article about the impact of fractal structure on multimedia messages and she is now trying to measure the self-similarity of the message, which is defined as"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1f85faed2793bbcbc0b4474c16a911abb6ceb648146c2e22cac2ab3d52af9122.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"where the sum is over all nonempty strings "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/statement-assets/d1eea87111e194adb254cefafb857b0b814997ab1d1aaba99d096b5d6b5768dc.png"},"kind":"image"},{"kind":"text","text":" is the number of occurences of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" as a "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":". (Note that the sum is infinite, but it only has a finite number of nonzero summands.)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Heidi refuses to do anything else until she knows how to calculate this self-similarity. Could you please help her? (If you would like to instead convince Heidi that a finite string cannot be a fractal anyway – do not bother, we have already tried.)"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input starts with a line indicating the number of test cases "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ T ≤ 10"},{"kind":"text","text":"). After that, "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" test cases follow, each of which consists of one line containing a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 100 000"},{"kind":"text","text":") composed of lowercase letters ("},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"-"},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" lines, every line containing one number – the answer to the corresponding test case."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\naa\nabcd\nccc\nabcc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n10\n14\n12\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" contains another string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" as a substring if "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is a contiguous subsequence of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". For example, "},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":" is a substring of "},{"children":[{"kind":"text","text":"cab"}],"kind":"container"},{"kind":"text","text":" but not of "},{"children":[{"kind":"text","text":"acb"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G3","problemCode":"802G3","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/802/problem/G3"}