{"assets":["/statement-assets/f50de49b74510f79e98538b5c1d53ed02952f8eacc22a33950adcbc3befc19c7.png","/statement-assets/0a91bd2e9a9dfd5b3eeb333927b70f28e951ee800c27fdbd95d606299169c04e.png"],"contentKind":"statement","contestId":"985","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Sand Fortress"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are going to the beach with the idea to build the greatest sand castle ever in your head! The beach is not as three-dimensional as you could have imagined, it can be decribed as a line of spots to pile up sand pillars. Spots are numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through infinity from left to right. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Obviously, there is not enough sand on the beach, so you brought "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" packs of sand with you. Let height "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" of the sand pillar on some spot "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" be the number of sand packs you spent on it. "},{"children":[{"kind":"text","text":"You can't split a sand pack to multiple pillars, all the sand from it should go to a single one."}],"kind":"container"},{"kind":"text","text":" There is a fence of height equal to the height of pillar with "},{"kind":"math_inline","text":"H"},{"kind":"text","text":" sand packs to the left of the first spot and you should prevent sand from going over it. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Finally you ended up with the following conditions to building the castle:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"h1 ≤ H"},{"kind":"text","text":": no sand from the leftmost spot should go over the fence; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For any "},{"attrs":{"alt":"","src":"/statement-assets/f50de49b74510f79e98538b5c1d53ed02952f8eacc22a33950adcbc3befc19c7.png"},"kind":"image"},{"kind":"math_inline","text":"|hi - hi + 1| ≤ 1"},{"kind":"text","text":": large difference in heights of two neighboring pillars can lead sand to fall down from the higher one to the lower, you really don't want this to happen; "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0a91bd2e9a9dfd5b3eeb333927b70f28e951ee800c27fdbd95d606299169c04e.png"},"kind":"image"},{"kind":"text","text":": you want to spend all the sand you brought with you. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"As you have infinite spots to build, it is always possible to come up with some valid castle structure. Though you want the castle to be as compact as possible. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to calculate the minimum number of spots you can occupy so that all the aforementioned conditions hold."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains two integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"H"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, H ≤ 1018"},{"kind":"text","text":") — the number of sand packs you have and the height of the fence, respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of spots you can occupy so the all the castle building conditions hold."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here are the heights of some valid castles: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"n = 5, H = 2, [2, 2, 1, 0, ...], [2, 1, 1, 1, 0, ...], [1, 0, 1, 2, 1, 0, ...]"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"n = 6, H = 8, [3, 2, 1, 0, ...], [2, 2, 1, 1, 0, ...], [0, 1, 0, 1, 2, 1, 1, 0...]"},{"kind":"text","text":" (this one has "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" spots occupied) "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The first list for both cases is the optimal answer, "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" spots are occupied in them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"And here are some invalid ones:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"n = 5, H = 2, [3, 2, 0, ...], [2, 3, 0, ...], [1, 0, 2, 2, ...]"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"n = 6, H = 8, [2, 2, 2, 0, ...], [6, 0, ...], [1, 4, 1, 0...], [2, 2, 1, 0, ...]"}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"985D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/985/problem/D"}