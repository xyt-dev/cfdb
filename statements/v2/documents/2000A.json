{"assets":[],"contentKind":"statement","contestId":"2000","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Primary Task"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dmitry wrote down $$$t$$$ integers on the board, and that is good. He is sure that he lost an "},{"children":[{"kind":"text","text":"important"}],"kind":"container"},{"kind":"text","text":" integer $$$n$$$ among them, and that is bad."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The integer $$$n$$$ had the form $$$\\text{10^x}$$$ ($$$x \\ge 2$$$), where the symbol '$$$\\text{^}$$$' denotes exponentiation.. Something went wrong, and Dmitry missed the symbol '$$$\\text{^}$$$' when writing the "},{"children":[{"kind":"text","text":"important"}],"kind":"container"},{"kind":"text","text":" integer. For example, instead of the integer $$$10^5$$$, he would have written $$$105$$$, and instead of $$$10^{19}$$$, he would have written $$$1019$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Dmitry wants to understand which of the integers on the board could have been the "},{"children":[{"kind":"text","text":"important"}],"kind":"container"},{"kind":"text","text":" integer and which could not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of integers on the board."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$t$$$ lines each contain an integer $$$a$$$ ($$$1 \\le a \\le 10000$$$) — the next integer from the board."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each integer on the board, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if it could have been the "},{"children":[{"kind":"text","text":"important"}],"kind":"container"},{"kind":"text","text":" integer and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may output each letter in any case (lowercase or uppercase). For example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be accepted as a positive answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n100\n1010\n101\n105\n2033\n1019\n1002\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\nYES\nNO\nYES\nNO\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2000A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2000/problem/A"}