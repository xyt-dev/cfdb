{"assets":[],"contentKind":"statement","contestId":"1594","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Ideal Farm"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Theofanis decided to visit his uncle's farm. There are $$$s$$$ animals and $$$n$$$ animal pens on the farm. For utility purpose, animal pens are constructed in one row."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Uncle told Theofanis that a farm is "},{"children":[{"kind":"text","text":"lucky"}],"kind":"container"},{"kind":"text","text":" if you can distribute all animals in all pens in such a way that there are no empty pens and there is at least one continuous segment of pens that has exactly $$$k$$$ animals in total."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Moreover, a farm is "},{"children":[{"kind":"text","text":"ideal"}],"kind":"container"},{"kind":"text","text":" if it's lucky for any distribution without empty pens."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Neither Theofanis nor his uncle knows if their farm is ideal or not. Can you help them to figure it out?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^5$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first and only line of each test case contains three integers $$$s$$$, $$$n$$$, and $$$k$$$ ($$$1 \\le s, n, k \\le 10^{18}$$$; $$$n \\le s$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" (case-insensitive), if the farm is ideal, or "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" (case-insensitive) otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 1 1\n1 1 2\n100 50 200\n56220 47258 14497\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first and the second test case, the only possible combination is $$$[1]$$$ so there always will be a subsegment with $$$1$$$ animal but not with $$$2$$$ animals."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1594F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1594/problem/F"}