{"assets":["/statement-assets/4deb64064f69ad65c01f03184ca7caa3d7f1a34d61eb0bded1dc46f3b98f0f13.png","/statement-assets/a7c6c825aed053c6fb190cb3e158bcd07cdafa3f8f95d721cfaf153852ad0285.png","/statement-assets/58769defbe8bbce8fc5c266179ca363191207fbead4bb63ab18c5a362381fc7f.png","/statement-assets/d0fb4facc3b98c0742a3dad014715c0c7a1c0648a828b6c7fbd6ef2c4fab9f36.png","/statement-assets/6b1e07c33e2640edc7a5d27a29f026a5c55b76fe8b432cedfedfa349433f34d7.png","/statement-assets/b1cff6afc1ccd1b23cc2fd822f4af1730bc7b8b654e67c67d691ba07d52eb0c9.png","/statement-assets/afb94fc37e5314850e481612f0843b76ace7d699bc97751bfc0f52d99f0ab442.png"],"contentKind":"statement","contestId":"228","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Zigzag"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The court wizard Zigzag wants to become a famous mathematician. For that, he needs his own theorem, like the Cauchy theorem, or his sum, like the Minkowski sum. But most of all he wants to have his sequence, like the Fibonacci sequence, and his function, like the Euler's totient function."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Zigag's sequence with the zigzag factor z is an infinite sequence "},{"kind":"math_inline","text":"Siz"},{"kind":"math_inline","text":"(i ≥ 1; z ≥ 2)"},{"kind":"text","text":", that is determined as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"Siz = 2"},{"kind":"text","text":", when "},{"attrs":{"alt":"","src":"/statement-assets/4deb64064f69ad65c01f03184ca7caa3d7f1a34d61eb0bded1dc46f3b98f0f13.png"},"kind":"image"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a7c6c825aed053c6fb190cb3e158bcd07cdafa3f8f95d721cfaf153852ad0285.png"},"kind":"image"},{"kind":"text","text":", when "},{"attrs":{"alt":"","src":"/statement-assets/58769defbe8bbce8fc5c266179ca363191207fbead4bb63ab18c5a362381fc7f.png"},"kind":"image"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d0fb4facc3b98c0742a3dad014715c0c7a1c0648a828b6c7fbd6ef2c4fab9f36.png"},"kind":"image"},{"kind":"text","text":", when "},{"attrs":{"alt":"","src":"/statement-assets/6b1e07c33e2640edc7a5d27a29f026a5c55b76fe8b432cedfedfa349433f34d7.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Operation "},{"attrs":{"alt":"","src":"/statement-assets/b1cff6afc1ccd1b23cc2fd822f4af1730bc7b8b654e67c67d691ba07d52eb0c9.png"},"kind":"image"},{"kind":"text","text":" means taking the remainder from dividing number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by number "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". For example, the beginning of sequence "},{"kind":"math_inline","text":"Si3"},{"kind":"text","text":" (zigzag factor 3) looks as follows: 1, 2, 3, 2, 1, 2, 3, 2, 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's assume that we are given an array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. Let's define element number "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ n)"},{"kind":"text","text":" of the array as "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". The Zigzag function is function "},{"attrs":{"alt":"","src":"/statement-assets/afb94fc37e5314850e481612f0843b76ace7d699bc97751bfc0f52d99f0ab442.png"},"kind":"image"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"l, r, z"},{"kind":"text","text":" satisfy the inequalities "},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"z ≥ 2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To become better acquainted with the Zigzag sequence and the Zigzag function, the wizard offers you to implement the following operations on the given array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The assignment operation. The operation parameters are "},{"kind":"math_inline","text":"(p, v)"},{"kind":"text","text":". The operation denotes assigning value "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to the "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"-th array element. After the operation is applied, the value of the array element "},{"kind":"math_inline","text":"ap"},{"kind":"text","text":" equals "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The Zigzag operation. The operation parameters are "},{"kind":"math_inline","text":"(l, r, z)"},{"kind":"text","text":". The operation denotes calculating the Zigzag function "},{"kind":"math_inline","text":"Z(l, r, z)"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Explore the magical powers of zigzags, implement the described operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":" — The number of elements in array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers: "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(1 ≤ ai ≤ 109)"},{"kind":"text","text":" — the elements of the array. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains integer "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ m ≤ 105)"},{"kind":"text","text":" — the number of operations. Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the operations' descriptions. An operation's description starts with integer "},{"kind":"math_inline","text":"ti"},{"kind":"math_inline","text":"(1 ≤ ti ≤ 2)"},{"kind":"text","text":" — the operation type. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"ti = 1"},{"kind":"text","text":" (assignment operation), then on the line follow two space-separated integers: "},{"kind":"math_inline","text":"pi, vi"},{"kind":"math_inline","text":"(1 ≤ pi ≤ n; 1 ≤ vi ≤ 109)"},{"kind":"text","text":" — the parameters of the assigning operation. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"ti = 2"},{"kind":"text","text":" (Zigzag operation), then on the line follow three space-separated integers: "},{"kind":"math_inline","text":"li, ri, zi"},{"kind":"math_inline","text":"(1 ≤ li ≤ ri ≤ n; 2 ≤ zi ≤ 6)"},{"kind":"text","text":" — the parameters of the Zigzag operation. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You should execute the operations in the order, in which they are given in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each Zigzag operation print the calculated value of the Zigzag function on a single line. Print the values for Zigzag functions in the order, in which they are given in the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2 3 1 5 5\n4\n2 2 3 2\n2 1 5 3\n1 3 5\n2 1 5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n26\n38\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Explanation of the sample test: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Result of the first operation is "},{"kind":"math_inline","text":"Z(2, 3, 2) = 3·1 + 1·2 = 5"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Result of the second operation is "},{"kind":"math_inline","text":"Z(1, 5, 3) = 2·1 + 3·2 + 1·3 + 5·2 + 5·1 = 26"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After the third operation array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"2, 3, 5, 5, 5"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Result of the forth operation is "},{"kind":"math_inline","text":"Z(1, 5, 3) = 2·1 + 3·2 + 5·3 + 5·2 + 5·1 = 38"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"228D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/228/problem/D"}