{"assets":["/statement-assets/f8f70451d188fa3be6c0b4b8d511af02265f863069ec90bf2582f9606a050d4b.png","/statement-assets/d1d442ef846c0c26892aef75cc0acc6583bdc6dbc924bcb5fe443bce169c155e.png","/statement-assets/c7ba8e3af5127f7e9f1d4d23d155acc51c030079913b0b741f7f5d3ddb01751d.png","/statement-assets/9023e1522e47421da320f5b11e27cd200f7e97dc8a3c89ba8e46bdbd1692fe8a.png","/statement-assets/e20f3318542907615a1846b10862949f83305b9f9d0c29331a9f8f224a5ecbcf.png","/statement-assets/fed9bdc3458e6c7655941a4a0fa94fe3716334a3061117d143b8e7c6573a9e7e.png","/statement-assets/05b95c28aa7ecbf5ebb54d922e21305e72a7fc9d323232fd9b79bcf69199bbe8.png"],"contentKind":"statement","contestId":"706","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Vasiliy's Multiset"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Author has gone out of the stories about Vasiliy, so here is just a formal task description."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries and a multiset "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", initially containing only integer "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". There are three types of queries:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"+ x"}],"kind":"container"},{"kind":"text","text":"\" — add integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to multiset "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"- x"}],"kind":"container"},{"kind":"text","text":"\" — erase one occurrence of integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" from multiset "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". It's guaranteed that at least one "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is present in the multiset "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" before this query."}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"? x"}],"kind":"container"},{"kind":"text","text":"\" — you are given integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and need to compute the value "},{"attrs":{"alt":"","src":"/statement-assets/f8f70451d188fa3be6c0b4b8d511af02265f863069ec90bf2582f9606a050d4b.png"},"kind":"image"},{"kind":"text","text":", i.e. the maximum value of bitwise exclusive OR (also know as XOR) of integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and some integer "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" from the multiset "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Multiset is a set, where equal elements are allowed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 200 000"},{"kind":"text","text":") — the number of queries Vasiliy has to perform."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines of the input contains one of three characters '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"' and an integer "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ 109"},{"kind":"text","text":"). It's guaranteed that there is at least one query of the third type."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note, that the integer "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" will always be present in the set "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the type '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"' print one integer — the maximum value of bitwise exclusive OR (XOR) of integer "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and some integer from the multiset "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n+ 8\n+ 9\n+ 11\n+ 6\n+ 1\n? 3\n- 8\n? 3\n? 8\n? 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n10\n14\n13\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"After first five operations multiset "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" contains integers "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"8"},{"kind":"text","text":", "},{"kind":"math_inline","text":"9"},{"kind":"text","text":", "},{"kind":"math_inline","text":"11"},{"kind":"text","text":", "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer for the sixth query is integer "},{"attrs":{"alt":"","src":"/statement-assets/d1d442ef846c0c26892aef75cc0acc6583bdc6dbc924bcb5fe443bce169c155e.png"},"kind":"image"},{"kind":"text","text":" — maximum among integers "},{"attrs":{"alt":"","src":"/statement-assets/c7ba8e3af5127f7e9f1d4d23d155acc51c030079913b0b741f7f5d3ddb01751d.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/9023e1522e47421da320f5b11e27cd200f7e97dc8a3c89ba8e46bdbd1692fe8a.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/e20f3318542907615a1846b10862949f83305b9f9d0c29331a9f8f224a5ecbcf.png"},"kind":"image"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/fed9bdc3458e6c7655941a4a0fa94fe3716334a3061117d143b8e7c6573a9e7e.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/statement-assets/05b95c28aa7ecbf5ebb54d922e21305e72a7fc9d323232fd9b79bcf69199bbe8.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"706D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/706/problem/D"}