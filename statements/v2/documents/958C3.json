{"assets":["/statement-assets/0291670b1c222c0523e3621328e8f10e0752969ac7403eb9dfcb77aedf3a1d0b.png"],"contentKind":"statement","contestId":"958","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C3. Encryption (hard)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2.2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Heidi is now just one code away from breaking the encryption of the Death Star plans. The screen that should be presenting her with the description of the next code looks almost like the previous one, though who would have thought that the evil Empire engineers would fill this small screen with several million digits! It is just ridiculous to think that anyone would read them all..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Heidi is once again given a sequence "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and two integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". She needs to find out what the encryption key "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" is."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" be a sequence of integers, and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" a positive integer. We define the "},{"children":[{"kind":"text","text":"score"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" to be the sum of the elements of "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Heidi is given a sequence "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" that consists of "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" integers, and also given integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". Her goal is to split "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" parts such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Each part contains at least "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" element of "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", and each part consists of contiguous elements of "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" No two parts overlap. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The total sum "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" of the scores of those parts is "},{"children":[{"kind":"text","text":"minimized"}],"kind":"container"},{"kind":"text","text":" (not maximized!). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Output the sum "},{"kind":"math_inline","text":"S"},{"kind":"text","text":", which is the encryption code."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three space-separated integers "},{"kind":"math_inline","text":"N"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"k ≤ N ≤ 500 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ k ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ p ≤ 100"},{"kind":"text","text":") – the number of elements in "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", the number of parts "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" should be split into, and the modulo for computing scores, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" space-separated integers that are the elements of "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". Each integer is from the interval "},{"kind":"math_inline","text":"[1, 1 000 000]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the number "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" as described in the problem statement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 10\n3 4 7 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 5 12\n16 3 24 13 9 8 7 5 12 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, if the input sequence is split as "},{"kind":"math_inline","text":"(3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(4, 7)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2)"},{"kind":"text","text":", the total score would be "},{"attrs":{"alt":"","src":"/statement-assets/0291670b1c222c0523e3621328e8f10e0752969ac7403eb9dfcb77aedf3a1d0b.png"},"kind":"image"},{"kind":"text","text":". It is easy to see that this score is the smallest possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, one possible way to obtain score "},{"kind":"math_inline","text":"13"},{"kind":"text","text":" is to make the following split: "},{"kind":"math_inline","text":"(16, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(24)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(13)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(9, 8)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(7, 5, 12, 12)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C3","problemCode":"958C3","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/958/problem/C3"}