{"assets":[],"contentKind":"statement","contestId":"359","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Neatness"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Simon loves neatness. So before he goes to bed, Simon wants to complete all chores in the house."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Simon's house looks like a rectangular table consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" columns from above. All rows of the table are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from top to bottom. All columns of the table are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right. Each cell of the table is a room. Pair "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" denotes the room, located at the intersection of the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-th row and the "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"-th column. For each room we know if the light is on or not there."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially Simon is in room "},{"kind":"math_inline","text":"(x0, y0)"},{"kind":"text","text":". He wants to turn off the lights in all the rooms in the house, and then return to room "},{"kind":"math_inline","text":"(x0, y0)"},{"kind":"text","text":". Suppose that at the current moment Simon is in the room "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":". To reach the desired result, he can perform the following steps:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The format of the action is \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\". The action is to turn on the light in room "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":". Simon cannot do it if the room already has light on. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The format of the action is \""},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":"\". The action is to turn off the light in room "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":". Simon cannot do it if the room already has light off. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The format of the action is \""},{"children":[{"kind":"text","text":"dir"}],"kind":"container"},{"kind":"text","text":"\" ("},{"kind":"math_inline","text":"dir"},{"kind":"text","text":" is a character). The action is to move to a side-adjacent room in direction "},{"kind":"math_inline","text":"dir"},{"kind":"text","text":". The direction can be left, right, up or down (the corresponding dir is "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"). Additionally, Simon can move only if he see a light in the direction "},{"kind":"math_inline","text":"dir"},{"kind":"text","text":". More formally, if we represent the room, Simon wants to go, as "},{"kind":"math_inline","text":"(nx, ny)"},{"kind":"text","text":", there shold be an integer "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(k > 0)"},{"kind":"text","text":", that room "},{"kind":"math_inline","text":"(x + (nx - x)k, y + (ny - y)k)"},{"kind":"text","text":" has a light. Of course, Simon cannot move out of his house. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Simon, find the sequence of actions that lets him achieve the desired result."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three positive integers "},{"kind":"math_inline","text":"n, x0, y0"},{"kind":"math_inline","text":"(2 ≤ n ≤ 500, 1 ≤ x0, y0 ≤ n)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the description of rooms in the house. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"ai1, ai2, ..., ain"},{"kind":"text","text":". If number "},{"kind":"math_inline","text":"aij"},{"kind":"text","text":" equals zero, then room "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" has light off, and if number "},{"kind":"math_inline","text":"aij"},{"kind":"text","text":" equals one, then room "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" has light on. It is guaranteed that at least one room has light on."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no desired sequence of actions, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes). Otherwise, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) and the description of the required sequence of actions as a string. Note that you do not have to minimize the length of the sequence of actions but you shouldn't use more than "},{"kind":"math_inline","text":"3·106"},{"kind":"text","text":" actions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 1\n1 0 0\n0 1 0\n1 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nD1R2L2D2UU2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 1\n1 0 0\n0 1 0\n0 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"359E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/359/problem/E"}