{"assets":[],"contentKind":"statement","contestId":"2043","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Coin Transformation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Initially, you have a coin with value $$$n$$$. You can perform the following operation any number of times (possibly zero):"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" transform one coin with value $$$x$$$, where $$$x$$$ is "},{"children":[{"kind":"text","text":"greater than $$$3$$$"}],"kind":"container"},{"kind":"text","text":" ($$$x \\gt 3$$$), into two coins with value $$$\\lfloor \\frac{x}{4} \\rfloor$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"What is the maximum number of coins you can have after performing this operation any number of times?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of one line containing one integer $$$n$$$ ($$$1 \\le n \\le 10^{18}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer — the maximum number of coins you can have after performing the operation any number of times."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1\n5\n16\n1000000000000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n4\n536870912\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, you have a coin of value $$$1$$$, and you can't do anything with it. So, the answer is $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, you can transform a coin of value $$$5$$$ into two coins with value $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, you can transform a coin of value $$$16$$$ into two coins with value $$$4$$$. Each of the resulting coins can be transformed into two coins with value $$$1$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2043A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2043/problem/A"}