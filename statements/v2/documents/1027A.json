{"assets":[],"contentKind":"statement","contestId":"1027","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Palindromic Twist"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ consisting of $$$n$$$ lowercase Latin letters. $$$n$$$ is even."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each position $$$i$$$ ($$$1 \\le i \\le n$$$) in string $$$s$$$ you are required to change the letter on this position either to the previous letter in alphabetic order or to the next one (letters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"' have only one of these options). Letter in every position must be changed "},{"children":[{"kind":"text","text":"exactly once"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, letter '"},{"children":[{"kind":"text","text":"p"}],"kind":"container"},{"kind":"text","text":"' should be changed either to '"},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"' or to '"},{"children":[{"kind":"text","text":"q"}],"kind":"container"},{"kind":"text","text":"', letter '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' should be changed to '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' and letter '"},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"' should be changed to '"},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"That way string \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\", for example, can be changed to \""},{"children":[{"kind":"text","text":"dpedepqbft"}],"kind":"container"},{"kind":"text","text":"\" ('"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"' $$$\\rightarrow$$$ '"},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"' $$$\\rightarrow$$$ '"},{"children":[{"kind":"text","text":"p"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":"' $$$\\rightarrow$$$ '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"' $$$\\rightarrow$$$ '"},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"f"}],"kind":"container"},{"kind":"text","text":"' $$$\\rightarrow$$$ '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"' $$$\\rightarrow$$$ '"},{"children":[{"kind":"text","text":"p"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"' $$$\\rightarrow$$$ '"},{"children":[{"kind":"text","text":"q"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"' $$$\\rightarrow$$$ '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"' $$$\\rightarrow$$$ '"},{"children":[{"kind":"text","text":"f"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":"' $$$\\rightarrow$$$ '"},{"children":[{"kind":"text","text":"t"}],"kind":"container"},{"kind":"text","text":"')."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"String $$$s$$$ is called a palindrome if it reads the same from left to right and from right to left. For example, strings \""},{"children":[{"kind":"text","text":"abba"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"zz"}],"kind":"container"},{"kind":"text","text":"\" are palindromes and strings \""},{"children":[{"kind":"text","text":"abca"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"zy"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your goal is to check if it's possible to make string $$$s$$$ a palindrome by applying the aforementioned changes to every position. Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if string $$$s$$$ can be transformed to a palindrome and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each testcase contains several strings, for each of them you are required to solve the problem separately."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$T$$$ ($$$1 \\le T \\le 50$$$) — the number of strings in a testcase."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$2T$$$ lines follow — lines $$$(2i - 1)$$$ and $$$2i$$$ of them describe the $$$i$$$-th string. The first line of the pair contains a single integer $$$n$$$ ($$$2 \\le n \\le 100$$$, $$$n$$$ is even) — the length of the corresponding string. The second line of the pair contains a string $$$s$$$, consisting of $$$n$$$ lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$T$$$ lines. The $$$i$$$-th line should contain the answer to the $$$i$$$-th string of the input. Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if it's possible to make the $$$i$$$-th string a palindrome by applying the aforementioned changes to every position. Print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n6\nabccba\n2\ncf\n4\nadfa\n8\nabaazaba\n2\nml\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nNO\nYES\nNO\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first string of the example can be changed to \""},{"children":[{"kind":"text","text":"bcbbcb"}],"kind":"container"},{"kind":"text","text":"\", two leftmost letters and two rightmost letters got changed to the next letters, two middle letters got changed to the previous letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second string can be changed to \""},{"children":[{"kind":"text","text":"be"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"bg"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"de"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"dg"}],"kind":"container"},{"kind":"text","text":"\", but none of these resulting strings are palindromes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third string can be changed to \""},{"children":[{"kind":"text","text":"beeb"}],"kind":"container"},{"kind":"text","text":"\" which is a palindrome."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fifth string can be changed to \""},{"children":[{"kind":"text","text":"lk"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"lm"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"nk"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"nm"}],"kind":"container"},{"kind":"text","text":"\", but none of these resulting strings are palindromes. Also note that no letter can remain the same, so you can't obtain strings \""},{"children":[{"kind":"text","text":"ll"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"mm"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1027A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1027/problem/A"}