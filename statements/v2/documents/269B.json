{"assets":[],"contentKind":"statement","contestId":"269","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Greenhouse Effect"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Emuskald is an avid horticulturist and owns the world's longest greenhouse — it is effectively infinite in length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Over the years Emuskald has cultivated "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" plants in his greenhouse, of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" different plant species numbered from 1 to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". His greenhouse is very narrow and can be viewed as an infinite line, with each plant occupying a single point on that line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Emuskald has discovered that each species thrives at a different temperature, so he wants to arrange "},{"kind":"math_inline","text":"m - 1"},{"kind":"text","text":" borders that would divide the greenhouse into "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" sections numbered from 1 to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" from left to right with each section housing a single species. He is free to place the borders, but in the end all of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th species plants must reside in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th section from the left."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Of course, it is not always possible to place the borders in such way, so Emuskald needs to replant some of his plants. He can remove each plant from its position and place it anywhere in the greenhouse (at "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" real coordinate) with no plant already in it. Since replanting is a lot of stress for the plants, help Emuskald find the minimum number of plants he has to replant to be able to place the borders."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 5000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n ≥ m"},{"kind":"text","text":"), the number of plants and the number of different species. Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain two space-separated numbers: one integer number "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ si ≤ m"},{"kind":"text","text":"), and one real number "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ xi ≤ 109"},{"kind":"text","text":"), the species and position of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th plant. Each "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" will contain no more than 6 digits after the decimal point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" are different; there is at least one plant of each species; the plants are given in order \"from left to the right\", that is in the ascending order of their "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" coordinates "},{"kind":"math_inline","text":"(xi < xi + 1, 1 ≤ i < n)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the minimum number of plants to be replanted."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n2 1\n1 2.0\n1 3.100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 5.0\n2 5.5\n3 6.0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3\n1 14.284235\n2 17.921382\n1 20.328172\n3 20.842331\n1 25.790145\n1 27.204125\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, Emuskald can replant the first plant to the right of the last plant, so the answer is 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the species are already in the correct order, so no replanting is needed."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"269B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/269/problem/B"}