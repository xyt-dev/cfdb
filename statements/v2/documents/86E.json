{"assets":["/statement-assets/92b3b47ec8105eb5f831889a79c99135267b3dd12555570fcc09007435798e52.png","/statement-assets/b3a74b0f72be680131725f4e0a152573de61b65379620ca41e9695a9425ba7fc.png","/statement-assets/5c0c027a8ec940e01a835b180b5a73f7aeac1e53f262ac54f0a66843404c1a99.png"],"contentKind":"statement","contestId":"86","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Long sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A sequence "},{"kind":"math_inline","text":"a0, a1, ..."},{"kind":"text","text":" is called a "},{"children":[{"kind":"text","text":"recurrent binary sequence"}],"kind":"container"},{"kind":"text","text":", if each term "},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"(i = 0, 1, ...)"},{"kind":"text","text":" is equal to 0 or 1 and there exist coefficients "},{"attrs":{"alt":"","src":"/statement-assets/92b3b47ec8105eb5f831889a79c99135267b3dd12555570fcc09007435798e52.png"},"kind":"image"},{"kind":"text","text":" such that "}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"an = c1·an - 1 + c2·an - 2 + ... + ck·an - k (mod 2), "}],"kind":"container"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"n ≥ k"},{"kind":"text","text":". Assume that not all of "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" are zeros."},{"children":[{"kind":"text","text":"Note that such a sequence can be uniquely recovered from any "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-tuple "},{"kind":"math_inline","text":"{as, as + 1, ..., as + k - 1}"},{"kind":"text","text":" and so it is periodic. Moreover, if a "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-tuple contains only zeros, then the sequence contains only zeros, so this case is not very interesting. Otherwise the minimal period of the sequence is not greater than "},{"kind":"math_inline","text":"2k - 1"},{"kind":"text","text":", as "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-tuple determines next element, and there are "},{"kind":"math_inline","text":"2k - 1"},{"kind":"text","text":" non-zero "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-tuples. Let us call a sequence "},{"children":[{"kind":"text","text":"long"}],"kind":"container"},{"kind":"text","text":" if its minimal period is exactly "},{"kind":"math_inline","text":"2k - 1"},{"kind":"text","text":". Your task is to find a long sequence for a given "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", if there is any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Input contains a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ k ≤ 50"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no long sequence for a given "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", output \"-1\" (without quotes). Otherwise the first line of the output should contain "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integer numbers: "},{"kind":"math_inline","text":"c1, c2, ..., ck"},{"kind":"text","text":" (coefficients). The second line should contain first "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" elements of the sequence: "},{"kind":"math_inline","text":"a0, a1, ..., ak - 1"},{"kind":"text","text":". All of them (elements and coefficients) should be equal to 0 or 1, and at least one "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" has to be equal to 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several solutions, output any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n1 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 1 1\n1 1 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"1. In the first sample: "},{"kind":"math_inline","text":"c1 = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c2 = 1"},{"kind":"text","text":", so "},{"kind":"math_inline","text":"an = an - 1 + an - 2  (mod 2)"},{"kind":"text","text":". Thus the sequence will be:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b3a74b0f72be680131725f4e0a152573de61b65379620ca41e9695a9425ba7fc.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"so its period equals "},{"kind":"math_inline","text":"3 = 22 - 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2. In the second sample: "},{"kind":"math_inline","text":"c1 = 0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c2 = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c3 = 1"},{"kind":"text","text":", so "},{"kind":"math_inline","text":"an = an - 2 + an - 3  (mod 2)"},{"kind":"text","text":". Thus our sequence is:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5c0c027a8ec940e01a835b180b5a73f7aeac1e53f262ac54f0a66843404c1a99.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"and its period equals "},{"kind":"math_inline","text":"7 = 23 - 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Periods are colored."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"86E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/86/problem/E"}