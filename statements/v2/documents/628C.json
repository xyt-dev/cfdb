{"assets":["/statement-assets/ca5f8ee48a2c9f76d7f3c3d9b2cd1ea5631360afbf5a128355ab40ecbeecf920.png","/statement-assets/35e159f82e17f1f22b3b628b7cad98f9fef711a0ed691ac3f934ae59a25ef91a.png","/statement-assets/352bf942834b6004520fcffe39fbe5f845e7648250216adfb9fa4d63fe723f22.png","/statement-assets/7af772b77aac6e01a73dd6d44829220d9c9b8ffbafc855934ec2c729df623daa.png","/statement-assets/34289b7d3f67894f486d7ae77d57a6068acfe08006e8ad133ad4f71695712574.png"],"contentKind":"statement","contestId":"628","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Bear and String Distance"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Limak is a little polar bear. He likes "},{"children":[{"kind":"text","text":"nice"}],"kind":"container"},{"kind":"text","text":" strings — strings of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", consisting of lowercase English letters only."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The distance between two letters is defined as the difference between their positions in the alphabet. For example, "},{"attrs":{"alt":"","src":"/statement-assets/ca5f8ee48a2c9f76d7f3c3d9b2cd1ea5631360afbf5a128355ab40ecbeecf920.png"},"kind":"image"},{"kind":"text","text":", and "},{"attrs":{"alt":"","src":"/statement-assets/35e159f82e17f1f22b3b628b7cad98f9fef711a0ed691ac3f934ae59a25ef91a.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, the distance between two nice strings is defined as the sum of distances of corresponding letters. For example, "},{"attrs":{"alt":"","src":"/statement-assets/352bf942834b6004520fcffe39fbe5f845e7648250216adfb9fa4d63fe723f22.png"},"kind":"image"},{"kind":"text","text":", and "},{"attrs":{"alt":"","src":"/statement-assets/7af772b77aac6e01a73dd6d44829220d9c9b8ffbafc855934ec2c729df623daa.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak gives you a nice string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and an integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". He challenges you to find any nice string "},{"kind":"math_inline","text":"s'"},{"kind":"text","text":" that "},{"attrs":{"alt":"","src":"/statement-assets/34289b7d3f67894f486d7ae77d57a6068acfe08006e8ad133ad4f71695712574.png"},"kind":"image"},{"kind":"text","text":". Find any "},{"kind":"math_inline","text":"s'"},{"kind":"text","text":" satisfying the given conditions, or print \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\" if it's impossible to do so."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As input/output can reach huge size it is recommended to use fast input/output methods: for example, prefer to use "},{"children":[{"kind":"text","text":"gets/scanf/printf"}],"kind":"container"},{"kind":"text","text":" instead of "},{"children":[{"kind":"text","text":"getline/cin/cout"}],"kind":"container"},{"kind":"text","text":" in C++, prefer to use "},{"children":[{"kind":"text","text":"BufferedReader/PrintWriter"}],"kind":"container"},{"kind":"text","text":" instead of "},{"children":[{"kind":"text","text":"Scanner/System.out"}],"kind":"container"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"Java"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ 106"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", consisting of lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no string satisfying the given conditions then print \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print any nice string "},{"kind":"math_inline","text":"s'"},{"kind":"text","text":" that "},{"attrs":{"alt":"","src":"/statement-assets/34289b7d3f67894f486d7ae77d57a6068acfe08006e8ad133ad4f71695712574.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 26\nbear\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"roar"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 7\naf\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"db\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1000\nhey\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"628C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/628/problem/C"}