{"assets":[],"contentKind":"statement","contestId":"132","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Constants in the language of Shakespeare"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Shakespeare is a widely known esoteric programming language in which programs look like plays by Shakespeare, and numbers are given by combinations of ornate epithets. In this problem we will have a closer look at the way the numbers are described in Shakespeare."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each constant in Shakespeare is created from non-negative powers of 2 using arithmetic operations. For simplicity we'll allow only addition and subtraction and will look for a representation of the given number which requires a minimal number of operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". You have to represent it as "},{"kind":"math_inline","text":"n = a1 + a2 + ... + am"},{"kind":"text","text":", where each of "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is a non-negative power of 2, possibly multiplied by -1. Find a representation which minimizes the value of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of input contains a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", written as its binary notation. The length of the notation is at most "},{"kind":"math_inline","text":"106"},{"kind":"text","text":". The first digit of the notation is guaranteed to be 1."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the required minimal "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". After it output "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines. Each line has to be formatted as \""},{"children":[{"kind":"text","text":"+2^x"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"-2^x"}],"kind":"container"},{"kind":"text","text":"\", where "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is the power coefficient of the corresponding term. The order of the lines doesn't matter."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n+2^4\n-2^0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1010011\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n+2^0\n+2^1\n+2^4\n+2^6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"132D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/132/problem/D"}