{"assets":[],"contentKind":"statement","contestId":"2008","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Sakurako's Exam"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Today, Sakurako has a math exam. The teacher gave the array, consisting of $$$a$$$ ones and $$$b$$$ twos."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In an array, Sakurako "},{"children":[{"kind":"text","text":"must"}],"kind":"container"},{"kind":"text","text":" place either a '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' or a '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"' in front of each element so that the sum of all elements in the array equals $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sakurako is not sure if it is possible to solve this problem, so determine whether there is a way to assign signs such that the sum of all elements in the array equals $$$0$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1\\le t\\le 100$$$)  — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains two integers $$$a$$$ and $$$b$$$ ($$$0\\le a,b \\lt 10$$$)  — the number of '1's and the number of '2's in the array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" if you can make the sum of the entire array equal to $$$0$$$, and \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output each letter in any case (lowercase or uppercase). For example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be accepted as a positive answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n0 1\n0 3\n2 0\n2 3\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\nNO\nYES\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" $$$a=0$$$, $$$b=1$$$: This means the array is $$$[2]$$$ — it is impossible to add the signs '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"' to get $$$0$$$ as a result;"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a=0$$$, $$$b=3$$$: This means the array is $$$[2, 2, 2]$$$ — it is impossible to add the signs '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"' to get $$$0$$$ as a result;"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a=2$$$, $$$b=0$$$: This means the array is $$$[1, 1]$$$ — it is possible to add the signs '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"' to get $$$0$$$ as a result ($$$+1-1=0$$$);"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a=2$$$, $$$b=3$$$: This means the array is $$$[1, 1, 2, 2, 2]$$$ — it is possible to add the signs '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"' to get $$$0$$$ as a result ($$$+1+1-2-2+2=0$$$);"}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2008A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2008/problem/A"}