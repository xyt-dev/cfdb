{"assets":[],"contentKind":"statement","contestId":"981","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Antipalindrome"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A string is a palindrome if it reads the same from the left to the right and from the right to the left. For example, the strings \""},{"children":[{"kind":"text","text":"kek"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abacaba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"papicipap"}],"kind":"container"},{"kind":"text","text":"\" are palindromes, while the strings \""},{"children":[{"kind":"text","text":"abb"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"iq"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A substring $$$s[l \\ldots r]$$$ ($$$1 \\leq l \\leq r \\leq |s|$$$) of a string $$$s = s_{1}s_{2} \\ldots s_{|s|}$$$ is the string $$$s_{l}s_{l + 1} \\ldots s_{r}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Anna does not like palindromes, so she makes her friends call her Ann. She also changes all the words she reads in a similar way. Namely, each word $$$s$$$ is changed into its longest substring that is not a palindrome. If all the substrings of $$$s$$$ are palindromes, she skips the word at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some time ago Ann read the word $$$s$$$. What is the word she changed it into?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a non-empty string $$$s$$$ with length at most $$$50$$$ characters, containing lowercase English letters only."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is such a substring in $$$s$$$ that is not a palindrome, print the maximum length of such a substring. Otherwise print $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that there can be multiple longest substrings that are not palindromes, but their length is unique."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"mew\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"wuffuw\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"qqqqqqqq\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"mew"}],"kind":"container"},{"kind":"text","text":"\" is not a palindrome, so the longest substring of it that is not a palindrome, is the string \""},{"children":[{"kind":"text","text":"mew"}],"kind":"container"},{"kind":"text","text":"\" itself. Thus, the answer for the first example is $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The string \""},{"children":[{"kind":"text","text":"uffuw"}],"kind":"container"},{"kind":"text","text":"\" is one of the longest non-palindrome substrings (of length $$$5$$$) of the string \""},{"children":[{"kind":"text","text":"wuffuw"}],"kind":"container"},{"kind":"text","text":"\", so the answer for the second example is $$$5$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All substrings of the string \""},{"children":[{"kind":"text","text":"qqqqqqqq"}],"kind":"container"},{"kind":"text","text":"\" consist of equal characters so they are palindromes. This way, there are no non-palindrome substrings. Thus, the answer for the third example is $$$0$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"981A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/981/problem/A"}