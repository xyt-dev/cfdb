{"assets":[],"contentKind":"statement","contestId":"1338","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Perfect Triples"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider the infinite sequence $$$s$$$ of positive integers, created by repeating the following steps:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Find the lexicographically smallest triple of positive integers $$$(a, b, c)$$$ such that "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a \\oplus b \\oplus c = 0$$$, where $$$\\oplus$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise XOR operation"}],"kind":"link"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a$$$, $$$b$$$, $$$c$$$ are not in $$$s$$$. "}],"kind":"list_item"},{"kind":"text","text":" Here triple of integers $$$(a_1, b_1, c_1)$$$ is considered to be lexicographically smaller than triple $$$(a_2, b_2, c_2)$$$ if sequence $$$[a_1, b_1, c_1]$$$ is lexicographically smaller than sequence $$$[a_2, b_2, c_2]$$$. "},{"children":[{"kind":"text","text":" Append $$$a$$$, $$$b$$$, $$$c$$$ to $$$s$$$ in this order. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Go back to the first step. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You have integer $$$n$$$. Find the $$$n$$$-th element of $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to answer $$$t$$$ independent test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A sequence $$$a$$$ is lexicographically smaller than a sequence $$$b$$$ if in the first position where $$$a$$$ and $$$b$$$ differ, the sequence $$$a$$$ has a smaller element than the corresponding element in $$$b$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^5$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$t$$$ lines contains a single integer $$$n$$$ ($$$1\\le n \\le 10^{16}$$$) — the position of the element you want to know."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In each of the $$$t$$$ lines, output the answer to the corresponding test case."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n1\n2\n3\n4\n5\n6\n7\n8\n9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n3\n4\n8\n12\n5\n10\n15\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first elements of $$$s$$$ are $$$1, 2, 3, 4, 8, 12, 5, 10, 15, \\dots $$$"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1338C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1338/problem/C"}