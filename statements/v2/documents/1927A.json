{"assets":[],"contentKind":"statement","contestId":"1927","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Make it White"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a horizontal strip of $$$n$$$ cells. Each cell is either white or black."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can choose a "},{"children":[{"kind":"text","text":"continuous"}],"kind":"container"},{"kind":"text","text":" segment of cells once and paint them all white. After this action, all the black cells in this segment will become white, and the white ones will remain white."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum length of the segment that needs to be painted white in order for all $$$n$$$ cells to become white?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. The descriptions of the test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 10$$$) — the length of the strip."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$s$$$, consisting of $$$n$$$ characters, each of which is either "},{"children":[{"kind":"text","text":"'W'"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"'B'"}],"kind":"container"},{"kind":"text","text":". The symbol "},{"children":[{"kind":"text","text":"'W'"}],"kind":"container"},{"kind":"text","text":" denotes a white cell, and "},{"children":[{"kind":"text","text":"'B'"}],"kind":"container"},{"kind":"text","text":" — a black one. It is guaranteed that at least one cell of the given strip is black."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single number — the minimum length of a "},{"children":[{"kind":"text","text":"continuous"}],"kind":"container"},{"kind":"text","text":" segment of cells that needs to be painted white in order for the "},{"children":[{"kind":"text","text":"entire"}],"kind":"container"},{"kind":"text","text":" strip to become white."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n6\nWBBWBW\n1\nB\n2\nWB\n3\nBBW\n4\nBWWB\n6\nBWBWWB\n6\nWWBBWB\n9\nWBWBWWWBW\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1\n1\n2\n4\n6\n4\n7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case of the example for the strip \""},{"children":[{"kind":"text","text":"WBBWBW"}],"kind":"container"},{"kind":"text","text":"\", the minimum length of the segment to be repainted white is $$$4$$$. It is necessary to repaint to white the segment from the $$$2$$$-nd to the $$$5$$$-th cell (the cells are numbered from $$$1$$$ from left to right)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1927A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1927/problem/A"}