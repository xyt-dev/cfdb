{"assets":["/statement-assets/46a3e5bae227f8dceaf915ce8e8f06026f2d329b56e6e037e47fb8c026259f55.png","/statement-assets/3bdabe2d8dc30b6d550eb278c6ad4864d07b91140ae965cbff26ee660a6d2ae4.png","/statement-assets/27a92fe6eb50feee97b69163cc7fe7b683c4aebd09fe02b1036c12e0404ef624.png"],"contentKind":"statement","contestId":"933","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. A Colourful Prospect"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Firecrackers scare Nian the monster, but they're wayyyyy too noisy! Maybe fireworks make a nice complement."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Little Tommy is watching a firework show. As circular shapes spread across the sky, a splendid view unfolds on the night of Lunar New Year's eve."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A wonder strikes Tommy. How many regions are formed by the circles on the sky? We consider the sky as a flat plane. A region is a connected part of the plane with positive area, whose bound consists of parts of bounds of the circles and is a curve or several curves without self-intersections, and that does not contain any curve other than its boundaries. Note that exactly one of the regions extends infinitely."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 3"},{"kind":"text","text":"), denoting the number of circles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each contains three space-separated integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 10 ≤ x, y ≤ 10"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ r ≤ 10"},{"kind":"text","text":"), describing a circle whose center is "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" and the radius is "},{"kind":"math_inline","text":"r"},{"kind":"text","text":". No two circles have the same "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" at the same time."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of regions on the plane."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n0 0 1\n2 0 1\n4 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n0 0 2\n3 0 2\n6 0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n0 0 2\n2 0 2\n1 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first example,"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/46a3e5bae227f8dceaf915ce8e8f06026f2d329b56e6e037e47fb8c026259f55.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"For the second example,"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/3bdabe2d8dc30b6d550eb278c6ad4864d07b91140ae965cbff26ee660a6d2ae4.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"For the third example,"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/27a92fe6eb50feee97b69163cc7fe7b683c4aebd09fe02b1036c12e0404ef624.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"933C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/933/problem/C"}