{"assets":[],"contentKind":"statement","contestId":"825","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Binary Protocol"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp has just invented a new binary protocol for data transmission. He is encoding positive integer decimal number to binary string using following algorithm:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Each digit is represented with number of "},{"children":[{"kind":"text","text":"'1'"}],"kind":"container"},{"kind":"text","text":" characters equal to the value of that digit (for "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" it is zero ones). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Digits are written one by one in order corresponding to number and separated by single "},{"children":[{"kind":"text","text":"'0'"}],"kind":"container"},{"kind":"text","text":" character. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Though Polycarp learnt how to encode the numbers, he has no idea how to decode them back. Help him calculate the decoded number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 89"},{"kind":"text","text":") — length of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" — sequence of "},{"children":[{"kind":"text","text":"'0'"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"'1'"}],"kind":"container"},{"kind":"text","text":" characters, number in its encoded format. It is guaranteed that the number corresponding to the string is positive and doesn't exceed "},{"kind":"math_inline","text":"109"},{"kind":"text","text":". The string always starts with "},{"children":[{"kind":"text","text":"'1'"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the decoded number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n110011101\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind"