{"assets":[],"contentKind":"statement","contestId":"818","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Multicolored Cars"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Alice and Bob got very bored during a long car trip so they decided to play a game. From the window they can see cars of different colors running past them. Cars are going one after another."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The game rules are like this. Firstly Alice chooses some color "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", then Bob chooses some color "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"A ≠ B"},{"kind":"text","text":"). After each car they update the number of cars of their chosen color that have run past them. Let's define this numbers after "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th car "},{"kind":"math_inline","text":"cntA(i)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"cntB(i)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"cntA(i) > cntB(i)"},{"kind":"text","text":" for every "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" then the winner is Alice. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"cntB(i) ≥ cntA(i)"},{"kind":"text","text":" for every "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" then the winner is Bob. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Otherwise it's a draw. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Bob knows all the colors of cars that they will encounter and order of their appearance. Alice have already chosen her color "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and Bob now wants to choose such color "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" that he will win the game (draw is not a win). Help him find this color."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, print any of them. If there is no such color then print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105, 1 ≤ A ≤ 106"},{"kind":"text","text":") – number of cars and the color chosen by Alice."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci ≤ 106"},{"kind":"text","text":") — colors of the cars that Alice and Bob will encounter in the order of their appearance."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output such color "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ B ≤ 106"},{"kind":"text","text":") that if Bob chooses it then he will win the game. If there are multiple solutions, print any of them. If there is no such color then print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that if there exists any solution then there exists solution with ("},{"kind":"math_inline","text":"1 ≤ B ≤ 106"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n2 1 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n2 2 4 5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 10\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's consider availability of colors in the first example: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"cnt2(i) ≥ cnt1(i)"},{"kind":"text","text":" for every "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", and color "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" can be the answer. "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"cnt4(2) < cnt1(2)"},{"kind":"text","text":", so color "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" isn't the winning one for Bob. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" All the other colors also have "},{"kind":"math_inline","text":"cntj(2) < cnt1(2)"},{"kind":"text","text":", thus they are not available. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the third example every color is acceptable except for "},{"kind":"math_inline","text":"10"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"818D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/818/problem/D"}