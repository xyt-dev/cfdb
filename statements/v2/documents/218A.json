{"assets":["/statement-assets/cc478312c45db37dac0a2bc64f764cca4a0370beb0a191435e10d3b6a97b1805.png"],"contentKind":"statement","contestId":"218","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Mountain Scenery"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Bolek has found a picture with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" mountain peaks painted on it. The "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" painted peaks are represented by a non-closed polyline, consisting of "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" segments. The segments go through "},{"kind":"math_inline","text":"2n + 1"},{"kind":"text","text":" points with coordinates "},{"kind":"math_inline","text":"(1, y1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, y2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2n + 1, y2n + 1)"},{"kind":"text","text":", with the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th segment connecting the point "},{"kind":"math_inline","text":"(i, yi)"},{"kind":"text","text":" and the point "},{"kind":"math_inline","text":"(i + 1, yi + 1)"},{"kind":"text","text":". For any even "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(2 ≤ i ≤ 2n)"},{"kind":"text","text":" the following condition holds: "},{"kind":"math_inline","text":"yi - 1 < yi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi > yi + 1"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We shall call a vertex of a polyline with an even "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" coordinate a "},{"children":[{"kind":"text","text":"mountain peak"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/cc478312c45db37dac0a2bc64f764cca4a0370beb0a191435e10d3b6a97b1805.png"},"kind":"image"},{"children":[{"kind":"text","text":" The figure to the left shows the initial picture, the figure to the right shows what the picture looks like after Bolek's actions. The affected peaks are marked red, "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" = 2. "}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Bolek fancied a little mischief. He chose exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" mountain peaks, rubbed out the segments that went through those peaks and increased each peak's height by one (that is, he increased the "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" coordinate of the corresponding points). Then he painted the missing segments to get a new picture of mountain peaks. Let us denote the points through which the new polyline passes on Bolek's new picture as "},{"kind":"math_inline","text":"(1, r1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, r2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2n + 1, r2n + 1)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given Bolek's final picture, restore the initial one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ k ≤ n ≤ 100)"},{"kind":"text","text":". The next line contains "},{"kind":"math_inline","text":"2n + 1"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"r1, r2, ..., r2n + 1"},{"kind":"math_inline","text":"(0 ≤ ri ≤ 100)"},{"kind":"text","text":" — the "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" coordinates of the polyline vertices on Bolek's picture."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that we can obtain the given picture after performing the described actions on some picture of mountain peaks."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"2n + 1"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"y1, y2, ..., y2n + 1"},{"kind":"text","text":" — the "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" coordinates of the vertices of the polyline on the initial picture. If there are multiple answers, output any one of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n0 5 3 5 1 5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 5 3 4 1 4 2 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n0 2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 1 0 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"218A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/218/problem/A"}