{"assets":[],"contentKind":"statement","contestId":"1372","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Omkar and Completion"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have been blessed as a child of Omkar. To express your gratitude, please solve this problem for Omkar!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An array $$$a$$$ of length $$$n$$$ is called "},{"children":[{"kind":"text","text":"complete"}],"kind":"container"},{"kind":"text","text":" if all elements are positive and don't exceed $$$1000$$$, and for all indices $$$x$$$,$$$y$$$,$$$z$$$ ($$$1 \\leq x,y,z \\leq n$$$), $$$a_{x}+a_{y} \\neq a_{z}$$$ (not necessarily distinct)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given one integer $$$n$$$. Please find any "},{"children":[{"kind":"text","text":"complete"}],"kind":"container"},{"kind":"text","text":" array of length $$$n$$$. It is guaranteed that under given constraints such array exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains $$$t$$$ ($$$1 \\le t \\le 1000$$$)  — the number of test cases. Description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains one integer $$$n$$$ ($$$1 \\leq n \\leq 1000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$1000$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a complete array on a single line. All elements have to be integers between $$$1$$$ and $$$1000$$$ and for all indices $$$x$$$,$$$y$$$,$$$z$$$ ($$$1 \\leq x,y,z \\leq n$$$) (not necessarily distinct), $$$a_{x}+a_{y} \\neq a_{z}$$$ must hold."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If multiple solutions exist, you may print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n5\n4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 5 3 77 12\n384 384 44 44\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"It can be shown that the outputs above are valid for each test case. For example, $$$44+44 \\neq 384$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Below are some examples of arrays that are NOT "},{"children":[{"kind":"text","text":"complete"}],"kind":"container"},{"kind":"text","text":" for the 1st test case:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$[1,2,3,4,5]$$$ "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Notice that $$$a_{1}+a_{2} = a_{3}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$[1,3000,1,300,1]$$$ "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Notice that $$$a_{2} = 3000 \\gt 1000$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1372A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1372/problem/A"}