{"assets":[],"contentKind":"statement","contestId":"666","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Forensic Examination"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"6 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"768 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The country of Reberland is the archenemy of Berland. Recently the authorities of Berland arrested a Reberlandian spy who tried to bring the leaflets intended for agitational propaganda to Berland illegally . The most leaflets contain substrings of the Absolutely Inadmissible Swearword and maybe even the whole word."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Berland legal system uses the difficult algorithm in order to determine the guilt of the spy. The main part of this algorithm is the following procedure."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" leaflets that are brought by the spy are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". After that it's needed to get the answer to "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries of the following kind: \""},{"children":[{"kind":"text","text":"In which leaflet in the segment of numbers "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":" the substring of the Absolutely Inadmissible Swearword "},{"kind":"math_inline","text":"[pl, pr]"},{"kind":"text","text":" occurs more often?"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The expert wants you to automate that procedure because this time texts of leaflets are too long. Help him!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 5·105"},{"kind":"text","text":") — the Absolutely Inadmissible Swearword. The string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consists of only lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the only integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 5·104"},{"kind":"text","text":") — the number of texts of leaflets for expertise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains the only string "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" — the text of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th leaflet. The sum of lengths of all leaflet texts doesn't exceed "},{"kind":"math_inline","text":"5·104"},{"kind":"text","text":". The text of the leaflets consists of only lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 5·105"},{"kind":"text","text":") — the number of queries for expertise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Finally, each of the last "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains four integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", "},{"kind":"math_inline","text":"pl"},{"kind":"text","text":", "},{"kind":"math_inline","text":"pr"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ m, 1 ≤ pl ≤ pr ≤ |s|"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":" is the length of the Absolutely Inadmissible Swearword."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should contain two integers — the number of the text with the most occurences and the number of occurences of the substring "},{"kind":"math_inline","text":"[pl, pr]"},{"kind":"text","text":" of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". If there are several text numbers print the smallest one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"suffixtree\n3\nsuffixtreesareawesome\ncartesiantreeisworsethansegmenttree\nnyeeheeheee\n2\n1 2 1 10\n1 3 9 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n3 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"666E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/666/problem/E"}