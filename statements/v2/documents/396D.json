{"assets":["/statement-assets/ee84db2f5dad2e1a30e57cac49a30d0c1dc284ea35974de77c6046d0cb45c38a.png"],"contentKind":"statement","contestId":"396","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. On Sum of Number of Inversions in Permutations"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". Calculate the total number of inversions in all permutations that lexicographically do not exceed the given one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As this number can be very large, print it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":") — the length of the permutation. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the answer to the problem modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the sequence that consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers, each of them is from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An inversion of permutation "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" is a pair of indexes "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"i < j"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"pi > pj"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Permutation "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" do not exceed permutation "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" lexicographically, if either "},{"kind":"math_inline","text":"a = b"},{"kind":"text","text":" or there exists such number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", for which the following logical condition fulfills: "},{"attrs":{"alt":"","src":"/statement-assets/ee84db2f5dad2e1a30e57cac49a30d0c1dc284ea35974de77c6046d0cb45c38a.png"},"kind":"image"},{"kind":"text","text":" AND "},{"kind":"math_inline","text":"(ai < bi)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"396D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/396/problem/D"}