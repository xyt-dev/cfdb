{"assets":[],"contentKind":"statement","contestId":"174","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. File List"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Eudokimus, a system administrator is in trouble again. As a result of an error in some script, a list of names of very important files has been damaged. Since they were files in the BerFS file system, it is known that each file name has a form \""},{"children":[{"kind":"text","text":"name.ext"}],"kind":"container"},{"kind":"text","text":"\", where: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"name"}],"kind":"container"},{"kind":"text","text":" is a string consisting of lowercase Latin letters, its length is from 1 to 8 characters; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"ext"}],"kind":"container"},{"kind":"text","text":" is a string consisting of lowercase Latin letters, its length is from 1 to 3 characters. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, \""},{"children":[{"kind":"text","text":"read.me"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"example.txt"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"b.cpp"}],"kind":"container"},{"kind":"text","text":"\" are valid file names and \""},{"children":[{"kind":"text","text":"version.info"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ntldr"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"contestdata.zip"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Damage to the list meant that all the file names were recorded one after another, without any separators. So now Eudokimus has a single string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Eudokimus needs to set everything right as soon as possible. He should divide the resulting string into parts so that each part would be a valid file name in BerFS. Since Eudokimus has already proved that he is not good at programming, help him. The resulting file list can contain the same file names."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input data consists of a single string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", its length is from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"4·105"},{"kind":"text","text":" characters. The string can contain only lowercase Latin letters ('"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' - '"},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"') and periods ('"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"')."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if it is possible to divide "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" into parts as required. In this case, the following lines should contain the parts of the required partition, one per line in the order in which they appear in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". The required partition can contain the same file names. If there are multiple solutions, print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the solution does not exist, then print in a single line \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"read.meexample.txtb.cpp\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nread.m\neexample.t\nxtb.cpp\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"version.infontldrcontestdata.zip\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"174B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/174/problem/B"}