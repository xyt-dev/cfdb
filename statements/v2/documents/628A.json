{"assets":[],"contentKind":"statement","contestId":"628","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Tennis Tournament"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A tennis tournament with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" participants is running. The participants are playing by an olympic system, so the winners move on and the losers drop out."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The tournament takes place in the following way (below, "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is the number of the participants of the current round):"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" let "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" be the maximal power of the number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"k ≤ m"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"k"},{"kind":"text","text":" participants compete in the current round and a half of them passes to the next round, the other "},{"kind":"math_inline","text":"m - k"},{"kind":"text","text":" participants pass to the next round directly, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" when only one participant remains, the tournament finishes. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Each match requires "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" bottles of water for each participant and one bottle for the judge. Besides "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" towels are given to each participant for the whole tournament."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the number of bottles and towels needed for the tournament."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that it's a tennis tournament so in each match two participants compete (one of them will win and the other will lose)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains three integers "},{"kind":"math_inline","text":"n, b, p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, b, p ≤ 500"},{"kind":"text","text":") — the number of participants and the parameters described in the problem statement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" — the number of bottles and towels need for the tournament."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20 15\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"35 32\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example will be three rounds:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" in the first round will be two matches and for each match "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" bottles of water are needed (two for each of the participants and one for the judge), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the second round will be only one match, so we need another "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" bottles of water, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the third round will also be only one match, so we need another "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" bottles of water. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So in total we need "},{"kind":"math_inline","text":"20"},{"kind":"text","text":" bottles of water."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example no participant will move on to some round directly."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"628A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/628/problem/A"}