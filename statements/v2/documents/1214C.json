{"assets":[],"contentKind":"statement","contestId":"1214","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Bad Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya's friends made him a birthday present — a bracket sequence. Petya was quite disappointed with his gift, because he dreamed of correct bracket sequence, yet he told his friends nothing about his dreams and decided to fix present himself. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To make everything right, Petya is going to move at most one bracket from its original place in the sequence to any other position. Reversing the bracket (e.g. turning \"(\" into \")\" or vice versa) isn't allowed. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We remind that bracket sequence $$$s$$$ is called correct if: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$s$$$ is empty; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s$$$ is equal to \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"$$$t$$$"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\", where $$$t$$$ is correct bracket sequence; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s$$$ is equal to $$$t_1 t_2$$$, i.e. concatenation of $$$t_1$$$ and $$$t_2$$$, where $$$t_1$$$ and $$$t_2$$$ are correct bracket sequences. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, \""},{"children":[{"kind":"text","text":"(()())"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":"\" are correct, while \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"())"}],"kind":"container"},{"kind":"text","text":"\" are not. Help Petya to fix his birthday present and understand whether he can move one bracket so that the sequence becomes correct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First of line of input contains a single number $$$n$$$ ($$$1 \\leq n \\leq 200\\,000$$$) — length of the sequence which Petya received for his birthday."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second line of the input contains bracket sequence of length $$$n$$$, containing symbols \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" if Petya can make his sequence correct moving at most one bracket. Otherwise print \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n)(\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n(()\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNo\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n()\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n)))))(((((\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNo\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, Petya can move first bracket to the end, thus turning the sequence into \""},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":"\", which is correct bracket sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, there is no way to move at most one bracket so that the sequence becomes correct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, the sequence is already correct and there's no need to move brackets."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1214C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1214/problem/C"}