{"assets":["/statement-assets/54f4e9d7548c9a57a064ab0e914e769f24a1741784c0a59af1d326ca1475635e.png","/statement-assets/437fd66364e9aed9a6d646de1f1f7018a801525fffeb791fd041c0729d0ff9cf.png","/statement-assets/fc53c650c6bbee4208e1db1539790c99ba70f75a1bee8cb6149bb57c6b5149c6.png"],"contentKind":"statement","contestId":"556","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Case of the Zeros and Ones"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Andrewid the Android is a galaxy-famous detective. In his free time he likes to think about strings containing zeros and ones."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Once he thought about a string of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" consisting of zeroes and ones. Consider the following operation: we choose any two "},{"children":[{"kind":"text","text":"adjacent"}],"kind":"container"},{"kind":"text","text":" positions in the string, and if one them contains 0, and the other contains 1, then we are allowed to remove these two digits from the string, obtaining a string of length "},{"kind":"math_inline","text":"n - 2"},{"kind":"text","text":" as a result."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Andreid thinks about what is the minimum length of the string that can remain after applying the described operation several times (possibly, zero)? Help him to calculate this number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105"},{"kind":"text","text":"), the length of the string that Andreid has."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" consisting only from zeros and ones."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the minimum length of the string that may remain after applying the described operations several times."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n01010\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n11101111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test it is possible to change the string like the following: "},{"attrs":{"alt":"","src":"/statement-assets/54f4e9d7548c9a57a064ab0e914e769f24a1741784c0a59af1d326ca1475635e.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test it is possible to change the string like the following: "},{"attrs":{"alt":"","src":"/statement-assets/437fd66364e9aed9a6d646de1f1f7018a801525fffeb791fd041c0729d0ff9cf.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample test it is possible to change the string like the following: "},{"attrs":{"alt":"","src":"/statement-assets/fc53c650c6bbee4208e1db1539790c99ba70f75a1bee8cb6149bb57c6b5149c6.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"556A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/556/problem/A"}