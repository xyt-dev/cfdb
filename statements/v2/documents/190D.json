{"assets":[],"contentKind":"statement","contestId":"190","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Non-Secret Cypher"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Berland starts to seize the initiative on the war with Flatland. To drive the enemy from their native land, the berlanders need to know exactly how many more flatland soldiers are left in the enemy's reserve. Fortunately, the scouts captured an enemy in the morning, who had a secret encrypted message with the information the berlanders needed so much."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The captured enemy had an array of positive integers. Berland intelligence have long been aware of the flatland code: to convey the message, which contained a number "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", the enemies use an array of integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". The number of its subarrays, in which there are at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" equal numbers, equals "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". The number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" has long been known in the Berland army so General Touristov has once again asked Corporal Vasya to perform a simple task: to decipher the flatlanders' message."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Vasya, given an array of integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", find the number of subarrays of the array of numbers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", which has at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" equal numbers."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Subarray"}],"kind":"container"},{"kind":"math_inline","text":"a[i... j] (1 ≤ i ≤ j ≤ n)"},{"kind":"text","text":" of array "},{"kind":"math_inline","text":"a = (a1, a2, ..., an)"},{"kind":"text","text":" is an array, made from its consecutive elements, starting from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th one and ending with the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th one: "},{"kind":"math_inline","text":"a[i... j] = (ai, ai + 1, ..., aj)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ k ≤ n ≤ 4·105)"},{"kind":"text","text":", showing how many numbers an array has and how many equal numbers the subarrays are required to have, correspondingly. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — elements of the array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the single number — the number of such subarrays of array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", that they have at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" equal integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. In is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n1 2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n1 2 1 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample are three subarrays, containing at least two equal numbers: (1,2,1), (2,1,2) and (1,2,1,2)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample are two subarrays, containing three equal numbers: (1,2,1,1,3) and (1,2,1,1)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample any subarray contains at least one 1 number. Overall they are 6: (1), (1), (1), (1,1), (1,1) and (1,1,1)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"190D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/190/problem/D"}