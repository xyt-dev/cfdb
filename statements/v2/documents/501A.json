{"assets":["/statement-assets/f028c04243a5874fa14a7f0a9c3bb3f0a87146dbfa69e491927b7c6c78d08a23.png"],"contentKind":"statement","contestId":"501","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Contest"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Misha and Vasya participated in a Codeforces contest. Unfortunately, each of them solved only one problem, though successfully submitted it at the first attempt. Misha solved the problem that costs "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" points and Vasya solved the problem that costs "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" points. Besides, Misha submitted the problem "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" minutes after the contest started and Vasya submitted the problem "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" minutes after the contest started. As you know, on Codeforces the cost of a problem reduces as a round continues. That is, if you submit a problem that costs "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" points "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" minutes after the contest started, you get "},{"attrs":{"alt":"","src":"/statement-assets/f028c04243a5874fa14a7f0a9c3bb3f0a87146dbfa69e491927b7c6c78d08a23.png"},"kind":"image"},{"kind":"text","text":" points. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Misha and Vasya are having an argument trying to find out who got more points. Help them to find out the truth."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"250 ≤ a, b ≤ 3500"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ c, d ≤ 180"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that numbers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are divisible by "},{"kind":"math_inline","text":"250"},{"kind":"text","text":" (just like on any real Codeforces round)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output on a single line: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"Misha"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if Misha got more points than Vasya."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"Vasya"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if Vasya got more points than Misha."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"Tie"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if both of them got the same number of points."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"500 1000 20 30\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Vasya\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1000 1000 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Tie\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1500 1000 176 177\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Misha\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"501A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/501/problem/A"}