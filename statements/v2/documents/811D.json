{"assets":["/statement-assets/dc8c6b25aebefe8ee4422ac78c2d80362a426f424edadad5559ec048c2afc2ff.png"],"contentKind":"statement","contestId":"811","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Vladik and Favorite Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is an interactive problem."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vladik has favorite game, in which he plays all his free time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Game field could be represented as "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" matrix which consists of cells of three types: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" «"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"» — normal cell, player can visit it. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" «"},{"children":[{"kind":"text","text":"F"}],"kind":"container"},{"kind":"text","text":"» — finish cell, player has to finish his way there to win. There is exactly one cell of this type. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" «"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"» — dangerous cell, if player comes to this cell, he loses. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Initially player is located in the left top cell with coordinates "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Player has access to "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" buttons \""},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\", each of them move player up, down, left and right directions respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But it’s not that easy! Sometimes friends play game and change functions of buttons. Function of buttons \""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\" could have been swapped, also functions of buttons \""},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"\" could have been swapped. Note that functions of buttons can be changed only at the beginning of the game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Vladik win the game!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100"},{"kind":"text","text":") — number of rows and columns respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters describing corresponding row of field. Set of characters in field is described above."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Guaranteed that cell with coordinates "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" is normal and there is at least one way from initial cell to finish cell without dangerous cells. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom","title":"Interaction"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Interaction"}],"kind":"heading"},{"children":[{"kind":"text","text":"You can press buttons no more than "},{"kind":"math_inline","text":"2·n·m"},{"kind":"text","text":" times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To press a button you should print \""},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\" in new line. It’s necessary to print newline character and "},{"children":[{"kind":"text","text":"flush"}],"kind":"container"},{"kind":"text","text":" output. After flushing buffer you should read answer from input data. Answer is the pair of space-separated integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" — new position of player. In case, if there is no cell in direction of moving, position will not change. If after any move player lost, in other words player move to dangerous cell, then "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" will be equal to "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If after any move player is in finish or dangerous cell, then you should terminate your program."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To finish output buffer (i. e. for operation "},{"children":[{"kind":"text","text":"flush"}],"kind":"container"},{"kind":"text","text":") right after printing direction and newline you should do next:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"fflush(stdout)"}],"kind":"container"},{"kind":"text","text":" in C++ "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"System.out.flush()"}],"kind":"container"},{"kind":"text","text":" in Java "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"stdout.flush()"}],"kind":"container"},{"kind":"text","text":" in Python "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"flush(output)"}],"kind":"container"},{"kind":"text","text":" in Pascal "}],"kind":"list_item"},{"children":[{"kind":"text","text":" read documentation for other languages. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"Hacks"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To perform a hack you should use this format:"}],"kind":"paragraph"},{"kind":"code_block","text":"\nn m swapLR swapUD  \na_1  \na_2  \n...  \na_n\n"},{"children":[{"kind":"text","text":"Where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — number of rows and columns in game field. "},{"kind":"math_inline","text":"swapLR"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" in case, when directions \""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"’’ and \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"’’ is swapped, and equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" otherwise. "},{"kind":"math_inline","text":"swapUD"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", when directions \""},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":"’’ and \""},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"’’ is swapped, and equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" otherwise. "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" — description of corresponding rows of game field."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n...\n**.\nF*.\n...\n1 1\n1 2\n1 3\n1 3\n2 3\n3 3\n4 3\n4 2\n4 1\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"R\nL\nL\nD\nU\nU\nU\nR\nR\nD\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In first test case all four directions swapped with their opposite directions. Protocol of interaction In more convenient form:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/dc8c6b25aebefe8ee4422ac78c2d80362a426f424edadad5559ec048c2afc2ff.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This test could be presenter for hack in following way: "}],"kind":"paragraph"},{"kind":"code_block","text":"\n4 3 1 1\n...\n**.\nF*.\n...\n"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"811D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/811/problem/D"}