{"assets":[],"contentKind":"statement","contestId":"2172","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"L. Maximum Color Segment"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a rope $$$n$$$ units long, where each unit is painted either red or black. The rope can be represented as a string of length $$$n$$$ consisting of characters "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":" (red) and "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" (black). You are also given two integers $$$m$$$ and $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may perform the following operation "},{"children":[{"kind":"text","text":"at most"}],"kind":"container"},{"kind":"text","text":" $$$m$$$ times (possibly, zero times):"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose any contiguous substring$$$^{\\text{∗}}$$$ of the rope of length exactly $$$k$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Flip the color of every unit in the substring: each "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":" becomes "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":", and each "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" becomes "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, consider the rope "},{"children":[{"kind":"text","text":"RRRRBRRR"}],"kind":"container"},{"kind":"text","text":" with $$$k = 4$$$. If you choose the $$$3$$$-rd to $$$6$$$-th characters ("},{"children":[{"kind":"text","text":"RR"},{"children":[{"kind":"text","text":"RRBR"}],"kind":"container"},{"kind":"text","text":"RR"}],"kind":"container"},{"kind":"text","text":"), then after flipping, the rope becomes "},{"children":[{"kind":"text","text":"RR"},{"children":[{"kind":"text","text":"BBRB"}],"kind":"container"},{"kind":"text","text":"RR"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Define the "},{"children":[{"kind":"text","text":"number of color segments"}],"kind":"container"},{"kind":"text","text":" as the smallest number of contiguous segments into which the rope can be divided so that each segment consists of units of a single color. For instance, the rope "},{"children":[{"kind":"text","text":"RRBRRRBB"}],"kind":"container"},{"kind":"text","text":" has $$$4$$$ color segments: "},{"children":[{"kind":"text","text":"RR"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"RRR"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"BB"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine the maximum possible number of color segments after performing "},{"children":[{"kind":"text","text":"at most"}],"kind":"container"},{"kind":"text","text":" $$$m$$$ operations."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$A string $$$t$$$ is a substring of a string $$$s$$$ if $$$t$$$ can be obtained from $$$s$$$ by the deletion of several (possibly, zero or all) characters from the beginning and several (possibly, zero or all) characters from the end."}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers $$$n$$$, $$$m$$$, and $$$k$$$, representing the length of the rope, the maximum number of operations allowed, and the length of each operation's flip window, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string of length $$$n$$$ consisting only of the characters "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":", representing the initial content of the rope."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1 \\le n \\le 3000$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$0 \\le m \\le 3000$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$1 \\le k \\le n$$$ "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output an integer in a single line, representing the maximum possible number of color segments after performing at most $$$m$$$ operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 4 3\nRRBRR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10 3 3\nRRRRBBRRRB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7 4 7\nRRBRBBR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"L","problemCode":"2172L","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2172/problem/L"}