{"assets":["/statement-assets/5038ce1bdf2956f438841e58c21d5cf4a41aa7abc8a22a912d22efd77b2988db.png","/statement-assets/dc8ad285c701d999df9c4f0e57bd2c6884633f9a3d78fde4f86c21a57278932f.png"],"contentKind":"statement","contestId":"761","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Dasha and Puzzle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dasha decided to have a rest after solving the problem. She had been ready to start her favourite activity — origami, but remembered the puzzle that she could not solve. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5038ce1bdf2956f438841e58c21d5cf4a41aa7abc8a22a912d22efd77b2988db.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The tree is a non-oriented connected graph without cycles. In particular, there always are "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" edges in a tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The puzzle is to position the vertices at the points of the Cartesian plane with integral coordinates, so that the segments between the vertices connected by edges are parallel to the coordinate axes. Also, the intersection of segments is allowed only at their ends. Distinct vertices should be placed at different points. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Dasha to find any suitable way to position the tree vertices on the plane."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that if it is possible to position the tree vertices on the plane without violating the condition which is given above, then you can do it by using points with integral coordinates which don't exceed "},{"kind":"math_inline","text":"1018"},{"kind":"text","text":" in absolute value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 30)"},{"kind":"text","text":" — the number of vertices in the tree. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":") that mean that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge of the tree connects vertices "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the described graph is a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the puzzle doesn't have a solution then in the only line print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, the first line should contain \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\". The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines should contain the pair of integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"math_inline","text":"(|xi|, |yi| ≤ 1018)"},{"kind":"text","text":" — the coordinates of the point which corresponds to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex of the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several solutions, print any of them. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 2\n1 3\n2 4\n2 5\n3 6\n3 7"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n0 0\n1 0\n0 1\n2 0\n1 -1\n-1 1\n0 2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 2\n2 3\n2 4\n2 5\n2 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2\n2 3\n3 4"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n3 3\n4 3\n5 3\n6 3"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample one of the possible positions of tree is: "},{"attrs":{"alt":"","src":"/statement-assets/dc8ad285c701d999df9c4f0e57bd2c6884633f9a3d78fde4f86c21a57278932f.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"761E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/761/problem/E"}