{"assets":[],"contentKind":"statement","contestId":"2086","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Zebra-like Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"We call a positive integer "},{"children":[{"kind":"text","text":"zebra-like"}],"kind":"container"},{"kind":"text","text":" if its binary representation has alternating bits up to the most significant bit, and the least significant bit is equal to $$$1$$$. For example, the numbers $$$1$$$, $$$5$$$, and $$$21$$$ are "},{"children":[{"kind":"text","text":"zebra-like"}],"kind":"container"},{"kind":"text","text":", as their binary representations $$$1$$$, $$$101$$$, and $$$10101$$$ meet the requirements, while the number $$$10$$$ is not "},{"children":[{"kind":"text","text":"zebra-like"}],"kind":"container"},{"kind":"text","text":", as the least significant bit of its binary representation $$$1010$$$ is $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We define the "},{"children":[{"kind":"text","text":"zebra value"}],"kind":"container"},{"kind":"text","text":" of a positive integer $$$e$$$ as the minimum integer $$$p$$$ such that $$$e$$$ can be expressed as the sum of $$$p$$$ "},{"children":[{"kind":"text","text":"zebra-like"}],"kind":"container"},{"kind":"text","text":" numbers (possibly the same, possibly different)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given three integers $$$l$$$, $$$r$$$, and $$$k$$$, calculate the number of integers $$$x$$$ such that $$$l \\le x \\le r$$$ and the "},{"c