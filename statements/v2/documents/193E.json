{"assets":[],"contentKind":"statement","contestId":"193","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Fibonacci Number"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"John Doe has a list of all Fibonacci numbers modulo "},{"kind":"math_inline","text":"1013"},{"kind":"text","text":". This list is infinite, it starts with numbers "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Each number in the list, apart from the first two, is a sum of previous two modulo "},{"kind":"math_inline","text":"1013"},{"kind":"text","text":". That is, John's list is made from the Fibonacci numbers' list by replacing each number there by the remainder when divided by "},{"kind":"math_inline","text":"1013"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"John got interested in number "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ f < 1013"},{"kind":"text","text":") and now wants to find its first occurrence in the list given above. Help John and find the number of the first occurence of number "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" in the list or otherwise state that number "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" does not occur in the list. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The numeration in John's list starts from zero. There, the "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"-th position is the number "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st position is the number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd position is the number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", the "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-rd position is the number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", the "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"-th position is the number "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and so on. Thus, the beginning of the list looks like this: "},{"kind":"math_inline","text":"0, 1, 1, 2, 3, 5, 8, 13, 21, ..."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the single integer "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ f < 1013"},{"kind":"text","text":") — the number, which position in the list we should find."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the number of the first occurrence of the given number in John's list. If this number doesn't occur in John's list, print -1."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"13\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"377\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"193E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/193/problem/E"}