{"assets":[],"contentKind":"statement","contestId":"188","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Stack"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In this problem we'll use a stack which supports two types of operations:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Push a given number on the stack. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Pop two numbers from the stack, perform a given operation (addition or multiplication) on them and push the result on the stack. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given a string which describes the sequence of operations to be performed on the stack. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character corresponds to "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th operation:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character is a digit, push the corresponding number on the stack. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character is «"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"» or «"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"», perform the corresponding operation. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Initially the stack is empty. Output the topmost number on the stack after executing all given operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of input contains a string of operations, consisting of characters «"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"» and digits ("},{"children":[{"kind":"text","text":"0..9"}],"kind":"container"},{"kind":"text","text":"). The length of the string will be between 1 and 20 characters, inclusive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The given sequence of operations is guaranteed to be correct, i.e. the stack will have at least two elements before every math operation. The numbers on the stack will never exceed "},{"kind":"math_inline","text":"106"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single number — the topmost element of the stack after performing all given operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"12+3*66*+\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"45\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"149\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first case the stack will end up containing a single number — the result of calculating (1+2)*3+6*6."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second case there are no math operations, so the answer will be the last number pushed on the stack."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"188H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/188/problem/H"}