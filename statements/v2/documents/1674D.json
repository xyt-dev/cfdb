{"assets":[],"contentKind":"statement","contestId":"1674","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. A-B-C Sort"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given three arrays $$$a$$$, $$$b$$$ and $$$c$$$. Initially, array $$$a$$$ consists of $$$n$$$ elements, arrays $$$b$$$ and $$$c$$$ are empty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are performing the following algorithm that consists of two steps: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Step $$$1$$$: while $$$a$$$ is not empty, you take "},{"children":[{"kind":"text","text":"the last element"}],"kind":"container"},{"kind":"text","text":" from $$$a$$$ and move it "},{"children":[{"kind":"text","text":"in the middle"}],"kind":"container"},{"kind":"text","text":" of array $$$b$$$. If $$$b$$$ currently has odd length, you can choose: place the element from $$$a$$$ to the left or to the right of the middle element of $$$b$$$. As a result, $$$a$$$ becomes empty and $$$b$$$ consists of $$$n$$$ elements. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Step $$$2$$$: while $$$b$$$ is not empty, you take "},{"children":[{"kind":"text","text":"the middle element"}],"kind":"container"},{"kind":"text","text":" from $$$b$$$ and move it "},{"children":[{"kind":"text","text":"to the end"}],"kind":"container"},{"kind":"text","text":" of array $$$c$$$. If $$$b$$$ currently has even length, you can choose which of two middle elements to take. As a result, $$$b$$$ becomes empty and $$$c$$$ now consists of $$$n$$$ elements. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" Refer to the Note section for examples."},{"children":[{"kind":"text","text":"Can you make array $$$c$$$ sorted in non-decreasing order?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 2 \\cdot 10^4$$$) — the number of test cases. Next $$$t$$$ cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains the single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the length of array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^6$$$) — the array $$$a$$$ itself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the sum of $$$n$$$ doesn't exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" (case-insensitive), if you can make array $$$c$$$ sorted in non-decreasing order. Otherwise, print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" (case-insensitive)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"