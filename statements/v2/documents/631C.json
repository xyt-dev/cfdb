{"assets":["/statement-assets/c5ccbcf94d1c084bd890b443f6fd462c3ce4a7fe5050ff84708e86b6a109560b.png"],"contentKind":"statement","contestId":"631","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Report"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Each month Blake gets the report containing main economic indicators of the company \"Blake Technologies\". There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" commodities produced by the company. For each of them there is exactly one integer in the final report, that denotes corresponding revenue. Before the report gets to Blake, it passes through the hands of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" managers. Each of them may reorder the elements in some order. Namely, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th manager either sorts first "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" numbers in non-descending or non-ascending order and then passes the report to the manager "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":", or directly to Blake (if this manager has number "},{"kind":"math_inline","text":"i = m"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Employees of the \"Blake Technologies\" are preparing the report right now. You know the initial sequence "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and the description of each manager, that is value "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and his favourite order. You are asked to speed up the process and determine how the final report will look like."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 200 000"},{"kind":"text","text":") — the number of commodities in the report and the number of managers, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|ai| ≤ 109"},{"kind":"text","text":") — the initial report before it gets to the first manager."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines with the descriptions of the operations managers are going to perform. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains two integers "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/c5ccbcf94d1c084bd890b443f6fd462c3ce4a7fe5050ff84708e86b6a109560b.png"},"kind":"image"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ri ≤ n"},{"kind":"text","text":"), meaning that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th manager sorts the first "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" numbers either in the non-descending (if "},{"kind":"math_inline","text":"ti = 1"},{"kind":"text","text":") or non-ascending (if "},{"kind":"math_inline","text":"ti = 2"},{"kind":"text","text":") order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers — the final report, which will be passed to Blake by manager number "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n1 2 3\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1 3 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n1 2 4 3\n2 3\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 4 1 3 "}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the initial report looked like: "},{"children":[{"kind":"text","text":"1 2 3"}],"kind":"container"},{"kind":"text","text":". After the first manager the first two numbers were transposed: "},{"children":[{"children":[{"kind":"text","text":"2 1"}],"kind":"container"},{"kind":"text","text":" 3"}],"kind":"container"},{"kind":"text","text":". The report got to Blake in this form."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the original report was like this: "},{"children":[{"kind":"text","text":"1 2 4 3"}],"kind":"container"},{"kind":"text","text":". After the first manager the report changed to: "},{"children":[{"children":[{"kind":"text","text":"4 2 1"}],"kind":"container"},{"kind":"text","text":" 3"}],"kind":"container"},{"kind":"text","text":". After the second manager the report changed to: "},{"children":[{"children":[{"kind":"text","text":"2 4"}],"kind":"container"},{"kind":"text","text":" 1 3"}],"kind":"container"},{"kind":"text","text":". This report was handed over to Blake."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"631C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/631/problem/C"}