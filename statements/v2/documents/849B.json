{"assets":[],"contentKind":"statement","contestId":"849","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Tell Your World"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Connect the countless points with lines, till we reach the faraway yonder."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" points on a coordinate plane, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of which being "},{"kind":"math_inline","text":"(i, yi)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine whether it's possible to draw two parallel and non-overlapping lines, such that every point in the set lies on "},{"children":[{"kind":"text","text":"exactly one"}],"kind":"container"},{"kind":"text","text":" of them, and each of them passes through "},{"children":[{"kind":"text","text":"at least one"}],"kind":"container"},{"kind":"text","text":" point in the set."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 1 000"},{"kind":"text","text":") — the number of points."}],"kind":"paragraph