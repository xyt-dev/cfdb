{"assets":["/statement-assets/c4a3600bd9765371c0d317ccf6798668c26a50d05288f44a95bbcd171db572a6.png"],"contentKind":"statement","contestId":"547","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Mike and Feet"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mike is the president of country What-The-Fatherland. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" bears living in this country besides Mike. All of them are standing in a line and they are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th bear is exactly "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" feet high. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c4a3600bd9765371c0d317ccf6798668c26a50d05288f44a95bbcd171db572a6.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"A group of bears is a non-empty contiguous segment of the line. The "},{"children":[{"kind":"text","text":"size"}],"kind":"container"},{"kind":"text","text":" of a group is the number of bears in that group. The "},{"children":[{"kind":"text","text":"strength"}],"kind":"container"},{"kind":"text","text":" of a group is the minimum height of the bear in that group."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mike is a curious to know for each "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"1 ≤ x ≤ n"},{"kind":"text","text":" the maximum strength among all groups of size "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2 × 105"},{"kind":"text","text":"), the number of bears."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers separated by space, "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":"), heights of bears."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers in one line. For each "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", print the maximum strength among all groups of size "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n1 2 3 4 5 4 3 2 1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6 4 4 3 3 2 2 1 1 1 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"547B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/547/problem/B"}