{"assets":["/statement-assets/4985133c49f078a321eb1ac25b7734dd52fe416c502610004a6302d7e0d6495f.png","/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"],"contentKind":"statement","contestId":"319","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Malek Dance Club"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As a tradition, every year before IOI all the members of Natalia Fan Club are invited to Malek Dance Club to have a fun night together. Malek Dance Club has "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" members and coincidentally Natalia Fan Club also has "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" members. Each member of MDC is assigned a unique id "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"2n - 1"},{"kind":"text","text":". The same holds for each member of NFC."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One of the parts of this tradition is one by one dance, where each member of MDC dances with a member of NFC. A dance pair is a pair of numbers "},{"kind":"math_inline","text":"(a, b)"},{"kind":"text","text":" such that member "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" from MDC dances with member "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" from NFC."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The complexity of a pairs' assignment is the number of pairs of dancing pairs "},{"kind":"math_inline","text":"(a, b)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(c, d)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"a < c"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b > d"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a binary number of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" named "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". We know that member "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from MDC dances with member "},{"attrs":{"alt":"","src":"/statement-assets/4985133c49f078a321eb1ac25b7734dd52fe416c502610004a6302d7e0d6495f.png"},"kind":"image"},{"kind":"text","text":" from NFC. Your task is to calculate the complexity of this assignment modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Expression "},{"attrs":{"alt":"","src":"/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"},"kind":"image"},{"kind":"text","text":" denotes applying «XOR» to numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". This operation exists in all modern programming languages, for example, in "},{"children":[{"kind":"text","text":"C++"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"Java"}],"kind":"container"},{"kind":"text","text":" it denotes as «"},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":"», in "},{"children":[{"kind":"text","text":"Pascal"}],"kind":"container"},{"kind":"text","text":" — «"},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":"»."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a binary number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" of lenght "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1 ≤ n ≤ 100)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This number may contain leading zeros."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the complexity of the given dance assignent modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"01\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"319A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/319/problem/A"}