{"assets":["/statement-assets/cb5a008540813eaf8ac64636db223db68d9f288573d056c5ce814df732e16ae6.png"],"contentKind":"statement","contestId":"540","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Infinite Inversions"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is an infinite sequence consisting of all positive integers in the increasing order: "},{"kind":"math_inline","text":"p = {1, 2, 3, ...}"},{"kind":"text","text":". We performed "},{"kind":"math_inline","text":"n"},{"children":[{"kind":"text","text":"swap"}],"kind":"container"},{"kind":"text","text":" operations with this sequence. A "},{"kind":"math_inline","text":"swap(a, b)"},{"kind":"text","text":" is an operation of swapping the elements of the sequence on positions "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Your task is to find the number of inversions in the resulting sequence, i.e. the number of such index pairs "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"i < j"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"pi > pj"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of "},{"children":[{"kind":"text","text":"swap"}],"kind":"container"},{"kind":"text","text":" operations applied to the sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":") — the arguments of the "},{"children":[{"kind":"text","text":"swap"}],"kind":"container"},{"kind":"text","text":" operation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of inversions in the resulting sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n4 2\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 6\n3 4\n2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"15\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the sequence is being modified as follows: "},{"attrs":{"alt":"","src":"/statement-assets/cb5a008540813eaf8ac64636db223db68d9f288573d056c5ce814df732e16ae6.png"},"kind":"image"},{"kind":"text","text":". It has 4 inversions formed by index pairs "},{"kind":"math_inline","text":"(1, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 4)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(3, 4)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"540E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/540/problem/E"}