{"assets":[],"contentKind":"statement","contestId":"822","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. I'm bored with life"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Holidays have finished. Thanks to the help of the hacker Leha, Noora managed to enter the university of her dreams which is located in a town Pavlopolis. It's well known that universities provide students with dormitory for the period of university studies. Consequently Noora had to leave Vičkopolis and move to Pavlopolis. Thus Leha was left completely alone in a quiet town Vičkopolis. He almost even fell into a depression from boredom!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Leha came up with a task for himself to relax a little. He chooses two integers "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" and then calculates the greatest common divisor of integers \""},{"kind":"math_inline","text":"A"},{"kind":"text","text":" factorial\" and \""},{"kind":"math_inline","text":"B"},{"kind":"text","text":" factorial\". Formally the hacker wants to find out GCD"},{"kind":"math_inline","text":"(A!, B!)"},{"kind":"text","text":". It's well known that the factorial of an integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is a product of all positive integers less than or equal to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". Thus "},{"kind":"math_inline","text":"x! = 1·2·3·...·(x - 1)·x"},{"kind":"text","text":". For example "},{"kind":"math_inline","text":"4! = 1·2·3·4 = 24"},{"kind":"text","text":". Recall that GCD"},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" is the largest positive integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" that divides (without a remainder) both "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Leha has learned how to solve this task very effective. You are able to cope with it not worse, aren't you?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and single line contains two integers "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"math_inline","text":"(1 ≤ A, B ≤ 109, min(A, B) ≤ 12)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer denoting the greatest common divisor of integers "},{"kind":"math_inline","text":"A!"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B!"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the sample."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"4! = 1·2·3·4 = 24"},{"kind":"text","text":". "},{"kind":"math_inline","text":"3! = 1·2·3 = 6"},{"kind":"text","text":". The greatest common divisor of integers "},{"kind":"math_inline","text":"24"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" is exactly "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"822A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/822/problem/A"}