{"assets":[],"contentKind":"statement","contestId":"1882","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Increasing Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a sequence $$$a_{1}, a_{2}, \\ldots, a_{n}$$$. A sequence $$$b_{1}, b_{2}, \\ldots, b_{n}$$$ is called "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":", if it satisfies all of the following conditions: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$b_{i}$$$ is a positive integer for $$$i = 1, 2, \\ldots, n$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b_{i} \\neq a_{i}$$$ for $$$i = 1, 2, \\ldots, n$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b_{1} \\lt b_{2} \\lt \\ldots \\lt b_{n}$$$. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" Find the minimum value of $$$b_{n}$$$ among all good sequences $$$b_{1}, b_{2}, \\ldots, b_{n}$$$."}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 100$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 100$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\le a_i \\le 10^{9}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single integer — the minimum value of $$$b_{n}$$$ among all good sequences $$$b$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n5\n1 3 2 6 7\n4\n2 3 4 5\n1\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n4\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, $$$b = [2, 4, 5, 7, 8]$$$ is a good sequence. It can be proved that there is no good $$$b$$$ with $$$b_{5} \\lt 8$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, $$$b = [1, 2, 3, 4]$$$ is an optimal good sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, $$$b = [2]$$$ is an optimal good sequence."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1882A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1882/problem/A"}