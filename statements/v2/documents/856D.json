{"assets":[],"contentKind":"statement","contestId":"856","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Masha and Cactus"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Masha is fond of cacti. When she was a little girl, she decided to plant a tree. Now Masha wants to make a nice cactus out of her tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Recall that "},{"children":[{"kind":"text","text":"tree"}],"kind":"container"},{"kind":"text","text":" is a connected undirected graph that has no cycles. "},{"children":[{"kind":"text","text":"Cactus"}],"kind":"container"},{"kind":"text","text":" is a connected undirected graph such that each vertex belongs to at most one cycle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Masha has some additional edges that she can add to a tree. For each edge she knows which vertices it would connect and the "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" of this edge. Masha can add some of these edges to the graph if the resulting graph is a cactus. "},{"children":[{"kind":"text","text":"Beauty"}],"kind":"container"},{"kind":"text","text":" of the resulting cactus is sum of beauties of all added edges. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Masha find out what maximum "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" of the resulting cactus she can achieve."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input data contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the number of vertices in a tree, and the number of additional edges available ("},{"kind":"math_inline","text":"3 ≤ n ≤ 2·105"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"0 ≤ m ≤ 2·105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us describe Masha's tree. It has a root at vertex 1. The second line contains "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"p2, p3, ..., pn"},{"kind":"text","text":", here "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" — is the parent of a vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" — the first vertex on a path from the vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to the root of the tree ("},{"kind":"math_inline","text":"1 ≤ pi < i"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain three integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" — pairs of vertices to be connected by the additional edges that Masha can add to the tree and "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" of edge ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"ui ≠ vi"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"1 ≤ ci ≤ 104"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that no additional edge coincides with the edge of the tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one integer — the maximum "},{"children":[{"kind":"text","text":"beauty"}],"kind":"container"},{"kind":"text","text":" of a cactus Masha can achieve."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 3\n1 1 2 2 3 3\n4 5 1\n6 7 1\n2 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"856D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/856/problem/D"}