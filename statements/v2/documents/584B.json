{"assets":["/statement-assets/58df0b3228ac17d684ad7189fa1cf98b2d321537614a3487c509bbc933c6f279.png"],"contentKind":"statement","contestId":"584","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Kolya and Tanya "}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Kolya loves putting gnomes at the circle table and giving them coins, and Tanya loves studying triplets of gnomes, sitting in the vertexes of an equilateral triangle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, there are "},{"kind":"math_inline","text":"3n"},{"kind":"text","text":" gnomes sitting in a circle. Each gnome can have from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" coins. Let's number the places in the order they occur in the circle by numbers from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"3n - 1"},{"kind":"text","text":", let the gnome sitting on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th place have "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" coins. If there is an integer "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ i < n"},{"kind":"text","text":") such that "},{"kind":"math_inline","text":"ai + ai + n + ai + 2n ≠ 6"},{"kind":"text","text":", then Tanya is satisfied. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Count the number of ways to choose "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" so that Tanya is satisfied. As there can be many ways of distributing coins, print the remainder of this number modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":". Two ways, "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", are considered distinct if there is index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ i < 3n"},{"kind":"text","text":"), such that "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":" (that is, some gnome got different number of coins in these two ways)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line contains number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of the gnomes divided by three."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the remainder of the number of variants of distributing coins that satisfy Tanya modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"680"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"math_inline","text":"20"},{"kind":"text","text":" ways for "},{"kind":"math_inline","text":"n = 1"},{"kind":"text","text":" (gnome with index "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" sits on the top of the triangle, gnome "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" on the right vertex, gnome "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" on the left vertex): "},{"attrs":{"alt":"","src":"/statement-assets/58df0b3228ac17d684ad7189fa1cf98b2d321537614a3487c509bbc933c6f279.png"},"kind":"image"}],"kind":"paragraph"},{"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"584B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/584/problem/B"}