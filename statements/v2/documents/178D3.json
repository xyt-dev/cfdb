{"assets":["/statement-assets/03df8521dfff926e5437154b182f43e47e2ce0666f0c15e316f29c103fab6dba.png"],"contentKind":"statement","contestId":"178","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D3. Magic Squares"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Smart Beaver from ABBYY loves puzzles. One of his favorite puzzles is the magic square. He has recently had an idea to automate the solution of this puzzle. The Beaver decided to offer this challenge to the ABBYY Cup contestants."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The magic square is a matrix of size "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":". The elements of this matrix are integers. The sum of numbers in each row of the matrix is equal to some number "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". The sum of numbers in each column of the matrix is also equal to "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". In addition, the sum of the elements on the main diagonal is equal to "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and the sum of elements on the secondary diagonal is equal to "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Examples of magic squares are given in the following figure:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/03df8521dfff926e5437154b182f43e47e2ce0666f0c15e316f29c103fab6dba.png"},"kind":"image"},{"children":[{"kind":"text","text":" Magic squares "}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"You are given a set of "},{"kind":"math_inline","text":"n2"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". It is required to place these numbers into a square matrix of size "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" so that they form a magic square. Note that each number must occur in the matrix exactly the same number of times as it occurs in the original set."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"It is guaranteed that a solution exists!"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The next line contains "},{"kind":"math_inline","text":"n2"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 108 ≤ ai ≤ 108"},{"kind":"text","text":"), separated by single spaces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The input limitations for getting 20 points are: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1 ≤ n ≤ 3"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The input limitations for getting 50 points are: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1 ≤ n ≤ 4"}],"kind":"list_item"},{"children":[{"kind":"text","text":" It is guaranteed that there are no more than 9 distinct numbers among "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The input limitations for getting 100 points are: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1 ≤ n ≤ 4"}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the output should contain a single integer "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". In each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, separated by spaces and describing the resulting magic square. In the resulting magic square the sums in the rows, columns and diagonals must be equal to "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". If there are multiple solutions, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3 4 5 6 7 8 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"15\n2 7 6\n9 5 1\n4 3 8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 0 -1 0 2 -1 -2 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n1 0 -1\n-2 0 2\n1 0 -1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n5 5 5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n5 5\n5 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D3","problemCode":"178D3","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/178/problem/D3"}