{"assets":["/statement-assets/c3fbbcaab7217a373b311a150460eea645e3ef421f15c22d2620cd6a45d4e881.png","/statement-assets/34a22e799a873e12c2b81d117d75af654b88e8d618995b91578f6ba652b621bd.png"],"contentKind":"statement","contestId":"172","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Pseudorandom Sequence Period"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarpus has recently got interested in sequences of pseudorandom numbers. He learned that many programming languages generate such sequences in a similar way: "},{"attrs":{"alt":"","src":"/statement-assets/c3fbbcaab7217a373b311a150460eea645e3ef421f15c22d2620cd6a45d4e881.png"},"kind":"image"},{"kind":"text","text":" (for "},{"kind":"math_inline","text":"i ≥ 1"},{"kind":"text","text":"). Here "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" are constants, fixed for the given realization of the pseudorandom numbers generator, "},{"kind":"math_inline","text":"r0"},{"kind":"text","text":" is the so-called "},{"kind":"math_inline","text":"randseed"},{"kind":"text","text":" (this value can be set from the program using functions like "},{"children":[{"kind":"text","text":"RandSeed(r)"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"srand(n)"}],"kind":"container"},{"kind":"text","text":"), and "},{"attrs":{"alt":"","src":"/statement-assets/34a22e799a873e12c2b81d117d75af654b88e8d618995b91578f6ba652b621bd.png"},"kind":"image"},{"kind":"text","text":" denotes the operation of taking the remainder of division."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if "},{"kind":"math_inline","text":"a = 2, b = 6, m = 12, r0 = 11"},{"kind":"text","text":", the generated sequence will be: "},{"kind":"math_inline","text":"4, 2, 10, 2, 10, 2, 10, 2, 10, 2, 10, ..."},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus realized that any such sequence will sooner or later form a cycle, but the cycle may occur not in the beginning, so there exist a preperiod and a period. The example above shows a preperiod equal to 1 and a period equal to 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the period of a sequence defined by the given values of "},{"kind":"math_inline","text":"a, b, m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r0"},{"kind":"text","text":". Formally, you have to find such minimum positive integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", for which exists such positive integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", that for any "},{"kind":"math_inline","text":"i ≥ k"},{"kind":"text","text":": "},{"kind":"math_inline","text":"ri = ri + t"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line of the input contains four integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r0"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 105, 0 ≤ a, b ≤ 1000, 0 ≤ r0 < m"},{"kind":"text","text":"), separated by single spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the period of the sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 6 12 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6 81 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first sample is described above. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the sequence is (starting from the first element): "},{"kind":"math_inline","text":"0, 3, 4, 1, 0, 3, 4, 1, 0, ..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample the sequence is (starting from the first element): "},{"kind":"math_inline","text":"33, 24, 78, 78, 78, 78, ..."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"172B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/172/problem/B"}