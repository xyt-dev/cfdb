{"assets":[],"contentKind":"statement","contestId":"468","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Permanent"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little X has solved the #P-complete problem in polynomial time recently. So he gives this task to you. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is a special "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" matrix "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", you should calculate its permanent modulo "},{"kind":"math_inline","text":"1000000007 (109 + 7)"},{"kind":"text","text":". The special property of matrix "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is almost all its elements equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Only "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" elements have specified value."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can find the definition of permanent at the link: "},{"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Permanent"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n, k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105; 1 ≤ k ≤ 50"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contain the description of the matrix. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains three space-separated integers "},{"kind":"math_inline","text":"xi, yi, wi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi,  yi ≤  n; 0  ≤  wi  ≤ 109"},{"kind":"text","text":"). These numbers denote that "},{"kind":"math_inline","text":"Axi, yi = wi"},{"kind":"text","text":". All the elements of the matrix except of the given elements are equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that all the positions "},{"kind":"math_inline","text":"(xi, yi)"},{"kind":"text","text":" are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the permanent of the matrix modulo "},{"kind":"math_inline","text":"1000000007 (109  +  7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n1 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 10\n3 3 367056794\n6 2 124561273\n1 3 46718146\n6 9 415916869\n10 5 985968336\n3 1 526792265\n1 4 386357058\n10 4 349304187\n2 7 102032499\n3 6 502679075\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"233333333\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"468E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/468/problem/E"}