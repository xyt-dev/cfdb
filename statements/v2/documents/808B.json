{"assets":["/statement-assets/116ae86aa45fc459b3f4f7a7404edab105965f11d2cce6b1a412debafa651b21.png"],"contentKind":"statement","contestId":"808","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Average Sleep Time"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"It's been almost a week since Polycarp couldn't get rid of insomnia. And as you may already know, one week in Berland lasts "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" days!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When Polycarp went to a doctor with his problem, the doctor asked him about his sleeping schedule (more specifically, the average amount of hours of sleep per week). Luckily, Polycarp kept records of sleep times for the last "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days. So now he has a sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the sleep time on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The number of records is so large that Polycarp is unable to calculate the average value by himself. Thus he is asking you to help him with the calculations. To get the average Polycarp is going to consider "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" consecutive days as a week. So there will be "},{"kind":"math_inline","text":"n - k + 1"},{"kind":"text","text":" weeks to take into consideration. For example, if "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n = 3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a = [3, 4, 7]"},{"kind":"text","text":", then the result is "},{"attrs":{"alt":"","src":"/statement-assets/116ae86aa45fc459b3f4f7a7404edab105965f11d2cce6b1a412debafa651b21.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You should write a program which will calculate average sleep times of Polycarp over all weeks."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 2·105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output average sleeping time over all weeks. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer is considered to be correct if its absolute or relative error does not exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":". In particular, it is enough to output real number with at least 6 digits after the decimal point."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n3 4 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9.0000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10.0000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 2\n1 2 4 100000 123 456 789 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"28964.2857142857\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the third example there are "},{"kind":"math_inline","text":"n - k + 1 = 7"},{"kind":"text","text":" weeks, so the answer is sums of all weeks divided by 7."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"808B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/808/problem/B"}