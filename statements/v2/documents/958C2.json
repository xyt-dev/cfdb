{"assets":["/statement-assets/53c59e0bc93d7c97af2248f74f2839a77885d06c27efaee78d7b21ee86e40db5.png"],"contentKind":"statement","contestId":"958","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C2. Encryption (medium)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Heidi has now broken the first level of encryption of the Death Star plans, and is staring at the screen presenting her with the description of the next code she has to enter. It looks surprisingly similar to the first one – seems like the Empire engineers were quite lazy..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Heidi is once again given a sequence "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", but now she is also given two integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". She needs to find out what the encryption key "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" is."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" be a sequence of integers, and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" a positive integer. We define the "},{"children":[{"kind":"text","text":"score"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" to be the sum of the elements of "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Heidi is given a sequence "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" that consists of "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" integers, and also given integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". Her goal is to split "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" part such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Each part contains at least "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" element of "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", and each part consists of contiguous elements of "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" No two parts overlap. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The total sum "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" of the scores of those parts is maximized. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Output the sum "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" – the encryption code."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three space-separated integer "},{"kind":"math_inline","text":"N"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"k ≤ N ≤ 20 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ k ≤ 50"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ p ≤ 100"},{"kind":"text","text":") – the number of elements in "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", the number of parts "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" should be split into, and the modulo for computing scores, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" space-separated integers that are the elements of "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". Each integer is from the interval "},{"kind":"math_inline","text":"[1, 1 000 000]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the number "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" as described in the problem statement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 10\n3 4 7 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"16\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 5 12\n16 3 24 13 9 8 7 5 12 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"37\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, if the input sequence is split as "},{"kind":"math_inline","text":"(3, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(7)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2)"},{"kind":"text","text":", the total score would be "},{"attrs":{"alt":"","src":"/statement-assets/53c59e0bc93d7c97af2248f74f2839a77885d06c27efaee78d7b21ee86e40db5.png"},"kind":"image"},{"kind":"text","text":". It is easy to see that this score is maximum."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, one possible way to obtain score "},{"kind":"math_inline","text":"37"},{"kind":"text","text":" is to make the following split: "},{"kind":"math_inline","text":"(16, 3, 24)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(13, 9)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(8)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(7)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(5, 12, 12)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C2","problemCode":"958C2","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/958/problem/C2"}