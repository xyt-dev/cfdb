{"assets":[],"contentKind":"statement","contestId":"1617","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Forbidden Subsequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given strings $$$S$$$ and $$$T$$$, consisting of lowercase English letters. It is guaranteed that $$$T$$$ is a permutation of the string "},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find string $$$S'$$$, the "},{"children":[{"kind":"text","text":"lexicographically smallest"}],"kind":"container"},{"kind":"text","text":" permutation of $$$S$$$ such that $$$T$$$ is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" a subsequence of $$$S'$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"String $$$a$$$ is a "},{"children":[{"kind":"text","text":"permutation"}],"kind":"container"},{"kind":"text","text":" of string $$$b$$$ if the number of occurrences of each distinct character is the same in both strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string $$$a$$$ is a "},{"children":[{"kind":"text","text":"subsequence"}],"kind":"container"},{"kind":"text","text":" of a string $$$b$$$ if $$$a$$$ can be obtained from $$$b$$$ by deletion of several (possibly, zero or all) elements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string $$$a$$$ is "},{"children":[{"kind":"text","text":"lexicographically smaller"}],"kind":"container"},{"kind":"text","text":" than a string $$$b$$$ if and only if one of the following holds:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a$$$ is a prefix of $$$b$$$, but $$$a \\ne b$$$;"}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the first position where $$$a$$$ and $$$b$$$ differ, the string $$$a$$$ has a letter that appears earlier in the alphabet than the corresponding letter in $$$b$$$."}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases. Description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a string $$$S$$$ ($$$1 \\le |S| \\le 100$$$), consisting of lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$T$$$ that is a permutation of the string "},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":". (Hence, $$$|T| = 3$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that there is no limit on the sum of $$$|S|$$$ across all test cases."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single string $$$S'$$$, the lexicographically smallest permutation of $$$S$$$ such that $$$T$$$ is not a subsequence of $$$S'$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\nabacaba\nabc\ncccba\nacb\ndbsic\nbac\nabracadabra\nabc\ndddddddddddd\ncba\nbbc\nabc\nac\nabc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\naaaacbb\nabccc\nbcdis\naaaaacbbdrr\ndddddddddddd\nbbc\nac\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, both "},{"children":[{"kind":"text","text":"aaaabbc"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"aaaabcb"}],"kind":"container"},{"kind":"text","text":" are lexicographically smaller than "},{"children":[{"kind":"text","text":"aaaacbb"}],"kind":"container"},{"kind":"text","text":", but they contain "},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":" as a subsequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, "},{"children":[{"kind":"text","text":"abccc"}],"kind":"container"},{"kind":"text","text":" is the smallest permutation of "},{"children":[{"kind":"text","text":"cccba"}],"kind":"container"},{"kind":"text","text":" and does not contain "},{"children":[{"kind":"text","text":"acb"}],"kind":"container"},{"kind":"text","text":" as a subsequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, "},{"children":[{"kind":"text","text":"bcdis"}],"kind":"container"},{"kind":"text","text":" is the smallest permutation of "},{"children":[{"kind":"text","text":"dbsic"}],"kind":"container"},{"kind":"text","text":" and does not contain "},{"children":[{"kind":"text","text":"bac"}],"kind":"container"},{"kind":"text","text":" as a subsequence."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1617A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1617/problem/A"}