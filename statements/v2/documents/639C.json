{"assets":["/statement-assets/136af9e7ba35ad0b525f75d76ff8a41337d4ca80e7ae965d8d1f5ff3b8a6e60a.png"],"contentKind":"statement","contestId":"639","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Bear and Polynomials"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Limak is a little polar bear. He doesn't have many toys and thus he often plays with polynomials."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He considers a polynomial "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" if its degree is "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and its coefficients are integers not exceeding "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" by the absolute value. More formally:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"a0, a1, ..., an"},{"kind":"text","text":" denote the coefficients, so "},{"attrs":{"alt":"","src":"/statement-assets/136af9e7ba35ad0b525f75d76ff8a41337d4ca80e7ae965d8d1f5ff3b8a6e60a.png"},"kind":"image"},{"kind":"text","text":". Then, a polynomial "},{"kind":"math_inline","text":"P(x)"},{"kind":"text","text":" is valid if all the following conditions are satisfied:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is integer for every "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"|ai| ≤ k"},{"kind":"text","text":" for every "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"an ≠ 0"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Limak has recently got a valid polynomial "},{"kind":"math_inline","text":"P"},{"kind":"text","text":" with coefficients "},{"kind":"math_inline","text":"a0, a1, a2, ..., an"},{"kind":"text","text":". He noticed that "},{"kind":"math_inline","text":"P(2) ≠ 0"},{"kind":"text","text":" and he wants to change it. He is going to change one coefficient to get a "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" polynomial "},{"kind":"math_inline","text":"Q"},{"kind":"text","text":" of degree "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" that "},{"kind":"math_inline","text":"Q(2) = 0"},{"kind":"text","text":". Count the number of ways to do so. You should count two ways as a distinct if coefficients of target polynoms differ."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000, 1 ≤ k ≤ 109"},{"kind":"text","text":") — the degree of the polynomial and the limit for absolute values of coefficients."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n + 1"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a0, a1, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|ai| ≤ k, an ≠ 0"},{"kind":"text","text":") — describing a "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" polynomial "},{"attrs":{"alt":"","src":"/statement-assets/136af9e7ba35ad0b525f75d76ff8a41337d4ca80e7ae965d8d1f5ff3b8a6e60a.png"},"kind":"image"},{"kind":"text","text":". It's guaranteed that "},{"kind":"math_inline","text":"P(2) ≠ 0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of ways to change one coefficient to get a valid polynomial "},{"kind":"math_inline","text":"Q"},{"kind":"text","text":" that "},{"kind":"math_inline","text":"Q(2) = 0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1000000000\n10 -9 -3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 12\n10 -9 -3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_b