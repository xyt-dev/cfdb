d":"text","text":" instead of "},{"kind":"math_inline","text":"109"},{"kind":"text","text":". Two first of ways listed above are still valid but in the third way we would get "},{"kind":"math_inline","text":"|a1| > k"},{"kind":"text","text":" what is not allowed. Thus, the answer is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" this time."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"639C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/639/problem/C"}