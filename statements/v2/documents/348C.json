"kind":"math_inline","text":"Sk"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain queries. Each query looks like either \""},{"children":[{"kind":"text","text":"? k"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"+ k x"}],"kind":"container"},{"kind":"text","text":"\" and sits on a single line. For all queries the following limits are held: "},{"kind":"math_inline","text":"1 ≤ k ≤ m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"|x| ≤ 108"},{"kind":"text","text":". The queries are given in order they need to be answered."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of sizes of all sets "},{"kind":"math_inline","text":"Sk"},{"kind":"text","text":" doesn't exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"After each first type query print the required sum on a single line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not write the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{