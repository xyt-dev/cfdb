{"assets":["/statement-assets/598b8c8e1923fce28ce1ec72fe7c4d6b01f6cc9b6ed8a184e910ea6038837781.png","/statement-assets/d92a37d2fdd8cdd11ae9550baa77c3bc90ee8231c508ad0b1fa1ecf7f35c08ab.png"],"contentKind":"statement","contestId":"915","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Almost Acyclic Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Directed_graph"},"children":[{"kind":"text","text":"directed graph"}],"kind":"link"},{"kind":"text","text":" consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges (each edge is directed, so it can be traversed in only one direction). You are allowed to remove at most one edge from it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Can you make this graph "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Directed_acyclic_graph"},"children":[{"kind":"text","text":"acyclic"}],"kind":"link"},{"kind":"text","text":" by removing at most one edge from it? A directed graph is called acyclic iff it doesn't contain any cycle (a non-empty path that starts and ends in the same vertex)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 500"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ min(n(n - 1), 100000)"},{"kind":"text","text":") — the number of vertices and the number of edges, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follow. Each line contains two integers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" denoting a directed edge going from vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ u, v ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"u ≠ v"},{"kind":"text","text":"). Each ordered pair "},{"kind":"math_inline","text":"(u, v)"},{"kind":"text","text":" is listed at most once (there is at most one directed edge from "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"v"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is possible to make this graph acyclic by removing at most one edge, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":". Otherwise, print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n1 2\n2 3\n3 2\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6\n1 2\n2 3\n3 2\n3 1\n2 1\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example you can remove edge "},{"attrs":{"alt":"","src":"/statement-assets/598b8c8e1923fce28ce1ec72fe7c4d6b01f6cc9b6ed8a184e910ea6038837781.png"},"kind":"image"},{"kind":"text","text":", and the graph becomes acyclic."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example you have to remove at least two edges (for example, "},{"attrs":{"alt":"","src":"/statement-assets/d92a37d2fdd8cdd11ae9550baa77c3bc90ee8231c508ad0b1fa1ecf7f35c08ab.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/statement-assets/598b8c8e1923fce28ce1ec72fe7c4d6b01f6cc9b6ed8a184e910ea6038837781.png"},"kind":"image"},{"kind":"text","text":") in order to make the graph acyclic."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"915D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/915/problem/D"}