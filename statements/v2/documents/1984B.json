{"assets":[],"contentKind":"statement","contestId":"1984","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Large Addition"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A digit is "},{"children":[{"kind":"text","text":"large"}],"kind":"container"},{"kind":"text","text":" if it is between $$$5$$$ and $$$9$$$, inclusive. A positive integer is "},{"children":[{"kind":"text","text":"large"}],"kind":"container"},{"kind":"text","text":" if all of its digits are large."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an integer $$$x$$$. Can it be the sum of two "},{"children":[{"kind":"text","text":"large"}],"kind":"container"},{"kind":"text","text":" positive integers with the "},{"children":[{"kind":"text","text":"same number of digits"}],"kind":"container"},{"kind":"text","text":"?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a single integer $$$x$$$ ($$$10 \\leq x \\leq 10^{18}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output $$$\\texttt{YES}$$$ if $$$x$$$ satisfies the condition, and $$$\\texttt{NO}$$$ otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output $$$\\texttt{YES}$$$ and $$$\\texttt{NO}$$$ in any case (for example, strings $$$\\texttt{yES}$$$, $$$\\texttt{yes}$$$, and $$$\\texttt{Yes}$$$ will be recognized as a positive response)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n11\n1337\n200\n1393938\n1434\n98765432123456789\n11111111111111111\n420\n1984\n10\n69\n119\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\nYES\nYES\nNO\nYES\nNO\nYES\nYES\nNO\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, we can have $$$658 + 679 = 1337$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, it can be shown that no numbers of equal length and only consisting of large digits can add to $$$200$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, we can have $$$696\\,969 + 696\\,969 = 1\\,393\\,938$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, we can have $$$777 + 657 = 1434$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1984B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1984/problem/B"}