{"assets":[],"contentKind":"statement","contestId":"895","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. String Mark"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"At the Byteland State University marks are strings of the same length. Mark "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is considered better than "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" if string "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is lexicographically smaller than "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Recently at the BSU was an important test work on which Vasya recived the mark "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". It is very hard for the teacher to remember the exact mark of every student, but he knows the mark "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", such that every student recieved mark strictly smaller than "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya isn't satisfied with his mark so he decided to improve it. He can swap characters in the string corresponding to his mark as many times as he like. Now he want to know only the number of different ways to improve his mark so that his teacher didn't notice something suspicious."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally: you are given two strings "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" of the same length and you need to figure out the number of different strings "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" such that:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1) "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" can be obtained from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" by swapping some characters, in other words "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" is a permutation of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2) String "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is lexicographically smaller than "},{"kind":"math_inline","text":"c"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"3) String "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" is lexicographically smaller than "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For two strings "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" of the same length it is true that "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is lexicographically smaller than "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" if there exists such "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"x1 = y1, x2 = y2, ..., xi - 1 = yi - 1, xi < yi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since the answer can be very large, you need to find answer modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains string "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", second line contains string "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Strings "},{"kind":"math_inline","text":"a, b"},{"kind":"text","text":" consist of lowercase English letters. Their lengths are equal and don't exceed "},{"kind":"math_inline","text":"106"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is lexicographically smaller than "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer  — the number of different strings satisfying the condition of the problem modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abc\nddd\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abcdef\nabcdeg\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abacaba\nubuduba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"64\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In first sample from string "},{"kind":"math_inline","text":"abc"},{"kind":"text","text":" can be obtained strings "},{"kind":"math_inline","text":"acb, bac, bca, cab, cba"},{"kind":"text","text":", all of them are larger than "},{"kind":"math_inline","text":"abc"},{"kind":"text","text":", but smaller than "},{"kind":"math_inline","text":"ddd"},{"kind":"text","text":". So the answer is "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In second sample any string obtained from "},{"kind":"math_inline","text":"abcdef"},{"kind":"text","text":" is larger than "},{"kind":"math_inline","text":"abcdeg"},{"kind":"text","text":". So the answer is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"895D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/895/problem/D"}