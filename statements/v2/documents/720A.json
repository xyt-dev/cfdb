{"assets":[],"contentKind":"statement","contestId":"720","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Closing ceremony"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The closing ceremony of Squanch Code Cup is held in the big hall with "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" seats, arranged in "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows, "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" seats in a row. Each seat has two coordinates "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ y ≤ m"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are two queues of people waiting to enter the hall: "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" people are standing at "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n·m - k"},{"kind":"text","text":" people are standing at "},{"kind":"math_inline","text":"(0, m + 1)"},{"kind":"text","text":". Each person should have a ticket for a specific seat. If person "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" at "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" has ticket for seat "},{"kind":"math_inline","text":"(xp, yp)"},{"kind":"text","text":" then he should walk "},{"kind":"math_inline","text":"|x - xp| + |y - yp|"},{"kind":"text","text":" to get to his seat."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each person has a stamina — the maximum distance, that the person agrees to walk. You should find out if this is possible to distribute all "},{"kind":"math_inline","text":"n·m"},{"kind":"text","text":" tickets in such a way that each person has enough stamina to get to their seat."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n·m ≤ 104"},{"kind":"text","text":") — the size of the hall."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains several integers. The first integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ k ≤ n·m"},{"kind":"text","text":") — the number of people at "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":". The following "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers indicate stamina of each person there."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line also contains several integers. The first integer "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"l = n·m - k"},{"kind":"text","text":") — the number of people at "},{"kind":"math_inline","text":"(0, m + 1)"},{"kind":"text","text":". The following "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" integers indicate stamina of each person there."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The stamina of the person is a positive integer less that or equal to "},{"kind":"math_inline","text":"n + m"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is possible to distribute tickets between people in the described manner print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\", otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n3 3 3 2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n3 2 3 3\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"720A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/720/problem/A"}