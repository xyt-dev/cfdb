{"assets":[],"contentKind":"statement","contestId":"727","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Bill Total Value"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasily exited from a store and now he wants to recheck the total price of all purchases in his bill. The bill is a string in which the names of the purchases and their prices are printed in a row without any spaces. Check has the format \""},{"children":[{"kind":"math_inline","text":"name1price1name2price2...namenpricen"}],"kind":"container"},{"kind":"text","text":"\", where "},{"kind":"math_inline","text":"namei"},{"kind":"text","text":" (name of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th purchase) is a non-empty string of length not more than "},{"kind":"math_inline","text":"10"},{"kind":"text","text":", consisting of lowercase English letters, and "},{"kind":"math_inline","text":"pricei"},{"kind":"text","text":" (the price of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th purchase) is a non-empty string, consisting of digits and dots (decimal points). It is possible that purchases with equal names have different prices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The price of each purchase is written in the following format. If the price is an integer number of dollars then cents are not written."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, after the number of dollars a dot (decimal point) is written followed by cents "},{"children":[{"kind":"text","text":"in a two-digit format"}],"kind":"container"},{"kind":"text","text":" (if number of cents is between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" inclusively, there is a leading zero)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, every three digits (from less significant to the most) in dollars are separated by dot (decimal point). No extra leading zeroes are allowed. The price always starts with a digit and ends with a digit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"234"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"1.544"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"149.431.10"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"0.99"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"123.05"}],"kind":"container"},{"kind":"text","text":"\" are valid prices, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":".333"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"3.33.11"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"12.00"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":".33"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"0.1234"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1.2"}],"kind":"container"},{"kind":"text","text":"\" are not valid. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Write a program that will find the total price of all purchases in the given bill."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains a non-empty string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" with length not greater than "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":" — the content of the bill."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the bill meets the format described above. It is guaranteed that each price in the bill is not less than one cent and not greater than "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" dollars."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the total price "},{"children":[{"kind":"text","text":"exactly in the same format"}],"kind":"container"},{"kind":"text","text":" as prices given in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"chipsy48.32televizor12.390\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12.438.32\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"a1b2c3.38\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6.38\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"aa0.01t0.03\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.04\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"727B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/727/problem/B"}