{"assets":[],"contentKind":"statement","contestId":"367","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Sereja and Intervals"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sereja is interested in intervals of numbers, so he has prepared a problem about intervals for you. An interval of numbers is a pair of integers "},{"kind":"math_inline","text":"[l, r]"},{"kind":"math_inline","text":"(1 ≤ l ≤ r ≤ m)"},{"kind":"text","text":". Interval "},{"kind":"math_inline","text":"[l1, r1]"},{"kind":"text","text":" belongs to interval "},{"kind":"math_inline","text":"[l2, r2]"},{"kind":"text","text":" if the following condition is met: "},{"kind":"math_inline","text":"l2 ≤ l1 ≤ r1 ≤ r2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sereja wants to write out a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" intervals "},{"kind":"math_inline","text":"[l1, r1]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"[l2, r2]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"[ln, rn]"},{"kind":"text","text":" on a piece of paper. At that, no interval in the sequence can belong to some other interval of the sequence. Also, Sereja loves number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" very much and he wants some (at least one) interval in the sequence to have "},{"kind":"math_inline","text":"li = x"},{"kind":"text","text":". Sereja wonders, how many distinct ways to write such intervals are there?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Sereja and find the required number of ways modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two ways are considered distinct if there is such "},{"kind":"math_inline","text":"j"},{"kind":"math_inline","text":"(1 ≤ j ≤ n)"},{"kind":"text","text":", that the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th intervals in two corresponding sequences are not equal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"(1 ≤ n·m ≤ 100000, 1 ≤ x ≤ m)"},{"kind":"text","text":" — the number of segments in the sequence, the constraints on the numbers in segments and Sereja's favourite number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print the answer modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"240\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In third example next sequences will be correct: "},{"kind":"math_inline","text":"{[1, 1], [3, 3]}"},{"kind":"text","text":", "},{"kind":"math_inline","text":"{[1, 2], [3, 3]}"},{"kind":"text","text":", "},{"kind":"math_inline","text":"{[2, 2], [3, 3]}"},{"kind":"text","text":", "},{"kind":"math_inline","text":"{[3, 3], [1, 1]}"},{"kind":"text","text":", "},{"kind":"math_inline","text":"{[3, 3], [2, 2]}"},{"kind":"text","text":", "},{"kind":"math_inline","text":"{[3, 3], [1, 2]}"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"367E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/367/problem/E"}