{"assets":["/statement-assets/a52468d1f73b5c12dffde8a086b722523269f57a49e211a3fcef86ddea9a9a5c.png"],"contentKind":"statement","contestId":"802","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D3. Marmots (hard)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Your task is the exact same as for the "},{"children":[{"kind":"text","text":"easy"}],"kind":"container"},{"kind":"text","text":" version. But this time, the marmots subtract the village's population "},{"kind":"math_inline","text":"P"},{"kind":"text","text":" from their random number before responding to Heidi's request."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, there are now villages with as few as a single inhabitant, meaning that "},{"attrs":{"alt":"","src":"/statement-assets/a52468d1f73b5c12dffde8a086b722523269f57a49e211a3fcef86ddea9a9a5c.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Can you help Heidi find out whether a village follows a Poisson or a uniform distribution?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Same as for the easy and medium versions. But remember that now "},{"kind":"math_inline","text":"1 ≤ P ≤ 1000"},{"kind":"text","text":" and that the marmots may provide positive as well as negative integers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one line per village, in the same order as provided in the input. The village's line shall state "},{"children":[{"kind":"text","text":"poisson"}],"kind":"container"},{"kind":"text","text":" if the village's distribution is of the Poisson type, and "},{"children":[{"kind":"text","text":"uniform"}],"kind":"container"},{"kind":"text","text":" if the answers came from a uniform distribution."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D3","problemCode":"802D3","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/802/problem/D3"}