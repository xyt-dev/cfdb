{"assets":["/statement-assets/a9c09e91d6533e0b9db74a1bd915c509a83bd2f07b18d8be79646a6326842f77.png"],"contentKind":"statement","contestId":"871","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Restore the Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya had a tree consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Accidentally he lost his tree. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya remembers information about "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" vertices: distances from each of them to each of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" tree vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to restore any tree that satisfies the information that Petya remembers or report that such tree doesn't exist."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 30 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ min(200, n)"},{"kind":"text","text":") — the number of vertices in the tree and the number of vertices about which Petya remembers distance information."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contain remembered information. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"di, 1, di, 2, ..., di, n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ di, j ≤ n - 1"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"di, j"},{"kind":"text","text":" — the distance to "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th vertex from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex that Petya remembers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there are no suitable trees, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the other case, print "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines: each line should contain two vertices connected by edge in the required tree. You can print edges and vertices in an edge in any order. The tree vertices are enumerated from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are many solutions print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n0 1 2 3 2\n2 1 0 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n3 2\n4 3\n5 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Picture for the first sample:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a9c09e91d6533e0b9db74a1bd915c509a83bd2f07b18d8be79646a6326842f77.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"871E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/871/problem/E"}