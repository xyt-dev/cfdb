{"assets":[],"contentKind":"statement","contestId":"341","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Iahub and Xors"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Iahub does not like background stories, so he'll tell you exactly what this problem asks you for."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a matrix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" columns. Initially, all values of the matrix are zeros. Both rows and columns are 1-based, that is rows are numbered 1, 2, ..., "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and columns are numbered 1, 2, ..., "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Let's denote an element on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column as "},{"kind":"math_inline","text":"ai, j"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We will call a submatrix "},{"kind":"math_inline","text":"(x0, y0, x1, y1)"},{"kind":"text","text":" such elements "},{"kind":"math_inline","text":"ai, j"},{"kind":"text","text":" for which two inequalities hold: "},{"kind":"math_inline","text":"x0 ≤ i ≤ x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y0 ≤ j ≤ y1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Write a program to perform two following operations:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Query("},{"kind":"math_inline","text":"x0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":"): print the xor sum of the elements of the submatrix "},{"kind":"math_inline","text":"(x0, y0, x1, y1)"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Update("},{"kind":"math_inline","text":"x0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"): each element from submatrix "},{"kind":"math_inline","text":"(x0, y0, x1, y1)"},{"kind":"text","text":" gets xor-ed by value "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":"). The number "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" represents the number of operations you need to perform. Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains five or six integers, depending on operation type. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th operation from the input is a query, the first number from "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line will be 1. It will be followed by four integers "},{"kind":"math_inline","text":"x0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":". If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th operation is an update, the first number from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line will be 2. It will be followed by five integers "},{"kind":"math_inline","text":"x0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that for each update operation, the following inequality holds: "},{"kind":"math_inline","text":"0 ≤ v < 262"},{"kind":"text","text":". It is guaranteed that for each operation, the following inequalities hold: "},{"kind":"math_inline","text":"1 ≤ x0 ≤ x1 ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ y0 ≤ y1 ≤ n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query operation, output on a new line the result."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n2 1 1 2 2 1\n2 1 3 2 3 2\n2 3 1 3 3 3\n1 2 2 3 3\n1 2 2 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"After the first "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" operations, the matrix will look like this: "}],"kind":"paragraph"},{"kind":"code_block","text":"\n1 1 2\n1 1 2\n3 3 3\n"},{"children":[{"kind":"text","text":"The fourth operation asks us to compute 1 xor 2 xor 3 xor 3 = 3."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fifth operation asks us to compute 1 xor 3 = 2. "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"341D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/341/problem/D"}