{"assets":[],"contentKind":"statement","contestId":"1266","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Almost Same Distance"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let $$$G$$$ be a simple graph. Let $$$W$$$ be a non-empty subset of vertices. Then $$$W$$$ is "},{"children":[{"kind":"text","text":"almost-$$$k$$$-uniform"}],"kind":"container"},{"kind":"text","text":" if for each pair of distinct vertices $$$u,v \\in W$$$ the distance between $$$u$$$ and $$$v$$$ is either $$$k$$$ or $$$k+1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a tree on $$$n$$$ vertices. For each $$$i$$$ between $$$1$$$ and $$$n$$$, find the maximum size of an almost-$$$i$$$-uniform set."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$2 \\leq n \\leq 5 \\cdot 10^5$$$) – the number of vertices of the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$n-1$$$ lines follows, the $$$i$$$-th of which consisting of two space separated integers $$$u_i$$$, $$$v_i$$$ ($$$1 \\leq u_i, v_i \\leq n$$$) meaning that there is an edge between vertices $$$u_i$$$ and $$$v_i$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given graph is tree. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single line containing $$$n$$$ space separated integers $$$a_i$$$, where $$$a_i$$$ is the maximum size of an almost-$$$i$$$-uniform set."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 2\n1 3\n1 4\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4 3 2 1 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 2\n1 3\n1 4\n4 5\n4 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4 4 2 1 1 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first example. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The only maximum almost-$$$1$$$-uniform set is $$$\\{1, 2, 3, 4\\}$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" One of the maximum almost-$$$2$$$-uniform sets is or $$$\\{2, 3, 5\\}$$$, another one is $$$\\{2, 3, 4\\}$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A maximum almost-$$$3$$$-uniform set is any pair of vertices on distance $$$3$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Any single vertex is an almost-$$$k$$$-uniform set for $$$k \\geq 1$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second sample there is an almost-$$$2$$$-uniform set of size $$$4$$$, and that is $$$\\{2, 3, 5, 6\\}$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1266F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1266/problem/F"}