{"assets":[],"contentKind":"statement","contestId":"1182","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Beautiful Lyrics"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given $$$n$$$ words, each of which consists of lowercase alphabet letters. Each word "},{"children":[{"kind":"text","text":"contains at least"}],"kind":"container"},{"kind":"text","text":" one vowel. You are going to choose some of the given words and make as many beautiful lyrics as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each "},{"children":[{"kind":"text","text":"lyric"}],"kind":"container"},{"kind":"text","text":" consists of two lines. Each "},{"children":[{"kind":"text","text":"line"}],"kind":"container"},{"kind":"text","text":" consists of two words separated by whitespace. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A lyric is "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if and only if it satisfies all conditions below. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The number of vowels in the first word of the first line is the same as the number of vowels in the first word of the second line. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The number of vowels in the second word of the first line is the same as the number of vowels in the second word of the second line. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The last vowel of the first line is the same as the last vowel of the second line. Note that there may be consonants after the vowel. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Also, letters \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"i"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"u"}],"kind":"container"},{"kind":"text","text":"\" are vowels. Note that \""},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":"\" is "},{"children":[{"kind":"text","text":"never"}],"kind":"container"},{"kind":"text","text":" vowel."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example of a beautiful lyric, "}],"kind":"paragraph"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"hello hellooowww"}],"kind":"container"},{"kind":"text","text":"\" "},{"children":[{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"whatsup yowowowow"}],"kind":"container"},{"kind":"text","text":"\" "}],"kind":"paragraph"}],"kind":"container"},{"kind":"text","text":" is a beautiful lyric because there are two vowels each in \""},{"children":[{"kind":"text","text":"hello"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"whatsup"}],"kind":"container"},{"kind":"text","text":"\", four vowels each in \""},{"children":[{"kind":"text","text":"hellooowww"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"yowowowow"}],"kind":"container"},{"kind":"text","text":"\" (keep in mind that \""},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":"\" is not a vowel), and the last vowel of each line is \""},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"\"."},{"children":[{"kind":"text","text":"For example of a not beautiful lyric, "}],"kind":"paragraph"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"hey man"}],"kind":"container"},{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"iam mcdic"}],"kind":"container"},{"kind":"text","text":"\" "}],"kind":"paragraph"}],"kind":"container"},{"kind":"text","text":" is not a beautiful lyric because \""},{"children":[{"kind":"text","text":"hey"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"iam"}],"kind":"container"},{"kind":"text","text":"\" don't have same number of vowels and the last vowels of two lines are different (\""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" in the first and \""},{"children":[{"kind":"text","text":"i"}],"kind":"container"},{"kind":"text","text":"\" in the second)."},{"children":[{"kind":"text","text":"How many beautiful lyrics can you write from given words? Note that you cannot use a word more times than it is given to you. For example, if a word is given three times, you can use it at most three times."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer $$$n$$$ ($$$1 \\le n \\le 10^{5}$$$) — the number of words."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the next $$$n$$$ lines contains string $$$s_{i}$$$ consisting lowercase alphabet letters — the $$$i$$$-th word. It is guaranteed that the sum of the total word length is equal or less than $$$10^{6}$$$. Each word contains at least one vowel."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, print $$$m$$$ — the number of maximum possible beautiful lyrics."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In next $$$2m$$$ lines, print $$$m$$$ beautiful lyrics (two lines per lyric)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n14\nwow\nthis\nis\nthe\nfirst\nmcdics\ncodeforces\nround\nhooray\ni\nam\nproud\nabout\nthat\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\nabout proud\nhooray round\nwow first\nthis is\ni that\nmcdics am\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\narsijo\nsuggested\nthe\nidea\nfor\nthis\nproblem\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nsame\nsame\nsame\ndiffer\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\nsame differ\nsame same\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, those beautiful lyrics are one of the possible answers. Let's look at the first lyric on the sample output of the first example. \""},{"children":[{"kind":"text","text":"about proud hooray round"}],"kind":"container"},{"kind":"text","text":"\" forms a beautiful lyric because \""},{"children":[{"kind":"text","text":"about"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"hooray"}],"kind":"container"},{"kind":"text","text":"\" have same number of vowels, \""},{"children":[{"kind":"text","text":"proud"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"round"}],"kind":"container"},{"kind":"text","text":"\" have same number of vowels, and both lines have same last vowel. On the other hand, you cannot form any beautiful lyric with the word \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, you cannot form any beautiful lyric from given words."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, you can use the word \""},{"children":[{"kind":"text","text":"same"}],"kind":"container"},{"kind":"text","text":"\" up to three times."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1182C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1182/problem/C"}