{"assets":["/statement-assets/a966537750beb8979a71e65d90f3a54ae51d172b07fa56594db46a3cae61cd89.png","/statement-assets/54d180d984952398822c6b4684f31e4469530e1d8900cb71dd376f4d6ba36d01.png"],"contentKind":"statement","contestId":"1404","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Bricks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A brick is defined as a rectangle with integer side lengths with either width $$$1$$$ or height $$$1$$$ (or both)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is an $$$n\\times m$$$ grid, and each cell is colored either black or white. A tiling is a way to place bricks onto the grid such that each black cell is covered by exactly one brick, and each white cell is not covered by any brick. In other words, bricks are placed on black cells only, cover all black cells, and "},{"children":[{"kind":"text","text":"no two bricks overlap"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a966537750beb8979a71e65d90f3a54ae51d172b07fa56594db46a3cae61cd89.png"},"kind":"image"},{"kind":"text","text":" An example tiling of the first test case using $$$5$$$ bricks. It is possible to do better, using only $$$4$$$ bricks. "}],"kind":"container"},{"children":[{"kind":"text","text":"What is the minimum number of bricks required to make a valid tiling?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$, $$$m$$$ ($$$1\\le n, m\\le 200$$$) — the number of rows and columns, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n$$$ lines describe the grid. The $$$i$$$-th of these lines contains a string of length $$$m$$$, where the $$$j$$$-th character denotes the color of the cell in row $$$i$$$, column $$$j$$$. A black cell is given by \""},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"\", and a white cell is given by \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there is at least one black cell."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer, the minimum number of bricks required."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 4\n#.##\n####\n##..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6 6\n######\n##....\n######\n##...#\n##...#\n######\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10 8\n####..##\n#..#.##.\n#..#.###\n####.#.#\n....####\n.###.###\n###.#..#\n########\n###..###\n.##.###.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n18\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test case can be tiled with $$$4$$$ bricks placed vertically."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third test case can be tiled with $$$18$$$ bricks like this:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/54d180d984952398822c6b4684f31e4469530e1d8900cb71dd376f4d6ba36d01.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1404E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1404/problem/E"}