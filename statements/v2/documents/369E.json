{"assets":[],"contentKind":"statement","contestId":"369","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Valera and Queries"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Valera loves segments. He has recently come up with one interesting problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":" axis of coordinates has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" segments, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th segment starts in position "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and ends in position "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" (we will mark it as "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":"). Your task is to process "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries, each consists of number "},{"kind":"math_inline","text":"cnti"},{"kind":"text","text":" and a set of "},{"kind":"math_inline","text":"cnti"},{"kind":"text","text":" coordinates of points located on the "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":" axis. The answer to the query is the number of segments, such that each of them contains at least one point from the query. Segment "},{"kind":"math_inline","text":"[l, r]"},{"children":[{"kind":"text","text":"contains"}],"kind":"container"},{"kind":"text","text":" point "},{"kind":"math_inline","text":"q"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"l ≤ q ≤ r"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valera found the solution of this problem too difficult. So he asked you to help him. Help Valera. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 3·105"},{"kind":"text","text":") — the number of segments on the axis of coordinates and the number of queries. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the descriptions of the segments. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two positive integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ 106"},{"kind":"text","text":") — the borders of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the description of the queries, one per line. Each line starts from integer "},{"kind":"math_inline","text":"cnti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ cnti ≤ 3·105"},{"kind":"text","text":") — the number of points in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query. Then the line contains "},{"kind":"math_inline","text":"cnti"},{"kind":"text","text":" distinct positive integers "},{"kind":"math_inline","text":"p1, p2, ..., pcnti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ p1 < p2 < ... < pcnti ≤ 106"},{"kind":"text","text":") — the coordinates of points in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the total number of points in all queries doesn't exceed "},{"kind":"math_inline","text":"3·105"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" non-negative integers, where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number is the response to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 3\n4 5\n6 7\n3 1 4 7\n2 4 5\n1 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"369E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/369/problem/E"}