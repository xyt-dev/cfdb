{"assets":["/statement-assets/51727ab09f8f0665fa69baa913af13f4a505fa90e27040afaf6af40920436655.png","/statement-assets/ddab7dc2f39f7bd7031987674ec8772beed89054b50754b7923f37f93f8a809c.png","/statement-assets/9a693af497bf5cd77498af71d71dfbbce4530d8aee863e73c47876a669aa56b8.png","/statement-assets/2567eb24af0c0c31f8453ef8bbb736a60144733c0f9113849119986e6b95fff1.png"],"contentKind":"statement","contestId":"330","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Cakeminator"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a rectangular cake, represented as an "},{"kind":"math_inline","text":"r × c"},{"kind":"text","text":" grid. Each cell either has an evil strawberry, or is empty. For example, a "},{"kind":"math_inline","text":"3 × 4"},{"kind":"text","text":" cake may look as follows:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/51727ab09f8f0665fa69baa913af13f4a505fa90e27040afaf6af40920436655.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The cakeminator is going to eat the cake! Each time he eats, he chooses a row or a column that does not contain any evil strawberries and contains at least one cake cell that has not been eaten before, and eats all the cake cells there. He may decide to eat any number of times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please output the maximum number of cake cells that the cakeminator can eat."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ r, c ≤ 10"},{"kind":"text","text":"), denoting the number of rows and the number of columns of the cake. The next "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" lines each contains "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" characters — the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th character of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line denotes the content of the cell at row "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and column "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", and is either one of these: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' character denotes a cake cell with no evil strawberry; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"S"}],"kind":"container"},{"kind":"text","text":"' character denotes a cake cell with an evil strawberry. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the maximum number of cake cells that the cakeminator can eat."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\nS...\n....\n..S.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first example, one possible way to eat the maximum number of cake cells is as follows (perform 3 eats)."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ddab7dc2f39f7bd7031987674ec8772beed89054b50754b7923f37f93f8a809c.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9a693af497bf5cd77498af71d71dfbbce4530d8aee863e73c47876a669aa56b8.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/2567eb24af0c0c31f8453ef8bbb736a60144733c0f9113849119986e6b95fff1.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"330A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/330/problem/A"}