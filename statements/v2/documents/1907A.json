{"assets":["/statement-assets/81447bf2ff9247ec3f4832ebee1eb02d31e25d6683fa025817889a919b5cb67b.png"],"contentKind":"statement","contestId":"1907","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Rook"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As you probably know, chess is a game that is played on a board with 64 squares arranged in an $$$8\\times 8$$$ grid. Columns of this board are labeled with letters from "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"h"}],"kind":"container"},{"kind":"text","text":", and rows are labeled with digits from "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"8"}],"kind":"container"},{"kind":"text","text":". Each square is described by the row and column it belongs to."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/81447bf2ff9247ec3f4832ebee1eb02d31e25d6683fa025817889a919b5cb67b.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The rook is a piece in the game of chess. During its turn, it may move any non-zero number of squares horizontally or vertically. Your task is to find all possible moves for a rook on an empty chessboard."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains single integer $$$t$$$ ($$$1 \\le t \\le 64$$$) — the number of test cases. The descriptions of test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case contains one string of two characters, description of the square where rook is positioned. The first character is a letter from "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"h"}],"kind":"container"},{"kind":"text","text":", the label of column, and the second character is a digit from "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"8"}],"kind":"container"},{"kind":"text","text":", the label of row. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The same position may occur in more than one test case."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output descriptions of all squares where the rook can move, in the same format as in the input. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output squares in any order per test case."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1\nd5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nd1\nd2\nb5\ng5\nh5\nd3\ne5\nf5\nd8\na5\nd6\nd7\nc5\nd4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1907A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1907/problem/A"}