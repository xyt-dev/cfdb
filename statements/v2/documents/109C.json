{"assets":[],"contentKind":"statement","contestId":"109","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Lucky Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Petya loves lucky numbers. We all know that lucky numbers are the positive integers whose decimal representations contain only the lucky digits "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":". For example, numbers "},{"children":[{"kind":"text","text":"47"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"744"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" are lucky and "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"17"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"467"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One day Petya encountered a tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertexes. Besides, the tree was weighted, i. e. each edge of the tree has weight (a positive integer). An edge is lucky if its weight is a lucky number. Note that a "},{"children":[{"kind":"text","text":"tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertexes"}],"kind":"container"},{"kind":"text","text":" is an undirected connected graph that has exactly "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya wondered how many vertex triples "},{"kind":"math_inline","text":"(i, j, k)"},{"kind":"text","text":" exists that on the way from "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", as well as on the way from "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" there must be at least one lucky edge (all three vertexes are pairwise distinct). The order of numbers in the triple matters, that is, the triple "},{"kind":"math_inline","text":"(1, 2, 3)"},{"kind":"text","text":" is not equal to the triple "},{"kind":"math_inline","text":"(2, 1, 3)"},{"kind":"text","text":" and is not equal to the triple "},{"kind":"math_inline","text":"(1, 3, 2)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find how many such triples of vertexes exist."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of tree vertexes. Next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain three integers each: "},{"kind":"math_inline","text":"ui"},{"kind":"math_inline","text":"vi"},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n, 1 ≤ wi ≤ 109"},{"kind":"text","text":") — the pair of vertexes connected by the edge and the edge's weight."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the single line print the single number — the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the %lld specificator to read or write 64-bit numbers in С++. It is recommended to use the cin, cout streams or the %I64d specificator."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 4\n3 1 2\n1 4 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"16\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 4\n1 3 47\n1 4 7447\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"24\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"16"},{"kind":"text","text":" triples of vertexes from the first sample are: "},{"kind":"math_inline","text":"(1, 2, 4), (1, 4, 2), (2, 1, 3), (2, 1, 4), (2, 3, 1), (2, 3, 4), (2, 4, 1), (2, 4, 3), (3, 2, 4), (3, 4, 2), (4, 1, 2), (4, 1, 3), (4, 2, 1), (4, 2, 3), (4, 3, 1), (4, 3, 2)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample all the triples should be counted: "},{"kind":"math_inline","text":"4·3·2 = 24"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"109C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/109/problem/C"}