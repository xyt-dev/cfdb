{"assets":[],"contentKind":"statement","contestId":"3","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Least Cost Bracket Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"This is yet another problem on regular bracket sequences."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A bracket sequence is called regular, if by inserting \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" into it we get a correct mathematical expression. For example, sequences \""},{"children":[{"kind":"text","text":"(())()"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(()(()))"}],"kind":"container"},{"kind":"text","text":"\" are regular, while \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"(()"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(()))("}],"kind":"container"},{"kind":"text","text":"\" are not. You have a pattern of a bracket sequence that consists of characters \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\". You have to replace each character \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\" with a bracket so, that you get a regular bracket sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each character \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\" the cost of its replacement with \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\" is given. Among all the possible variants your should choose the cheapest."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a non-empty pattern of even length, consisting of characters \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\". Its length doesn't exceed "},{"kind":"math_inline","text":"5·104"},{"kind":"text","text":". Then there follow "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines, where "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is the number of characters \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\" in the pattern. Each line contains two integer numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai,  bi ≤ 106"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the cost of replacing the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character \""},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"\" with an opening bracket, and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" — with a closing one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the cost of the optimal regular bracket sequence in the first line, and the required sequence in the second."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":", if there is no answer. If the answer is not unique, print any of them. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"(??)\n1 2\n2 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n()()\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"3D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/3/problem/D"}