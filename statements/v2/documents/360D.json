{"assets":[],"contentKind":"statement","contestId":"360","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Levko and Sets"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Levko loves all sorts of sets very much."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Levko has two arrays of integers "},{"kind":"math_inline","text":"a1, a2, ... , an"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b1, b2, ... , bm"},{"kind":"text","text":" and a prime number "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". Today he generates "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sets. Let's describe the generation process for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th set:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" First it has a single number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Let's take any element "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" from this set. For all "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j ≤ m"},{"kind":"text","text":") if number "},{"kind":"math_inline","text":"(c·aibj) mod p"},{"kind":"text","text":" doesn't occur in the set, then add it to the set. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Repeat step "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" as long as we can add at least one element to our set. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Levko wonders, how many numbers belong to at least one set. That is, he wants to know what size is the union of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" generated sets."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 104"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ p ≤ 109"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is prime. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains space-separated integers "},{"kind":"math_inline","text":"a1, a2, ... , an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai < p"},{"kind":"text","text":"). The third line contains space-separated integers "},{"kind":"math_inline","text":"b1, b2, ... , bm"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single number — the size of the union of the sets."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},