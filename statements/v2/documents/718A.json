{"assets":[],"contentKind":"statement","contestId":"718","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Efim and Strange Grade"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Efim just received his grade for the last test. He studies in a special school and his grade can be equal to any positive decimal fraction. First he got disappointed, as he expected a way more pleasant result. Then, he developed a tricky plan. Each second, he can ask his teacher to round the grade at any place after the decimal point (also, he can ask to round to the nearest integer). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" seconds left till the end of the break, so Efim has to act fast. Help him find what is the maximum grade he can get in no more than "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" seconds. Note, that he can choose to not use all "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" seconds. Moreover, he can even choose to not round the grade at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem, classic rounding rules are used: while rounding number to the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th digit one has to take a look at the digit "},{"kind":"math_inline","text":"n + 1"},{"kind":"text","text":". If it is less than "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" than the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th digit remain unchanged while all subsequent digits are replaced with "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". Otherwise, if the "},{"kind":"math_inline","text":"n + 1"},{"kind":"text","text":" digit is greater or equal to "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", the digit at the position "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is increased by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" (this might also change some other digits, if this one was equal to "},{"kind":"math_inline","text":"9"},{"kind":"text","text":") and all subsequent digits are replaced with "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". At the end, all trailing zeroes are thrown away."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if the number "},{"kind":"math_inline","text":"1.14"},{"kind":"text","text":" is rounded to the first decimal place, the result is "},{"kind":"math_inline","text":"1.1"},{"kind":"text","text":", while if we round "},{"kind":"math_inline","text":"1.5"},{"kind":"text","text":" to the nearest integer, the result is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Rounding number "},{"kind":"math_inline","text":"1.299996121"},{"kind":"text","text":" in the fifth decimal place will result in number "},{"kind":"math_inline","text":"1.3"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ t ≤ 109"},{"kind":"text","text":") — the length of Efim's grade and the number of seconds till the end of the break respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the grade itself. It's guaranteed that the grade is a positive number, containing at least one digit after the decimal points, and it's representation doesn't finish with "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum grade that Efim can get in "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" seconds. Do not print trailing zeroes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 1\n10.245\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10.25\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2\n10.245\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10.3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 100\n9.2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9.2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first two samples Efim initially has grade "},{"kind":"math_inline","text":"10.245"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During the first second Efim can obtain grade "},{"kind":"math_inline","text":"10.25"},{"kind":"text","text":", and then "},{"kind":"math_inline","text":"10.3"},{"kind":"text","text":" during the next second. Note, that the answer "},{"kind":"math_inline","text":"10.30"},{"kind":"text","text":" will be considered incorrect."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample the optimal strategy is to not perform any rounding at all."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"718A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/718/problem/A"}