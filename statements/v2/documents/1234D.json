{"assets":[],"contentKind":"statement","contestId":"1234","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Distinct Characters Queries"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ consisting of lowercase Latin letters and $$$q$$$ queries for this string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Recall that the substring $$$s[l; r]$$$ of the string $$$s$$$ is the string $$$s_l s_{l + 1} \\dots s_r$$$. For example, the substrings of \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\" are \""},{"children":[{"kind":"text","text":"code"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"force"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"f"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"for"}],"kind":"container"},{"kind":"text","text":"\", but not \""},{"children":[{"kind":"text","text":"coder"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"top"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are two types of queries: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1~ pos~ c$$$ ($$$1 \\le pos \\le |s|$$$, $$$c$$$ is lowercase Latin letter): replace $$$s_{pos}$$$ with $$$c$$$ (set $$$s_{pos} := c$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$2~ l~ r$$$ ($$$1 \\le l \\le r \\le |s|$$$): calculate the number of distinct characters in the substring $$$s[l; r]$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one string $$$s$$$ consisting of no more than $$$10^5$$$ lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains one integer $$$q$$$ ($$$1 \\le q \\le 10^5$$$) — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$q$$$ lines contain queries, one per line. Each query is given in the format described in the problem statement. It is guaranteed that there is at least one query of the second type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the second type print the answer for it — the number of distinct characters in the required substring in this query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nabacaba\n5\n2 1 4\n1 4 b\n1 5 b\n2 4 6\n2 1 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{