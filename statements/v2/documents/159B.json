{"assets":[],"contentKind":"statement","contestId":"159","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Matchmaker"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarpus has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" markers and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" marker caps. Each marker is described by two numbers: "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" is the color and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" is the diameter. Correspondingly, each cap is described by two numbers: "},{"kind":"math_inline","text":"aj"},{"kind":"text","text":" is the color and "},{"kind":"math_inline","text":"bj"},{"kind":"text","text":" is the diameter. Cap "},{"kind":"math_inline","text":"(aj, bj)"},{"kind":"text","text":" can close marker "},{"kind":"math_inline","text":"(xi, yi)"},{"kind":"text","text":" only if their diameters match, that is, "},{"kind":"math_inline","text":"bj = yi"},{"kind":"text","text":". Besides, a marker is considered to be "},{"children":[{"kind":"text","text":"beautifully closed"}],"kind":"container"},{"kind":"text","text":", if the cap color and the marker color match, that is, "},{"kind":"math_inline","text":"aj = xi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the way to close the maximum number of markers. If there are several such ways, then choose the one that has the maximum number of "},{"children":[{"kind":"text","text":"beautifully closed"}],"kind":"container"},{"kind":"text","text":" markers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":") — the number of markers and the number of caps, correspondingly. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines describe the markers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two space-separated integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ 1000"},{"kind":"text","text":") — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th marker's color and diameter, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines describe the caps. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th line contains two space-separated integers "},{"kind":"math_inline","text":"aj"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ aj, bj ≤ 1000"},{"kind":"text","text":") — the color and diameter of the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th cap, correspondingly."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two space-separated integers "},{"kind":"math_inline","text":"u, v"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" is the number of closed markers and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is the number of "},{"children":[{"kind":"text","text":"beautifully closed"}],"kind":"container"},{"kind":"text","text":" markers in the sought optimal way. Remember that you have to find the way to close the maximum number of markers, and if there are several such ways, you should choose the one where the number of "},{"children":[{"kind":"text","text":"beautifully closed"}],"kind":"container"},{"kind":"text","text":" markers is maximum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n1 2\n3 4\n2 4\n5 4\n2 4\n1 1\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n1 2\n2 1\n3 4\n5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test sample the first marker should be closed by the fourth cap, the second marker should be closed by the first cap and the third marker should be closed by the second cap. Thus, three markers will be closed, and two of them will be "},{"children":[{"kind":"text","text":"beautifully closed"}],"kind":"container"},{"kind":"text","text":" — the first and the third markers."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"159B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/159/problem/B"}