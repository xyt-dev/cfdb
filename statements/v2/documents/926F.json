{"assets":[],"contentKind":"statement","contestId":"926","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Mobile Communications"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A sum of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" rubles is charged from Arkady's mobile phone account every day in the morning. Among the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" days, there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days when Arkady will top up the account: in the day "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" he will deposit "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" rubles on his mobile phone account. Arkady will always top up the account before the daily payment will be done. There will be no other payments nor tops up in the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" days."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the number of days starting from the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st to the "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-th such that the account will have a negative amount on it after the daily payment (i. e. in evening). Initially the account's balance is zero rubles."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ p ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n ≤ m"},{"kind":"text","text":") — the number of days Arkady will top up the account, the amount of the daily payment, and the number of days you should check."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ di ≤ m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ti ≤ 109"},{"kind":"text","text":") — the index of the day when Arkady will make the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th top up, and the amount he will deposit on this day. It is guaranteed that the indices of the days are distinct and are given in increasing order, i. e. "},{"kind":"math_inline","text":"di > di - 1"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of days from the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st to the "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-th such that the account will have a negative amount on it after the daily payment."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6 7\n2 13\n4 20\n7 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4 100\n10 70\n15 76\n21 12\n30 100\n67 85\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"26\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the balance will change as following (remember, initially the balance is zero):"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" in the first day "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" rubles will be charged, the balance in the evening will be equal to "},{"kind":"math_inline","text":" - 6"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the second day Arkady will deposit "},{"kind":"math_inline","text":"13"},{"kind":"text","text":" rubles, then "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" rubles will be charged, the balance in the evening will be equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the third day "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" rubles will be charged, the balance in the evening will be equal to "},{"kind":"math_inline","text":" - 5"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the fourth day Arkady will deposit "},{"kind":"math_inline","text":"20"},{"kind":"text","text":" rubles, then "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" rubles will be charged, the balance in the evening will be equal to "},{"kind":"math_inline","text":"9"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the fifth day "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" rubles will be charged, the balance in the evening will be equal to "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the sixth day "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" rubles will be charged, the balance in the evening will be equal to "},{"kind":"math_inline","text":" - 3"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in the seventh day Arkady will deposit "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" rubles, then "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" rubles will be charged, the balance in the evening will be equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Thus, in the end of the first, third and sixth days the balance will be negative in the end of the day."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"926F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/926/problem/F"}