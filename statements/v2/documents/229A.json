{"assets":[],"contentKind":"statement","contestId":"229","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Shifts"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a table consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" columns. Each cell of the table contains a number, 0 or 1. In one move we can choose some row of the table and cyclically shift its values either one cell to the left, or one cell to the right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To "},{"children":[{"kind":"text","text":"cyclically shift"}],"kind":"container"},{"kind":"text","text":" a table row one cell to the right means to move the value of each cell, except for the last one, to the right neighboring cell, and to move the value of the last cell to the first cell. A cyclical shift of a row to the left is performed similarly, but in the other direction. For example, if we cyclically shift a row \""},{"children":[{"kind":"text","text":"00110"}],"kind":"container"},{"kind":"text","text":"\" one cell to the right, we get a row \""},{"children":[{"kind":"text","text":"00011"}],"kind":"container"},{"kind":"text","text":"\", but if we shift a row \""},{"children":[{"kind":"text","text":"00110"}],"kind":"container"},{"kind":"text","text":"\" one cell to the left, we get a row \""},{"children":[{"kind":"text","text":"01100"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the minimum number of moves needed to make some table column consist only of numbers 1."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of rows in the table and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 104"},{"kind":"text","text":") — the number of columns in the table. Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, each of them contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\": the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th character of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line describes the contents of the cell in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and in the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column of the table."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the description of the table contains no other characters besides \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number: the minimum number of moves needed to get only numbers 1 in some column of the table. If this is impossible, print -1."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6\n101010\n000100\n100000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n111\n000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample one way to achieve the goal with the least number of moves is as follows: cyclically shift the second row to the right once, then shift the third row to the left twice. Then the table column before the last one will contain only 1s."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample one can't shift the rows to get a column containing only 1s."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"229A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/229/problem/A"}