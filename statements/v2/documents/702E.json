{"assets":["/statement-assets/fcc45f08b70970b9fec60636ab9bb0d9903a537a801968ade49ef5d72fa0b6b1.png"],"contentKind":"statement","contestId":"702","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Analysis of Pathes in Functional Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a "},{"children":[{"kind":"text","text":"functional graph"}],"kind":"container"},{"kind":"text","text":". It is a directed graph, in which from each vertex goes exactly one arc. The vertices are numerated from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Graph is given as the array "},{"kind":"math_inline","text":"f0, f1, ..., fn - 1"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":" — the number of vertex to which goes the only arc from the vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". Besides you are given array with weights of the arcs "},{"kind":"math_inline","text":"w0, w1, ..., wn - 1"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" — the arc weight from "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/fcc45f08b70970b9fec60636ab9bb0d9903a537a801968ade49ef5d72fa0b6b1.png"},"kind":"image"},{"children":[{"kind":"text","text":"The graph from the first sample test."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Also you are given the integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" (the length of the path) and you need to find for each vertex two numbers "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":", where:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"si"},{"kind":"text","text":" — the sum of the weights of all arcs of the path with length equals to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" which starts from the vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"mi"},{"kind":"text","text":" — the minimal weight from all arcs on the path with length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" which starts from the vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The length of the path is the number of arcs on this path."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n, k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105, 1 ≤ k ≤ 1010"},{"kind":"text","text":"). The second line contains the sequence "},{"kind":"math_inline","text":"f0, f1, ..., fn - 1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ fi < n"},{"kind":"text","text":") and the third — the sequence "},{"kind":"math_inline","text":"w0, w1, ..., wn - 1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ wi ≤ 108"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, the pair of integers "},{"kind":"math_inline","text":"si"},{"kind":"text","text":", "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":" in each line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 3\n1 2 3 4 3 2 6\n6 3 1 4 2 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10 1\n8 1\n7 1\n10 2\n8 2\n7 1\n9 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n0 1 2 3\n0 1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 0\n4 1\n8 2\n12 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n1 2 3 4 0\n4 1 2 14 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7 1\n17 1\n19 2\n21 3\n8 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"702E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/702/problem/E"}