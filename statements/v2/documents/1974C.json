{"assets":[],"contentKind":"statement","contestId":"1974","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Beautiful Triple Pairs"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp was given an array $$$a$$$ of $$$n$$$ integers. He really likes triples of numbers, so for each $$$j$$$ ($$$1 \\le j \\le n - 2$$$) he wrote down a triple of elements $$$[a_j, a_{j + 1}, a_{j + 2}]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp considers a pair of triples $$$b$$$ and $$$c$$$ "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if they differ in exactly one position, that is, one of the following conditions is satisfied:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$b_1 \\ne c_1$$$ and $$$b_2 = c_2$$$ and $$$b_3 = c_3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b_1 = c_1$$$ and $$$b_2 \\ne c_2$$$ and $$$b_3 = c_3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b_1 = c_1$$$ and $$$b_2 = c_2$$$ and $$$b_3 \\ne c_3$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Find the number of "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" pairs of triples among the written triples $$$[a_j, a_{j + 1}, a_{j + 2}]$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$3 \\le n \\le 2 \\cdot 10^5$$$) — the length of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^6$$$) — the elements of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of the values of $$$n$$$ for all test cases in the test does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the number of "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" pairs of triples among the pairs of the form $$$[a_j, a_{j + 1}, a_{j + 2}]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the answer may not fit into 32-bit data types."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n5\n3 2 2 2 3\n5\n1 2 1 2 1\n8\n1 2 3 2 2 3 4 2\n4\n2 1 1 1\n8\n2 1 1 2 1 1 1 1\n7\n2 1 1 1 1 1 1\n6\n2 1 1 1 1 1\n5\n2 1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n0\n3\n1\n8\n4\n3\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, $$$a = [3, 2, 2, 2, 3]$$$, Polycarp will write the following triples: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" $$$[3, 2, 2]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2, 2, 2]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2, 2, 3]$$$. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" The beautiful pairs are triple $$$1$$$ with triple $$$2$$$ and triple $$$2$$$ with triple $$$3$$$."},{"children":[{"kind":"text","text":"In the third example, $$$a = [1, 2, 3, 2, 2, 3, 4, 2]$$$, Polycarp will write the following triples: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" $$$[1, 2, 3]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2, 3, 2]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[3, 2, 2]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2, 2, 3]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2, 3, 4]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[3, 4, 2]$$$; "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" The beautiful pairs are triple $$$1$$$ with triple $$$4$$$, triple $$$2$$$ with triple $$$5$$$, and triple $$$3$$$ with triple $$$6$$$."}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1974C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1974/problem/C"}