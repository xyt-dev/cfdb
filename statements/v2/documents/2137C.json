{"assets":[],"contentKind":"statement","contestId":"2137","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Maximum Even Sum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two integers $$$a$$$ and $$$b$$$. You are to perform the following procedure:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First, you choose an integer $$$k$$$ such that $$$b$$$ is divisible by $$$k$$$. Then, you simultaneously multiply $$$a$$$ by $$$k$$$ and divide $$$b$$$ by $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the greatest possible "},{"children":[{"kind":"text","text":"even"}],"kind":"container"},{"kind":"text","text":" value of $$$a+b$$$. If it is impossible to make $$$a+b$$$ even, output $$$-1$$$ instead."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$a$$$ and $$$b$$$ ($$$1 \\leq a,b \\leq a\\cdot b \\leq 10^{18})$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the maximum "},{"children":[{"kind":"text","text":"even"}],"kind":"container"},{"kind":"text","text":" value of $$$a+b$$$ on a new line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n8 1\n1 8\n7 7\n2 6\n9 16\n1 6\n4 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n6\n50\n8\n74\n-1\n14\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, it can be shown it is impossible for $$$a+b$$$ to be even."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the optimal $$$k$$$ is $$$2$$$. The sum is $$$2+4=6$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"2137C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2137/problem/C"}