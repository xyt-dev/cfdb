{"assets":[],"contentKind":"statement","contestId":"76","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Tourist"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"0.5 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Tourist walks along the "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" axis. He can choose either of two directions and any speed not exceeding "},{"kind":"math_inline","text":"V"},{"kind":"text","text":". He can also stand without moving anywhere. He knows from newspapers that at time "},{"kind":"math_inline","text":"t1"},{"kind":"text","text":" in the point with coordinate "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":" an interesting event will occur, at time "},{"kind":"math_inline","text":"t2"},{"kind":"text","text":" in the point with coordinate "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":" — another one, and so on up to ("},{"kind":"math_inline","text":"xn, tn"},{"kind":"text","text":"). Interesting events are short so we can assume they are immediate. Event "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" counts visited if at time "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" tourist was at point with coordinate "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Write program tourist that will find maximum number of events tourist if: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" at the beginning (when time is equal to 0) tourist appears at point 0, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" tourist can choose initial point for himself. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Yes, you should answer on two similar but different questions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains single integer number "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ N ≤ 100000"},{"kind":"text","text":") — number of interesting events. The following "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" lines contain two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" — coordinate and time of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th event. The last line of the input contains integer "},{"kind":"math_inline","text":"V"},{"kind":"text","text":" — maximum speed of the tourist. All "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" will be within range "},{"kind":"math_inline","text":" - 2·108 ≤ xi ≤ 2·108"},{"kind":"text","text":", all "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" will be between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2·106"},{"kind":"text","text":" inclusive. "},{"kind":"math_inline","text":"V"},{"kind":"text","text":" will be positive and will not exceed 1000. The input may contain events that happen at the same time or in the same place but not in the same place at the same time."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the output should contain two space-sepatated integers — maximum number of events tourist can visit in he starts moving from point 0 at time 0, and maximum number of events tourist can visit if he chooses the initial point for himself."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n-1 1\n42 7\n40 8\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"76F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/76/problem/F"}