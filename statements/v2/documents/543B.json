{"assets":["/statement-assets/790756f0b7a9ed59eb35263f141c3d0768d3b3a8c8a1cc1f4bba3e9979e81bb0.png"],"contentKind":"statement","contestId":"543","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Destroying Roads"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In some country there are exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" bidirectional roads connecting the cities. Cities are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". If cities "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are connected by a road, then in an hour you can go along this road either from city "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", or from city "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". The road network is such that from any city you can get to any other one by moving along the roads."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You want to destroy the largest possible number of roads in the country so that the remaining roads would allow you to get from city "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"t1"},{"kind":"text","text":" in at most "},{"kind":"math_inline","text":"l1"},{"kind":"text","text":" hours and get from city "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"t2"},{"kind":"text","text":" in at most "},{"kind":"math_inline","text":"l2"},{"kind":"text","text":" hours."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine what maximum number of roads you need to destroy in order to meet the condition of your plan. If it is impossible to reach the desired result, print -1."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 3000"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/790756f0b7a9ed59eb35263f141c3d0768d3b3a8c8a1cc1f4bba3e9979e81bb0.png"},"kind":"image"},{"kind":"text","text":") — the number of cities and roads in the country, respectively. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the descriptions of the roads as pairs of integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":"). It is guaranteed that the roads that are given in the description can transport you from any city to any other one. It is guaranteed that each pair of cities has at most one road between them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last two lines contains three integers each, "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l2"},{"kind":"text","text":", respectively ("},{"kind":"math_inline","text":"1 ≤ si, ti ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ li ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the answer to the problem. If the it is impossible to meet the conditions, print -1."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n1 2\n2 3\n3 4\n4 5\n1 3 2\n3 5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n1 2\n2 3\n3 4\n4 5\n1 3 2\n2 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n1 2\n2 3\n3 4\n4 5\n1 3 2\n3 5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"543B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/543/problem/B"}