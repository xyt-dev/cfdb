{"assets":[],"contentKind":"statement","contestId":"2048","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Kevin and Strange Operation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Kevin is exploring problems related to binary strings in Chinatown. When he was at a loss, a stranger approached him and introduced a peculiar operation:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Suppose the current binary string is $$$ t $$$, with a length of $$$ \\vert t \\vert $$$. Choose an integer $$$ 1 \\leq p \\leq \\vert t \\vert $$$. For all $$$ 1 \\leq i \\lt p $$$, "},{"children":[{"kind":"text","text":"simultaneously"}],"kind":"container"},{"kind":"text","text":" perform the operation $$$ t_i = \\max(t_i, t_{i+1}) $$$, and then delete $$$ t_p $$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, suppose the current binary string is "},{"children":[{"kind":"text","text":"01001"}],"kind":"container"},{"kind":"text","text":", and you choose $$$ p = 4 $$$. Perform $$$ t_i = \\max(t_i, t_{i+1}) $$$ for $$$t_1$$$, $$$t_2$$$, and $$$ t_3 $$$, transforming the string into "},{"children":[{"kind":"text","text":"11001"}],"kind":"container"},{"kind":"text","text":", then delete $$$ t_4 $$$, resulting in "},{"children":[{"kind":"text","text":"1101"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Kevin finds this strange operation quite interesting. Thus, he wants to ask you: Given a binary string $$$ s $$$, how many distinct non-empty binary strings can you obtain through any number of operations (possibly zero)?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since the answer may be very large, you only need to output the result modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains a single integer $$$t$$$ ($$$1\\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each test case, the only line contains a binary string $$$ s $$$ ($$$ 1 \\le \\lvert s \\rvert \\le 10^6 $$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$\\lvert s \\rvert$$$ over all test cases does not exceed $$$10^6$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single integer in the only line of the output — the number of distinct non-empty binary strings you can obtain, modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n11001\n000110111001100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n73\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, all the binary strings you can obtain are: "},{"children":[{"kind":"text","text":"11001"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1001"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1101"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"001"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"101"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"111"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". There are $$$ 9 $$$ in total."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"H","problemCode":"2048H","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2048/problem/H"}