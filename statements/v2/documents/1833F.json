{"assets":[],"contentKind":"statement","contestId":"1833","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Ira and Flamenco"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ira loves Spanish flamenco dance very much. She decided to start her own dance studio and found $$$n$$$ students, $$$i$$$th of whom has "},{"children":[{"kind":"text","text":"level"}],"kind":"container"},{"kind":"text","text":" $$$a_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ira can choose several of her students and set a dance with them. So she can set a huge number of dances, but she is only interested in "},{"children":[{"kind":"text","text":"magnificent"}],"kind":"container"},{"kind":"text","text":" dances. The dance is called "},{"children":[{"kind":"text","text":"magnificent"}],"kind":"container"},{"kind":"text","text":" if the following is true: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" $$$m$$$ students participate in the dance; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"levels"}],"kind":"container"},{"kind":"text","text":" of all dancers are "},{"children":[{"kind":"text","text":"pairwise distinct"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"levels"}],"kind":"container"},{"kind":"text","text":" of every two dancers have an absolute difference "},{"children":[{"kind":"text","text":"strictly less"}],"kind":"container"},{"kind":"text","text":" than $$$m$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, if $$$m = 3$$$ and $$$a = [4, 2, 2, 3, 6]$$$, the following dances are "},{"children":[{"kind":"text","text":"magnificent"}],"kind":"container"},{"kind":"text","text":" (students participating in the dance are highlighted in red): $$$[\\color{red}{4}, 2, \\color{red}{2}, \\color{red}{3}, 6]$$$, $$$[\\color{red}{4}, \\color{red}{2}, 2, \\color{red}{3}, 6]$$$. At the same time dances $$$[\\color{red}{4}, 2, 2, \\color{red}{3}, 6]$$$, $$$[4, \\color{red}{2}, \\color{red}{2}, \\color{red}{3}, 6]$$$, $$$[\\color{red}{4}, 2, 2, \\color{red}{3}, \\color{red}{6}]$$$ are not "},{"children":[{"kind":"text","text":"magnificent"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the dance $$$[\\color{red}{4}, 2, 2, \\color{red}{3}, 6]$$$ only $$$2$$$ students participate, although $$$m = 3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The dance $$$[4, \\color{red}{2}, \\color{red}{2}, \\color{red}{3}, 6]$$$ involves students with "},{"children":[{"kind":"text","text":"levels"}],"kind":"container"},{"kind":"text","text":" $$$2$$$ and $$$2$$$, although "},{"children":[{"kind":"text","text":"levels"}],"kind":"container"},{"kind":"text","text":" of all dancers must be pairwise distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the dance $$$[\\color{red}{4}, 2, 2, \\color{red}{3}, \\color{red}{6}]$$$ students with "},{"children":[{"kind":"text","text":"levels"}],"kind":"container"},{"kind":"text","text":" $$$3$$$ and $$$6$$$ participate, but $$$|3 - 6| = 3$$$, although $$$m = 3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Ira count the number of "},{"children":[{"kind":"text","text":"magnificent"}],"kind":"container"},{"kind":"text","text":" dances that she can set. Since this number can be very large, count it "},{"children":[{"kind":"text","text":"modulo"}],"kind":"container"},{"kind":"text","text":" $$$10^9 + 7$$$. Two dances are considered different if the sets of students participating in them are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — number of testcases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each testcase contains integers $$$n$$$ and $$$m$$$ ($$$1 \\le m \\le n \\le 2 \\cdot 10^5$$$) — the number of Ira students and the number of dancers in the "},{"children":[{"kind":"text","text":"magnificent"}],"kind":"container"},{"kind":"text","text":" dance."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each testcase contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$) — "},{"children":[{"kind":"text","text":"levels"}],"kind":"container"},{"kind":"text","text":" of students."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all testcases "},{"children":[{"kind":"text","text":"does not exceed"}],"kind":"container"},{"kind":"text","text":" $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase, print a single integer — the number of "},{"children":[{"kind":"text","text":"magnificent"}],"kind":"container"},{"kind":"text","text":" dances. Since this number can be very large, print it "},{"children":[{"kind":"text","text":"modulo"}],"kind":"container"},{"kind":"text","text":" $$$10^9 + 7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n7 4\n8 10 10 9 6 11 7\n5 3\n4 2 2 3 6\n8 2\n1 5 2 2 3 1 3 3\n3 3\n3 3 3\n5 1\n3 4 3 10 7\n12 3\n5 2 1 1 4 3 5 5 5 2 7 5\n1 1\n1\n3 2\n1 2 3\n2 2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n2\n10\n0\n5\n11\n1\n2\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first testcase, Ira can set such "},{"children":[{"kind":"text","text":"magnificent"}],"kind":"container"},{"kind":"text","text":" dances: $$$[\\color{red}{8}, 10, 10, \\color{red}{9}, \\color{red}{6}, 11, \\color{red}{7}]$$$, $$$[\\color{red}{8}, \\color{red}{10}, 10, \\color{red}{9}, 6, 11, \\color{red}{7}]$$$, $$$[\\color{red}{8}, 10, \\color{red}{10}, \\color{red}{9}, 6, 11, \\color{red}{7}]$$$, $$$[\\color{red}{8}, 10, \\color{red}{10}, \\color{red}{9}, 6, \\color{red}{11}, 7]$$$, $$$[\\color{red}{8}, \\color{red}{10}, 10, \\color{red}{9}, 6, \\color{red}{11}, 7]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second testcase is explained in the statements."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1833F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1833/problem/F"}