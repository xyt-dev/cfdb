{"assets":[],"contentKind":"statement","contestId":"825","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Five-In-a-Row"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Alice and Bob play 5-in-a-row game. They have a playing field of size "},{"kind":"math_inline","text":"10 × 10"},{"kind":"text","text":". In turns they put either crosses or noughts, one at a time. Alice puts crosses and Bob puts noughts."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In current match they have made some turns and now it's Alice's turn. She wonders if she can put cross in such empty cell that she wins immediately."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Alice wins if some crosses in the field form line of length "},{"children":[{"kind":"text","text":"not smaller than "},{"children":[{"kind":"text","text":"5"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":". This line can be horizontal, vertical and diagonal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"You are given matrix "},{"kind":"math_inline","text":"10 × 10"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" lines of "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" characters each) with capital 