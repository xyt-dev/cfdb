{"assets":[],"contentKind":"statement","contestId":"755","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. PolandBall and Forest"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"PolandBall lives in a forest with his family. There are some trees in the forest. Trees are undirected acyclic graphs with "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"k - 1"},{"kind":"text","text":" edges, where "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is some integer. Note that one vertex "},{"children":[{"kind":"text","text":"is"}],"kind":"container"},{"kind":"text","text":" a valid tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is exactly one relative living in each vertex of each tree, they have unique ids from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". For each Ball "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" we know the id of its most distant relative living on the same tree. If there are several such vertices, we only know the value of the one with smallest id among those."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How many trees are there in the forest?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 104"},{"kind":"text","text":") — the number of Balls living in the forest."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", where ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":") holds and "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" denotes the most distant from Ball "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" relative living on the same tree. If there are several most distant relatives living on the same tree, "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" is the id of one with the smallest id."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the sequence "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" corresponds to some valid forest."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Hacking"}],"kind":"container"},{"kind":"text","text":": To hack someone, you should provide a "},{"children":[{"kind":"text","text":"correct forest"}],"kind":"container"},{"kind":"text","text":" as a test. The sequence "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" will be calculated according to the forest and given to the solution you try to hack as input. Use the following format:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first line, output the integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 104"},{"kind":"text","text":") — the number of Balls and the integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ m < n"},{"kind":"text","text":") — the total number of edges in the forest. Then "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines should follow. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should contain two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" and represent an edge between vertices in which relatives "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" live. For example, the first sample is written as follows:"}],"kind":"paragraph"},{"kind":"code_block","text":"\n5 3\n1 2\n3 4\n4 5\n"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"You should output the number of trees in the forest where PolandBall lives."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom","title":"Interaction"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Interaction"}],"kind":"heading"},{"children":[{"kind":"text","text":"From the technical side, this problem is interactive. However, it should not affect you (except hacking) since there is no interaction."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2 1 5 3 3"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample testcase, possible forest is: "},{"children":[{"kind":"text","text":"1-2 3-4-5"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" trees overall."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample testcase, the only possible graph is one vertex and no edges. Therefore, there is only one tree."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"755C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/755/problem/C"}