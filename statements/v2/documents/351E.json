{"assets":[],"contentKind":"statement","contestId":"351","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Jeff and Permutation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Jeff's friends know full well that the boy likes to get sequences and arrays for his birthday. Thus, Jeff got sequence "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" for his birthday."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Jeff hates inversions in sequences. An inversion in sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" is a pair of indexes "},{"kind":"math_inline","text":"i, j"},{"kind":"math_inline","text":"(1 ≤ i < j ≤ n)"},{"kind":"text","text":", such that an inequality "},{"kind":"math_inline","text":"ai > aj"},{"kind":"text","text":" holds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Jeff can multiply some numbers of the sequence "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" by -1. At that, he wants the number of inversions in the sequence to be minimum. Help Jeff and find the minimum number of inversions he manages to get."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 2000)"},{"kind":"text","text":". The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers — sequence "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"pn"},{"kind":"math_inline","text":"(|pi| ≤ 105)"},{"kind":"text","text":". The numbers are separated by spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print the answer to the problem — the minimum number of inversions Jeff can get."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n-2 0 -1 0 -1 2 1 0 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"351E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/351/problem/E"}