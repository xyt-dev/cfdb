{"assets":[],"contentKind":"statement","contestId":"414","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Mashmokh and Reverse Operation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Mashmokh's boss, Bimokh, didn't like Mashmokh. So he fired him. Mashmokh decided to go to university and participate in ACM instead of finding a new job. He wants to become a member of Bamokh's team. In order to join he was given some programming tasks and one week to solve them. Mashmokh is not a very experienced programmer. Actually he is not a programmer at all. So he wasn't able to solve them. That's why he asked you to help him with these tasks. One of these tasks is the following."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have an array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries on it. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query is described by an integer "},{"kind":"math_inline","text":"qi"},{"kind":"text","text":". In order to perform the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query you must:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" split the array into "},{"kind":"math_inline","text":"2n - qi"},{"kind":"text","text":" parts, where each part is a subarray consisting of "},{"kind":"math_inline","text":"2qi"},{"kind":"text","text":" numbers; the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th subarray "},{"kind":"math_inline","text":"(1 ≤ j ≤ 2n - qi)"},{"kind":"text","text":" should contain the elements "},{"kind":"math_inline","text":"a[(j - 1)·2qi + 1], a[(j - 1)·2qi + 2], ..., a[(j - 1)·2qi + 2qi]"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" reverse each of the subarrays; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" join them into a single array in the same order (this array becomes new array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" output the number of inversions in the new "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Given initial array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and all the queries. Answer all the queries. Please, note that the changes from some query is saved for further queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer "},{"kind":"math_inline","text":"n (0 ≤ n ≤ 20)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of input contains "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a[1], a[2], ..., a[2n] (1 ≤ a[i] ≤ 109)"},{"kind":"text","text":", the initial array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line of input contains a single integer "},{"kind":"math_inline","text":"m (1 ≤ m ≤ 106)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fourth line of input contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"q1, q2, ..., qm (0 ≤ qi ≤ n)"},{"kind":"text","text":", the queries."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note"}],"kind":"container"},{"kind":"text","text":": since the size of the input and output could be very large, don't use slow output techniques in your language. For example, do not use input and output streams (cin, cout) in C++."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print the answer (the number of inversions) for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 1 4 3\n4\n1 2 0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n6\n6\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n1 2\n3\n0 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n1\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"If we reverse an array "},{"kind":"math_inline","text":"x[1], x[2], ..., x[n]"},{"kind":"text","text":" it becomes new array "},{"kind":"math_inline","text":"y[1], y[2], ..., y[n]"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"y[i] = x[n - i + 1]"},{"kind":"text","text":" for each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The number of inversions of an array "},{"kind":"math_inline","text":"x[1], x[2], ..., x[n]"},{"kind":"text","text":" is the number of pairs of indices "},{"kind":"math_inline","text":"i, j"},{"kind":"text","text":" such that: "},{"kind":"math_inline","text":"i < j"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x[i] > x[j]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"414C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/414/problem/C"}