{"assets":[],"contentKind":"statement","contestId":"1832","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Combinatorics Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recall that the binomial coefficient $$$\\binom{x}{y}$$$ is calculated as follows ($$$x$$$ and $$$y$$$ are non-negative integers):"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if $$$x \\lt y$$$, then $$$\\binom{x}{y} = 0$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" otherwise, $$$\\binom{x}{y} = \\frac{x!}{y! \\cdot (x-y)!}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given an array $$$a_1, a_2, \\dots, a_n$$$ and an integer $$$k$$$. You have to calculate a new array $$$b_1, b_2, \\dots, b_n$$$, where"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$b_1 = (\\binom{1}{k} \\cdot a_1) \\bmod 998244353$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b_2 = (\\binom{2}{k} \\cdot a_1 + \\binom{1}{k} \\cdot a_2) \\bmod 998244353$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b_3 = (\\binom{3}{k} \\cdot a_1 + \\binom{2}{k} \\cdot a_2 + \\binom{1}{k} \\cdot a_3) \\bmod 998244353$$$, and so on. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Formally, $$$b_i = (\\sum\\limits_{j=1}^{i} \\binom{i - j + 1}{k} \\cdot a_j) \\bmod 998244353$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note that the array is given in a modified way, and you have to output it in a modified way as well"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains six integers $$$n$$$, $$$a_1$$$, $$$x$$$, $$$y$$$, $$$m$$$ and $$$k$$$ ($$$1 \\le n \\le 10^7$$$; $$$0 \\le a_1, x, y \\lt m$$$; $$$2 \\le m \\le 998244353$$$; $$$1 \\le k \\le 5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The array $$$[a_1, a_2, \\dots, a_n]$$$ is generated as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a_1$$$ is given in the input; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for $$$2 \\le i \\le n$$$, $$$a_i = (a_{i-1} \\cdot x + y) \\bmod m$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Since outputting up to $$$10^7$$$ integers might be too slow, you have to do the following:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$c_i = b_i \\cdot i$$$ "},{"children":[{"kind":"text","text":"(without taking modulo $$$998244353$$$ after the multiplication)"}],"kind":"container"},{"kind":"text","text":". Print the integer $$$c_1 \\oplus c_2 \\oplus \\dots \\oplus c_n$$$, where $$$\\oplus$$$ denotes the bitwise XOR operator."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 8 2 3 100 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1283\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1832E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1832/problem/E"}