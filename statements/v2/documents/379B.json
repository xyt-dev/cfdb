{"assets":[],"contentKind":"statement","contestId":"379","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. New Year Present"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The New Year is coming! That's why many people today are busy preparing New Year presents. Vasily the Programmer is no exception."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasily knows that the best present is (no, it's not a contest) money. He's put "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" empty wallets from left to right in a row and decided how much money to put in what wallet. Vasily decided to put "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" coins to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th wallet from the left."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasily is a very busy man, so the money are sorted into the bags by his robot. Initially, the robot stands by the leftmost wallet in the row. The robot can follow instructions of three types: go to the wallet that is to the left of the current one (if such wallet exists), go to the wallet that is to the right of the current one (if such wallet exists), put a coin to the current wallet. Due to some technical malfunctions the robot cannot follow two \"put a coin\" instructions in a row."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasily doesn't want to wait for long, so he wants to write a program for the robot that contains at most "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" operations (not necessarily minimum in length) the robot can use to put coins into the wallets. Help him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(2 ≤ n ≤ 300)"},{"kind":"text","text":" — the number of wallets. The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(0 ≤ ai ≤ 300)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that at least one "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is positive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the sequence that consists of "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ k ≤ 106)"},{"kind":"text","text":" characters, each of them equals: \""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"P"}],"kind":"container"},{"kind":"text","text":"\". Each character of the sequence is an instruction to the robot. Character \""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\" orders to move to the left, character \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\" orders to move to the right, character \""},{"children":[{"kind":"text","text":"P"}],"kind":"container"},{"kind":"text","text":"\" orders the robot to put a coin in the wallet. The robot is not allowed to go beyond the wallet line. In other words, you cannot give instructions \""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\" if the robot is at wallet 1, or \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\" at wallet "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As a result of the performed operations, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th wallet from the left must contain exactly "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" coins. If there are multiple answers, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"PRPLRP"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 2 0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"RPRRPLLPLRRRP"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"379B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/379/problem/B"}