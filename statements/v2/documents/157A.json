{"assets":["/statement-assets/20786a67c52f4b3c13be6489e9a241870a6777aab9debf5a211d39b4ed7052c9.png"],"contentKind":"statement","contestId":"157","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Game Outcome"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sherlock Holmes and Dr. Watson played some game on a checkered board "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" in size. During the game they put numbers on the board's squares by some tricky rules we don't know. However, the game is now over and each square of the board contains exactly one number. To understand who has won, they need to count the number of "},{"children":[{"kind":"text","text":"winning"}],"kind":"container"},{"kind":"text","text":" squares. To determine if the particular square is winning you should do the following. Calculate the sum of all numbers on the squares that share this column (including the given square) and separately calculate the sum of all numbers on the squares that share this row (including the given square). A square is considered "},{"children":[{"kind":"text","text":"winning"}],"kind":"container"},{"kind":"text","text":" if the sum of the column numbers is "},{"children":[{"kind":"text","text":"strictly"}],"kind":"container"},{"kind":"text","text":" greater than the sum of the row numbers."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/20786a67c52f4b3c13be6489e9a241870a6777aab9debf5a211d39b4ed7052c9.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"For instance, lets game was ended like is shown in the picture. Then the purple cell is winning, because the sum of its column numbers equals "},{"kind":"math_inline","text":"8 + 3 + 6 + 7 = 24"},{"kind":"text","text":", sum of its row numbers equals "},{"kind":"math_inline","text":"9 + 5 + 3 + 2 = 19"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"24 > 19"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 30"},{"kind":"text","text":"). Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th number on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line represents the number on the square that belongs to the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column and the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row on the board. All number on the board are integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"100"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the single number — the number of the winning squares."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n5 7 8 4\n9 5 3 2\n1 6 6 4\n9 5 7 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example two upper squares are winning."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example three left squares in the both middle rows are winning:"}],"kind":"paragraph"},{"kind":"code_block","text":"5 7 8 4\n9 5 3 2\n1 6 6 4\n9 5 7 3\n"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"157A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/157/problem/A"}