{"assets":[],"contentKind":"statement","contestId":"852","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Bathroom terminal"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Smith wakes up at the side of a dirty, disused bathroom, his ankle chained to pipes. Next to him is tape-player with a hand-written message \"Play Me\". He finds a tape in his own back pocket. After putting the tape in the tape-player, he sees a key hanging from a ceiling, chained to some kind of a machine, which is connected to the terminal next to him. After pressing a Play button a rough voice starts playing from the tape:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"\"Listen up Smith. As you can see, you are in pretty tough situation and in order to escape, you have to solve a puzzle. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" strings which represent words. Each word is of the maximum length "},{"kind":"math_inline","text":"L"},{"kind":"text","text":" and consists of characters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"'-'"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"'. You are also given "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" strings which represent patterns. Pattern is a string of length "},{"kind":"math_inline","text":" ≤  L"},{"kind":"text","text":" and consists of characters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"'-'"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"' as well as the maximum 3 characters '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"'. Character '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"' is an unknown character, meaning it can be equal to any character 'a'-'e', or even an empty character. For each pattern find the number of words that matches with the given pattern. After solving it and typing the result in the terminal, the key will drop from the ceiling and you may escape. Let the game begin.\""}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Smith escape."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ N ≤  100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ M ≤  5000"},{"kind":"text","text":"), representing the number of words and patterns respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" lines represent each word, and after those "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" lines, following "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" lines represent each pattern. Each word and each pattern has a maximum length "},{"kind":"math_inline","text":"L"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ L ≤ 50"},{"kind":"text","text":"). Each pattern has no more that three characters '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"'. All other characters in words and patters are lowercase English letters from '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output contains "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" lines and each line consists of one integer, representing the number of words that match the corresponding pattern."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\nabc\naec\nac\na?c\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"If we switch '?' with 'b', 'e' and with empty character, we get 'abc', 'aec' and 'ac' respectively."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"852G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/852/problem/G"}