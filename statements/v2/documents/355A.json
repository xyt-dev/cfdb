{"assets":[],"contentKind":"statement","contestId":"355","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Vasya and Digital Root"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya has recently found out what a digital root of a number is and he decided to share his knowledge with you."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's assume that "},{"kind":"math_inline","text":"S(n)"},{"kind":"text","text":" is the sum of digits of number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", for example, "},{"kind":"math_inline","text":"S(4098) = 4 + 0 + 9 + 8 = 21"},{"kind":"text","text":". Then the digital root of number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" equals to: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"dr(n) = S(n)"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"S(n) < 10"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"dr(n) = dr( S(n) )"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"S(n) ≥ 10"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, "},{"kind":"math_inline","text":"dr(4098)  =  dr(21)  =  3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya is afraid of large numbers, so the numbers he works with are at most "},{"kind":"math_inline","text":"101000"},{"kind":"text","text":". For all such numbers, he has proved that "},{"kind":"math_inline","text":"dr(n)  =  S( S( S( S(n) ) ) )"},{"kind":"math_inline","text":"(n ≤ 101000)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Vasya wants to quickly find numbers with the given digital root. The problem is, he hasn't learned how to do that and he asked you to help him. You task is, given numbers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":", find the number consisting of exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" digits (the leading zeroes are not allowed), with digital root equal to "},{"kind":"math_inline","text":"d"},{"kind":"text","text":", or else state that such number does not exist."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"math_inline","text":"(1 ≤ k ≤ 1000; 0 ≤ d ≤ 9)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print either any number that meets the requirements (without the leading zeroes) or \""},{"children":[{"kind":"text","text":"No solution"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), if the corresponding number does not exist."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The chosen number must consist of exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" digits. We assume that number 0 doesn't contain any leading zeroes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5881\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"36172\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first test sample "},{"kind":"math_inline","text":"dr(5881)  =  dr(22)  =  4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second test sample "},{"kind":"math_inline","text":"dr(36172)  =  dr(19)  =  dr(10)  =  1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A"