{"assets":[],"contentKind":"statement","contestId":"121","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Lucky Permutation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Petya loves lucky numbers. Everybody knows that lucky numbers are positive integers whose decimal representation contains only the lucky digits "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":". For example, numbers "},{"children":[{"kind":"text","text":"47"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"744"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" are lucky and "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"17"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"467"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One day Petya dreamt of a lexicographically "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th permutation of integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Determine how many lucky numbers in the permutation are located on the positions whose indexes are also lucky numbers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n, k ≤ 109)"},{"kind":"text","text":" — the number of elements in the permutation and the lexicographical number of the permutation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th permutation of numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" does not exist, print the single number \"-1\" (without the quotes). Otherwise, print the answer to the problem: the number of such indexes "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" are both lucky numbers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A permutation is an ordered set of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" elements, where each integer from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" occurs exactly once. The element of permutation in position with index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is denoted as "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":"). Permutation "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is lexicographically smaller that permutation "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" if there is such a "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":"), that "},{"kind":"math_inline","text":"ai < bi"},{"kind":"text","text":", and for any "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j < i"},{"kind":"text","text":") "},{"kind":"math_inline","text":"aj = bj"},{"kind":"text","text":". Let's make a list of all possible permutations of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" elements and sort it in the order of lexicographical increasing. Then the lexicographically "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th permutation is the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th element of this list of permutations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample the permutation looks like that:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"1 2 3 4 6 7 5"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only suitable position is 4."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the permutation looks like that:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"2 1 3 4"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only suitable position is 4."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"121C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/121/problem/C"}