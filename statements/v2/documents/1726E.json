{"assets":[],"contentKind":"statement","contestId":"1726","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Almost Perfect"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A permutation $$$p$$$ of length $$$n$$$ is called "},{"children":[{"kind":"text","text":"almost perfect"}],"kind":"container"},{"kind":"text","text":" if for all integer $$$1 \\leq i \\leq n$$$, it holds that $$$\\lvert p_i - p^{-1}_i \\rvert \\le 1$$$, where $$$p^{-1}$$$ is the inverse permutation of $$$p$$$ (i.e. $$$p^{-1}_{k_1} = k_2$$$ if and only if $$$p_{k_2} = k_1$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Count the number of "},{"children":[{"kind":"text","text":"almost perfect"}],"kind":"container"},{"kind":"text","text":" permutations of length $$$n$$$ modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 1000$$$) — the number of test cases. The description of each test case follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first and only line of each test case contains a single integer $$$n$$$ ($$$1 \\leq n \\leq 3 \\cdot 10^5$$$) — the length of the permutation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$3 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the number of "},{"children":[{"kind":"text","text":"almost perfect"}],"kind":"container"},{"kind":"text","text":" permutations of length $$$n$$$ modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2\n3\n50\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n4\n830690567\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For $$$n = 2$$$, both permutations $$$[1, 2]$$$, and $$$[2, 1]$$$ are almost perfect."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For $$$n = 3$$$, there are only $$$6$$$ permutations. Having a look at all of them gives us:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[1, 2, 3]$$$ is an almost perfect permutation. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1, 3, 2]$$$ is an almost perfect permutation. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2, 1, 3]$$$ is an almost perfect permutation. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2, 3, 1]$$$ is "},{"children":[{"kind":"text","text":"NOT"}],"kind":"container"},{"kind":"text","text":" an almost perfect permutation ($$$\\lvert p_2 - p^{-1}_2 \\rvert = \\lvert 3 - 1 \\rvert = 2$$$). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[3, 1, 2]$$$ is "},{"children":[{"kind":"text","text":"NOT"}],"kind":"container"},{"kind":"text","text":" an almost perfect permutation ($$$\\lvert p_2 - p^{-1}_2 \\rvert = \\lvert 1 - 3 \\rvert = 2$$$). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[3, 2, 1]$$$ is an almost perfect permutation. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So we get $$$4$$$ almost perfect permutations."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1726E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1726/problem/E"}