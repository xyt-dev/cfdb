{"assets":[],"contentKind":"statement","contestId":"682","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Alyona and Mex"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Someone gave Alyona an array containing "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". In one operation, Alyona can choose any element of the array and decrease it, i.e. replace with any positive integer that is smaller than the current one. Alyona can repeat this operation as many times as she wants. In particular, she may not apply any operation to the array at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, after applying some operations Alyona will get an array of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"1 ≤ bi ≤ ai"},{"kind":"text","text":" for every "},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":". Your task is to determine the maximum possible value of mex of this array."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Mex"}],"kind":"container"},{"kind":"text","text":" of an array in this problem is the "},{"children":[{"kind":"text","text":"minimum positive"}],"kind":"container"},{"kind":"text","text":" integer that doesn't appear in this array. For example, mex of the array containing "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", while mex of the array containing "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of elements in the Alyona's array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — the elements of the array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one positive integer — the maximum possible value of mex of the array after Alyona applies some (possibly none) operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 3 3 3 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case if one will decrease the second element value to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and the fifth element value to "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" then the "},{"children":[{"kind":"text","text":"mex"}],"kind":"container"},{"kind":"text","text":" value of resulting array "},{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"3"},{"kind":"math_inline","text":"3"},{"kind":"math_inline","text":"4"},{"kind":"text","text":" will be equal to "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To reach the answer to the second sample case one must not decrease any of the array elements."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"682B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/682/problem/B"}