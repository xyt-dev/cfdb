{"assets":[],"contentKind":"statement","contestId":"193","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Two Segments"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Nick has some permutation consisting of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". A segment "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"l ≤ r"},{"kind":"text","text":") is a set of elements "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" satisfying "},{"kind":"math_inline","text":"l ≤ i ≤ r"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nick calls a pair of segments "},{"kind":"math_inline","text":"[a0, a1]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"[b0, b1]"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a0 ≤ a1 < b0 ≤ b1 ≤ n"},{"kind":"text","text":") good if all their "},{"kind":"math_inline","text":"(a1 - a0 + b1 - b0 + 2)"},{"kind":"text","text":" elements, when sorted in ascending order, form an arithmetic progression with a difference of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". That is, when they sorted in ascending order, the elements are in the form "},{"kind":"math_inline","text":"{x, x + 1, x + 2, ..., x + m - 1}"},{"kind":"text","text":", for some "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the number of distinct pairs of good segments in the given permutation. Two pairs of segments are considered distinct if the sets of elements contained in these pairs of segments are distinct. For example, any segment "},{"kind":"math_inline","text":"[l, r]"},{"kind":"math_inline","text":"(l < r)"},{"kind":"text","text":" can be represented as a pair of segments, as "},{"kind":"math_inline","text":"[l, i]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"[i + 1, r]"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"l ≤ i ≤ r"},{"kind":"text","text":"). As all these pairs consist of the same set of elements, they are considered identical."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"See the notes accompanying the sample tests for clarification."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 3·105"},{"kind":"text","text":") — the permutation size. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated distinct integers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":", ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of good pairs of segments of permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","t