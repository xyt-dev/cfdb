{"assets":[],"contentKind":"statement","contestId":"677","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Vanya and Treasure"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vanya is in the palace that can be represented as a grid "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":". Each room contains a single chest, an the room located in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th columns contains the chest of type "},{"kind":"math_inline","text":"aij"},{"kind":"text","text":". Each chest of type "},{"kind":"math_inline","text":"x ≤ p - 1"},{"kind":"text","text":" contains a key that can open any chest of type "},{"kind":"math_inline","text":"x + 1"},{"kind":"text","text":", and all chests of type "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" are not locked. There is exactly one chest of type "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and it contains a treasure."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vanya starts in cell "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" (top left corner). What is the minimum total distance Vanya has to walk in order to get the treasure? Consider the distance between cell "},{"kind":"math_inline","text":"(r1, c1)"},{"kind":"text","text":" (the cell in the row "},{"kind":"math_inline","text":"r1"},{"kind":"text","text":" and column "},{"kind":"math_inline","text":"c1"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"(r2, c2)"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"|r1 - r2| + |c1 - c2|"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 300, 1 ≤ p ≤ n·m"},{"kind":"text","text":") — the number of rows and columns in the table representing the palace and the number of different types of the chests, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"aij"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ aij ≤ p"},{"kind":"text","text":") — the types of the chests in corresponding rooms. It's guaranteed that for each "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" there is at least one chest of this type (that is, there exists a pair of "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"arc = x"},{"kind":"text","text":"). Also, it's guaranteed that there is exactly one chest of type "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the minimum possible total distance Vanya has to walk in order to get the treasure from the chest of type "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4 3\n2 1 1 1\n1 1 1 1\n2 1 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 9\n1 3 5\n8 9 7\n4 6 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"22\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4 12\n1 2 3 4\n8 7 6 5\n9 10 11 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"677D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/677/problem/D"}