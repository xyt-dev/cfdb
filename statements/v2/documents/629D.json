{"assets":["/statement-assets/7400ce840a2dd7f70d5f7169f546af9aec8b1b7c0c18043b50670a606baf03d2.png"],"contentKind":"statement","contestId":"629","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Babaei and Birthday Cake"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As you know, every birthday party has a cake! This time, Babaei is going to prepare the very special birthday party's cake."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Simple cake"}],"kind":"container"},{"kind":"text","text":" is a cylinder of some radius and height. The volume of the simple cake is equal to the volume of corresponding cylinder. Babaei has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" simple cakes and he is going to make a "},{"children":[{"kind":"text","text":"special cake"}],"kind":"container"},{"kind":"text","text":" placing some cylinders on each other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, there are some additional culinary restrictions. The cakes are numbered in such a way that the cake number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" can be placed only on the table or on some cake number "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"j < i"},{"kind":"text","text":". Moreover, in order to impress friends Babaei will put the cake "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" on top of the cake "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" only if the volume of the cake "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is strictly greater than the volume of the cake "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Babaei wants to prepare a birthday cake that has a maximum possible total volume. Help him find this value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000)"},{"kind":"text","text":" — the number of simple cakes Babaei has."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ri, hi ≤ 10 000"},{"kind":"text","text":"), giving the radius and height of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th cake."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum volume of the cake that Babaei can make. Your answer will be considered correct if its absolute or relative error does not exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Namely: let's assume that your answer is "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and the answer of the jury is "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The checker program will consider your answer correct, if "},{"attrs":{"alt":"","src":"/statement-assets/7400ce840a2dd7f70d5f7169f546af9aec8b1b7c0c18043b50670a606baf03d2.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n100 30\n40 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"942477.796077000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1\n9 7\n1 4\n10 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3983.539484752\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In first sample, the optimal way is to choose the cake number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In second sample, the way to get the maximum volume is to use cakes with indices "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"629D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/629/problem/D"}