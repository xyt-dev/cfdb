{"assets":[],"contentKind":"statement","contestId":"288","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Polo the Penguin and Trees "}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little penguin Polo has got a tree — a non-directed connected acyclic graph, containing "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes and "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" edges. We will consider the tree nodes numbered by integers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Today Polo wonders, how to find the number of pairs of paths that don't have common nodes. More formally, he should find the number of groups of four integers "},{"kind":"math_inline","text":"a, b, c"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" such that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1 ≤ a < b ≤ n"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1 ≤ c < d ≤ n"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" there's no such node that lies on both the shortest path from node "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to node "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and from node "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" to node "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The shortest path betweem two nodes is the path that is shortest in the number of edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Polo solve this problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 80000)"},{"kind":"text","text":" — the number of tree nodes. Each of the following "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains a pair of integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"math_inline","text":"(1 ≤ ui, vi ≤ n; ui ≠ vi)"},{"kind":"text","text":" — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge of the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given graph is a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print a single integer — the answer to the problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the %lld specificator to read or write 64-bit numbers in С++. It is recommended to use the cin, cout streams or the %I64d specificator."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2\n2 3\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"288D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/288/problem/D"}