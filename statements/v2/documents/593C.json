{"assets":["/statement-assets/9bb7270a46dcfa275d5ce24f6119e20cea5b8f70356a6f48e3858a14dd00404f.png"],"contentKind":"statement","contestId":"593","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Beautiful Function"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Every day Ruslan tried to count sheep to fall asleep, but this didn't help. Now he has found a more interesting thing to do. First, he thinks of some set of circles on a plane, and then tries to choose a beautiful set of points, such that there is at least one point from the set inside or on the border of each of the imagined circles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Yesterday Ruslan tried to solve this problem for the case when the set of points is considered beautiful if it is given as "},{"kind":"math_inline","text":"(xt = f(t), yt = g(t))"},{"kind":"text","text":", where argument "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" takes all integer values from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"50"},{"kind":"text","text":". Moreover, "},{"kind":"math_inline","text":"f(t)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"g(t)"},{"kind":"text","text":" should be "},{"children":[{"kind":"text","text":"correct"}],"kind":"container"},{"kind":"text","text":" functions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Assume that "},{"kind":"math_inline","text":"w(t)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"h(t)"},{"kind":"text","text":" are some correct functions, and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" is an integer ranging from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"50"},{"kind":"text","text":". The function "},{"kind":"math_inline","text":"s(t)"},{"kind":"text","text":" is correct if it's obtained by one of the following rules: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"s(t) = abs(w(t))"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"abs(x)"},{"kind":"text","text":" means taking the absolute value of a number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", i.e. "},{"kind":"math_inline","text":"|x|"},{"kind":"text","text":";"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"s(t) = (w(t) + h(t))"},{"kind":"text","text":";"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"s(t) = (w(t) - h(t))"},{"kind":"text","text":";"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"s(t) = (w(t) * h(t))"},{"kind":"text","text":", where "},{"kind":"math_inline","text":" * "},{"kind":"text","text":" means multiplication, i.e. "},{"kind":"math_inline","text":"(w(t)·h(t))"},{"kind":"text","text":";"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"s(t) = c"},{"kind":"text","text":";"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"s(t) = t"},{"kind":"text","text":";"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Yesterday Ruslan thought on and on, but he could not cope with the task. Now he asks you to write a program that computes the appropriate "},{"kind":"math_inline","text":"f(t)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"g(t)"},{"kind":"text","text":" for any set of at most "},{"kind":"math_inline","text":"50"},{"kind":"text","text":" circles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In each of the functions "},{"kind":"math_inline","text":"f(t)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"g(t)"},{"kind":"text","text":" you are allowed to use no more than "},{"kind":"math_inline","text":"50"},{"kind":"text","text":" multiplications. The length of any function should not exceed "},{"kind":"math_inline","text":"100·n"},{"kind":"text","text":" characters. The function "},{"children":[{"kind":"text","text":"should not contain spaces."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ruslan can't keep big numbers in his memory, so you should choose "},{"kind":"math_inline","text":"f(t)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"g(t)"},{"kind":"text","text":", such that for all integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"50"},{"kind":"text","text":" value of "},{"kind":"math_inline","text":"f(t)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"g(t)"},{"kind":"text","text":" and all the intermediate calculations won't exceed "},{"kind":"math_inline","text":"109"},{"kind":"text","text":" by their absolute value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50"},{"kind":"text","text":") — the number of circles Ruslan thinks of. Next follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each of them containing three integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ xi, yi ≤ 50"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ ri ≤ 50"},{"kind":"text","text":") — the coordinates of the center and the raduis of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th circle."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a correct function "},{"kind":"math_inline","text":"f(t)"},{"kind":"text","text":". In the second line print a correct function "},{"kind":"math_inline","text":"g(t)"},{"kind":"text","text":". The set of the points "},{"kind":"math_inline","text":"(xt = f(t), yt = g(t))"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ t ≤ 50"},{"kind":"text","text":") must satisfy the condition, that there is at least one point inside or on the border of each of the circles, Ruslan thinks of at the beginning."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n0 10 4\n10 0 4\n20 10 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"t \nabs((t-10))"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Correct functions:"}],"kind":"container"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"10"}],"kind":"list_item"},{"children":[{"kind":"text","text":" ("},{"kind":"math_inline","text":"1"},{"kind":"text","text":"+"},{"kind":"math_inline","text":"2"},{"kind":"text","text":")"}],"kind":"list_item"},{"children":[{"kind":"text","text":" (("},{"kind":"math_inline","text":"t"},{"kind":"text","text":"-"},{"kind":"math_inline","text":"3"},{"kind":"text","text":")+("},{"kind":"math_inline","text":"t"},{"kind":"text","text":"*"},{"kind":"math_inline","text":"4"},{"kind":"text","text":"))"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"abs((t"},{"kind":"text","text":"-"},{"kind":"math_inline","text":"10))"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"(abs((((23"},{"kind":"text","text":"-"},{"kind":"math_inline","text":"t"},{"kind":"text","text":")*("},{"kind":"math_inline","text":"t"},{"kind":"text","text":"*"},{"kind":"math_inline","text":"t"},{"kind":"text","text":"))+(("},{"kind":"math_inline","text":"45"},{"kind":"text","text":"+"},{"kind":"math_inline","text":"12"},{"kind":"text","text":")*("},{"kind":"math_inline","text":"t"},{"kind":"text","text":"*"},{"kind":"math_inline","text":"t))))"},{"kind":"text","text":"*"},{"kind":"math_inline","text":"((5"},{"kind":"text","text":"*"},{"kind":"math_inline","text":"t"},{"kind":"text","text":")+(("},{"kind":"math_inline","text":"12"},{"kind":"text","text":"*"},{"kind":"math_inline","text":"t"},{"kind":"text","text":")-"},{"kind":"math_inline","text":"13)))"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"abs((t"},{"kind":"text","text":"-("},{"kind":"math_inline","text":"abs((t"},{"kind":"text","text":"*"},{"kind":"math_inline","text":"31"},{"kind":"text","text":"))+"},{"kind":"math_inline","text":"14))))"}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"Incorrect functions:"}],"kind":"container"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"3"},{"kind":"text","text":"+"},{"kind":"math_inline","text":"5"},{"kind":"text","text":"+"},{"kind":"math_inline","text":"7"},{"kind":"text","text":" (not enough brackets, it should be (("},{"kind":"math_inline","text":"3"},{"kind":"text","text":"+"},{"kind":"math_inline","text":"5"},{"kind":"text","text":")+"},{"kind":"math_inline","text":"7"},{"kind":"text","text":") or ("},{"kind":"math_inline","text":"3"},{"kind":"text","text":"+("},{"kind":"math_inline","text":"5"},{"kind":"text","text":"+"},{"kind":"math_inline","text":"7"},{"kind":"text","text":"))) "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"abs(t"},{"kind":"text","text":"-"},{"kind":"math_inline","text":"3)"},{"kind":"text","text":" (not enough brackets, it should be "},{"kind":"math_inline","text":"abs((t"},{"kind":"text","text":"-"},{"kind":"math_inline","text":"3))"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2"},{"kind":"text","text":"+"},{"kind":"math_inline","text":"(2"},{"kind":"text","text":"-"},{"kind":"math_inline","text":"3"},{"kind":"text","text":" (one bracket too many)"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1"},{"kind":"text","text":"("},{"kind":"math_inline","text":"t"},{"kind":"text","text":"+"},{"kind":"math_inline","text":"5"},{"kind":"text","text":") (no arithmetic operation between 1 and the bracket)"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"5000"},{"kind":"text","text":"*"},{"kind":"math_inline","text":"5000"},{"kind":"text","text":" (the number exceeds the maximum)"}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9bb7270a46dcfa275d5ce24f6119e20cea5b8f70356a6f48e3858a14dd00404f.png"},"kind":"image"},{"kind":"text","text":" The picture shows one of the possible solutions"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"593C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/593/problem/C"}