{"assets":[],"contentKind":"statement","contestId":"270","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Multithreading"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Emuskald is addicted to Codeforces, and keeps refreshing the main page not to miss any changes in the \"recent actions\" list. He likes to read thread conversations where each thread consists of multiple messages."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Recent actions shows a list of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different threads ordered by the time of the latest message in the thread. When a new message is posted in a thread that thread jumps on the top of the list. No two messages of different threads are ever posted at the same time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Emuskald has just finished reading all his opened threads and refreshes the main page for some more messages to feed his addiction. He notices that no new threads have appeared in the list and at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th place in the list there is a thread that was at the "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"-th place before the refresh. He doesn't want to waste any time reading old messages so he wants to open only threads with new messages."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Emuskald find out the number of threads that "},{"children":[{"kind":"text","text":"surely"}],"kind":"container"},{"kind":"text","text":" have new messages. A thread "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" surely has a new message if there is no such sequence of thread updates (posting messages) that both conditions hold: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" thread "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is not updated (it has no new messages); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the list order 1, 2, ..., "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" changes to "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", the number of threads ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":"). The next line contains a list of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ n"},{"kind":"text","text":") is the old position of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th thread in the new list. It is guaranteed that all of the "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the number of threads that surely contain a new message."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n5 2 1 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n4 3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, threads 2 and 5 are placed before the thread 1, so these threads must contain new messages. Threads 1, 3 and 4 may contain no new messages, if only threads 2 and 5 have new messages."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, there may be no new messages at all, since the thread order hasn't changed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, only thread 1 can contain no new messages."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"270B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/270/problem/B"}