{"assets":["/statement-assets/4a6f49b521dced73eeda92bc8c03a8c347c5c01e6bcbf3a7daf4570de96ba3ed.png","/statement-assets/df96b750fdf5a1e1476433e1e71845efe07b512454d56fc77d378962d10cdbb3.png","/statement-assets/5073c4e5a6a285d2a607a4f95df59f2221838a0b5845b6cbe5224ab6afddbde1.png","/statement-assets/930aed06e8183ceb2d746b1d112c9a234c299513c73c1a6688e6da9f4a94f6ce.png","/statement-assets/d4825e3665a22d21f6cb11e2bfe5e38c2a1a33c7c61f1945b5dddd84c5b59b43.png"],"contentKind":"statement","contestId":"715","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Digit Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"ZS the Coder has a large tree. It can be represented as an undirected connected graph of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices numbered from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" edges between them. There is a single "},{"children":[{"kind":"text","text":"nonzero"}],"kind":"container"},{"kind":"text","text":" digit written on each edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One day, ZS the Coder was bored and decided to investigate some properties of the tree. He chose a positive integer "},{"kind":"math_inline","text":"M"},{"kind":"text","text":", which is "},{"children":[{"kind":"text","text":"coprime"}],"kind":"container"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"10"},{"kind":"text","text":", i.e. "},{"attrs":{"alt":"","src":"/statement-assets/4a6f49b521dced73eeda92bc8c03a8c347c5c01e6bcbf3a7daf4570de96ba3ed.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"ZS consider an "},{"children":[{"kind":"text","text":"ordered pair"}],"kind":"container"},{"kind":"text","text":" of distinct vertices "},{"kind":"math_inline","text":"(u, v)"},{"children":[{"kind":"text","text":"interesting"}],"kind":"container"},{"kind":"text","text":" when if he would follow the shortest path from vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and write down all the digits he encounters on his path in the same order, he will get a decimal representaion of an integer divisible by "},{"kind":"math_inline","text":"M"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, ZS consider an ordered pair of distinct vertices "},{"kind":"math_inline","text":"(u, v)"},{"kind":"text","text":" interesting if the following states true:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Let "},{"kind":"math_inline","text":"a1 = u, a2, ..., ak = v"},{"kind":"text","text":" be the sequence of vertices on the shortest path from "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" in the order of encountering them; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Let "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i < k"},{"kind":"text","text":") be the digit written on the edge between vertices "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ai + 1"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The integer "},{"attrs":{"alt":"","src":"/statement-assets/df96b750fdf5a1e1476433e1e71845efe07b512454d56fc77d378962d10cdbb3.png"},"kind":"image"},{"kind":"text","text":" is divisible by "},{"kind":"math_inline","text":"M"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help ZS the Coder find the number of interesting pairs!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100 000"},{"kind":"text","text":","},{"kind":"math_inline","text":" 1 ≤ M ≤ 109"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/5073c4e5a6a285d2a607a4f95df59f2221838a0b5845b6cbe5224ab6afddbde1.png"},"kind":"image"},{"kind":"text","text":") — the number of vertices and the number ZS has chosen respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain three integers each. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains "},{"kind":"math_inline","text":"ui, vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":", denoting an edge between vertices "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" with digit "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" written on it ("},{"kind":"math_inline","text":"0 ≤ ui, vi < n,  1 ≤ wi ≤ 9"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of interesting (by ZS the Coder's consideration) pairs."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 7\n0 1 2\n4 2 4\n2 0 1\n3 0 9\n2 5 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 11\n1 2 3\n2 0 3\n3 0 3\n4 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case, the interesting pairs are "},{"kind":"math_inline","text":"(0, 4), (1, 2), (1, 5), (3, 2), (2, 5), (5, 2), (3, 5)"},{"kind":"text","text":". The numbers that are formed by these pairs are "},{"kind":"math_inline","text":"14, 21, 217, 91, 7, 7, 917"},{"kind":"text","text":" respectively, which are all multiples of "},{"kind":"math_inline","text":"7"},{"kind":"text","text":". Note that "},{"kind":"math_inline","text":"(2, 5)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(5, 2)"},{"kind":"text","text":" are considered different. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/930aed06e8183ceb2d746b1d112c9a234c299513c73c1a6688e6da9f4a94f6ce.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second sample case, the interesting pairs are "},{"kind":"math_inline","text":"(4, 0), (0, 4), (3, 2), (2, 3), (0, 1), (1, 0), (4, 1), (1, 4)"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" of these pairs give the number "},{"kind":"math_inline","text":"33"},{"kind":"text","text":" while "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" of them give the number "},{"kind":"math_inline","text":"3333"},{"kind":"text","text":", which are all multiples of "},{"kind":"math_inline","text":"11"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d4825e3665a22d21f6cb11e2bfe5e38c2a1a33c7c61f1945b5dddd84c5b59b43.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"715C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/715/problem/C"}