{"assets":[],"contentKind":"statement","contestId":"432","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Football Kit"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider a football tournament where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" teams participate. Each team has two football kits: for home games, and for away games. The kit for home games of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th team has color "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and the kit for away games of this team has color "},{"kind":"math_inline","text":"yi"},{"kind":"math_inline","text":"(xi ≠ yi)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the tournament, each team plays exactly one home game and exactly one away game with each other team ("},{"kind":"math_inline","text":"n(n - 1)"},{"kind":"text","text":" games in total). The team, that plays the home game, traditionally plays in its home kit. The team that plays an away game plays in its away kit. However, if two teams has the kits of the same color, they cannot be distinguished. In this case the away team plays in its home kit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Calculate how many games in the described tournament each team plays in its home kit and how many games it plays in its away kit."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(2 ≤ n ≤ 105)"},{"kind":"text","text":" — the number of teams. Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the description of the teams. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two space-separated numbers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"math_inline","text":"(1 ≤ xi, yi ≤ 105; xi ≠ yi)"},{"kind":"text","text":" — the color numbers for the home and away kits of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th team."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each team, print on a single line two space-separated integers — the number of games this team is going to play in home and away kits, correspondingly. Print the answers for the teams in the order they appeared in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 0\n2 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n2 1\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n4 0\n2 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"432B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/432/problem/B"}