{"assets":[],"contentKind":"statement","contestId":"1406","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Three Sequences"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a sequence of $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to construct two sequences of integers $$$b$$$ and $$$c$$$ with length $$$n$$$ that satisfy:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" for every $$$i$$$ ($$$1\\leq i\\leq n$$$) $$$b_i+c_i=a_i$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b$$$ is non-decreasing, which means that for every $$$1 \\lt i\\leq n$$$, $$$b_i\\geq b_{i-1}$$$ must hold "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$c$$$ is non-increasing, which means that for every $$$1 \\lt i\\leq n$$$, $$$c_i\\leq c_{i-1}$$$ must hold "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You have to minimize $$$\\max(b_i,c_i)$$$. In other words, you have to minimize the maximum number in sequences $$$b$$$ and $$$c$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also there will be $$$q$$$ changes, the $$$i$$$-th change is described by three integers $$$l,r,x$$$. You should add $$$x$$$ to $$$a_l,a_{l+1}, \\ldots, a_r$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to find the minimum possible value of $$$\\max(b_i,c_i)$$$ for the initial sequence and for sequence after each change."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$n$$$ ($$$1\\leq n\\leq 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The secound line contains $$$n$$$ integers $$$a_1,a_2,\\ldots,a_n$$$ ($$$1\\leq i\\leq n$$$, $$$-10^9\\leq a_i\\leq 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains an integer $$$q$$$ ($$$1\\leq q\\leq 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$q$$$ lines contains three integers $$$l,r,x$$$ ($$$1\\leq l\\leq r\\leq n,-10^9\\leq x\\leq 10^9$$$), desribing the next change. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$q+1$$$ lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the $$$i$$$-th ($$$1 \\leq i \\leq q+1$$$) line, print the answer to the problem for the sequence after $$$i-1$$$ changes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n2 -1 7 3\n2\n2 4 -3\n3 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n5\n6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n-9 -10 -9 -6 -5 4\n3\n2 6 -9\n1 2 -10\n4 6 -3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n3\n3\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n0\n2\n1 1 -1\n1 1 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n0\n-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The initial sequence $$$a = (2, -1, 7, 3)$$$. Two sequences $$$b=(-3,-3,5,5),c=(5,2,2,-2)$$$ is a possible choice. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After the first change $$$a = (2, -4, 4, 0)$$$. Two sequences $$$b=(-3,-3,5,5),c=(5,-1,-1,-5)$$$ is a possible choice. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" After the second change $$$a = (2, -4, 6, 2)$$$. Two sequences $$$b=(-4,-4,6,6),c=(6,0,0,-4)$$$ is a possible choice. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1406D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1406/problem/D"}