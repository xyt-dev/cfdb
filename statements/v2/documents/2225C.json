{"assets":[],"contentKind":"statement","contestId":"2225","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Red-Black Pairs"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a table of $$$2 \\times n$$$ cells. Each cell of the table is colored either red or black. You want to repaint some cells of this table so that there exists at least one way to partition all cells into $$$n$$$ pairs such that the following conditions hold: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the cells in each pair have the same color; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the cells in each pair share a side. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"What is the minimum number of cells that need to be repainted?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains one integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^{5}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second and third lines of each test case describe the colors of the cells. Each line contains a string consisting of exactly $$$n$$$ letters \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\" and/or \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraint on the input: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output one integer — the minimum number of cells that need to be repainted."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1\nR\nB\n2\nBR\nBR\n3\nRBR\nBRB\n4\nRRBB\nBBRB\n5\nRBRBR\nBBBRB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n0\n3\n1\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the $$$3$$$rd example. One possible option is to color all cells in one color, which requires repainting $$$3$$$ cells."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the $$$4$$$th example, one possible valid repainting is "}],"kind":"paragraph"},{"children":[{"kind":"code_block","text":"\nRRBB\nBBRR\n"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"2225C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2225/problem/C"}