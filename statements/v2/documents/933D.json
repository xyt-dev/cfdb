{"assets":["/statement-assets/43517707aa6c86f26a0b6e1347f025d4448488ccec5b93243c63e9c552521298.png","/statement-assets/95c45fbe78328c88eb8c7f5077f2cf10d02331c19dba4d362732688b375fd827.png","/statement-assets/c7992d194e7ac06280eed178aeff2c9f5bce04222b3f4735e3c51d71c1b15c38.png","/statement-assets/038d27f9c1d63e4f3b43359b29d20b93d371fbdefef0e4838a3aae5cfbacd7af.png","/statement-assets/b1277c567a600dc85dc46316ccf3ed06ee41a6989100291865152060ecba93ad.png"],"contentKind":"statement","contestId":"933","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. A Creative Cutout"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Everything red frightens Nian the monster. So do red paper and... you, red on Codeforces, potential or real."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Big Banban has got a piece of paper with endless lattice points, where lattice points form squares with the same area. His most favorite closed shape is the circle because of its beauty and simplicity. Once he had obtained this piece of paper, he prepares it for paper-cutting."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/43517707aa6c86f26a0b6e1347f025d4448488ccec5b93243c63e9c552521298.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"He drew "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" concentric circles on it and numbered these circles from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" such that the center of each circle is the same lattice point and the radius of the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th circle is "},{"attrs":{"alt":"","src":"/statement-assets/95c45fbe78328c88eb8c7f5077f2cf10d02331c19dba4d362732688b375fd827.png"},"kind":"image"},{"kind":"text","text":" times the length of a lattice edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Define the degree of beauty of a lattice point as the summation of the "},{"children":[{"kind":"text","text":"indices"}],"kind":"container"},{"kind":"text","text":" of circles such that this lattice point is inside them, or on their bounds. Banban wanted to ask you the total degree of beauty of all the lattice points, but changed his mind."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Defining the total degree of beauty of all the lattice points on a piece of paper with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" circles as "},{"kind":"math_inline","text":"f(n)"},{"kind":"text","text":", you are asked to figure out "},{"attrs":{"alt":"","src":"/statement-assets/c7992d194e7ac06280eed178aeff2c9f5bce04222b3f4735e3c51d71c1b15c38.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ m ≤ 1012)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print one integer representing "},{"attrs":{"alt":"","src":"/statement-assets/c7992d194e7ac06280eed178aeff2c9f5bce04222b3f4735e3c51d71c1b15c38.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"387\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"233\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"788243189\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A piece of paper with "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" circles is shown in the following."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/038d27f9c1d63e4f3b43359b29d20b93d371fbdefef0e4838a3aae5cfbacd7af.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" types of lattice points where the degree of beauty of each red point is "},{"kind":"math_inline","text":"1 + 2 + 3 + 4 + 5 = 15"},{"kind":"text","text":", the degree of beauty of each orange point is "},{"kind":"math_inline","text":"2 + 3 + 4 + 5 = 14"},{"kind":"text","text":", the degree of beauty of each green point is "},{"kind":"math_inline","text":"4 + 5 = 9"},{"kind":"text","text":", the degree of beauty of each blue point is "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" and the degree of beauty of each gray point is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". Therefore, "},{"kind":"math_inline","text":"f(5) = 5·15 + 4·14 + 4·9 + 8·5 = 207"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Similarly, "},{"kind":"math_inline","text":"f(1) = 5, f(2) = 23, f(3) = 50, f(4) = 102"},{"kind":"text","text":" and consequently "},{"attrs":{"alt":"","src":"/statement-assets/b1277c567a600dc85dc46316ccf3ed06ee41a6989100291865152060ecba93ad.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"933D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/933/problem/D"}