{"assets":[],"contentKind":"statement","contestId":"883","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Berland Army"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" military men in the Berland army. Some of them have given orders to other military men by now. Given "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" pairs ("},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":"), meaning that the military man "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" gave the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th order to another military man "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is time for reform! The Berland Ministry of Defence plans to introduce ranks in the Berland army. Each military man should be assigned a rank — integer number between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", inclusive. Some of them have been already assigned a rank, but the rest of them should get a rank soon."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the ministry to assign ranks to the rest of the army so that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" for each of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" orders it is true that the rank of a person giving the order (military man "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":") is strictly greater than the rank of a person receiving the order (military man "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for each rank from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" there is at least one military man with this rank. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ m ≤ 2·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 2·105"},{"kind":"text","text":") — number of military men in the Berland army, number of orders and number of ranks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"r1, r2, ..., rn"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ri > 0"},{"kind":"text","text":" (in this case "},{"kind":"math_inline","text":"1 ≤ ri ≤ k"},{"kind":"text","text":") means that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th military man has been already assigned the rank "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"ri = 0"},{"kind":"text","text":" means the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th military man doesn't have a rank yet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain orders one per line. Each order is described with a line containing two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"xi ≠ yi"},{"kind":"text","text":"). This line means that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th order was given by the military man "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" to the military man "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":". For each pair "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" of military men there could be several orders from "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number is the rank of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th military man. If there are many solutions, print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is no solution, print the only number "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":