{"assets":[],"contentKind":"statement","contestId":"2047","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Replace Character"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You're given a string $$$s$$$ of length $$$n$$$, consisting of only lowercase English letters. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You must do the following operation exactly once: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose any two indices $$$i$$$ and $$$j$$$ ($$$1 \\le i, j \\le n$$$). You can choose $$$i = j$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Set $$$s_i := s_j$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You need to minimize the number of distinct permutations$$$^\\dagger$$$ of $$$s$$$. Output any string with the smallest number of distinct permutations after performing "},{"children":[{"kind":"text","text":"exactly one"}],"kind":"container"},{"kind":"text","text":" operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$^\\dagger$$$ A permutation of the string is an arrangement of its characters into any order. For example, \""},{"children":[{"kind":"text","text":"bac"}],"kind":"container"},{"kind":"text","text":"\" is a permutation of \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\" but \""},{"children":[{"kind":"text","text":"bcc"}],"kind":"container"},{"kind":"text","text":"\" is not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 500$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains $$$n$$$ ($$$1 \\le n \\le 10$$$) — the length of string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$s$$$ of length $$$n$$$. The string contains only lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the required $$$s$$$ after applying exactly one operation. If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n3\nabc\n4\nxyyx\n8\nalphabet\n1\nk\n10\naabbccddee\n6\nttbddq\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\ncbc\nyyyx\nalphaaet\nk\neabbccddee\ntttddq\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, we can obtain the following strings in one operation: \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"bbc"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"cbc"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"aac"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"acc"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"abb"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The string \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\" has $$$6$$$ distinct permutations: \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"acb"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"bac"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"bca"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"cab"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"cba"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The string \""},{"children":[{"kind":"text","text":"cbc"}],"kind":"container"},{"kind":"text","text":"\" has $$$3$$$ distinct permutations: \""},{"children":[{"kind":"text","text":"bcc"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"cbc"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"ccb"}],"kind":"container"},{"kind":"text","text":"\", which is the lowest of all the obtainable strings. In fact, all obtainable strings except \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\" have $$$3$$$ permutations, so any of them would be accepted."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"2047B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2047/problem/B"}