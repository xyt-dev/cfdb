{"assets":["/statement-assets/83e7f4e4a8df4f96ee6da09fb348769f8c485e4b49524968b0097784fde99f53.png","/statement-assets/20b5484fb8adb1b5020593c8cc3c66054c35639e7a875a7f1815f25f0f394dff.png"],"contentKind":"statement","contestId":"444","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. DZY Loves FFT"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"DZY loves Fast Fourier Transformation, and he enjoys using it."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Fast Fourier Transformation is an algorithm used to calculate convolution. Specifically, if "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" are sequences with length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", which are indexed from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":", and"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/83e7f4e4a8df4f96ee6da09fb348769f8c485e4b49524968b0097784fde99f53.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"We can calculate "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" fast using Fast Fourier Transformation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"DZY made a little change on this formula. Now"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/20b5484fb8adb1b5020593c8cc3c66054c35639e7a875a7f1815f25f0f394dff.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"To make things easier, "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is a permutation of integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is a sequence only containing "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Given "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", DZY needs your help to calculate "},{"kind":"math_inline","text":"c"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Because he is naughty, DZY provides a special way to get "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". What you need is only three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"d"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". After getting them, use the code below to generate "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"kind":"code_block","text":"\n//x is 64-bit variable;\nfunction getNextX() {\n    x = (x * 37 + 10007) % 1000000007;\n    return x;\n}\nfunction initAB() {\n    for(i = 0; i < n; i = i + 1){\n        a[i] = i + 1;\n    }\n    for(i = 0; i < n; i = i + 1){\n        swap(a[i], a[getNextX() % (i + 1)]);\n    }\n    for(i = 0; i < n; i = i + 1){\n        if (i < d)\n            b[i] = 1;\n        else\n            b[i] = 0;\n    }\n    for(i = 0; i < n; i = i + 1){\n        swap(b[i], b[getNextX() % (i + 1)]);\n    }\n}\n\n"},{"children":[{"kind":"text","text":"Operation "},{"children":[{"kind":"text","text":"x % y"}],"kind":"container"},{"kind":"text","text":" denotes remainder after division "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". Function "},{"children":[{"kind":"text","text":"swap(x, y)"}],"kind":"container"},{"kind":"text","text":" swaps two values "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of input contains three space-separated integers "},{"kind":"math_inline","text":"n, d, x (1 ≤ d ≤ n ≤ 100000; 0 ≤ x ≤ 1000000006)"},{"kind":"text","text":". Because DZY is naughty, "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" can't be equal to "},{"kind":"math_inline","text":"27777500"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line should contain an integer "},{"kind":"math_inline","text":"ci - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n3\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2\n4\n5\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n5\n5\n5\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"[1 3 2]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"[1 0 0]"},{"kind":"text","text":", so "},{"kind":"math_inline","text":"c0 = max(1·1) = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c1 = max(1·0, 3·1) = 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c2 = max(1·0, 3·0, 2·1) = 2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, "},{"kind":"math_inline","text":"a"},{"kind":"text