{"assets":[],"contentKind":"statement","contestId":"280","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Game on Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Momiji has got a rooted tree, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes. The tree nodes are numbered by integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The root has number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Momiji decided to play a game on this tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The game consists of several steps. On each step, Momiji chooses one of the remaining tree nodes (let's denote it by "},{"kind":"math_inline","text":"v"},{"kind":"text","text":") and removes all the subtree nodes with the root in node "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" from the tree. Node "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" gets deleted as well. The game finishes when the tree has no nodes left. In other words, the game finishes after the step that chooses the node number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each time Momiji chooses a new node uniformly among all the remaining nodes. Your task is to find the expectation of the number of steps in the described game."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":" — the number of nodes in the tree. The next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain the tree edges. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"math_inline","text":"(1 ≤ ai, bi ≤ n; ai ≠ bi)"},{"kind":"text","text":" — the numbers of the nodes that are connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given graph is a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single real number — the expectation of the number of steps in the described game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer will be considered correct if the absolute or relative error doesn't exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.50000000000000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2.00000000000000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, there are two cases. One is directly remove the root and another is remove the root after one step. Thus the expected steps are: "}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"1 × (1 / 2) + 2 × (1 / 2) = 1.5"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second sample, things get more complex. There are two cases that reduce to the first sample, and one case cleaned at once. Thus the expected steps are: "}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"1 × (1 / 3) + (1 + 1.5) × (2 / 3) = (1 / 3) + (5 / 3) = 2"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"280C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/280/problem/C"}