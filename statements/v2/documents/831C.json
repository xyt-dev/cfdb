{"assets":[],"contentKind":"statement","contestId":"831","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Jury Marks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp watched TV-show where "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" jury members one by one rated a participant by adding him a certain number of points (may be negative, i. e. points were subtracted). Initially the participant had some score, and each the marks were one by one added to his score. It is known that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th jury member gave "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp does not remember how many points the participant had before this "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" marks were given, but he remembers that among the scores announced after each of the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" judges rated the participant there were "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"n ≤ k"},{"kind":"text","text":") values "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" (it is guaranteed that all values "},{"kind":"math_inline","text":"bj"},{"kind":"text","text":" are distinct). It is possible that Polycarp remembers not all of the scores announced, i. e. "},{"kind":"math_inline","text":"n < k"},{"kind":"text","text":". Note that the initial score wasn't announced."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine the number of options for the score the participant could have before the judges rated the participant."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ k ≤ 2 000"},{"kind":"text","text":") — the number of jury members and the number of scores Polycarp remembers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., ak"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 2 000 ≤ ai ≤ 2 000"},{"kind":"text","text":") — jury's marks in chronological order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 4 000 000 ≤ bj ≤ 4 000 000"},{"kind":"text","text":") — the values of points Polycarp remembers. Note that these values are not necessarily given in chronological order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of options for the score the participant could have before the judges rated the participant. If Polycarp messes something up and there is no options, print \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n-5 5 0 20\n10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n-2000 -2000\n3998000 4000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The answer for the first example is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" because initially the participant could have "},{"kind":"math_inline","text":" - 10"},{"kind":"text","text":", "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"15"},{"kind":"text","text":" points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example there is only one correct initial score equaling to "},{"kind":"math_inline","text":"4 002 000"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"831C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/831/problem/C"}