{"assets":[],"contentKind":"statement","contestId":"416","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Population Size"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarpus develops an interesting theory about the interrelation of arithmetic progressions with just everything in the world. His current idea is that the population of the capital of Berland changes over time like an arithmetic progression. Well, or like multiple arithmetic progressions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus believes that if he writes out the population of the capital for several consecutive years in the sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":", then it is convenient to consider the array as several arithmetic progressions, written one after the other. For example, sequence "},{"kind":"math_inline","text":"(8, 6, 4, 2, 1, 4, 7, 10, 2)"},{"kind":"text","text":" can be considered as a sequence of three arithmetic progressions "},{"kind":"math_inline","text":"(8, 6, 4, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 4, 7, 10)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(2)"},{"kind":"text","text":", which are written one after another."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, Polycarpus may not have all the data for the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" consecutive years (a census of the population doesn't occur every year, after all). For this reason, some values of "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ​​may be unknown. Such values are represented by number "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a given sequence "},{"kind":"math_inline","text":"a = (a1, a2, ..., an)"},{"kind":"text","text":", which consists of positive integers and values ​​"},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":", find the minimum number of arithmetic progressions Polycarpus needs to get "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". To get "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", the progressions need to be written down one after the other. Values ​​"},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" may correspond to an arbitrary positive integer and the values "},{"kind":"math_inline","text":"ai > 0"},{"kind":"text","text":" must be equal to the corresponding elements of sought consecutive record of the progressions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us remind you that a finite sequence "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" is called an arithmetic progression if the difference "},{"kind":"math_inline","text":"ci + 1 - ci"},{"kind":"text","text":" of any two consecutive elements in it is constant. By definition, any sequence of length 1 is an arithmetic progression."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105"},{"kind":"text","text":") — the number of elements in the sequence. The second line contains integer values "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" separated by a space ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"ai =  - 1"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of arithmetic progressions that you need to write one after another to get sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". The positions marked as "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" can be represented by any positive integers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n8 6 4 2 1 4 7 10 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n-1 6 -1 2 -1 4 7 -1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n-1 -1 -1 -1 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n-1 -1 4 5 1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"416D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/416/problem/D"}