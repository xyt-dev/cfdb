{"assets":[],"contentKind":"statement","contestId":"156","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Message"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dr. Moriarty is about to send a message to Sherlock Holmes. He has a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"String "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is called a "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":" of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" if you can read it starting from some position in the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". For example, string \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\" has six substrings: \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Dr. Moriarty plans to take string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and cut out some substring from it, let's call it "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Then he needs to "},{"children":[{"kind":"text","text":"change"}],"kind":"container"},{"kind":"text","text":" the substring "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" zero or more times. As a result, he should obtain a fixed string "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" (which is the string that should be sent to Sherlock Holmes). One change is defined as making one of the following actions: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Insert one letter to any end of the string. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Delete one letter from any end of the string. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Change one letter into any other one. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Moriarty is very smart and after he chooses some substring "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", he always makes the minimal number of changes to obtain "},{"kind":"math_inline","text":"u"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Moriarty choose the best substring "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" from all substrings of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". The substring "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" should minimize the number of changes Moriarty should make to obtain the string "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" from it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a non-empty string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of lowercase Latin letters. The second line contains a non-empty string "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", consisting of lowercase Latin letters. The lengths of both strings are in the range from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"2000"},{"kind":"text","text":", inclusive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer — the minimum number of changes that Dr. Moriarty has to make with the string that you choose."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"aaaaa\naaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abcabc\nbcd\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abcdef\nklmnopq\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Moriarty can take any substring of length "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", and it will be equal to the required message "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", so Moriarty won't have to make any changes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample you should take a substring consisting of characters from second to fourth (\""},{"children":[{"kind":"text","text":"bca"}],"kind":"container"},{"kind":"text","text":"\") or from fifth to sixth (\""},{"children":[{"kind":"text","text":"bc"}],"kind":"container"},{"kind":"text","text":"\"). Then you will only have to make one change: to change or to add the last character."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample the initial string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" doesn't contain any character that the message should contain, so, whatever string you choose, you will have to make at least "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" changes to obtain the required message."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"156A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/156/problem/A"}