{"assets":["/statement-assets/0de0938f8e58a82ccc79c835917a7c70691db371dd528866156f4638aa451af4.png","/statement-assets/e210da9989fe2c3dcde358c07ae05a7fa0a93dace3a728879039207a975cdd08.png","/statement-assets/0caf9abca076bef42ad701d0276d351e5c7d54147e2db7f6c2717ebf7a0fd661.png"],"contentKind":"statement","contestId":"459","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Pashmak and Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pashmak's homework is a problem about graphs. Although he always tries to do his homework completely, he can't solve this problem. As you know, he's really weak at graph theory; so try to help him in solving the problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a weighted directed graph with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges. You need to find a path (perhaps, non-simple) with maximum number of edges, such that the weights of the edges increase along the path. In other words, each edge of the path must have strictly greater weight than the previous edge in the path."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Pashmak, print the number of edges in the required path."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(2 ≤ n ≤ 3·105; 1 ≤ m ≤ min(n·(n - 1), 3·105))"},{"kind":"text","text":". Then, "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follows. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains three space separated integers: "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"wi"},{"kind":"math_inline","text":"(1 ≤ ui, vi ≤ n; 1 ≤ wi ≤ 105)"},{"kind":"text","text":" which indicates that there's a directed edge with weight "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" from vertex "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the graph doesn't contain self-loops and multiple edges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2 1\n2 3 1\n3 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2 1\n2 3 2\n3 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 7\n1 2 1\n3 2 5\n2 4 2\n2 5 2\n2 6 9\n5 4 3\n4 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the maximum trail can be any of this trails: "},{"attrs":{"alt":"","src":"/statement-assets/0de0938f8e58a82ccc79c835917a7c70691db371dd528866156f4638aa451af4.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the maximum trail is "},{"attrs":{"alt":"","src":"/statement-assets/e210da9989fe2c3dcde358c07ae05a7fa0a93dace3a728879039207a975cdd08.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample the maximum trail is "},{"attrs":{"alt":"","src":"/statement-assets/0caf9abca076bef42ad701d0276d351e5c7d54147e2db7f6c2717ebf7a0fd661.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"459E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/459/problem/E"}