{"assets":["/statement-assets/7881a7507b1455e1eeccbaf09616abc04ee2f6dbd7de0866a194155a07e2b963.png"],"contentKind":"statement","contestId":"424","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Squats"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pasha has many hamsters and he makes them work out. Today, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" hamsters ("},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is even) came to work out. The hamsters lined up and each hamster either sat down or stood up."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For another exercise, Pasha needs exactly "},{"attrs":{"alt":"","src":"/statement-assets/7881a7507b1455e1eeccbaf09616abc04ee2f6dbd7de0866a194155a07e2b963.png"},"kind":"image"},{"kind":"text","text":" hamsters to stand up and the other hamsters to sit down. In one minute, Pasha can make some hamster ether sit down or stand up. How many minutes will he need to get what he wants if he acts optimally well?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 200"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is even). The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters without spaces. These characters describe the hamsters' position: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character equals '"},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"', if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th hamster in the row is standing, and '"},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":"', if he is sitting."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, print a single integer — the minimum required number of minutes. In the second line, print a string that describes the hamsters' position after Pasha makes the required changes. If there are multiple optimal positions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nxxXx\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\nXxXx\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\nXX\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\nxX\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\nxXXxXx\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\nxXXxXx\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"424A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/424/problem/A"}