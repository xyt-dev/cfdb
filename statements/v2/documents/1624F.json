{"assets":[],"contentKind":"statement","contestId":"1624","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Interacdive Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This problem is interactive."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We decided to play a game with you and guess the number $$$x$$$ ($$$1 \\le x \\lt n$$$), where you know the number $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can make queries like this:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"+ c"}],"kind":"container"},{"kind":"text","text":": this command assigns $$$x = x + c$$$ ($$$1 \\le c \\lt n$$$) and then returns you the value $$$\\lfloor\\frac{x}{n}\\rfloor$$$ ($$$x$$$ divide by $$$n$$$ and round down)."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You win if you guess the current number with no more than $$$10$$$ queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom","title":"Interaction"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Interaction"}],"kind":"heading"},{"children":[{"kind":"text","text":"The interaction begins by reading an integer $$$n$$$ ($$$2 \\lt n \\le 1000$$$), which is written in the input data on its own line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then you can make no more than $$$10$$$ queries. To make a query, print on a separate line:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"+ c"}],"kind":"container"},{"kind":"text","text":": this command will assign $$$x = x + c$$$ ($$$1 \\le c \\lt n$$$) and then print $$$\\lfloor\\frac{x}{n}\\rfloor$$$ (divide $$$x$$$ by $$$n$$$ and round down) on a separate line. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Print the answer, like the queries, on a separate line. The answer doesn't count in number of queries. To output it, use the following format:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"! x"}],"kind":"container"},{"kind":"text","text":": the current value of $$$x$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"After that, your program should exit."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to use a "},{"children":[{"kind":"text","text":"flush"}],"kind":"container"},{"kind":"text","text":" operation right after printing each line. For example, in C++ you should use the function "},{"children":[{"kind":"text","text":"fflush(stdout)"}],"kind":"container"},{"kind":"text","text":", in Java — "},{"children":[{"kind":"text","text":"System.out.flush()"}],"kind":"container"},{"kind":"text","text":", in Pascal — "},{"children":[{"kind":"text","text":"flush(output)"}],"kind":"container"},{"kind":"text","text":" and in Python — "},{"children":[{"kind":"text","text":"sys.stdout.flush()"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the interactor is not responsive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To make a hack, use the following format: a single line must contain two numbers $$$x$$$ and $$$n$$$, separated by a space."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n\n1"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n+ 1\n\n! 3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n\n0\n\n0\n\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n+ 1\n\n+ 1\n\n+ 1\n\n! 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n\n0\n\n0\n\n1\n\n2"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n\n+ 2\n\n+ 2\n\n+ 3\n\n+ 8\n\n! 20"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample initially $$$x = 2$$$. After the first query $$$x = 3$$$, $$$\\lfloor\\frac{x}{n}\\rfloor = 1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample also initially $$$x = 2$$$. After the first query $$$x = 3$$$, $$$\\lfloor\\frac{x}{n}\\rfloor = 0$$$. After the second query $$$x = 4$$$, $$$\\lfloor\\frac{x}{n}\\rfloor = 0$$$. After the third query $$$x=5$$$, $$$\\lfloor\\frac{x}{n}\\rfloor = 1$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1624F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1624/problem/F"}