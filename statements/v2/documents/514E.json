{"assets":["/statement-assets/6e52a32b7b22b84270b68761c721e091126b60f6c36046bdce10ca390cd58d71.png"],"contentKind":"statement","contestId":"514","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Darth Vader and Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"When Darth Vader gets bored, he sits down on the sofa, closes his eyes and thinks of an infinite rooted tree where each node has exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sons, at that for each node, the distance between it an its "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th left child equals to "},{"kind":"math_inline","text":"di"},{"kind":"text","text":". The Sith Lord loves counting the number of nodes in the tree that are at a distance at most "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" from the root. The distance is the sum of the lengths of edges on the path between nodes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But he has got used to this activity and even grew bored of it. 'Why does he do that, then?' — you may ask. It's just that he feels superior knowing that only he can solve this problem. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Do you want to challenge Darth Vader himself? Count the required number of nodes. As the answer can be rather large, find it modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105, 0 ≤ x ≤ 109"},{"kind":"text","text":") — the number of children of each node and the distance from the root within the range of which you need to count the nodes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ di ≤ 100"},{"kind":"text","text":") — the length of the edge that connects each node with its "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th child."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the number of vertexes in the tree at distance from the root equal to at most "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Pictures to the sample (the yellow color marks the nodes the distance to which is at most three)"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6e52a32b7b22b84270b68761c721e091126b60f6c36046bdce10ca390cd58d71.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"514E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/514/problem/E"}