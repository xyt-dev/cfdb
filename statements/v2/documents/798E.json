{"assets":[],"contentKind":"statement","contestId":"798","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Mike and code of a permutation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mike has discovered a new way to encode permutations. If he has a permutation "},{"kind":"math_inline","text":"P = [p1, p2, ..., pn]"},{"kind":"text","text":", he will encode it in the following way:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Denote by "},{"kind":"math_inline","text":"A = [a1, a2, ..., an]"},{"kind":"text","text":" a sequence of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" which will represent the code of the permutation. For each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sequentially, he will choose the smallest unmarked "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j ≤ n"},{"kind":"text","text":") such that "},{"kind":"math_inline","text":"pi < pj"},{"kind":"text","text":" and will assign to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" the number "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" (in other words he performs "},{"kind":"math_inline","text":"ai = j"},{"kind":"text","text":") and will mark "},{"kind":"math_inline","text":"j"},{"kind":"text","text":". If there is no such "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", he'll assign to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" the number "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":" (he performs "},{"kind":"math_inline","text":"ai =  - 1"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mike forgot his original permutation but he remembers its code. Your task is simple: find "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" permutation such that its code is the same as the code of Mike's original permutation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may assume that there will always be at least one valid permutation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 500 000"},{"kind":"text","text":") — length of permutation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ n"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"ai =  - 1"},{"kind":"text","text":") — the code of Mike's permutation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may assume that all positive values from "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In first and only line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":") — a permutation "},{"kind":"math_inline","text":"P"},{"kind":"text","text":" which has the same code as the given one. Note that numbers in permutation are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n2 -1 1 5 -1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 6 1 4 5 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n2 -1 4 -1 6 -1 8 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 8 2 7 3 6 4 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the permutation from the first example:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"i = 1"},{"kind":"text","text":", the smallest "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" because "},{"kind":"math_inline","text":"p2 = 6 > p1 = 2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"i = 2"},{"kind":"text","text":", there is no "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" because "},{"kind":"math_inline","text":"p2 = 6"},{"kind":"text","text":" is the greatest element in the permutation."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"i = 3"},{"kind":"text","text":", the smallest "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" because "},{"kind":"math_inline","text":"p1 = 2 > p3 = 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"i = 4"},{"kind":"text","text":", the smallest "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2"},{"kind":"text","text":" was already marked) because "},{"kind":"math_inline","text":"p5 = 5 > p4 = 4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"i = 5"},{"kind":"text","text":", there is no "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" because "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" is already marked."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"i = 6"},{"kind":"text","text":", the smallest "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" because "},{"kind":"math_inline","text":"p4 = 4 > p6 = 3"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"798E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/798/problem/E"}