{"assets":[],"contentKind":"statement","contestId":"231","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. To Add or Not to Add"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A piece of paper contains an array of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". Your task is to find a number that occurs the maximum number of times in this array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, before looking for such number, you are allowed to perform not more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" following operations — choose an arbitrary element from the array and add "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to it. In other words, you are allowed to increase some array element by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" no more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" times (you are allowed to increase the same element of the array multiple times)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the maximum number of occurrences of some number in the array after performing no more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" allowed operations. If there are several such numbers, your task is to find the minimum one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"0 ≤ k ≤ 109"},{"kind":"text","text":") — the number of elements in the array and the number of operations you are allowed to perform, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(|ai| ≤ 109)"},{"kind":"text","text":" — the initial array. The numbers in the lines are separated by single spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print two numbers — the maximum number of occurrences of some number in the array after at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" allowed operations are performed, and the minimum number that reaches the given maximum. Separate the printed numbers by whitespaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n6 3 4 0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n5 5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n3 1 2 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample your task is to increase the second element of the array once and increase the fifth element of the array twice. Thus, we get sequence "},{"kind":"math_inline","text":"6, 4, 4, 0, 4"},{"kind":"text","text":", where number "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" occurs "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample you don't need to perform a single operation or increase each element by one. If we do nothing, we get array "},{"kind":"math_inline","text":"5, 5, 5"},{"kind":"text","text":", if we increase each by one, we get "},{"kind":"math_inline","text":"6, 6, 6"},{"kind":"text","text":". In both cases the maximum number of occurrences equals "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". So we should do nothing, as number "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" is less than number "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample we should increase the second array element once and the fifth element once. Thus, we get sequence "},{"kind":"math_inline","text":"3, 2, 2, 2, 2"},{"kind":"text","text":", where number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" occurs "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" times."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"231C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/231/problem/C"}