{"assets":["/statement-assets/ea29d7d04adf3812cc87b6a752b7d41d8a7308ad1aec29d4e28fdbc2d3fb4a71.png","/statement-assets/a0e80d066101e0ef17b3673986feff0f723d4df430eaead803d93c65414b606b.png","/statement-assets/93a9c5dbd2d464e9a9bfbf7f3ae1e1d1f89445914496597cde7b9a9c67d0f0cd.png"],"contentKind":"statement","contestId":"117","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Tree or not Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an undirected connected graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertexes and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" edges. "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" contains no self-loops or multiple edges. Let each edge has two states: on and off. Initially all edges are switched off."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are also given "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries represented as "},{"kind":"math_inline","text":"(v, u)"},{"kind":"text","text":" — change the state of all edges on the shortest path from vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" in graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":". If there are several such paths, the lexicographically minimal one is chosen. More formally, let us consider all shortest paths from vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" as the sequences of vertexes "},{"kind":"math_inline","text":"v, v1, v2, ..., u"},{"kind":"text","text":". Among such sequences we choose the lexicographically minimal one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After each query you should tell how many connected components has the graph whose vertexes coincide with the vertexes of graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" and edges coincide with the switched on edges of graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":"). Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines describe the graph edges as "},{"kind":"math_inline","text":"a"},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ n"},{"kind":"text","text":"). Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the queries as "},{"kind":"math_inline","text":"v"},{"kind":"math_inline","text":"u"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ v, u ≤ n"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the graph is connected, does not have any self-loops or multiple edges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines, each containing one integer — the query results."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n2 1\n4 3\n2 4\n2 5\n4 1\n5 4\n1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2\n4 6\n4 3\n1 2\n6 5\n1 5\n1 4\n2 5\n2 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's consider the first sample. We'll highlight the switched on edges blue on the image. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"The graph before applying any operations. No graph edges are switched on, that's why there initially are 5 connected components. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ea29d7d04adf3812cc87b6a752b7d41d8a7308ad1aec29d4e28fdbc2d3fb4a71.png"},"kind":"image"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"The graph after query "},{"kind":"math_inline","text":"v = 5, u = 4"},{"kind":"text","text":". We can see that the graph has three components if we only consider the switched on edges. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a0e80d066101e0ef17b3673986feff0f723d4df430eaead803d93c65414b606b.png"},"kind":"image"}],"kind":"container"}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"The graph after query "},{"kind":"math_inline","text":"v = 1, u = 5"},{"kind":"text","text":". We can see that the graph has three components if we only consider the switched on edges. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/93a9c5dbd2d464e9a9bfbf7f3ae1e1d1f89445914496597cde7b9a9c67d0f0cd.png"},"kind":"image"}],"kind":"container"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Lexicographical comparison of two sequences of equal length of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" numbers should be done as follows. Sequence "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is lexicographically less than sequence "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" if exists such "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ k"},{"kind":"text","text":"), so that "},{"kind":"math_inline","text":"xi < yi"},{"kind":"text","text":", and for any "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j < i"},{"kind":"text","text":") "},{"kind":"math_inline","text":"xj = yj"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"117E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/117/problem/E"}