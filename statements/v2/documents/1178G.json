{"assets":[],"contentKind":"statement","contestId":"1178","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. The Awesomest Vertex"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a rooted tree on $$$n$$$ vertices. The vertices are numbered from $$$1$$$ to $$$n$$$; the root is the vertex number $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each vertex has two integers associated with it: $$$a_i$$$ and $$$b_i$$$. We denote the set of all ancestors of $$$v$$$ (including $$$v$$$ itself) by $$$R(v)$$$. The "},{"children":[{"kind":"text","text":"awesomeness"}],"kind":"container"},{"kind":"text","text":" of a vertex $$$v$$$ is defined as "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$\\left| \\sum_{w \\in R(v)} a_w\\right| \\cdot \\left|\\sum_{w \\in R(v)} b_w\\right|,$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"where $$$|x|$$$ denotes the absolute value of $$$x$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Process $$$q$$$ queries of one of the following forms: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"1 v x"}],"kind":"container"},{"kind":"text","text":" — increase $$$a_v$$$ by a positive integer $$$x$$$. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"2 v"}],"kind":"container"},{"kind":"text","text":" — report the maximum "},{"children":[{"kind":"text","text":"awesomeness"}],"kind":"container"},{"kind":"text","text":" in the subtree of vertex $$$v$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$q$$$ ($$$1 \\leq n \\leq 2\\cdot 10^5, 1 \\leq q \\leq 10^5$$$) — the number of vertices in the tree and the number of queries, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n - 1$$$ integers $$$p_2, p_3, \\dots, p_n$$$ ($$$1 \\leq p_i \\lt i$$$), where $$$p_i$$$ means that there is an edge between vertices $$$i$$$ and $$$p_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$-5000 \\leq a_i \\leq 5000$$$), the initial values of $$$a_i$$$ for each vertex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fourth line contains $$$n$$$ integers $$$b_1, b_2, \\dots, b_n$$$ ($$$-5000 \\leq b_i \\leq 5000$$$), the values of $$$b_i$$$ for each vertex."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$q$$$ lines describes a query. It has one of the following forms: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"1 v x"}],"kind":"container"},{"kind":"text","text":"  ($$$1 \\leq v \\leq n$$$, $$$1\\leq x \\leq 5000$$$). "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"2 v"}],"kind":"container"},{"kind":"text","text":"  ($$$1 \\leq v \\leq n$$$). "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the second type, print a single line with the maximum "},{"children":[{"kind":"text","text":"awesomeness"}],"kind":"container"},{"kind":"text","text":" in the respective subtree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6\n1 1 2 2\n10 -3 -7 -3 -10\n10 3 9 3 6\n2 1\n2 2\n1 2 6\n2 1\n1 2 5\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"100\n91\n169\n240\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The initial "},{"children":[{"kind":"text","text":"awesomeness"}],"kind":"container"},{"kind":"text","text":" of the vertices is $$$[100, 91, 57, 64, 57]$$$. The most "},{"children":[{"kind":"text","text":"awesome"}],"kind":"container"},{"kind":"text","text":" vertex in the subtree of vertex $$$1$$$ (the first query) is $$$1$$$, and the most "},{"children":[{"kind":"text","text":"awesome"}],"kind":"container"},{"kind":"text","text":" vertex in the subtree of vertex $$$2$$$ (the second query) is $$$2$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the first update (the third query), the "},{"children":[{"kind":"text","text":"awesomeness"}],"kind":"container"},{"kind":"text","text":" changes to $$$[100, 169, 57, 160, 57]$$$ and thus the most "},{"children":[{"kind":"text","text":"awesome"}],"kind":"container"},{"kind":"text","text":" vertex in the whole tree (the fourth query) is now $$$2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the second update (the fifth query), the "},{"children":[{"kind":"text","text":"awesomeness"}],"kind":"container"},{"kind":"text","text":" becomes $$$[100, 234, 57, 240, 152]$$$, hence the most "},{"children":[{"kind":"text","text":"awesome"}],"kind":"container"},{"kind":"text","text":" vertex (the sixth query) is now $$$4$$$. "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1178G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1178/problem/G"}