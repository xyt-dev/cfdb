{"assets":[],"contentKind":"statement","contestId":"518","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Ilya and Escalator"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ilya got tired of sports programming, left university and got a job in the subway. He was given the task to determine the escalator load factor. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's assume that "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people stand in the queue for the escalator. At each second one of the two following possibilities takes place: either the first person in the queue enters the escalator with probability "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", or the first person in the queue doesn't move with probability "},{"kind":"math_inline","text":"(1 - p)"},{"kind":"text","text":", paralyzed by his fear of escalators and making the whole queue wait behind him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally speaking, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th person in the queue cannot enter the escalator until people with indices from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"i - 1"},{"kind":"text","text":" inclusive enter it. In one second only one person can enter the escalator. The escalator is infinite, so if a person enters it, he never leaves it, that is he will be standing on the escalator at any following second. Ilya needs to count the expected value of the number of people standing on the escalator after "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" seconds. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to help him solve this complicated task."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three numbers "},{"kind":"math_inline","text":"n, p, t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, t ≤ 2000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ p ≤ 1"},{"kind":"text","text":"). Numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" are integers, number "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is real, given with exactly two digits after the decimal point."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single real number — the expected number of people who will be standing on the escalator after "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" seconds. The absolute or relative error mustn't exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 0.50 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 0.50 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.9375\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 0.20 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"518D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/518/problem/D"}