{"assets":[],"contentKind":"statement","contestId":"106","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Choosing Laptop"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya is choosing a laptop. The shop has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" laptops to all tastes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya is interested in the following properties: processor speed, ram and hdd. Vasya is a programmer and not a gamer which is why he is not interested in all other properties."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If all three properties of a laptop are "},{"children":[{"kind":"text","text":"strictly less"}],"kind":"container"},{"kind":"text","text":" than those properties of some other laptop, then the first laptop is considered outdated by Vasya. Among all laptops Vasya does not consider outdated, he chooses the cheapest one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are very many laptops, which is why Vasya decided to write a program that chooses the suitable laptop. However, Vasya doesn't have his own laptop yet and he asks you to help him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines. Each describes a laptop as "},{"kind":"math_inline","text":"speed"},{"kind":"math_inline","text":"ram"},{"kind":"math_inline","text":"hdd"},{"kind":"math_inline","text":"cost"},{"kind":"text","text":". Besides, "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"speed"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ram"},{"kind":"text","text":", "},{"kind":"math_inline","text":"hdd"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"cost"},{"kind":"text","text":" are integers "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1000 ≤ speed ≤ 4200"},{"kind":"text","text":" is the processor's speed in megahertz "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"256 ≤ ram ≤ 4096"},{"kind":"text","text":" the RAM volume in megabytes "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1 ≤ hdd ≤ 500"},{"kind":"text","text":" is the HDD in gigabytes "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"100 ≤ cost ≤ 1000"},{"kind":"text","text":" is price in tugriks "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"All laptops have different prices."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the number of a laptop Vasya will choose. The laptops are numbered with positive integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in the order in which they are given in the input data."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2100 512 150 200\n2000 2048 240 350\n2300 1024 200 320\n2500 2048 80 300\n2000 512 180 150\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the third sample Vasya considers the first and fifth laptops outdated as all of their properties cannot match those of the third laptop. The fourth one is the cheapest among the laptops that are left. Thus, Vasya chooses the fourth laptop."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"106B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/106/problem/B"}