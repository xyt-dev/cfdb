{"assets":[],"contentKind":"statement","contestId":"567","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. One-Dimensional Battle Ships"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Alice and Bob love playing one-dimensional battle ships. They play on the field in the form of a line consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" square cells (that is, on a "},{"kind":"math_inline","text":"1 × n"},{"kind":"text","text":" table)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At the beginning of the game Alice puts "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ships on the field without telling their positions to Bob. Each ship looks as a "},{"kind":"math_inline","text":"1 × a"},{"kind":"text","text":" rectangle (that is, it occupies a sequence of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" consecutive squares of the field). The ships cannot intersect and even touch each other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After that Bob makes a sequence of \"shots\". He names cells of the field and Alice either says that the cell is empty (\"miss\"), or that the cell belongs to some ship (\"hit\")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But here's the problem! Alice like to cheat. May be that is why she responds to each Bob's move with a \"miss\". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Bob catch Alice cheating — find Bob's first move, such that after it you can be sure that Alice cheated."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, k, a ≤ 2·105"},{"kind":"text","text":") — the size of the field, the number of the ships and the size of each ship. It is guaranteed that the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" are such that you can put "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ships of size "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" on the field, so that no two ships intersect or touch each other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ n"},{"kind":"text","text":") — the number of Bob's moves."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"x1, x2, ..., xm"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" is the number of the cell where Bob made the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th shot. The cells are numbered from left to right from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of such Bob's first move, after which you can be sure that Alice lied. Bob's moves are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" in the order the were made. If the sought move doesn't exist, then print \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11 3 3\n5\n4 8 6 1 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1 3\n2\n1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1 3\n1\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"567D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/567/problem/D"}