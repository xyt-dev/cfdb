{"assets":[],"contentKind":"statement","contestId":"66","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Petya and His Friends"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Petya has a birthday soon. Due this wonderful event, Petya's friends decided to give him sweets. The total number of Petya's friends equals to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let us remind you the definition of the greatest common divisor: "},{"kind":"math_inline","text":"GCD(a1, ..., ak) = d"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" represents such a maximal positive number that each "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ k"},{"kind":"text","text":") is evenly divisible by "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". At that, we assume that all "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"'s are greater than zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Knowing that Petya is keen on programming, his friends has agreed beforehand that the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st friend gives "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":" sweets, the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd one gives "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":" sweets, ..., the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th one gives "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" sweets. At the same time, for any "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i, j ≤ n"},{"kind":"text","text":") they want the "},{"kind":"math_inline","text":"GCD(ai, aj)"},{"kind":"text","text":" not to be equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". However, they also want the following condition to be satisfied: "},{"kind":"math_inline","text":"GCD(a1, a2, ..., an) = 1"},{"kind":"text","text":". One more: all the "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" should be distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the friends to choose the suitable numbers "},{"kind":"math_inline","text":"a1, ..., an"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 50"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no answer, print \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\" without quotes. Otherwise print a set of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct positive numbers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". Each line must contain one number. Each number must consist of not more than "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" digits, and must not contain any leading zeros. If there are several solutions to that problem, print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Do not forget, please, that all of the following conditions must be true:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" For every "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i, j ≤ n"},{"kind":"text","text":"): "},{"kind":"math_inline","text":"GCD(ai, aj) ≠ 1"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"GCD(a1, a2, ..., an) = 1"}],"kind":"list_item"},{"children":[{"kind":"text","text":" For every "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i, j ≤ n, i ≠ j"},{"kind":"text","text":"): "},{"kind":"math_inline","text":"ai ≠ aj"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Please, do not use "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specificator to read or write 64-bit integers in C++. It is preffered to use "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" (also you may use "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"99\n55\n11115\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"385\n360\n792\n8360\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"66D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/66/problem/D"}