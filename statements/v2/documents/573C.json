{"assets":["/statement-assets/6a82f3f1b6e1d85cf4ab6974e0f1e77e14a68679c00cb8bd8df281913b1f82d9.png"],"contentKind":"statement","contestId":"573","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Bear and Drawing"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Limak is a little bear who learns to draw. People usually start with houses, fences and flowers but why would bears do it? Limak lives in the forest and he decides to draw a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Recall that "},{"children":[{"kind":"text","text":"tree"}],"kind":"container"},{"kind":"text","text":" is a connected graph consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak chose a tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. He has infinite strip of paper with two parallel rows of dots. Little bear wants to assign vertices of a tree to some "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct dots on a paper so that edges would intersect only at their endpoints — drawn tree must be planar. Below you can see one of correct drawings for the first sample test."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6a82f3f1b6e1d85cf4ab6974e0f1e77e14a68679c00cb8bd8df281913b1f82d9.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Is it possible for Limak to draw chosen tree?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain description of a tree. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains two space-separated integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n, ai ≠ bi"},{"kind":"text","text":") denoting an edge between vertices "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". It's guaranteed that given description forms a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) if Limak can draw chosen tree. Otherwise, print \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n1 2\n1 3\n1 6\n6 4\n6 7\n6 5\n7 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"13\n1 2\n1 3\n1 4\n2 5\n2 6\n2 7\n3 8\n3 9\n3 10\n4 11\n4 12\n4 13\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"573C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/573/problem/C"}