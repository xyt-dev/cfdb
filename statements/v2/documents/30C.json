{"assets":[],"contentKind":"statement","contestId":"30","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Shooting Gallery"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One warm and sunny day king Copa decided to visit the shooting gallery, located at the Central Park, and try to win the main prize — big pink plush panda. The king is not good at shooting, so he invited you to help him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The shooting gallery is an infinite vertical plane with Cartesian coordinate system on it. The targets are points on this plane. Each target is described by it's coordinates "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":", by the time of it's appearance "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" and by the number "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":", which gives the probability that Copa hits this target if he aims at it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A target appears and disappears instantly, so Copa can hit the target only if at the moment "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" his gun sight aimed at "},{"kind":"math_inline","text":"(xi, yi)"},{"kind":"text","text":". Speed of movement of the gun sight on the plane is equal to 1. Copa knows all the information about the targets beforehand (remember, he is a king!). He wants to play in the optimal way, which maximizes the expected value of the amount of hit targets. He can aim at any target at the moment 0."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":") — amount of targets in the shooting gallery. Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, each describing one target. Each description consists of four numbers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" (where "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" — integers, "},{"kind":"math_inline","text":" - 1000 ≤ xi, yi ≤ 1000, 0 ≤ ti ≤ 109"},{"kind":"text","text":", real number "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" is given with no more than 6 digits after the decimal point, "},{"kind":"math_inline","text":"0 ≤ pi ≤ 1"},{"kind":"text","text":"). No two targets may be at the same point."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the maximum expected value of the amount of targets that was shot by the king. Your answer will be accepted if it differs from the correct answer by not more than "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n0 0 0 0.5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.5000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n0 0 0 0.6\n5 0 5 0.7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.3000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"30C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/30/problem/C"}