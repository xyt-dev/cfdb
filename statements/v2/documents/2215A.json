{"assets":[],"contentKind":"statement","contestId":"2215","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Interval Mod"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array $$$a$$$ consisting of $$$n$$$ integers, as well as a parameter $$$k$$$ and an integer set $$$M=\\{p, q\\}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can perform the following operation on $$$a$$$ an arbitrary number of times (possibly zero):"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" First, choose an interval $$$[l,r]$$$ ($$$1 \\le l \\le r \\le n$$$) of length "},{"children":[{"kind":"text","text":"at least"}],"kind":"container"},{"kind":"text","text":" $$$k$$$ (i.e., $$$r-l+1\\ge k$$$) and an integer $$$m \\in M$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then, set $$$a_i \\gets a_i \\bmod m$$$ for each $$$l \\le i \\le r$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You have to find the minimum possible value of $$$\\sum \\limits_{i=1}^n a_i$$$ after all operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains four integers $$$n$$$, $$$k$$$, $$$p$$$, and $$$q$$$ ($$$1\\le k\\le n\\le 10^5$$$, $$$1\\le p \\lt q\\le 10^9$$$) — the length of $$$a$$$, the parameter, and the elements of $$$M$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1\\le a_i\\le 10^9$$$) — the elements of $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$10^5$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the minimum possible value of $$$\\sum \\limits_{i=1}^n a_i$$$ after all operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 1 3 4\n2026\n3 2 10 20\n31 41 59\n4 3 3 4\n1 2 3 4\n6 4 9 20\n18 27 180 9 45 99\n7 4 3 5\n6 7 14 12 100 78 4\n9 4 244 353\n9982 4435 3998 2443 5399 8244 3539 9824 4353\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n11\n3\n0\n4\n569\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second test case, a possible way to obtain $$$\\sum \\limits_{i=1}^n a_i=11$$$ is to apply the following operation to $$$a$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Choose $$$[l,r]=[1,3]$$$ and $$$m=10$$$, then $$$a$$$ becomes $$$[1,1,9]$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the third test case, a possible way to obtain $$$\\sum \\limits_{i=1}^n a_i=3$$$ is to apply the following operations to $$$a$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Choose $$$[l,r]=[1,4]$$$ and $$$m=4$$$, then $$$a$$$ becomes $$$[1,2,3,0]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Choose $$$[l,r]=[2,4]$$$ and $$$m=3$$$, then $$$a$$$ becomes $$$[1,2,0,0]$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2215A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2215/problem/A"}