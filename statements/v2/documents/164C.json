{"assets":[],"contentKind":"statement","contestId":"164","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Machine Programming"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One remarkable day company \"X\" received "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" machines. And they were not simple machines, they were mechanical programmers! This was the last unsuccessful step before switching to android programmers, but that's another story."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The company has now "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" tasks, for each of them we know the start time of its execution "},{"kind":"math_inline","text":"si"},{"kind":"text","text":", the duration of its execution "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", and the company profit from its completion "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":". Any machine can perform any task, exactly one at a time. If a machine has started to perform the task, it is busy at all moments of time from "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"si + ti - 1"},{"kind":"text","text":", inclusive, and it cannot switch to another task."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are required to select a set of tasks which can be done with these "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" machines, and which will bring the maximum total profit."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 50"},{"kind":"text","text":") — the numbers of tasks and machines, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain space-separated groups of three integers "},{"kind":"math_inline","text":"si, ti, ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ si, ti ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ci ≤ 106"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" is the time where they start executing the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th task, "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" is the duration of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th task and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" is the profit of its execution."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":". Number "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" should equal "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", if task "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" should be completed and otherwise it should equal "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several optimal solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n2 7 5\n1 3 3\n4 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 1 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n1 5 4\n1 4 5\n1 3 2\n4 1 2\n5 6 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1 0 0 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the tasks need to be executed at moments of time 2 ... 8, 1 ... 3 and 4 ... 4, correspondingly. The first task overlaps with the second and the third ones, so we can execute either task one (profit 5) or tasks two and three (profit 6)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"164C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/164/problem/C"}