{"assets":[],"contentKind":"statement","contestId":"508","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Arthur and Brackets"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"128 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Notice that the memory limit is non-standard."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Recently Arthur and Sasha have studied correct bracket sequences. Arthur understood this topic perfectly and become so amazed about correct bracket sequences, so he even got himself a favorite correct bracket sequence of length "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":". Unlike Arthur, Sasha understood the topic very badly, and broke Arthur's favorite correct bracket sequence just to spite him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All Arthur remembers about his favorite sequence is for each opening parenthesis ('"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"') the approximate distance to the corresponding closing one ('"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"'). For the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th opening bracket he remembers the segment "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":", containing the distance to the corresponding closing bracket."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally speaking, for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th opening bracket (in order from left to right) we know that the difference of its position and the position of the corresponding closing bracket belongs to the segment "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Arthur restore his favorite correct bracket sequence!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 600"},{"kind":"text","text":"), the number of opening brackets in Arthur's favorite correct bracket sequence. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain numbers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri < 2n"},{"kind":"text","text":"), representing the segment where lies the distance from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th opening bracket and the corresponding closing one. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The descriptions of the segments are given in the order in which the opening brackets occur in Arthur's favorite sequence if we list them from left to right."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is possible to restore the correct bracket sequence by the given data, print any possible choice."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If Arthur got something wrong, and there are no sequences corresponding to the given information, print a single line \""},{"children":[{"kind":"text","text":"IMPOSSIBLE"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1\n1 1\n1 1\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"()()()()\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n5 5\n3 3\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"((()))\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n5 5\n3 3\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"IMPOSSIBLE\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 3\n1 4\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"chil