{"assets":["/statement-assets/b03950dd7b7ffabd0e590d0bebc789395b52b7e41f1b3ceb68ad2f906751c9b1.png","/statement-assets/c90a273edc8b1769fb44245a1fb2f751cc9c10d11ee5a1970348c753afdd8acb.png"],"contentKind":"statement","contestId":"512","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Fox And Travelling"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Fox Ciel is going to travel to New Foxland during this summer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"New Foxland has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" attractions that are linked by "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" undirected roads. Two attractions are called adjacent if they are linked by a road. Fox Ciel has "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" days to visit this city and each day she will visit exactly one attraction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is one important rule in New Foxland: you can't visit an attraction if it has more than one adjacent attraction that you haven't visited yet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At the beginning Fox Ciel haven't visited any attraction. During her travelling she may move aribtrarly between attraction. After visiting attraction "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", she may travel to "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" attraction "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" satisfying conditions above that hasn't been visited yet, even if it is not reachable from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" by using the roads (Ciel uses boat for travelling between attractions, so it is possible)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":" She wants to know how many different travelling plans she can make. Calculate this number modulo "},{"kind":"math_inline","text":"109 + 9"},{"kind":"text","text":" for every "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" since she hasn't decided for how many days she is visiting New Foxland."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains two integers: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/b03950dd7b7ffabd0e590d0bebc789395b52b7e41f1b3ceb68ad2f906751c9b1.png"},"kind":"image"},{"kind":"text","text":"), the number of attractions and number of undirected roads."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines each contain two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":"), describing a road. There is no more than one road connecting each pair of attractions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"n + 1"},{"kind":"text","text":" integer: the number of possible travelling plans modulo "},{"kind":"math_inline","text":"109 + 9"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n4\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n1 2\n2 3\n3 4\n4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n0\n0\n0\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"12 11\n2 3\n4 7\n4 5\n5 6\n4 6\n6 12\n5 12\n5 8\n8 9\n10 8\n11 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n6\n31\n135\n483\n1380\n3060\n5040\n5040\n0\n0\n0\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"13 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n13\n156\n1716\n17160\n154440\n1235520\n8648640\n51891840\n259459200\n37836791\n113510373\n227020746\n227020746\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test for "},{"kind":"math_inline","text":"k = 3"},{"kind":"text","text":" there are 4 travelling plans: "},{"kind":"math_inline","text":"{1, 2, 3}, {1, 3, 2}, {3, 1, 2}, {3, 2, 1}"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test Ciel can't visit any attraction in the first day, so for "},{"kind":"math_inline","text":"k > 0"},{"kind":"text","text":" the answer is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample test Foxlands look like this:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c90a273edc8b1769fb44245a1fb2f751cc9c10d11ee5a1970348c753afdd8acb.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"512D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/512/problem/D"}