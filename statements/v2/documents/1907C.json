{"assets":[],"contentKind":"statement","contestId":"1907","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Removal of Unattractive Pairs"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vlad found a string $$$s$$$ consisting of $$$n$$$ lowercase Latin letters, and he wants to make it as short as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To do this, he can remove "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" pair of adjacent characters from $$$s$$$ any number of times, provided they are "},{"children":[{"kind":"text","text":"different"}],"kind":"container"},{"kind":"text","text":". For example, if $$$s$$$="},{"children":[{"kind":"text","text":"racoon"}],"kind":"container"},{"kind":"text","text":", then by removing one pair of characters he can obtain the strings "},{"children":[{"kind":"text","text":"coon"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"roon"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"raon"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"raco"}],"kind":"container"},{"kind":"text","text":", but he cannot obtain "},{"children":[{"kind":"text","text":"racn"}],"kind":"container"},{"kind":"text","text":" (because the removed letters were the same) or "},{"children":[{"kind":"text","text":"rcon"}],"kind":"container"},{"kind":"text","text":" (because the removed letters were not adjacent)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum length Vlad can achieve by applying any number of deletions?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. Descriptions of the test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the length of the string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains the string $$$s$$$ consisting of $$$n$$$ lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single number—the minimum length of the string $$$s$$$, after removing pairs of adjacent characters with different values."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n4\naabc\n5\nabaca\n10\navbvvcvvvd\n7\nabcdefg\n5\ndabbb\n8\naacebeaa\n7\nbbbbacc\n6\ndacfcc\n6\nfdfcdc\n9\ndbdcfbbdc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n1\n2\n1\n1\n0\n1\n0\n0\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case of the example, you need to act as follows: \""},{"children":[{"kind":"text","text":"aabc"}],"kind":"container"},{"kind":"text","text":"\" $$$\\rightarrow$$$ \""},{"children":[{"kind":"text","text":"ac"}],"kind":"container"},{"kind":"text","text":"\" $$$\\rightarrow$$$ \"\". Note that with a different order of deletions, the string will not become empty."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1907C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1907/problem/C"}