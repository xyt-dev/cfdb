{"assets":[],"contentKind":"statement","contestId":"935","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Fafa and Ancient Mathematics"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ancient Egyptians are known to have understood difficult concepts in mathematics. The ancient Egyptian mathematician Ahmes liked to write a kind of arithmetic expressions on papyrus paper which he called as "},{"children":[{"kind":"text","text":"Ahmes arithmetic expression"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An "},{"children":[{"kind":"text","text":"Ahmes arithmetic expression"}],"kind":"container"},{"kind":"text","text":" can be defined as: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"kind":"math_inline","text":"d"},{"kind":"text","text":"\" is an Ahmes arithmetic expression, where "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" is a one-digit positive integer; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"kind":"math_inline","text":"(E1 op E2)"},{"kind":"text","text":"\" is an Ahmes arithmetic expression, where "},{"kind":"math_inline","text":"E1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"E2"},{"kind":"text","text":" are valid Ahmes arithmetic expressions (without spaces) and "},{"kind":"math_inline","text":"op"},{"kind":"text","text":" is either plus "},{"kind":"math_inline","text":"( + )"},{"kind":"text","text":" or minus "},{"kind":"math_inline","text":"( - )"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" For example "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"(1-1)"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"((1+(2-3))-5)"}],"kind":"container"},{"kind":"text","text":" are valid Ahmes arithmetic expressions."},{"children":[{"kind":"text","text":"On his trip to Egypt, Fafa found a piece of papyrus paper having one of these Ahmes arithmetic expressions written on it. Being very ancient, the papyrus piece was very worn out. As a result, all the operators were erased, keeping only the numbers and the brackets. Since Fafa loves mathematics, he decided to challenge himself with the following task:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the number of plus and minus operators in the original expression, find out the maximum possible value for the expression on the papyrus paper after putting the plus and minus operators in the place of the original erased operators."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a string "},{"kind":"math_inline","text":"E"},{"kind":"math_inline","text":"(1 ≤ |E| ≤ 104)"},{"kind":"text","text":" — a valid Ahmes arithmetic expression. All operators are erased and replaced with '"},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains two space-separated integers "},{"kind":"math_inline","text":"P"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ min(P, M) ≤ 100"},{"kind":"text","text":") — the number of plus and minus operators, respectively. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that "},{"kind":"math_inline","text":"P + M = "},{"kind":"text","text":" the number of erased operators."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one line containing the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"(1?1)\n1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"(2?(1?2))\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"((1?(5?7))?((6?2)?7))\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"18\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"((1?(5?7))?((6?2)?7))\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"16\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The first sample will be "},{"kind":"math_inline","text":"(1 + 1)  =  2"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The second sample will be "},{"kind":"math_inline","text":"(2 + (1 - 2))  =  1"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The third sample will be "},{"kind":"math_inline","text":"((1 - (5 - 7)) + ((6 + 2) + 7))  =  18"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The fourth sample will be "},{"kind":"math_inline","text":"((1 + (5 + 7)) - ((6 - 2) - 7))  =  16"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"935E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/935/problem/E"}