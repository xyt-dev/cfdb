{"assets":[],"contentKind":"statement","contestId":"1690","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Black and White Stripe"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a stripe of checkered paper of length $$$n$$$. Each cell is either white or black."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of cells that must be recolored from white to black in order to have a segment of $$$k$$$ consecutive black cells on the stripe?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the input data is such that a segment of $$$k$$$ consecutive black cells already exists, then print "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next, descriptions of $$$t$$$ test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of the input contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\le k \\le n \\le 2\\cdot10^5$$$). The second line consists of the letters '"},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"' (white) and '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' (black). The line length is $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of values $$$n$$$ does not exceed $$$2\\cdot10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each of $$$t$$$ test cases print an integer — the minimum number of cells that need to be repainted from white to black in order to have a segment of $$$k$$$ consecutive black cells."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n5 3\nBBWBW\n5 5\nBBWBW\n5 1\nBBWBW\n1 1\nW\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2\n0\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, $$$s$$$=\""},{"children":[{"kind":"text","text":"BBWBW"}],"kind":"container"},{"kind":"text","text":"\" and $$$k=3$$$. It is enough to recolor $$$s_3$$$ and get $$$s$$$=\""},{"children":[{"kind":"text","text":"BBBBW"}],"kind":"container"},{"kind":"text","text":"\". This string contains a segment of length $$$k=3$$$ consisting of the letters '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case of the example $$$s$$$=\""},{"children":[{"kind":"text","text":"BBWBW"}],"kind":"container"},{"kind":"text","text":"\" and $$$k=5$$$. It is enough to recolor $$$s_3$$$ and $$$s_5$$$ and get $$$s$$$=\""},{"children":[{"kind":"text","text":"BBBBB"}],"kind":"container"},{"kind":"text","text":"\". This string contains a segment of length $$$k=5$$$ consisting of the letters '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case of the example $$$s$$$=\""},{"children":[{"kind":"text","text":"BBWBW"}],"kind":"container"},{"kind":"text","text":"\" and $$$k=1$$$. The string $$$s$$$ already contains a segment of length $$$k=1$$$ consisting of the letters '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1690D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1690/problem/D"}