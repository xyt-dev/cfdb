{"assets":[],"contentKind":"statement","contestId":"625","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. K-special Tables"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"People do many crazy things to stand out in a crowd. Some of them dance, some learn by heart rules of Russian language, some try to become an outstanding competitive programmers, while others collect funny math objects."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Alis is among these collectors. Right now she wants to get one of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-special tables. In case you forget, the table "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" is called "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-special if the following three conditions are satisfied:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" every integer from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n2"},{"kind":"text","text":" appears in the table exactly once; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" in each row numbers are situated in increasing order; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the sum of numbers in the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th column is maximum possible. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your goal is to help Alice and find at least one "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-special table of size "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":". Both rows and columns are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", with rows numbered from top to bottom and columns numbered from left to right."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 500, 1 ≤ k ≤ n"},{"kind":"text","text":") — the size of the table Alice is looking for and the column that should have maximum possible sum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"First print the sum of the integers in the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th column of the required table."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines should contain the description of the table itself: first line should contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" elements of the first row, second line should contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" elements of the second row and so on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple suitable table, you are allowed to print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"att