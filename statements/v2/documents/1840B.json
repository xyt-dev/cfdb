{"assets":[],"contentKind":"statement","contestId":"1840","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Binary Cafe"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Once upon a time, Toma found himself in a binary cafe. It is a very popular and unusual place."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The cafe offers visitors $$$k$$$ different delicious desserts. The desserts are numbered from $$$0$$$ to $$$k-1$$$. The cost of the $$$i$$$-th dessert is $$$2^i$$$ coins, because it is a binary cafe! Toma is willing to spend no more than $$$n$$$ coins on tasting desserts. At the same time, he is not interested in buying any dessert more than once, because one is enough to evaluate the taste."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In how many different ways can he buy several desserts "},{"children":[{"kind":"text","text":"(possibly zero)"}],"kind":"container"},{"kind":"text","text":" for tasting?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follows $$$t$$$ lines, each of which describes one test case."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case is given on a single line and consists of two integers $$$n$$$ and $$$k$$$ ($$$1 \\le n, k \\le 10^9$$$) — the number of coins Toma is willing to spend and the number of desserts in the binary cafe."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output $$$t$$$ integers, the $$$i$$$-th of which should be equal to the answer for the $$$i$$$-th test case — the number of ways to buy desserts for tasting."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 2\n2 1\n2 2\n10 2\n179 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n2\n3\n4\n180\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Variants for 1st sample: {}, {1}"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Variants for 2nd sample: {}, {1}"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Variants for 3rd sample: {}, {1}, {2}"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Variants for 4th sample: {}, {1}, {2}, {1, 2}"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1840B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1840/problem/B"}