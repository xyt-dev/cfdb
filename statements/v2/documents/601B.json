"text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A function "},{"attrs":{"alt":"","src":"/statement-assets/272c142d7387d5800a2c881b17a2dd4a0bd85404c2d078575c7110954c35977c.png"},"kind":"image"},{"kind":"text","text":" is called Lipschitz continuous if there is a real constant "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" such that the inequality "},{"kind":"math_inline","text":"|f(x) - f(y)| ≤ K·|x - y|"},{"kind":"text","text":" holds for all "},{"attrs":{"alt":"","src":"/statement-assets/2a41e82161189e28f77c000ffd090eb443c1d38999e00b97c8131c8b18759c44.png"},"kind":"image"},{"kind":"text","text":". We'll deal with a more... discrete version of this term."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For an array "},{"attrs":{"alt":"","src":"/statement-assets/7badd9ca643e66fed732adea986344e37c2043a89cf8e6a6213796c10bcf679e.png"},"kind":"image"},{"kind":"text","text":", we define it's Lipschitz constant "},{"attrs":{"alt":"","src":"/statement-assets/46dbe73b33f1bbaaeace7b19b59b148d6cccc8674afa98d54adc507701cc7651.png"},"kind":"image"},{"kind":"text","text":" as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if "},{"kind":"math_inline","text":"n < 2"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/62d856e949896edc153fa5f69a0386560e88d1e347c33321f259f265d8a28eb4.png"},"kind":"image"}],"kind":"list_item"},{"children":[{"kind":"text","text":" if "},{"kind":"math_inline","text":"n ≥ 2"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/accaf0e9f29e6248346a6bb882dd10a6bc87b1242b5665096725dc6bc1f0d95a.png"},"kind":"image"},{"kind":"text","text":" over all "},{"kind":"math_inline","text":"1 ≤ i < j ≤ n"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In other words, "},{"attrs":{"alt":"","src":"/statement-assets/f15e79fbe59522f6a87903eed1d8e84e039514efdf2a9afabd674e63ba463165.png"},"kind":"image"},{"kind":"text","text":" is the smallest non-negative integer such that "},{"kind":"math_inline","text":"|h[i] - h[j]| ≤ L·|i - j|"},{"kind":"text","text":" holds for all "},{"kind":"math_inline","text":"1 ≤ i, j ≤ n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array "},{"attrs":{"alt":"","src":"/statement-assets/2ee78979d2ef2335332d2c87bfa6af27174e9d824d9d23800901db7ff0bc5f85.png"},"kind":"image"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries of the form "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":". For each query, consider the subarray "},{"attrs":{"alt":"","src":"/statement-assets/b858945e59e0904db67510b68fc3bf6f0532f27bc23eca296b204c2fd48894ca.png"},"kind":"image"},{"kind":"text","text":"; determine the sum of Lipschitz constants of "},{"children":[{"kind":"text","text":"all subarrays"}],"kind":"container"},{"kind":"text","text":" of "},{"attrs":{"alt":"","src":"/statement-assets/46b13872c85a17d690929aa4e0eafb856e0afaa57321cb7c3bd6f3c28724c5cc.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100 000"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 ≤ q ≤ 100"},{"kind":"text","text":") — the number of elements in array "},{"attrs":{"alt":"","src":"/statement-assets/2ee78979d2