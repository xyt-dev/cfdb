{"assets":[],"contentKind":"statement","contestId":"940","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Points on the line"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"We've got no test cases. A big olympiad is coming up. But the problemsetters' number one priority should be adding another problem to the round."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"diameter"}],"kind":"container"},{"kind":"text","text":" of a multiset of points on the line is the largest distance between two points from this set. For example, the diameter of the multiset "},{"kind":"math_inline","text":"{1, 3, 2, 1}"},{"kind":"text","text":" is 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Diameter of multiset consisting of one point is 0."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" points on the line. What is the minimum number of points you have to remove, so that the diameter of the multiset of the remaining points will not exceed "},{"kind":"math_inline","text":"d"},{"kind":"text","text":"?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100, 0 ≤ d ≤ 100"},{"kind":"text","text":") — the amount of points and the maximum allowed diameter respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space separated integers ("},{"kind":"math_inline","text":"1 ≤ xi ≤ 100"},{"kind":"text","text":") — the coordinates of the points."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the minimum number of points you have to remove."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n2 1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 0\n7 7 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3\n1 3 4 6 9 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case the optimal strategy is to remove the point with coordinate "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". The remaining points will have coordinates "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", so the diameter will be equal to "},{"kind":"math_inline","text":"2 - 1 = 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case the diameter is equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", so its is unnecessary to remove any points. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case the optimal strategy is to remove points with coordinates "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"10"},{"kind":"text","text":". The remaining points will have coordinates "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"6"},{"kind":"text","text":", so the diameter will be equal to "},{"kind":"math_inline","text":"6 - 3 = 3"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"940A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/940/problem/A"}