{"assets":[],"contentKind":"statement","contestId":"1431","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Number Deletion Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Alice and Bob play a game. They have a set that initially consists of $$$n$$$ integers. The game is played in $$$k$$$ turns. During each turn, the following events happen:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" firstly, Alice chooses an integer from the set. She can choose any integer "},{"children":[{"kind":"text","text":"except for the maximum one"}],"kind":"container"},{"kind":"text","text":". Let the integer chosen by Alice be $$$a$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" secondly, Bob chooses an integer from the set. He can choose any integer "},{"children":[{"kind":"text","text":"that is greater than $$$a$$$"}],"kind":"container"},{"kind":"text","text":". Let the integer chosen by Bob be $$$b$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" finally, both $$$a$$$ and $$$b$$$ are erased from the set, and the value of $$$b - a$$$ is added to the score of the game. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Initially, the score is $$$0$$$. Alice wants to maximize the resulting score, Bob wants to minimize it. Assuming that both Alice and Bob play optimally, calculate the resulting score of the game."}],"kind":"paragraph"}],"kind":"section"},{