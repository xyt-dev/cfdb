{"assets":[],"contentKind":"statement","contestId":"677","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Vanya and Balloons"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vanya plays a game of balloons on the field of size "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":", where each cell contains a balloon with one of the values "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". The goal is to destroy a cross, such that the product of all values of balloons in the cross is maximum possible. There are two types of crosses: normal and rotated. For example:"}],"kind":"paragraph"},{"kind":"code_block","text":"\n**o**\n**o**\nooooo\n**o**\n**o**\n"},{"children":[{"kind":"text","text":"or"}],"kind":"paragraph"},{"kind":"code_block","text":"\no***o\n*o*o*\n**o**\n*o*o*\no***o\n"},{"children":[{"kind":"text","text":"Formally, the cross is given by three integers "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"d ≤ r, c ≤ n - d + 1"},{"kind":"text","text":". The normal cross consists of balloons located in cells "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" (where "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" stay for the number of the row and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" for the number of the column), such that "},{"kind":"math_inline","text":"|x - r|·|y - c| = 0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"|x - r| + |y - c| < d"},{"kind":"text","text":". Rotated cross consists of balloons located in cells "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"|x - r| = |y - c|"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"|x - r| < d"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vanya wants to know the maximum possible product of the values of balls forming one cross. As this value can be large, output it modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":") — the number of rows and columns in the table with balloons."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"3"}],"kind":"container"},{"kind":"text","text":"' — the description of the values in balloons."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum possible product modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":". Note, that you are not asked to maximize the remainder modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":", but to find the maximum value and print it this modulo."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1233\n0213\n2020\n0303\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"108\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n00300\n00300\n33333\n00300\n00300\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"19683\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n00003\n02030\n00300\n03020\n30000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kin