{"assets":[],"contentKind":"statement","contestId":"789","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Masha and geometric depression"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Masha really loves algebra. On the last lesson, her strict teacher Dvastan gave she new exercise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given geometric progression "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" defined by two integers "},{"kind":"math_inline","text":"b1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":". Remind that a geometric progression is a sequence of integers "},{"kind":"math_inline","text":"b1, b2, b3, ..."},{"kind":"text","text":", where for each "},{"kind":"math_inline","text":"i > 1"},{"kind":"text","text":" the respective term satisfies the condition "},{"kind":"math_inline","text":"bi = bi - 1·q"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" is called the common ratio of the progression. Progressions in Uzhlyandia are unusual: both "},{"kind":"math_inline","text":"b1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"children":[{"kind":"text","text":"can equal "},{"kind":"math_inline","text":"0"}],"kind":"container"},{"kind":"text","text":". Also, Dvastan gave Masha "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" \"bad\" integers "},{"kind":"math_inline","text":"a1, a2, ..., am"},{"kind":"text","text":", and an integer "},{"kind":"math_inline","text":"l"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Masha writes all progression terms one by one onto the board (including repetitive) while condition "},{"kind":"math_inline","text":"|bi| ≤ l"},{"kind":"text","text":" is satisfied ("},{"kind":"math_inline","text":"|x|"},{"kind":"text","text":" means absolute value of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"). There is an exception: if a term equals one of the \"bad\" integers, Masha skips it (doesn't write onto the board) and moves forward to the next term."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But the lesson is going to end soon, so Masha has to calculate how many integers will be written on the board. In order not to get into depression, Masha asked you for help: help her calculate how many numbers she will write, or print \""},{"children":[{"kind":"text","text":"inf"}],"kind":"container"},{"kind":"text","text":"\" in case she needs to write infinitely many integers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains four integers "},{"kind":"math_inline","text":"b1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"q"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" (-"},{"kind":"math_inline","text":"109 ≤ b1, q ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ l ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":") — the initial term and the common ratio of progression, absolute value of maximal number that can be written on the board and the number of \"bad\" integers, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"a1, a2, ..., am"},{"kind":"text","text":" (-"},{"kind":"math_inline","text":"109 ≤ ai ≤ 109)"},{"kind":"text","text":" — numbers that will never be written on the board."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer, meaning the number of progression terms that will be written on the board if it is finite, or \""},{"children":[{"kind":"text","text":"inf"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 30 4\n6 14 25 48\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"123 1 2143435 4\n123 11 -5453 141245\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"123 1 2143435 4\n54343 -13 6 124\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"inf"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case, Masha will write integers "},{"kind":"math_inline","text":"3, 12, 24"},{"kind":"text","text":". Progression term "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" will be skipped because it is a \"bad\" integer. Terms bigger than "},{"kind":"math_inline","text":"24"},{"kind":"text","text":" won't be written because they exceed "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" by absolute value."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second case, Masha won't write any number because all terms are equal "},{"kind":"math_inline","text":"123"},{"kind":"text","text":" and this is a \"bad\" integer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third case, Masha will write infinitely integers "},{"kind":"math_inline","text":"123"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"789B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/789/problem/B"}