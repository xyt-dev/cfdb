{"assets":[],"contentKind":"statement","contestId":"1913","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Array Collapse"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array $$$[p_1, p_2, \\dots, p_n]$$$, where all elements are distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can perform several (possibly zero) operations with it. In one operation, you can choose a "},{"children":[{"kind":"text","text":"contiguous subsegment"}],"kind":"container"},{"kind":"text","text":" of $$$p$$$ and remove "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" elements from that subsegment, "},{"children":[{"kind":"text","text":"except for"}],"kind":"container"},{"kind":"text","text":" the minimum element on that subsegment. For example, if $$$p = [3, 1, 4, 7, 5, 2, 6]$$$ and you choose the subsegment from the $$$3$$$-rd element to the $$$6$$$-th element, the resulting array is $$$[3, 1, 2, 6]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An array $$$a$$$ is called "},{"children":[{"kind":"text","text":"reachable"}],"kind":"container"},{"kind":"text","text":" if it can be obtained from $$$p$$$ using several (maybe zero) aforementioned operations. Calculate the number of "},{"children":[{"kind":"text","text":"reachable"}],"kind":"container"},{"kind":"text","text":" arrays, and print it modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two lines. The first line contains one integer $$$n$$$ ($$$1 \\le n \\le 3 \\cdot 10^5$$$). The second line contains $$$n$$$ "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" integers $$$p_1, p_2, \\dots, p_n$$$ ($$$1 \\le p_i \\le 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraint on the input: the sum of $$$n$$$ over all test cases does not exceed $$$3 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer — the number of "},{"children":[{"kind":"text","text":"reachable"}],"kind":"container"},{"kind":"text","text":" arrays, taken modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2\n2 1\n4\n2 4 1 3\n5\n10 2 6 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n6\n12\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1913D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1913/problem/D"}