{"assets":["/statement-assets/b8a9aaafc1ee32727053df2b98574b5f9612a48a914106746c5e8f097100d214.png"],"contentKind":"statement","contestId":"985","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Liebig's Barrels"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have "},{"kind":"math_inline","text":"m = n·k"},{"kind":"text","text":" wooden staves. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th stave has length "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". You have to assemble "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" barrels consisting of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" staves each, you can use any "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" staves to construct a barrel. Each stave must belong to exactly one barrel."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let volume "},{"kind":"math_inline","text":"vj"},{"kind":"text","text":" of barrel "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" be equal to the length of the "},{"children":[{"kind":"text","text":"minimal"}],"kind":"container"},{"kind":"text","text":" stave in it."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b8a9aaafc1ee32727053df2b98574b5f9612a48a914106746c5e8f097100d214.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"You want to assemble exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" barrels with the maximal total sum of volumes. But you have to make them "},{"children":[{"kind":"text","text":"equal enough"}],"kind":"container"},{"kind":"text","text":", so a difference between volumes of any pair of the resulting barrels must not exceed "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", i.e. "},{"kind":"math_inline","text":"|vx - vy| ≤ l"},{"kind":"text","text":" for any "},{"kind":"math_inline","text":"1 ≤ x ≤ n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 ≤ y ≤ n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print maximal total sum of volumes of "},{"children":[{"kind":"text","text":"equal enough"}],"kind":"container"},{"kind":"text","text":" barrels or "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" if it's impossible to satisfy the condition above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, k ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ n·k ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ l ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"m = n·k"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., am"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — lengths of staves."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print single integer — maximal total sum of the volumes of barrels or "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" if it's impossible to construct exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" barrels satisfying the condition "},{"kind":"math_inline","text":"|vx - vy| ≤ l"},{"kind":"text","text":" for any "},{"kind":"math_inline","text":"1 ≤ x ≤ n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 ≤ y ≤ n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 1\n2 2 1 2 3 2 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 0\n10 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2 1\n5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 1\n1 2 3 4 5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example you can form the following barrels: "},{"kind":"math_inline","text":"[1, 2]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"[2, 2]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"[2, 3]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"[2, 3]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example you can form the following barrels: "},{"kind":"math_inline","text":"[10]"},{"kind":"text","text":", "},{"kind":"math_inline","text":"[10]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example you can form the following barrels: "},{"kind":"math_inline","text":"[2, 5]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example difference between volumes of barrels in any partition is at least "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" so it is impossible to make barrels equal enough."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"985C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/985/problem/C"}