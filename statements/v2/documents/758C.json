{"assets":[],"contentKind":"statement","contestId":"758","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Unfair Poll"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"On the Literature lesson Sergei noticed an awful injustice, it seems that some students are asked more often than others."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Seating in the class looks like a rectangle, where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows with "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" pupils in each. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The teacher asks pupils in the following order: at first, she asks all pupils from the first row in the order of their seating, then she continues to ask pupils from the next row. If the teacher asked the last row, then the direction of the poll changes, it means that she asks the previous row. The order of asking the rows looks as follows: the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st row, the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd row, "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", the "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":"-st row, the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th row, the "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":"-st row, "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd row, the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st row, the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd row, "},{"kind":"math_inline","text":"..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The order of asking of pupils on the same row is always the same: the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st pupil, the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd pupil, "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", the "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-th pupil."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During the lesson the teacher managed to ask exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" questions from pupils in order described above. Sergei seats on the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-th row, on the "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"-th place in the row. Sergei decided to prove to the teacher that pupils are asked irregularly, help him count three values:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" the maximum number of questions a particular pupil is asked, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the minimum number of questions a particular pupil is asked, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" how many times the teacher asked Sergei. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there is only one row in the class, then the teacher always asks children from this row."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and the only line contains five integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100, 1 ≤ k ≤ 1018, 1 ≤ x ≤ n, 1 ≤ y ≤ m"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print three integers:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" the maximum number of questions a particular pupil is asked, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the minimum number of questions a particular pupil is asked, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" how many times the teacher asked Sergei. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 3 8 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 2 3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 9 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"co