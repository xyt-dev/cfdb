{"assets":[],"contentKind":"statement","contestId":"1342","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Binary Period"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's say string $$$s$$$ has period $$$k$$$ if $$$s_i = s_{i + k}$$$ for all $$$i$$$ from $$$1$$$ to $$$|s| - k$$$ ($$$|s|$$$ means length of string $$$s$$$) and $$$k$$$ is the minimum positive integer with this property."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some examples of a period: for $$$s$$$=\""},{"children":[{"kind":"text","text":"0101"}],"kind":"container"},{"kind":"text","text":"\" the period is $$$k=2$$$, for $$$s$$$=\""},{"children":[{"kind":"text","text":"0000"}],"kind":"container"},{"kind":"text","text":"\" the period is $$$k=1$$$, for $$$s$$$=\""},{"children":[{"kind":"text","text":"010"}],"kind":"container"},{"kind":"text","text":"\" the period is $$$k=2$$$, for $$$s$$$=\""},{"children":[{"kind":"text","text":"0011"}],"kind":"container"},{"kind":"text","text":"\" the period is $$$k=4$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given string $$$t$$$ consisting only of "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"'s and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"'s and you need to find such string $$$s$$$ that:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" String $$$s$$$ consists only of "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"'s and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"'s; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The length of $$$s$$$ doesn't exceed $$$2 \\cdot |t|$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" String $$$t$$$ is a subsequence of string $$$s$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" String $$$s$$$ has smallest possible period among all strings that meet conditions 1—3. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let us recall that $$$t$$$ is a subsequence of $$$s$$$ if $$$t$$$ can be derived from $$$s$$$ by deleting zero or more elements (any) without changing the order of the remaining elements. For example, $$$t$$$=\""},{"children":[{"kind":"text","text":"011"}],"kind":"container"},{"kind":"text","text":"\" is a subsequence of $$$s$$$=\""},{"children":[{"kind":"text","text":"10101"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer $$$T$$$ ($$$1 \\le T \\le 100$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$T$$$ lines contain test cases — one per line. Each line contains string $$$t$$$ ($$$1 \\le |t| \\le 100$$$) consisting only of "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"'s and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"'s."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one string for each test case — string $$$s$$$ you needed to find. If there are multiple solutions print any one of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n00\n01\n111\n110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n00\n01\n11111\n1010"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first and second test cases, $$$s = t$$$ since it's already one of the optimal solutions. Answers have periods equal to $$$1$$$ and $$$2$$$, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, there are shorter optimal solutions, but it's okay since we don't need to minimize the string $$$s$$$. String $$$s$$$ has period equal to $$$1$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1342B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1342/problem/B"}