— the number defining the masses of the weights and the mass of the item."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print word '"},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"' if the item can be weighted and '"},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"' if it cannot."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"100 99\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"100 50\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Note to the first sample test. One pan can have an item of mass "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" and a weight of mass "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", and the second pan can have two weights of masses "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", correspondingly. Then "},{"kind":"math_inline","text":"7 + 3 = 9 + 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note to the second sample test. One pan of the scales can have an item of mass "},{"kind":"math_inline","text":"99"},{"kind":"text","text":" and the weight of mass "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", and the second pan can have the weight of mass "},{"kind":"math_inline","text":"100"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note to the third sample test. It is impossible to measure the weight of the item in the manner described in the input. "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"552C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/552/problem/C"}