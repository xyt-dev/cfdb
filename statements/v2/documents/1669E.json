{"assets":[],"contentKind":"statement","contestId":"1669","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. 2-Letter Strings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Given $$$n$$$ strings, each of length $$$2$$$, consisting of lowercase Latin alphabet letters "},{"children":[{"kind":"text","text":"from '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"k"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":"', output the number of pairs of indices $$$(i, j)$$$ such that $$$i \\lt j$$$ and the $$$i$$$-th string and the $$$j$$$-th string differ in exactly one position."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In other words, count the number of pairs $$$(i, j)$$$ ($$$i \\lt j$$$) such that the $$$i$$$-th string and the $$$j$$$-th string have "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" one position $$$p$$$ ($$$1 \\leq p \\leq 2$$$) such that $$${s_{i}}_{p} \\neq {s_{j}}_{p}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer may not fit into 32-bit integer type, so you should use 64-bit integers like "},{"children":[{"kind":"text","text":"long long"}],"kind":"container"},{"kind":"text","text":" in C++ to avoid integer overflow."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer $$$t$$$ ($$$1 \\le t \\le 100$$$) — the number of test cases. The description of test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 10^5$$$) — the number of strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follows $$$n$$$ lines, the $$$i$$$-th of which containing a single string $$$s_i$$$ of length $$$2$$$, consisting of lowercase Latin letters "},{"children":[{"kind":"text","text":"from '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"k"}],"kind":"container"},{"kind":"text","text":"'"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single integer — the number of pairs $$$(i, j)$$$ ($$$i \\lt j$$$) such that the $$$i$$$-th string and the $$$j$$$-th string have "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" one position $$$p$$$ ($$$1 \\leq p \\leq 2$$$) such that $$${s_{i}}_{p} \\neq {s_{j}}_{p}$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please note, that the answer for some test cases won't fit into 32-bit integer type, so you should use at least 64-bit integer type in your programming language (like "},{"children":[{"kind":"text","text":"long long"}],"kind":"container"},{"kind":"text","text":" for C++)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind"