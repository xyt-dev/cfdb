{"assets":[],"contentKind":"statement","contestId":"39","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"K. Testing"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You take part in the testing of new weapon. For the testing a polygon was created. The polygon is a rectangular field "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" in size, divided into unit squares "},{"kind":"math_inline","text":"1 × 1"},{"kind":"text","text":" in size. The polygon contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" objects, each of which is a rectangle with sides, parallel to the polygon sides and entirely occupying several unit squares. The objects don't intersect and don't touch each other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The principle according to which the weapon works is highly secret. You only know that one can use it to strike any rectangular area whose area is not equal to zero with sides, parallel to the sides of the polygon. The area must completely cover some of the unit squares into which the polygon is divided and it must not touch the other squares. Of course the area mustn't cross the polygon border. Your task is as follows: you should hit no less than one and no more than three rectangular objects. Each object must either lay completely inside the area (in that case it is considered to be hit), or lay completely outside the area."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the number of ways of hitting."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line has three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" и "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 90"},{"kind":"text","text":") — the sizes of the polygon and the number of objects on it respectively. Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" symbols each and describe the polygon. The symbol \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\" stands for a square occupied an object, whereas the symbol \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" stands for an empty space. The symbols \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\" form exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" rectangular connected areas that meet the requirements of the task."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single number — the number of different ways to hit a target."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 3\n*.*\n...\n*..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"21\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5 4\n.*.**\n...**\n**...\n...**\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"38\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 1\n.*\n..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"K","problemCode":"39K","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/39/problem/K"}