{"assets":[],"contentKind":"statement","contestId":"165","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Compatible Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" are "},{"children":[{"kind":"text","text":"compatible"}],"kind":"container"},{"kind":"text","text":", if the result of their bitwise \"AND\" equals zero, that is, "},{"kind":"math_inline","text":"a"},{"kind":"math_inline","text":"&"},{"kind":"math_inline","text":"b = 0"},{"kind":"text","text":". For example, numbers "},{"kind":"math_inline","text":"90"},{"kind":"math_inline","text":"(10110102)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"36"},{"kind":"math_inline","text":"(1001002)"},{"kind":"text","text":" are compatible, as "},{"kind":"math_inline","text":"10110102"},{"kind":"math_inline","text":"&"},{"kind":"math_inline","text":"1001002 = 02"},{"kind":"text","text":", and numbers "},{"kind":"math_inline","text":"3"},{"kind":"math_inline","text":"(112)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"6"},{"kind":"math_inline","text":"(1102)"},{"kind":"text","text":" are not compatible, as "},{"kind":"math_inline","text":"112"},{"kind":"math_inline","text":"&"},{"kind":"math_inline","text":"1102 = 102"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array of integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". Your task is to find the following for each array element: is this element compatible with some other element from the given array? If the answer to this question is positive, then you also should find any suitable element."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":") — the number of elements in the given array. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 4·106"},{"kind":"text","text":") — the elements of the given array. The numbers in the array can coincide."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ansi"},{"kind":"text","text":". If "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" isn't compatible with any other element of the given array "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"ansi"},{"kind":"text","text":" should be equal to -1. Otherwise "},{"kind":"math_inline","text":"ansi"},{"kind":"text","text":" is any such number, that "},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"&"},{"kind":"math_inline","text":"ansi = 0"},{"kind":"text","text":", and also "},{"kind":"math_inline","text