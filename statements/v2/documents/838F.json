"a"},{"kind":"text","text":" and the jury answer is "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", your answer will be accepted if "},{"attrs":{"alt":"","src":"/statement-assets/1ae22f61db293cf2e07fdc3922dfc629fe50424264f74918ab55686a373077bc.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 200000\n250000 250000 250000 250000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.9000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here, there is equal probability for the bag to contain 0,1,2,3 red balls. Also, it costs 0.2 to draw a ball from the bag."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"838F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/838/problem/F"}