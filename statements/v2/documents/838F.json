{"assets":["/statement-assets/3bd815ce758a7c713b3c4fcaac7d45823fa40446f9bcb4b3d176877879b6c7ed.png","/statement-assets/b7919eacf6e396194d8e84c511ad83afb66449fd816f03a864d8c8cb7dc632b2.png","/statement-assets/1ae22f61db293cf2e07fdc3922dfc629fe50424264f74918ab55686a373077bc.png"],"contentKind":"statement","contestId":"838","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Expected Earnings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are playing a game with a bag of red and black balls. Initially, you are told that the bag has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" balls total. In addition, you are also told that the bag has probability "},{"kind":"math_inline","text":"pi / 106"},{"kind":"text","text":" of containing exactly "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" red balls."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You now would like to buy balls from this bag. You really like the color red, so red balls are worth a unit of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", while black balls are worth nothing. To buy a ball, if there are still balls in the bag, you pay a cost "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"0 ≤ c ≤ 1"},{"kind":"text","text":", and draw a ball randomly from the bag. You can choose to stop buying at any point (and you can even choose to not buy anything at all)."}],"kind":"paragraph"},{"chil