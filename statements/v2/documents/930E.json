{"assets":[],"contentKind":"statement","contestId":"930","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Coins Exhibition"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Arkady and Kirill visited an exhibition of rare coins. The coins were located in a row and enumerated from left to right from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", each coin either was laid with its obverse (front) side up, or with its reverse (back) side up."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Arkady and Kirill made some photos of the coins, each photo contained a segment of neighboring coins. Akrady is interested in obverses, so on each photo made by him there is at least one coin with obverse side up. On the contrary, Kirill is interested in reverses, so on each photo made by him there is at least one coin with its reverse side up."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The photos are lost now, but Arkady and Kirill still remember the bounds of the segments of coins each photo contained. Given this information, compute the remainder of division by "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":" of the number of ways to choose the upper side of each coin in such a way, that on each Arkady's photo there is at least one coin with obverse side up, and on each Kirill's photo there is at least one coin with reverse side up."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ n, m ≤ 105"},{"kind":"text","text":") — the total number of coins, the number of photos made by Arkady, and the number of photos made by Kirill, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the descriptions of Arkady's photos, one per line. Each of these lines contains two integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ k"},{"kind":"text","text":"), meaning that among coins from the "},{"kind":"math_inline","text":"l"},{"kind":"text","text":"-th to the "},{"kind":"math_inline","text":"r"},{"kind":"text","text":"-th there should be at least one with obverse side up."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the descriptions of Kirill's photos, one per line. Each of these lines contains two integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ k"},{"kind":"text","text":"), meaning that among coins from the "},{"kind":"math_inline","text":"l"},{"kind":"text","text":"-th to the "},{"kind":"math_inline","text":"r"},{"kind":"text","text":"-th there should be at least one with reverse side up."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only line — the number of ways to choose the side for each coin modulo "},{"kind":"math_inline","text":"109 + 7 = 1000000007"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 2\n1 3\n3 5\n2 2\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3 2\n1 3\n2 2\n3 5\n2 2\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"60 5 7\n1 3\n50 60\n1 60\n30 45\n20 40\n4 5\n6 37\n5 18\n50 55\n22 27\n25 31\n44 45\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"732658600\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the following ways are possible ('"},{"children":[{"kind":"text","text":"O"}],"kind":"container"},{"kind":"text","text":"' — obverse, '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"' — reverse side): "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"OROOR"}],"kind":"container"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"ORORO"}],"kind":"container"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"ORORR"}],"kind":"container"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"RROOR"}],"kind":"container"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"RRORO"}],"kind":"container"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"RRORR"}],"kind":"container"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"ORROR"}],"kind":"container"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"ORRRO"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second example the information is contradictory: the second coin should have obverse and reverse sides up at the same time, that is impossible. So, the answer is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"930E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/930/problem/E"}