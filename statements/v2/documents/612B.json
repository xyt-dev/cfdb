{"assets":[],"contentKind":"statement","contestId":"612","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. HDD is Outdated Technology"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"HDD hard drives group data by sectors. All files are split to fragments and each of them are written in some sector of hard drive. Note the fragments can be written in sectors in arbitrary order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One of the problems of HDD hard drives is the following: the magnetic head should move from one sector to another to read some file."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the time need to read file split to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" fragments. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th sector contains the "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":"-th fragment of the file ("},{"kind":"math_inline","text":"1 ≤ fi ≤ n"},{"kind":"text","text":"). Note different sectors contains the different fragments. At the start the magnetic head is in the position that contains the first fragment. The file are reading in the following manner: at first the first fragment is read, then the magnetic head moves to the sector that contains the second fragment, then the second fragment is read and so on until the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th fragment is read. The fragments are read in the order from the first to the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It takes "},{"kind":"math_inline","text":"|a - b|"},{"kind":"text","text":" time units to move the magnetic head from the sector "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to the sector "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Reading a fragment takes no time."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105"},{"kind":"text","text":") — the number of fragments."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different integers "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ fi ≤ n"},{"kind":"text","text":") — the number of the fragment written in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th sector."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer — the number of time units needed to read the file."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 3 5 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second example the head moves in the following way:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" 1->2 means movement from the sector 1 to the sector 5, i.e. it takes 4 time units "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 2->3 means movement from the sector 5 to the sector 2, i.e. it takes 3 time units "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 3->4 means movement from the sector 2 to the sector 4, i.e. it takes 2 time units "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 4->5 means movement from the sector 4 to the sector 3, i.e. it takes 1 time units "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So the answer to the second example is "},{"kind":"math_inline","text":"4 + 3 + 2 + 1 = 10"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"612B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/612/problem/B"}