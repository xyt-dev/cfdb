{"assets":[],"contentKind":"statement","contestId":"877","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Olya and Energy Drinks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Olya loves energy drinks. She loves them so much that her room is full of empty cans from energy drinks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, her room can be represented as a field of "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" cells, each cell of which is empty or littered with cans."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Olya drank a lot of energy drink, so now she can run "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" meters per second. Each second she chooses one of the four directions (up, down, left or right) and runs from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" meters in this direction. Of course, she can only run through empty cells."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Olya needs to get from cell "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":" to cell "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":". How many seconds will it take her if she moves optimally?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that cells "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":" are empty. These cells can coincide."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m, k ≤ 1000"},{"kind":"text","text":") — the sizes of the room and Olya's speed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow containing "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters each, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains on "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th position \""},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"\", if the cell "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" is littered with cans, and \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line contains four integers "},{"kind":"math_inline","text":"x1, y1, x2, y2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x1, x2 ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ y1, y2 ≤ m"},{"kind":"text","text":") — the coordinates of the first and the last cells."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum time it will take Olya to get from "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it's impossible to get from "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":", print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4 4\n....\n###.\n....\n1 1 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4 1\n....\n###.\n....\n1 1 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 1\n.#\n#.\n1 1 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Olya should run "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" meters to the right in the first second, "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" meters down in the second second and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" meters to the left in the third second."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In second sample Olya should run to the right for "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" seconds, then down for "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" seconds and then to the left for "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" seconds."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Olya does not recommend drinking energy drinks and generally believes that this is bad"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"877D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/877/problem/D"}