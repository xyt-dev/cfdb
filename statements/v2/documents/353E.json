{"assets":[],"contentKind":"statement","contestId":"353","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Antichain"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a directed acyclic graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertexes, numbered from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":". The graph contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" edges numbered from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":". An edge with number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" connects vertexes "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(i + 1) mod n"},{"kind":"text","text":", and it can be directed in either direction (from "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(i + 1) mod n"},{"kind":"text","text":", or vise versa)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Operation "},{"kind":"math_inline","text":"x mod y"},{"kind":"text","text":" means taking the remainder after dividing number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by number "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call two vertexes "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" in graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" comparable if the graph contains a path either from "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" or from "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"u"},{"kind":"text","text":". We'll assume that an antichain is a set of vertexes of graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":", where any two distinct vertexes are not comparable. The size of an antichain is the number of vertexes in the corresponding set. An antichain is maximum if the graph doesn't have antichains of a larger size."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the size of the maximum antichain in graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the sequence of characters "},{"kind":"math_inline","text":"s0s1... sn - 1"},{"kind":"math_inline","text":"(2 ≤ n ≤ 106)"},{"kind":"text","text":", consisting of numbers zero and one. The length of the line (number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":") corresponds to the number of vertexes and edges in graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":". If character "},{"kind":"math_inline","text":"si"},{"kind":"math_inline","text":"(i ≥ 0)"},{"kind":"text","text":" equals "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", then the edge between vertexes "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(i + 1) mod n"},{"kind":"text","text":" is directed from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex to the "},{"kind":"math_inline","text":"(i + 1) mod n"},{"kind":"text","text":"-th one, otherwise — to the opposite point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given graph is acyclic."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the size of the maximum antichain of graph "},{"kind":"math_inline","text":"G"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"001\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"110010\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first test sample. The graph's "},{"kind":"math_inline","text":"G"},{"kind":"text","text":" edges are: "},{"kind":"math_inline","text":"0 → 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 → 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 → 2"},{"kind":"text","text":". We can choose the set of vertexes "},{"kind":"math_inline","text":"[0]"},{"kind":"text","text":" as the maximum antichain. We cannot choose an antichain of larger size."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"353E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/353/problem/E"}