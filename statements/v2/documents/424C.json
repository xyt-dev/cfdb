{"assets":["/statement-assets/6c0199f7c005d00043b2892f61f557f62dcd8eea87db60d63fb4211edea1244b.png","/statement-assets/f07dcc36ec61a190382204ca2db09f43b7f30dd04a552d2c3ea8bda4bb23424a.png","/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"],"contentKind":"statement","contestId":"424","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Magic Formulas"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"People in the Tomskaya region like magic formulas very much. You can see some of them below."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Imagine you are given a sequence of positive integer numbers "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"pn"},{"kind":"text","text":". Lets write down some magic formulas:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/6c0199f7c005d00043b2892f61f557f62dcd8eea87db60d63fb4211edea1244b.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f07dcc36ec61a190382204ca2db09f43b7f30dd04a552d2c3ea8bda4bb23424a.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Here, \""},{"children":[{"kind":"text","text":"mod"}],"kind":"container"},{"kind":"text","text":"\" means the operation of taking the residue after dividing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The expression "},{"attrs":{"alt":"","src":"/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"},"kind":"image"},{"kind":"text","text":" means applying the bitwise "},{"kind":"math_inline","text":"xor"},{"kind":"text","text":" (excluding \"OR\") operation to integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". The given operation exists in all modern programming languages. For example, in languages C++ and Java it is represented by \""},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":"\", in Pascal — by \"xor\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"People in the Tomskaya region like magic formulas very much, but they don't like to calculate them! Therefore you are given the sequence "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", calculate the value of "},{"kind":"math_inline","text":"Q"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains the only integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":"). The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ pi ≤ 2·109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of output should contain a single integer — the value of "},{"kind":"math_inline","text":"Q"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"424C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/424/problem/C"}