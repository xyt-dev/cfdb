{"assets":[],"contentKind":"statement","contestId":"1770","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Koxia and Bracket"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Chiyuu has a bracket sequence$$$^\\dagger$$$ $$$s$$$ of length $$$n$$$. Let $$$k$$$ be the minimum number of characters that Chiyuu has to remove from $$$s$$$ to make $$$s$$$ balanced$$$^\\ddagger$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, Koxia wants you to count the number of ways to remove $$$k$$$ characters from $$$s$$$ so that $$$s$$$ becomes balanced, modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that two ways of removing characters are considered distinct if and only if the set of indices removed is different."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$^\\dagger$$$ A bracket sequence is a string containing only the characters \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$^\\ddagger$$$ A bracket sequence is called balanced if one can turn it into a valid math expression by adding characters "},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". For example, sequences "},{"children":[{"kind":"text","text":"(())()"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"(()(()))"}],"kind":"container"},{"kind":"text","text":" and the empty string are balanced, while "},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"(()"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"(()))("}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a string $$$s$$$ ($$$1 \\leq |s| \\leq 5 \\cdot {10}^5$$$) — the bracket sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that $$$s$$$ only contains the characters \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the number of ways to remove $$$k$$$ characters from $$$s$$$ so that $$$s$$$ becomes balanced, modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n())(()\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n(\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, it can be proved that the minimum number of characters that Chiyuu has to remove is $$$2$$$. There are $$$4$$$ ways to remove $$$2$$$ characters to make $$$s$$$ balanced as follows. Deleted characters are noted as red."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$\\texttt{(} \\color{Red}{\\texttt{)}} \\texttt{)} \\color{Red}{\\texttt{(}} \\texttt{(} \\texttt{)}$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\texttt{(} \\texttt{)} \\color{Red}{\\texttt{)}} \\color{Red}{\\texttt{(}} \\texttt{(} \\texttt{)}$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\texttt{(} \\color{Red}{\\texttt{)}} \\texttt{)} \\texttt{(} \\color{Red}{\\texttt{(}} \\texttt{)}$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\texttt{(} \\texttt{)} \\color{Red}{\\texttt{)}} \\texttt{(} \\color{Red}{\\texttt{(}} \\texttt{)}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second test case, the only way to make $$$s$$$ balanced is by deleting the only character to get an empty bracket sequence, which is considered balanced."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1770G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1770/problem/G"}