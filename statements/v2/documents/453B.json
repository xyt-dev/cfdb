{"assets":["/statement-assets/7ad08d066a5539cca89e9a4e6f6d0602c9fa1ba933a7692cc531a0001ec73fcf.png","/statement-assets/257d3220cb7a1da4e60922a175eeae22b07978d0caed567399b3b3d38e405b84.png"],"contentKind":"statement","contestId":"453","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Little Pony and Harmony Chest"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Princess Twilight went to Celestia and Luna's old castle to research the chest from the Elements of Harmony."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/7ad08d066a5539cca89e9a4e6f6d0602c9fa1ba933a7692cc531a0001ec73fcf.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"A sequence of positive integers "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is harmony if and only if for every two elements of the sequence their greatest common divisor equals 1. According to an ancient book, the key of the chest is a harmony sequence "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" which minimizes the following expression:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/257d3220cb7a1da4e60922a175eeae22b07978d0caed567399b3b3d38e405b84.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"You are given sequence "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", help Princess Twilight to find the key."}],"kind":"paragraph"}],"kind":"section"},{"attrs"