{"assets":[],"contentKind":"statement","contestId":"165","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Supercentral Point"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day Vasya painted a Cartesian coordinate system on a piece of paper and marked some set of points "},{"kind":"math_inline","text":"(x1, y1), (x2, y2), ..., (xn, yn)"},{"kind":"text","text":". Let's define neighbors for some fixed point from the given set "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":": "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" point "},{"kind":"math_inline","text":"(x', y')"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":"'s right neighbor, if "},{"kind":"math_inline","text":"x' > x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y' = y"}],"kind":"list_item"},{"children":[{"kind":"text","text":" point "},{"kind":"math_inline","text":"(x', y')"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":"'s left neighbor, if "},{"kind":"math_inline","text":"x' < x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y' = y"}],"kind":"list_item"},{"children":[{"kind":"text","text":" point "},{"kind":"math_inline","text":"(x', y')"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":"'s lower neighbor, if "},{"kind":"math_inline","text":"x' = x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y' < y"}],"kind":"list_item"},{"children":[{"kind":"text","text":" point "},{"kind":"math_inline","text":"(x', y')"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":"'s upper neighbor, if "},{"kind":"math_inline","text":"x' = x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y' > y"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"We'll consider point "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" from the given set supercentral, if it has at least one upper, at least one lower, at least one left and at least one right neighbor among this set's points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya marked quite many points on the paper. Analyzing the picture manually is rather a challenge, so Vasya asked you to help him. Your task is to find the number of supercentral points in the given set."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains the only integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200"},{"kind":"text","text":") — the number of points in the given set. Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the coordinates of the points written as \""},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"y"},{"kind":"text","text":"\" (without the quotes) ("},{"kind":"math_inline","text":"|x|, |y| ≤ 1000"},{"kind":"text","text":"), all coordinates are integers. The numbers in the line are separated by exactly one space. It is guaranteed that all points are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only number — the number of supercentral points of the given set."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n1 1\n4 2\n3 1\n1 2\n0 2\n0 1\n1 0\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 0\n0 1\n1 0\n0 -1\n-1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the supercentral points are only points "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample there is one supercental point — point "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"165A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/165/problem/A"}