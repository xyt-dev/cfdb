{"assets":[],"contentKind":"statement","contestId":"611","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. New Year and Days"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Today is Wednesday, the third day of the week. What's more interesting is that tomorrow is the last day of the year 2015."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak is a little polar bear. He enjoyed this year a lot. Now, he is so eager to the coming year 2016."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak wants to prove how responsible a bear he is. He is going to regularly save candies for the entire year 2016! He considers various saving plans. He can save one candy either on some fixed day of the week or on some fixed day of the month."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak chose one particular plan. He isn't sure how many candies he will save in the 2016 with his plan. Please, calculate it and tell him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input is in one of the following two formats: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"math_inline","text":"x"},{"kind":"text","text":" of week"}],"kind":"container"},{"kind":"text","text":"\" where "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ 7"},{"kind":"text","text":") denotes the day of the week. The 1-st day is Monday and the 7-th one is Sunday. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"math_inline","text":"x"},{"kind":"text","text":" of month"}],"kind":"container"},{"kind":"text","text":"\" where "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ 31"},{"kind":"text","text":") denotes the day of the month. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the number of candies Limak will save in the year 2016."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 of week\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"52\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"30 of month\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Polar bears use the Gregorian calendar. It is the most common calendar and you likely use it too. You can read about it on Wikipedia if you want to – "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Gregorian_calendar"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Gregorian_calendar"}],"kind":"link"},{"kind":"text","text":". The week starts with Monday."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample Limak wants to save one candy on each Thursday (the 4-th day of the week). There are "},{"kind":"math_inline","text":"52"},{"kind":"text","text":" Thursdays in the 2016. Thus, he will save "},{"kind":"math_inline","text":"52"},{"kind":"text","text":" candies in total."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample Limak wants to save one candy on the 30-th day of each month. There is the 30-th day in exactly "},{"kind":"math_inline","text":"11"},{"kind":"text","text":" months in the 2016 — all months but February. It means that Limak will save "},{"kind":"math_inline","text":"11"},{"kind":"text","text":" candies in total."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"611A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/611/problem/A"}