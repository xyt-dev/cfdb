{"assets":["/statement-assets/7d3483aa04fb1518b4d977888b6191a8d85002eb388d73cb4b4766c43ac41f03.png"],"contentKind":"statement","contestId":"56","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Domino Principle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya is interested in arranging dominoes. He is fed up with common dominoes and he uses the dominoes of different heights. He put "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" dominoes on the table along one axis, going from left to right. Every domino stands perpendicular to that axis so that the axis passes through the center of its base. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th domino has the coordinate "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and the height "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":". Now Vasya wants to learn for every domino, how many dominoes will fall if he pushes it to the right. Help him do that. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider that a domino falls if it is touched strictly above the base. In other words, the fall of the domino with the initial coordinate "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and height "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" leads to the fall of all dominoes on the segment "},{"kind":"math_inline","text":"[x + 1, x + h - 1]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/7d3483aa04fb1518b4d977888b6191a8d85002eb388d73cb4b4766c43ac41f03.png"},"kind":"image"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") which is the number of dominoes. Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines containing two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 108 ≤ xi ≤ 108, 2 ≤ hi ≤ 108"},{"kind":"text","text":") each, which are the coordinate and height of every domino. No two dominoes stand on one point."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated numbers "},{"kind":"math_inline","text":"zi"},{"kind":"text","text":" — the number of dominoes that will fall if Vasya pushes the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th domino to the right (including the domino itself)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n16 5\n20 5\n10 10\n18 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 1 4 1 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 10\n1 5\n9 10\n15 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 1 2 1 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"56E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/56/problem/E"}