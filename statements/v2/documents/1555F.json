{"assets":[],"contentKind":"statement","contestId":"1555","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Good Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have an undirected graph consisting of $$$n$$$ vertices with weighted edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A simple cycle is a cycle of the graph without repeated vertices. Let the "},{"children":[{"kind":"text","text":"weight"}],"kind":"container"},{"kind":"text","text":" of the cycle be the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"XOR"}],"kind":"link"},{"kind":"text","text":" of weights of edges it consists of."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's say the graph is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if all its "},{"children":[{"kind":"text","text":"simple"}],"kind":"container"},{"kind":"text","text":" cycles have weight $$$1$$$. A graph is bad if it's not good."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially, the graph is empty. Then $$$q$$$ queries follow. Each query has the next type: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$u$$$ $$$v$$$ $$$x$$$ — add edge between vertices $$$u$$$ and $$$v$$$ of weight $$$x$$$ if it doesn't make the graph bad. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For each query print, was the edge added or not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$q$$$ ($$$3 \\le n \\le 3 \\cdot 10^5$$$; $$$1 \\le q \\le 5 \\cdot 10^5$$$) — the number of vertices and queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$q$$$ lines contain queries — one per line. Each query contains three integers $$$u$$$, $$$v$$$ and $$$x$$$ ($$$1 \\le u, v \\le n$$$; $$$u \\neq v$$$; $$$0 \\le x \\le 1$$$) — the vertices of the edge and its weight."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"It's guaranteed that there are no multiple edges in the input."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" if the edge was added to the graph, or "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" otherwise (both case-insensitive)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n9 12\n6 1 0\n1 3 1\n3 6 0\n6 2 0\n6 4 1\n3 4 1\n2 4 0\n2 5 0\n4 5 0\n7 8 1\n8 9 1\n9 7 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nYES\nYES\nYES\nYES\nNO\nYES\nYES\nNO\nYES\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1555F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1555/problem/F"}