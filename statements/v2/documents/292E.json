{"assets":[],"contentKind":"statement","contestId":"292","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Copying Data"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"We often have to copy large volumes of information. Such operation can take up many computer resources. Therefore, in this problem you are advised to come up with a way to copy some part of a number array into another one, quickly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, you've got two arrays of integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Also, you've got "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries of two types:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Copy the subsegment of array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", starting from position "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", into array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", starting from position "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", that is, execute "},{"kind":"math_inline","text":"by + q = ax + q"},{"kind":"text","text":" for all integer "},{"kind":"math_inline","text":"q"},{"kind":"math_inline","text":"(0 ≤ q < k)"},{"kind":"text","text":". The given operation is correct — both subsegments do not touch unexistent elements. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Determine the value in position "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" of array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", that is, find value "},{"kind":"math_inline","text":"bx"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For each query of the second type print the result — the value of the corresponding element of array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 105)"},{"kind":"text","text":" — the number of elements in the arrays and the number of queries, correspondingly. The second line contains an array of integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(|ai| ≤ 109)"},{"kind":"text","text":". The third line contains an array of integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"math_inline","text":"(|bi| ≤ 109)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the descriptions of the queries. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line first contains integer "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" — the type of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query "},{"kind":"math_inline","text":"(1 ≤ ti ≤ 2)"},{"kind":"text","text":". If "},{"kind":"math_inline","text":"ti = 1"},{"kind":"text","text":", then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query means the copying operation. If "},{"kind":"math_inline","text":"ti = 2"},{"kind":"text","text":", then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query means taking the value in array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". If "},{"kind":"math_inline","text":"ti = 1"},{"kind":"text","text":", then the query type is followed by three integers "},{"kind":"math_inline","text":"xi, yi, ki"},{"kind":"math_inline","text":"(1 ≤ xi, yi, ki ≤ n)"},{"kind":"text","text":" — the parameters of the copying query. If "},{"kind":"math_inline","text":"ti = 2"},{"kind":"text","text":", then the query type is followed by integer "},{"kind":"math_inline","text":"xi"},{"kind":"math_inline","text":"(1 ≤ xi ≤ n)"},{"kind":"text","text":" — the position in array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All numbers in the lines are separated with single spaces. It is guaranteed that all the queries are correct, that is, the copying borders fit into the borders of arrays "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each second type query print the result on a single line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 10\n1 2 0 -1 3\n3 1 5 -2 0\n2 5\n1 3 3 3\n2 5\n2 4\n2 1\n1 2 1 4\n2 1\n2 4\n1 4 2 1\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n3\n-1\n3\n2\n3\n-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"292E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/292/problem/E"}