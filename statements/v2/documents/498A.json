{"assets":["/statement-assets/3d3f8e30fa2b039192f5b2e0799160af341102e205edb889a4589c674d62df6d.png","/statement-assets/f5e79d2667513345901bf482a07ec8d9223d3407c678eb2acf580145d7cfe4aa.png"],"contentKind":"statement","contestId":"498","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Crazy Town"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Crazy Town is a plane on which there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" infinite line roads. Each road is defined by the equation "},{"kind":"math_inline","text":"aix + biy + ci = 0"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" are not both equal to the zero. The roads divide the plane into connected regions, possibly of infinite space. Let's call each such region a block. We define an intersection as the point where at least two different roads intersect."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your home is located in one of the blocks. Today you need to get to the University, also located in some block. In one step you can move from one block to another, if the length of their common border is nonzero (in particular, this means that if the blocks are adjacent to one intersection, but have no shared nonzero boundary segment, then it are not allowed to move from one to another one in one step)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine what is the minimum number of steps you have to perform to get to the block containing the university. It is guaranteed that neither your home nor the university is located on the road."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 106 ≤ x1, y1 ≤ 106"},{"kind":"text","text":") — the coordinates of your home."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains two integers separated by a space "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 106 ≤ x2, y2 ≤ 106"},{"kind":"text","text":") — the coordinates of the university you are studying at."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 300"},{"kind":"text","text":") — the number of roads in the city. The following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain 3 space-separated integers ("},{"kind":"math_inline","text":" - 106 ≤ ai, bi, ci ≤ 106"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"|ai| + |bi| > 0"},{"kind":"text","text":") — the coefficients of the line "},{"kind":"math_inline","text":"aix + biy + ci = 0"},{"kind":"text","text":", defining the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road. It is guaranteed that no two roads are the same. In addition, neither your home nor the university lie on the road (i.e. they do not belong to any one of the lines)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n-1 -1\n2\n0 1 0\n1 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n-1 -1\n3\n1 0 0\n0 1 0\n1 1 -3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Pictures to the samples are presented below (A is the point representing the house; B is the point representing the university, different blocks are filled with different colors):"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/3d3f8e30fa2b039192f5b2e0799160af341102e205edb889a4589c674d62df6d.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f5e79d2667513345901bf482a07ec8d9223d3407c678eb2acf580145d7cfe4aa.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"498A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/498/problem/A"}