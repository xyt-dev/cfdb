{"assets":[],"contentKind":"statement","contestId":"912","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Tricky Alchemy"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"During the winter holidays, the demand for Christmas balls is exceptionally high. Since it's already "},{"kind":"math_inline","text":"2018"},{"kind":"text","text":", the advances in alchemy allow easy and efficient ball creation by utilizing magic crystals."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Grisha needs to obtain some yellow, green and blue balls. It's known that to produce a "},{"children":[{"kind":"text","text":"yellow"}],"kind":"container"},{"kind":"text","text":" ball one needs two yellow crystals, "},{"children":[{"kind":"text","text":"green"}],"kind":"container"},{"kind":"text","text":" — one yellow and one blue, and for a "},{"children":[{"kind":"text","text":"blue"}],"kind":"container"},{"kind":"text","text":" ball, three blue crystals are enough."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Right now there are "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" yellow and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" blue crystals in Grisha's disposal. Find out how many additional crystals he should acquire in order to produce the required number of balls."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line features two integers "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ A, B ≤ 109"},{"kind":"text","text":"), denoting the number of yellow and blue crystals respectively at Grisha's disposal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains three integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"z"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ x, y, z ≤ 109"},{"kind":"text","text":") — the respective amounts of yellow, green and blue balls to be obtained."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum number of crystals that Grisha should acquire in addition."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n2 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 9\n1 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"12345678 87654321\n43043751 1000000000 53798715\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2147483648\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case, Grisha needs five yellow and four blue crystals to create two yellow balls, one green ball, and one blue ball. To do that, Grisha needs to obtain two additional crystals: one yellow and one blue."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"912A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/912/problem/A"}