{"assets":[],"contentKind":"statement","contestId":"276","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Little Girl and Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Little Girl loves problems on games very much. Here's one of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two players have got a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of lowercase English letters. They play a game that is described by the following rules:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The players move in turns; In one move the player can remove an arbitrary letter from string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the player before his turn can reorder the letters in string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" so as to get a palindrome, this player wins. A palindrome is a string that reads the same both ways (from left to right, and vice versa). For example, string \""},{"children":[{"kind":"text","text":"abba"}],"kind":"container"},{"kind":"text","text":"\" is a palindrome and string \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\" isn't. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Determine which player will win, provided that both sides play optimally well — the one who moves first or the one who moves second."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input contains a single line, containing string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s|  ≤  103"},{"kind":"text","text":"). String "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consists of lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print word \""},{"children":[{"kind":"text","text":"First"}],"kind":"container"},{"kind":"text","text":"\" if the first player wins (provided that both players play optimally well). Otherwise, print word \""},{"children":[{"kind":"text","text":"Second"}],"kind":"container"},{"kind":"text","text":"\". Print the words without the quotes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"aba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"First\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abca\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"child