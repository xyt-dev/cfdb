{"assets":[],"contentKind":"statement","contestId":"1550","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Maximum Cost Deletion"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ of length $$$n$$$ consisting only of the characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You perform the following operation until the string becomes empty: choose some "},{"children":[{"kind":"text","text":"consecutive"}],"kind":"container"},{"kind":"text","text":" substring of "},{"children":[{"kind":"text","text":"equal"}],"kind":"container"},{"kind":"text","text":" characters, erase it from the string and glue the remaining two parts together (any of them can be empty) in the same order. For example, if you erase the substring "},{"children":[{"kind":"text","text":"111"}],"kind":"container"},{"kind":"text","text":" from the string "},{"children":[{"kind":"text","text":"1"},{"children":[{"kind":"text","text":"111"}],"kind":"container"},{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":", you will get the string "},{"children":[{"kind":"text","text":"110"}],"kind":"container"},{"kind":"text","text":". When you delete a substring of length $$$l$$$, you get $$$a \\cdot l + b$$$ points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to calculate the maximum number of points that you can score in total, if you have to make the given string empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 2000$$$) — the number of testcases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each testcase contains three integers $$$n$$$, $$$a$$$ and $$$b$$$ ($$$1 \\le n \\le 100; -100 \\le a, b \\le 100$$$) — the length of the string $$$s$$$ and the parameters $$$a$$$ and $$$b$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string $$$s$$$. The string $$$s$$$ consists only of the characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase, print a single integer — the maximum number of points that you can score."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n3 2 0\n000\n5 -2 5\n11001\n6 1 -4\n100111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n15\n-2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, it is enough to delete the entire string, then we will get $$$2 \\cdot 3 + 0 = 6$$$ points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, if we delete characters one by one, then for each deleted character we will get $$$(-2) \\cdot 1 + 5 = 3$$$ points, i. e. $$$15$$$ points in total."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, we can delete the substring "},{"children":[{"kind":"text","text":"00"}],"kind":"container"},{"kind":"text","text":" from the string "},{"children":[{"kind":"text","text":"1"},{"children":[{"kind":"text","text":"00"}],"kind":"container"},{"kind":"text","text":"111"}],"kind":"container"},{"kind":"text","text":", we get $$$1 \\cdot 2 + (-4) = -2$$$ points, and the string will be equal to "},{"children":[{"kind":"text","text":"1111"}],"kind":"container"},{"kind":"text","text":", removing it entirely we get $$$1 \\cdot 4 + (-4) = 0$$$ points. In total, we got $$$-2$$$ points for $$$2$$$ operations."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1550B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1550/problem/B"}