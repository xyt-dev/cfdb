{"assets":[],"contentKind":"statement","contestId":"1883","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Chemistry"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ of length $$$n$$$, consisting of lowercase Latin letters, and an integer $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to check if it is possible to remove "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" $$$k$$$ characters from the string $$$s$$$ in such a way that the remaining characters can be rearranged to form a palindrome. Note that you can reorder the remaining characters in any way."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A palindrome is a string that reads the same forwards and backwards. For example, the strings \""},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"aaa"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abccba"}],"kind":"container"},{"kind":"text","text":"\" are palindromes, while the strings \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"reality"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test consists of multiple test cases. The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 10^4$$$) — the number of the test cases. This is followed by their description."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$k$$$ ($$$0 \\leq k \\lt n \\leq 10^5$$$) — the length of the string $$$s$$$ and the number of characters to be deleted."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$s$$$ of length $$$n$$$, consisting of lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if it is possible to remove exactly $$$k$$$ characters from the string $$$s$$$ in such a way that the remaining characters can be rearranged to form a palindrome, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output the answer in any case (uppercase or lowercase). For example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be recognized as positive answers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n14\n1 0\na\n2 0\nab\n2 1\nba\n3 1\nabb\n3 2\nabc\n6 2\nbacacd\n6 2\nfagbza\n6 2\nzwaafa\n7 2\ntaagaak\n14 3\nttrraakkttoorr\n5 3\ndebdb\n5 4\necadc\n5 3\ndebca\n5 3\nabaac\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\nYES\nYES\nYES\nYES\nNO\nNO\nYES\nYES\nYES\nYES\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, nothing can be removed, and the string \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" is a palindrome."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, nothing can be removed, but the strings \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":"\" are not palindromes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, any character can be removed, and the resulting string will be a palindrome."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, one occurrence of the character \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" can be removed, resulting in the string \""},{"children":[{"kind":"text","text":"bb"}],"kind":"container"},{"kind":"text","text":"\", which is a palindrome."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the sixth test case, one occurrence of the characters \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":"\" can be removed, resulting in the string \""},{"children":[{"kind":"text","text":"acac"}],"kind":"container"},{"kind":"text","text":"\", which can be rearranged to the string \""},{"children":[{"kind":"text","text":"acca"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the ninth test case, one occurrence of the characters \""},{"children":[{"kind":"text","text":"t"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"k"}],"kind":"container"},{"kind":"text","text":"\" can be removed, resulting in the string \""},{"children":[{"kind":"text","text":"aagaa"}],"kind":"container"},{"kind":"text","text":"\", which is a palindrome."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1883B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1883/problem/B"}