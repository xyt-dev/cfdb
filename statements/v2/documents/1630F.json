{"assets":["/statement-assets/1d7c7a69eedea385334376a4b8d58f49a010cffe1dfa1645527740a16a921d10.png","/statement-assets/1258a0d4f43fac3ab93e211f59d1b3da26f698097e985401c30ce8cb55ca83ce.png","/statement-assets/71226ae8bf74b203bf038743cdec063ca27432e3ae58c1095544e35fdbb359b9.png","/statement-assets/2ec1eb6159a2c035c687eaafdd0aed011fd9defb594faf6cfc23300c99c68036.png","/statement-assets/1deafea4a249d6b61340985fa487d332dd5e73dcfd2fea37e17f93cc5e026fea.png","/statement-assets/37bce721b898d83e26605b97e2e86d501b32fd046b7ce81e1c059f3bf1f9f5b8.png","/statement-assets/fb6ac99f608ac71c16e307dec1c618a1f34337dbf76367b04e7cd88ca49e7ae3.png"],"contentKind":"statement","contestId":"1630","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Making It Bipartite"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an undirected graph of $$$n$$$ vertices indexed from $$$1$$$ to $$$n$$$, where vertex $$$i$$$ has a value $$$a_i$$$ assigned to it and all values $$$a_i$$$ are "},{"children":[{"kind":"text","text":"different"}],"kind":"container"},{"kind":"text","text":". There is an edge between two vertices $$$u$$$ and $$$v$$$ if either $$$a_u$$$ divides $$$a_v$$$ or $$$a_v$$$ divides $$$a_u$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the minimum number of vertices to remove such that the remaining graph is bipartite, when you remove a vertex you remove all the edges incident to it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of multiple test cases. The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. Description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 5\\cdot10^4$$$) — the number of vertices in the graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers, the $$$i$$$-th of them is the value $$$a_i$$$ ($$$1 \\le a_i \\le 5\\cdot10^4$$$) assigned to the $$$i$$$-th vertex, all values $$$a_i$$$ are "},{"children":[{"kind":"text","text":"different"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$5\\cdot10^4$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print a single integer — the minimum number of vertices to remove such that the remaining graph is bipartite."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n4\n8 4 2 1\n4\n30 2 3 5\n5\n12 4 6 2 3\n10\n85 195 5 39 3 13 266 154 14 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n0\n1\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case if we remove the vertices with values $$$1$$$ and $$$2$$$ we will obtain a bipartite graph, so the answer is $$$2$$$, it is impossible to remove less than $$$2$$$ vertices and still obtain a bipartite graph."}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"Before"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"After"}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/1d7c7a69eedea385334376a4b8d58f49a010cffe1dfa1645527740a16a921d10.png"},"kind":"image"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/1258a0d4f43fac3ab93e211f59d1b3da26f698097e985401c30ce8cb55ca83ce.png"},"kind":"image"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"},{"children":[{"kind":"text","text":"test case #1"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second test case we do not have to remove any vertex because the graph is already bipartite, so the answer is $$$0$$$."}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"Before"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"After"}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/71226ae8bf74b203bf038743cdec063ca27432e3ae58c1095544e35fdbb359b9.png"},"kind":"image"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/71226ae8bf74b203bf038743cdec063ca27432e3ae58c1095544e35fdbb359b9.png"},"kind":"image"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"},{"children":[{"kind":"text","text":"test case #2"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"In the third test case we only have to remove the vertex with value $$$12$$$, so the answer is $$$1$$$."}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"Before"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"After"}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/2ec1eb6159a2c035c687eaafdd0aed011fd9defb594faf6cfc23300c99c68036.png"},"kind":"image"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/1deafea4a249d6b61340985fa487d332dd5e73dcfd2fea37e17f93cc5e026fea.png"},"kind":"image"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"},{"children":[{"kind":"text","text":"test case #3"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"In the fourth test case we remove the vertices with values $$$2$$$ and $$$195$$$, so the answer is $$$2$$$."}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"Before"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"After"}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/