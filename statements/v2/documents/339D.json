{"assets":[],"contentKind":"statement","contestId":"339","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Xenia and Bit Operations"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Xenia the beginner programmer has a sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" non-negative integers: "},{"kind":"math_inline","text":"a1, a2, ..., a2n"},{"kind":"text","text":". Xenia is currently studying bit operations. To better understand how they work, Xenia decided to calculate some value "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" for "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Namely, it takes several iterations to calculate value "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". At the first iteration, Xenia writes a new sequence "},{"kind":"math_inline","text":"a1 or a2, a3 or a4, ..., a2n - 1 or a2n"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"2n - 1"},{"kind":"text","text":" elements. In other words, she writes down the bit-wise OR of adjacent elements of sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". At the second iteration, Xenia writes the bitwise "},{"children":[{"kind":"text","text":"exclusive"}],"kind":"container"},{"kind":"text","text":" OR of adjacent elements of the sequence obtained after the first iteration. At the third iteration Xenia writes the bitwise OR of the adjacent elements of the sequence obtained after the second iteration. And so on; the operations of bitwise exclusive OR and bitwise OR alternate. In the end, she obtains a sequence consisting of one element, and that element is "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's consider an example. Suppose that sequence "},{"kind":"math_inline","text":"a = (1, 2, 3, 4)"},{"kind":"text","text":". Then let's write down all the transformations "},{"kind":"math_inline","text":"(1, 2, 3, 4)"},{"kind":"math_inline","text":" → "},{"kind":"math_inline","text":"(1 or 2 = 3, 3 or 4 = 7)"},{"kind":"math_inline","text":" → "},{"kind":"math_inline","text":"(3 xor 7 = 4)"},{"kind":"text","text":". The result is "},{"kind":"math_inline","text":"v = 4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given Xenia's initial sequence. But to calculate value "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" for a given sequence would be too easy, so you are given additional "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries. Each query is a pair of integers "},{"kind":"math_inline","text":"p, b"},{"kind":"text","text":". Query "},{"kind":"math_inline","text":"p, b"},{"kind":"text","text":" means that you need to perform the assignment "},{"kind":"math_inline","text":"ap = b"},{"kind":"text","text":". After each query, you need to print the new value "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" for the new sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n ≤ 17, 1 ≤ m ≤ 105)"},{"kind":"text","text":". The next line contains "},{"kind":"math_inline","text":"2n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., a2n"},{"kind":"math_inline","text":"(0 ≤ ai < 230)"},{"kind":"text","text":". Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains queries. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains integers "},{"kind":"math_inline","text":"pi, bi"},{"kind":"math_inline","text":"(1 ≤ pi ≤ 2n, 0 ≤ bi < 230)"},{"kind":"text","text":" — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th integer denotes value "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" for sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" after the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4\n1 6 3 5\n1 4\n3 4\n1 2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n3\n3\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For more information on the bit operations, you can follow this link: "},{"children":[{"kind":"text","text":"http://en.wikipedia.org/wiki/Bitwise_operation"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"339D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/339/problem/D"}