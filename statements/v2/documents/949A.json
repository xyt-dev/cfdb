{"assets":[],"contentKind":"statement","contestId":"949","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Zebras"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Oleg writes down the history of the days he lived. For each day he decides if it was good or bad. Oleg calls a non-empty sequence of days a "},{"children":[{"kind":"text","text":"zebra"}],"kind":"container"},{"kind":"text","text":", if it starts with a bad day, ends with a bad day, and good and bad days are alternating in it. Let us denote bad days as "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and good days as "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". Then, for example, sequences of days "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"010"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"01010"}],"kind":"container"},{"kind":"text","text":" are zebras, while sequences "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"0110"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"0101"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Oleg tells you the story of days he lived in chronological order in form of string consisting of "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". Now you are interested if it is possible to divide Oleg's life history into several "},{"children":[{"kind":"text","text":"subsequences"}],"kind":"container"},{"kind":"text","text":", each of which is a zebra, and the way it can be done. Each day must belong to exactly one of the subsequences. For each of the subsequences, days forming it must be ordered chronologically. Note that subsequence does not have to be a group of consecutive days. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line of input data there is a non-empty string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", which describes the history of Oleg's life. Its length (denoted as "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":") does not exceed "},{"kind":"math_inline","text":"200 000"},{"kind":"text","text":" characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is a way to divide history into zebra subsequences, in the first line of output you should print an integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ |s|"},{"kind":"text","text":"), the resulting number of subsequences. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of following "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines first print the integer "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ |s|"},{"kind":"text","text":"), which is the length of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th subsequence, and then "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" indices of days forming the subsequence. Indices must follow in ascending order. Days are numbered starting from 1. Each index from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" must belong to exactly one subsequence. If there is no way to divide day history into zebra subsequences, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Subsequences may be printed in any order. If there are several solutions, you may print any of them. You do not have to minimize nor maximize the value of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0010100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 1 3 4\n3 2 5 6\n1 7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"949A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/949/problem/A"}