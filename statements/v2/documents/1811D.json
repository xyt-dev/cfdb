{"assets":["/statement-assets/4be4c9e9720627b1055e4b05ee873f6d1722d7648d0ca0cf10c46acea8632de4.png","/statement-assets/a7c86013d2eaf88444ad9c0df7459fc143c761937b3b520358f32d2e0d652426.png","/statement-assets/e4e4659c6979c83eb179952e861d96cb3a931a5b06eef03b9762d08f347b5816.png"],"contentKind":"statement","contestId":"1811","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Umka and a Long Flight"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The girl Umka loves to travel and participate in math olympiads. One day she was flying by plane to the next olympiad and out of boredom explored a huge checkered sheet of paper."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Denote the $$$n$$$-th Fibonacci number as $$$F_n = \\begin{cases} 1, & n = 0; \\\\ 1, & n = 1; \\\\ F_{n-2} + F_{n-1}, & n \\ge 2. \\end{cases}$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A checkered rectangle with a height of $$$F_n$$$ and a width of $$$F_{n+1}$$$ is called a Fibonacci rectangle "},{"children":[{"kind":"text","text":"of order"}],"kind":"container"},{"kind":"text","text":" $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Umka has a Fibonacci rectangle "},{"children":[{"kind":"text","text":"of order"}],"kind":"container"},{"kind":"text","text":" $$$n$$$. Someone colored a cell in it at the intersection of the row $$$x$$$ and the column $$$y$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is necessary to cut this rectangle "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" into $$$n+1$$$ squares in such way that"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the painted cell was in a square with a side of $$$1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" there was "},{"children":[{"kind":"text","text":"at most one"}],"kind":"container"},{"kind":"text","text":" pair of squares with equal sides; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the side of each square was equal to a Fibonacci number. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Will Umka be able to cut this rectangle in that way?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\le t \\le 2 \\cdot 10^5$$$) — number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each test case the integers $$$n$$$, $$$x$$$, $$$y$$$ are given ($$$1 \\le n \\le 44$$$, $$$1 \\le x \\le F_n$$$, $$$1 \\le y \\le F_{n+1}$$$) — "},{"children":[{"kind":"text","text":"the order"}],"kind":"container"},{"kind":"text","text":" of the Fibonacci rectangle and the coordinates of the colored cell."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if the answer is positive, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" in any case (for example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" will be recognized as a positive answer)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n12\n1 1 1\n2 1 2\n3 1 4\n3 3 2\n4 4 6\n4 3 3\n5 6 5\n5 4 12\n5 2 12\n4 2 1\n1 1 2\n44 758465880 1277583853\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\nYES\nYES\nYES\nNO\nYES\nNO\nNO\nYES\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/4be4c9e9720627b1055e4b05ee873f6d1722d7648d0ca0cf10c46acea8632de4.png"},"kind":"image"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/a7c86013d2eaf88444ad9c0df7459fc143c761937b3b520358f32d2e0d652426.png"},"kind":"image"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/e4e4659c6979c83eb179952e861d96cb3a931a5b06eef03b9762d08f347b5816.png"},"kind":"image"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"},{"children":[{"kind":"text","text":"The first, third and fourth test cases."}],"kind":"container"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1811D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1811/problem/D"}