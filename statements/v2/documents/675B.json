},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", and different cells may contain either different or equal integers. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The sum of integers in each of four squares "},{"kind":"math_inline","text":"2 × 2"},{"kind":"text","text":" is equal to the sum of integers in the top left square "},{"kind":"math_inline","text":"2 × 2"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Four elements "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" are known and are located as shown on the picture below. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ebbe4d64446441eb318d259ead81f48e5f12c434fb0bf659f6e0e43017cbcfc7.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Help Vasya find out the number of distinct squares the satisfy all the conditions above. Note, that this number may be equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", meaning Vasya remembers something wrong."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two squares are considered to be different, if there exists a cell that contains two different integers in different squares."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains five integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ a, b, c, d ≤ n"},{"kind":"text","text":") — maximum possible value of an integer in the cell and four integers that Vasya remembers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the number of distinct valid squares."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 1 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Below are all the possible paintings for the first sample. "},{"attrs":{"alt":"","src":"/statement-assets/1fb91586e0828f4672dfb42bf98bcc953d6065b1f1a2f7c0160260e97b477054.png"},"kind":"image"},{"attrs":{"alt":