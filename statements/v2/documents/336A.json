{"assets":["/statement-assets/d79e2aaff662e51f0c1a43f02ad95d30310af09ea7385dacc2b2581c72ef349f.png","/statement-assets/cb65837e7d2b8fd87005c9fccc3ff0edcd1b121d7a019a0a163cccc5789e5fa9.png"],"contentKind":"statement","contestId":"336","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Vasily the Bear and Triangle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasily the bear has a "},{"children":[{"kind":"text","text":"favorite rectangle"}],"kind":"container"},{"kind":"text","text":", it has one vertex at point "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":", and the opposite vertex at point "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":". Of course, the sides of Vasya's favorite rectangle are parallel to the coordinate axes. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya also loves triangles, if the triangles have one vertex at point "},{"kind":"math_inline","text":"B = (0, 0)"},{"kind":"text","text":". That's why today he asks you to find two points "},{"kind":"math_inline","text":"A = (x1, y1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"C = (x2, y2)"},{"kind":"text","text":", such that the following conditions hold:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the coordinates of points: "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":" are integers. Besides, the following inequation holds: "},{"kind":"math_inline","text":"x1 < x2"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the triangle formed by point "},{"kind":"math_inline","text":"A"},{"kind":"text","text":", "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" is rectangular and isosceles ("},{"attrs":{"alt":"","src":"/statement-assets/d79e2aaff662e51f0c1a43f02ad95d30310af09ea7385dacc2b2581c72ef349f.png"},"kind":"image"},{"kind":"text","text":" is right); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" all points of the favorite rectangle are located inside or on the border of triangle "},{"kind":"math_inline","text":"ABC"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the area of triangle "},{"kind":"math_inline","text":"ABC"},{"kind":"text","text":" is as small as possible. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help the bear, find the required points. It is not so hard to proof that these points are unique."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"x, y"},{"kind":"math_inline","text":"( - 109 ≤ x, y ≤ 109, x ≠ 0, y ≠ 0)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print in the single line four integers "},{"kind":"math_inline","text":"x1, y1, x2, y2"},{"kind":"text","text":" — the coordinates of the required points."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 15 15 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"-10 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-15 0 0 15\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/cb65837e7d2b8fd87005c9fccc3ff0edcd1b121d7a019a0a163cccc5789e5fa9.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Figure to the first sample"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"336A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/336/problem/A"}