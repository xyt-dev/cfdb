{"assets":["/statement-assets/14327c2efd3bcd1c76d889545b4d5089da6eb5063310fa7835c4af5deecb3645.png","/statement-assets/7d5ef059d112fecfab0cd65ce348ee6e34dc3e12cc1e0d83fedede3dca23dfc6.png","/statement-assets/44b85742d1e80514d479fe6942892c5c4977ed521932cf6ca54cdddf31896421.png","/statement-assets/14dae9c0941055fce6e8a8f62c9bd17e2e45bc726635e90ba649984ca9bc869c.png","/statement-assets/31658c00666e48cd5e8ef4eeebb60c2aaffd310cdcfd2b1480393145d644a9b5.png","/statement-assets/ea47226339266d15fe051cbea042818a9287fc3155bbc24a6f930dcf6d69deaa.png"],"contentKind":"statement","contestId":"547","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Mike and Frog"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mike has a frog and a flower. His frog is named Xaniar and his flower is named Abol. Initially(at time "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"), height of Xaniar is "},{"kind":"math_inline","text":"h1"},{"kind":"text","text":" and height of Abol is "},{"kind":"math_inline","text":"h2"},{"kind":"text","text":". Each second, Mike waters Abol and Xaniar."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/14327c2efd3bcd1c76d889545b4d5089da6eb5063310fa7835c4af5deecb3645.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"So, if height of Xaniar is "},{"kind":"math_inline","text":"h1"},{"kind":"text","text":" and height of Abol is "},{"kind":"math_inline","text":"h2"},{"kind":"text","text":", after one second height of Xaniar will become "},{"attrs":{"alt":"","src":"/statement-assets/7d5ef059d112fecfab0cd65ce348ee6e34dc3e12cc1e0d83fedede3dca23dfc6.png"},"kind":"image"},{"kind":"text","text":" and height of Abol will become "},{"attrs":{"alt":"","src":"/statement-assets/44b85742d1e80514d479fe6942892c5c4977ed521932cf6ca54cdddf31896421.png"},"kind":"image"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"x1, y1, x2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":" are some integer numbers and "},{"attrs":{"alt":"","src":"/statement-assets/14dae9c0941055fce6e8a8f62c9bd17e2e45bc726635e90ba649984ca9bc869c.png"},"kind":"image"},{"kind":"text","text":" denotes the remainder of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mike is a competitive programmer fan. He wants to know the minimum time it takes until height of Xania is "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":" and height of Abol is "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mike has asked you for your help. Calculate the minimum time or say it will never happen."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ m ≤ 106"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of input contains integers "},{"kind":"math_inline","text":"h1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ h1, a1 < m"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line of input contains integers "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ x1, y1 < m"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fourth line of input contains integers "},{"kind":"math_inline","text":"h2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ h2, a2 < m"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fifth line of input contains integers "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ x2, y2 < m"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that "},{"kind":"math_inline","text":"h1 ≠ a1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"h2 ≠ a2"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of seconds until Xaniar reaches height "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":" and Abol reaches height "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":" or print -1 otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n4 2\n1 