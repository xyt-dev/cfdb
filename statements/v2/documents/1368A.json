{"assets":[],"contentKind":"statement","contestId":"1368","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. C+="}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Leo has developed a new programming language C+=. In C+=, integer variables can only be changed with a \""},{"children":[{"kind":"text","text":"+="}],"kind":"container"},{"kind":"text","text":"\" operation that adds the right-hand side value to the left-hand side variable. For example, performing \""},{"children":[{"kind":"text","text":"a += b"}],"kind":"container"},{"kind":"text","text":"\" when "},{"children":[{"kind":"text","text":"a = "}],"kind":"container"},{"kind":"text","text":"$$$2$$$, "},{"children":[{"kind":"text","text":"b = "}],"kind":"container"},{"kind":"text","text":"$$$3$$$ changes the value of "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" to $$$5$$$ (the value of "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":" does not change)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In a prototype program Leo has two integer variables "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":", initialized with some positive values. He can perform any number of operations \""},{"children":[{"kind":"text","text":"a += b"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"b += a"}],"kind":"container"},{"kind":"text","text":"\". Leo wants to test handling large integers, so he wants to make the value of either "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"children":[{"kind":"text","text":"strictly greater"}],"kind":"container"},{"kind":"text","text":" than a given value $$$n$$$. What is the smallest number of operations he has to perform?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$T$$$ ($$$1 \\leq T \\leq 100$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following $$$T$$$ lines describes a single test case, and contains three integers $$$a, b, n$$$ ($$$1 \\leq a, b \\leq n \\leq 10^9$$$) — initial values of "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":", and the value one of the variables has to exceed, respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print a single integer — the smallest number of operations needed. Separate answers with line breaks."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n1 2 3\n5 4 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first case we cannot make a variable exceed $$$3$$$ in one operation. One way of achieving this in two operations is to perform \""},{"children":[{"kind":"text","text":"b += a"}],"kind":"container"},{"kind":"text","text":"\" twice."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1368A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1368/problem/A"}