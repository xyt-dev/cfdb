{"assets":["/statement-assets/5a3effeb21b1fee4ce0b0a8fe2a8b70c19f18bf04b58c1ac982e02e40cd8544a.png"],"contentKind":"statement","contestId":"302","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Eugeny and Play List"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Eugeny loves listening to music. He has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" songs in his play list. We know that song number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has the duration of "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" minutes. Eugeny listens to each song, perhaps more than once. He listens to song number "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" times. Eugeny's play list is organized as follows: first song number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" plays "},{"kind":"math_inline","text":"c1"},{"kind":"text","text":" times, then song number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" plays "},{"kind":"math_inline","text":"c2"},{"kind":"text","text":" times, "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", in the end the song number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" plays "},{"kind":"math_inline","text":"cn"},{"kind":"text","text":" times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Eugeny took a piece of paper and wrote out "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" moments of time when he liked a song. Now for each such moment he wants to know the number of the song that played at that moment. The moment "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" means that Eugeny wants to know which song was playing during the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-th minute of his listening to the play list."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Eugeny and calculate the required numbers of songs."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 105)"},{"kind":"text","text":". The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain pairs of integers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains integers "},{"kind":"math_inline","text":"ci, ti"},{"kind":"math_inline","text":"(1 ≤ ci, ti ≤ 109)"},{"kind":"text","text":" — the description of the play list. It is guaranteed that the play list's total duration doesn't exceed "},{"kind":"math_inline","text":"109"},{"attrs":{"alt":"","src":"/statement-assets/5a3effeb21b1fee4ce0b0a8fe2a8b70c19f18bf04b58c1ac982e02e40cd8544a.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"v1, v2, ..., vm"},{"kind":"text","text":", that describe the moments Eugeny has written out. It is guaranteed that there isn't such moment of time "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", when the music doesn't play any longer. It is guaranteed that "},{"kind":"math_inline","text":"vi < vi + 1"},{"kind":"math_inline","text":"(i < m)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The moment of time "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" means that Eugeny wants to know which song was playing during the "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":"-th munite from the start of listening to the playlist."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number must equal the number of the song that was playing during the "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":"-th minute after Eugeny started listening to the play list."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n2 8\n1 16\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 9\n1 2\n2 1\n1 1\n2 2\n1 2 3 4 5 6 7 8 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n2\n2\n3\n4\n4\n4\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"302B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/302/problem/B"}