{"assets":[],"contentKind":"statement","contestId":"34","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Road Map"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities in Berland. Each city has its index — an integer number from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The capital has index "},{"kind":"math_inline","text":"r1"},{"kind":"text","text":". All the roads in Berland are two-way. The road system is such that there is exactly one path from the capital to each city, i.e. the road map looks like a tree. In Berland's chronicles the road map is kept in the following way: for each city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", different from the capital, there is kept number "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" — index of the last city on the way from the capital to "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Once the king of Berland Berl XXXIV decided to move the capital from city "},{"kind":"math_inline","text":"r1"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"r2"},{"kind":"text","text":". Naturally, after this the old representation of the road map in Berland's chronicles became incorrect. Please, help the king find out a new representation of the road map in the way described above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 5·104, 1 ≤ r1 ≠ r2 ≤ n"},{"kind":"text","text":") — amount of cities in Berland, index of the old capital and index of the new one, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following line contains "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" space-separated integers — the old representation of the road map. For each city, apart from "},{"kind":"math_inline","text":"r1"},{"kind":"text","text":", there is given integer "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" — index of the last city on the way from the capital to city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". All the cities are described in order of increasing indexes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" numbers — new representation of the road map in the same format."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 3\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 3 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2 4\n6 1 2 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6 4 1 4 2 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"34D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/34/problem/D"}