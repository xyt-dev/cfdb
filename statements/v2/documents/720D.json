{"assets":["/statement-assets/b6b599e0ed0a306721a11ef8b8d8d19e5f06c6b3aaa5ea41b2ef414c36ba86ca.png","/statement-assets/727245a4940550fe5ac189d13b10959127de9e35390eb3e549a4b0e9bdc6f213.png","/statement-assets/41e8e4005718d4f4098929988c0c4eb46bdd337e3918095a23c55bd298c09bdf.png"],"contentKind":"statement","contestId":"720","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Slalom"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little girl Masha likes winter sports, today she's planning to take part in slalom skiing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The track is represented as a grid composed of "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" squares. There are rectangular obstacles at the track, composed of grid squares. Masha must get from the square "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" to the square "},{"kind":"math_inline","text":"(n, m)"},{"kind":"text","text":". She can move from a square to adjacent square: either to the right, or upwards. If the square is occupied by an obstacle, it is not allowed to move to that square."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One can see that each obstacle can actually be passed in two ways: either it is to the right of Masha's path, or to the left. Masha likes to try all ways to do things, so she would like to know how many ways are there to pass the track. Two ways are considered different if there is an obstacle such that it is to the right of the path in one way, and to the left of the path in the other way."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Masha to find the number of ways to pass the track. The number of ways can be quite big, so Masha would like to know it modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The pictures below show different ways to pass the track in sample tests. "},{"attrs":{"alt":"","src":"/statement-assets/b6b599e0ed0a306721a11ef8b8d8d19e5f06c6b3aaa5ea41b2ef414c36ba86ca.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/727245a4940550fe5ac189d13b10959127de9e35390eb3e549a4b0e9bdc6f213.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/41e8e4005718d4f4098929988c0c4eb46bdd337e3918095a23c55bd298c09bdf.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input data contains three positive integers: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n, m ≤ 106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ 105"},{"kind":"text","text":") — the size of the track and the number of obstacles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contain four positive integers each: "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x1 ≤ x2 ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ y1 ≤ y2 ≤ m"},{"kind":"text","text":") — coordinates of bottom left, and top right squares of the obstacle. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there are no obstacles at squares "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(n, m)"},{"kind":"text","text":", and no obstacles overlap (but some of them may touch)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one integer — the number of ways to pass the track modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5 1\n2 2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5 3\n2 2 2 3\n4 2 5 2\n4 4 4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"720D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/720/problem/D"}