{"assets":[],"contentKind":"statement","contestId":"2011","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Split the Expression"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ of the form "},{"children":[{"kind":"text","text":"<block of digits>+<block of digits>+...+<block of digits>"}],"kind":"container"},{"kind":"text","text":". Every block of digits consists of at least $$$2$$$ and at most $$$13$$$ digits; every digit is from $$$1$$$ to $$$9$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to split this string into expressions of the form "},{"children":[{"kind":"text","text":"<integer>+<integer>"}],"kind":"container"},{"kind":"text","text":". Every expression must be a contiguous part of the given string, and every character of the given string must belong to exactly one expression. For example, if you have a string "},{"children":[{"kind":"text","text":"123+456+789+555"}],"kind":"container"},{"kind":"text","text":", then:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" you are allowed to split it into "},{"children":[{"kind":"text","text":"123+4"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"56+7"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"89+555"}],"kind":"container"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" you are not allowed to split it into "},{"children":[{"kind":"text","text":"123+456"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"+789+555"}],"kind":"container"},{"kind":"text","text":", since the second part begins with a "},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":" sign; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" you are not allowed to split it into "},{"children":[{"kind":"text","text":"123+4"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"56+7"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"8"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"9+555"}],"kind":"container"},{"kind":"text","text":", since the third part does not contain a "},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":" sign; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" you are not allowed to split it into "},{"children":[{"kind":"text","text":"123+456+78"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"9+555"}],"kind":"container"},{"kind":"text","text":", since the first part contains two "},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":" signs. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Among all allowed ways to split the string, find one which maximizes the sum of results of all expressions you get, and print this sum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 100$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of one line containing the string $$$s$$$ ($$$5 \\le |s| \\le 10