{"assets":[],"contentKind":"statement","contestId":"72","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Perse-script"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"7 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Two good friends were trying to make a new programming language called Perse-script."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The most important part of this language is "},{"children":[{"kind":"text","text":"strings"}],"kind":"container"},{"kind":"text","text":". A string in Perse-script is put between characters "},{"children":[{"kind":"text","text":"\""}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So for example "},{"children":[{"kind":"text","text":"\"Hello\""}],"kind":"container"},{"kind":"text","text":" is a string. But "},{"children":[{"kind":"text","text":"Hello"}],"kind":"container"},{"kind":"text","text":" is a variable name or a keyword, which are not considered in this problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Perse-script is function-based. So there are no operators in this language. For example for summing two numbers you have to write "},{"children":[{"kind":"text","text":"sum(a,b)"}],"kind":"container"},{"kind":"text","text":" and not "},{"children":[{"kind":"text","text":"a+b"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are several functions for working on strings. These include: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"concat(x,y)"}],"kind":"container"},{"kind":"text","text":" is a function which gets two strings "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" and puts "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" at the end of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and returns the result. For example "},{"children":[{"kind":"text","text":"concat(\"Hello\",\"World\")"}],"kind":"container"},{"kind":"text","text":" returns "},{"children":[{"kind":"text","text":"\"HelloWorld\""}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"reverse(x)"}],"kind":"container"},{"kind":"text","text":" gets a single string "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and reverses it. For example "},{"children":[{"kind":"text","text":"reverse(\"Hello\")"}],"kind":"container"},{"kind":"text","text":" returns "},{"children":[{"kind":"text","text":"\"olleH\""}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"substr(x,a,b)"}],"kind":"container"},{"kind":"text","text":" gets a string "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a ≤ b ≤ n"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the length of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"). And returns the substring of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" between indexes "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", inclusive. For example "},{"children":[{"kind":"text","text":"substr(\"Hello\",2,4)"}],"kind":"container"},{"kind":"text","text":" returns "},{"children":[{"kind":"text","text":"\"ell\""}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"substr(x,a,b,c)"}],"kind":"container"},{"kind":"text","text":" is another version of substr which works just like the last one but "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" is the step of adding. "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"positive"}],"kind":"container"},{"kind":"text","text":". For example "},{"children":[{"kind":"text","text":"substr(\"HelloWorld\",1,10,2)"}],"kind":"container"},{"kind":"text","text":" returns "},{"children":[{"kind":"text","text":"\"Hlool\""}],"kind":"container"},{"kind":"text","text":". This substr means that you put the "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"th character , and then every "},{"kind":"math_inline","text":"c"},{"kind":"text","text":"th character until you reach "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You're going to manipulate the string part of Perse-script. Given a string expression, you should print its result. It is guaranteed that the expression contains only strings shown by characters "},{"children":[{"kind":"text","text":"\""}],"kind":"container"},{"kind":"text","text":" and the above functions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Commands in Perse-script are case-insensitive. So to call "},{"children":[{"kind":"text","text":"substr"}],"kind":"container"},{"kind":"text","text":" function you can write "},{"children":[{"kind":"text","text":"SUBsTr()"}],"kind":"container"},{"kind":"text","text":". But you can't print as the result "},{"children":[{"kind":"text","text":"\"hElLo\""}],"kind":"container"},{"kind":"text","text":" instead of printing "},{"children":[{"kind":"text","text":"\"Hello\""}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"See the samples for more information."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line containing the correct expression. It is guaranteed that the total length of this expression does not exceed "},{"kind":"math_inline","text":"103"},{"kind":"text","text":" and that all the integers used in it are less than or equal to "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" by absolute value. The given string is non-empty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All strings in the input which are placed between "},{"children":[{"kind":"text","text":"\""}],"kind":"container"},{"kind":"text","text":"s consist of uppercase and lowercase Latin letters only."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print in single line the resulting string. It is guaranteed that an answer exists and that the length of the answer does not exceed "},{"kind":"math_inline","text":"104"},{"kind":"text","text":". It is guaranteed that the answer is non-empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\"HelloWorld\"\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\"HelloWorld\"\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"REVerse(substr(\"helloworld\",1,5))\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\"olleh\"\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"conCAT(rEveRSE(\"olleh\"),\"world\")\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\"helloworld\"\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"reversE(concAT(substr(\"hello\",1,2),sUbstr(\"world\",1,5,1)))\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\"dlroweh\"\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"suBstr(\"Noruz\",1,4,2)\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\"Nr\"\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"72D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/72/problem/D"}