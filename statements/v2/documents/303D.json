{"assets":[],"contentKind":"statement","contestId":"303","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Rotatable Number"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bike is a smart boy who loves math very much. He invented a number called \"Rotatable Number\" inspired by "},{"kind":"math_inline","text":"142857"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As you can see, "},{"kind":"math_inline","text":"142857"},{"kind":"text","text":" is a magic number because any of its rotatings can be got by multiplying that number by "},{"kind":"math_inline","text":"1, 2, ..., 6"},{"kind":"text","text":" (numbers from one to number's length). Rotating a number means putting its last several digit into first. For example, by rotating number "},{"kind":"math_inline","text":"12345"},{"kind":"text","text":" you can obtain any numbers: "},{"kind":"math_inline","text":"12345, 51234, 45123, 34512, 23451"},{"kind":"text","text":". It's worth mentioning that "},{"children":[{"kind":"text","text":"leading-zeroes"}],"kind":"container"},{"kind":"text","text":" are allowed. So both "},{"kind":"math_inline","text":"4500123"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"0123450"},{"kind":"text","text":" can be obtained by rotating "},{"kind":"math_inline","text":"0012345"},{"kind":"text","text":". You can see why "},{"kind":"math_inline","text":"142857"},{"kind":"text","text":" satisfies the condition. All of the "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" equations are under base "},{"kind":"math_inline","text":"10"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"142857·1 = 142857"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"142857·2 = 285714"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"142857·3 = 428571"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"142857·4 = 571428"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"142857·5 = 714285"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"142857·6 = 857142"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Now, Bike has a problem. He extends \"Rotatable Number\" under any base "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". As is mentioned above, "},{"kind":"math_inline","text":"142857"},{"kind":"text","text":" is a \"Rotatable Number\" under base "},{"kind":"math_inline","text":"10"},{"kind":"text","text":". Another example is "},{"kind":"math_inline","text":"0011"},{"kind":"text","text":" under base 2. All of the "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" equations are under base "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"0011·1 = 0011"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"0011·10 = 0110"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"0011·11 = 1001"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"0011·100 = 1100"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So, he wants to find the largest "},{"kind":"math_inline","text":"b"},{"kind":"math_inline","text":"(1 < b < x)"},{"kind":"text","text":" so that there is a "},{"children":[{"kind":"text","text":"positive"}],"kind":"container"},{"kind":"text","text":" \"Rotatable Number\" (leading-zeroes allowed) of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" under base "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that any time you multiply a rotatable number by numbers from 1 to its length you should get a rotating of that number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains two space-separated integers "},{"kind":"math_inline","text":"n, x"},{"kind":"math_inline","text":"(1 ≤ n ≤ 5·106, 2 ≤ x ≤ 109)"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the largest "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" you found. If no such "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" exists, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" instead. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 11\n"}],"kind":"section"},{"attrs":{"rol