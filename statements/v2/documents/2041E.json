{"assets":["/statement-assets/4cb432d7b417a359d6a5260aba27309ddcb4cde986c18e5ec31f9f3327b97510.png"],"contentKind":"statement","contestId":"2041","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Beautiful Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"attrs":{"alt":"","src":"/statement-assets/4cb432d7b417a359d6a5260aba27309ddcb4cde986c18e5ec31f9f3327b97510.png"},"kind":"image"},{"children":[{"kind":"text","text":"Image generated by ChatGPT 4o."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"A-Ming's birthday is coming and his friend A-May decided to give him an integer array as a present. A-Ming has two favorite numbers $$$a$$$ and $$$b$$$, and he thinks an array is "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if its mean is exactly $$$a$$$ and its median is exactly $$$b$$$. Please help A-May find a beautiful array so her gift can impress A-Ming."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The mean of an array is its sum divided by its length. For example, the mean of array $$$[3, -1, 5, 5]$$$ is $$$12 \\div 4 = 3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The median of an array is its middle element after sorting if its length is odd, or the mean of two middle elements after sorting if its length is even. For example, the median of $$$[1, 1, 2, 4, 8]$$$ is $$$2$$$ and the median of $$$[3, -1, 5, 5]$$$ is $$$(3 + 5) \\div 2 = 4$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the mean and median are not rounded to an integer. For example, the mean of array $$$[1, 2]$$$ is $$$1.5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains two integers $$$a$$$ and $$$b$$$."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$-100 \\leq a, b \\leq 100$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The length of the array must be between $$$1$$$ and $$$1000$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The elements of the array must be integers and their absolute values must not exceed $$$10^6$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, print the length of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line, print the elements of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, you can print any. It can be proved that, under the constraints of the problem, a solution always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n3 -1 5 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n-100 -100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n-100\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"2041E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2041/problem/E"}