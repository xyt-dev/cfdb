{"assets":[],"contentKind":"statement","contestId":"148","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Terse princess"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"«Next please», — the princess called and cast an estimating glance at the next groom."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The princess intends to choose the most worthy groom, this is, the richest one. Whenever she sees a groom who is more rich than each of the previous ones, she says a measured «Oh...». Whenever the groom is richer than all previous ones added together, she exclaims «Wow!» (no «Oh...» in this case). At the sight of the first groom the princess stays calm and says nothing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fortune of each groom is described with an integer between 1 and 50000. You know that during the day the princess saw "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" grooms, said «Oh...» exactly "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" times and exclaimed «Wow!» exactly "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" times. Your task is to output a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" describes the fortune of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th groom. If several sequences are possible, output any of them. If no sequence exists that would satisfy all the requirements, output a single number "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of input data contains three integer numbers "},{"kind":"math_inline","text":"n, a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100, 0 ≤ a, b ≤ 15, n > a + b"},{"kind":"text","text":"), separated with single spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output any sequence of integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 50000"},{"kind":"text","text":") is the fortune of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th groom, that satisfies the given constraints. If no sequence exists that would satisfy all the requirements, output a single number "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5 1 3 6 16 35 46 4 200 99"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10 10 6 6 5"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's have a closer look at the answer for the first sample test. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The princess said «Oh...» (highlighted in bold): 5 1 3 "},{"children":[{"kind":"text","text":"6"}],"kind":"container"},{"kind":"text","text":" 16 35 "},{"children":[{"kind":"text","text":"46"}],"kind":"container"},{"kind":"text","text":" 4 200 99. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The princess exclaimed «Wow!» (highlighted in bold): 5 1 3 6 "},{"children":[{"kind":"text","text":"16"}],"kind":"container"},{"children":[{"kind":"text","text":"35"}],"kind":"container"},{"kind":"text","text":" 46 4 "},{"children":[{"kind":"text","text":"200"}],"kind":"container"},{"kind":"text","text":" 99. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"148C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/148/problem/C"}