{"assets":[],"contentKind":"statement","contestId":"235","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. LCM Challenge"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Some days ago, I learned the concept of LCM (least common multiple). I've played with it for several times and I want to make a big number with it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But I also don't want to use many numbers, so I'll choose three positive integers (they don't have to be distinct) which are not greater than "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Can you help me to find the maximum possible least common multiple of these three integers?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":") — the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" mentioned in the statement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maximum possible LCM of three not necessarily distinct positive integers that are not greater than "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"504\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"210\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The least common multiple of some positive integers is the least positive integer which is multiple for each of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The result may become very large, 32-bit integer won't be enough. So using 64-bit integers is recommended."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the last example, we can chose numbers "},{"kind":"math_inline","text":"7"},{"kind":"text","text":", "},{"kind":"math_inline","text":"6"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" and the LCM of them is "},{"kind":"math_inline","text":"7·6·5 = 210"},{"kind":"text","text":". It is the maximum value we can get."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"235A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/235/problem/A"}