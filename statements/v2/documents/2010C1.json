{"assets":[],"contentKind":"statement","contestId":"2010","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C1. Message Transmission Error (easy version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is a simplified version of the problem. It differs from the difficult one only in its constraints."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At the Berland State University, the local network between servers does not always operate without errors. When transmitting two "},{"children":[{"kind":"text","text":"identical"}],"kind":"container"},{"kind":"text","text":" messages consecutively, an error may occur, resulting in the two messages merging into one. In this merging, the end of the first message coincides with the beginning of the second. Of course, the merging can only occur at identical characters. The length of the merging must be a positive number less than the length of the message text."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, when transmitting two messages \""},{"children":[{"kind":"text","text":"abrakadabra"}],"kind":"container"},{"kind":"text","text":"\" consecutively, it is possible that it will be transmitted with the described type of error, resulting in a message like \""},{"children":[{"kind":"text","text":"abrakadabrabrakadabra"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"abrakadabrakadabra"}],"kind":"container"},{"kind":"text","text":"' (in the first case, the merging occurred at one character, and in the second case, at four)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given the received message "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", determine if it is possible that this is the result of an error of the described type in the operation of the local network, and if so, determine a possible value of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A situation where two messages completely overlap each other should not be considered an error. For example, if the received message is \""},{"children":[{"kind":"text","text":"abcd"}],"kind":"container"},{"kind":"text","text":"\", it should be considered that there is no error in it. Similarly, simply appending one message after another is not a sign of an error. For instance, if the received message is \""},{"children":[{"kind":"text","text":"abcabc"}],"kind":"container"},{"kind":"text","text":"\", it should also be considered that there is no error in it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of a single non-empty string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", consisting of lowercase letters of the Latin alphabet. The length of the string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" does not exceed "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the message "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" cannot contain an error, output \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in a single line of output."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, in the first line, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes), and in the next line, output the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" — a possible message that could have led to the error. If there are multiple possible answers, any of them is acceptable."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abrakadabrabrakadabra\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nabrakadabra\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"acacacaca\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nacaca\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abcabc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abababab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nababab\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"tatbt\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second example, a suitable answer could also be the string \""},{"children":[{"kind":"text","text":"acacaca"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C1","problemCode":"2010C1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2010/problem/C1"}