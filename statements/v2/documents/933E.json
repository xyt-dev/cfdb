{"assets":["/statement-assets/9ae26978d6320eb81397b38da07ac64e6da5957a9506e90b09fab81aaac8d231.png","/statement-assets/51061faf59d794cea8ae03504a6d04c30027e34b6de67ed549c686af745b83a8.png"],"contentKind":"statement","contestId":"933","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. A Preponderant Reunion"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"East or west, home is best. That's why family reunion, the indispensable necessity of Lunar New Year celebration, is put in such a position."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the reunion dinner, Little Tommy plays a game with the family. Here is a concise introduction to this game: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" There is a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" non-negative integers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" in the beginning. It is ruled that each integer in this sequence should be non-negative "},{"children":[{"kind":"text","text":"at any time"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" You can select two "},{"children":[{"kind":"text","text":"consecutive positive"}],"kind":"container"},{"kind":"text","text":" integers in this sequence, "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"pi + 1"},{"kind":"math_inline","text":"(1 ≤ i < n)"},{"kind":"text","text":", and then decrease them by their minimum (i. e. "},{"kind":"math_inline","text":"min(pi, pi + 1)"},{"kind":"text","text":"), the cost of this operation is equal to "},{"kind":"math_inline","text":"min(pi, pi + 1)"},{"kind":"text","text":". We call such operation as a "},{"children":[{"kind":"text","text":"descension"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The game immediately ends when there are no two consecutive positive integers. Your task is to end the game so that the total cost of your operations is as small as possible. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Obviously, every game ends after at most "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" descensions. Please share your solution of this game with the lowest cost."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 3·105)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"math_inline","text":"(0 ≤ pi ≤ 109, i = 1, 2, ..., n)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print one integer as the number of descensions "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(0 ≤ m ≤ n - 1)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines print the descensions chronologically. More precisely, in each line of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines print one integer "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i < n)"},{"kind":"text","text":" representing a descension would operate on "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"pi + 1"},{"kind":"text","text":" such that all the descensions could be utilized from top to bottom."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are many possible solutions to reach the minimal cost, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 1 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2 2 1 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n2\n1\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, one possible best solution is "},{"attrs":{"alt":"","src":"/statement-assets/9ae26978d6320eb81397b38da07ac64e6da5957a9506e90b09fab81aaac8d231.png"},"kind":"image"},{"kind":"text","text":", of which the cost is "},{"kind":"math_inline","text":"1 + 1 = 2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, one possible best solution is "},{"attrs":{"alt":"","src":"/statement-assets/51061faf59d794cea8ae03504a6d04c30027e34b6de67ed549c686af745b83a8.png"},"kind":"image"},{"kind":"text","text":", of which the cost is "},{"kind":"math_inline","text":"1 + 1 + 1 = 3"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"933E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/933/problem/E"}