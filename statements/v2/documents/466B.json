{"assets":[],"contentKind":"statement","contestId":"466","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Wonder Room"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The start of the new academic year brought about the problem of accommodation students into dormitories. One of such dormitories has a "},{"kind":"math_inline","text":"a × b"},{"kind":"text","text":" square meter wonder room. The caretaker wants to accommodate exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students there. But the law says that there must be at least 6 square meters per student in a room (that is, the room for "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students must have the area of at least "},{"kind":"math_inline","text":"6n"},{"kind":"text","text":" square meters). The caretaker can enlarge any (possibly both) side of the room by an arbitrary positive integer of meters. Help him change the room so as all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students could live in it and the total area of the room was as small as possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, a, b ≤ 109"},{"kind":"text","text":") — the number of students and the sizes of the room."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print three integers "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b1"},{"kind":"math_inline","text":"(a ≤ a1; b ≤ b1)"},{"kind":"text","text":" — the final area of the room and its sizes. If there are multiple optimal solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"18\n3 6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"16\n4 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"466B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/466/problem/B"}