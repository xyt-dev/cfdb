{"assets":["/statement-assets/210f9df0b3d74a9ddeae0b1024d9b91b98b9f4b4359e1b432025f7b1eed344bd.png"],"contentKind":"statement","contestId":"237","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Young Table"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got table "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows, numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line of table "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" contains "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" cells, at that for all "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 < i ≤ n)"},{"kind":"text","text":" holds "},{"kind":"math_inline","text":"ci ≤ ci - 1"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's denote "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" as the total number of cells of table "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", that is, "},{"attrs":{"alt":"","src":"/statement-assets/210f9df0b3d74a9ddeae0b1024d9b91b98b9f4b4359e1b432025f7b1eed344bd.png"},"kind":"image"},{"kind":"text","text":". We know that each cell of the table contains a single integer from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", at that all written integers are distinct. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's assume that the cells of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row of table "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" are numbered from 1 to "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":", then let's denote the number written in the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th cell of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row as "},{"kind":"math_inline","text":"ai, j"},{"kind":"text","text":". Your task is to perform several swap operations to rearrange the numbers in the table so as to fulfill the following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i, j"},{"kind":"math_inline","text":"(1 < i ≤ n; 1 ≤ j ≤ ci)"},{"kind":"text","text":" holds "},{"kind":"math_inline","text":"ai, j > ai - 1, j"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i, j"},{"kind":"math_inline","text":"(1 ≤ i ≤ n; 1 < j ≤ ci)"},{"kind":"text","text":" holds "},{"kind":"math_inline","text":"ai, j > ai, j - 1"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In one swap operation you are allowed to choose two different cells of the table and swap the recorded there numbers, that is the number that was recorded in the first of the selected cells before the swap, is written in the second cell after it. Similarly, the number that was recorded in the second of the selected cells, is written in the first cell after the swap."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Rearrange the numbers in the required manner. Note that you are allowed to perform any number of operations, but not more than "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". You do not have to minimize the number of operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 50)"},{"kind":"text","text":" that shows the number of rows in the table. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"ci"},{"kind":"math_inline","text":"(1 ≤ ci ≤ 50; ci ≤ ci - 1)"},{"kind":"text","text":" — the numbers of cells on the corresponding rows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain table "},{"kind":"math_inline","text":"а"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" space-separated integers: the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th integer in this line represents "},{"kind":"math_inline","text":"ai, j"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all the given numbers "},{"kind":"math_inline","text":"ai, j"},{"kind":"text","text":" are positive and do not exceed "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". It is guaranteed that all "},{"kind":"math_inline","text":"ai, j"},{"kind":"text","text":" are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single integer "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(0 ≤ m ≤ s)"},{"kind":"text","text":", representing the number of performed swaps."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines print the description of these swap operations. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print four space-separated integers "},{"kind":"math_inline","text":"xi, yi, pi, qi"},{"kind":"math_inline","text":"(1 ≤ xi, pi ≤ n; 1 ≤ yi ≤ cxi; 1 ≤ qi ≤ cpi)"},{"kind":"text","text":". The printed numbers denote swapping the contents of cells "},{"kind":"math_inline","text":"axi, yi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"api, qi"},{"kind":"text","text":". Note that a swap operation can change the contents of "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" table cells. Print the swaps in the order, in which they should be executed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 2 1\n4 3 5\n6 1\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1 2 2\n2 1 3 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n4\n4 3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1 1 4\n1 2 1 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"237B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/237/problem/B"}