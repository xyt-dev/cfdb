{"assets":["/statement-assets/ba08bf908edd902b9d739232079a3f30768ec4d8ca8e50b4c510192a4791d15b.png","/statement-assets/eb126e047693ee9875c91f1853da8e1725eaf7412580eb659ede25f58eea3b08.png"],"contentKind":"statement","contestId":"335","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Rectangles and Square"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rectangles, labeled 1 through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The corners of rectangles have integer coordinates and their edges are parallel to the "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Oy"},{"kind":"text","text":" axes. The rectangles may touch each other, but they do not overlap (that is, there are no points that belong to the interior of more than one rectangle)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine if there's a non-empty subset of the rectangles that forms a square. That is, determine if there exists a subset of the rectangles and some square for which every point that belongs to the interior or the border of that square belongs to the interior or the border of at least one of the rectangles in the subset, and every point that belongs to the interior or the border of at least one rectangle in the subset belongs to the interior or the border of that square."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of rectangles. Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains a description of a rectangle, with the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th such line describing the rectangle labeled "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". Each rectangle description consists of four integers: "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":" — coordinates of the bottom left and the top right corners ("},{"kind":"math_inline","text":"0 ≤ x1 < x2 ≤ 3000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ y1 < y2 ≤ 3000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"No two rectangles overlap (that is, there are no points that belong to the interior of more than one rectangle)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If such a subset exists, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) on the first line of the output file, followed by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", the number of rectangles in the subset. On the second line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" numbers — the labels of rectangles in the subset in any order. If more than one such subset exists, print any one. If no such subset exists, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n0 0 1 9\n1 0 9 1\n1 8 9 9\n8 1 9 8\n2 2 3 6\n3 2 7 3\n2 6 7 7\n5 3 7 6\n3 3 5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES 5\n5 6 7 8 9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 0 1 9\n1 0 9 1\n1 8 9 9\n8 1 9 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test case looks as follows:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ba08bf908edd902b9d739232079a3f30768ec4d8ca8e50b4c510192a4791d15b.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Note that rectangles 6, 8, and 9 form a square as well, and would be an acceptable answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second test case looks as follows:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/eb126e047693ee9875c91f1853da8e1725eaf7412580eb659ede25f58eea3b08.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"335D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/335/problem/D"}