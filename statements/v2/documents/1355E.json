{"assets":[],"contentKind":"statement","contestId":"1355","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Restorer Distance"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have to restore the wall. The wall consists of $$$N$$$ pillars of bricks, the height of the $$$i$$$-th pillar is initially equal to $$$h_{i}$$$, the height is measured in number of bricks. After the restoration all the $$$N$$$ pillars should have equal heights."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are allowed the following operations:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" put a brick on top of one pillar, the cost of this operation is $$$A$$$;"}],"kind":"list_item"},{"children":[{"kind":"text","text":" remove a brick from the top of one non-empty pillar, the cost of this operation is $$$R$$$;"}],"kind":"list_item"},{"children":[{"kind":"text","text":" move a brick from the top of one non-empty pillar to the top of another pillar, the cost of this operation is $$$M$$$."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You cannot create additional pillars or ignore some of pre-existing pillars even if their height becomes $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimal total cost of restoration, in other words, what is the minimal total cost to make all the pillars of equal height?"}],"kind":"paragraph"}],"kind":"section"},{"a