{"assets":[],"contentKind":"statement","contestId":"645","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Cowslip Collections"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"8 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In an attempt to make peace with the Mischievious Mess Makers, Bessie and Farmer John are planning to plant some flower gardens to complement the lush, grassy fields of Bovinia. As any good horticulturist knows, each garden they plant must have the exact same arrangement of flowers. Initially, Farmer John has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different species of flowers he can plant, with "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" flowers of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th species."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" days, Farmer John will receive a batch of flowers of a new species. On day "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", he will receive "},{"kind":"math_inline","text":"cj"},{"kind":"text","text":" flowers of the same species, but of a different species from those Farmer John already has. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Farmer John, knowing the right balance between extravagance and minimalism, wants exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" species of flowers to be used. Furthermore, to reduce waste, each flower of the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" species Farmer John chooses must be planted in some garden. And each of the gardens must be identical; that is to say that each of the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" chosen species should have an equal number of flowers in each garden. As Farmer John is a proponent of national equality, he would like to create the greatest number of gardens possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After receiving flowers on each of these "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" days, Farmer John would like to know the sum, over all possible choices of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" species, of the maximum number of gardens he could create. Since this could be a large number, you should output your result modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ q ≤ 100 000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines of the input contains an integer "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 1 000 000"},{"kind":"text","text":"), the number of flowers of species "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" Farmer John has initially."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th ("},{"kind":"math_inline","text":"1 ≤ j ≤ q"},{"kind":"text","text":") of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines of the input contains an integer "},{"kind":"math_inline","text":"cj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ cj ≤ 1 000 000"},{"kind":"text","text":"), the number of flowers of a new species Farmer John receives on day "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"After each of the "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" days, output the sum of the maximum possible number of gardens, where the sum is taken over all possible choices of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" species, modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 2\n4\n6\n9\n8\n6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n16\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1 2\n6\n5\n4\n3\n2\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20\n21\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case, after the first day Farmer John has "},{"kind":"math_inline","text":"(4, 6, 9, 8)"},{"kind":"text","text":" of each type of flower, and "},{"kind":"math_inline","text":"k = 3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Choosing "},{"kind":"math_inline","text":"(4, 6, 8)"},{"kind":"text","text":" lets him make "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" gardens, each with "},{"kind":"math_inline","text":"(2, 3, 4)"},{"kind":"text","text":" of each flower, respectively. Choosing "},{"kind":"math_inline","text":"(4, 6, 9)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(4, 9, 8)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(6, 9, 8)"},{"kind":"text","text":" each only let him make one garden, since there is no number of gardens that each species can be evenly split into. So the sum over all choices of "},{"kind":"math_inline","text":"k = 3"},{"kind":"text","text":" flowers is "},{"kind":"math_inline","text":"2 + 1 + 1 + 1 = 5"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the second day, Farmer John has "},{"kind":"math_inline","text":"(4, 6, 9, 8, 6)"},{"kind":"text","text":" of each flower. The sum over all choices is "},{"kind":"math_inline","text":"1 + 2 + 2 + 1 + 1 + 2 + 2 + 3 + 1 + 1 = 16"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample case, "},{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":". With "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" flowers Farmer John can make "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" gardens. So the answers to the queries are "},{"kind":"math_inline","text":"6 + 5 + 4 + 3 + 2 = 20"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"6 + 5 + 4 + 3 + 2 + 1 = 21"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"645F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/645/problem/F"}