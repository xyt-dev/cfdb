{"assets":[],"contentKind":"statement","contestId":"1526","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Kill Anton"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After rejecting $$$10^{100}$$$ data structure problems, Errorgorn is very angry at Anton and decided to kill him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Anton's DNA can be represented as a string $$$a$$$ which only contains the characters \""},{"children":[{"kind":"text","text":"ANTON"}],"kind":"container"},{"kind":"text","text":"\" (there are only $$$4$$$ distinct characters). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Errorgorn can change Anton's DNA into string $$$b$$$ which must be a "},{"children":[{"kind":"text","text":"permutation"}],"kind":"container"},{"kind":"text","text":" of $$$a$$$. However, Anton's body can defend against this attack. In $$$1$$$ second, his body can swap $$$2$$$ "},{"children":[{"kind":"text","text":"adjacent"}],"kind":"container"},{"kind":"text","text":" characters of his DNA to transform it back to $$$a$$$. Anton's body is smart and will use the minimum number of moves."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To maximize the chance of Anton dying, Errorgorn wants to change Anton's DNA the string that maximizes the time for Anton's body to revert his DNA. But since Errorgorn is busy making more data structure problems, he needs your help to find the best string $$$B$$$. Can you help him?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer $$$t$$$ $$$(1 \\leq t \\leq 100000)$$$ — the number of testcases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first and only line of each testcase contains $$$1$$$ string $$$a$$$ ($$$1 \\leq |a| \\leq 100000$$$). $$$a$$$ consists of only the characters \""},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"N"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"O"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$|a|$$$ over all testcases does not exceed $$$100000$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase, print a single string, $$$b$$$. If there are multiple answers, you can output any one of them. $$$b$$$ must be a permutation of the string $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nANTON\nNAAN\nAAAAAA\nOAANTTON\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNNOTA\nAANN\nAAAAAA\nTNNTAOOA\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first testcase, it takes $$$7$$$ seconds for Anton's body to transform "},{"children":[{"kind":"text","text":"NNOTA"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"ANTON"}],"kind":"container"},{"kind":"text","text":": "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"NNOTA"}],"kind":"container"},{"kind":"text","text":" $$$\\to$$$ "},{"children":[{"kind":"text","text":"NNOAT"}],"kind":"container"},{"kind":"text","text":" $$$\\to$$$ "},{"children":[{"kind":"text","text":"NNAOT"}],"kind":"container"},{"kind":"text","text":" $$$\\to$$$ "},{"children":[{"kind":"text","text":"NANOT"}],"kind":"container"},{"kind":"text","text":" $$$\\to$$$ "},{"children":[{"kind":"text","text":"NANTO"}],"kind":"container"},{"kind":"text","text":" $$$\\to$$$ "},{"children":[{"kind":"text","text":"ANNTO"}],"kind":"container"},{"kind":"text","text":" $$$\\to$$$ "},{"children":[{"kind":"text","text":"ANTNO"}],"kind":"container"},{"kind":"text","text":" $$$\\to$$$ "},{"children":[{"kind":"text","text":"ANTON"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that you cannot output strings such as "},{"children":[{"kind":"text","text":"AANTON"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"ANTONTRYGUB"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"AAAAA"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"anton"}],"kind":"container"},{"kind":"text","text":" as it is not a permutation of "},{"children":[{"kind":"text","text":"ANTON"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second testcase, it takes $$$2$$$ seconds for Anton's body to transform "},{"children":[{"kind":"text","text":"AANN"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"NAAN"}],"kind":"container"},{"kind":"text","text":". Note that other strings such as "},{"children":[{"kind":"text","text":"NNAA"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"ANNA"}],"kind":"container"},{"kind":"text","text":" will also be accepted."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1526D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1526/problem/D"}