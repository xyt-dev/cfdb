{"assets":["/statement-assets/a3286f16ab84d8f63d860f1a1fd64f850ecef06af650bdd80a22d5b219fafd6d.png"],"contentKind":"statement","contestId":"405","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Domino Effect"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Chris knows there's no fun in playing dominoes, he thinks it's too random and doesn't require skill. Instead, he decided to play "},{"children":[{"kind":"text","text":"with"}],"kind":"container"},{"kind":"text","text":" the dominoes and make a \"domino show\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Chris arranges "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" dominoes in a line, placing each piece vertically upright. In the beginning, he simultaneously pushes some of the dominoes either to the left or to the right. However, somewhere between every two dominoes pushed in the same direction there is at least one domino pushed in the opposite direction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After each second, each domino that is falling to the left pushes the adjacent domino on the left. Similarly, the dominoes falling to the right push their adjacent dominoes standing on the right. When a vertical domino has dominoes falling on it from both sides, it stays still due to the balance of the forces. The figure shows one possible example of the process."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a3286f16ab84d8f63d860f1a1fd64f850ecef06af650bdd80a22d5b219fafd6d.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Given the initial directions Chris has pushed the dominoes, find the number of the dominoes left standing vertically at the end of the process!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 3000"},{"kind":"text","text":"), the number of the dominoes in the line. The next line contains a character string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character of the string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" is equal to "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\", if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th domino has been pushed to the left; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\", if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th domino has been pushed to the right; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\", if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th domino has not been pushed. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is guaranteed that if "},{"kind":"math_inline","text":"si = sj = "},{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\" and "},{"kind":"math_inline","text":"i < j"},{"kind":"text","text":", then there exists such "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" that "},{"kind":"math_inline","text":"i < k < j"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"sk = "},{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\"; if "},{"kind":"math_inline","text":"si = sj = "},{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\" and "},{"kind":"math_inline","text":"i < j"},{"kind":"text","text":", then there exists such "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" that "},{"kind":"math_inline","text":"i < k < j"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"sk = "},{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer, the number of the dominoes that remain vertical at the end of the process."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"14\n.L.R...LR..L..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nR....\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first example case is shown on the figure. The four pieces that remain standing vertically are highlighted with orange."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example case, all pieces fall down since the first piece topples all the other pieces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the last example case, a single piece has not been pushed in either direction."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"405B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/405/problem/B"}