{"assets":[],"contentKind":"statement","contestId":"466","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Cheap Travel"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ann has recently started commuting by subway. We know that a one ride subway ticket costs "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" rubles. Besides, Ann found out that she can buy a special ticket for "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" rides (she can buy it several times). It costs "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" rubles. Ann did the math; she will need to use subway "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" times. Help Ann, tell her what is the minimum sum of money she will have to spend to make "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rides?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains four space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m, a, b ≤ 1000"},{"kind":"text","text":") — the number of rides Ann has planned, the number of rides covered by the "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ride ticket, the price of a one ride ticket and the price of an "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ride ticket. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum sum in rubles that Ann will need to spend."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample one of the optimal solutions is: each time buy a one ride ticket. There are other optimal solutions. For example, buy three "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ride tickets."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"466A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/466/problem/A"}