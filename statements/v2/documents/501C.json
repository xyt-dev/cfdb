{"assets":[],"contentKind":"statement","contestId":"501","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Misha and Forest"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's define a forest as a non-directed acyclic graph (also without loops and parallel edges). One day Misha played with the forest consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. For each vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" he wrote down two integers, "},{"kind":"math_inline","text":"degreev"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"sv"},{"kind":"text","text":", were the first integer is the number of vertices adjacent to vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", and the second integer is the XOR sum of the numbers of vertices adjacent to "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" (if there were no adjacent vertices, he wrote down "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next day Misha couldn't remember what graph he initially had. Misha has values "},{"kind":"math_inline","text":"degreev"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"sv"},{"kind":"text","text":" left, though. Help him find the number of edges and the edges of the initial graph. It is guaranteed that there exists a forest that corresponds to the numbers written by Misha."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 216"},{"kind":"text","text":"), the number of vertices in the graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the next lines contains numbers "},{"kind":"math_inline","text":"degreei"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ degreei ≤ n - 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ si < 216"},{"kind":"text","text":"), separated by a space."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print number "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", the number of edges of the graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines, each containing two distinct numbers, "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ a ≤ n - 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ b ≤ n - 1"},{"kind":"text","text":"), corresponding to edge "},{"kind":"math_inline","text":"(a, b)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Edges can be printed in any order; vertices of the edge can also be printed in any order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 3\n1 0\n1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 0\n2 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1\n1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n0 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The XOR sum of numbers is the result of bitwise adding numbers modulo "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". This operation exists in many modern programming languages. For example, in languages C++, Java and Python it is represented as \""},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":"\", and in Pascal — as \"xor\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"501C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/501/problem/C"}