{"assets":[],"contentKind":"statement","contestId":"711","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Bus to Udayland"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"ZS the Coder and Chris the Baboon are travelling to Udayland! To get there, they have to get on the special IOI bus. The IOI bus has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows of seats. There are "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" seats in each row, and the seats are separated into pairs by a walkway. When ZS and Chris came, some places in the bus was already occupied."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"ZS and Chris are good friends. They insist to get "},{"children":[{"kind":"text","text":"a pair of neighbouring empty seats"}],"kind":"container"},{"kind":"text","text":". Two seats are considered neighbouring if they are in the same row and in the same pair. Given the configuration of the bus, can you help ZS and Chris determine where they should sit?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 1000)"},{"kind":"text","text":" — the number of rows of seats in the bus."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow. Each line contains exactly "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" characters, the first two of them denote the first pair of seats in the row, the third character denotes the walkway (it always equals '|') and the last two of them denote the second pair of seats in the row. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each character, except the walkway, equals to 'O' or to 'X'. 'O' denotes an empty seat, 'X' denotes an occupied seat. See the sample cases for more details. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is possible for Chris and ZS to sit at neighbouring empty seats, print \"YES\" (without quotes) in the first line. In the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines print the bus configuration, where the characters in the pair of seats for Chris and ZS is changed with characters '+'. Thus the configuration should differ from the input one by exactly two charaters (they should be equal to 'O' in the input and to '+' in the output)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is no pair of seats for Chris and ZS, print \"NO\" (without quotes) in a single line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, you may print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\nOO|OX\nXO|XX\nOX|OO\nXX|OX\nOO|OO\nOO|XX\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n++|OX\nXO|XX\nOX|OO\nXX|OX\nOO|OO\nOO|XX\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nXO|OX\nXO|XX\nOX|OX\nXX|OX\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nXX|XX\nXX|XX\nXO|OX\nXO|OO\nOX|XO\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\nXX|XX\nXX|XX\nXO|OX\nXO|++\nOX|XO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Note that the following is an incorrect configuration for the first sample case because the seats must be in the same pair."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"O+|+X"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"XO|XX"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"OX|OO"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"XX|OX"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"OO|OO"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"OO|XX"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"711A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/711/problem/A"}