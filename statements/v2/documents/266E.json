{"assets":["/statement-assets/ad26707563a5aa4b19d2661ae2b3146722163411d5a3496027edbb70d29dbe9f.png","/statement-assets/a080a0712da8f2bb7e9b699f11a81b0278c3dd6e00431bf74b0d5ff2eb2fc4f4.png","/statement-assets/ccadb41a7db46e3bcdd33f6be6d84cc450961fb5bc806a24f8141b273698580d.png"],"contentKind":"statement","contestId":"266","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. More Queries to Array..."}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got an array, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". Your task is to quickly run the queries of two types:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Assign value "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to all elements from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" inclusive. After such query the values of the elements of array "},{"kind":"math_inline","text":"al, al + 1, ..., ar"},{"kind":"text","text":" become equal to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"kind":"text","text":" Calculate and print sum "},{"attrs":{"alt":"","src":"/statement-assets/ad26707563a5aa4b19d2661ae2b3146722163411d5a3496027edbb70d29dbe9f.png"},"kind":"image"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" doesn't exceed "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". As the value of the sum can be rather large, you should print it modulo "},{"kind":"math_inline","text":"1000000007 (109 + 7)"},{"kind":"text","text":"."}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":"), showing, how many numbers are in the array and the number of queries, correspondingly. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 109"},{"kind":"text","text":") — the initial values of the array elements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries follow, one per line:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The assign query has the following format: \""},{"attrs":{"alt":"","src":"/statement-assets/a080a0712da8f2bb7e9b699f11a81b0278c3dd6e00431bf74b0d5ff2eb2fc4f4.png"},"kind":"image"},{"kind":"text","text":"\", ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n; 0 ≤ x ≤ 109"},{"kind":"text","text":")."}],"kind":"list_item"},{"children":[{"kind":"text","text":" The query to calculate the sum has the following format: \""},{"attrs":{"alt":"","src":"/statement-assets/ccadb41a7db46e3bcdd33f6be6d84cc450961fb5bc806a24f8141b273698580d.png"},"kind":"image"},{"kind":"text","text":"\", ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n; 0 ≤ k ≤ 5"},{"kind":"text","text":")."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"All numbers in the input are integers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query to calculate the sum print an integer — the required sum modulo "},{"kind":"math_inline","text":"1000000007 (109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n5 10 2 1\n? 1 2 1\n= 2 2 0\n? 2 4 3\n= 1 4 1\n? 1 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"25\n43\n1300\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n1000000000 1000000000 1000000000\n? 1 3 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"999999986\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"266E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/266/problem/E"}