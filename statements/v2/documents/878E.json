{"assets":[],"contentKind":"statement","contestId":"878","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Numbers on the blackboard"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers is written on a blackboard. Soon Sasha will come to the blackboard and start the following actions: let "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" be two adjacent numbers ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":" before "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"), then he can remove them and write "},{"kind":"math_inline","text":"x + 2y"},{"kind":"text","text":" instead of them. He will perform these operations until one number is left. Sasha likes big numbers and will get the biggest possible number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nikita wants to get to the blackboard before Sasha and erase some of the numbers. He has "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" options, in the option "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" he erases all numbers to the left of the "},{"kind":"math_inline","text":"li"},{"kind":"text","text":"-th number and all numbers to the right of "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":"-th number, i. e. all numbers between the "},{"kind":"math_inline","text":"li"},{"kind":"text","text":"-th and the "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":"-th, inclusive, remain on the blackboard. For each of the options he wants to know how big Sasha's final number is going to be. This number can be very big, so output it modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, q ≤ 105"},{"kind":"text","text":") — the number of integers on the blackboard and the number of Nikita's options."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ ai ≤ 109"},{"kind":"text","text":") — the sequence on the blackboard."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":"), describing Nikita's options."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each option output Sasha's result modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2 3\n1 3\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"17\n5\n8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n1 2 -3\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1000000006\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n1 1 1 -1\n1 4\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n1000000006\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second sample Nikita doesn't erase anything. Sasha first erases the numbers "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and writes "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". Then he erases "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"-3"}],"kind":"container"},{"kind":"text","text":" and gets "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"109 + 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"878E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/878/problem/E"}