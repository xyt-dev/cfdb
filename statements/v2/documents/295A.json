{"assets":[],"contentKind":"statement","contestId":"295","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Greg and Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Greg has an array "},{"kind":"math_inline","text":"a = a1, a2, ..., an"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" operations. Each operation looks as: "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", "},{"kind":"math_inline","text":"di"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1 ≤ li ≤ ri ≤ n)"},{"kind":"text","text":". To apply operation "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to the array means to increase all array elements with numbers "},{"kind":"math_inline","text":"li, li + 1, ..., ri"},{"kind":"text","text":" by value "},{"kind":"math_inline","text":"di"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Greg wrote down "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" queries on a piece of paper. Each query has the following form: "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1 ≤ xi ≤ yi ≤ m)"},{"kind":"text","text":". That means that one should apply operations with numbers "},{"kind":"math_inline","text":"xi, xi + 1, ..., yi"},{"kind":"text","text":" to the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Greg is wondering, what the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" will be after all the queries are executed. Help Greg."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n, m, k ≤ 105)"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(0 ≤ ai ≤ 105)"},{"kind":"text","text":" — the initial array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain operations, the operation number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is written as three integers: "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", "},{"kind":"math_inline","text":"di"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1 ≤ li ≤ ri ≤ n)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(0 ≤ di ≤ 105)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contain the queries, the query number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is written as two integers: "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1 ≤ xi ≤ yi ≤ m)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The numbers in the lines are separated by single spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On a single line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" — the array after executing all the queries. Separate the printed numbers by spaces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in "},{"children":[{"kind":"text","text":"C++"}],"kind":"container"},{"kind":"text","text":". It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams of the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 3\n1 2 3\n1 2 1\n1 3 2\n2 3 4\n1 2\n1 3\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9 18 17\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":