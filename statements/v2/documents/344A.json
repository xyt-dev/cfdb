{"assets":["/statement-assets/ecde1c7f2cdb4d6a8d611f4f918c21ea7df740971e511e1dd28c4989d951be6d.png"],"contentKind":"statement","contestId":"344","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Magnets"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mad scientist Mike entertains himself by arranging rows of dominoes. He doesn't need dominoes, though: he uses rectangular magnets instead. Each magnet has two poles, positive (a \"plus\") and negative (a \"minus\"). If two magnets are put together at a close distance, then the like poles will repel each other and the opposite poles will attract each other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mike starts by laying one magnet horizontally on the table. During each following step Mike adds one more magnet horizontally to the right end of the row. Depending on how Mike puts the magnet on the table, it is either attracted to the previous one (forming a group of multiple magnets linked together) or repelled by it (then Mike lays this magnet at some distance to the right from the previous one). We assume that a sole magnet not linked to others forms a group of its own."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ecde1c7f2cdb4d6a8d611f4f918c21ea7df740971e511e1dd28c4989d951be6d.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Mike arranged multiple magnets in a row. Determine the number of groups that the magnets formed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100000"},{"kind":"text","text":") — the number of magnets. Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") contains either characters \""},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":"\", if Mike put the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th magnet in the \"plus-minus\" position, or characters \""},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":"\", if Mike put the magnet in the \"minus-plus\" position."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the single line of the output print the number of groups of magnets."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n10\n10\n10\n01\n10\n10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n01\n01\n10\n10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first testcase corresponds to the figure. The testcase has three groups consisting of three, one and two magnets."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second testcase has two groups, each consisting of two magnets."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"344A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/344/problem/A"}