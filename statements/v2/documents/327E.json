{"assets":[],"contentKind":"statement","contestId":"327","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Axis Walking"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Iahub wants to meet his girlfriend Iahubina. They both live in "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":" axis (the horizontal axis). Iahub lives at point 0 and Iahubina at point "},{"kind":"math_inline","text":"d"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Iahub has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"text","text":". The sum of those numbers is "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". Suppose "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"pn"},{"kind":"text","text":" is a permutation of "},{"kind":"math_inline","text":"{1, 2, ..., n}"},{"kind":"text","text":". Then, let "},{"kind":"math_inline","text":"b1 = ap1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b2 = ap2"},{"kind":"text","text":" and so on. The array b is called a \"route\". There are "},{"kind":"math_inline","text":"n!"},{"kind":"text","text":" different routes, one for each permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Iahub's travel schedule is: he walks "},{"kind":"math_inline","text":"b1"},{"kind":"text","text":" steps on "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":" axis, then he makes a break in point "},{"kind":"math_inline","text":"b1"},{"kind":"text","text":". Then, he walks "},{"kind":"math_inline","text":"b2"},{"kind":"text","text":" more steps on "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":" axis and makes a break in point "},{"kind":"math_inline","text":"b1 + b2"},{"kind":"text","text":". Similarly, at "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th "},{"kind":"math_inline","text":"(1 ≤ j ≤ n)"},{"kind":"text","text":" time he walks "},{"kind":"math_inline","text":"bj"},{"kind":"text","text":" more steps on "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":" axis and makes a break in point "},{"kind":"math_inline","text":"b1 + b2 + ... + bj"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Iahub is very superstitious and has "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers which give him bad luck. He calls a route \"good\" if he never makes a break in a point corresponding to one of those "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" numbers. For his own curiosity, answer how many good routes he can make, modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"). "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 24"},{"kind":"text","text":"). The following line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ k ≤ 2"},{"kind":"text","text":"). The fourth line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" positive integers, representing the numbers that give Iahub bad luck. Each of these numbers does not exceed "},{"kind":"math_inline","text":"109"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the answer of Iahub's dilemma modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"). "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 3 5\n2\n5 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 2 2\n2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first case consider six possible orderings:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" [2, 3, 5]. Iahub will stop at position 2, 5 and 10. Among them, 5 is bad luck for him. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" [2, 5, 3]. Iahub will stop at position 2, 7 and 10. Among them, 7 is bad luck for him. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" [3, 2, 5]. He will stop at the unlucky 5. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" [3, 5, 2]. This is a valid ordering. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" [5, 2, 3]. He got unlucky twice (5 and 7). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" [5, 3, 2]. Iahub would reject, as it sends him to position 5. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second case, note that it is possible that two different ways have the identical set of stopping. In fact, all six possible ways have the same stops: [2, 4, 6], so there's no bad luck for Iahub."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"327E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/327/problem/E"}