{"assets":[],"contentKind":"statement","contestId":"17","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Noldbach problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Nick is interested in prime numbers. Once he read about "},{"children":[{"kind":"text","text":"Goldbach problem"}],"kind":"container"},{"kind":"text","text":". It states that every even integer greater than "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" can be expressed as the sum of two primes. That got Nick's attention and he decided to invent a problem of his own and call it "},{"children":[{"kind":"text","text":"Noldbach problem"}],"kind":"container"},{"kind":"text","text":". Since Nick is interested only in prime numbers, Noldbach problem states that at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" prime numbers from "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" inclusively can be expressed as the sum of three integer numbers: two neighboring prime numbers and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". For example, "},{"children":[{"kind":"text","text":"19"}],"kind":"container"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"11"}],"kind":"container"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", or "},{"children":[{"kind":"text","text":"13"}],"kind":"container"},{"kind":"text","text":" = "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":" + "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two prime numbers are called neighboring if there are no other prime numbers between them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are to help Nick, and find out if he is right or wrong."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 1000"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ k ≤ 1000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" if at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" prime numbers from "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" inclusively can be expressed as it was described above. Otherwise output "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"27 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"45 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the answer is "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" since at least two numbers can be expressed as it was described (for example, 13 and 19). In the second sample the answer is "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" since it is impossible to express 7 prime numbers from 2 to 45 in the desired form."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"17A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/17/problem/A"}