{"assets":[],"contentKind":"statement","contestId":"491","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. New York Hotel"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Think of New York as a rectangular grid consisting of "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" vertical avenues numerated from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" horizontal streets numerated "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"M"},{"kind":"text","text":". "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" friends are staying at "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" hotels located at some street-avenue crossings. They are going to celebrate birthday of one of them in the one of "},{"kind":"math_inline","text":"H"},{"kind":"text","text":" restaurants also located at some street-avenue crossings. They also want that the maximum distance covered by one of them while traveling to the restaurant to be minimum possible. Help friends choose optimal restaurant for a celebration."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Suppose that the distance between neighboring crossings are all the same equal to one kilometer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":