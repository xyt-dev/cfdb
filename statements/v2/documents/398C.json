{"assets":["/statement-assets/d0fbb58f35ae8f6a74cb84f4b606419fedf852a2538890a37bfdc5e4a61e8533.png","/statement-assets/68f88e50c23f568c17cbc1c7b04a3cd7d12747829c007de228d0b579c1787709.png","/statement-assets/b627fecf641c1b4537c527aec3cb5f55ed92900c1ca8fe7f6d16ae78387f3d90.png"],"contentKind":"statement","contestId":"398","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Tree and Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"User ainta likes trees. This time he is going to make an undirected tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices numbered by integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The tree is weighted, so each edge of the tree will have some integer weight."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also he has an array "},{"kind":"math_inline","text":"t"},{"kind":"text","text":": "},{"kind":"math_inline","text":"t[1], t[2], ..., t[n]"},{"kind":"text","text":". At first all the elements of the array are initialized to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". Then for each edge connecting vertices "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"u < v"},{"kind":"text","text":") of the tree with weight "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", ainta adds value "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" to the elements "},{"kind":"math_inline","text":"t[u], t[u + 1], ..., t[v - 1], t[v]"},{"kind":"text","text":" of array "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's assume that "},{"kind":"math_inline","text":"d(u, v)"},{"kind":"text","text":" is the total weight of edges on the shortest path between vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". User ainta calls a pair of integers "},{"kind":"math_inline","text":"x, y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x < y ≤ n"},{"kind":"text","text":") "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if and only if "},{"kind":"math_inline","text":"d(x, y) = t[x] + t[x + 1] + ... + t[y - 1] + t[y]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"User ainta wants to make at least "},{"attrs":{"alt":"","src":"/statement-assets/d0fbb58f35ae8f6a74cb84f4b606419fedf852a2538890a37bfdc5e4a61e8533.png"},"kind":"image"},{"kind":"text","text":" good pairs, but he couldn't make a proper tree. Help ainta to find such a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"5 ≤ n ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines containing the description of the edges. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line should contain three space-separated integers "},{"kind":"math_inline","text":"ui, vi, ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui < vi ≤ n; 1 ≤ ci ≤ 105"},{"kind":"text","text":") — two vertices connected by the edge, and the weight of the edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next print "},{"attrs":{"alt":"","src":"/statement-assets/d0fbb58f35ae8f6a74cb84f4b606419fedf852a2538890a37bfdc5e4a61e8533.png"},"kind":"image"},{"kind":"text","text":" lines containing the good pairs. The "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th line should contain two space-separated integers "},{"kind":"math_inline","text":"xk"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yk"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xk < yk ≤ n"},{"kind":"text","text":"). Of course, "},{"kind":"math_inline","text":"xk, yk"},{"kind":"text","text":" must be a good pair. All pairs should be distinct — that is, for all "},{"kind":"math_inline","text":"j, k"},{"attrs":{"alt":"","src":"/statement-assets/68f88e50c23f568c17cbc1c7b04a3cd7d12747829c007de228d0b579c1787709.png"},"kind":"image"},{"kind":"text","text":", "},{"kind":"math_inline","text":"xj ≠ xk"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"yj ≠ yk"},{"kind":"text","text":" must be satisfied."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are many correct solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 4 1\n1 2 2\n2 3 5\n3 5 3\n2 6 2\n6 7 3\n4 5\n5 6\n5 7"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"math_inline","text":"⌊x⌋"},{"kind":"text","text":" is the largest integer not greater than "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can find the definition of a tree by the following link: "},{"children":[{"kind":"text","text":"http://en.wikipedia.org/wiki/Tree_(graph_theory)"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can also find the definition of the shortest path by the following link: "},{"children":[{"kind":"text","text":"http://en.wikipedia.org/wiki/Shortest_path_problem"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The tree and the array "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in the sample output look like this:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b627fecf641c1b4537c527aec3cb5f55ed92900c1ca8fe7f6d16ae78387f3d90.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"398C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/398/problem/C"}