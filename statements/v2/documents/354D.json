{"assets":["/statement-assets/f71332e5223f127f8dbb736a511ae0eee5265f9c0e5d35b29d7888da45b0a95f.png","/statement-assets/43fa08eb352ebf00c0ef706e7e23006b6c546ee466b4134bf45d27896ea808c4.png","/statement-assets/33ede7bb267413859abd0352a8ddf23c99ff28de98fce3e4e234da7334cdb869.png"],"contentKind":"statement","contestId":"354","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Transferring Pyramid"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya and Petya are using an interesting data storing structure: a pyramid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The pyramid consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row contains "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" cells. Each row is shifted half a cell to the left relative to the previous row. The cells are numbered by integers from 1 to "},{"attrs":{"alt":"","src":"/statement-assets/f71332e5223f127f8dbb736a511ae0eee5265f9c0e5d35b29d7888da45b0a95f.png"},"kind":"image"},{"kind":"text","text":" as shown on the picture below."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An example of a pyramid at "},{"kind":"math_inline","text":"n = 5"},{"kind":"text","text":" is: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/43fa08eb352ebf00c0ef706e7e23006b6c546ee466b4134bf45d27896ea808c4.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"This data structure can perform operations of two types: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Change the value of a specific cell. It is described by three integers: "},{"kind":"math_inline","text":"\"t i v\""},{"kind":"text","text":", where "},{"kind":"math_inline","text":"t = 1"},{"kind":"text","text":" (the type of operation), "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" — the number of the cell to change and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" the value to assign to the cell. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Change the value of some subpyramid. The picture shows a highlighted subpyramid with the top in cell "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". It is described by "},{"kind":"math_inline","text":"s + 2"},{"kind":"text","text":" numbers: "},{"kind":"math_inline","text":"\"t i v1 v2 ... vs\""},{"kind":"text","text":", where "},{"kind":"math_inline","text":"t = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" — the number of the top cell of the pyramid, "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" — the size of the subpyramid (the number of cells it has), "},{"kind":"math_inline","text":"vj"},{"kind":"text","text":" — the value you should assign to the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th cell of the subpyramid. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Formally: a subpyramid with top at the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th cell of the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th row (the "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"-th cell is the second cell of the third row) will contain cells from rows from "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", the "},{"kind":"math_inline","text":"(k + p)"},{"kind":"text","text":"-th row contains cells from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th to the "},{"kind":"math_inline","text":"(i + p)"},{"kind":"text","text":"-th ("},{"kind":"math_inline","text":"0 ≤ p ≤ n - k"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya and Petya had two identical pyramids. Vasya changed some cells in his pyramid and he now wants to send his changes to Petya. For that, he wants to find a sequence of operations at which Petya can repeat all Vasya's changes. Among all possible sequences, Vasya has to pick the minimum one (the one that contains the fewest numbers)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have a pyramid of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows with "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" changed cells. Find the sequence of operations which result in "},{"children":[{"kind":"text","text":"each of the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" changed cells being changed by at least one operation"}],"kind":"container"},{"kind":"text","text":". Among all the possible sequences pick "},{"children":[{"kind":"text","text":"the one that contains the fewest numbers"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, k ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contain the coordinates of the modified cells "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci"},{"kind":"math_inline","text":"(1 ≤ ci ≤ ri ≤ n)"},{"kind":"text","text":" — the row and the cell's number in the row. All cells are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number showing how many numbers the final sequence has."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n3 1\n3 3\n4 1\n4 3\n4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 11\n2 2\n3 1\n4 3\n5 1\n5 2\n5 5\n6 4\n7 2\n7 3\n7 4\n7 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"26\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"One of the possible solutions of the first sample consists of two operations:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"2 4 v4 v7 v8"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"2 6 v6 v9 v10"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The picture shows the changed cells color-highlighted. The subpyramid used by the first operation is highlighted blue and the subpyramid used by the first operation is highlighted yellow: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/33ede7bb267413859abd0352a8ddf23c99ff28de98fce3e4e234da7334cdb869.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"354D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/354/problem/D"}