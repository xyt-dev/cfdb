{"assets":[],"contentKind":"statement","contestId":"1428","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. ABBB"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Zookeeper is playing a game. In this game, Zookeeper must use bombs to bomb a string that consists of letters '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"'. He can use bombs to bomb a substring which is either \""},{"children":[{"kind":"text","text":"AB"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"BB"}],"kind":"container"},{"kind":"text","text":"\". When he bombs such a substring, the substring gets deleted from the string and the remaining parts of the string get concatenated."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, Zookeeper can use two such operations: "},{"children":[{"kind":"text","text":"AAB"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"AB"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"BA"}],"kind":"container"},{"kind":"text","text":" $$$\\to$$$ "},{"children":[{"kind":"text","text":"AA"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"BB"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" $$$\\to$$$ "},{"children":[{"kind":"text","text":"AAA"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Zookeeper wonders what the shortest string he can make is. Can you help him find the length of the shortest string?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains a single integer $$$t$$$ $$$(1 \\leq t \\leq 20000)$$$  — the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$t$$$ lines contains a single test case each, consisting of a non-empty string $$$s$$$: the string that Zookeeper needs to bomb. It is guaranteed that all symbols of $$$s$$$ are either '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$|s|$$$ (length of $$$s$$$) among all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single integer: the length of the shortest string that Zookeeper can make."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\nAAA\nBABA\nAABBBABBBB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"childr