t":"i"},{"kind":"text","text":"-th row and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Okabe determine whether a given lab is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":"!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains the integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50"},{"kind":"text","text":") — the size of the lab. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers denoting a row of the grid. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th integer in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row is "},{"kind":"math_inline","text":"ai, j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, j ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" if the given lab is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" and \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output each letter in upper or lower case."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"childr