{"assets":["/statement-assets/795dd53d56a520ca67cef92e9b657a697f32905d6bf36d514cf2c253b13b0820.png"],"contentKind":"statement","contestId":"1223","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. CME"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's denote "},{"children":[{"kind":"text","text":"correct match equation"}],"kind":"container"},{"kind":"text","text":" (we will denote it as CME) an equation $$$a + b = c$$$ there all integers $$$a$$$, $$$b$$$ and $$$c$$$ are greater than zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, equations $$$2 + 2 = 4$$$ ("},{"children":[{"kind":"text","text":"||+||=||||"}],"kind":"container"},{"kind":"text","text":") and $$$1 + 2 = 3$$$ ("},{"children":[{"kind":"text","text":"|+||=|||"}],"kind":"container"},{"kind":"text","text":") are CME but equations $$$1 + 2 = 4$$$ ("},{"children":[{"kind":"text","text":"|+||=||||"}],"kind":"container"},{"kind":"text","text":"), $$$2 + 2 = 3$$$ ("},{"children":[{"kind":"text","text":"||+||=|||"}],"kind":"container"},{"kind":"text","text":"), and $$$0 + 1 = 1$$$ ("},{"children":[{"kind":"text","text":"+|=|"}],"kind":"container"},{"kind":"text","text":") are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, you have $$$n$$$ matches. You want to assemble a CME using "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" your matches. Unfortunately, it is possible that you can't assemble the CME using all matches. But you can buy some extra matches and then assemble CME!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if $$$n = 2$$$, you can buy two matches and assemble "},{"children":[{"kind":"text","text":"|+|=||"}],"kind":"container"},{"kind":"text","text":", and if $$$n = 5$$$ you can buy one match and assemble "},{"children":[{"kind":"text","text":"||+|=|||"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/795dd53d56a520ca67cef92e9b657a697f32905d6bf36d514cf2c253b13b0820.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Calculate the minimum number of matches which you have to buy for assembling CME."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note, that you have to answer $$$q$$$ independent queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$q$$$ ($$$1 \\le q \\le 100$$$) — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each query contains one integer $$$n$$$ ($$$2 \\le n \\le 10^9$$$) — the number of matches."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print one integer in single line — the minimum number of matches which you have to buy for assembling CME. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n2\n5\n8\n11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n1\n0\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and second queries are explained in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third query, you can assemble $$$1 + 3 = 4$$$ ("},{"children":[{"kind":"text","text":"|+|||=||||"}],"kind":"container"},{"kind":"text","text":") without buying matches."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth query, buy one match and assemble $$$2 + 4 = 6$$$ ("},{"children":[{"kind":"text","text":"||+||||=||||||"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1223A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1223/problem/A"}