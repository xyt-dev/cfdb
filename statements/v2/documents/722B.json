{"assets":[],"contentKind":"statement","contestId":"722","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Verse Pattern"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a text consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines. Each line contains some space-separated words, consisting of lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We define a syllable as a string that contains exactly one vowel and any arbitrary number (possibly none) of consonants. In English alphabet following letters are considered to be vowels: '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"i"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"u"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"y"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each word of the text that contains at least one vowel can be divided into syllables. Each character should be a part of exactly one syllable. For example, the word \""},{"children":[{"kind":"text","text":"mamma"}],"kind":"container"},{"kind":"text","text":"\" can be divided into syllables as \""},{"children":[{"kind":"text","text":"ma"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"mma"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"mam"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"ma"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"mamm"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\". Words that consist of only consonants should be ignored."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The verse patterns for the given text is a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":". Text matches the given verse pattern if for each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" one can divide words of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line in syllables in such a way that the total number of syllables is equal to "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the text and the verse pattern. Check, if the given text matches the given verse pattern."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of lines in the text."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains integers "},{"kind":"math_inline","text":"p1, ..., pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ pi ≤ 100"},{"kind":"text","text":") — the verse pattern."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the text itself. Text consists of lowercase English letters and spaces. It's guaranteed that all lines are non-empty, each line starts and ends with a letter and words are separated by exactly one space. The length of each line doesn't exceed "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the given text matches the given verse pattern, then print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in the only line of the output. Otherwise, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 2 3\nintel\ncode\nch allenge\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 3 1\na\nbcdefghi\njklmnopqrstu\nvwxyz\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n13 11 15 15\nto be or not to be that is the question\nwhether tis nobler in the mind to suffer\nthe slings and arrows of outrageous fortune\nor to take arms against a sea of troubles\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, one can split words into syllables in the following way: "}],"kind":"paragraph"},{"kind":"code_block","text":"in-tel\nco-de\nch al-len-ge\n"},{"children":[{"kind":"text","text":"Since the word \""},{"children":[{"kind":"text","text":"ch"}],"kind":"container"},{"kind":"text","text":"\" in the third line doesn't contain vowels, we can ignore it. As the result we get "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" syllabels in first two lines and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" syllables in the third one."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"722B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/722/problem/B"}