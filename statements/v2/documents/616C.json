{"assets":[],"contentKind":"statement","contestId":"616","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. The Labyrinth"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a rectangular field of "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" cells. Each cell is either empty or impassable (contains an obstacle). Empty cells are marked with '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"', impassable cells are marked with '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"'. Let's call two empty cells "},{"children":[{"kind":"text","text":"adjacent"}],"kind":"container"},{"kind":"text","text":" if they share a side."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a "},{"children":[{"kind":"text","text":"connected component"}],"kind":"container"},{"kind":"text","text":" any non-extendible set of cells such that any two of them are connected by the path of adjacent cells. It is a typical well-known definition of a connected component."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each impassable cell "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" imagine that it is an empty cell (all other cells remain unchanged) and find the size (the number of cells) of the connected component which contains "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":". You should do it for each impassable cell independently."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer should be printed as a matrix with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" columns. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th symbol of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row should be \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" if the cell is empty at the start. Otherwise the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th symbol of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row should contain the only digit —- the answer modulo "},{"kind":"math_inline","text":"10"},{"kind":"text","text":". The matrix should be printed without any spaces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To make your output faster it is recommended to build the output as an array of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" strings having length "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and print it as a sequence of lines. It will be much faster than writing character-by-character."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As input/output can reach huge size it is recommended to use fast input/output methods: for example, prefer to use "},{"children":[{"kind":"text","text":"scanf/printf"}],"kind":"container"},{"kind":"text","text":" instead of "},{"children":[{"kind":"text","text":"cin/cout"}],"kind":"container"},{"kind":"text","text":" in C++, prefer to use "},{"children":[{"kind":"text","text":"BufferedReader/PrintWriter"}],"kind":"container"},{"kind":"text","text":" instead of "},{"children":[{"kind":"text","text":"Scanner/System.out"}],"kind":"container"},{"kind":"text","text":" in "},{"children":[{"kind":"text","text":"Java"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n, m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 1000"},{"kind":"text","text":") — the number of rows and columns in the field."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" symbols: \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" for empty cells, \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\" for impassable cells."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the answer as a matrix as described above. See the examples to precise the format of the output."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n*.*\n.*.\n*.*\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3.3\n.5.\n3.3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n**..*\n..***\n.*.*.\n*.*.*\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"46..3\n..732\n.6.4.\n5.4.3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In first example, if we imagine that the central cell is empty then it will be included to component of size "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" (cross). If any of the corner cell will be empty then it will be included to component of size "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" (corner)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"616C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/616/problem/C"}