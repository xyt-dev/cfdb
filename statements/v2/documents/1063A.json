{"assets":[],"contentKind":"statement","contestId":"1063","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Oh Those Palindromes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A non-empty string is called "},{"children":[{"kind":"text","text":"palindrome"}],"kind":"container"},{"kind":"text","text":", if it reads the same from the left to the right and from the right to the left. For example, \""},{"children":[{"kind":"text","text":"abcba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"abba"}],"kind":"container"},{"kind":"text","text":"\" are palindromes, while \""},{"children":[{"kind":"text","text":"abab"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"xy"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string is called a "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":" of another string, if it can be obtained from that string by dropping some (possibly zero) number of characters from the beginning and from the end of it. For example, \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\" are substrings of the string \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\", while \""},{"children":[{"kind":"text","text":"ac"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define a "},{"children":[{"kind":"text","text":"palindromic count"}],"kind":"container"},{"kind":"text","text":" of the string as the number of its substrings that are palindromes. For example, the palindromic count of the string \""},{"children":[{"kind":"text","text":"aaa"}],"kind":"container"},{"kind":"text","text":"\" is $$$6$$$ because all its substrings are palindromes, and the palindromic count of the string \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\" is $$$3$$$ because only its substrings of length $$$1$$$ are palindromes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string $$$s$$$. You can arbitrarily rearrange its characters. You goal is to obtain a string with the maximum possible value of palindromic count."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$n$$$ ($$$1 \\le n \\le 100\\,000$$$) — the length of string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains string $$$s$$$ that consists of exactly $$$n$$$ lowercase characters of Latin alphabet."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print string $$$t$$$, which consists of the same set of characters (and each characters appears exactly the same number of times) as string $$$s$$$. Moreover, $$$t$$$ should have the maximum possible value of palindromic count among all such strings strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple such strings, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\noolol\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"ololo\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"16\ngagadbcgghhchbdf\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"abccbaghghghgdfd\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, string \""},{"children":[{"kind":"text","text":"ololo"}],"kind":"container"},{"kind":"text","text":"\" has $$$9$$$ palindromic substrings: \""},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"l"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"l"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"olo"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"lol"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"olo"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ololo"}],"kind":"container"},{"kind":"text","text":"\". Note, that even though some substrings coincide, they are counted as many times as they appear in the resulting string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, the palindromic count of string \""},{"children":[{"kind":"text","text":"abccbaghghghgdfd"}],"kind":"container"},{"kind":"text","text":"\" is $$$29$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1063A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1063/problem/A"}