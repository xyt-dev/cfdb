{"assets":[],"contentKind":"statement","contestId":"72","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Ali goes shopping"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ali Koochooloo is going to buy new clothes since we're reaching Noruz, the ancient Persian festival and the beginning of new Persian year."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When Ali entered a shop, he saw that the shopkeeper was a programmer and since there is no money in programming he had changed his career. The shopkeeper told Ali that he can buy anything for free if he could answer a simple question in "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" seconds. But to see the question Ali has to pay 3 tomans."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ali agreed instantly and the shopkeeper handed him a piece of paper containing the task. The task was indeed very simple. It said: "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Let string "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" be "},{"children":[{"kind":"text","text":"ababababababab"}],"kind":"container"},{"kind":"text","text":". Which non-empty substring of "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is repeated the most times in it?"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ali answered fast. He said the answer is "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":". But the shopkeeper said that Ali is wrong and asked him to read the rest of statement:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"If several substrings have the maximal repeat time, then the substring with maximal length would be the answer, in case of a tie the alphabetically latest substring will be chosen."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So the answer is "},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Ali wants us to solve this problem for different strings. We don't have a great advantage over Ali, we just have a computer and a weird language."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line consisting of a string "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". It is non-empty, made of lower-case Latin letters and contains at most "},{"kind":"math_inline","text":"30"},{"kind":"text","text":" characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains the answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"ab\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abcd\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"abcd\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"72E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/72/problem/E"}