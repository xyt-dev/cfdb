{"assets":["/statement-assets/0f5c4e46f00a8a27b5ebb49a48dc8d3a769f14194b04f7291038f505a4ec6d48.png","/statement-assets/25d28f9205adea7b6414385e0e032a9ea31ac14ca6765947ebae6861c8f5dbe6.png"],"contentKind":"statement","contestId":"870","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Points, Lines and Ready-made Titles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct points on a plane with integral coordinates. For each point you can either draw a vertical line through it, draw a horizontal line through it, or do nothing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You consider several coinciding straight lines as a single one. How many distinct pictures you can get? Print the answer modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of points."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow. The ("},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":")-th of these lines contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ xi, yi ≤ 109"},{"kind":"text","text":") — coordinates of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all points are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of possible distinct pictures modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1\n1 2\n2 1\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"16\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n-1 -1\n0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example there are two vertical and two horizontal lines passing through the points. You can get pictures with any subset of these lines. For example, you can get the picture containing all four lines in two ways (each segment represents a line containing it)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":" The first way: "},{"attrs":{"alt":"","src":"/statement-assets/0f5c4e46f00a8a27b5ebb49a48dc8d3a769f14194b04f7291038f505a4ec6d48.png"},"kind":"image"},{"kind":"text","text":" The second way: "},{"attrs":{"alt":"","src":"/statement-assets/25d28f9205adea7b6414385e0e032a9ea31ac14ca6765947ebae6861c8f5dbe6.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second example you can work with two points independently. The number of pictures is "},{"kind":"math_inline","text":"32 = 9"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"870E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/870/problem/E"}