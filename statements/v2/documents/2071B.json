{"assets":[],"contentKind":"statement","contestId":"2071","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Perfecto"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"A permutation $$$p$$$ of length $$$n$$$$$$^{\\text{∗}}$$$ is "},{"children":[{"kind":"text","text":"perfect"}],"kind":"container"},{"kind":"text","text":" if, for each index $$$i$$$ ($$$1 \\le i \\le n$$$), it satisfies the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The sum of the first $$$i$$$ elements $$$p_1 + p_2 + \\ldots + p_i$$$ is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" a perfect square$$$^{\\text{†}}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You would like things to be perfect. Given a positive integer $$$n$$$, find a "},{"children":[{"kind":"text","text":"perfect"}],"kind":"container"},{"kind":"text","text":" permutation of length $$$n$$$, or print $$$-1$$$ if none exists."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$A permutation of length $$$n$$$ is an array consisting of $$$n$$$ distinct integers from $$$1$$$ to $$$n$$$ in arbitrary order. For example, $$$[2,3,1,5,4]$$$ is a permutation, but $$$[1,2,2]$$$ is not a permutation ($$$2$$$ appears twice in the array), and $$$[1,3,4]$$$ is also not a permutation ($$$n=3$$$ but there is $$$4$$$ in the array). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$^{\\text{†}}$$$A perfect square is an integer that is the square of an integer, e.g., $$$9=3^2$$$ is a perfect square, but $$$8$$$ and $$$14$$$ are not."}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first and only line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 5 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$10^6$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If no solution exists, print a single integer $$$-1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Otherwise, print $$$n$$$ integers $$$p_1,p_2,\\ldots,p_n$$$ — the "},{"children":[{"kind":"text","text":"perfect"}],"kind":"container"},{"kind":"text","text":" permutation you find. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1\n4\n5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n2 4 1 3\n5 1 4 3 2"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, there is only one permutation with length $$$n = 1$$$ that is $$$p = [1]$$$, which is not "},{"children":[{"kind":"text","text":"perfect"}],"kind":"container"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$p_1 = 1 = x^2$$$ for $$$x = 1$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second test case, one possible "},{"children":[{"kind":"text","text":"perfect"}],"kind":"container"},{"kind":"text","text":" permutation with length $$$n = 4$$$ is $$$p = [2, 4, 1, 3]$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$p_1 = 2 \\neq x^2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$p_1 + p_2 = 2 + 4 = 6 \\neq x^2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$p_1 + p_2 + p_3 = 2 + 4 + 1 = 7 \\neq x^2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$p_1 + p_2 + p_3 + p_4 = 2 + 4 + 1 + 3 = 10 \\neq x^2$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the third test case, one possible "},{"children":[{"kind":"text","text":"perfect"}],"kind":"container"},{"kind":"text","text":" permutation with length $$$n = 5$$$ is $$$p = [5, 1, 4, 3, 2]$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$p_1 = 5 \\neq x^2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$p_1 + p_2 = 5 + 1 = 6 \\neq x^2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$p_1 + p_2 + p_3 = 5 + 1 + 4 = 10 \\neq x^2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$p_1 + p_2 + p_3 + p_4 = 5 + 1 + 4 + 3 = 13 \\neq x^2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$p_1 + p_2 + p_3 + p_4 + p_5 = 5 + 1 + 4 + 3 + 2 = 15 \\neq x^2$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"2071B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2071/problem/B"}