{"assets":[],"contentKind":"statement","contestId":"1860","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Balanced String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a binary string $$$s$$$ (a binary string is a string consisting of characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a binary string "},{"children":[{"kind":"text","text":"balanced"}],"kind":"container"},{"kind":"text","text":" if the number of subsequences "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" (the number of indices $$$i$$$ and $$$j$$$ such that $$$1 \\le i \\lt j \\le n$$$, $$$s_i=0$$$ and $$$s_j=1$$$) equals to the number of subsequences "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" (the number of indices $$$k$$$ and $$$l$$$ such that $$$1 \\le k \\lt l \\le n$$$, $$$s_k=1$$$ and $$$s_l=0$$$) in it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the string "},{"children":[{"kind":"text","text":"1000110"}],"kind":"container"},{"kind":"text","text":" is balanced, because both the number of subsequences "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" and the number of subsequences "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" are equal to $$$6$$$. On the other hand, "},{"children":[{"kind":"text","text":"11010"}],"kind":"container"},{"kind":"text","text":" is not balanced, because the number of subsequences "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" is $$$1$$$, but the number of subsequences "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" is $$$5$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can perform the following operation any number of times: choose two characters in $$$s$$$ and swap them. Your task is to calculate the minimum number of operations to make the string $$$s$$$ balanced."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains the string $$$s$$$ ($$$3 \\le |s| \\le 100$$$) consisting of characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraint on the input: the string $$$s$$$ can be made balanced."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum number of swap operations to make the string $$$s$$$ balanced."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n101\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1000110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n11010\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n11001100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the string is already balanced, the number of both "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" is equal to $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, the string is already balanced, the number of both "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" is equal to $$$6$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, one of the possible answers is the following one: "},{"children":[{"kind":"text","text":"11010"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"01110"}],"kind":"container"},{"kind":"text","text":". After that, the number of both "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" is equal to $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example, one of the possible answers is the following one: "},{"children":[{"kind":"text","text":"11001100"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"11001010"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"11000011"}],"kind":"container"},{"kind":"text","text":". After that, the number of both "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"10"}],"kind":"container"},{"kind":"text","text":" is equal to $$$8$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1860D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1860/problem/D"}