{"assets":[],"contentKind":"statement","contestId":"1665","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. MinimizOR"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array $$$a$$$ of $$$n$$$ non-negative integers, numbered from $$$1$$$ to $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define the "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" of the array $$$a$$$ as $$$\\displaystyle \\min_{i \\neq j} a_i | a_j$$$, where $$$|$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#OR"},"children":[{"kind":"text","text":"bitwise OR operation"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are $$$q$$$ queries. For each query you are given two integers $$$l$$$ and $$$r$$$ ($$$l \\lt r$$$). For each query you should find the cost of the subarray $$$a_{l}, a_{l + 1}, \\ldots, a_{r}$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test case consists of several test cases. The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains an integer $$$n$$$ ($$$2 \\le n \\le 10^5$$$) — the length array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$0 \\le a_i \\lt 2^{30}$$$) — the elements of $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line of each test case contains an integer $$$q$$$ ($$$1 \\le q \\le 10^5$$$) — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$q$$$ lines contains two integers $$$l_j$$$, $$$r_j$$$ ($$$1 \\le l_j \\lt r_j \\le n$$$) — the description of the $$$j$$$-th query."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ and the sum of $$$q$$$ over all test cases do not exceed $$$10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print $$$q$$$ numbers, where the $$$j$$$-th number is the cost of array $$$a_{l_j}, a_{l_j + 1}, \\ldots, a_{r_j}$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n5\n6 1 3 2 1\n4\n1 2\n2 3\n2 4\n2 5\n4\n0 2 1 1073741823\n4\n1 2\n2 3\n1 3\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n3\n3\n1\n2\n3\n1\n1073741823\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case the array $$$a$$$ is"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$110_2, 001_2, 011_2, 010_2, 001_2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"That's why the answers for the queries are:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[1; 2]$$$: $$$a_1 | a_2 = 110_2 | 001_2 = 111_2 = 7$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2; 3]$$$: $$$a_2 | a_3 = 001_2 | 011_2 = 011_2 = 3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2; 4]$$$: $$$a_2 | a_3 = a_3 | a_4 = a_2 | a_4 = 011_2 = 3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2; 5]$$$: $$$a_2 | a_5 = 001_2 = 1$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second test case the array $$$a$$$ is"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$00_2, 10_2, 01_2, \\underbrace{11\\ldots 1_2}_{30}$$$ ($$$a_4 = 2^{30} - 1$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"That's why the answers for the queries are:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[1; 2]$$$: $$$a_1 | a_2 = 10_2 = 2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[2; 3]$$$: $$$a_2 | a_3 = 11_2 = 3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[1; 3]$$$: $$$a_1 | a_3 = 01_2 = 1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[3; 4]$$$: $$$a_3 | a_4 = 01_2 | \\underbrace{11\\ldots 1_2}_{30} = 2^{30} - 1 = 1073741823$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1665E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1665/problem/E"}