{"assets":[],"contentKind":"statement","contestId":"556","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Case of Fake Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Andrewid the Android is a galaxy-famous detective. He is now investigating a case of frauds who make fake copies of the famous Stolp's gears, puzzles that are as famous as the Rubik's cube once was."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Its most important components are a button and a line of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" similar gears. Each gear has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" teeth containing all numbers from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" in the counter-clockwise order. When you push a button, the first gear rotates "},{"children":[{"kind":"text","text":"clockwise"}],"kind":"container"},{"kind":"text","text":", then the second gear rotates "},{"children":[{"kind":"text","text":"counter-clockwise"}],"kind":"container"},{"kind":"text","text":", the the third gear rotates "},{"children":[{"kind":"text","text":"clockwise"}],"kind":"container"},{"kind":"text","text":" an so on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Besides, each gear has exactly one active tooth. When a gear turns, a new active tooth is the one following after the current active tooth according to the direction of the rotation. For example, if "},{"kind":"math_inline","text":"n = 5"},{"kind":"text","text":", and the active tooth is the one containing number "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", then clockwise rotation makes the tooth with number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" active, or the counter-clockwise rotating makes the tooth number "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" active."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Andrewid remembers that the real puzzle has the following property: you can push the button multiple times in such a way that in the end the numbers on the active teeth of the gears from first to last form sequence "},{"kind":"math_inline","text":"0, 1, 2, ..., n - 1"},{"kind":"text","text":". Write a program that determines whether the given puzzle is real or fake."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":") — the number of gears."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" digits "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ n - 1"},{"kind":"text","text":") — the sequence of active teeth: the active tooth of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th gear contains number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print "},{"children":[{"kind":"text","text":"\"Yes\""}],"kind":"container"},{"kind":"text","text":" (without the quotes), if the given Stolp's gears puzzle is real, and "},{"children":[{"kind":"text","text":"\"No\""}],"kind":"container"},{"kind":"text","text":" (without the quotes) otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n4 2 1 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 2 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test when you push the button for the first time, the sequence of active teeth will be "},{"children":[{"kind":"text","text":"2 2 1"}],"kind":"container"},{"kind":"text","text":", when you push it for the second time, you get "},{"children":[{"kind":"text","text":"0 1 2"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"556B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/556/problem/B"}