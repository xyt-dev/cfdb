{"assets":[],"contentKind":"statement","contestId":"1789","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Serval and Inversion Magic"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Serval has a string $$$s$$$ that only consists of "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" of length $$$n$$$. The $$$i$$$-th character of $$$s$$$ is denoted as $$$s_i$$$, where $$$1\\leq i\\leq n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Serval can perform the following operation called Inversion Magic on the string $$$s$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose an segment $$$[l, r]$$$ ($$$1\\leq l\\leq r\\leq n$$$). For $$$l\\leq i\\leq r$$$, change $$$s_i$$$ into "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" if $$$s_i$$$ is "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":", and change $$$s_i$$$ into "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" if $$$s_i$$$ is "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, let $$$s$$$ be "},{"children":[{"kind":"text","text":"010100"}],"kind":"container"},{"kind":"text","text":" and the segment $$$[2,5]$$$ is chosen. The string $$$s$$$ will be "},{"children":[{"kind":"text","text":"001010"}],"kind":"container"},{"kind":"text","text":" after performing the Inversion Magic."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Serval wants to make $$$s$$$ a palindrome after performing Inversion Magic "},{"children":[{"kind":"text","text":"exactly once"}],"kind":"container"},{"kind":"text","text":". Help him to determine whether it is possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string is a palindrome iff it reads the same backwards as forwards. For example, "},{"children":[{"kind":"text","text":"010010"}],"kind":"container"},{"kind":"text","text":" is a palindrome but "},{"children":[{"kind":"text","text":"10111"}],"kind":"container"},{"kind":"text","text":" is not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1\\leq t\\leq 10^4$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$2\\leq n\\leq 10^5$$$) — the length of string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a binary string $$$s$$$ of length $$$n$$$. Only characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" can appear in $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2\\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" if $$$s$$$ can be a palindrome after performing Inversion Magic exactly once, and print "},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":" if not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":" in any case (for example, strings "},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" will be recognized as a positive response)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n4\n1001\n5\n10010\n7\n0111011\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYes\nYes\nNo\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, Serval can perform Inversion Magic on the segment $$$[1,4]$$$. The string $$$s$$$ will be "},{"children":[{"kind":"text","text":"0110"}],"kind":"container"},{"kind":"text","text":" after the magic."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, Serval can perform Inversion Magic on the segment $$$[1,3]$$$. The string $$$s$$$ will be "},{"children":[{"kind":"text","text":"01110"}],"kind":"container"},{"kind":"text","text":" after the magic."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, Serval can't make $$$s$$$ a palindrome by performing Inversion Magic exactly once."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1789B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1789/problem/B"}