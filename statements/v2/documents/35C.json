{"assets":[],"contentKind":"statement","contestId":"35","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Fire Again"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"input_channel"},"children":[{"children":[{"kind":"text","text":"input"}],"kind":"container"},{"kind":"text","text":"input.txt"}],"kind":"container"},{"attrs":{"role":"output_channel"},"children":[{"children":[{"kind":"text","text":"output"}],"kind":"container"},{"kind":"text","text":"output.txt"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After a terrifying forest fire in Berland a forest rebirth program was carried out. Due to it "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" rows with "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" trees each were planted and the rows were so neat that one could map it on a system of coordinates so that the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th tree in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row would have the coordinates of "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":". However a terrible thing happened and the young forest caught fire. Now we must find the coordinates of the tree that will catch fire last to plan evacuation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The burning began in "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" points simultaneously, which means that initially "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" trees started to burn. Every minute the fire gets from the burning trees to the ones that aren’t burning and that the distance from them to the nearest burning tree equals to 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the tree that will be the last to start burning. If there are several such trees, output any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains two integers "},{"kind":"math_inline","text":"N, M"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ N, M ≤ 2000"},{"kind":"text","text":") — the size of the forest. The trees were planted in all points of the ("},{"kind":"math_inline","text":"x, y"},{"kind":"text","text":") ("},{"kind":"math_inline","text":"1 ≤ x ≤ N, 1 ≤ y ≤ M"},{"kind":"text","text":") type, "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" are integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains an integer "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ K ≤ 10"},{"kind":"text","text":") — amount of trees, burning in the beginning. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" pairs of integers: "},{"kind":"math_inline","text":"x1, y1, x2, y2, ..., xk, yk"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ N, 1 ≤ yi ≤ M"},{"kind":"text","text":") — coordinates of the points from which the fire started. It is guaranteed that no two points coincide."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a line with two space-separated integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" — coordinates of the tree that will be the last one to start burning. If there are several such trees, output any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n2\n1 1 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 2"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"35C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/35/problem/C"}