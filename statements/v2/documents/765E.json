{"assets":["/statement-assets/babdda60815fb6e1b29716bedc1ab15b93f6148fe854e794d911580e0fd154bc.png"],"contentKind":"statement","contestId":"765","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Tree Folding"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vanya wants to minimize a tree. He can perform the following operation multiple times: choose a vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", and two disjoint (except for "},{"kind":"math_inline","text":"v"},{"kind":"text","text":") paths of equal length "},{"kind":"math_inline","text":"a0 = v"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"ak"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"b0 = v"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b1"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"bk"},{"kind":"text","text":". Additionally, vertices "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"ak"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b1"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"bk"},{"kind":"text","text":" must not have any neighbours in the tree other than adjacent vertices of corresponding paths. After that, one of the paths may be merged into the other, that is, the vertices "},{"kind":"math_inline","text":"b1"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"bk"},{"kind":"text","text":" can be effectively erased:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/babdda60815fb6e1b29716bedc1ab15b93f6148fe854e794d911580e0fd154bc.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Help Vanya determine if it possible to make the tree into a path via a sequence of described operations, and if the answer is positive, also determine the shortest length of such path."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains the number of vertices "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2·105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines describe edges of the tree. Each of these lines contains two space-separated integers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ u, v ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"u ≠ v"},{"kind":"text","text":") — indices of endpoints of the corresponding edge. It is guaranteed that the given graph is a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is impossible to obtain a path, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". Otherwise, print the minimum number of edges in a possible path."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 2\n2 3\n2 4\n4 5\n1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 2\n1 3\n3 4\n1 5\n5 6\n6 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case, a path of three edges is obtained after merging paths "},{"kind":"math_inline","text":"2 - 1 - 6"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2 - 4 - 5"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is impossible to perform any operation in the second sample case. For example, it is impossible to merge paths "},{"kind":"math_inline","text":"1 - 3 - 4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 - 5 - 6"},{"kind":"text","text":", since vertex 6 additionally has a neighbour 7 that is not present in the corresponding path."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"765E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/765/problem/E"}