{"assets":[],"contentKind":"statement","contestId":"609","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Gadgets for dollars and pounds"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Nura wants to buy "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" gadgets. She has only "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" burles for that. She can buy each gadget for dollars or for pounds. So each gadget is selling only for some type of currency. The type of currency and the cost in that currency are not changing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nura can buy gadgets for "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days. For each day you know the exchange rates of dollar and pound, so you know the cost of conversion burles to dollars or to pounds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each day (from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":") Nura can buy some gadgets by current exchange rate. Each day she can buy any gadgets she wants, but each gadget can be bought no more than once during "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Nura to find the minimum day index when she will have "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" gadgets. Nura always pays with burles, which are converted according to the exchange rate of the purchase day. Nura can't buy dollars or pounds, she always stores only burles. Gadgets are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" in order of their appearing in input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains four integers "},{"kind":"math_inline","text":"n, m, k, s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105, 1 ≤ k ≤ m ≤ 2·105, 1 ≤ s ≤ 109"},{"kind":"text","text":") — number of days, total number and required number of gadgets, number of burles Nura has."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 106"},{"kind":"text","text":") — the cost of one dollar in burles on "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ 106"},{"kind":"text","text":") — the cost of one pound in burles on "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ti, ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 2, 1 ≤ ci ≤ 106"},{"kind":"text","text":") — type of the gadget and it's cost. For the gadgets of the first type cost is specified in dollars. For the gadgets of the second type cost is specified in pounds."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If Nura can't buy "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" gadgets print the only line with the number "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise the first line should contain integer "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" — the minimum day index, when Nura will have "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" gadgets. On each of the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines print two integers "},{"kind":"math_inline","text":"qi, di"},{"kind":"text","text":" — the number of gadget and the day gadget should be bought. All values "},{"kind":"math_inline","text":"qi"},{"kind":"text","text":" should be different, but the values "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" can coincide (so Nura can buy several gadgets at one day). The days are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In case there are multiple possible solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4 2 2\n1 2 3 2 1\n3 2 1 2 3\n1 1\n2 1\n1 2\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1\n2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 2 200\n69 70 71 72\n104 105 106 107\n1 1\n2 2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 1 1000000000\n900000 910000 940000 990000\n990000 999000 999900 999990\n1 87654\n2 76543\n1 65432\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"609D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/609/problem/D"}