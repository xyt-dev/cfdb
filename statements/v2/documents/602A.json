{"assets":["/statement-assets/655373c0e34ea1ccc9ee7b7c2cd40a12a6db3f98333e6f455fbe438c9bf7da28.png"],"contentKind":"statement","contestId":"602","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Two Bases"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After seeing the \"ALL YOUR BASE ARE BELONG TO US\" meme for the first time, numbers "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" realised that they have different bases, which complicated their relations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You're given a number "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" represented in base "},{"kind":"math_inline","text":"bx"},{"kind":"text","text":" and a number "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" represented in base "},{"kind":"math_inline","text":"by"},{"kind":"text","text":". Compare those two numbers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bx"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ bx ≤ 40"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the number of digits in the "},{"kind":"math_inline","text":"bx"},{"kind":"text","text":"-based representation of "},{"kind":"math_inline","text":"X"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ xi < bx"},{"kind":"text","text":") — the digits of "},{"kind":"math_inline","text":"X"},{"kind":"text","text":". They are given in the order from the most significant digit to the least significant one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following two lines describe "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" in the same way: the third line contains two space-separated integers "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"by"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 10"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ by ≤ 40"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bx ≠ by"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is the number of digits in the "},{"kind":"math_inline","text":"by"},{"kind":"text","text":"-based representation of "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":", and the fourth line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"y1, y2, ..., ym"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ yi < by"},{"kind":"text","text":") — the digits of "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There will be no leading zeroes. Both "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" will be positive. All digits of both numbers are given in the standard decimal numeral system."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single character (quotes for clarity): "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":"' if "},{"kind":"math_inline","text":"X < Y"}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":"' if "},{"kind":"math_inline","text":"X > Y"}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"="}],"kind":"container"},{"kind":"text","text":"' if "},{"kind":"math_inline","text":"X = Y"}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2\n1 0 1 1 1 1\n2 10\n4 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"=\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 0 2\n2 5\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"<\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 16\n15 15 4 0 0 7 10\n7 9\n4 8 0 3 1 5 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":">\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, "},{"kind":"math_inline","text":"X = 1011112 = 4710 = Y"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, "},{"kind":"math_inline","text":"X = 1023 = 215"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Y = 245 = 1123"},{"kind":"text","text":", thus "},{"kind":"math_inline","text":"X < Y"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, "},{"attrs":{"alt":"","src":"/statement-assets/655373c0e34ea1ccc9ee7b7c2cd40a12a6db3f98333e6f455fbe438c9bf7da28.png"},"kind":"image"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Y = 48031509"},{"kind":"text","text":". We may notice that "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" starts with much larger digits and "},{"kind":"math_inline","text":"bx"},{"kind":"text","text":" is much larger than "},{"kind":"math_inline","text":"by"},{"kind":"text","text":", so "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" is clearly larger than "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"