{"assets":[],"contentKind":"statement","contestId":"444","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. DZY Loves Strings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"DZY loves strings, and he enjoys collecting them."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In China, many people like to use strings containing their names' initials, for example: "},{"children":[{"kind":"text","text":"xyz"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"jcvb"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"dzy"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"dyh"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Once DZY found a lucky string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". A lot of pairs of good friends came to DZY when they heard about the news. The first member of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th pair has name "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", the second one has name "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". Each pair wondered if there is a substring of the lucky string containing both of their names. If so, they want to find the one with minimum length, which can give them good luck and make their friendship last forever."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please help DZY for each pair find the minimum length of the substring of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" that contains both "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", or point out that such substring doesn't exist."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A substring of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a string "},{"kind":"math_inline","text":"slsl + 1... sr"},{"kind":"text","text":" for some integers "},{"kind":"math_inline","text":"l, r"},{"kind":"math_inline","text":"(1 ≤ l ≤ r ≤ |s|)"},{"kind":"text","text":". The length of such the substring is "},{"kind":"math_inline","text":"(r - l + 1)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" contains some another string "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" if there is a substring of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" equal to "},{"kind":"math_inline","text":"q"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a string "},{"kind":"math_inline","text":"s"},{"kind":"math_inline","text":"(1 ≤ |s| ≤ 50000)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a non-negative integer "},{"kind":"math_inline","text":"q"},{"kind":"math_inline","text":"(0 ≤ q ≤ 100000)"},{"kind":"text","text":" — the number of pairs. Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines describes a pair, the line contains two space-separated strings "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"math_inline","text":"(1 ≤ |ai|, |bi| ≤ 4)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all the strings only consist of lowercase English letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each pair, print a line containing a single integer — the minimum length of the required substring. If there is no such substring, output "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"xudyhduxyz\n3\nxyz xyz\ndyh xyz\ndzy xyz\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n8\n-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abcabd\n3\na c\nab abc\nab d\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n3\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"baabcabaaa\n2\nabca baa\naa aba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The shortest substrings in the first sample are: "},{"children":[{"kind":"text","text":"xyz"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"dyhduxyz"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The shortest substrings in the second sample are: "},{"children":[{"kind":"text","text":"ca"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"abd"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The shortest substrings in the third sample are: "},{"children":[{"kind":"text","text":"baabca"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"abaa"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"444D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/444/problem/D"}