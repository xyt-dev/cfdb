{"assets":["/statement-assets/08d0da3c2d8ba99c46e41ba0450982fdc9a753742c7ce3d65721cd4ad07b748e.png","/statement-assets/ffcdfdcfec8e7bf36bc42a913830d7dda465997d6069f9b4de7e7c8ffe60e5a1.png"],"contentKind":"statement","contestId":"744","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Hongcow Masters the Cyclic Shift"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Hongcow's teacher heard that Hongcow had learned about the cyclic shift, and decided to set the following problem for him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a list of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" strings "},{"kind":"math_inline","text":"s1, s2, ..., sn"},{"kind":"text","text":" contained in the list "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A list "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" of strings is called "},{"children":[{"kind":"text","text":"stable"}],"kind":"container"},{"kind":"text","text":" if the following condition holds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First, a "},{"children":[{"kind":"text","text":"message"}],"kind":"container"},{"kind":"text","text":" is defined as a concatenation of some elements of the list "},{"kind":"math_inline","text":"X"},{"kind":"text","text":". You can use an arbitrary element as many times as you want, and you may concatenate these elements in any arbitrary order. Let "},{"kind":"math_inline","text":"SX"},{"kind":"text","text":" denote the set of of all messages you can construct from the list. Of course, this set has infinite size if your list is nonempty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Call a single message "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if the following conditions hold: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Suppose the message is the concatenation of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" strings "},{"kind":"math_inline","text":"w1, w2, ..., wk"},{"kind":"text","text":", where each "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" is an element of "},{"kind":"math_inline","text":"X"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Consider the "},{"kind":"math_inline","text":"|w1| + |w2| + ... + |wk|"},{"kind":"text","text":" cyclic shifts of the string. Let "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" be the number of these cyclic shifts of the string that are elements of "},{"kind":"math_inline","text":"SX"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" A message is good if and only if "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is exactly equal to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The list "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" is called stable if and only if every element of "},{"kind":"math_inline","text":"SX"},{"kind":"text","text":" is good."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let "},{"kind":"math_inline","text":"f(L)"},{"kind":"text","text":" be "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" if "},{"kind":"math_inline","text":"L"},{"kind":"text","text":" is a stable list, and "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the sum of "},{"kind":"math_inline","text":"f(L)"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"L"},{"kind":"text","text":" is a nonempty "},{"children":[{"kind":"text","text":"contiguous sublist"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" (there are "},{"attrs":{"alt":"","src":"/statement-assets/08d0da3c2d8ba99c46e41ba0450982fdc9a753742c7ce3d65721cd4ad07b748e.png"},"kind":"image"},{"kind":"text","text":" contiguous sublists in total)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input will contain a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 30"},{"kind":"text","text":"), denoting the number of strings in the list."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines will each contain a string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/ffcdfdcfec8e7bf36bc42a913830d7dda465997d6069f9b4de7e7c8ffe60e5a1.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer, the number of nonempty "},{"children":[{"kind":"text","text":"contiguous sublists"}],"kind":"container"},{"kind":"text","text":" that are stable."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\na\nab\nb\nbba\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nhh\nee\nll\nll\noo\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\naab\nab\nbba\nb\nab\nc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample, there are "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" sublists to consider. Sublists [\""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\"], [\""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"bba"}],"kind":"container"},{"kind":"text","text":"\"], and [\""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"bba"}],"kind":"container"},{"kind":"text","text":"\"] are not stable. The other seven sublists are stable."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" = [\""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\"] is not stable, since the message \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\" + \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\" = \""},{"children":[{"kind":"text","text":"abab"}],"kind":"container"},{"kind":"text","text":"\" has four cyclic shifts [\""},{"children":[{"kind":"text","text":"abab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"baba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"baba"}],"kind":"container"},{"kind":"text","text":"\"], which are all elements of "},{"kind":"math_inline","text":"SX"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E",