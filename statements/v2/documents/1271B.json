{"assets":[],"contentKind":"statement","contestId":"1271","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Blocks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are $$$n$$$ blocks arranged in a row and numbered from left to right, starting from one. Each block is either black or white. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may perform the following operation zero or more times: choose two "},{"children":[{"kind":"text","text":"adjacent"}],"kind":"container"},{"kind":"text","text":" blocks and invert their colors (white block becomes black, and vice versa). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You want to find a sequence of operations, such that they make all the blocks having the same color. You "},{"children":[{"kind":"text","text":"don't have"}],"kind":"container"},{"kind":"text","text":" to minimize the number of operations, but it should not exceed $$$3 \\cdot n$$$. If it is impossible to find such a sequence of operations, you need to report it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$2 \\le n \\le 200$$$) — the number of blocks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains one string $$$s$$$ consisting of $$$n$$$ characters, each character is either \""},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\". If the $$$i$$$-th character is \""},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"\", then the $$$i$$$-th block is white. If the $$$i$$$-th character is \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\", then the $$$i$$$-th block is black. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is impossible to make all the blocks having the same color, print $$$-1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print an integer $$$k$$$ ($$$0 \\le k \\le 3 \\cdot n$$$) — the number of operations. Then print $$$k$$$ integers $$$p_1, p_2, \\dots, p_k$$$ $$$(1 \\le p_j \\le n - 1)$$$, where $$$p_j$$$ is the position of the left block in the pair of blocks that should be affected by the $$$j$$$-th operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8\nBWWWWWWB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n6 2 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nBWBB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\nWWWWW\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\nBWB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n2 1 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, it is possible to make all blocks black in $$$3$$$ operations. Start with changing blocks $$$6$$$ and $$$7$$$, so the sequence is \""},{"children":[{"kind":"text","text":"BWWWWBBB"}],"kind":"container"},{"kind":"text","text":"\". Then change blocks $$$2$$$ and $$$3$$$, so the sequence is \""},{"children":[{"kind":"text","text":"BBBWWBB"}],"kind":"container"},{"kind":"text","text":"\". And finally, change blocks $$$4$$$ and $$$5$$$, so all blocks are black."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is impossible to make all colors equal in the second example."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All blocks are already white in the third example."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example it is possible to make all blocks white in two operations: first operation is to change blocks $$$2$$$ and $$$3$$$ (so the sequence is \""},{"children":[{"kind":"text","text":"BBW"}],"kind":"container"},{"kind":"text","text":"\"), and then change blocks $$$1$$$ and $$$2$$$ (so all blocks are white)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1271B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1271/problem/B"}