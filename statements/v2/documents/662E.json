{"assets":["/statement-assets/2d731738305464865a3716c97bdbb6304ef8c32f6c03d24aa6630b186c8d0e8d.png","/statement-assets/91b237adeb348ae0b6429c9ed75ffdbacf7699f1e5bccc271562327c7cd0dcac.png"],"contentKind":"statement","contestId":"662","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. To Hack or not to Hack"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider a regular Codeforces round consisting of three problems that uses dynamic scoring."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an almost final scoreboard. For each participant (including yourself), the time of the accepted submission for each of the problems is given. Also, for each solution you already know whether you are able to hack it or not. The only changes in the scoreboard that will happen before the end of the round are your challenges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the best place you may take at the end?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"More formally, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people are participating (including yourself). For any problem, if it was solved by exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" people at the end of the round, the maximum score for this problem is defined as: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"n < 2k ≤ 2n"},{"kind":"text","text":", then the maximum possible score is "},{"kind":"math_inline","text":"500"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"n < 4k ≤ 2n"},{"kind":"text","text":", then the maximum possible score is "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"n < 8k ≤ 2n"},{"kind":"text","text":", then the maximum possible score is "},{"kind":"math_inline","text":"1500"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"n < 16k ≤ 2n"},{"kind":"text","text":", then the maximum possible score is "},{"kind":"math_inline","text":"2000"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"n < 32k ≤ 2n"},{"kind":"text","text":", then the maximum possible score is "},{"kind":"math_inline","text":"2500"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"32k ≤ n"},{"kind":"text","text":", then the maximum possible score is "},{"kind":"math_inline","text":"3000"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let the maximum possible score for some problem be equal to "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Then a contestant who didn't manage to get it accepted (or his solution was hacked) earns "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" points for this problem. If he got the the solution accepted "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" minutes after the beginning of the round (and his solution wasn't hacked), he earns "},{"attrs":{"alt":"","src":"/statement-assets/2d731738305464865a3716c97bdbb6304ef8c32f6c03d24aa6630b186c8d0e8d.png"},"kind":"image"},{"kind":"text","text":" points for this problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The overall score of a participant is equal to the sum of points he earns for each problem plus "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" points for each successful hack (only you make hacks)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The resulting place you get is equal to one plus the number of participants who's overall score is strictly greater than yours."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5000"},{"kind":"text","text":") — the number of participants. You are the participant number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains three integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":". Here "},{"kind":"math_inline","text":"ai = 0"},{"kind":"text","text":" means that the participant number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" didn't manage to accept first problem. If "},{"kind":"math_inline","text":"1 ≤ ai ≤ 120"},{"kind":"text","text":", then the participant number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" got the first problem accepted "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" minutes after the start of the contest and you cannot hack this solution. Finally, "},{"kind":"math_inline","text":" - 120 ≤ ai ≤  - 1"},{"kind":"text","text":" means that the participant number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" got the first problem accepted "},{"kind":"math_inline","text":" - ai"},{"kind":"text","text":" minutes after the start of the contest and you can hack this solution. Similarly, "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" provide the information regarding second and third problems in the same format."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c1"},{"kind":"text","text":" are non-negative."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer — the best place you can take at the end of the round."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n120 120 1\n61 61 120\n-61 61 120\n0 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 0 119\n-3 -17 -42\n0 7 0\n51 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first sample. If you do not hack any solutions, you will win the contest (scoreboard to the left). However, if you hack the solution of the first problem of the third participant (the only one you can hack), the maximum score for the first problem will change and you will finish second (scoreboard to the right). "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/91b237adeb348ae0b6429c9ed75ffdbacf7699f1e5bccc271562327c7cd0dcac.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"662E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/662/problem/E"}