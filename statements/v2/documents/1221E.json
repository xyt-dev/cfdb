{"assets":[],"contentKind":"statement","contestId":"1221","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Game With String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Alice and Bob play a game. Initially they have a string $$$s_1, s_2, \\dots, s_n$$$, consisting of only characters "},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":". They take alternating turns, and Alice is moving first. During each turn, the player has to select a contiguous substring consisting only of characters "},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" and replaces each of them with "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":". Alice must select a substing of length $$$a$$$, and Bob must select a substring of length $$$b$$$. It is guaranteed that $$$a \\gt b$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if $$$s =$$$ "},{"children":[{"kind":"text","text":"...X.."}],"kind":"container"},{"kind":"text","text":" and $$$a = 3$$$, $$$b = 2$$$, then after Alice's move string can turn only into "},{"children":[{"kind":"text","text":"XXXX.."}],"kind":"container"},{"kind":"text","text":". And if it's Bob's turn and the string $$$s =$$$ "},{"children":[{"kind":"text","text":"...X.."}],"kind":"container"},{"kind":"text","text":", then after Bob's move the string can turn into "},{"children":[{"kind":"text","text":"XX.X.."}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":".XXX.."}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"...XXX"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Whoever is unable to make a move, loses. You have to determine who wins if they both play optimally."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to answer $$$q$$$ independent queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$q$$$ ($$$1 \\le q \\le 3 \\cdot 10^5$$$) — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each query contains two integers $$$a$$$ and $$$b$$$ ($$$1 \\le b \\lt a \\le 3 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each query contains the string $$$s$$$ ($$$1 \\le |s| \\le 3 \\cdot 10^5$$$), consisting of only characters "},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that sum of all $$$|s|$$$ over all queries not exceed $$$3 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" if Alice can win and "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may print every letter in any case you want (so, for example, the strings "},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" will all be recognized as positive answer)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n3 2\nXX......XX...X\n4 2\nX...X.X..X\n5 3\n.......X..X\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first query Alice can select substring $$$s_3 \\dots s_5$$$. After that $$$s$$$ turns into "},{"children":[{"kind":"text","text":"XXXXX...XX...X"}],"kind":"container"},{"kind":"text","text":". After that, no matter what move Bob makes, Alice can make the move (this will be her second move), but Bob can't make his second move."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second query Alice can not win because she cannot even make one move."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third query Alice can choose substring $$$s_2 \\dots s_6$$$. After that $$$s$$$ turns into "},{"children":[{"kind":"text","text":".XXXXX.X..X"}],"kind":"container"},{"kind":"text","text":", and Bob can't make a move after that."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1221E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1221/problem/E"}