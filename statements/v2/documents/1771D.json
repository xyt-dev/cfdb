{"assets":["/statement-assets/4e836a9470ca15f979cac5c7eeee04890b872cf23dd7643c9eae048296c4eec4.png","/statement-assets/0fa99670835e4a7d0d661de39454181feb56b8a0751ce462d6c1a8bb4f636efe.png"],"contentKind":"statement","contestId":"1771","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Hossam and (sub-)palindromic tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Hossam has an unweighted tree $$$G$$$ with letters in vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Hossam defines $$$s(v, \\, u)$$$ as a string that is obtained by writing down all the letters on the unique simple path from the vertex $$$v$$$ to the vertex $$$u$$$ in the tree $$$G$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string $$$a$$$ is a "},{"children":[{"kind":"text","text":"subsequence"}],"kind":"container"},{"kind":"text","text":" of a string $$$s$$$ if $$$a$$$ can be obtained from $$$s$$$ by deletion of several (possibly, zero) letters. For example, \""},{"children":[{"kind":"text","text":"dores"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"cf"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"for"}],"kind":"container"},{"kind":"text","text":"\" are subsequences of \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\", while \""},{"children":[{"kind":"text","text":"decor"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"fork"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"palindrome"}],"kind":"container"},{"kind":"text","text":" is a string that reads the same from left to right and from right to left. For example, \""},{"children":[{"kind":"text","text":"abacaba"}],"kind":"container"},{"kind":"text","text":"\" is a palindrome, but \""},{"children":[{"kind":"text","text":"abac"}],"kind":"container"},{"kind":"text","text":"\" is not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Hossam defines a "},{"children":[{"kind":"text","text":"sub-palindrome"}],"kind":"container"},{"kind":"text","text":" of a string $$$s$$$ as a subsequence of $$$s$$$, that is a palindrome. For example, \""},{"children":[{"kind":"text","text":"k"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abba"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"abhba"}],"kind":"container"},{"kind":"text","text":"\" are sub-palindromes of the string \""},{"children":[{"kind":"text","text":"abhbka"}],"kind":"container"},{"kind":"text","text":"\", but \""},{"children":[{"kind":"text","text":"abka"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"cat"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Hossam defines a "},{"children":[{"kind":"text","text":"maximal sub-palindrome"}],"kind":"container"},{"kind":"text","text":" of a string $$$s$$$ as a sub-palindrome of $$$s$$$, which has the maximal length among all sub-palindromes of $$$s$$$. For example, \""},{"children":[{"kind":"text","text":"abhbka"}],"kind":"container"},{"kind":"text","text":"\" has only one maximal sub-palindrome — \""},{"children":[{"kind":"text","text":"abhba"}],"kind":"container"},{"kind":"text","text":"\". But it may also be that the string has several maximum sub-palindromes: the string \""},{"children":[{"kind":"text","text":"abcd"}],"kind":"container"},{"kind":"text","text":"\" has $$$4$$$ maximum sub-palindromes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Hossam find the length of the longest maximal sub-palindrome among all $$$s(v, \\, u)$$$ in the tree $$$G$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note that the sub-palindrome is a subsequence, not a substring."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 200$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case has one integer number $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^3$$$) — the number of vertices in the graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string $$$s$$$ of length $$$n$$$, the $$$i$$$-th symbol of which denotes the letter on the vertex $$$i$$$. It is guaranteed that all characters in this string are lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n - 1$$$ lines describe the edges of the tree. Each edge is given by two integers $$$v$$$ and $$$u$$$ ($$$1 \\le v, \\, u \\le n$$$, $$$v \\neq u$$$). These two numbers mean that there is an edge $$$(v, \\, u)$$$ in the tree. It is guaranteed that the given edges form a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that sum of all $$$n$$$ doesn't exceed $$$2 \\cdot 10^3$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case output one integer — the length of the longest maximal sub-palindrome among all $$$s(v, \\, u)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n5\nabaca\n1 2\n1 3\n3 4\n4 5\n9\ncaabadedb\n1 2\n2 3\n2 4\n1 5\n5 6\n5 7\n5 8\n8 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the maximal subpalindromes are \""},{"children":[{"kind":"text","text":"aaa"}],"kind":"container"},{"kind":"text","text":"\" with letters in vertices $$$1, \\, 3, \\, 5$$$, or \""},{"children":[{"kind":"text","text":"aca"}],"kind":"container"},{"kind":"text","text":"\" with letters in vertices $$$1, \\, 4, \\, 5$$$."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/4e836a9470ca15f979cac5c7eeee04890b872cf23dd7643c9eae048296c4eec4.png"},"kind":"image"},{"children":[{"kind":"text","text":"The tree from the first example."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second example there is only one maximal palindrome \""},{"children":[{"kind":"text","text":"bacab"}],"kind":"container"},{"kind":"text","text":"\" with letters in vertices $$$4, \\, 2, \\, 1, \\, 5, \\, 9$$$."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0fa99670835e4a7d0d661de39454181feb56b8a0751ce462d6c1a8bb4f636efe.png"},"kind":"image"},{"children":[{"kind":"text","text":"The tree from the second example."}],"kind":"container"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1771D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1771/problem/D"}