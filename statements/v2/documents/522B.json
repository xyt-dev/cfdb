{"assets":[],"contentKind":"statement","contestId":"522","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Photo to Remember"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" friends met at a party, they hadn't seen each other for a long time and so they decided to make a group photo together. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Simply speaking, the process of taking photos can be described as follows. On the photo, each photographed friend occupies a rectangle of pixels: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them occupies the rectangle of width "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" pixels and height "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" pixels. On the group photo everybody stands in a line, thus the minimum pixel size of the photo including all the photographed friends, is "},{"kind":"math_inline","text":"W × H"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"W"},{"kind":"text","text":" is the total sum of all widths and "},{"kind":"math_inline","text":"H"},{"kind":"text","text":" is the maximum height of all the photographed friends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As is usually the case, the friends made "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" photos — the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th ("},{"kind":"math_inline","text":"1 ≤ j ≤ n"},{"kind":"text","text":") photo had everybody except for the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th friend as he was the photographer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print the minimum size of each made photo in pixels. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 200 000"},{"kind":"text","text":") — the number of friends. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains information about the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th friend. The line contains a pair of integers "},{"kind":"math_inline","text":"wi, hi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ wi ≤ 10, 1 ≤ hi ≤ 1000"},{"kind":"text","text":") — the width and height in pixels of the corresponding rectangle."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated numbers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" — the total number of pixels on the minimum photo containing all friends expect for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 10\n5 5\n10 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"75 110 60 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 1\n1 2\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6 4 6 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"522B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/522/problem/B"}