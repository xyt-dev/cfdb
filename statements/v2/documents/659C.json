{"assets":[],"contentKind":"statement","contestId":"659","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Tanya and Toys"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In Berland recently a new collection of toys went on sale. This collection consists of "},{"kind":"math_inline","text":"109"},{"kind":"text","text":" types of toys, numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"109"},{"kind":"text","text":". A toy from the new collection of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th type costs "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" bourles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Tania has managed to collect "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" different types of toys "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" from the new collection. Today is Tanya's birthday, and her mother decided to spend no more than "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" bourles on the gift to the daughter. Tanya will choose several different types of toys from the new collection as a gift. Of course, she does not want to get a type of toy which she already has."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Tanya wants to have as many distinct types of toys in her collection as possible as the result. The new collection is too diverse, and Tanya is too little, so she asks you to help her in this."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 109"},{"kind":"text","text":") — the number of types of toys that Tanya already has and the number of bourles that her mom is willing to spend on buying new toys."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — the types of toys that Tanya already has."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of different types of toys that Tanya should choose so that the number of different types of toys in her collection is maximum possible. Of course, the total cost of the selected toys should not exceed "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" distinct space-separated integers "},{"kind":"math_inline","text":"t1, t2, ..., tk"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 109"},{"kind":"text","text":") — the types of toys that Tanya should choose."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, you may print any of them. Values of "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" can be printed in any order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 7\n1 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 5 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 14\n4 6 12 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n7 2 3 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample mom should buy two toys: one toy of the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd type and one toy of the "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"-th type. At any other purchase for "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" bourles (assuming that the toys of types "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" have already been bought), it is impossible to buy two and more toys."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"659C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/659/problem/C"}