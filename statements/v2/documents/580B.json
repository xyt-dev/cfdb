{"assets":["/statement-assets/3cd654d989dae13b5083a9a99eeae691a254aa76f7c1d23d9339260d26cd31d9.png"],"contentKind":"statement","contestId":"580","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Kefa and Company"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Kefa wants to celebrate his first big salary by going to restaurant. However, he needs company. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Kefa has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" friends, each friend will agree to go to the restaurant if Kefa asks. Each friend is characterized by the amount of money he has and the friendship factor in respect to Kefa. The parrot doesn't want any friend to feel poor compared to somebody else in the company (Kefa doesn't count). A friend feels poor if in the company there is someone who has at least "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" units of money more than he does. Also, Kefa wants the total friendship factor of the members of the company to be maximum. Help him invite an optimal company!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two space-separated integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/3cd654d989dae13b5083a9a99eeae691a254aa76f7c1d23d9339260d26cd31d9.png"},"kind":"image"},{"kind":"text","text":") — the number of Kefa's friends and the minimum difference between the amount of money in order to feel poor, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the descriptions of Kefa's friends, the "},{"kind":"math_inline","text":"(i + 1)"},{"kind":"text","text":"-th line contains the description of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th friend of type "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ mi, si ≤ 109"},{"kind":"text","text":") — the amount of money and the friendship factor, respectively. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum total friendship factir that can be reached."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n75 5\n0 100\n150 20\n75 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"100\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 100\n0 7\n11 32\n99 10\n46 8\n87 54\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"111\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test the most profitable strategy is to form a company from only the second friend. At all other variants the total degree of friendship will be worse."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test we can take all the friends."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"580B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/580/problem/B"}