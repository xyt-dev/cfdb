{"assets":[],"contentKind":"statement","contestId":"1827","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Palindrome Partition"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":" is a continuous and non-empty segment of letters from a given string, without any reorders."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An "},{"children":[{"kind":"text","text":"even palindrome"}],"kind":"container"},{"kind":"text","text":" is a string that reads the same backward as forward and has an even length. For example, strings \""},{"children":[{"kind":"text","text":"zz"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abccba"}],"kind":"container"},{"kind":"text","text":"\" are even palindromes, but strings \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"reality"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"beautiful string"}],"kind":"container"},{"kind":"text","text":" is an even palindrome or a string that can be partitioned into some smaller even palindromes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string $$$s$$$, consisting of $$$n$$$ lowercase Latin letters. Count the number of "},{"children":[{"kind":"text","text":"beautiful substrings"}],"kind":"container"},{"kind":"text","text":" of $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 5\\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a string $$$s$$$. String $$$s$$$ consists of only lowercase Latin letters and has a length of $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$5\\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print the number of beautiful substrings."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n6\nabaaba\n1\na\n2\naa\n6\nabcdef\n12\naccabccbacca\n6\nabbaaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n0\n1\n0\n14\n6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the beautiful substrings are \""},{"children":[{"kind":"text","text":"abaaba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"baab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the last test case, the beautiful substrings are \""},{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"\" (counted twice), \""},{"children":[{"kind":"text","text":"abba"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"bb"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"bbaa"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abbaaa"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1827C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1827/problem/C"}