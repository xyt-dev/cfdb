{"assets":[],"contentKind":"statement","contestId":"2123","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. MEX Count"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Define the $$$\\mathrm{MEX}$$$ (minimum excluded value) of an array to be the smallest nonnegative integer not present in the array. For example,"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$\\mathrm{MEX}([2, 2, 1]) = 0$$$ because $$$0$$$ is not in the array. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\mathrm{MEX}([3, 1, 0, 1]) = 2$$$ because $$$0$$$ and $$$1$$$ are in the array but $$$2$$$ is not. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\mathrm{MEX}([0, 3, 1, 2]) = 4$$$ because $$$0$$$, $$$1$$$, $$$2$$$, and $$$3$$$ are in the array but $$$4$$$ is not. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are given an array $$$a$$$ of size $$$n$$$ of nonnegative integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For all $$$k$$$ ($$$0\\leq k \\leq n$$$), count the number of possible values of $$$\\mathrm{MEX}(a)$$$ after removing exactly $$$k$$$ values from $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1\\leq t\\leq 10^4$$$)  — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains one integer $$$n$$$ ($$$1\\leq n\\leq 2\\cdot 10^5$$$) — the size of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers, $$$a_1,a_2,\\dots,a_n$$$ ($$$0\\leq a_i\\leq n$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2\\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single line containing $$$n+1$$$ integers — the number of possible values of $$$\\mathrm{MEX}(a)$$$ after removing exactly $$$k$$$ values, for $$$k=0,1,\\dots,n$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n5\n1 0 0 1 2\n6\n3 2 0 4 5 1\n6\n1 2 0 1 3 2\n4\n0 3 4 1\n5\n0 0 0 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 2 4 3 2 1\n1 6 5 4 3 2 1\n1 3 5 4 3 2 1\n1 3 3 2 1\n1 1 1 1 1 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, consider $$$k=1$$$. If you remove a $$$0$$$, then you get the following array: "}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"1"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"0"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"1"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"2"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"},{"kind":"text","text":" So we get $$$\\mathrm{MEX}(a) = 3$$$. Alternatively, if you remove the $$$2$$$, then you get the following array: "},{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"1"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"0"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"0"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"1"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"},{"kind":"text","text":" So we get $$$\\mathrm{MEX}(a) = 2$$$. It can be shown that these are the only possible values of $$$\\mathrm{MEX}(a)$$$ after removing exactly one value. So the output for $$$k=1$$$ is $$$2$$$."}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"2123E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2123/problem/E"}