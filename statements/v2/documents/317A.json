{"assets":["/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"],"contentKind":"statement","contestId":"317","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Perfect Pair"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let us call a pair of integer numbers "},{"children":[{"kind":"math_inline","text":"m"},{"kind":"text","text":"-perfect"}],"kind":"container"},{"kind":"text","text":", if at least one number in the pair is greater than or equal to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Thus, the pairs (3, 3) and (0, 2) are 2-perfect while the pair (-1, 1) is not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" are written on the blackboard. It is allowed to erase one of them and replace it with the sum of the numbers, "},{"kind":"math_inline","text":"(x + y)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of such operations one has to perform in order to make the given pair of integers "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-perfect?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Single line of the input contains three integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 1018 ≤ x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m ≤ 1018"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in C++. It is preffered to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of operations or \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\" (without quotes), if it is impossible to transform the given pair to the "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"-perfect one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"-1 4 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 -1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the following sequence of operations is suitable: (1, 2) "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" (3, 2) "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" (5, 2)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample: (-1, 4) "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" (3, 4) "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" (7, 4) "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" (11, 4) "},{"attrs":{"alt":"","src":"/statement-assets/ec0b0b271386a3da4e74664848ecae4449b04575636e78c12f5fd29acb32a420.png"},"kind":"image"},{"kind":"text","text":" (15, 4)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Finally, in the third sample "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" cannot be made positive, hence there is no proper sequence of operations."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"317A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/317/problem/A"}