{"assets":[],"contentKind":"statement","contestId":"779","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Pupils Redistribution"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In Berland each high school student is characterized by "},{"children":[{"kind":"text","text":"academic performance"}],"kind":"container"},{"kind":"text","text":" — integer value between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In high school "},{"children":[{"kind":"text","text":"0xFF"}],"kind":"container"},{"kind":"text","text":" there are two groups of pupils: the group "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and the group "},{"kind":"math_inline","text":"B"},{"kind":"text","text":". Each group consists of exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students. An academic performance of each student is known — integer value between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The school director wants to redistribute students between groups so that each of the two groups has the same number of students whose academic performance is equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", the same number of students whose academic performance is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and so on. In other words, the purpose of the school director is to change the composition of groups, so that for each value of academic performance the numbers of students in both groups are equal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To achieve this, there is a plan to produce a series of exchanges of students between groups. During the single exchange the director selects one student from the class "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and one student of class "},{"kind":"math_inline","text":"B"},{"kind":"text","text":". After that, they both change their groups."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Print the least number of exchanges, in order to achieve the desired equal numbers of students for each academic performance."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — number of students in both groups."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains sequence of integer numbers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 5"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is academic performance of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th student of the group "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains sequence of integer numbers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ 5"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is academic performance of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th student of the group "},{"kind":"math_inline","text":"B"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the required minimum number of exchanges or "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":", if the desired distribution of students can not be obtained."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n5 4 4 4\n5 5 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 1 1 1 1 1\n5 5 5 5 5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n5\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n3 2 5 5 2 3 3 3 2\n4 1 4 1 1 2 4 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"779A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/779/problem/A"}