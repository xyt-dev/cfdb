{"assets":[],"contentKind":"statement","contestId":"995","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Number Clicker"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Allen is playing Number Clicker on his phone."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He starts with an integer $$$u$$$ on the screen. Every second, he can press one of 3 buttons."}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Turn $$$u \\to u+1 \\pmod{p}$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Turn $$$u \\to u+p-1 \\pmod{p}$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Turn $$$u \\to u^{p-2} \\pmod{p}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Allen wants to press at most 200 buttons and end up with $$$v$$$ on the screen. Help him!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains 3 positive integers: $$$u, v, p$$$ ($$$0 \\le u, v \\le p-1$$$, $$$3 \\le p \\le 10^9 + 9$$$). $$$p$$$ is guaranteed to be prime."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first line, print a single integer $$$\\ell$$$, the number of button presses. On the second line, print integers $$$c_1, \\dots, c_\\ell$$$, the button presses. For $$$1 \\le i \\le \\ell$$$, $$$1 \\le c_i \\le 3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can show that the answer always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the integer on the screen changes as $$$1 \\to 2 \\to 3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the integer on the screen changes as $$$3 \\to 2$$$. "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"995E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/995/problem/E"}