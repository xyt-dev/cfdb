{"assets":["/statement-assets/78bbcaec25e0f8e2f5201596b4608f490a735cf3bcadf0cf8a0a4f301057a097.png"],"contentKind":"statement","contestId":"547","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Mike and Fish"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As everyone knows, bears love fish. But Mike is a strange bear; He hates fish! The even more strange thing about him is he has an infinite number of blue and red fish. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/78bbcaec25e0f8e2f5201596b4608f490a735cf3bcadf0cf8a0a4f301057a097.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"He has marked "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct points in the plane. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th point is point "},{"kind":"math_inline","text":"(xi, yi)"},{"kind":"text","text":". He wants to put exactly one fish in each of these points such that the difference between the number of red fish and the blue fish on each horizontal or vertical line is at most 1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He can't find a way to perform that! Please help him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains integer "},{"kind":"math_inl