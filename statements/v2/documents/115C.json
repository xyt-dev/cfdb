{"assets":["/statement-assets/c24cfa3644eb7dbadb5305bdc4acf809e568c906ed930e1f6c6a7b93b6be4f14.png","/statement-assets/dfb45e50226c7cd21cca9756303cc8568bb90a75db5f7a0a3626028cac2acf31.png","/statement-assets/c071317f5ef88af2fd7ada459fbc4aa923077bdfe7ca1a874d3e318b1a2ce43a.png","/statement-assets/82d64b521379f717f77cb9827ec1b7a64fc455925e0982bccc795791c72a268b.png","/statement-assets/0a4fbe839db98b196cafec54bae8917eddb325cf38f0fed7966b7dbd6ddeb262.png","/statement-assets/9d95520e52b00e9d7b088e057ccc6a8b3b8f6299e7da546dfb237b43779dea14.png"],"contentKind":"statement","contestId":"115","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Plumber"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little John aspires to become a plumber! Today he has drawn a grid consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" columns, consisting of "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" square cells."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In each cell he will draw a pipe segment. He can only draw four types of segments numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", illustrated as follows:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c24cfa3644eb7dbadb5305bdc4acf809e568c906ed930e1f6c6a7b93b6be4f14.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Each pipe segment has two ends, illustrated by the arrows in the picture above. For example, segment "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" has ends at top and left side of it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Little John considers the piping system to be leaking if there is at least one pipe segment inside the grid whose end is not connected to another pipe's end or to the border of the grid. The image below shows an example of leaking and non-leaking systems of size "},{"kind":"math_inline","text":"1 × 2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/dfb45e50226c7cd21cca9756303cc8568bb90a75db5f7a0a3626028cac2acf31.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Now, you will be given the grid that has been partially filled by Little John. Each cell will either contain one of the four segments above, or be empty. Find the number of possible different non-leaking final systems after Little John finishes filling "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" of the empty cells with pipe segments. Print this number modulo "},{"kind":"math_inline","text":"1000003"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"106 + 3"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that rotations or flipping of the grid are not allowed and so two configurations that are identical only when one of them has been rotated or flipped either horizontally or vertically are considered two different configurations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line will contain two single-space separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m, n·m ≤ 5·105"},{"kind":"text","text":") — the number of rows and columns respectively. Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, each contains exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters — the description of the grid. Each character describes a cell and is either one of these: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" - \""},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":"\" — a pipe segment of one of four types as described above "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" — an empty cell "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer denoting the number of possible final non-leaking pipe systems modulo "},{"kind":"math_inline","text":"1000003"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"106 + 3"},{"kind":"text","text":"). If there are no such configurations, print "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n13\n..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n1\n4\n.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n3.\n.1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first example, the initial configuration of the grid is as follows. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c071317f5ef88af2fd7ada459fbc4aa923077bdfe7ca1a874d3e318b1a2ce43a.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The only two possible final non-leaking pipe configurations are as follows:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/82d64b521379f717f77cb9827ec1b7a64fc455925e0982bccc795791c72a268b.png"},"kind":"image"}],"kind":"container"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0a4fbe839db98b196cafec54bae8917eddb325cf38f0fed7966b7dbd6ddeb262.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"For the second example, the initial grid is already leaking, so there will be no final grid that is non-leaking."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the final example, there's only one possible non-leaking final grid as follows."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9d95520e52b00e9d7b088e057ccc6a8b3b8f6299e7da546dfb237b43779dea14.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"115C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/115/problem/C"}