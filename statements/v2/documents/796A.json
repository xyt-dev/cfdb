{"assets":["/statement-assets/4fd2cbd1127758f92c730a865abed54f2323e45c02e7474f4d55eb2128d83e79.png"],"contentKind":"statement","contestId":"796","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Buying A House"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Zane the wizard had never loved anyone before, until he fell in love with a girl, whose name remains unknown to us."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/4fd2cbd1127758f92c730a865abed54f2323e45c02e7474f4d55eb2128d83e79.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The girl lives in house "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" of a village. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" houses in that village, lining in a straight line from left to right: house "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", house "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", ..., house "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The village is also well-structured: house "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and house "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i < n"},{"kind":"text","text":") are exactly "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" meters away. In this village, some houses are occupied, and some are not. Indeed, unoccupied houses can be purchased."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You will be given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" that denote the availability and the prices of the houses. If house "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is occupied, and therefore cannot be bought, then "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" equals "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". Otherwise, house "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" can be bought, and "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" represents the money required to buy it, in dollars."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As Zane has only "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" dollars to spare, it becomes a challenge for him to choose the house to purchase, so that he could live as near as possible to his crush. Help Zane determine the minimum distance from his crush's house to some house he can afford, to help him succeed in his love."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 100"},{"kind":"text","text":") — the number of houses in the village, the house where the girl lives, and the amount of money Zane has (in dollars), respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 100"},{"kind":"text","text":") — denoting the availability and the prices of the houses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that "},{"kind":"math_inline","text":"am = 0"},{"kind":"text","text":" and that it is possible to purchase some house with no more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" dollars."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the minimum distance, in meters, from the house where the girl Zane likes lives to the house Zane can buy."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1 20\n0 27 32 21 19\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"40"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 3 50\n62 0 0 0 99 33 22\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"30"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 5 100\n1 0 1 0 0 0 0 0 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, with "},{"kind":"math_inline","text":"k = 20"},{"kind":"text","text":" dollars, Zane can buy only house "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". The distance from house "},{"kind":"math_inline","text":"m = 1"},{"kind":"text","text":" to house "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"10 + 10 + 10 + 10 = 40"},{"kind":"text","text":" meters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, Zane can buy houses "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"7"},{"kind":"text","text":". It is better to buy house "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" than house "},{"kind":"math_inline","text":"7"},{"kind":"text","text":", since house "},{"kind":"math_inline","text":"m = 3"},{"kind":"text","text":" and house "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" are only "},{"kind":"math_inline","text":"30"},{"kind":"text","text":" meters away, while house "},{"kind":"math_inline","text":"m = 3"},{"kind":"text","text":" and house "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" are "},{"kind":"math_inline","text":"40"},{"kind":"text","text":" meters away."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"796A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/796/problem/A"}