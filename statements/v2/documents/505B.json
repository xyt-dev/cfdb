{"assets":["/statement-assets/69019a910974b89069ee7b5654ea3c75d0f8d14b3edc43174a311f34e564384a.png"],"contentKind":"statement","contestId":"505","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Mr. Kitayuta's Colorful Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mr. Kitayuta has just bought an undirected graph consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges. The vertices of the graph are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Each edge, namely edge "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", has a color "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":", connecting vertex "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mr. Kitayuta wants you to process the following "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query, he gives you two integers — "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the number of the colors that satisfy the following condition: the edges of that color connect vertex "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and vertex "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" directly or indirectly."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains space-separated two integers — "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 100, 1 ≤ m ≤ 100"},{"kind":"text","text":"), denoting the number of the vertices and the number of the edges, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain space-separated three integers — "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai < bi ≤ n"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci ≤ m"},{"kind":"text","text":"). Note that there can be multiple edges between two vertices. However, there are no multiple edges of the same color between two vertices, that is, if "},{"kind":"math_inline","text":"i ≠ j"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(ai, bi, ci) ≠ (aj, bj, cj)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains a integer — "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 100"},{"kind":"text","text":"), denoting the number of the queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follows "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines, containing space-separated two integers — "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":"). It is guaranteed that "},{"kind":"math_inline","text":"ui ≠ vi"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query, print the answer in a separate line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n1 2 1\n1 2 2\n2 3 1\n2 3 3\n2 4 3\n3\n1 2\n3 4\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 7\n1 5 1\n2 5 1\n3 5 1\n4 5 1\n1 2 2\n2 3 2\n3 4 2\n5\n1 5\n5 1\n2 5\n1 5\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n1\n1\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's consider the first sample. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/69019a910974b89069ee7b5654ea3c75d0f8d14b3edc43174a311f34e564384a.png"},"kind":"image"},{"kind":"text","text":" The figure above shows the first sample. "}],"kind":"container"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and vertex "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" are connected by color "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Vertex "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and vertex "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" are connected by color "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and vertex "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" are not connected by any single color. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"505B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/505/problem/B"}