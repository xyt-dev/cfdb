{"assets":[],"contentKind":"statement","contestId":"253","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Boys and Girls"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"input_channel"},"children":[{"children":[{"kind":"text","text":"input"}],"kind":"container"},{"kind":"text","text":"input.txt"}],"kind":"container"},{"attrs":{"role":"output_channel"},"children":[{"children":[{"kind":"text","text":"output"}],"kind":"container"},{"kind":"text","text":"output.txt"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" boys and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" girls studying in the class. They should stand in a line so that boys and girls alternated there as much as possible. Let's assume that positions in the line are indexed from left to right by numbers from 1 to "},{"kind":"math_inline","text":"n + m"},{"kind":"text","text":". Then the number of integers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i < n + m"},{"kind":"text","text":") such that positions with indexes "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" contain children of different genders (position "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has a girl and position "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" has a boy or vice versa) must be as large as possible. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the children and tell them how to form the line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100"},{"kind":"text","text":"), separated by a space."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a line of "},{"kind":"math_inline","text":"n + m"},{"kind":"text","text":" characters. Print on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th position of the line character \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\", if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th position of your arrangement should have a boy and \""},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"\", if it should have a girl. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Of course, the number of characters \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\" should equal "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and the number of characters \""},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"\" should equal "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". If there are multiple optimal solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"GBGBGB\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"BGBGBB\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample another possible answer is "},{"children":[{"kind":"text","text":"BGBGBG"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample answer "},{"children":[{"kind":"text","text":"BBGBGB"}],"kind":"container"},{"kind":"text","text":" is also optimal."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"253A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/253/problem/A"}