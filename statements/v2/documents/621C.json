{"assets":["/statement-assets/af572790d886b5de9e6a69678560f5b9ffb802b8d91d49716b2f7199c5afce2c.png","/statement-assets/d00e2a55ddd34285ddd67bde283f1f16fd3ce5b7001d445cd140fe0b893c9052.png"],"contentKind":"statement","contestId":"621","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Wet Shark and Flowers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sharks who grow flowers for Wet Shark. They are all sitting around the table, such that sharks "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" are neighbours for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":". Sharks "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" are neighbours too."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each shark will grow some number of flowers "},{"kind":"math_inline","text":"si"},{"kind":"text","text":". For "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th shark value "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" is random integer equiprobably chosen in range from "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":". Wet Shark has it's favourite prime number "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", and he really likes it! If for any pair of "},{"children":[{"kind":"text","text":"neighbouring"}],"kind":"container"},{"kind":"text","text":" sharks "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" the product "},{"kind":"math_inline","text":"si·sj"},{"kind":"text","text":" is divisible by "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", then Wet Shark becomes happy and gives "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":" dollars to each of these sharks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At the end of the day sharks sum all the money Wet Shark granted to them. Find the expectation of this value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 100 000, 2 ≤ p ≤ 109"},{"kind":"text","text":") — the number of sharks and Wet Shark's favourite prime number. It is guaranteed that "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is prime."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains information about "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th shark — two space-separated integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ 109"},{"kind":"text","text":"), the range of flowers shark "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" can produce. Remember that "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" is chosen equiprobably among all integers from "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", inclusive."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single real number — the expected number of dollars that the sharks receive in total. You answer will be considered correct if its absolute or relative error does not exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Namely: let's assume that your answer is "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and the answer of the jury is "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The checker program will consider your answer correct, if "},{"attrs":{"alt":"","src":"/statement-assets/af572790d886b5de9e6a69678560f5b9ffb802b8d91d49716b2f7199c5afce2c.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 2\n420 421\n420420 420421\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4500.0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n1 4\n2 3\n11 14\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A prime number is a positive integer number that is divisible only by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and itself. "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is not considered to be prime."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the first sample. First shark grows some number of flowers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", second sharks grows from "},{"kind":"math_inline","text":"420"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"421"},{"kind":"text","text":" flowers and third from "},{"kind":"math_inline","text":"420420"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"420421"},{"kind":"text","text":". There are eight cases for the quantities of flowers "},{"kind":"math_inline","text":"(s0, s1, s2)"},{"kind":"text","text":" each shark grows:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"(1, 420, 420420)"},{"kind":"text","text":": note that "},{"kind":"math_inline","text":"s0·s1 = 420"},{"kind":"text","text":", "},{"kind":"math_inline","text":"s1·s2 = 176576400"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"s2·s0 = 420420"},{"kind":"text","text":". For each pair, "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":" dollars will be awarded to each shark. Therefore, each shark will be awarded "},{"kind":"math_inline","text":"2000"},{"kind":"text","text":" dollars, for a total of "},{"kind":"math_inline","text":"6000"},{"kind":"text","text":" dollars."}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"(1, 420, 420421)"},{"kind":"text","text":": now, the product "},{"kind":"math_inline","text":"s2·s0"},{"kind":"text","text":" is not divisible by "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Therefore, sharks "},{"kind":"math_inline","text":"s0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" will receive "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":" dollars, while shark "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" will receive "},{"kind":"math_inline","text":"2000"},{"kind":"text","text":". The total is "},{"kind":"math_inline","text":"4000"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"(1, 421, 420420)"},{"kind":"text","text":": total is "},{"kind":"math_inline","text":"4000"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"(1, 421, 420421)"},{"kind":"text","text":": total is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"(2, 420, 420420)"},{"kind":"text","text":": total is "},{"kind":"math_inline","text":"6000"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"(2, 420, 420421)"},{"kind":"text","text":": total is "},{"kind":"math_inline","text":"6000"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"(2, 421, 420420)"},{"kind":"text","text":": total is "},{"kind":"math_inline","text":"6000"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"(2, 421, 420421)"},{"kind":"te