{"assets":[],"contentKind":"statement","contestId":"263","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Circle of Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day Vasya came up to the blackboard and wrote out "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in some order in a circle. Then he drew arcs to join the pairs of integers "},{"kind":"math_inline","text":"(a, b)"},{"kind":"math_inline","text":"(a ≠ b)"},{"kind":"text","text":", that are either each other's immediate neighbors in the circle, or there is number "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"с"},{"kind":"text","text":" are immediate neighbors, and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" are immediate neighbors. As you can easily deduce, in the end Vasya drew "},{"kind":"math_inline","text":"2·n"},{"kind":"text","text":" arcs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if the numbers are written in the circle in the order "},{"kind":"math_inline","text":"1, 2, 3, 4, 5"},{"kind":"text","text":" (in the clockwise direction), then the arcs will join pairs of integers "},{"kind":"math_inline","text":"(1, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(4, 5)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(5, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(3, 5)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(4, 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(5, 2)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Much time has passed ever since, the numbers we wiped off the blackboard long ago, but recently Vasya has found a piece of paper with "},{"kind":"math_inline","text":"2·n"},{"kind":"text","text":" written pairs of integers that were joined with the arcs on the board. Vasya asks you to find the order of numbers in the circle by these pairs."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"5 ≤ n ≤ 105"},{"kind":"text","text":") that shows, how many numbers were written on the board. Next "},{"kind":"math_inline","text":"2·n"},{"kind":"text","text":" lines contain pairs of integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":") — the numbers that were connected by the arcs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that no pair of integers, connected by a arc, occurs in the input more than once. The pairs of numbers and the numbers in the pairs are given in the arbitrary order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If Vasya made a mistake somewhere and there isn't any way to place numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" on the circle according to the statement, then print a single number \"-1\" (without the quotes). Otherwise, print any suitable sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, you are allowed to print any of them. Specifically, it doesn't matter which number you write first to describe the sequence of the order. It also doesn't matter whether you write out the numbers in the clockwise or counter-clockwise direction."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2\n2 3\n3 4\n4 5\n5 1\n1 3\n2 4\n3 5\n4 1\n5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 3 4 5 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n5 6\n4 3\n5 3\n2 4\n6 1\n3 1\n6 2\n2 5\n1 4\n3 6\n1 2\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 4 5 3 6 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"263C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/263/problem/C"}