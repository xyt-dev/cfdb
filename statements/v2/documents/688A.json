{"assets":[],"contentKind":"statement","contestId":"688","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Opponents"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Arya has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" opponents in the school. Each day he will fight with all opponents who are present this day. His opponents have some fighting plan that guarantees they will win, but implementing this plan requires presence of them all. That means if one day at least one of Arya's opponents is absent at the school, then Arya will beat all present opponents. Otherwise, if all opponents are present, then they will beat Arya."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each opponent Arya knows his schedule — whether or not he is going to present on each particular day. Tell him the maximum number of "},{"children":[{"kind":"text","text":"consecutive"}],"kind":"container"},{"kind":"text","text":" days that he will beat all present opponents."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note, that if some day there are no opponents present, Arya still considers he beats all the present opponents."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, d ≤ 100"},{"kind":"text","text":") — the number of opponents and the number of days, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the following "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" lines contains a string of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" consisting of characters '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"'. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th character of this string is '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' if the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th opponent is going to be absent on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer — the maximum number of consecutive days that Arya will beat all present opponents."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n10\n00\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n0100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n1101\n1111\n0110\n1011\n1111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first and the second samples, Arya will beat all present opponents each of the "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" days."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, Arya will beat his opponents on days "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and his opponents will beat him on days "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". Thus, the maximum number of consecutive winning days is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", which happens on days "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"688A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/688/problem/A"}