{"assets":[],"contentKind":"statement","contestId":"732","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Cormen — The Best Friend Of a Man"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recently a dog was bought for Polycarp. The dog's name is Cormen. Now Polycarp has a lot of troubles. For example, Cormen likes going for a walk. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Empirically Polycarp learned that the dog needs at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" walks for any two consecutive days in order to feel good. For example, if "},{"kind":"math_inline","text":"k = 5"},{"kind":"text","text":" and yesterday Polycarp went for a walk with Cormen "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" times, today he has to go for a walk at least "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" times. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp analysed all his affairs over the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days and made a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the number of times Polycarp will walk with the dog on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day while doing all his affairs (for example, he has to go to a shop, throw out the trash, etc.)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Polycarp determine the minimum number of walks he needs to do additionaly in the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days so that Cormen will feel good during all the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days. You can assume that on the day before the first day and on the day after the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th day Polycarp will go for a walk with Cormen exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" times. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Write a program that will find the minumum number of additional walks and the appropriate schedule — the sequence of integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"bi ≥ ai"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" means the total number of walks with the dog on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, k ≤ 500"},{"kind":"text","text":") — the number of days and the minimum number of walks with Cormen for any two consecutive days. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 500"},{"kind":"text","text":") — the number of walks with Cormen on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day which Polycarp has already planned. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the smallest number of additional walks that Polycarp should do during the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days so that Cormen will feel good during all days. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" — the total number of walks on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day according to the found solutions ("},{"kind":"math_inline","text":"ai ≤ bi"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"). If there are multiple solutions, print any of them. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n2 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 3 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n0 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n0 1 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 6\n2 4 3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n2 4 3 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"732B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/732/problem/B"}