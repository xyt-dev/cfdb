{"assets":[],"contentKind":"statement","contestId":"505","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Mr. Kitayuta's Gift"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mr. Kitayuta has kindly given you a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of lowercase English letters. You are asked to insert exactly one lowercase English letter into "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to make it a palindrome. A "},{"children":[{"kind":"text","text":"palindrome"}],"kind":"container"},{"kind":"text","text":" is a string that reads the same forward and backward. For example, \""},{"children":[{"kind":"text","text":"noon"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"testset"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" are all palindromes, while \""},{"children":[{"kind":"text","text":"test"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"kitayuta"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can choose any lowercase English letter, and insert it to any position of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", possibly to the beginning or the end of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". You have to insert a letter even if the given string is already a palindrome."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it is possible to insert one lowercase English letter into "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" so that the resulting string will be a palindrome, print the string after the insertion. Otherwise, print \""},{"children":[{"kind":"text","text":"NA"}],"kind":"container"},{"kind":"text","text":"\" (without quotes, case-sensitive). In case there is more than one palindrome that can be obtained, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 10"},{"kind":"text","text":"). Each character in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a lowercase English letter."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is possible to turn "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" into a palindrome by inserting one lowercase English letter, print the resulting string in a single line. Otherwise, print \""},{"children":[{"kind":"text","text":"NA"}],"kind":"container"},{"kind":"text","text":"\" (without quotes, case-sensitive). In case there is more than one solution, any of them will be accepted. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{