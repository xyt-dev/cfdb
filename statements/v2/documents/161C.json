{"assets":[],"contentKind":"statement","contestId":"161","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Abracadabra"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarpus analyzes a string called "},{"children":[{"kind":"text","text":"abracadabra"}],"kind":"container"},{"kind":"text","text":". This string is constructed using the following algorithm: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" On the first step the string consists of a single character \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" On the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th step Polycarpus concatenates two copies of the string obtained on the "},{"kind":"math_inline","text":"(k - 1)"},{"kind":"text","text":"-th step, while inserting the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th character of the alphabet between them. Polycarpus uses the alphabet that consists of lowercase Latin letters and digits (a total of 36 characters). The alphabet characters are numbered like this: the 1-st character is \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", the 2-nd — \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\", ..., the 26-th — \""},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"\", the 27-th — \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\", the 28-th — \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\", ..., the 36-th — \""},{"children":[{"kind":"text","text":"9"}],"kind":"container"},{"kind":"text","text":"\". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let's have a closer look at the algorithm. On the second step Polycarpus will concatenate two strings \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" and insert the character \""},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"\" between them, resulting in \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\" string. The third step will transform it into \""},{"children":[{"kind":"text","text":"abacaba"}],"kind":"container"},{"kind":"text","text":"\", and the fourth one - into \""},{"children":[{"kind":"text","text":"abacabadabacaba"}],"kind":"container"},{"kind":"text","text":"\". Thus, the string constructed on the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th step will consist of "},{"kind":"math_inline","text":"2k - 1"},{"kind":"text","text":" characters. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus wrote down the string he got after 30 steps of the given algorithm and chose two non-empty substrings of it. Your task is to find the length of the longest common substring of the two substrings selected by Polycarpus."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A substring "},{"kind":"math_inline","text":"s[i... j]"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ j ≤ |s|"},{"kind":"text","text":") of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" = "},{"kind":"math_inline","text":"s1s2... s|s|"},{"kind":"text","text":" is a string "},{"kind":"math_inline","text":"sisi + 1... sj"},{"kind":"text","text":". For example, substring "},{"kind":"math_inline","text":"s[2...4]"},{"kind":"text","text":" of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" = \""},{"children":[{"kind":"text","text":"abacaba"}],"kind":"container"},{"kind":"text","text":"\" equals \""},{"children":[{"kind":"text","text":"bac"}],"kind":"container"},{"kind":"text","text":"\". The string is its own substring."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The longest common substring of two strings "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is the longest string that is a substring of both "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". For example, the longest common substring of \""},{"children":[{"kind":"text","text":"contest"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"systemtesting"}],"kind":"container"},{"kind":"text","text":"\" is string \""},{"children":[{"kind":"text","text":"test"}],"kind":"container"},{"kind":"text","text":"\". There can be several common substrings of maximum length."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of a single line containing four integers "},{"kind":"math_inline","text":"l1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"i = 1, 2"},{"kind":"text","text":"). The numbers are separated by single spaces. "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" give the indices of the first and the last characters of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th chosen substring, correspondingly ("},{"kind":"math_inline","text":"i = 1, 2"},{"kind":"text","text":"). The characters of string "},{"children":[{"kind":"text","text":"abracadabra"}],"kind":"container"},{"kind":"text","text":" are numbered starting from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the length of the longest common substring of the given strings. If there are no common substrings, print 0."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6 1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the first substring is \""},{"children":[{"kind":"text","text":"acab"}],"kind":"container"},{"kind":"text","text":"\", the second one is \""},{"children":[{"kind":"text","text":"abac"}],"kind":"container"},{"kind":"text","text":"\". These two substrings have two longest common substrings \""},{"children":[{"kind":"text","text":"ac"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", but we are only interested in their length — 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the first substring is \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", the second one is \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\". These two substrings don't have any common characters, so the length of their longest common substring is 0."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"161C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/161/problem/C"}