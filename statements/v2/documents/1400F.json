{"assets":[],"contentKind":"statement","contestId":"1400","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. x-prime Substrings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an integer value $$$x$$$ and a string $$$s$$$ consisting of digits from $$$1$$$ to $$$9$$$ inclusive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A substring of a string is a contiguous subsequence of that string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$f(l, r)$$$ be the sum of digits of a substring $$$s[l..r]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call substring $$$s[l_1..r_1]$$$ "},{"children":[{"kind":"text","text":"$$$x$$$-prime"}],"kind":"container"},{"kind":"text","text":" if "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$f(l_1, r_1) = x$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" there are no values $$$l_2, r_2$$$ such that "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$l_1 \\le l_2 \\le r_2 \\le r_1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$f(l_2, r_2) \\neq x$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$x$$$ is divisible by $$$f(l_2, r_2)$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are allowed to erase some characters from the string. If you erase a character, the two resulting parts of the string are concatenated without changing their order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of characters you should erase from the string so that there are no "},{"children":[{"kind":"text","text":"$$$x$$$-prime"}],"kind":"container"},{"kind":"text","text":" substrings in it? If there are no "},{"children":[{"kind":"text","text":"$$$x$$$-prime"}],"kind":"container"},{"kind":"text","text":" substrings in the given string $$$s$$$, then print $$$0$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a string $$$s$$$ ($$$1 \\le |s| \\le 1000$$$). $$$s$$$ contains only digits from $$$1$$$ to $$$9$$$ inclusive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains an integer $$$x$$$ ($$$1 \\le x \\le 20$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum number of characters you should erase from the string so that there are no "},{"children":[{"kind":"text","text":"$$$x$$$-prime"}],"kind":"container"},{"kind":"text","text":" substrings in it. If there are no "},{"children":[{"kind":"text","text":"$$$x$$$-prime"}],"kind":"container"},{"kind":"text","text":" substrings in the given string $$$s$$$, then print $$$0$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n116285317\n8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n314159265359\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n13\n13\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3434343434\n7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example there are two $$$8$$$-prime substrings \""},{"children":[{"kind":"text","text":"8"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"53"}],"kind":"container"},{"kind":"text","text":"\". You can erase these characters to get rid of both: \""},{"children":[{"kind":"text","text":"1162"},{"children":[{"kind":"text","text":"85"}],"kind":"container"},{"kind":"text","text":"317"}],"kind":"container"},{"kind":"text","text":"\". The resulting string \""},{"children":[{"kind":"text","text":"1162317"}],"kind":"container"},{"kind":"text","text":"\" contains no $$$8$$$-prime substrings. Removing these characters is also a valid answer: \""},{"children":[{"kind":"text","text":"1162"},{"children":[{"kind":"text","text":"8"}],"kind":"container"},{"kind":"text","text":"5"},{"children":[{"kind":"text","text":"3"}],"kind":"container"},{"kind":"text","text":"17"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example you just have to erase both ones."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example there are no $$$13$$$-prime substrings. There are no substrings with the sum of digits equal to $$$13$$$ at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example you can have neither \""},{"children":[{"kind":"text","text":"34"}],"kind":"container"},{"kind":"text","text":"\", nor \""},{"children":[{"kind":"text","text":"43"}],"kind":"container"},{"kind":"text","text":"\" in a string. Thus, you have to erase either all threes or all fours. There are $$$5$$$ of each of them, so it doesn't matter which."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1400F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1400/problem/F"}