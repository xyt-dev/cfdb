{"assets":[],"contentKind":"statement","contestId":"1005","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Polycarp and Div 3"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp likes numbers that are divisible by 3."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He has a huge number $$$s$$$. Polycarp wants to cut from it the maximum number of numbers that are divisible by $$$3$$$. To do this, he makes an arbitrary number of vertical cuts between pairs of adjacent digits. As a result, after $$$m$$$ such cuts, there will be $$$m+1$$$ parts in total. Polycarp analyzes each of the obtained numbers and finds the number of those that are divisible by $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if the original number is $$$s=3121$$$, then Polycarp can cut it into three parts with two cuts: $$$3|1|21$$$. As a result, he will get two numbers that are divisible by $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp can make an arbitrary number of vertical cuts, where each cut is made between a pair of adjacent digits. The resulting numbers cannot contain extra leading zeroes (that is, the number can begin with "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" if and only if this number is exactly one character '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"'). For example, "},{"children":[{"kind":"text","text":"007"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"00099"}],"kind":"container"},{"kind":"text","text":" are not valid numbers, but "},{"children":[{"kind":"text","text":"90"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"10001"}],"kind":"container"},{"kind":"text","text":" are valid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the maximum number of numbers divisible by $$$3$$$ that Polycarp can obtain?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a positive integer $$$s$$$. The number of digits of the number $$$s$$$ is between $$$1$$$ and $$$2\\cdot10^5$$$, inclusive. The first (leftmost) digit is not equal to "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum number of numbers divisible by $$$3$$$ that Polycarp can get by making vertical cuts in the given number $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3121\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1000000000000000000000000000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"33\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"201920181\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, an example set of optimal cuts on the number is "},{"children":[{"kind":"text","text":"3|1|21"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, you do not need to make any cuts. The specified number "},{"children":[{"kind":"text","text":"6"}],"kind":"container"},{"kind":"text","text":" forms one number that is divisible by $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, cuts must be made between each pair of digits. As a result, Polycarp gets one digit "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" and $$$33$$$ digits "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":". Each of the $$$33$$$ digits "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" forms a number that is divisible by $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example, an example set of optimal cuts is "},{"children":[{"kind":"text","text":"2|0|1|9|201|81"}],"kind":"container"},{"kind":"text","text":". The numbers $$$0$$$, $$$9$$$, $$$201$$$ and $$$81$$$ are divisible by $$$3$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1005D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1005/problem/D"}