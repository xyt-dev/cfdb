{"assets":["/statement-assets/cd2847d59e34ad488d859543045936d082161be1b7bccf7cde026e3f01f347df.png"],"contentKind":"statement","contestId":"1760","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Challenging Valleys"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array $$$a[0 \\dots n-1]$$$ of $$$n$$$ integers. This array is called a \""},{"children":[{"kind":"text","text":"valley"}],"kind":"container"},{"kind":"text","text":"\" if there exists "},{"children":[{"kind":"text","text":"exactly one"}],"kind":"container"},{"kind":"text","text":" subarray $$$a[l \\dots r]$$$ such that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$0 \\le l \\le r \\le n-1$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_l = a_{l+1} = a_{l+2} = \\dots = a_r$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$l = 0$$$ or $$$a_{l-1} \\gt a_{l}$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$r = n-1$$$ or $$$a_r \\lt a_{r+1}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Here are three examples:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/cd2847d59e34ad488d859543045936d082161be1b7bccf7cde026e3f01f347df.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The first image shows the array [$$$3, 2, 2, 1, 2, 2, 3$$$], it "},{"children":[{"kind":"text","text":"is a valley"}],"kind":"container"},{"kind":"text","text":" because only subarray with indices $$$l=r=3$$$ satisfies the condition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second image shows the array [$$$1, 1, 1, 2, 3, 3, 4, 5, 6, 6, 6$$$], it "},{"children":[{"kind":"text","text":"is a valley"}],"kind":"container"},{"kind":"text","text":" because only subarray with indices $$$l=0, r=2$$$ satisfies the codition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third image shows the array [$$$1, 2, 3, 4, 3, 2, 1$$$], it "},{"children":[{"kind":"text","text":"is not a valley"}],"kind":"container"},{"kind":"text","text":" because two subarrays $$$l=r=0$$$ and $$$l=r=6$$$ that satisfy the condition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are asked whether the given array is a valley or not."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note that we consider the array to be indexed from $$$0$$$."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\leq n \\leq 2\\cdot10^5$$$) — the length of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_i$$$ ($$$1 \\leq a_i \\leq 10^9$$$) — the elements of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases is smaller than $$$2\\cdot10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if the array is a valley, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output the answer in any case (for example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be recognized as a positive answer)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n7\n3 2 2 1 2 2 3\n11\n1 1 1 2 3 3 4 5 6 6 6\n7\n1 2 3 4 3 2 1\n7\n9 7 4 6 9 9 10\n1\n1000000000\n8\n9 4 4 5 9 4 9 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nYES\nNO\nYES\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first three test cases are explained in the statement."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1760D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1760/problem/D"}