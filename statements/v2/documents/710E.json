{"assets":[],"contentKind":"statement","contestId":"710","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Generate a String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"zscoder"}],"kind":"container"},{"kind":"text","text":" wants to generate an input file for some programming competition problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"His input is a string consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" letters 'a'. He is too lazy to write a generator so he will manually generate the input in a text editor."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially, the text editor is empty. It takes him "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" seconds to insert or delete a letter 'a' from the text file and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" seconds to copy the contents of the entire text file, and duplicate it."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"zscoder"}],"kind":"container"},{"kind":"text","text":" wants to find the minimum amount of time needed for him to create the input file of exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" letters 'a'. Help him to determine the amount of time needed to generate the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kin