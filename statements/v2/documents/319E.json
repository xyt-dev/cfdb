{"assets":[],"contentKind":"statement","contestId":"319","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Ping-Pong"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In this problem at each moment you have a set of intervals. You can move from interval "},{"kind":"math_inline","text":"(a, b)"},{"kind":"text","text":" from our set to interval "},{"kind":"math_inline","text":"(c, d)"},{"kind":"text","text":" from our set if and only if "},{"kind":"math_inline","text":"c < a < d"},{"children":[{"kind":"text","text":"or"}],"kind":"container"},{"kind":"math_inline","text":"c < b < d"},{"kind":"text","text":". Also there is a path from interval "},{"kind":"math_inline","text":"I1"},{"kind":"text","text":" from our set to interval "},{"kind":"math_inline","text":"I2"},{"kind":"text","text":" from our set if there is a sequence of successive moves starting from "},{"kind":"math_inline","text":"I1"},{"kind":"text","text":" so that we can reach "},{"kind":"math_inline","text":"I2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your program should handle the queries of the following two types:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"1 x y"}],"kind":"container"},{"kind":"text","text":"\" "},{"kind":"math_inline","text":"(x < y)"},{"kind":"text","text":" — add the new interval "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" to the set of intervals. The length of the new interval is guaranteed to be strictly greater than all the previous intervals."}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"2 a b"}],"kind":"container"},{"kind":"text","text":"\" "},{"kind":"math_inline","text":"(a ≠ b)"},{"kind":"text","text":" — answer the question: is there a path from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"-th (one-based) added interval to "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"-th (one-based) added interval? "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Answer all the queries. Note, that initially you have an empty set of intervals."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" denoting the number of queries, "},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":". Each of the following lines contains a query as described above. All numbers in the input are integers and don't exceed "},{"kind":"math_inline","text":"109"},{"kind":"text","text":" by their absolute value."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that all queries are correct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the second type print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" on a separate line depending on the answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 1 5\n1 5 11\n2 1 2\n1 2 9\n2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"319E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/319/problem/E"}