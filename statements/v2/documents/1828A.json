{"assets":[],"contentKind":"statement","contestId":"1828","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Divisible Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a positive integer $$$n$$$. Please find an array $$$a_1, a_2, \\ldots, a_n$$$ that is perfect."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A perfect array $$$a_1, a_2, \\ldots, a_n$$$ satisfies the following criteria: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1 \\le a_i \\le 1000$$$ for all $$$1 \\le i \\le n$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_i$$$ is divisible by $$$i$$$ for all $$$1 \\le i \\le n$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_1 + a_2 + \\ldots + a_n$$$ is divisible by $$$n$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 200$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a single positive integer $$$n$$$ ($$$1 \\le n \\le 200$$$) — the length of the array $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output an array $$$a_1, a_2, \\ldots, a_n$$$ that is perfect."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can show that an answer always exists. If there are multiple solutions, print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n1\n2\n3\n4\n5\n6\n7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n2 4\n1 2 3\n2 8 6 4\n3 4 9 4 5\n1 10 18 8 5 36\n3 6 21 24 10 6 14\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the third test case: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a_1 = 1$$$ is divisible by $$$1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_2 = 2$$$ is divisible by $$$2$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_3 = 3$$$ is divisible by $$$3$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_1 + a_2 + a_3 = 1 + 2 + 3 = 6$$$ is divisible by $$$3$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the fifth test case: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a_1 = 3$$$ is divisible by $$$1$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_2 = 4$$$ is divisible 