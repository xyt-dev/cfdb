{"assets":[],"contentKind":"statement","contestId":"714","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Filya and Homework"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Today, hedgehog Filya went to school for the very first time! Teacher gave him a homework which Filya was unable to complete without your help."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Filya is given an array of non-negative integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". First, he pick an integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and then he adds "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to some elements of the array (no more than once), subtract "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" from some other elements (also, no more than once) and do no change other elements. He wants all elements of the array to be equal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now he wonders if it's possible to pick such integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and change some elements of the array using this "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" in order to make all elements equal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of integers in the Filya's array. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 109"},{"kind":"text","text":") — elements of the array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it's impossible to make all elements of the array equal using the process given in the problem statement, then print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in the only line of the output. Otherwise print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 3 3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Filya should select "},{"kind":"math_inline","text":"x = 1"},{"kind":"text","text":", then add it to the first and the last elements of the array and subtract from the second and the third elements."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"714B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/714/problem/B"}