{"assets":[],"contentKind":"statement","contestId":"479","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Expression"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya studies in a school and he adores Maths. His class has been studying arithmetic expressions. On the last class the teacher wrote three positive integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" on the blackboard. The task was to insert signs of operations '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"', and probably brackets between the numbers so that the value of the resulting expression is as large as possible. Let's consider an example: assume that the teacher wrote numbers 1, 2 and 3 on the blackboard. Here are some ways of placing signs and brackets:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" 1+2*3=7 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 1*(2+3)=5 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" 1*2*3=6 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" (1+2)*3=9 "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that you can insert operation signs only between "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", and between "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", that is, you cannot swap integers. For instance, in the given sample you cannot get expression (1+3)*2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's easy to see that the maximum value that you can obtain is 9."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is: given "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" print the maximum value that you can get."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input contains three integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", each on a single line ("},{"kind":"math_inline","text":"1 ≤ a, b, c ≤ 10"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum value of the expression that you can obtain."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n10\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"60\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"479A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/479/problem/A"}