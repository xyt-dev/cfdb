{"assets":[],"contentKind":"statement","contestId":"23","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Tetragon"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You're given the centers of three equal sides of a strictly convex tetragon. Your task is to restore the initial tetragon."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains one number "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" — amount of tests ("},{"kind":"math_inline","text":"1 ≤ T ≤ 5·104"},{"kind":"text","text":"). Each of the following "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" lines contains numbers "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y3"},{"kind":"text","text":" — coordinates of different points that are the centers of three equal sides (non-negative integer numbers, not exceeding 10)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test output two lines. If the required tetragon exists, output in the first line "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":", in the second line — four pairs of numbers — coordinates of the polygon's vertices in clockwise or counter-clockwise order. Don't forget, please, that the tetragon should be strictly convex, i.e. no 3 of its points lie on one line. Output numbers with 9 characters after a decimal point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the required tetragon doen't exist, output "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" in the first line, and leave the second line empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 2 2 3 3\n0 1 1 0 2 2\n9 3 7 9 9 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n\nYES\n3.5 1.5 0.5 2.5 -0.5 -0.5 2.5 0.5\nNO\n\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"23D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/23/problem/D"}