{"assets":[],"contentKind":"statement","contestId":"656","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. You're a Professional"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A simple recommendation system would recommend a user things liked by a certain number of their friends. In this problem you will implement part of such a system."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given user's friends' opinions about a list of items. You are also given a threshold "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" — the minimal number of \"likes\" necessary for an item to be recommended to the user."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Output the number of items in the list liked by at least "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" of user's friends."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input will contain three space-separated integers: the number of friends "},{"kind":"math_inline","text":"F"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ F ≤ 10"},{"kind":"text","text":"), the number of items "},{"kind":"math_inline","text":"I"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ I ≤ 10"},{"kind":"text","text":") and the threshold "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ T ≤ F"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"F"},{"kind":"text","text":" lines of input contain user's friends' opinions. "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th character of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line is '"},{"children":[{"kind":"text","text":"Y"}],"kind":"container"},{"kind":"text","text":"' if "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th friend likes "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th item, and '"},{"children":[{"kind":"text","text":"N"}],"kind":"container"},{"kind":"text","text":"' otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output an integer — the number of items liked by at least "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" of user's friends."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 2\nYYY\nNNN\nYNY\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4 1\nNNNY\nNNYN\nNYNN\nYNNN\n"}],"kind":"section"},