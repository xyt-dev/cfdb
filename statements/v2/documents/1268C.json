{"assets":[],"contentKind":"statement","contestId":"1268","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. K Integers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a permutation $$$p_1, p_2, \\ldots, p_n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one move you can swap two adjacent values."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You want to perform a minimum number of moves, such that in the end there will exist a subsegment $$$1,2,\\ldots, k$$$, in other words in the end there should be an integer $$$i$$$, $$$1 \\leq i \\leq n-k+1$$$ such that $$$p_i = 1, p_{i+1} = 2, \\ldots, p_{i+k-1}=k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$f(k)$$$ be the minimum number of moves that you need to make a subsegment with values $$$1,2,\\ldots,k$$$ appear in the permutation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to find $$$f(1), f(2), \\ldots, f(n)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains one integer $$$n$$$ ($$$1 \\leq n \\leq 200\\,000$$$): the number of elements in the permutation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line of input contains $$$n$$$ integers $$$p_1, p_2, \\ldots, p_n$$$: given permutation ($$$1 \\leq p_i \\leq n$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$n$$$ integers, the minimum number of moves that you need to make a subsegment with values $$$1,2,\\ldots,k$$$ appear in the permutation, for $$$k=1, 2, \\ldots, n$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n5 4 3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0 1 3 6 10 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0 0 0 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1268C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1268/problem/C"}