{"assets":["/statement-assets/9e21ab2d936c5d6654f4344f48b991f99df962183fb719a709fc46112d3d3af8.png"],"contentKind":"statement","contestId":"280","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Rectangle Puzzle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two rectangles on a plane. The centers of both rectangles are located in the origin of coordinates (meaning the center of the rectangle's symmetry). The first rectangle's sides are parallel to the coordinate axes: the length of the side that is parallel to the "},{"kind":"math_inline","text":"Ox"},{"kind":"text","text":" axis, equals "},{"kind":"math_inline","text":"w"},{"kind":"text","text":", the length of the side that is parallel to the "},{"kind":"math_inline","text":"Oy"},{"kind":"text","text":" axis, equals "},{"kind":"math_inline","text":"h"},{"kind":"text","text":". The second rectangle can be obtained by rotating the first rectangle relative to the origin of coordinates by angle "},{"kind":"math_inline","text":"α"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9e21ab2d936c5d6654f4344f48b991f99df962183fb719a709fc46112d3d3af8.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Your task is to find the area of the region which belongs to both given rectangles. This region is shaded in the picture."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"w, h, α"},{"kind":"math_inline","text":"(1 ≤ w, h ≤ 106; 0 ≤ α ≤ 180)"},{"kind":"text","text":". Angle "},{"kind":"math_inline","text":"α"},{"kind":"text","text":" is given in degrees."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print a real number — the area of the region which belongs to both given rectangles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer will be considered correct if its relative or absolute error doesn't exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 45\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.828427125\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 4 30\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"19.668384925\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The second sample has been drawn on the picture above."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"280A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/280/problem/A"}