{"assets":["/statement-assets/b7a64d400093058081913847b48c0c5a27cd7683922047fc079be554993c16ca.png"],"contentKind":"statement","contestId":"237","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. T-decomposition"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got a undirected tree "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes. Your task is to build an optimal T-decomposition for it. Let's define a T-decomposition as follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's denote the set of all nodes "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". Let's consider an undirected tree "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", whose nodes are some non-empty subsets of "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", we'll call them "},{"kind":"math_inline","text":"xi"},{"attrs":{"alt":"","src":"/statement-assets/b7a64d400093058081913847b48c0c5a27cd7683922047fc079be554993c16ca.png"},"kind":"image"},{"kind":"text","text":". The tree "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is a T-decomposition of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", if the following conditions holds:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" the union of all "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" equals "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for any edge "},{"kind":"math_inline","text":"(a, b)"},{"kind":"text","text":" of tree "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" exists the tree node "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", containing both "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if the nodes of the tree "},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"xj"},{"kind":"text","text":" contain the node "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of the tree "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", then all nodes of the tree "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", lying on the path from "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"xj"},{"kind":"text","text":" also contain node "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". So this condition is equivalent to the following: all nodes of the tree "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", that contain node "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of the tree "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", form a connected subtree of tree "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"There are obviously many distinct trees "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", that are T-decompositions of the tree "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". For example, a T-decomposition is a tree that consists of a single node, equal to set "},{"kind":"math_inline","text":"v"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define the cardinality of node "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" as the number of nodes in tree "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", containing in the node. Let's choose the node with the maximum cardinality in "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Let's assume that its cardinality equals "},{"kind":"math_inline","text":"w"},{"kind":"text","text":". Then the weight of T-decomposition "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is value "},{"kind":"math_inline","text":"w"},{"kind":"text","text":". The optimal T-decomposition is the one with the minimum weight."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the optimal T-decomposition of the given tree "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" that has the minimum number of nodes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(2 ≤ n ≤ 105)"},{"kind":"text","text":", that denotes the number of nodes in tree "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains two space-separated integers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"math_inline","text":"(1 ≤ ai, bi ≤ n; ai ≠ bi)"},{"kind":"text","text":", denoting that the nodes of tree "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" with indices "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" are connected by an edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider the nodes of tree "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" indexed from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". It is guaranteed that "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" that denotes the number of nodes in the required T-decomposition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines, containing descriptions of the T-decomposition nodes. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th "},{"kind":"math_inline","text":"(1 ≤ i ≤ m)"},{"kind":"text","text":" of them print the description of node "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" of the T-decomposition. The description of each node "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" should start from an integer "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":", that represents the number of nodes of the initial tree "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", that are contained in the node "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". Then you should print "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" distinct space-separated integers — the numbers of nodes from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", contained in "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", in arbitrary order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then print "},{"kind":"math_inline","text":"m - 1"},{"kind":"text","text":" lines, each consisting two integers "},{"kind":"math_inline","text":"pi, qi"},{"kind":"math_inline","text":"(1 ≤ pi, qi ≤ m; pi ≠ qi)"},{"kind":"text","text":". The pair of integers "},{"kind":"math_inline","text":"pi, qi"},{"kind":"text","text":" means there is an edge between nodes "},{"kind":"math_inline","text":"xpi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"xqi"},{"kind":"text","text":" of T-decomposition."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The printed T-decomposition should be the optimal T-decomposition for the given tree "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and have the minimum possible number of nodes among all optimal T-decompositions. If there are multiple optimal T-decompositions with the minimum number of nodes, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2 1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 1 2\n2 2 3\n1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 1\n3 1\n4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 2 1\n2 3 1\n2 4 1\n1 2\n2 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"237D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/237/problem/D"}