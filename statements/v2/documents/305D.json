{"assets":[],"contentKind":"statement","contestId":"305","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Olya and Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Olya has got a directed non-weighted graph, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertexes and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges. We will consider that the graph vertexes are indexed from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in some manner. Then for any graph edge that goes from vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" the following inequation holds: "},{"kind":"math_inline","text":"v < u"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Olya wonders, how many ways there are to add an arbitrary (possibly zero) number of edges to the graph so as the following conditions were met:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" You can reach vertexes number "},{"kind":"math_inline","text":"i + 1, i + 2, ..., n"},{"kind":"text","text":" from any vertex number "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(i < n)"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For any graph edge going from vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" the following inequation fulfills: "},{"kind":"math_inline","text":"v < u"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There is at most one edge between any two vertexes. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The shortest distance between the pair of vertexes "},{"kind":"math_inline","text":"i, j"},{"kind":"math_inline","text":"(i < j)"},{"kind":"text","text":", for which "},{"kind":"math_inline","text":"j - i ≤ k"},{"kind":"text","text":" holds, equals "},{"kind":"math_inline","text":"j - i"},{"kind":"text","text":" edges. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The shortest distance between the pair of vertexes "},{"kind":"math_inline","text":"i, j"},{"kind":"math_inline","text":"(i < j)"},{"kind":"text","text":", for which "},{"kind":"math_inline","text":"j - i > k"},{"kind":"text","text":" holds, equals either "},{"kind":"math_inline","text":"j - i"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"j - i - k"},{"kind":"text","text":" edges. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"We will consider two ways "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":", if there is the pair of vertexes "},{"kind":"math_inline","text":"i, j"},{"kind":"math_inline","text":"(i < j)"},{"kind":"text","text":", such that first resulting graph has an edge from "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" and the second one doesn't have it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Olya. As the required number of ways can be rather large, print it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three space-separated integers "},{"kind":"math_inline","text":"n, m, k"},{"kind":"math_inline","text":"(2 ≤ n ≤ 106, 0 ≤ m ≤ 105, 1 ≤ k ≤ 106)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the description of the edges of the initial graph. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains a pair of space-separated integers "},{"kind":"math_inline","text":"ui, vi"},{"kind":"math_inline","text":"(1 ≤ ui < vi ≤ n)"},{"kind":"text","text":" — the numbers of vertexes that have a directed edge from "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" between them. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that any pair of vertexes "},{"kind":"math_inline","text":"ui, vi"},{"kind":"text","text":" has at most one edge between them. It also is guaranteed that the graph edges are given in the order of non-decreasing "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":". If there are multiple edges going from vertex "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":", then it is guaranteed that these edges are given in the order of increasing "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the answer to the problem modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 8 2\n1 2\n2 3\n3 4\n3 6\n4 5\n4 7\n5 6\n6 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 2 1\n1 3\n3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample there are two ways: the first way is not to add anything, the second way is to add a single edge from vertex "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to vertex "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"305D","schema":