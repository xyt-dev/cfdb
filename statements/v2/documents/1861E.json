{"assets":[],"contentKind":"statement","contestId":"1861","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Non-Intersecting Subpermutations"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two integers $$$n$$$ and $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For an array of length $$$n$$$, let's define its "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" as the maximum number of contiguous subarrays of this array that can be chosen so that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" each element belongs to at most one subarray; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the length of each subarray is exactly $$$k$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" each subarray contains each integer from $$$1$$$ to $$$k$$$ exactly once. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, if $$$n = 10$$$, $$$k = 3$$$ and the array is $$$[1, 2, 1, 3, 2, 3, 2, 3, 1, 3]$$$, its cost is $$$2$$$ because, for example, we can choose the subarrays from the $$$2$$$-nd element to the $$$4$$$-th element and from the $$$7$$$-th element to the $$$9$$$-th element, and we can show that it's impossible to choose more than $$$2$$$ subarrays."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Calculate the sum of costs over all arrays of length $$$n$$$ consisting of integers from $$$1$$$ to $$$k$$$, and print it modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains two integers $$$n$$$ and $$$k$$$ ($$$2 \\le k \\le n \\le 4000$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the sum of costs of all arrays of length $$$n$$$ consisting of integers from $$$1$$$ to $$$k$$$ taken modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n71712\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1337 42\n"}