{"assets":["/statement-assets/e24777ddd35db6f776e983d32c3d7644a005f351c7f744784ec5d8208da425b2.png"],"contentKind":"statement","contestId":"1749","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Distance to the Path"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a tree consisting of $$$n$$$ vertices. Initially, each vertex has a value $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to perform $$$m$$$ queries of two types: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" You are given a vertex index $$$v$$$. Print the value of the vertex $$$v$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" You are given two vertex indices $$$u$$$ and $$$v$$$ and values $$$k$$$ and $$$d$$$ ($$$d \\le 20$$$). You need to add $$$k$$$ to the value of each vertex such that the distance from that vertex to the path from $$$u$$$ to $$$v$$$ is less than or equal to $$$d$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"distance"}],"kind":"container"},{"kind":"text","text":" between two vertices $$$x$$$ and $$$y$$$ is equal to the number of "},{"children":[{"kind":"text","text":"edges"}],"kind":"container"},{"kind":"text","text":" on the path from $$$x$$$ to $$$y$$$. For example, the distance from $$$x$$$ to $$$x$$$ itself is equal to $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The distance from the vertex $$$v$$$ to some path from $$$x$$$ to $$$y$$$ is equal to the minimum among distances from $$$v$$$ to any vertex on the path from $$$x$$$ to $$$y$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$2 \\le n \\le 2 \\cdot 10^5$$$) — the number of vertices in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$n - 1$$$ lines contain the edges of the tree — one per line. Each line contains two integers $$$u$$$ and $$$v$$$ ($$$1 \\le u, v \\le n$$$; $$$u \\neq v$$$) representing one edge of the tree. It's guaranteed that the given edges form a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains a single integer $$$m$$$ ($$$1 \\le m \\le 2 \\cdot 10^5$$$) — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$m$$$ lines contain the queries — one per line. Each query has one of the following two types: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1$$$ $$$v$$$ ($$$1 \\le v \\le n$$$) — the query of the first type; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$2$$$ $$$u$$$ $$$v$$$ $$$k$$$ $$$d$$$ ($$$1 \\le u, v \\le n$$$; $$$1 \\le k \\le 1000$$$; $$$0 \\le d \\le 20$$$) — the query of the second type. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Additional constraint on the input: there is at least one query of the first type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the first type, print the value of the corresponding vertex."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 2\n1 3\n4 2\n5 2\n3 6\n14\n2 4 5 10 2\n1 3\n1 6\n2 1 1 10 20\n2 6 6 10 20\n1 3\n2 3 2 10 0\n2 5 2 10 1\n1 1\n1 2\n1 3\n1 4\n1 5\n1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n0\n30\n50\n50\n40\n40\n40\n20\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The tree from the first example: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e24777ddd35db6f776e983d32c3d7644a005f351c7f744784ec5d8208da425b2.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" Some query explanations: "},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \"$$$2$$$ $$$4$$$ $$$5$$$ $$$10$$$ $$$2$$$\": affected vertices are $$$\\{4, 2, 5, 1, 3\\}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \"$$$2$$$ $$$1$$$ $$$1$$$ $$$10$$$ $$$20$$$\" and \"$$$2$$$ $$$6$$$ $$$6$$$ $$$10$$$ $$$20$$$\": all vertices are affected, since distance to $$$1$$$ ($$$6$$$) is less that $$$20$$$ for any vertex; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \"$$$2$$$ $$$3$$$ $$$2$$$ $$$10$$$ $$$0$$$\": affected vertices are $$$\\{3, 1, 2\\}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \"$$$2$$$ $$$5$$$ $$$2$$$ $$$10$$$ $$$1$$$\": affected vertices are $$$\\{5, 2, 4, 1\\}$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1749F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1749/problem/F"}