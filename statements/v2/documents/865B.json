{"assets":[],"contentKind":"statement","contestId":"865","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Ordering Pizza"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"It's another Start[c]up finals, and that means there is pizza to order for the onsite contestants. There are only 2 types of pizza (obviously not, but let's just pretend for the sake of the problem), and all pizzas contain exactly "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" slices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is known that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th contestant will eat "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" slices of pizza, and gain "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" happiness for each slice of type 1 pizza they eat, and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" happiness for each slice of type 2 pizza they eat. We can order any number of type 1 and type 2 pizzas, but we want to buy the minimum possible number of pizzas for all of the contestants to be able to eat their required number of slices. Given that restriction, what is the maximum possible total happiness that can be achieved?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input will contain integers "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"S"},{"kind":"math_inline","text":"(1 ≤ N ≤ 105, 1 ≤ S ≤ 105)"},{"kind":"text","text":", the number of contestants and the number of slices per pizza, respectively. "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" lines follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th such line contains integers "},{"kind":"math_inline","text":"si"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"bi"},{"kind":"math_inline","text":"(1 ≤ si ≤ 105, 1 ≤ ai ≤ 105, 1 ≤ bi ≤ 105)"},{"kind":"text","text":", the number of slices the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th contestant will eat, the happiness they will gain from each type 1 slice they eat, and the happiness they will gain from each type 2 slice they eat, respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the maximum total happiness that can be achieved."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 12\n3 5 7\n4 6 7\n5 9 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"84\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 10\n7 4 7\n5 8 8\n12 5 8\n6 11 6\n3 3 7\n5 9 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"314\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, you only need to buy one pizza. If you buy a type 1 pizza, the total happiness will be "},{"kind":"math_inline","text":"3·5 + 4·6 + 5·9 = 84"},{"kind":"text","text":", and if you buy a type 2 pizza, the total happiness will be "},{"kind":"math_inline","text":"3·7 + 4·7 + 5·5 = 74"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"865B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/865/problem/B"}