{"assets":[],"contentKind":"statement","contestId":"1910","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Username"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"On the official website of Berland, each account has two parameters: username and ID."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Username is a string consisting of lowercase Latin letters and/or digits, which contains at least one letter. For example, "},{"children":[{"kind":"text","text":"user0"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"1fox1"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"zzzz"}],"kind":"container"},{"kind":"text","text":" are correct usernames, but "},{"children":[{"kind":"text","text":"1337"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"User22"}],"kind":"container"},{"kind":"text","text":" are not. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The ID of the account for a given username is generated as follows: a "},{"children":[{"kind":"text","text":"positive integer without leading zeroes"}],"kind":"container"},{"kind":"text","text":" is appended to the end of the username. For example, the ID "},{"children":[{"kind":"text","text":"user0125"}],"kind":"container"},{"kind":"text","text":" can be generated by the following usernames: "},{"children":[{"kind":"text","text":"user012"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"user01"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"user0"}],"kind":"container"},{"kind":"text","text":"; but neither by "},{"children":[{"kind":"text","text":"user"}],"kind":"container"},{"kind":"text","text":" nor "},{"children":[{"kind":"text","text":"us"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string $$$s$$$ — a valid ID. Your task is to determine any valid username that can generate the given ID. If there are several correct usernames, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^3$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a string $$$s$$$ ($$$2 \\le |s| \\le 50$$$), consisting of lowercase Latin letters and/or digits."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraint on input: there is at least one valid username that can generate the given ID."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case on a separate line, print a string — any valid username that can generate the given ID. If there are multiple correct usernames, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nuser0125\na1\nkotlin990000\n1code0forces101\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nuser0\na\nkotlin9\n1code0forces"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1910A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1910/problem/A"}