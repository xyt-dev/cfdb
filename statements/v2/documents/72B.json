{"assets":[],"contentKind":"statement","contestId":"72","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. INI-file"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The INI file format is a de facto standard for configuration files. INI files are simple text files with a basic structure. They are commonly associated with Microsoft Windows, but are also used on other platforms."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each line in INI-file stands for key-value mapping or defines new section. A key-value line has a format \""},{"children":[{"kind":"text","text":"key=value"}],"kind":"container"},{"kind":"text","text":"\",where "},{"children":[{"kind":"text","text":"key"}],"kind":"container"},{"kind":"text","text":" — is the name of some property, and "},{"children":[{"kind":"text","text":"value"}],"kind":"container"},{"kind":"text","text":" — it's value. It is possible that it will be spaces from the both sides of "},{"children":[{"kind":"text","text":"key"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"value"}],"kind":"container"},{"kind":"text","text":", the spaces should be ignored."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A section line has a format \""},{"children":[{"kind":"text","text":"[section]"}],"kind":"container"},{"kind":"text","text":"\". It means that all key-value lines after it define properties of the specified section. Of cause, the following section line changes the current section. A section line may have spaces around any of brackets."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also you should ignore comment lines — the first non-space character of comment line is \""},{"children":[{"kind":"text","text":";"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You task is to write the program which will format given INI-file in a special way: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" first, print key-value lines which do not belong to any section; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" print all the sections in the lexicographical (alphabetical) order of their names; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" inside each of two previous items, order key-value lines lexicographically by \""},{"children":[{"kind":"text","text":"key"}],"kind":"container"},{"kind":"text","text":"\"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if there are more than one key-value lines with the same key inside a single section (or outside any sections), leave only one line (which appears later in the input data); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" remove all redundant spaces and lines. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 510"},{"kind":"text","text":") — the number of lines in given INI-file."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The rest of the input contains a valid INI-file in "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines. Values of "},{"children":[{"kind":"text","text":"section"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"key"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"value"}],"kind":"container"},{"kind":"text","text":" contain only Latin letters, digits, \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\" and/or \""},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each line has length not exceeding 255 characters and not less than 1 character. The total length of all the lines does’t exceed 10000."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print formatted INI-file."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11\na= 1\nb=a\na = 2\n ; comment\n[z]\n1=2\n[y]\n2=3\n[z]\n2=1\n[w]\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"a=2\nb=a\n[w]\n[y]\n2=3\n[z]\n1=2\n2=1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"72B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/72/problem/B"}