{"assets":["/statement-assets/1cf6a3edbee8447d6ae73e9c6e1cb76e104ffb0efcc62ebdfe84b2cfa5a2a3b0.png"],"contentKind":"statement","contestId":"757","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Bash Plays with Functions"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bash got tired on his journey to become the greatest Pokemon master. So he decides to take a break and play with functions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Bash defines a function "},{"kind":"math_inline","text":"f0(n)"},{"kind":"text","text":", which denotes the number of ways of factoring "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" into two factors "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"gcd(p, q) = 1"},{"kind":"text","text":". In other words, "},{"kind":"math_inline","text":"f0(n)"},{"kind":"text","text":" is the number of ordered pairs of positive integers "},{"kind":"math_inline","text":"(p, q)"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"p·q = n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"gcd(p, q) = 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But Bash felt that it was too easy to calculate this function. So he defined a series of functions, where "},{"kind":"math_inline","text":"fr + 1"},{"kind":"text","text":" is defined as:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1cf6a3edbee8447d6ae73e9c6e1cb76e104ffb0efcc62ebdfe84b2cfa5a2a3b0.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Where "},{"kind":"math_inline","text":"(u, v)"},{"kind":"text","text":" is any ordered pair of positive integers, they need not to be co-prime."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Bash wants to know the value of "},{"kind":"math_inline","text":"fr(n)"},{"kind":"text","text":" for different "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Since the value could be huge, he would like to know the value modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":". Help him!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 106"},{"kind":"text","text":") — the number of values Bash wants to know."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain two integers "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ r ≤ 106"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":"), which denote Bash wants to know the value "},{"kind":"math_inline","text":"fr(n)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" integers. For each pair of "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" given, print "},{"kind":"math_inline","text":"fr(n)"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":" on a separate line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 30\n1 25\n3 65\n2 5\n4 48\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n5\n25\n4\n630\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"757E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/757/problem/E"}