{"assets":["/statement-assets/85a44184fa9a6d8e675cb71f4e53600a09f078df773a02ab38069b74aeef4cbc.png","/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"],"contentKind":"statement","contestId":"276","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Little Girl and Maximum XOR"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A little girl loves problems on bitwise operations very much. Here's one of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given two integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":". Let's consider the values of "},{"attrs":{"alt":"","src":"/statement-assets/85a44184fa9a6d8e675cb71f4e53600a09f078df773a02ab38069b74aeef4cbc.png"},"kind":"image"},{"kind":"text","text":" for all pairs of integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"math_inline","text":"(l ≤ a ≤ b ≤ r)"},{"kind":"text","text":". Your task is to find the maximum value among all considered ones."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Expression "},{"attrs":{"alt":"","src":"/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"},"kind":"image"},{"kind":"text","text":" means applying bitwise excluding or operation to integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". The given operation exists in all modern programming languages, for example, in languages "},{"kind":"math_inline","text":"C"},{"kind":"text","text":"++ and "},{"kind":"math_inline","text":"Java"},{"kind":"text","text":" it is represented as \""},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":"\", in "},{"kind":"math_inline","text":"Pascal"},{"kind":"text","text":" — as \""},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains space-separated integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ 1018"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in C++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print a single integer — the maximum value of "},{"attrs":{"alt":"","src":"/statement-assets/85a44184fa9a6d8e675cb71f4e53600a09f078df773a02ab38069b74aeef4cbc.png"},"kind":"image"},{"kind":"text",