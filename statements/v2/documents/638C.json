{"assets":[],"contentKind":"statement","contestId":"638","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Road Improvement"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In Berland there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities and "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" bidirectional roads. Each road connects some pair of cities, from any city you can get to any other one using only the given roads."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In each city there is exactly one repair brigade. To repair some road, you need two teams based in the cities connected by the road to work simultaneously for one day. Both brigades repair one road for the whole day and cannot take part in repairing other roads on that day. But the repair brigade can do nothing on that day."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the minimum number of days needed to repair all the roads. The brigades cannot change the cities where they initially are."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 200 000"},{"kind":"text","text":") — the number of cities in Berland."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contains two numbers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", meaning that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road connects city "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and city "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ui ≠ vi"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"First print number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the minimum number of days needed to repair all the roads in Berland."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines print the description of the roads that should be repaired on each of the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" days. On the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print first number "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" — the number of roads that should be repaired on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day, and then "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" space-separated integers — the numbers of the roads that should be repaired on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day. The roads are numbered according to the order in the input, starting from one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple variants, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2\n3 4\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 2 1\n1 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n3 4\n5 4\n3 2\n1 3\n4 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 \n2 2 3 \n2 4 5 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample you can repair all the roads in two days, for example, if you repair roads "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" on the first day and road "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" — on the second day."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"638C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/638/problem/C"}