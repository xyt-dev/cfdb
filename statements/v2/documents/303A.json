{"assets":["/statement-assets/5c0d96f8c43b2212af1717faffa1ba540190fa105d63467106bc379d1ef8455a.png","/statement-assets/07355c9ecc237a8a3b4c40006f060b188f9d24b3f29bb30aae56b34c8b125c79.png","/statement-assets/e4fdefb0653edda2c71eae019537f3d3ce4fac832bbf43c15f33c3a354f36527.png","/statement-assets/7435f9d34680da5f365c4f9c9deee80b9122d38bbeae513221a5a8d18f08fe45.png","/statement-assets/93a9899dcbc27b7efb5b868cff5d07f11fcbfdbc8a9ad416c243ce63cec81adb.png","/statement-assets/7024ef439de550557a1146ed196a898effb87a6dfe3020c07eb350bcb1739b73.png"],"contentKind":"statement","contestId":"303","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Lucky Permutation Triple"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bike is interested in permutations. A permutation of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is an integer sequence such that each integer from 0 to "},{"kind":"math_inline","text":"(n - 1)"},{"kind":"text","text":" appears exactly once in it. For example, "},{"kind":"math_inline","text":"[0, 2, 1]"},{"kind":"text","text":" is a permutation of length 3 while both "},{"kind":"math_inline","text":"[0, 2, 2]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"[1, 2, 3]"},{"kind":"text","text":" is not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A permutation triple of permutations of length "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(a, b, c)"},{"kind":"text","text":" is called a Lucky Permutation Triple if and only if "},{"attrs":{"alt":"","src":"/statement-assets/5c0d96f8c43b2212af1717faffa1ba540190fa105d63467106bc379d1ef8455a.png"},"kind":"image"},{"kind":"text","text":". The sign "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" denotes the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th element of permutation "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". The modular equality described above denotes that the remainders after dividing "},{"kind":"math_inline","text":"ai + bi"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and dividing "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" are equal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, he has an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and wants to find a Lucky Permutation Triple. Could you please help him?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If no Lucky Permutation Triple of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" exists print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, you need to print three lines. Each line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-seperated integers. The first line must contain permutation "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", the second line — permutation "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", the third — permutation "},{"kind":"math_inline","text":"c"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 4 3 2 0\n1 0 2 4 3\n2 4 0 1 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In Sample 1, the permutation triple "},{"kind":"math_inline","text":"([1, 4, 3, 2, 0], [1, 0, 2, 4, 3], [2, 4, 0, 1, 3])"},{"kind":"text","text":" is Lucky Permutation Triple, as following holds:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"attrs":{"alt":"","src":"/statement-assets/07355c9ecc237a8a3b4c40006f060b188f9d24b3f29bb30aae56b34c8b125c79.png"},"kind":"image"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e4fdefb0653edda2c71eae019537f3d3ce4fac832bbf43c15f33c3a354f36527.png"},"kind":"image"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/7435f9d34680da5f365c4f9c9deee80b9122d38bbeae513221a5a8d18f08fe45.png"},"kind":"image"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/93a9899dcbc27b7efb5b868cff5d07f11fcbfdbc8a9ad416c243ce63cec81adb.png"},"kind":"image"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/7024ef439de550557a1146ed196a898effb87a6dfe3020c07eb350bcb1739b73.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In Sample 2, you can easily notice that no lucky permutation triple exists."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"303A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/303/problem/A"}