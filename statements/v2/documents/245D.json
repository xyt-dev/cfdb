{"assets":[],"contentKind":"statement","contestId":"245","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Restoring Table"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recently Polycarpus has learned the \"bitwise AND\" operation (which is also called \""},{"children":[{"kind":"text","text":"AND"}],"kind":"container"},{"kind":"text","text":"\") of non-negative integers. Now he wants to demonstrate the school IT teacher his superb manipulation with the learned operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For that Polycarpus came to school a little earlier and wrote on the board a sequence of non-negative integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". He also wrote a square matrix "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":". The element of matrix "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" that sits in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row in the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column (we'll denote it as "},{"kind":"math_inline","text":"bij"},{"kind":"text","text":") equals:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the \"bitwise AND\" of numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"aj"},{"kind":"text","text":" (that is, "},{"kind":"math_inline","text":"bij = ai & aj"},{"kind":"text","text":"), if "},{"kind":"math_inline","text":"i ≠ j"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" -1, if "},{"kind":"math_inline","text":"i = j"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Having written out matrix "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", Polycarpus got very happy and wiped "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" off the blackboard. But the thing is, the teacher will want this sequence to check whether Polycarpus' calculations were correct. Polycarus urgently needs to restore the removed sequence of integers, or else he won't prove that he can count correctly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Polycarpus, given matrix "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", restore the sequence of numbers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":", that he has removed from the board. Polycarpus doesn't like large numbers, so any number in the restored sequence mustn't exceed "},{"kind":"math_inline","text":"109"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 100)"},{"kind":"text","text":" — the size of square matrix "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain matrix "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers: the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th number represents the element of matrix "},{"kind":"math_inline","text":"bij"},{"kind":"text","text":". It is guaranteed, that for all "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ n)"},{"kind":"text","text":" the following condition fulfills: "},{"kind":"math_inline","text":"bii"},{"kind":"text","text":" = -1. It is guaranteed that for all "},{"kind":"math_inline","text":"i, j"},{"kind":"math_inline","text":"(1 ≤ i, j ≤ n; i ≠ j)"},{"kind":"text","text":" the following condition fulfills: "},{"kind":"math_inline","text":"0 ≤ bij ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bij = bji"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" non-negative integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(0 ≤ ai ≤ 109)"},{"kind":"text","text":" — the sequence that Polycarpus wiped off the board. Separate the numbers by whitespaces. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there is sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" that satisfies the problem conditions. If there are multiple such sequences, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n-1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n-1 18 0\n18 -1 0\n0 0 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"18 18 0 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n-1 128 128 128\n128 -1 148 160\n128 148 -1 128\n128 160 128 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"128 180 148 160 "}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"If you do not know what is the \"bitwise AND\" operation please read: "},{"children":[{"kind":"text","text":"http://en.wikipedia.org/wiki/Bitwise_operation"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"245D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/245/problem/D"}