{"assets":[],"contentKind":"statement","contestId":"1762","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Good Pairs "}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array $$$a$$$ consisting of $$$n$$$ integers and an integer $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A pair $$$(l,r)$$$ is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if there exists a sequence of indices $$$i_1, i_2, \\dots, i_m$$$ such that "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$i_1=l$$$ and $$$i_m=r$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$i_j \\lt i_{j+1}$$$ for all $$$1 \\leq j \\lt m$$$; and "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$|a_{i_j}-a_{i_{j+1}}| \\leq k$$$ for all $$$1 \\leq j \\lt m$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Find the number of pairs $$$(l,r)$$$ ($$$1 \\leq l \\leq r \\leq n$$$) that are "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 10^5$$$) — the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two space-separated integers $$$n$$$ and $$$k$$$ ($$$1 \\leq n \\leq 5 \\cdot 10^5$$$; $$$0 \\leq k \\leq 10^5$$$) — the length of the array $$$a$$$ and the integer $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ space-separated integers $$$a_1,a_2,\\ldots,a_n$$$ ($$$1 \\leq a_i \\leq 10^5$$$) — representing the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$5 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the number of "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" pairs."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n3 0\n1 1 1\n4 2\n4 8 6 8\n6 4\n7 2 5 8 3 8\n20 23\n110 57 98 14 20 1 60 82 108 37 82 73 8 46 38 35 106 115 58 112\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n9\n18\n92\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" pairs are $$$(1,1)$$$, $$$(1,2)$$$, $$$(1,3)$$$, $$$(2,2)$$$, $$$(2,3)$$$, and $$$(3,3)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" pairs are $$$(1,1)$$$, $$$(1,3)$$$, $$$(1,4)$$$, $$$(2,2)$$$, $$$(2,3)$$$, $$$(2,4)$$$, $$$(3,3)$$$, $$$(3,4)$$$ and $$$(4,4)$$$. Pair $$$(1,4)$$$ is "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" because there exists a sequence of indices $$$1, 3, 4$$$ which satisfy the given conditions."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1762F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1762/problem/F"}