"children":[{"attrs":{"alt":"","src":"/statement-assets/05c8702da08e2aa5c2b37bccfb343a21b4744748911c4d49505e183f986bb2eb.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Find the number of ways to color some borders of the figure's inner squares so that no square had all four borders colored. The borders of the squares lying on the border of the figure should be considered painted. The ways that differ with the figure's rotation should be considered distinct. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line of the input contains 7 numbers "},{"kind":"math_inline","text":"w1, w2, ..., w7"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ wi ≤ 105"},{"kind":"text","text":"). It is guaranteed that at least one of the "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":"'s isn't equal to zero."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the single line of the output display a single number — the answer to the problem modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 1 0 0 0 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind"