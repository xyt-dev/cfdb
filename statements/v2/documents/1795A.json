{"assets":["/statement-assets/9c7aee8e4436c2da413b0264113e56dcef71a8ebd450378c8488d6b629f1a88e.png","/statement-assets/8ea2587329342d5dbeb84c400a0dc20f94f93cbfaa098152de9a7836829f3c0e.png","/statement-assets/b396e5b6d74698d5b7ee8bee7cfbceefb01f93946e1fbb1e196daa054b5d9d0e.png"],"contentKind":"statement","contestId":"1795","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Two Towers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are two towers consisting of blocks of two colors: red and blue. Both towers are represented by strings of characters "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":" denoting the order of blocks in them "},{"children":[{"kind":"text","text":"from the bottom to the top"}],"kind":"container"},{"kind":"text","text":", where "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" corresponds to a blue block, and "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":" corresponds to a red block."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9c7aee8e4436c2da413b0264113e56dcef71a8ebd450378c8488d6b629f1a88e.png"},"kind":"image"},{"children":[{"kind":"text","text":"These two towers are represented by strings "},{"children":[{"kind":"text","text":"BRBB"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"RBR"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"You can perform the following operation any number of times: choose a tower with "},{"children":[{"kind":"text","text":"at least two blocks"}],"kind":"container"},{"kind":"text","text":", and move its "},{"children":[{"kind":"text","text":"top"}],"kind":"container"},{"kind":"text","text":" block to the "},{"children":[{"kind":"text","text":"top"}],"kind":"container"},{"kind":"text","text":" of the other tower."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/8ea2587329342d5dbeb84c400a0dc20f94f93cbfaa098152de9a7836829f3c0e.png"},"kind":"image"},{"attrs":{"alt":"","src":"/statement-assets/b396e5b6d74698d5b7ee8bee7cfbceefb01f93946e1fbb1e196daa054b5d9d0e.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The pair of towers is "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if no pair of touching blocks has the same color; i. e. no red block stands on top of another red block, and no blue block stands on top of another blue block."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to check if it is possible to perform any number of operations (possibly zero) to make the pair of towers beautiful."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of three lines:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the first line contains two integers $$$n$$$ and $$$m$$$ ($$$1 \\le n, m \\le 20$$$) — the number of blocks in the first tower and the number of blocks in the second tower, respectively; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the second line contains $$$s$$$ — a string of exactly $$$n$$$ characters "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":", denoting the first tower; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the third line contains $$$t$$$ — a string of exactly $$$m$$$ characters "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":", denoting the second tower. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" if it is possible to perform several (possibly zero) operations in such a way that the pair of towers becomes beautiful; otherwise print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may print each letter in any case ("},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" will all be recognized as positive answer, "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"no"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"nO"}],"kind":"container"},{"kind":"text","text":" will all be recognized as negative answer)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n4 3\nBRBB\nRBR\n4 7\nBRBR\nRRBRBRB\n3 4\nRBR\nBRBR\n5 4\nBRBRR\nBRBR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nYES\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, you can move the top block from the first tower to the second tower (see the third picture)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, you can move the top block from the second tower to the first tower $$$6$$$ times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, the pair of towers is already beautiful."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1795A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1795/problem/A"}