{"assets":["/statement-assets/004424c71b1bb6516f3521276be71d7dfeff5ed31a0113764426d25b6c430793.png"],"contentKind":"statement","contestId":"659","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Round House"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya lives in a round building, whose entrances are numbered sequentially by integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Entrance "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and entrance "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" are adjacent."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Today Vasya got bored and decided to take a walk in the yard. Vasya lives in entrance "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and he decided that during his walk he will move around the house "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" entrances in the direction of increasing numbers (in this order entrance "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" should be followed by entrance "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"). The negative value of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" corresponds to moving "},{"kind":"math_inline","text":"|b|"},{"kind":"text","text":" entrances in the order of decreasing numbers (in this order entrance "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is followed by entrance "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"). If "},{"kind":"math_inline","text":"b = 0"},{"kind":"text","text":", then Vasya prefers to walk beside his entrance."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/004424c71b1bb6516f3521276be71d7dfeff5ed31a0113764426d25b6c430793.png"},"kind":"image"},{"children":[{"kind":"text","text":"Illustration for "},{"kind":"math_inline","text":"n = 6"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b =  - 5"},{"kind":"text","text":"."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Help Vasya to determine the number of the entrance, near which he will be at the end of his walk."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line of the input contains three space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100, 1 ≤ a ≤ n,  - 100 ≤ b ≤ 100"},{"kind":"text","text":") — the number of entrances at Vasya's place, the number of his entrance and the length of his walk, respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":") — the number of the entrance where Vasya will be at the end of his walk."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2 -5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first example is illustrated by the picture in the statements."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"659A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/659/problem/A"}