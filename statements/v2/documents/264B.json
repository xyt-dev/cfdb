{"assets":[],"contentKind":"statement","contestId":"264","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Good Sequences"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Squirrel Liss is interested in sequences. She also has preferences of integers. She thinks "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" are "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now she is interested in good sequences. A sequence "},{"kind":"math_inline","text":"x1, x2, ..., xk"},{"kind":"text","text":" is called "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if it satisfies the following three conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The sequence is strictly increasing, i.e. "},{"kind":"math_inline","text":"xi < xi + 1"},{"kind":"text","text":" for each "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ k - 1)"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" No two adjacent elements are coprime, i.e. "},{"kind":"math_inline","text":"gcd(xi, xi + 1) > 1"},{"kind":"text","text":" for each "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ k - 1)"},{"kind":"text","text":" (where "},{"kind":"math_inline","text":"gcd(p, q)"},{"kind":"text","text":" denotes the greatest common divisor of the integers "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":"). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" All elements of the sequence are good integers. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Find the length of the longest good sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of two lines. The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of good integers. The second line contains a single-space separated list of good integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" in strictly increasing order ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 105; ai < ai + 1"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the length of the longest good sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2 3 4 6 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n1 2 3 5 6 7 8 9 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the following sequences are examples of good sequences: [2; 4; 6; 9], [2; 4; 6], [3; 9], [6]. The length of the longest good sequence is 4."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"264B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/264/problem/B"}