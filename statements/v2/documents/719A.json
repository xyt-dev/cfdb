{"assets":[],"contentKind":"statement","contestId":"719","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Vitya in the Countryside"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Every summer Vitya comes to visit his grandmother in the countryside. This summer, he got a huge wart. Every grandma knows that one should treat warts when the moon goes down. Thus, Vitya has to catch the moment when the moon is down."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Moon cycle lasts 30 days. The size of the visible part of the moon (in Vitya's units) for each day is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"6"},{"kind":"text","text":", "},{"kind":"math_inline","text":"7"},{"kind":"text","text":", "},{"kind":"math_inline","text":"8"},{"kind":"text","text":", "},{"kind":"math_inline","text":"9"},{"kind":"text","text":", "},{"kind":"math_inline","text":"10"},{"kind":"text","text":", "},{"kind":"math_inline","text":"11"},{"kind":"text","text":", "},{"kind":"math_inline","text":"12"},{"kind":"text","text":", "},{"kind":"math_inline","text":"13"},{"kind":"text","text":", "},{"kind":"math_inline","text":"14"},{"kind":"text","text":", "},{"kind":"math_inline","text":"15"},{"kind":"text","text":", "},{"kind":"math_inline","text":"14"},{"kind":"text","text":", "},{"kind":"math_inline","text":"13"},{"kind":"text","text":", "},{"kind":"math_inline","text":"12"},{"kind":"text","text":", "},{"kind":"math_inline","text":"11"},{"kind":"text","text":", "},{"kind":"math_inline","text":"10"},{"kind":"text","text":", "},{"kind":"math_inline","text":"9"},{"kind":"text","text":", "},{"kind":"math_inline","text":"8"},{"kind":"text","text":", "},{"kind":"math_inline","text":"7"},{"kind":"text","text":", "},{"kind":"math_inline","text":"6"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", and then cycle repeats, thus after the second "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" again goes "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As there is no internet in the countryside, Vitya has been watching the moon for "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" consecutive days and for each of these days he wrote down the size of the visible part of the moon. Help him find out whether the moon will be up or down next day, or this cannot be determined by the data he has."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 92"},{"kind":"text","text":") — the number of consecutive days Vitya was watching the size of the visible part of the moon. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 15"},{"kind":"text","text":") — Vitya's records."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the input data is consistent."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If Vitya can be sure that the size of visible part of the moon on day "},{"kind":"math_inline","text":"n + 1"},{"kind":"text","text":" will be less than the size of the visible part on day "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", then print \""},{"children":[{"kind":"text","text":"DOWN"}],"kind":"container"},{"kind":"text","text":"\" at the only line of the output. If he might be sure that the size of the visible part will increase, then print \""},{"children":[{"kind":"text","text":"UP"}],"kind":"container"},{"kind":"text","text":"\". If it's impossible to determine what exactly will happen with the moon, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n3 4 5 6 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"UP\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n12 13 14 15 14 13 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"DOWN\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the size of the moon on the next day will be equal to "},{"kind":"math_inline","text":"8"},{"kind":"text","text":", thus the answer is \""},{"children":[{"kind":"text","text":"UP"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the size of the moon on the next day will be "},{"kind":"math_inline","text":"11"},{"kind":"text","text":", thus the answer is \""},{"children":[{"kind":"text","text":"DOWN"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, there is no way to determine whether the size of the moon on the next day will be "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"9"},{"kind":"text","text":", thus the answer is "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"719A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/719/problem/A"}