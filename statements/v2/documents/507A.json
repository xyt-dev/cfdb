{"assets":[],"contentKind":"statement","contestId":"507","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Amr and Music"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Amr is a young coder who likes music a lot. He always wanted to learn how to play music but he was busy coding so he got an idea."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Amr has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" instruments, it takes "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" days to learn "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th instrument. Being busy, Amr dedicated "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" days to learn how to play the maximum possible number of instruments."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Amr asked for your help to distribute his free days between instruments so that he can achieve his goal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ 10 000"},{"kind":"text","text":"), the number of instruments and