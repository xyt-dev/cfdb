{"assets":[],"contentKind":"statement","contestId":"1375","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Inversion SwapSort"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Madeline has an array $$$a$$$ of $$$n$$$ integers. A pair $$$(u, v)$$$ of integers forms an inversion in $$$a$$$ if:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1 \\le u \\lt v \\le n$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_u \\gt a_v$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Madeline recently found a magical paper, which allows her to write two indices $$$u$$$ and $$$v$$$ and swap the values $$$a_u$$$ and $$$a_v$$$. Being bored, she decided to write a list of pairs $$$(u_i, v_i)$$$ with the following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" all the pairs in the list are distinct and form an inversion in $$$a$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" all the pairs that form an inversion in $$$a$$$ are in the list. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Starting from the given array, if you swap the values at indices $$$u_1$$$ and $$$v_1$$$, then the values at indices $$$u_2$$$ and $$$v_2$$$ and so on, then after all pairs are processed, the array $$$a$$$ will be sorted in "},{"children":[{"kind":"text","text":"non-decreasing order"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Construct such a list or determine that no such list exists. If there are multiple possible answers, you may find any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer $$$n$$$ ($$$1 \\le n \\le 1000$$$) — the length of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains $$$n$$$ integers $$$a_1,a_2,...,a_n$$$ $$$(1 \\le a_i \\le 10^9)$$$  — elements of the array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" if no such list exists. Otherwise in the first line you should print a single integer $$$m$$$ ($$$0 \\le m \\le \\dfrac{n(n-1)}{2}$$$) — number of pairs in the list."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the following $$$m$$$ lines should contain two integers $$$u_i, v_i$$$ ($$$1 \\le u_i \\lt v_i\\le n$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple possible answers, you may find any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n3 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n1 3\n1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 8 1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n2 4\n2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 1 1 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test case the array will change in this order $$$[3,1,2] \\rightarrow [2,1,3] \\rightarrow [1,2,3]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test case it will be $$$[1,8,1,6] \\rightarrow [1,6,1,8] \\rightarrow [1,1,6,8]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample test case the array is already sorted."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1375E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1375/problem/E"}