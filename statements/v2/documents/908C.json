{"assets":["/statement-assets/af572790d886b5de9e6a69678560f5b9ffb802b8d91d49716b2f7199c5afce2c.png","/statement-assets/4f68ad831f754fb0ebc7071f96663fd0af3c53ba5726c555fcd52e55c34401a7.png"],"contentKind":"statement","contestId":"908","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. New Year and Curling"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Carol is currently curling."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"She has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" disks each with radius "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" on the 2D plane. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially she has all these disks above the line "},{"kind":"math_inline","text":"y = 10100"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"She then will slide the disks towards the line "},{"kind":"math_inline","text":"y = 0"},{"kind":"text","text":" one by one in order from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When she slides the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th disk, she will place its center at the point "},{"kind":"math_inline","text":"(xi, 10100)"},{"kind":"text","text":". She will then push it so the disk’s "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" coordinate continuously decreases, and "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" coordinate stays constant. The disk stops once it touches the line "},{"kind":"math_inline","text":"y = 0"},{"kind":"text","text":" or it touches any previous disk. Note that once a disk stops moving, it will not move again, even if hit by another disk. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Compute the "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"-coordinates of centers of all the disks after all disks have been pushed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line will contain two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, r ≤ 1 000"},{"kind":"text","text":"), the number of disks, and the radius of the disks, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line will contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ 1 000"},{"kind":"text","text":") — the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-coordinates of the disks."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single line with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number denotes the "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"-coordinate of the center of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th disk. The output will be accepted if it has absolute or relative error at most "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Namely, let's assume that your answer for a particular value of a coordinate is "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and the answer of the jury is "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The checker program will consider your answer correct if "},{"attrs":{"alt":"","src":"/statement-assets/af572790d886b5de9e6a69678560f5b9ffb802b8d91d49716b2f7199c5afce2c.png"},"kind":"image"},{"kind":"text","text":" for all coordinates."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2\n5 5 6 8 3 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 6.0 9.87298334621 13.3370849613 12.5187346573 13.3370849613\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The final positions of the disks will look as follows:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/4f68ad831f754fb0ebc7071f96663fd0af3c53ba5726c555fcd52e55c34401a7.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In particular, note the position of the last disk. "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"908C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/908/problem/C"}