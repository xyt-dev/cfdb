{"assets":[],"contentKind":"statement","contestId":"466","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Increase Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Peter has a sequence of integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". Peter wants all numbers in the sequence to equal "},{"kind":"math_inline","text":"h"},{"kind":"text","text":". He can perform the operation of \"adding one on the segment "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":"\": add one to all elements of the sequence with indices from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" (inclusive). At that, Peter never chooses any element as the beginning of the segment twice. Similarly, Peter never chooses any element as the end of the segment twice. In other words, for any two segments "},{"kind":"math_inline","text":"[l1, r1]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"[l2, r2]"},{"kind":"text","text":", where Peter added one, the following inequalities hold: "},{"kind":"math_inline","text":"l1 ≠ l2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r1 ≠ r2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How many distinct ways are there to make all numbers in the sequence equal "},{"kind":"math_inline","text":"h"},{"kind":"text","text":"? Print this number of ways modulo "},{"kind":"math_inline","text":"1000000007 (109 + 7)"},{"kind":"text","text":". Two ways are considered distinct if one of them has a segment that isn't in the other way."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n, h"},{"kind":"math_inline","text":"(1 ≤ n, h ≤ 2000)"},{"kind":"text","text":". The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(0 ≤ ai ≤ 2000)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the answer to the problem modulo "},{"kind":"math_inline","text":"1000000007 (109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1\n1 1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n3 2 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"466D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/466/problem/D"}