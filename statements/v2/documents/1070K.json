{"assets":[],"contentKind":"statement","contestId":"1070","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"K. Video Posts"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp took $$$n$$$ videos, the duration of the $$$i$$$-th video is $$$a_i$$$ seconds. The videos are listed in the chronological order, i.e. the $$$1$$$-st video is the earliest, the $$$2$$$-nd video is the next, ..., the $$$n$$$-th video is the last."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Polycarp wants to publish exactly $$$k$$$ ($$$1 \\le k \\le n$$$) posts in Instabram. Each video should be a part of a single post. The posts should preserve the chronological order, it means that the first post should contain one or more of the earliest videos, the second post should contain a block (one or more videos) going next and so on. In other words, if the number of videos in the $$$j$$$-th post is $$$s_j$$$ then:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$s_1+s_2+\\dots+s_k=n$$$ ($$$s_i \\gt 0$$$), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the first post contains the videos: $$$1, 2, \\dots, s_1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the second post contains the videos: $$$s_1+1, s_1+2, \\dots, s_1+s_2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the third post contains the videos: $$$s_1+s_2+1, s_1+s_2+2, \\dots, s_1+s_2+s_3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" ... "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the $$$k$$$-th post contains videos: $$$n-s_k+1,n-s_k+2,\\dots,n$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Polycarp is a perfectionist, he wants the total duration of videos in each post to be the same."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Polycarp to find such positive integer values $$$s_1, s_2, \\dots, s_k$$$ that satisfy all the conditions above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\le k \\le n \\le 10^5$$$). The next line contains $$$n$$$ positive integer numbers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^4$$$), where $$$a_i$$$ is the duration of the $$$i$$$-th video."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If solution exists, print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" in the first line. Print $$$k$$$ positive integers $$$s_1, s_2, \\dots, s_k$$$ ($$$s_1+s_2+\\dots+s_k=n$$$) in the second line. The total duration of videos in each post should be the same. It can be easily proven that the answer is unique (if it exists)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is no solution, print a single line \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3\n3 3 1 4 1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n2 3 1 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n1 1 1 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n1 10 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n3 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"K","problemCode":"1070K","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1070/problem/K"}