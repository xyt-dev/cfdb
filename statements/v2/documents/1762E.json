{"assets":[],"contentKind":"statement","contestId":"1762","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Tree Sum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let us call an edge-weighted tree with $$$n$$$ vertices numbered from $$$1$$$ to $$$n$$$ "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if the weight of each edge is either $$$1$$$ or $$$-1$$$ and for each vertex $$$i$$$, the product of the edge weights of all edges having $$$i$$$ as one endpoint is $$$-1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a positive integer $$$n$$$. There are $$$n^{n-2} \\cdot 2^{n-1}$$$ distinct$$$^\\dagger$$$ edge-weighted trees with $$$n$$$ vertices numbered from $$$1$$$ to $$$n$$$ such that each edge is either $$$1$$$ or $$$-1$$$. Your task is to find the sum of $$$d(1,n)^\\ddagger$$$ of all such trees that are good. Since the answer can be quite large, you only need to find it modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$^\\dagger$$$ Two trees are considered to be distinct if either: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" there exists two vertices such that there is an edge between them in one of the trees, and not in the other. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" there exists two vertices such that there is an edge between them in both trees but the weight of the edge between them in one tree is different from the one in the other tree. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that by "},{"attrs":{"href":"https://rb.gy/hho7vu"},"children":[{"kind":"text","text":"Cayley's formula"}],"kind":"link"},{"kind":"text","text":", the number of trees on $$$n$$$ labeled vertices is $$$n^{n-2}$$$. Since we have $$$n-1$$$ edges, there are $$$2^{n-1}$$$ possible assignment of weights(weight can either be $$$1$$$ or $$$-1$$$). That is why total number of distinct edge-weighted tree is $$$n^{n-2} \\cdot 2^{n-1}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$^\\ddagger$$$ $$$d(u,v)$$$ denotes the sum of the weight of all edges on the unique simple path from $$$u$$$ to $$$v$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and only line of input contains a single integer $$$n$$$ ($$$1 \\leq n \\leq 5 \\cdot 10^5$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of output should contain a single integer, the required answer, modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n998244352\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n998244343\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n948359297\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n43434\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n86232114\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, there is only $$$1$$$ distinct "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" tree. The value of $$$d(1,2)$$$ for that tree is $$$-1$$$, which is $$$998\\,244\\,352$$$ under modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the value of $$$d(1,1)$$$ for any tree is $$$0$$$, so the answer is $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, there are $$$16$$$ distinct "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" trees. The value of $$$d(1,4)$$$ is: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$-2$$$ for $$$2$$$ trees; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$-1$$$ for $$$8$$$ trees; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$0$$$ for $$$4$$$ trees; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$1$$$ for $$$2$$$ trees. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The sum of $$$d(1,4)$$$ over all trees is $$$2 \\cdot (-2) + 8 \\cdot (-1) + 4 \\cdot (0) + 2 \\cdot (1) = -10$$$, which is $$$998\\,244\\,343$$$ under modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1762E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1762/problem/E"}