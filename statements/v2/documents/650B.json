{"assets":[],"contentKind":"statement","contestId":"650","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Image Preview"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya's telephone contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" photos. Photo number 1 is currently opened on the phone. It is allowed to move left and right to the adjacent photo by swiping finger over the screen. If you swipe left from the first photo, you reach photo "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Similarly, by swiping right from the last photo you reach photo "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". It takes "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" seconds to swipe from photo to adjacent."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each photo it is known which orientation is intended for it — horizontal or vertical. Phone is in the vertical orientation and "},{"children":[{"kind":"text","text":"can't"}],"kind":"container"},{"kind":"text","text":" be rotated. It takes "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" second to change orientation of the photo."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya has "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" seconds to watch photos. He want to watch as many photos as possible. If Vasya opens the photo for the first time, he spends "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" second to notice all details in it. If photo is in the wrong orientation, he spends "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" seconds on rotating it before watching it. If Vasya has already opened the photo, he just skips it (so he doesn't spend any time for watching it or for changing its orientation). It is not allowed to skip unseen photos."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Vasya find the maximum number of photos he is able to watch during "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" seconds."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains 4 integers "},{"kind":"math_inline","text":"n, a, b, T"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ a, b ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ T ≤ 109"},{"kind":"text","text":") — the number of photos, time to move from a photo to adjacent, time to change orientation of a photo and time Vasya can spend for watching photo."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second line of the input contains a string of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" containing symbols '"},{"children":[{"kind":"text","text":"w"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"h"}],"kind":"container"},{"kind":"text","text":"'. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th position of a string contains '"},{"children":[{"kind":"text","text":"w"}],"kind":"container"},{"kind":"text","text":"', then the photo "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" should be seen in the "},{"children":[{"kind":"text","text":"horizontal"}],"kind":"container"},{"kind":"text","text":" orientation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th position of a string contains '"},{"children":[{"kind":"text","text":"h"}],"kind":"container"},{"kind":"text","text":"', then the photo "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" should be seen in "},{"children":[{"kind":"text","text":"vertical"}],"kind":"container"},{"kind":"text","text":" orientation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the only integer, the maximum number of photos Vasya is able to watch during those "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" seconds."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 3 10\nwwhw\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 4 13\nhhwhh\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"r