{"assets":[],"contentKind":"statement","contestId":"906","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Reverses"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Hurricane came to Berland and to suburbs Stringsvill. You are going to it to check if it's all right with you favorite string. Hurrinace broke it a bit by reversing some of its non-intersecting substrings. You have a photo of this string before hurricane and you want to restore it to original state using reversing minimum possible number of its substrings and find out which substrings you should reverse."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" — original state of your string and string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — state of the string after hurricane. You should select "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" non-intersecting substrings of "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in such a way that after reverse of these substrings string will be equal "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is minimum possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of input contains string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and second line contains string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Both strings have same length and consist of lowercase English letters. "},{"kind":"math_inline","text":"1 ≤ |s| = |t| ≤ 5·105"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In first line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — minimum number of substrings you should reverse. Next output "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines. Each line should contain two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" meaning that you should reverse substring from symbol number "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to symbol "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" (strings are 1-indexed). These substrings shouldn't intersect. If there are multiple answers print any. If it's impossible to restore string output "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"abcxxxdef\ncbaxxxfed\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n7 9\n1 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":