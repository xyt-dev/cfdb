{"assets":[],"contentKind":"statement","contestId":"676","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Theseus and labyrinth"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Theseus has just arrived to Crete to fight Minotaur. He found a labyrinth that has a form of a rectangular field of size "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" and consists of blocks of size "},{"kind":"math_inline","text":"1 × 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Each"}],"kind":"container"},{"kind":"text","text":" block of the labyrinth has a button that rotates "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" blocks "},{"kind":"math_inline","text":"90"},{"kind":"text","text":" degrees clockwise. Each block rotates around its center and doesn't change its position in the labyrinth. Also, each block has some number of doors (possibly none). In one minute, Theseus can either push the button in order to rotate all the blocks "},{"kind":"math_inline","text":"90"},{"kind":"text","text":" degrees clockwise or pass to the neighbouring block. Theseus can go from block "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" to some neighbouring block "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" only if block "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" has a door that leads to block "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" and block "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" has a door that leads to block "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Theseus found an entrance to labyrinth and is now located in block "},{"kind":"math_inline","text":"(xT, yT)"},{"kind":"text","text":" — the block in the row "},{"kind":"math_inline","text":"xT"},{"kind":"text","text":" and column "},{"kind":"math_inline","text":"yT"},{"kind":"text","text":". Theseus know that the Minotaur is hiding in block "},{"kind":"math_inline","text":"(xM, yM)"},{"kind":"text","text":" and wants to know the minimum number of minutes required to get there."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Theseus is a hero, not a programmer, so he asks you to help him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 1000"},{"kind":"text","text":") — the number of rows and the number of columns in labyrinth, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters, describing the blocks of the labyrinth. The possible characters are:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" «"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"» means this block has "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" doors (one door to each neighbouring block); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" «"},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"» means this block has "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" doors — to the left and to the right neighbours; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" «"},{"children":[{"kind":"text","text":"|"}],"kind":"container"},{"kind":"text","text":"» means this block has "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" doors — to the top and to the bottom neighbours; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" «"},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":"» means this block has "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" door — to the top neighbour; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" «"},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":"» means this block has "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" door — to the right neighbour; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" «"},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":"» means this block has "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" door — to the left neighbour; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" «"},{"children":[{"kind":"text","text":"v"}],"kind":"container"},{"kind":"text","text":"» means this block has "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" door — to the bottom neighbour;"}],"kind":"list_item"},{"children":[{"kind":"text","text":" «"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"» means this block has "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" doors — to all neighbours except left one; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" «"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"» means this block has "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" doors — to all neighbours except right one; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" «"},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":"» means this block has "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" doors — to all neighbours except top one; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" «"},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"» means this block has "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" doors — to all neighbours except bottom one;"}],"kind":"list_item"},{"children":[{"kind":"text","text":" «"},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"» means this block is a wall and has no doors. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Left, right, top and bottom are defined from representing labyrinth as a table, where rows are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from top to bottom and columns are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" from left to right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains two integers — coordinates of the block "},{"kind":"math_inline","text":"(xT, yT)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xT ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ yT ≤ m"},{"kind":"text","text":"), where Theseus is initially located."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Last line contains two integers — coordinates of the block "},{"kind":"math_inline","text":"(xM, yM)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xM ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ yM ≤ m"},{"kind":"text","text":"), where Minotaur hides."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that both the block where Theseus starts and the block where Minotaur is hiding have at least one door. Theseus and Minotaur may be initially located at the same block."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If Theseus is not able to get to Minotaur, then print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" in the only line of the output. Otherwise, print the minimum number of minutes required to get to the block where Minotaur is hiding."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n+*\n*U\n1 1\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n<><\n><>\n1 1\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Assume that Theseus starts at the block "},{"kind":"math_inline","text":"(xT, yT)"},{"kind":"text","text":" at the moment "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"676D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/676/problem/D"}