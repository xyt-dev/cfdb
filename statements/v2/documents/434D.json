{"assets":[],"contentKind":"statement","contestId":"434","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Nanami's Power Plant"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Nanami likes playing games, and is also really good at it. This day she was playing a new game which involved operating a power plant. Nanami's job is to control the generators in the plant and produce maximum output."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" generators in the plant. Each generator should be set to a generating level. Generating level is an integer (possibly zero or negative), the generating level of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th generator should be between "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" (both inclusive). The output of a generator can be calculated using a certain quadratic function "},{"kind":"math_inline","text":"f(x)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is the generating level of the generator. Each generator has its own function, the function of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th generator is denoted as "},{"kind":"math_inline","text":"fi(x)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, there are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" further restrictions to the generators. Let the generating level of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th generator be "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". Each restriction is of the form "},{"kind":"math_inline","text":"xu ≤ xv + d"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" are IDs of two different generators and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" is an integer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nanami found the game tedious but giving up is against her creed. So she decided to have a program written to calculate the answer for her (the maximum total output of generators). Somehow, this became your job."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m (1 ≤ n ≤ 50; 0 ≤ m ≤ 100)"},{"kind":"text","text":" — the number of generators and the number of restrictions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each line contains three integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"ci (|ai| ≤ 10; |bi|, |ci| ≤ 1000)"},{"kind":"text","text":" — the coefficients of the function "},{"kind":"math_inline","text":"fi(x)"},{"kind":"text","text":". That is, "},{"kind":"math_inline","text":"fi(x) = aix2 + bix + ci"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow another "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each line contains two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri ( - 100 ≤ li ≤ ri ≤ 100)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines, each line contains three integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"di (1 ≤ ui, vi ≤ n; ui ≠ vi; |di| ≤ 200)"},{"kind":"text","text":", describing a restriction. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th restriction is "},{"kind":"math_inline","text":"xui ≤ xvi + di"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single line containing a single integer — the maximum output of all the generators. It is guaranteed that there exists at least one valid configuration."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n0 1 0\n0 1 1\n0 1 2\n0 3\n1 2\n-100 100\n1 2 0\n2 3 0\n3 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 8\n1 -8 20\n2 -4 0\n-1 10 -10\n0 1 0\n0 -1 1\n1 9\n1 4\n0 10\n3 11\n7 9\n2 1 3\n1 2 3\n2 3 3\n3 2 3\n3 4 3\n4 3 3\n4 5 3\n5 4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"46\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, "},{"kind":"math_inline","text":"f1(x) = x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f2(x) = x + 1"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"f3(x) = x + 2"},{"kind":"text","text":", so we are to maximize the sum of the generating levels. The restrictions are "},{"kind":"math_inline","text":"x1 ≤ x2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2 ≤ x3"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"x3 ≤ x1"},{"kind":"text","text":", which gives us "},{"kind":"math_inline","text":"x1 = x2 = x3"},{"kind":"text","text":". The optimal configuration is "},{"kind":"math_inline","text":"x1 = x2 = x3 = 2"},{"kind":"text","text":", which produces an output of 9."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, restrictions are equal to "},{"kind":"math_inline","text":"|xi - xi + 1| ≤ 3"},{"kind":"text","text":" for "},{"kind":"math_inline","text":"1 ≤ i < n"},{"kind":"text","text":". One of the optimal configurations is "},{"kind":"math_inline","text":"x1 = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2 = 4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x3 = 5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x4 = 8"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x5 = 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"434D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/434/problem/D"}