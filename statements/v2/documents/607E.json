{"assets":["/statement-assets/947f0e2ccc1cca2b7c2a50fe6e9ec50df45bba44975eb4c80847eccfdf72009a.png","/statement-assets/a36ba95183c44dfd6c55b2e7a25aaa027a60060fda6b2b6af1f46bd9fa63ddc5.png","/statement-assets/3b0a32727bfe05e54e154be2521d2606eb2f781be43449e78c068292a22efcf5.png","/statement-assets/52d7a5fbb452073aa77c09664fd48027172fbf036db5deae1123e77a95f0d8b0.png","/statement-assets/add175249654acb1c274a5ac947aa827de72e4bf74f20919c3f23d46ded34720.png","/statement-assets/df50b7122fd6e2c87291469fbd1ba9343a0d86af1a442c3de0b5afe9430af6b4.png","/statement-assets/8d8acee3be5ef43b45dffb278d0dc274f2ac9898859730645120b77c59e8fa3c.png","/statement-assets/43f1126b0d4e4b00f7c46370fb42d4d253c0431b1b8419a58bdc45dc282950f4.png","/statement-assets/7400ce840a2dd7f70d5f7169f546af9aec8b1b7c0c18043b50670a606baf03d2.png","/statement-assets/a6aef5b0b33b10e801854264e416e94e58b82e0d3b38285c5463ddf679a5e2cb.png","/statement-assets/425dd3a5bd5875fc04c1be71dc1381b532fe8648940dcf8aa8403b143f83d873.png","/statement-assets/193af364a817a9020d2c4c94dd718d2f40c2049872578340072ed5d4c9293a3d.png","/statement-assets/ed77a2c99c5b99c6f28062a2dabd4e62308909b73f17537aa7a55c5bd29765e4.png"],"contentKind":"statement","contestId":"607","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Cross Sum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"7 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Genos has been given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct lines on the Cartesian plane. Let "},{"attrs":{"alt":"","src":"/statement-assets/947f0e2ccc1cca2b7c2a50fe6e9ec50df45bba44975eb4c80847eccfdf72009a.png"},"kind":"image"},{"kind":"text","text":" be a list of intersection points of these lines. A single point might appear multiple times in this list if it is the intersection of multiple pairs of lines. The order of the list does not matter."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given a query point "},{"kind":"math_inline","text":"(p, q)"},{"kind":"text","text":", let "},{"attrs":{"alt":"","src":"/statement-assets/a36ba95183c44dfd6c55b2e7a25aaa027a60060fda6b2b6af1f46bd9fa63ddc5.png"},"kind":"image"},{"kind":"text","text":" be the corresponding list of distances of all points in "},{"attrs":{"alt":"","src":"/statement-assets/947f0e2ccc1cca2b7c2a50fe6e9ec50df45bba44975eb4c80847eccfdf72009a.png"},"kind":"image"},{"kind":"text","text":" to the query point. Distance here refers to euclidean distance. As a refresher, the euclidean distance between two points "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":" is "},{"attrs":{"alt":"","src":"/statement-assets/3b0a32727bfe05e54e154be2521d2606eb2f781be43449e78c068292a22efcf5.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Genos is given a point "},{"kind":"math_inline","text":"(p, q)"},{"kind":"text","text":" and a positive integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". He is asked to find the sum of the "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" smallest elements in "},{"attrs":{"alt":"","src":"/statement-assets/a36ba95183c44dfd6c55b2e7a25aaa027a60060fda6b2b6af1f46bd9fa63ddc5.png"},"kind":"image"},{"kind":"text","text":". Duplicate elements in "},{"attrs":{"alt":"","src":"/statement-assets/a36ba95183c44dfd6c55b2e7a25aaa027a60060fda6b2b6af1f46bd9fa63ddc5.png"},"kind":"image"},{"kind":"text","text":" are treated as separate elements. Genos is intimidated by Div1 E problems so he asked for your help."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 50 000"},{"kind":"text","text":") — the number of lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains three integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|x|, |y| ≤ 1 000 000"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/52d7a5fbb452073aa77c09664fd48027172fbf036db5deae1123e77a95f0d8b0.png"},"kind":"image"},{"kind":"text","text":") — the encoded coordinates of the query point and the integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" from the statement above. The query point "},{"kind":"math_inline","text":"(p, q)"},{"kind":"text","text":" is obtained as "},{"attrs":{"alt":"","src":"/statement-assets/add175249654acb1c274a5ac947aa827de72e4bf74f20919c3f23d46ded34720.png"},"kind":"image"},{"kind":"text","text":". In other words, divide "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":" to get the actual query point. "},{"attrs":{"alt":"","src":"/statement-assets/df50b7122fd6e2c87291469fbd1ba9343a0d86af1a442c3de0b5afe9430af6b4.png"},"kind":"image"},{"kind":"text","text":" denotes the length of the list "},{"attrs":{"alt":"","src":"/statement-assets/a36ba95183c44dfd6c55b2e7a25aaa027a60060fda6b2b6af1f46bd9fa63ddc5.png"},"kind":"image"},{"kind":"text","text":" and it is guaranteed that "},{"attrs":{"alt":"","src":"/statement-assets/8d8acee3be5ef43b45dffb278d0dc274f2ac9898859730645120b77c59e8fa3c.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|ai|, |bi| ≤ 1 000 000"},{"kind":"text","text":") — the parameters for a line of the form: "},{"attrs":{"alt":"","src":"/statement-assets/43f1126b0d4e4b00f7c46370fb42d4d253c0431b1b8419a58bdc45dc282950f4.png"},"kind":"image"},{"kind":"text","text":". It is guaranteed that no two lines are the same, that is "},{"kind":"math_inline","text":"(ai, bi) ≠ (aj, bj)"},{"kind":"text","text":" if "},{"kind":"math_inline","text":"i ≠ j"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single real number, the sum of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" smallest elements of "},{"attrs":{"alt":"","src":"/statement-assets/a36ba95183c44dfd6c55b2e7a25aaa027a60060fda6b2b6af1f46bd9fa63ddc5.png"},"kind":"image"},{"kind":"text","text":". Your answer will be considered correct if its absolute or relative error does not exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To clarify, let's assume that your answer is "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and the answer of the jury is "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The checker program will consider your answer correct if "},{"attrs":{"alt":"","src":"/statement-assets/7400ce840a2dd7f70d5f7169f546af9aec8b1b7c0c18043b50670a606baf03d2.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1000 1000 3\n1000 0\n-1000 0\n0 5000\n0 -5000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14.282170363\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n-1000000 -1000000 1\n1000000 -1000000\n999999 1000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2000001000.999999500\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n-1000 1000 3\n1000 0\n-1000 2000\n2000 -1000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6.000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n-303667 189976 10\n-638 116487\n-581 44337\n1231 -756844\n1427 -44097\n8271 -838417\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12953.274911829\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the three closest points have distances "},{"attrs":{"alt":"","src":"/statement-assets/a6aef5b0b33b10e801854264e416e94e58b82e0d3b38285c5463ddf679a5e2cb.png"},"kind":"image"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/statement-assets/425dd3a5bd5875fc04c1be71dc1381b532fe8648940dcf8aa8403b143f83d873.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the two lines "},{"kind":"math_inline","text":"y = 1000x - 1000"},{"kind":"text","text":" and "},{"attrs":{"alt":"","src":"/statement-assets/193af364a817a9020d2c4c94dd718d2f40c2049872578340072ed5d4c9293a3d.png"},"kind":"image"},{"kind":"text","text":" intersect at "},{"kind":"math_inline","text":"(2000000, 1999999000)"},{"kind":"text","text":". This point has a distance of "},{"attrs":{"alt":"","src":"/statement-assets/ed77a2c99c5b99c6f28062a2dabd4e62308909b73f17537aa7a55c5bd29765e4.png"},"kind":"image"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"( - 1000,  - 1000)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, the three lines all intersect at the point "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":". This intersection point is present three times in "},{"attrs":{"alt":"","src":"/statement-assets/947f0e2ccc1cca2b7c2a50fe6e9ec50df45bba44975eb4c80847eccfdf72009a.png"},"kind":"image"},{"kind":"text","text":" since it is the intersection of three pairs of lines. Since the distance between the intersection point and the query point is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", the answer is three times that or "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"607E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/607/problem/E"}