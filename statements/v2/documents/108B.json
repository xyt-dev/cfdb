{"assets":[],"contentKind":"statement","contestId":"108","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Datatypes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Tattah's youngest brother, Tuftuf, is new to programming."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since his older brother is such a good programmer, his biggest dream is to outshine him. Tuftuf is a student at the German University in Cairo (GUC) where he learns to write programs in Gava."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Today, Tuftuf was introduced to Gava's unsigned integer datatypes. Gava has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" unsigned integer datatypes of sizes (in bits) "},{"kind":"math_inline","text":"a1, a2, ... an"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th datatype have size "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" bits, so it can represent every integer between "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2ai - 1"},{"kind":"text","text":" inclusive. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Tuftuf is thinking of learning a better programming language. If there exists an integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" fits in some type "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" (in "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" bits) and "},{"kind":"math_inline","text":"x·x"},{"kind":"text","text":" does not fit in some other type "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" (in "},{"kind":"math_inline","text":"aj"},{"kind":"text","text":" bits) where "},{"kind":"math_inline","text":"ai < aj"},{"kind":"text","text":", then Tuftuf will stop using Gava."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine Tuftuf's destiny."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":") — the number of Gava's unsigned integer datatypes' sizes. The second line contains a single-space-separated list of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — sizes of datatypes in bits. Some datatypes may have equal sizes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if Tuftuf will stop using Gava, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n64 16 32\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n4 2 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second example, "},{"kind":"math_inline","text":"x = 7"},{"kind":"math_inline","text":"(1112)"},{"kind":"text","text":" fits in "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" bits, but "},{"kind":"math_inline","text":"x2 = 49"},{"kind":"math_inline","text":"(1100012)"},{"kind":"text","text":" does not fit in "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" bits."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"108B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/108/problem/B"}