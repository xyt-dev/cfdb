{"assets":[],"contentKind":"statement","contestId":"819","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Mister B and Astronomers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After studying the beacons Mister B decided to visit alien's planet, because he learned that they live in a system of flickering star Moon. Moreover, Mister B learned that the star shines once in exactly "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" seconds. The problem is that the star is yet to be discovered by scientists."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" astronomers numerated from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" trying to detect the star. They try to detect the star by sending requests to record the sky for "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" second. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The astronomers send requests "},{"children":[{"kind":"text","text":"in cycle"}],"kind":"container"},{"kind":"text","text":": the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th astronomer sends a request exactly "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" second after the "},{"kind":"math_inline","text":"(i - 1)"},{"kind":"text","text":"-th (i.e. if the previous request was sent at moment "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", then the next request is sent at moment "},{"kind":"math_inline","text":"t + ai"},{"kind":"text","text":"); the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st astronomer sends requests "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":" seconds later than the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th. The first astronomer sends his first request at moment "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mister B doesn't know the first moment the star is going to shine, but it's obvious that all moments at which the star will shine are determined by the time of its shine moment in the interval "},{"kind":"math_inline","text":"[0, T)"},{"kind":"text","text":". Moreover, this interval can be split into "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" parts of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" second length each of form "},{"kind":"math_inline","text":"[t, t + 1)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"t = 0, 1, 2, ..., (T - 1)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mister B wants to know how lucky each astronomer can be in discovering the star first."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each astronomer compute how many segments of form "},{"kind":"math_inline","text":"[t, t + 1)"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"t = 0, 1, 2, ..., (T - 1)"},{"kind":"text","text":") there are in the interval "},{"kind":"math_inline","text":"[0, T)"},{"kind":"text","text":" so that this astronomer is the first to discover the star if the first shine of the star happens in this time interval."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ T ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ n ≤ 2·105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers: for each astronomer print the number of time segments describer earlier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1 1 1 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test the first astronomer will send requests at moments "},{"kind":"math_inline","text":"t1 = 0, 5, 10, ..."},{"kind":"text","text":", the second — at moments "},{"kind":"math_inline","text":"t2 = 3, 8, 13, ..."},{"kind":"text","text":". That's why interval "},{"kind":"math_inline","text":"[0, 1)"},{"kind":"text","text":" the first astronomer will discover first at moment "},{"kind":"math_inline","text":"t1 = 0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"[1, 2)"},{"kind":"text","text":" — the first astronomer at moment "},{"kind":"math_inline","text":"t1 = 5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"[2, 3)"},{"kind":"text","text":" — the first astronomer at moment "},{"kind":"math_inline","text":"t1 = 10"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"[3, 4)"},{"kind":"text","text":" — the second astronomer at moment "},{"kind":"math_inline","text":"t2 = 3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test interval "},{"kind":"math_inline","text":"[0, 1)"},{"kind":"text","text":" — the first astronomer will discover first, "},{"kind":"math_inline","text":"[1, 2)"},{"kind":"text","text":" — the second astronomer, "},{"kind":"math_inline","text":"[2, 3)"},{"kind":"text","text":" — the third astronomer, "},{"kind":"math_inline","text":"[3, 4)"},{"kind":"text","text":" — the fourth astronomer, "},{"kind":"math_inline","text":"[4, 5)"},{"kind":"text","text":" — the first astronomer."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"819D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/819/problem/D"}