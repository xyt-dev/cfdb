{"assets":[],"contentKind":"statement","contestId":"479","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Long Jumps"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Valery is a PE teacher at a school in Berland. Soon the students are going to take a test in long jumps, and Valery has lost his favorite ruler! "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, there is no reason for disappointment, as Valery has found another ruler, its length is "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" centimeters. The ruler already has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" marks, with which he can make measurements. We assume that the marks are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in the order they appear from the beginning of the ruler to its end. The first point coincides with the beginning of the ruler and represents the origin. The last mark coincides with the end of the ruler, at distance "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" from the origin. This ruler can be repesented by an increasing sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" denotes the distance of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th mark from the origin ("},{"kind":"math_inline","text":"a1 = 0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"an = l"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valery believes that with a ruler he can measure the distance of "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" centimeters, if there is a pair of integers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ j ≤ n"},{"kind":"text","text":"), such that the distance between the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th and the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th mark is exactly equal to "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" (in other words, "},{"kind":"math_inline","text":"aj - ai = d"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Under the rules, the girls should be able to jump at least "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" centimeters, and the boys should be able to jump at least "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"x < y"},{"kind":"text","text":") centimeters. To test the children's abilities, Valery needs a ruler to measure each of the distances "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine what is the minimum number of additional marks you need to add on the ruler so that they can be used to measure the distances "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". Valery can add the marks at any integer non-negative distance from the origin not exceeding the length of the ruler."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four positive space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 ≤ l ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ x < y ≤ l"},{"kind":"text","text":") — the number of marks, the length of the ruler and the jump norms for girls and boys, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 = a1 < a2 < ... < an = l"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" shows the distance from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th mark to the origin."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single non-negative integer "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" — the minimum number of marks that you need to add on the ruler."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"p1, p2, ..., pv"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ pi ≤ l"},{"kind":"text","text":"). Number "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" means that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th mark should be at the distance of "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" centimeters from the origin. Print the marks in any order. If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 250 185 230\n0 185 250\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n230\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 250 185 230\n0 20 185 250\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 300 185 230\n0 300\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n185 230\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample it is impossible to initially measure the distance of "},{"kind":"math_inline","text":"230"},{"kind":"text","text":" centimeters. For that it is enough to add a "},{"kind":"math_inline","text":"20"},{"kind":"text","text":" centimeter mark or a "},{"kind":"math_inline","text":"230"},{"kind":"text","text":" centimeter mark."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample you already can use the ruler to measure the distances of "},{"kind":"math_inline","text":"185"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"230"},{"kind":"text","text":" centimeters, so you don't have to add new marks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample the ruler only contains the initial and the final marks. We will need to add two marks to be able to test the children's skills."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"479D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/479/problem/D"}