{"assets":[],"contentKind":"statement","contestId":"1515","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"H. Phoenix and Bits"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Phoenix loves playing with bits — specifically, by using the bitwise operations "},{"children":[{"kind":"text","text":"AND"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"OR"}],"kind":"container"},{"kind":"text","text":", and "},{"children":[{"kind":"text","text":"XOR"}],"kind":"container"},{"kind":"text","text":". He has $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$, and will perform $$$q$$$ of the following queries:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" replace all numbers $$$a_i$$$ where $$$l \\le a_i \\le r$$$ with $$$a_i$$$ "},{"children":[{"kind":"text","text":"AND"}],"kind":"container"},{"kind":"text","text":" $$$x$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" replace all numbers $$$a_i$$$ where $$$l \\le a_i \\le r$$$ with $$$a_i$$$ "},{"children":[{"kind":"text","text":"OR"}],"kind":"container"},{"kind":"text","text":" $$$x$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" replace all numbers $$$a_i$$$ where $$$l \\le a_i \\le r$$$ with $$$a_i$$$ "},{"children":[{"kind":"text","text":"XOR"}],"kind":"container"},{"kind":"text","text":" $$$x$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" output how many "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" integers $$$a_i$$$ where $$$l \\le a_i \\le r$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For each query, Phoenix is given $$$l$$$, $$$r$$$, and $$$x$$$. Note that he is considering the values of the numbers, not their indices."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$q$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$; $$$1 \\le q \\le 10^5$$$) — the number of integers and the number of queries, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$0 \\le a_i \\lt 2^{20}$$$) — the integers that Phoenix starts with."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$q$$$ lines contain the queries. For each query, the first integer of each line is $$$t$$$ ($$$1 \\le t \\le 4$$$) — the type of query."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If $$$t \\in \\{1, 2, 3\\}$$$, then three integers $$$l_i$$$, $$$r_i$$$, and $$$x_i$$$ will follow ($$$0 \\le l_i, r_i, x_i \\lt 2^{20}$$$; $$$l_i \\le r_i$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, if $$$t=4$$$, two integers $$$l_i$$$ and $$$r_i$$$ will follow ($$$0 \\le l_i \\le r_i \\lt 2^{20}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there is at least one query where $$$t=4$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the answer for each query where $$$t=4$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"c