{"assets":[],"contentKind":"statement","contestId":"1008","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Romaji"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vitya has just started learning Berlanese language. It is known that Berlanese uses the Latin alphabet. Vowel letters are \""},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"o"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"u"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"i"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"e"}],"kind":"container"},{"kind":"text","text":"\". Other letters are consonant."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In Berlanese, there has to be a vowel after every consonant, but there can be any letter after any vowel. The only exception is a consonant \""},{"children":[{"kind":"text","text":"n"}],"kind":"container"},{"kind":"text","text":"\"; after this letter, there can be any letter (not only a vowel) or there can be no letter at all. For example, the words \""},{"children":[{"kind":"text","text":"harakiri"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yupie"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"man"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"nbo"}],"kind":"container"},{"kind":"text","text":"\" are Berlanese while the words \""},{"children":[{"kind":"text","text":"horse"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"king"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"my"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"nz"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Vitya find out if a word $$$s$$$ is Berlanese."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains the string $$$s$$$ consisting of $$$|s|$$$ ($$$1\\leq |s|\\leq 100$$$) lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if there is a vowel after every consonant except \""},{"children":[{"kind":"text","text":"n"}],"kind":"container"},{"kind":"text","text":"\", otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print each letter in any case (upper or lower)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"sumimasen\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ninja\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"codeforces\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first and second samples, a vowel goes after each consonant except \""},{"children":[{"kind":"text","text":"n"}],"kind":"container"},{"kind":"text","text":"\", so the word is Berlanese."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, the consonant \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\" goes after the consonant \""},{"children":[{"kind":"text","text":"r"}],"kind":"container"},{"kind":"text","text":"\", and the consonant \""},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":"\" stands on the end, so the word is not Berlanese."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1008A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1008/problem/A"}