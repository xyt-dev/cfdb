{"assets":[],"contentKind":"statement","contestId":"1856","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Good Arrays"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array of "},{"children":[{"kind":"text","text":"positive"}],"kind":"container"},{"kind":"text","text":" integers $$$a$$$ of length $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call an array of "},{"children":[{"kind":"text","text":"positive"}],"kind":"container"},{"kind":"text","text":" integers $$$b$$$ of length $$$n$$$ "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" $$$a_i \\neq b_i$$$ for "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" $$$i$$$ from $$$1$$$ to $$$n$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_1 + a_2 +\\ldots + a_n = b_1 + b_2 + \\ldots + b_n$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Does a good array exist?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line of input contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases. The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 10^5$$$) — the length of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10 ^ 9$$$) — the elements of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if there exists a good array, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output the answer in any case (upper or lower). For example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\",\""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be recognized as positive responses."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n3\n6 1 2\n2\n1 1\n4\n3 1 2 4\n1\n17\n5\n1 2 1 1 1\n3\n618343152 819343431 1000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nNO\nYES\nNO\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, a possible "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" array is $$$[3, 3, 3]$$$. Some examples of not "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" arrays are: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$[8, 0, 1]$$$ — the array does not consist of only "},{"children":[{"kind":"text","text":"positive"}],"kind":"container"},{"kind":"text","text":" integers, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[5, 2, 4]$$$ — the array does not have the same sum as the given array, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$[5, 2, 2]$$$ — the third element is equal to the third element of the given array. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second test case, $$$[1, 1]$$$ is the only array of positive integers of length $$$2$$$ that has the sum of it's elements equal to $$$2$$$. Since $$$[1, 1]$$$ is not a "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" array, the answer is \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1856B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1856/problem/B"}