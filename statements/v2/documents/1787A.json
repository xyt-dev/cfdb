{"assets":[],"contentKind":"statement","contestId":"1787","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Exponential Equation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an integer $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find any pair of integers $$$(x,y)$$$ ($$$1\\leq x,y\\leq n$$$) such that $$$x^y\\cdot y+y^x\\cdot x = n$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1\\leq t\\leq 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case contains one line with a single integer $$$n$$$ ($$$1\\leq n\\leq 10^9$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, if possible, print two integers $$$x$$$ and $$$y$$$ ($$$1\\leq x,y\\leq n$$$). If there are multiple answers, print any."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print $$$-1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n3\n7\n42\n31250\n20732790\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n-1\n-1\n2 3\n5 5\n3 13\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the third test case, $$$2^3 \\cdot 3+3^2 \\cdot 2 = 42$$$, so $$$(2,3),(3,2)$$$ will be considered as legal solutions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, $$$5^5 \\cdot 5+5^5 \\cdot 5 = 31250$$$, so $$$(5,5)$$$ is a legal solution."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1787A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1787/problem/A"}