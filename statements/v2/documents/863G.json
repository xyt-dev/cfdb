{"assets":["/statement-assets/d0958e0e4042024eb89b9ceb4849ae8bad2b2c408aca4a10ca3590b16eecfd5f.png","/statement-assets/c6e2f9c282982e4b16d871cca8600013009fc7860626d9c134a9b2e0a6e1a829.png"],"contentKind":"statement","contestId":"863","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Graphic Settings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recently Ivan bought a new computer. Excited, he unpacked it and installed his favourite game. With his old computer Ivan had to choose the worst possible graphic settings (because otherwise the framerate would be really low), but now he wants to check, maybe his new computer can perform well even with the best possible graphics?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" graphics parameters in the game. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th parameter can be set to any positive integer from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", and initially is set to "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"bi ≤ ai"},{"kind":"text","text":"). So there are "},{"attrs":{"alt":"","src":"/statement-assets/d0958e0e4042024eb89b9ceb4849ae8bad2b2c408aca4a10ca3590b16eecfd5f.png"},"kind":"image"},{"kind":"text","text":" different combinations of parameters. Ivan can increase or decrease any of these parameters by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"; after that the game will be restarted with new parameters (and Ivan will have the opportunity to check chosen combination of parameters)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ivan wants to try all "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" possible combinations. Also he wants to return to the initial settings after trying all combinations, because he thinks that initial settings can be somehow best suited for his hardware. But Ivan doesn't really want to make a lot of restarts."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So he wants you to tell the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If there exists a way to make exactly "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" changes (each change either decreases or increases some parameter by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":") to try all possible combinations and return to initial combination, then Ivan wants to know this way. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Otherwise, if there exists a way to make exactly "},{"kind":"math_inline","text":"p - 1"},{"kind":"text","text":" changes to try all possible combinations (including the initial one), then Ivan wants to know this way. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Ivan by showing him the way to change parameters!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains one integer number "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 6"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"a1, a2, ..., am"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ ai ≤ 1000"},{"kind":"text","text":"). It is guaranteed that "},{"attrs":{"alt":"","src":"/statement-assets/c6e2f9c282982e4b16d871cca8600013009fc7860626d9c134a9b2e0a6e1a829.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"b1, b2, ..., bm"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ ai"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is a way to make exactly "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" changes (each change either decreases or increases some parameter by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":") to try all possible combinations and return to initial combination, then output "},{"children":[{"kind":"text","text":"Cycle"}],"kind":"container"},{"kind":"text","text":" in the first line. Then "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" lines must follow, each desribing a change. The line must be either "},{"children":[{"kind":"text","text":"inc x"}],"kind":"container"},{"kind":"text","text":" (increase parameter "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":") or "},{"children":[{"kind":"text","text":"dec x"}],"kind":"container"},{"kind":"text","text":" (decrease it)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, if there is a way to make exactly "},{"kind":"math_inline","text":"p - 1"},{"kind":"text","text":" changes to try all possible combinations (including the initial one), then output "},{"children":[{"kind":"text","text":"Path"}],"kind":"container"},{"kind":"text","text":" in the first line. Then "},{"kind":"math_inline","text":"p - 1"},{"kind":"text","text":" lines must follow, each describing the change the same way as mentioned above."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, output "},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n3\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Path\ninc 1\ninc 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n3\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n3 2\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Cycle\ninc 1\ninc 1\ninc 2\ndec 1\ndec 1\ndec 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"863G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/863/problem/G"}