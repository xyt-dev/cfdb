{"assets":[],"contentKind":"statement","contestId":"1990","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Grid Puzzle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array $$$a$$$ of size $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is an $$$n \\times n$$$ grid. In the $$$i$$$-th row, the first $$$a_i$$$ cells are black and the other cells are white. In other words, note $$$(i,j)$$$ as the cell in the $$$i$$$-th row and $$$j$$$-th column, cells $$$(i,1), (i,2), \\ldots, (i,a_i)$$$ are black, and cells $$$(i,a_i+1), \\ldots, (i,n)$$$ are white."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can do the following operations any number of times in any order: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Dye a $$$2 \\times 2$$$ subgrid white; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Dye a whole row white. Note you can "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" dye a whole column white. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Find the minimum number of operations to dye all cells white."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\leq t \\leq 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each test case: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The first line contains an integer $$$n$$$ ($$$1 \\leq n \\leq 2 \\cdot 10^5$$$) — the size of the array $$$a$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The second line contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$0 \\leq a_i \\leq n$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It's guaranteed that the sum of $$$n$$$ over all test cases will not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the minimum number of operations to dye all cells white."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n1\n0\n4\n2 4 4 2\n4\n3 2 1 0\n3\n0 3 0\n3\n0 1 3\n3\n3 1 0\n4\n3 1 0 3\n4\n0 2 2 2\n6\n1 3 4 2 0 4\n8\n2 2 5 2 3 4 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n3\n2\n1\n2\n2\n3\n2\n4\n6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, you don't need to do any operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, you can do:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Dye $$$(1,1), (1,2), (2,1)$$$, and $$$(2,2)$$$ white; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Dye $$$(2,3), (2,4), (3,3)$$$, and $$$(3,4)$$$ white; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Dye $$$(3,1), (3,2), (4,1)$$$, and $$$(4,2)$$$ white. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It can be proven $$$3$$$ is the minimum number of operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, you can do:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Dye the first row white; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Dye $$$(2,1), (2,2), (3,1)$$$, and $$$(3,2)$$$ white. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It can be proven $$$2$$$ is the minimum number of operations."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1990D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1990/problem/D"}