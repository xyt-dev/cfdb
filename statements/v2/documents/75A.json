{"assets":[],"contentKind":"statement","contestId":"75","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Life Without Zeros"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Can you imagine our life if we removed all zeros from it? For sure we will have many problems."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem we will have a simple example if we removed all zeros from our life, it's the addition operation. Let's assume you are given this equation "},{"kind":"math_inline","text":"a + b = c"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are positive integers, and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" is the sum of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Now let's remove all zeros from this equation. Will the equation remain correct after removing all zeros?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example if the equation is "},{"kind":"math_inline","text":"101 + 102 = 203"},{"kind":"text","text":", if we removed all zeros it will be "},{"kind":"math_inline","text":"11 + 12 = 23"},{"kind":"text","text":" which is still a correct equation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But if the equation is "},{"kind":"math_inline","text":"105 + 106 = 211"},{"kind":"text","text":", if we removed all zeros it will be "},{"kind":"math_inline","text":"15 + 16 = 211"},{"kind":"text","text":" which is not a correct equation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input will consist of two lines, the first line will contain the integer "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and the second line will contain the integer "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" which are in the equation as described above ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ 109"},{"kind":"text","text":"). There won't be any leading zeros in both. The value of "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" should be calculated as "},{"kind":"math_inline","text":"c = a + b"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The output will be just one line, you should print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if the equation will remain correct after removing all zeros, and print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"101\n102\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"105\n106\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"75A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/75/problem/A"}