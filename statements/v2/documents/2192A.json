{"assets":[],"contentKind":"statement","contestId":"2192","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. String Rotation Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Define a "},{"children":[{"kind":"text","text":"block"}],"kind":"container"},{"kind":"text","text":" in a string as a contiguous substring of characters of the same type that cannot be extended either to the left or the right. For example, in the string "},{"children":[{"kind":"text","text":"aabcccdaa"}],"kind":"container"},{"kind":"text","text":", there are five blocks:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":" ($$$1$$$-st to $$$2$$$-nd characters) "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":" ($$$3$$$-rd character) "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"ccc"}],"kind":"container"},{"kind":"text","text":" ($$$4$$$-th to $$$6$$$-th characters) "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"d"}],"kind":"container"},{"kind":"text","text":" ($$$7$$$-th character) "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":" ($$$8$$$-th to $$$9$$$-th characters). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You are playing a game where you are given a string $$$s$$$ of length $$$n$$$. You can cyclically rotate$$$^{\\text{∗}}$$$ the string however you want. Your score is then calculated as the number of blocks in the final string. Please find the maximum score possible."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$Formally, choose an index $$$1 \\leq i \\leq n$$$, and replace the string $$$s_1s_2\\ldots s_n$$$ with the string $$$s_{i+1}s_{i+2}\\ldots s_ns_1s_2\\ldots s_{i}$$$. For example, the string "},{"children":[{"kind":"text","text":"abcde"}],"kind":"container"},{"kind":"text","text":" can be rotated to string "},{"children":[{"kind":"text","text":"deabc"}],"kind":"container"},{"kind":"text","text":" by choosing $$$i=3$$$."}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 500$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 100$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains the string $$$s$$$ of length $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Strings $$$s$$$ consist of lowercase Latin characters only."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase, output a single integer denoting the maximum score you can achieve."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n4\nabcd\n4\nabbc\n4\nabba\n6\nabbccc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n4\n3\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, score of the original string "},{"children":[{"kind":"text","text":"abcd"}],"kind":"container"},{"kind":"text","text":" is $$$4$$$. It can be shown that a score greater than $$$4$$$ cannot be achieved."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, cyclically rotating the string by $$$2$$$ positions will give us string "},{"children":[{"kind":"text","text":"bcab"}],"kind":"container"},{"kind":"text","text":". Score of this string is $$$4$$$. It can be shown that a score greater than $$$4$$$ cannot be achieved."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2192A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2192/problem/A"}