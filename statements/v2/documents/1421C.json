{"assets":[],"contentKind":"statement","contestId":"1421","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Palindromifier"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ringo found a string $$$s$$$ of length $$$n$$$ in his "},{"attrs":{"href":"https://www.youtube.com/watch?v=m2uTFF_3MaA"},"children":[{"kind":"text","text":"yellow submarine"}],"kind":"link"},{"kind":"text","text":". The string contains only lowercase letters from the English alphabet. As Ringo and his friends love palindromes, he would like to turn the string $$$s$$$ into a palindrome by applying two types of operations to the string. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first operation allows him to choose $$$i$$$ ($$$2 \\le i \\le n-1$$$) and to append the substring $$$s_2s_3 \\ldots s_i$$$ ($$$i - 1$$$ characters) reversed to the front of $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second operation allows him to choose $$$i$$$ ($$$2 \\le i \\le n-1$$$) and to append the substring $$$s_i s_{i + 1}\\ldots s_{n - 1}$$$ ($$$n - i$$$ characters) reversed to the end of $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that characters in the string in this problem are indexed from $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example suppose $$$s=$$$"},{"children":[{"kind":"text","text":"abcdef"}],"kind":"container"},{"kind":"text","text":". If he performs the first operation with $$$i=3$$$ then he appends "},{"children":[{"kind":"text","text":"cb"}],"kind":"container"},{"kind":"text","text":" to the front of $$$s$$$ and the result will be "},{"children":[{"kind":"text","text":"cbabcdef"}],"kind":"container"},{"kind":"text","text":". Performing the second operation on the resulted string with $$$i=5$$$ will yield "},{"children":[{"kind":"text","text":"cbabcdefedc"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to help Ringo make the entire string a palindrome by applying any of the two operations (in total) "},{"children":[{"kind":"text","text":"at most $$$30$$$ times"}],"kind":"container"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"The length of the resulting palindrome must not exceed $$$10^6$$$"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that under these constraints there always is a solution. Also note you do not have to minimize neither the number of operations applied, nor the length of the resulting string, but they have to fit into the constraints."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains the string $$$S$$$ ($$$3 \\le |s| \\le 10^5$$$) of lowercase letters from the English alphabet."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line should contain $$$k$$$ ($$$0\\le k \\le 30$$$)  — the number of operations performed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following $$$k$$$ lines should describe an operation in form "},{"children":[{"kind":"text","text":"L i"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"R i"}],"kind":"container"},{"kind":"text","text":". $$$L$$$ represents the first operation, $$$R$$$ represents the second operation, $$$i$$$ represents the index chosen."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The length of the resulting palindrome must not exceed $$$10^6$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nabac\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\nR 2\nR 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nacccc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\nL 4\nL 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nhannah\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first example the following operations are performed:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"abac"}],"kind":"container"},{"kind":"text","text":" $$$\\to$$$ "},{"children":[{"kind":"text","text":"abacab"}],"kind":"container"},{"kind":"text","text":" $$$\\to$$$ "},{"children":[{"kind":"text","text":"abacaba"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second sample performs the following operations: "},{"children":[{"kind":"text","text":"acccc"}],"kind":"container"},{"kind":"text","text":" $$$\\to$$$ "},{"children":[{"kind":"text","text":"cccacccc"}],"kind":"container"},{"kind":"text","text":" $$$\\to$$$ "},{"children":[{"kind":"text","text":"ccccacccc"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third example is already a palindrome so no operations are required."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1421C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1421/problem/C"}