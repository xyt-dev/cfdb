{"assets":[],"contentKind":"statement","contestId":"613","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Puzzle Lover"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Oleg Petrov loves crossword puzzles and every Thursday he buys his favorite magazine with crosswords and other word puzzles. In the last magazine Oleg found a curious puzzle, and the magazine promised a valuable prize for it's solution. We give a formal description of the problem below."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The puzzle field consists of two rows, each row contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cells. Each cell contains exactly one small English letter. You also are given a word "},{"kind":"math_inline","text":"w"},{"kind":"text","text":", which consists of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" small English letters. A "},{"children":[{"kind":"text","text":"solution"}],"kind":"container"},{"kind":"text","text":" of the puzzle is a sequence of field cells "},{"kind":"math_inline","text":"c1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"ck"},{"kind":"text","text":", such that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" For all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" the letter written in the cell "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" matches the letter "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":";"}],"kind":"list_item"},{"children":[{"kind":"text","text":" All the cells in the sequence are pairwise distinct;"}],"kind":"list_item"},{"children":[{"kind":"text","text":" For all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k - 1"},{"kind":"text","text":" cells "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci + 1"},{"kind":"text","text":" have a common side."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Oleg Petrov quickly found a solution for the puzzle. Now he wonders, how many distinct solutions are there for this puzzle. Oleg Petrov doesn't like too large numbers, so calculate the answer modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two solutions "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c'i"},{"kind":"text","text":" are considered distinct if the sequences of cells do not match in at least one position, that is there is such "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" in range from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"cj ≠ c'j"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first two lines contain the state of the field for the puzzle. Each of these non-empty lines contains exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" small English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line is left empty."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line is non-empty and contains word "},{"kind":"math_inline","text":"w"},{"kind":"text","text":", consisting of small English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The length of each line doesn't exceed "},{"kind":"math_inline","text":"2 000"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of distinct solutions for the puzzle modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"code\nedoc\n\ncode\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"aaa\naaa\n\naa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"14\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"d