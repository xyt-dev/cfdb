{"assets":[],"contentKind":"statement","contestId":"605","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Board Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are playing a board card game. In this game the player has two characteristics, "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" — the white magic skill and the black magic skill, respectively. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" spell cards lying on the table, each of them has four characteristics, "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"di"},{"kind":"text","text":". In one move a player can pick one of the cards and cast the spell written on it, but only if first two of it's characteristics meet the requirement "},{"kind":"math_inline","text":"ai ≤ x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi ≤ y"},{"kind":"text","text":", i.e. if the player has enough magic skill to cast this spell. However, after casting the spell the characteristics of a player change and become equal to "},{"kind":"math_inline","text":"x = ci"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y = di"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At the beginning of the game both characteristics of a player are equal to zero. The goal of the game is to cast the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th spell. Your task is to make it in as few moves as possible. You are allowed to use spell in any order and any number of times (for example, you may not use some spells at all)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of cards on the table."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains four integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":", "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai, bi, ci, di ≤ 109"},{"kind":"text","text":") — the characteristics of the corresponding card."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the minimum number of moves needed to cast the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th spell and in the second line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" numbers — the indices of the cards in the order in which you should cast them. In case there are multiple possible solutions, print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it is impossible to cast the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th spell, print "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 0 3 4\n2 2 5 3\n4 1 1 7\n5 3 8 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n0 0 4 6\n5 1 1000000000 1000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"605D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/605/problem/D"}