{"assets":[],"contentKind":"statement","contestId":"81","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Sequence Formatting"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp is very careful. He even types numeric sequences carefully, unlike his classmates. If he sees a sequence without a space after the comma, with two spaces in a row, or when something else does not look neat, he rushes to correct it. For example, number sequence written like \""},{"children":[{"kind":"text","text":"1,2 ,3,...,   10"}],"kind":"container"},{"kind":"text","text":"\" will be corrected to \""},{"children":[{"kind":"text","text":"1, 2, 3, ..., 10"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this task you are given a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", which is composed by a concatination of terms, each of which may be: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" a positive integer of an arbitrary length (leading zeroes are not allowed), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" a \"comma\" symbol (\""},{"children":[{"kind":"text","text":","}],"kind":"container"},{"kind":"text","text":"\"), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" a \"space\" symbol (\""},{"kind":"container"},{"kind":"text","text":"\"), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \"three dots\" (\""},{"children":[{"kind":"text","text":"..."}],"kind":"container"},{"kind":"text","text":"\", that is, exactly three points written one after another, also known as suspension points). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Polycarp wants to add and remove spaces in the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to ensure the following: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" each comma is followed by exactly one space (if the comma is the last character in the string, this rule does not apply to it), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" each \"three dots\" term is preceded by exactly one space (if the dots are at the beginning of the string, this rule does not apply to the term), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if two consecutive numbers were separated by spaces only (one or more), then exactly one of them should be left, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" there should not be other spaces. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Automate Polycarp's work and write a program that will process the given string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input data contains a single string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Its length is from 1 to 255 characters. The string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" does not begin and end with a space. Its content matches the description given above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" after it is processed. Your program's output should be "},{"children":[{"kind":"text","text":"exactly"}],"kind":"container"},{"kind":"text","text":" the same as the expected answer. It is permissible to end output line with a line-break character, and without it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1,2 ,3,...,     10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1, 2, 3, ..., 10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1,,,4...5......6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1, , , 4 ...5 ... ...6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"...,1,2,3,...\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"..., 1, 2, 3, ...\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"81B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/81/problem/B"}