{"assets":[],"contentKind":"statement","contestId":"1037","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Maximum Reduction"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Given an array $$$a$$$ of $$$n$$$ integers and an integer $$$k$$$ ($$$2 \\le k \\le n$$$), where each element of the array is denoted by $$$a_i$$$ ($$$0 \\le i \\lt n$$$). Perform the operation $$$z$$$ given below on $$$a$$$ and print the value of $$$z(a,k)$$$ modulo $$$10^{9}+7$$$."}],"kind":"paragraph"},{"kind":"code_block","text":"\nfunction z(array a, integer k):\n    if length(a) < k:\n        return 0\n    else:\n        b = empty array\n        ans = 0\n        for i = 0 .. (length(a) - k):\n            temp = a[i]\n            for j = i .. (i + k - 1):\n                temp = max(temp, a[j])\n            append temp to the end of b\n            ans = ans + temp\n        return ans + z(b, k)\n"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two integers $$$n$$$ and $$$k$$$ ($$$2 \\le k \\le n \\le 10^6$$$) — the length of the initial array $$$a$$$ and the parameter $$$k$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of input contains $$$n$$$ integers $$$a_0, a_1, \\ldots, a_{n - 1}$$$ ($$$1 \\le a_{i} \\le 10^9$$$) — the elements of the array $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the only integer, the value of $$$z(a,k)$$$ modulo $$$10^9+7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n9 1 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"29\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n5 8 7 1 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"34\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" for $$$a=(9,1,10)$$$, $$$ans=19$$$ and $$$b=(9,10)$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for $$$a=(9,10)$$$, $$$ans=10$$$ and $$$b=(10)$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for $$$a=(10)$$$, $$$ans=0$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So the returned value is $$$19+10+0=29$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" for $$$a=(5,8,7,1,9)$$$, $$$ans=25$$$ and $$$b=(8,8,9)$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for $$$a=(8,8,9)$$$, $$$ans=9$$$ and $$$b=(9)$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for $$$a=(9)$$$, $$$ans=0$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So the returned value is $$$25+9+0=34$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1037F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1037/problem/F"}