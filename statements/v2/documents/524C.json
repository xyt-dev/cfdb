{"assets":[],"contentKind":"statement","contestId":"524","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. The Art of Dealing with ATM"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"ATMs of a well-known bank of a small country are arranged so that they can not give any amount of money requested by the user. Due to the limited size of the bill dispenser (the device that is directly giving money from an ATM) and some peculiarities of the ATM structure, you can get at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" bills from it, and the bills may be of at most two distinct denominations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if a country uses bills with denominations "},{"kind":"math_inline","text":"10"},{"kind":"text","text":", "},{"kind":"math_inline","text":"50"},{"kind":"text","text":", "},{"kind":"math_inline","text":"100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"500"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5000"},{"kind":"text","text":" burles, then at "},{"kind":"math_inline","text":"k = 20"},{"kind":"text","text":" such ATM can give sums "},{"kind":"math_inline","text":"100 000"},{"kind":"text","text":" burles and "},{"kind":"math_inline","text":"96 000"},{"kind":"text","text":" burles, but it cannot give sums "},{"kind":"math_inline","text":"99 000"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"101 000"},{"kind":"text","text":" burles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's suppose that the country uses bills of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct denominations, and the ATM that you are using has an unlimited number of bills of each type. You know that during the day you will need to withdraw a certain amount of cash "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" times. You know that when the ATM has multiple ways to give money, it chooses the one which requires the minimum number of bills, or displays an error message if it cannot be done. Determine the result of each of the "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" of requests for cash withdrawal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 5000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 20"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 107"},{"kind":"text","text":") — the denominations of the bills that are used in the country. Numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" follow in the strictly increasing order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 20"},{"kind":"text","text":") — the number of requests for cash withdrawal that you will make."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain numbers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi ≤ 2·108"},{"kind":"text","text":") — the sums of money in burles that you are going to withdraw from the ATM."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each request for cash withdrawal print on a single line the minimum number of bills it can be done, or print "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":", if it is impossible to get the corresponding sum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 20\n10 50 100 500 1000 5000\n8\n4200\n100000\n95000\n96000\n99000\n10100\n2015\n9950\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n20\n19\n20\n-1\n3\n-1\n-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n1 2 3 5 8\n8\n1\n3\n5\n7\n9\n11\n13\n15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n1\n2\n2\n2\n2\n-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"524C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/524/problem/C"}