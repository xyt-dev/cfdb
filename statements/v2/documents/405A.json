{"assets":["/statement-assets/4db9a9753dd62339ed237f91e5d42184bcf0ea5c1eb4dee4d109b8b6490ed9e9.png"],"contentKind":"statement","contestId":"405","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Gravity Flip"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Chris is bored during his physics lessons (too easy), so he has built a toy box to keep himself occupied. The box is special, since it has the ability to change gravity."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" columns of toy cubes in the box arranged in a line. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th column contains "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" cubes. At first, the gravity in the box is pulling the cubes downwards. When Chris switches the gravity, it begins to pull all the cubes to the right side of the box. The figure shows the initial and final configurations of the cubes in the box: the cubes that have changed their position are highlighted with orange."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/4db9a9753dd62339ed237f91e5d42184bcf0ea5c1eb4dee4d109b8b6490ed9e9.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Given the initial configuration of the toy cubes in the box, find the amounts of cubes in each of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" columns after the gravity switch!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":"), the number of the columns in the box. The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integer numbers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 100"},{"kind":"text","text":") denotes the number of cubes in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th column."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers separated by spaces, where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number is the amount of cubes in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th column after the gravity switch."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n3 2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 2 3 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 3 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 3 8 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first example case is shown on the figure. The top cube of the first column falls to the top of the last column; the top cube of the second column falls to the top of the third column; the middle cube of the first column falls to the top of the second column."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example case the gravity switch does not change the heights of the columns."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"405A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/405/problem/A"}