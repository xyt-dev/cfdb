{"assets":[],"contentKind":"statement","contestId":"468","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. 24 Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little X used to play a card game called \"24 Game\", but recently he has found it too easy. So he invented a new game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially you have a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"1, 2, ..., n"},{"kind":"text","text":". In a single step, you can pick two of them, let's denote them "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", erase them from the sequence, and append to the sequence either "},{"kind":"math_inline","text":"a + b"},{"kind":"text","text":", or "},{"kind":"math_inline","text":"a - b"},{"kind":"text","text":", or "},{"kind":"math_inline","text":"a × b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" steps there is only one number left. Can you make this number equal to "},{"kind":"math_inline","text":"24"},{"kind":"text","text":"?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it's possible, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" in the first line. Otherwise, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is a way to obtain "},{"kind":"math_inline","text":"24"},{"kind":"text","text":" as the result number, in the following "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines print the required operations an operation per line. Each operation should be in form: \""},{"kind":"math_inline","text":"a"},{"kind":"math_inline","text":"op"},{"kind":"math_inline","text":"b"},{"kind":"text","text":" = "},{"kind":"math_inline","text":"c"},{"kind":"text","text":"\". Where "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are the numbers you've picked at this operation; "},{"kind":"math_inline","text":"op"},{"kind":"text","text":" is either \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\", or \""},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"\", or \""},{"children":[{"kind":"text","text":"*"}],"kind":"container"},{"kind":"text","text":"\"; "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" is the result of corresponding operation. Note, that the absolute value of "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" mustn't be greater than "},{"kind":"math_inline","text":"1018"},{"kind":"text","text":". The result of the last operation must be equal to "},{"kind":"math_inline","text":"24"},{"kind":"text","text":". Separate operator sign and equality sign from numbers with spaces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple valid answers, you may print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n8 * 7 = 56\n6 * 5 = 30\n3 - 4 = -1\n1 - 2 = -1\n30 - -1 = 31\n56 - 31 = 25\n25 + -1 = 24\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"468A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/468/problem/A"}