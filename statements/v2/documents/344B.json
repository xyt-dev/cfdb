{"assets":["/statement-assets/35eab05f0808ed0003270aecaace893a2c9d4c805246d036f0c27109881a0a7d.png"],"contentKind":"statement","contestId":"344","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Simple Molecules"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mad scientist Mike is busy carrying out experiments in chemistry. Today he will attempt to join three atoms into one molecule."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A molecule consists of atoms, with some pairs of atoms connected by atomic bonds. Each atom has a valence number — the number of bonds the atom must form with other atoms. An atom can form "},{"children":[{"kind":"text","text":"one or multiple"}],"kind":"container"},{"kind":"text","text":" bonds with any other atom, but it cannot form a bond with itself. The number of bonds of an atom in the molecule must be equal to its valence number."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/35eab05f0808ed0003270aecaace893a2c9d4c805246d036f0c27109881a0a7d.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Mike knows valence numbers of the three atoms. Find a molecule that can be built from these atoms according to the stated rules, or determine that it is impossible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line of the input contains three space-separated integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b, c ≤ 106"},{"kind":"text","text":") — the valence numbers of the given atoms."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If such a molecule can be built, print three space-separated integers — the number of bonds between the 1-st and the 2-nd, the 2-nd and the 3-rd, the 3-rd and the 1-st atoms, correspondingly. If there are multiple solutions, output any of them. If there is no solution, print \""},{"children":[{"kind":"text","text":"Impossible"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 1 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Impossible\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first sample corresponds to the first figure. There are no bonds between atoms 1 and 2 in this case."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second sample corresponds to the second figure. There is one or more bonds between each pair of atoms."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third sample corresponds to the third figure. There is no solution, because an atom cannot form bonds with itself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The configuration in the fourth figure is impossible as each atom must have at least one atomic bond."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"344B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/344/problem/B"}