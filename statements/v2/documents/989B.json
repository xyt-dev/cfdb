{"assets":[],"contentKind":"statement","contestId":"989","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. A Tide of Riverscape"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"children":[{"kind":"text","text":" Walking along a riverside, Mino silently takes a note of something."},{"children":[{"kind":"text","text":"\"Time,\" Mino thinks aloud."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"\"What?\""}],"kind":"paragraph"},{"children":[{"kind":"text","text":"\"Time and tide wait for no man,\" explains Mino. \"My name, taken from the river, always reminds me of this.\""}],"kind":"paragraph"},{"children":[{"kind":"text","text":"\"And what are you recording?\""}],"kind":"paragraph"},{"children":[{"kind":"text","text":"\"You see it, tide. Everything has its own period, and I think I've figured out this one,\" says Mino with confidence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Doubtfully, Kanno peeks at Mino's records. "}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"The records are expressed as a string $$$s$$$ of characters '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"', where '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' denotes a low tide, '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' denotes a high tide, and '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' denotes an unknown one (either high or low)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are to help Mino determine whether it's possible that after replacing each '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' independently with '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"', a given integer $$$p$$$ is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" a period of the resulting string. In case the answer is yes, please also show such a replacement to Mino."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem, a positive integer $$$p$$$ is considered a period of string $$$s$$$, if for all $$$1 \\leq i \\leq \\lvert s \\rvert - p$$$, the $$$i$$$-th and $$$(i + p)$$$-th characters of $$$s$$$ are the same. Here $$$\\lvert s \\rvert$$$ is the length of $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers $$$n$$$ and $$$p$$$ ($$$1 \\leq p \\leq n \\leq 2000$$$) — the length of the given string and the supposed period, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string $$$s$$$ of $$$n$$$ characters — Mino's records. $$$s$$$ only contains characters '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"', and contains at least one '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' character."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one line — if it's possible that $$$p$$$ is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" a period of the resulting string, output any one of such strings; otherwise output \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\" (without quotes, you can print letters in any case (upper or lower))."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 7\n1.0.1.0.1.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1000100010\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 6\n1.0.1.1000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1001101000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 9\n1........1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, $$$7$$$ is not a period of the resulting string because the $$$1$$$-st and $$$8$$$-th characters of it are different."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, $$$6$$$ is not a period of the resulting string because the $$$4$$$-th and $$$10$$$-th characters of it are different."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, $$$9$$$ is always a period because the only constraint that the first and last characters are the same is already satisfied."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that there are multiple acceptable answers for the first two examples, you can print any of them."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"989B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/989/problem/B"}