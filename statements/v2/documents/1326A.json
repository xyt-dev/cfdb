{"assets":[],"contentKind":"statement","contestId":"1326","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Bad Ugly Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a integer $$$n$$$ ($$$n \\gt 0$$$). Find "},{"children":[{"kind":"text","text":"any"}],"kind":"container"},{"kind":"text","text":" integer $$$s$$$ which satisfies these conditions, or report that there are no such numbers:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the decimal representation of $$$s$$$: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$s \\gt 0$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s$$$ consists of $$$n$$$ digits, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" no digit in $$$s$$$ equals $$$0$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s$$$ is not divisible by any of it's digits. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of multiple test cases. The first line of the input contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 400$$$), the number of test cases. The next $$$t$$$ lines each describe a test case."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case contains one positive integer $$$n$$$ ($$$1 \\leq n \\leq 10^5$$$)."}],"kind":"par