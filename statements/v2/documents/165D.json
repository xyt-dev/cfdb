{"assets":[],"contentKind":"statement","contestId":"165","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Beard Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's define a non-oriented connected graph of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" edges as a "},{"children":[{"kind":"text","text":"beard"}],"kind":"container"},{"kind":"text","text":", if all of its vertices except, perhaps, one, have the degree of 2 or 1 (that is, there exists no more than one vertex, whose degree is more than two). Let us remind you that the degree of a vertex is the number of edges that connect to it. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let each edge be either black or white. Initially all edges are black."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the description of the beard graph. Your task is to analyze requests of the following types: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" paint the edge number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" black. The edge number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is the edge that has this number in the description. It is guaranteed that by the moment of this request the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge is white "}],"kind":"list_item"},{"children":[{"kind":"text","text":" paint the edge number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" white. It is guaranteed that by the moment of this request the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge is black "}],"kind":"list_item"},{"children":[{"kind":"text","text":" find the length of the shortest path going "},{"children":[{"kind":"text","text":"only along the black edges"}],"kind":"container"},{"kind":"text","text":" between vertices "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" or indicate that no such path exists between them (a path's length is the number of edges in it) "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The vertices are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", and the edges are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":") — the number of vertices in the graph. Next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain edges described as the numbers of vertices "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ vi, ui ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi ≠ ui"},{"kind":"text","text":") connected by this edge. It is guaranteed that the given graph is connected and forms a beard graph, and has no self-loops or multiple edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains an integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 3·105"},{"kind":"text","text":") — the number of requests. Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain requests in the following form: first a line contains an integer "},{"kind":"math_inline","text":"type"},{"kind":"text","text":", which takes values ​​from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", and represents the request type."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"type = 1"},{"kind":"text","text":", then the current request is a request to paint the edge black. In this case, in addition to number "},{"kind":"math_inline","text":"type"},{"kind":"text","text":" the line should contain integer "},{"kind":"math_inline","text":"id"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ id ≤ n - 1"},{"kind":"text","text":"), which represents the number of the edge to paint."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"type = 2"},{"kind":"text","text":", then the current request is a request to paint the edge white, its form is similar to the previous request."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"type = 3"},{"kind":"text","text":", then the current request is a request to find the distance. In this case, in addition to "},{"kind":"math_inline","text":"type"},{"kind":"text","text":", the line should contain two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" can be equal to "},{"kind":"math_inline","text":"b"},{"kind":"text","text":") — the numbers of vertices, the distance between which must be found."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The numbers in all lines are separated by exactly one space. The edges are numbered in the order in which they are given in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each request to \"find the distance between vertices "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"\" print the result. If there is no path going only along the black edges between vertices "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", then print \"-1\" (without the quotes). Print the results in the order of receiving the requests, separate the numbers with spaces or line breaks."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n2 3\n7\n3 1 2\n3 1 3\n3 2 3\n2 2\n3 1 2\n3 1 3\n3 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n1\n1\n-1\n-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 5\n6 4\n2 3\n3 5\n5 6\n6\n3 3 4\n2 5\n3 2 6\n3 1 2\n2 3\n3 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n-1\n3\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample vertices "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" are connected with edge number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", and vertices "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" are connected with edge number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Before the repainting edge number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" each vertex is reachable from each one along the black edges. Specifically, the shortest path between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" goes along both edges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If we paint edge number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" white, vertex "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" will end up cut off from other vertices, that is, no path exists from it to any other vertex along the black edges."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"165D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/165/problem/D"}