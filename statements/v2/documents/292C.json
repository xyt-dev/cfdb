{"assets":[],"contentKind":"statement","contestId":"292","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Beautiful IP Addresses"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"The problem uses a simplified TCP/IP address model, please read the statement carefully."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An IP address is a 32-bit integer, represented as a group of four decimal 8-bit integers (without leading zeroes), separated by commas. For example, record "},{"children":[{"kind":"text","text":"0.255.1.123"}],"kind":"container"},{"kind":"text","text":" shows a correct IP address and records "},{"children":[{"kind":"text","text":"0.256.1.123"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"0.255.1.01"}],"kind":"container"},{"kind":"text","text":" do not. In the given problem an arbitrary group of four 8-bit integers is a correct IP address."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Our hero Polycarpus still works as a system administrator in some large corporation. He likes beautiful IP addresses. To check if some IP address is beautiful, he should do the following:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" write out in a line four 8-bit numbers of the IP address, without the commas; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" check if the resulting string is a palindrome. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Let us remind you that a palindrome is a string that reads the same from right to left and from left to right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, IP addresses "},{"children":[{"kind":"text","text":"12.102.20.121"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"0.3.14.130"}],"kind":"container"},{"kind":"text","text":" are beautiful (as strings \""},{"children":[{"kind":"text","text":"1210220121"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"0314130"}],"kind":"container"},{"kind":"text","text":"\" are palindromes), and IP addresses "},{"children":[{"kind":"text","text":"1.20.20.1"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"100.4.4.1"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus wants to find all beautiful IP addresses that have the given set of digits. Each digit from the set must occur in the IP address at least once. IP address must not contain any other digits. Help him to cope with this difficult task."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 10)"},{"kind":"text","text":" — the number of digits in the set. The second line contains the set of integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(0 ≤ ai ≤ 9)"},{"kind":"text","text":". It is guaranteed that all digits in the set are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of beautiful IP addresses that contain the given set of digits. In the following "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines print the IP addresses, one per line in the arbitrary order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n0 1 2 9 8 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n78.190.209.187\n79.180.208.197\n87.190.209.178\n89.170.207.198\n97.180.208.179\n98.170.207.189\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"16\n4.4.4.4\n4.4.4.44\n4.4.44.4\n4.4.44.44\n4.44.4.4\n4.44.4.44\n4.44.44.4\n4.44.44.44\n44.4.4.4\n44.4.4.44\n44.4.44.4\n44.4.44.44\n44.44.4.4\n44.44.4.44\n44.44.44.4\n44.44.44.44\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"292C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/292/problem/C"}