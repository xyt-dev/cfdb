{"assets":[],"contentKind":"statement","contestId":"519","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. A and B and Lecture Rooms"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"A and B are preparing themselves for programming contests."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The University where A and B study is a set of rooms connected by corridors. Overall, the University has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rooms connected by "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" corridors so that you can get from any room to any other one by moving along the corridors. The rooms are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Every day А and B write contests in some rooms of their university, and after each contest they gather together in the same room and discuss problems. A and B want the distance from the rooms where problems are discussed to the rooms where contests are written to be equal. The distance between two rooms is the number of edges on the shortest path between them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As they write contests in new rooms every day, they asked you to help them find the number of possible rooms to discuss problems for each of the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" days."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of rooms in the University."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines describe the corridors. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines ("},{"kind":"math_inline","text":"1 ≤ i ≤ n - 1"},{"kind":"text","text":") contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":"), showing that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th corridor connects rooms "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":") — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines describe the queries. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th of these lines ("},{"kind":"math_inline","text":"1 ≤ j ≤ m"},{"kind":"text","text":") contains two integers "},{"kind":"math_inline","text":"xj"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xj, yj ≤ n"},{"kind":"text","text":") that means that on the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th day A will write the contest in the room "},{"kind":"math_inline","text":"xj"},{"kind":"text","text":", B will write in the room "},{"kind":"math_inline","text":"yj"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th ("},{"kind":"math_inline","text":"1 ≤ i ≤ m"},{"kind":"text","text":") line print the number of rooms that are equidistant from the rooms where A and B write contest on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2\n1 3\n2 4\n1\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2\n2 3\n2 4\n2\n1 2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"in the first sample there is only one room at the same distance from rooms number 2 and 3 — room number 1."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"519E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/519/problem/E"}