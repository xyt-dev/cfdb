{"assets":[],"contentKind":"statement","contestId":"614","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Gena's Code"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"0.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"It's the year 4527 and the tanks game that we all know and love still exists. There also exists Great Gena's code, written in 2016. The problem this code solves is: given the number of tanks that go into the battle from each country, find their product. If it is turns to be too large, then the servers might have not enough time to assign tanks into teams and the whole game will collapse!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct countries in the world and the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th country added "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" tanks to the game. As the developers of the game are perfectionists, the number of tanks from each country is beautiful. A "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" number, according to the developers, is such number that its decimal representation consists only of digits '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"', moreover it contains "},{"children":[{"kind":"text","text":"at most one"}],"kind":"container"},{"kind":"text","text":" digit '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"'. However, due to complaints from players, some number of tanks of "},{"children":[{"kind":"text","text":"one"}],"kind":"container"},{"kind":"text","text":" country was removed from the game, hence the number of tanks of this country may not remain beautiful."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to write the program that solves exactly the same problem in order to verify Gena's code correctness. Just in case."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains the number of countries "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" non-negative integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" without leading zeroes — the number of tanks of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th country."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the second line contains at least "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" beautiful numbers and the total length of all these number's representations doesn't exceed "},{"kind":"math_inline","text":"100 000"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number without leading zeroes — the product of the number of tanks presented by each country."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n5 10 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"50"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1 10 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"110"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 3 1 100 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In sample 1 numbers 10 and 1 are "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":", number 5 is not not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In sample 2 number 11 is not "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" (contains two '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"'s), all others are "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In sample 3 number 3 is not "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":", all others are "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"614B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/614/problem/B"}