{"assets":[],"contentKind":"statement","contestId":"174","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Range Increments"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarpus is an amateur programmer. Now he is analyzing a friend's program. He has already found there the function "},{"children":[{"kind":"text","text":"rangeIncrement(l, r)"}],"kind":"container"},{"kind":"text","text":", that adds "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" to each element of some array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" for all indexes in the segment "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":". In other words, this function does the following: "}],"kind":"paragraph"},{"kind":"code_block","text":"\nfunction rangeIncrement(l, r)\n    for i := l .. r do\n        a[i] = a[i] + 1\n"},{"children":[{"kind":"text","text":"Polycarpus knows the state of the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" after a series of function calls. He wants to determine the minimum number of function calls that lead to such state. In addition, he wants to find what function calls are needed in this case. It is guaranteed that the required number of calls does not exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Before calls of function "},{"children":[{"kind":"text","text":"rangeIncrement(l, r)"}],"kind":"container"},{"kind":"text","text":" all array elements equal zero."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the length of the array "},{"kind":"math_inline","text":"a[1... n]"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains its integer space-separated elements, "},{"kind":"math_inline","text":"a[1], a[2], ..., a[n]"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ a[i] ≤ 105"},{"kind":"text","text":") after some series of function calls "},{"children":[{"kind":"text","text":"rangeIncrement(l, r)"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that at least one element of the array is positive. It is guaranteed that the answer contains no more than "},{"kind":"math_inline","text":"105"},{"kind":"text","text":" calls of function "},{"children":[{"kind":"text","text":"rangeIncrement(l, r)"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print on the first line "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" — the minimum number of calls of function "},{"children":[{"kind":"text","text":"rangeIncrement(l, r)"}],"kind":"container"},{"kind":"text","text":", that lead to the array from the input data. It is guaranteed that this number will turn out not more than "},{"kind":"math_inline","text":"105"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then print "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines — the descriptions of function calls, one per line. Each line should contain two integers "},{"kind":"math_inline","text":"li, ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":") — the arguments of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th call "},{"children":[{"kind":"text","text":"rangeIncrement(l, r)"}],"kind":"container"},{"kind":"text","text":". Calls can be applied in any order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 2 1 1 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n2 2\n5 5\n5 5\n5 5\n1 6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 0 1 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1\n3 3\n5 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first sample requires a call for the entire array, and four additional calls:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" one for the segment [2,2] (i.e. the second element of the array), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" three for the segment [5,5] (i.e. the fifth element of the array). "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"174C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/174/problem/C"}