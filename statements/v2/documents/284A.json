{"assets":["/statement-assets/4e1f1f30cac6bad5f0e165ebd644f49265d3055572b93a4772b0b8d786dc3e6e.png","/statement-assets/bf37dd5c6e501886077694d246e1139551f34b9fd11d534667b08f05046972c7.png","/statement-assets/beb1b60288c21893fc37269b140af1c9054d2a497ccbc2eaaf2898eb35808b93.png"],"contentKind":"statement","contestId":"284","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Cows and Primitive Roots"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The cows have just learned what a primitive root is! Given a prime "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", a primitive root "},{"attrs":{"alt":"","src":"/statement-assets/4e1f1f30cac6bad5f0e165ebd644f49265d3055572b93a4772b0b8d786dc3e6e.png"},"kind":"image"},{"kind":"text","text":" is an integer "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"(1 ≤ x < p)"},{"kind":"text","text":" such that none of integers "},{"kind":"math_inline","text":"x - 1, x2 - 1, ..., xp - 2 - 1"},{"kind":"text","text":" are divisible by "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", but "},{"kind":"math_inline","text":"xp - 1 - 1"},{"kind":"text","text":" is. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, computing primitive roots can be time consuming, so the cows need your help. Given a prime "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", help the cows find the number of primitive roots "},{"attrs":{"alt":"","src":"/statement-assets/4e1f