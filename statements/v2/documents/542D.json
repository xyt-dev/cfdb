{"assets":["/statement-assets/e93da64d293a9a6f9738df4224c98b7ccd98e4458bf7ba78f492c945fec44b77.png","/statement-assets/fda48f0976f8f573cd6dae0b308eb8cd9d886caf03303850d136e067719de427.png"],"contentKind":"statement","contestId":"542","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Superhero's Job"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"It's tough to be a superhero. And it's twice as tough to resist the supervillain who is cool at math. Suppose that you're an ordinary Batman in an ordinary city of Gotham. Your enemy Joker mined the building of the city administration and you only have several minutes to neutralize the charge. To do that you should enter the cancel code on the bomb control panel."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, that mad man decided to give you a hint. This morning the mayor found a playing card under his pillow. There was a line written on the card:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e93da64d293a9a6f9738df4224c98b7ccd98e4458bf7ba78f492c945fec44b77.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The bomb has a note saying \""},{"kind":"math_inline","text":"J(x) = A"},{"kind":"text","text":"\", where "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is some positive integer. You suspect that the cancel code is some integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" that meets the equation "},{"kind":"math_inline","text":"J(x) = A"},{"kind":"text","text":". Now in order to decide whether you should neutralize the bomb or run for your life, you've got to count how many distinct positive integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" meet this equation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line of the input contains a single integer "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ A ≤ 1012"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of solutions of the equation "},{"kind":"math_inline","text":"J(x) = A"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"24\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Record "},{"kind":"math_inline","text":"x|n"},{"kind":"text","text":" means that number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" divides number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/fda48f0976f8f573cd6dae0b308eb8cd9d886caf03303850d136e067719de427.png"},"kind":"image"},{"kind":"text","text":" is defined as the largest positive integer that divides both "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample test the only suitable value of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Then "},{"kind":"math_inline","text":"J(2) = 1 + 2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test the following values of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" match:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"x = 14"},{"kind":"text","text":", "},{"kind":"math_inline","text":"J(14) = 1 + 2 + 7 + 14 = 24"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"x = 15"},{"kind":"text","text":", "},{"kind":"math_inline","text":"J(15) = 1 + 3 + 5 + 15 = 24"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"x = 23"},{"kind":"text","text":", "},{"kind":"math_inline","text":"J(23) = 1 + 23 = 24"}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"542D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/542/problem/D"}