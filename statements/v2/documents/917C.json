{"assets":["/statement-assets/a6d747871cef4ecbdb10acc584b5e2534d6c88aca820b0e5b08cfa5b5feba619.png"],"contentKind":"statement","contestId":"917","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Pollywog"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As we all know, Dart is some kind of creature from Upside Down world. For simplicity, we call their kind "},{"children":[{"kind":"text","text":"pollywogs"}],"kind":"container"},{"kind":"text","text":". Dart and "},{"kind":"math_inline","text":"x - 1"},{"kind":"text","text":" other pollywogs are playing a game. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" stones in a row, numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right. At most "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" pollywog may be sitting on each stone at a time. Initially, the pollywogs are sitting on the first "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" stones (one pollywog on each stone)."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a6d747871cef4ecbdb10acc584b5e2534d6c88aca820b0e5b08cfa5b5feba619.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Dart and his friends want to end up on the last "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" stones. At each second, the leftmost pollywog should jump to the right. A pollywog can jump at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" stones; more specifically, a pollywog can jump from stone number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to stones "},{"kind":"math_inline","text":"i + 1, i + 2, ... i + k"},{"kind":"text","text":". A pollywog can't jump on an occupied stone. Jumping a distance "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" takes "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" amounts of energy from the pollywog. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" stones are "},{"children":[{"kind":"text","text":"special"}],"kind":"container"},{"kind":"text","text":" Each time landing on a special stone "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", takes "},{"kind":"math_inline","text":"wp"},{"kind":"text","text":" amounts of energy (in addition to the energy for jump) from the pollywog. "},{"kind":"math_inline","text":"wp"},{"kind":"text","text":" could be negative, in this case, it means the pollywog absorbs "},{"kind":"math_inline","text":"|wp|"},{"kind":"text","text":" amounts of energy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pollywogs want to spend as little energy as possible (this value could be negative). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"They're just pollywogs, so they asked for your help. Tell them the total change in their energy, in case they move optimally."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains four integers, "},{"kind":"math_inline","text":"x, k, n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ k ≤ 8"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k ≤ n ≤ 108"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ q ≤ min(25, n - x)"},{"kind":"text","text":") — the number of pollywogs, the maximum length of jump, the number of stones and the number of special stones."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers, "},{"kind":"math_inline","text":"c1, c2, ... ck"},{"kind":"text","text":", separated by spaces ("},{"kind":"math_inline","text":"1 ≤ ci ≤ 109"},{"kind":"text","text":") — the energetic costs of jumps."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain description of the special stones. Each line contains two integers "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"wp"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"x + 1 ≤ p ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"|wp| ≤ 109"},{"kind":"text","text":"). All "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum amount of energy they need, in the first and only line of output."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 10 2\n1 2 3\n5 -10\n6 1000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 7 85 3\n17 5 28 4 52 46 6\n59 -76\n33 -69\n19 2018\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"135\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"917C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/917/problem/C"}