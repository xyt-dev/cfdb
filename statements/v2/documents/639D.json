{"assets":[],"contentKind":"statement","contestId":"639","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Bear and Contribution"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Codeforces is a wonderful platform and one its feature shows how much someone contributes to the community. Every registered user has "},{"children":[{"kind":"text","text":"contribution"}],"kind":"container"},{"kind":"text","text":" — an integer number, not necessarily positive. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" registered users and the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them has contribution "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak is a little polar bear and he's new into competitive programming. He doesn't even have an account in Codeforces but he is able to upvote existing blogs and comments. We assume that every registered user has infinitely many blogs and comments."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Limak can spend "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" minutes to read one blog and upvote it. Author's contribution will be increased by "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Limak can spend "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" minutes to read one comment and upvote it. Author's contribution will be increased by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that it's possible that Limak reads blogs faster than comments."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak likes ties. He thinks it would be awesome to see a tie between at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" registered users. To make it happen he is going to spend some time on reading and upvoting. After that, there should exist an integer value "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" that at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" registered users have contribution exactly "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How much time does Limak need to achieve his goal?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ k ≤ n ≤ 200 000, 1 ≤ b, c ≤ 1000"},{"kind":"text","text":") — the number of registered users, the required minimum number of users with the same contribution, time needed to read and upvote a blog, and time needed to read and upvote a comment, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"t1, t2, ..., tn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|ti| ≤ 109"},{"kind":"text","text":") where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" denotes contribution of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th registered user."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of minutes Limak will spend to get a tie between at least "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" registered users."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 100 30\n12 2 6 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"220\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 30 100\n12 2 6 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"190\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 2 987 789\n-8 42 -4 -65 -8 -8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, there are "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" registered users and Limak wants a tie between at least "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" of them. Limak should behave as follows."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" He spends "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" minutes to read one blog of the "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"-th user and increase his contribution from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"6"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then he spends "},{"kind":"math_inline","text":"4·30 = 120"},{"kind":"text","text":" minutes to read four comments of the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd user and increase his contribution from "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" (four times it was increaded by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the given scenario, Limak spends "},{"kind":"math_inline","text":"100 + 4·30 = 220"},{"kind":"text","text":" minutes and after that each of users "},{"kind":"math_inline","text":"2, 3, 4"},{"kind":"text","text":" has contribution "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, Limak needs "},{"kind":"math_inline","text":"30"},{"kind":"text","text":" minutes to read a blog and "},{"kind":"math_inline","text":"100"},{"kind":"text","text":" minutes to read a comment. This time he can get "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" users with contribution equal to "},{"kind":"math_inline","text":"12"},{"kind":"text","text":" by spending "},{"kind":"math_inline","text":"100 + 3·30 = 190"},{"kind":"text","text":" minutes:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Spend "},{"kind":"math_inline","text":"2·30 = 60"},{"kind":"text","text":" minutes to read two blogs of the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st user to increase his contribution from "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"12"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Spend "},{"kind":"math_inline","text":"30 + 100"},{"kind":"text","text":" minutes to read one blog and one comment of the "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-rd user. His contribution will change from "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"6 + 5 + 1 = 12"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"639D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/639/problem/D"}