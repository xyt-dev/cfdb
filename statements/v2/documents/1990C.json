{"assets":[],"contentKind":"statement","contestId":"1990","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Mad MAD Sum"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"We define the $$$\\operatorname{MAD}$$$ (Maximum Appearing Duplicate) in an array as the largest number that appears at least twice in the array. Specifically, if there is no number that appears at least twice, the $$$\\operatorname{MAD}$$$ value is $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, $$$\\operatorname{MAD}([1, 2, 1]) = 1$$$, $$$\\operatorname{MAD}([2, 2, 3, 3]) = 3$$$, $$$\\operatorname{MAD}([1, 2, 3, 4]) = 0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array $$$a$$$ of size $$$n$$$. Initially, a variable $$$sum$$$ is set to $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following process will be executed in a sequential loop until all numbers in $$$a$$$ become $$$0$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Set $$$sum := sum + \\sum_{i=1}^{n} a_i$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Let $$$b$$$ be an array of size $$$n$$$. Set $$$b_i :=\\ \\operatorname{MAD}([a_1, a_2, \\ldots, a_i])$$$ for all $$$1 \\le i \\le n$$$, and then set $$$a_i := b_i$$$ for all $$$1 \\le i \\le n$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Find the value of $$$sum$$$ after the process."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\leq t \\leq 2 \\cdot 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each test case: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The first line contains an integer $$$n$$$ ($$$1 \\leq n \\leq 2 \\cdot 10^5$$$) — the size of the array $$$a$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The second line contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\leq a_i \\leq n$$$) — the elements of the array. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases will not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output the value of $$$sum$$$ in a new line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1\n1\n3\n2 2 3\n4\n2 1 1 2\n4\n4 4 4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n13\n9\n40\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, $$$a=[1]$$$ initially."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first loop: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Set $$$sum := sum + a_1 = 0+1=1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Set $$$b_1 :=\\ \\operatorname{MAD}([a_1])=\\ \\operatorname{MAD}([1])=0$$$, and then set $$$a_1 := b_1$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"After the first loop, $$$a=[0]$$$ and the process ends. The value of $$$sum$$$ after the process is $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, $$$a=[2,2,3]$$$ initially."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the first loop, $$$a=[0,2,2]$$$ and $$$sum=7$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the second loop, $$$a=[0,0,2]$$$ and $$$sum=11$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the third loop, $$$a=[0,0,0]$$$ and $$$sum=13$$$. Then the process ends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The value of $$$sum$$$ after the process is $$$13$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1990C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1990/problem/C"}