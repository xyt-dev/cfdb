{"assets":[],"contentKind":"statement","contestId":"499","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Watching a movie"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have decided to watch the best moments of some movie. There are two buttons on your player: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Watch the current minute of the movie. By pressing this button, you watch the current minute of the movie and the player automatically proceeds to the next minute of the movie. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Skip exactly "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" minutes of the movie ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is some fixed positive integer). If the player is now at the "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"-th minute of the movie, then as a result of pressing this button, it proceeds to the minute "},{"kind":"math_inline","text":"(t + x)"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Initially the movie is turned on in the player on the first minute, and you want to watch exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" best moments of the movie, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th best moment starts at the "},{"kind":"math_inline","text":"li"},{"kind":"text","text":"-th minute and ends at the "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":"-th minute (more formally, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th best moment consists of minutes: "},{"kind":"math_inline","text":"li, li + 1, ..., ri"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine, what is the minimum number of minutes of the movie you have to watch if you want to watch all the best moments?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ x ≤ 105"},{"kind":"text","text":") — the number of the best moments of the movie and the value of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" for the second button."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the descriptions of the best moments of the movie, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line of the description contains two integers separated by a space "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that for all integers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" the following condition holds: "},{"kind":"math_inline","text":"ri - 1 < li"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single number — the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n5 6\n10 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n1 100000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"100000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the player was initially standing on the first minute. As the minutes from the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st to the "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"-th one don't contain interesting moments, we press the second button. Now we can not press the second button and skip "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" more minutes, because some of them contain interesting moments. Therefore, we watch the movie from the "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"-th to the "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"-th minute, after that the current time is "},{"kind":"math_inline","text":"7"},{"kind":"text","text":". Similarly, we again skip "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" minutes and then watch from the "},{"kind":"math_inline","text":"10"},{"kind":"text","text":"-th to the "},{"kind":"math_inline","text":"12"},{"kind":"text","text":"-th minute of the movie. In total, we watch "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" minutes of the movie."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the movie is very interesting, so you'll have to watch all "},{"kind":"math_inline","text":"100000"},{"kind":"text","text":" minutes of the movie."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"499A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/499/problem/A"}