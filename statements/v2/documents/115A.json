{"assets":[],"contentKind":"statement","contestId":"115","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Party"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A company has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" employees numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Each employee either has no immediate manager or exactly one immediate manager, who is another employee with a different number. An employee "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is said to be the "},{"children":[{"kind":"text","text":"superior"}],"kind":"container"},{"kind":"text","text":" of another employee "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" if at least one of the following is true:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Employee "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is the immediate manager of employee "},{"kind":"math_inline","text":"B"}],"kind":"list_item"},{"children":[{"kind":"text","text":" Employee "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" has an immediate manager employee "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" such that employee "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is the superior of employee "},{"kind":"math_inline","text":"C"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The company will not have a managerial cycle. That is, there will not exist an employee who is the superior of his/her own immediate manager."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Today the company is going to arrange a party. This involves dividing all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" employees into several groups: every employee must belong to exactly one group. Furthermore, within any single group, there must not be two employees "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is the superior of "},{"kind":"math_inline","text":"B"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of groups that must be formed?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2000"},{"kind":"text","text":") — the number of employees."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the integers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"pi = "},{"kind":"text","text":"-1). Every "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" denotes the immediate manager for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th employee. If "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" is -1, that means that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th employee does not have an immediate manager. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed, that no employee will be the immediate manager of him/herself ("},{"kind":"math_inline","text":"pi ≠ i"},{"kind":"text","text":"). Also, there will be no managerial cycles."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer denoting the minimum number of groups that will be formed in the party."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n-1\n1\n2\n1\n-1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first example, three groups are sufficient, for example: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Employee 1 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Employees 2 and 4 "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Employees 3 and 5 "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"115A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/115/problem/A"}