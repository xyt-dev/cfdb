{"assets":["/statement-assets/c032d2c46080db574ebcfb09edb628eff72e8d4f7f405df9c2386dd30e926e11.png"],"contentKind":"statement","contestId":"682","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Alyona and the Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Alyona decided to go on a diet and went to the forest to get some apples. There she unexpectedly found a magic rooted tree with root in the vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", every vertex and every edge of which has a number written on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The girl noticed that some of the tree's vertices are "},{"children":[{"kind":"text","text":"sad"}],"kind":"container"},{"kind":"text","text":", so she decided to play with them. Let's call vertex "},{"kind":"math_inline","text":"v"},{"children":[{"kind":"text","text":"sad"}],"kind":"container"},{"kind":"text","text":" if there is a vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" in subtree of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"dist(v, u) > au"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"au"},{"kind":"text","text":" is the number written on vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", "},{"kind":"math_inline","text":"dist(v, u)"},{"kind":"text","text":" is the sum of the numbers written on the edges on the path from "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"u"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Leaves"}],"kind":"container"},{"kind":"text","text":" of a tree are vertices connected to a single vertex by a single edge, but the root of a tree is a "},{"children":[{"kind":"text","text":"leaf"}],"kind":"container"},{"kind":"text","text":" if and only if the tree consists of a single vertex — root."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Thus Alyona decided to remove some of tree leaves until there will be no any sad vertex left in the tree. What is the minimum number of leaves Alyona needs to remove?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line of the input integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") is given — the number of vertices in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line the sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") is given, where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the number written on vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines describe tree edges: "},{"kind":"math_inline","text":"ith"},{"kind":"text","text":" of them consists of two integers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci"},{"kind":"math_inline","text":"(1 ≤ pi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":" - 109 ≤ ci ≤ 109)"},{"kind":"text","text":", meaning that there is an edge connecting vertices "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" with number "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" written on it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer — the minimum number of leaves Alyona needs to remove such that there will be no any sad vertex left in the tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n88 22 83 14 95 91 98 53 11\n3 24\n7 -8\n1 67\n1 64\n9 65\n5 12\n6 -80\n3 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The following image represents possible process of removing leaves from the tree: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c032d2c46080db574ebcfb09edb628eff72e8d4f7f405df9c2386dd30e926e11.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"682C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/682/problem/C"}