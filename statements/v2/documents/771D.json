{"assets":[],"contentKind":"statement","contestId":"771","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Bear and Company"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bear Limak prepares problems for a programming competition. Of course, it would be unprofessional to mention the sponsor name in the statement. Limak takes it seriously and he is going to change some words. To make it still possible to read, he will try to modify each word as little as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak has a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" that consists of uppercase English letters. In one move he can swap two "},{"children":[{"kind":"text","text":"adjacent"}],"kind":"container"},{"kind":"text","text":" letters of the string. For example, he can transform a string \""},{"children":[{"kind":"text","text":"ABBC"}],"kind":"container"},{"kind":"text","text":"\" into \""},{"children":[{"kind":"text","text":"BABC"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"ABCB"}],"kind":"container"},{"kind":"text","text":"\" in one move."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak wants to obtain a string without a substring \""},{"children":[{"kind":"text","text":"VK"}],"kind":"container"},{"kind":"text","text":"\" (i.e. there should be no letter '"},{"children":[{"kind":"text","text":"V"}],"kind":"container"},{"kind":"text","text":"' immediately followed by letter '"},{"children":[{"kind":"text","text":"K"}],"kind":"container"},{"kind":"text","text":"'). It can be easily proved that it's possible for any initial string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum possible number of moves Limak can do?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 75"},{"kind":"text","text":") — the length of the string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of uppercase English letters. The length of the string is equal to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer, denoting the minimum possible number of moves Limak can do, in order to obtain a string without a substring \""},{"children":[{"kind":"text","text":"VK"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nVKVK\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":