":"math_inline","text":"30"},{"kind":"text","text":", so the answer is "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth example the months are: December — January — February (non-leap year)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"899B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/899/problem/B"}