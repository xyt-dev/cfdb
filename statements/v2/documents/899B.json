{"assets":[],"contentKind":"statement","contestId":"899","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Months and Years"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Everybody in Russia uses Gregorian calendar. In this calendar there are "},{"kind":"math_inline","text":"31"},{"kind":"text","text":" days in January, "},{"kind":"math_inline","text":"28"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"29"},{"kind":"text","text":" days in February (depending on whether the year is leap or not), "},{"kind":"math_inline","text":"31"},{"kind":"text","text":" days in March, "},{"kind":"math_inline","text":"30"},{"kind":"text","text":" days in April, "},{"kind":"math_inline","text":"31"},{"kind":"text","text":" days in May, "},{"kind":"math_inline","text":"30"},{"kind":"text","text":" in June, "},{"kind":"math_inline","text":"31"},{"kind":"text","text":" in July, "},{"kind":"math_inline","text":"31"},{"kind":"text","text":" in August, "},{"kind":"math_inline","text":"30"},{"kind":"text","text":" in September, "},{"kind":"math_inline","text":"31"},{"kind":"text","text":" in October, "},{"kind":"math_inline","text":"30"},{"kind":"text","text":" in November, "},{"kind":"math_inline","text":"31"},{"kind":"text","text":" in December."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A year is leap in one of two cases: either its number is divisible by "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", but not divisible by "},{"kind":"math_inline","text":"100"},{"kind":"text","text":", or is divisible by "},{"kind":"math_inline","text":"400"},{"kind":"text","text":". For example, the following years are leap: "},{"kind":"math_inline","text":"2000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2004"},{"kind":"text","text":", but years "},{"kind":"math_inline","text":"1900"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2018"},{"kind":"text","text":" are not leap."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem you are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 24"},{"kind":"text","text":") integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":", and you have to check if these integers could be durations in days of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" consecutive months, according to Gregorian calendar. Note that these months could belong to several consecutive years. In other words, check if there is a month in some year, such that its duration is "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":" days, duration of the next month is "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":" days, and so on."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 24"},{"kind":"text","text":") — the number of integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"28 ≤ ai ≤ 31"},{"kind":"text","text":") — the numbers you are to check."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there are several consecutive months that fit the sequence, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes). Otherwise, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print each letter in arbitrary case (small or large)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n31 31 30 31\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n30 30\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n29 31 30 31 30\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"chi