{"assets":[],"contentKind":"statement","contestId":"1833","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Vlad Building Beautiful Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vlad was given an array $$$a$$$ of $$$n$$$ positive integers. Now he wants to build a "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" array $$$b$$$ of length $$$n$$$ from it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vlad considers an array "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if all the numbers in it are positive and have the same parity. That is, all numbers in the "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" array are "},{"children":[{"kind":"text","text":"greater"}],"kind":"container"},{"kind":"text","text":" than zero and are either all even or all odd."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To build the array $$$b$$$, Vlad can assign each $$$b_i$$$ either the value $$$a_i$$$ or $$$a_i - a_j$$$, where any $$$j$$$ from $$$1$$$ to $$$n$$$ can be chosen."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To avoid trying to do the impossible, Vlad asks you to determine whether it is possible to build a "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" array $$$b$$$ of length $$$n$$$ using his array $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains an integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow the descriptions of the test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each case contains a single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the length of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each case contains $$$n$$$ positive integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$) — the elements of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output $$$t$$$ strings, each of which is the answer to the corresponding test case. As the answer, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if Vlad can build a "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" array $$$b$$$, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output the answer in any case (for example, the strings \""},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" will be recognized as a positive answer)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n5\n2 6 8 4 3\n5\n1 4 7 6 9\n4\n2 6 4 10\n7\n5 29 13 9 10000001 11 3\n5\n2 1 2 4 2\n5\n2 4 5 4 3\n4\n2 5 5 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNO\nYES\nYES\nYES\nYES\nNO\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1833C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1833/problem/C"}