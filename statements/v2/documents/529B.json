{"assets":[],"contentKind":"statement","contestId":"529","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Group Photo 2 (online mirror version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Many years have passed, and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" friends met at a party again. Technologies have leaped forward since the last meeting, cameras with timer appeared and now it is not obligatory for one of the friends to stand with a camera, and, thus, being absent on the photo."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Simply speaking, the process of photographing can be described as follows. Each friend occupies a rectangle of pixels on the photo: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them in a standing state occupies a "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" pixels wide and a "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" pixels high rectangle. But also, each person can lie down for the photo, and then he will occupy a "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" pixels wide and a "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" pixels high rectangle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The total photo will have size "},{"kind":"math_inline","text":"W × H"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"W"},{"kind":"text","text":" is the total width of all the people rectangles, and "},{"kind":"math_inline","text":"H"},{"kind":"text","text":" is the maximum of the heights. The friends want to determine what minimum area the group photo can they obtain if no more than "},{"kind":"math_inline","text":"n / 2"},{"kind":"text","text":" of them can lie on the ground (it would be strange if more than "},{"kind":"math_inline","text":"n / 2"},{"kind":"text","text":" gentlemen lie on the ground together, isn't it?..)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help them to achieve this goal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":") — the number of friends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines have two integers "},{"kind":"math_inline","text":"wi, hi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ wi, hi ≤ 1000"},{"kind":"text","text":") each, representing the size of the rectangle, corresponding to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th friend."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer equal to the minimum possible area of the photo containing all friends if no more than "},{"kind":"math_inline","text":"n / 2"},{"kind":"text","text":" of them can lie on the ground."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n10 1\n20 2\n30 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"180\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 1\n2 2\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"21\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n5 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"50\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"529B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/529/problem/B"}