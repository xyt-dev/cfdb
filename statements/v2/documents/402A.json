{"assets":[],"contentKind":"statement","contestId":"402","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Nuts"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" nuts and lots of boxes. The boxes have a wonderful feature: if you put "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"(x ≥ 0)"},{"kind":"text","text":" divisors (the spacial bars that can divide a box) to it, you get a box, divided into "},{"kind":"math_inline","text":"x + 1"},{"kind":"text","text":" sections."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are minimalist. Therefore, on the one hand, you are against dividing some box into more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" sections. On the other hand, you are against putting more than "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" nuts into some section of the box. What is the minimum number of boxes you have to use if you want to put all the nuts in boxes, and you have "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" divisors?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please note that you need to minimize the number of used boxes, not sections. You do not have to minimize the number of used divisors."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four space-separated integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ k ≤ 1000"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"1 ≤ a, b, v ≤ 1000"},{"kind":"text","text":") — the maximum number of sections in the box, the number of nuts, the number of divisors and the capacity of each section of the box."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 10 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 10 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"100 100 1 1000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample you can act like this: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Put two divisors to the first box. Now the first box has three sections and we can put three nuts into each section. Overall, the first box will have nine nuts. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Do not put any divisors into the second box. Thus, the second box has one section for the last nut. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the end we've put all the ten nuts into boxes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second sample is different as we have exactly one divisor and we put it to the first box. The next two boxes will have one section each."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"402A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/402/problem/A"}