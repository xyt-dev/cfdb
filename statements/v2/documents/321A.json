text":"\" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\nRU\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2\nRU\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"-1 1000000000\nLRRLU\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 0\nD\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first and second test case, command string is \""},{"children":[{"kind":"text","text":"RU"}],"kind":"container"},{"kind":"text","text":"\", so the robot will go right, then go up, then right, and then up and so on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The locations of its moves are (0, 0) "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" (1, 0) "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" (1, 1) "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" (2, 1) "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" (2, 2) "},{"kind":"math_inline","text":" → "},{"kind":"math_inline","text":"..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So it can reach (2, 2) but not (1, 2)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"321A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/321/problem/A"}