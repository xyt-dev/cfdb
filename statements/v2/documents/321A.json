{"assets":[],"contentKind":"statement","contestId":"321","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Ciel and Robot"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Fox Ciel has a robot on a 2D plane. Initially it is located in (0, 0). Fox Ciel code a command to it. The command was represented by string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Each character of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is one move operation. There are four move operations at all:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":"': go up, (x, y) "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" (x, y+1); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"': go down, (x, y) "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" (x, y-1); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"': go left, (x, y) "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" (x-1, y); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"': go right, (x, y) "},{"kind":"math_inline","text"