{"assets":[],"contentKind":"statement","contestId":"223","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Bracket Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"bracket sequence"}],"kind":"container"},{"kind":"text","text":" is a string, containing only characters \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"["}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"]"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"correct bracket sequence"}],"kind":"container"},{"kind":"text","text":" is a bracket sequence that can be transformed into a correct arithmetic expression by inserting characters \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" between the original characters of the sequence. For example, bracket sequences \""},{"children":[{"kind":"text","text":"()[]"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"([])"}],"kind":"container"},{"kind":"text","text":"\" are correct (the resulting expressions ar