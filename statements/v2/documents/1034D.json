{"assets":[],"contentKind":"statement","contestId":"1034","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Intervals of Intervals"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little D is a friend of Little C who loves intervals very much instead of number \"$$$3$$$\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now he has $$$n$$$ intervals on the number axis, the $$$i$$$-th of which is $$$[a_i,b_i]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Only the $$$n$$$ intervals can not satisfy him. He defines the value of an "},{"children":[{"kind":"text","text":"interval of intervals"}],"kind":"container"},{"kind":"text","text":" $$$[l,r]$$$ ($$$1 \\leq l \\leq r \\leq n$$$, $$$l$$$ and $$$r$$$ are both integers) as the total length of the union of intervals from the $$$l$$$-th to the $$$r$$$-th."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He wants to select exactly $$$k$$$ different "},{"children":[{"kind":"text","text":"intervals of intervals"}],"kind":"container"},{"kind":"text","text":" such that the sum of their values is maximal. Please help him calculate the maximal sum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\leq n \\leq 3 \\cdot 10^5$$$, $$$1 \\leq k \\leq \\min\\{\\frac{n(n+1)}{2},10^9\\}$$$) — the number of intervals Little D has and the number of "},{"children":[{"kind":"text","text":"intervals of intervals"}],"kind":"container"},{"kind":"text","text":" he will select."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n$$$ lines contains two integers $$$a_i$$$ and $$$b_i$$$, the $$$i$$$-th line of the $$$n$$$ lines describing the $$$i$$$-th interval ($$$1 \\leq a_i \\lt b_i \\leq 10^9$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the maximal sum of values Little D can get."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n1 3\n2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 4\n5 7\n3 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"15"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first example, Little D will select $$$[1,2]$$$, the union of the first interval and the second interval is $$$[1,4]$$$, whose length is $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second example, Little D will select $$$[1,2]$$$, $$$[2,3]$$$ and $$$[1,3]$$$, the answer is $$$5+6+4=15$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1034D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1034/problem/D"}