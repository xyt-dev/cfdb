{"assets":[],"contentKind":"statement","contestId":"362","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Petya and Pipes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A little boy Petya dreams of growing up and becoming the Head Berland Plumber. He is thinking of the problems he will have to solve in the future. Unfortunately, Petya is too inexperienced, so you are about to solve one of such problems for Petya, the one he's the most interested in."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Berland capital has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" water tanks numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". These tanks are connected by unidirectional pipes in some manner. Any pair of water tanks is connected by at most one pipe in each direction. Each pipe has a strictly positive integer width. Width determines the number of liters of water per a unit of time this pipe can transport. The water goes to the city from the main water tank (its number is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"). The water must go through some pipe path and get to the sewer tank with cleaning system (its number is "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya wants to increase the width of some subset of pipes by at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" units in total so that the width of each pipe remains integer. Help him determine the maximum amount of water that can be transmitted per a unit of time from the main tank to the sewer tank after such operation is completed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 50"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ 1000"},{"kind":"text","text":"). Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers separated by single spaces. The "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":"-th row and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column contain number "},{"kind":"math_inline","text":"cij"},{"kind":"text","text":" — the width of the pipe that goes from tank "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to tank "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ cij ≤ 106, cii = 0"},{"kind":"text","text":"). If "},{"kind":"math_inline","text":"cij = 0"},{"kind":"text","text":", then there is no pipe from tank "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to tank "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maximum amount of water that can be transmitted from the main tank to the sewer tank per a unit of time."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 7\n0 1 0 2 0\n0 0 4 10 0\n0 0 0 0 5\n0 0 0 0 10\n0 0 0 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 10\n0 1 0 0 0\n0 0 2 0 0\n0 0 0 3 0\n0 0 0 0 4\n100 0 0 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test Petya can increase width of the pipe that goes from the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"st to the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"nd water tank by "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" units."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test Petya can increase width of the pipe that goes from the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"st to the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"nd water tank by "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" units, from the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"nd to the "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"rd water tank by "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" units, from the "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"rd to the "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"th water tank by "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" units and from the "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"th to "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"th water tank by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" unit."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"362E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/362/problem/E"}