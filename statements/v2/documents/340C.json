{"assets":["/statement-assets/42a093c5ef335715ce92341d6de10aade5a2bc84e5e6a3bc20df833d616e9058.png","/statement-assets/5b61a3cd7bdc4e3cb0f0b342eb4a609387413e2451bb61ae01ec4062842f7379.png","/statement-assets/3c923b00381cc407c11a86e146807a81199d53931f8843152d19c75b5c58b0d3.png"],"contentKind":"statement","contestId":"340","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Tourist Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Iahub is a big fan of tourists. He wants to become a tourist himself, so he planned a trip. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" destinations on a straight road that Iahub wants to visit. Iahub starts the excursion from kilometer 0. The "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" destinations are described by a non-negative integers sequence "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"text","text":". The number "},{"kind":"math_inline","text":"ak"},{"kind":"text","text":" represents that the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"th destination is at distance "},{"kind":"math_inline","text":"ak"},{"kind":"text","text":" kilometers from the starting point. No two destinations are located in the same place. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Iahub wants to visit each destination only once. Note that, crossing through a destination is not considered visiting, unless Iahub explicitly wants to visit it at that point. Also, after Iahub visits his last destination, he doesn't come back to kilometer 0, as he stops his trip at the last destination. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The distance between destination located at kilometer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and next destination, located at kilometer "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", is "},{"kind":"math_inline","text":"|x - y|"},{"kind":"text","text":" kilometers. We call a \"route\" an order of visiting the destinations. Iahub can visit destinations in any order he wants, as long as he visits all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" destinations and he doesn't visit a destination more than once. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Iahub starts writing out on a paper all possible routes and for each of them, he notes the total distance he would walk. He's interested in the average number of kilometers he would walk by choosing a route. As he got bored of writing out all the routes, he asks you to help him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":"). Next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 107"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output two integers — the numerator and denominator of a fraction which is equal to the wanted average number. The fraction must be irreducible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"22 3"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider 6 possible routes:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" [2, 3, 5]: total distance traveled: |2 – 0| + |3 – 2| + |5 – 3| = 5; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" [2, 5, 3]: |2 – 0| + |5 – 2| + |3 – 5| = 7; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" [3, 2, 5]: |3 – 0| + |2 – 3| + |5 – 2| = 7; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" [3, 5, 2]: |3 – 0| + |5 – 3| + |2 – 5| = 8; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" [5, 2, 3]: |5 – 0| + |2 – 5| + |3 – 2| = 9; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" [5, 3, 2]: |5 – 0| + |3 – 5| + |2 – 3| = 8. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The average travel distance is "},{"attrs":{"alt":"","src":"/statement-assets/42a093c5ef335715ce92341d6de10aade5a2bc84e5e6a3bc20df833d616e9058.png"},"kind":"image"},{"kind":"text","text":" = "},{"attrs":{"alt":"","src":"/statement-assets/5b61a3cd7bdc4e3cb0f0b342eb4a609387413e2451bb61ae01ec4062842f7379.png"},"kind":"image"},{"kind":"text","text":" = "},{"attrs":{"alt":"","src":"/statement-assets/3c923b00381cc407c11a86e146807a81199d53931f8843152d19c75b5c58b0d3.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"340C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/340/problem/C"}