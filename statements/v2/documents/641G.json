{"assets":[],"contentKind":"statement","contestId":"641","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Little Artem and Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"12 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Artem is given a graph, constructed as follows: start with some "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-clique, then add new vertices one by one, connecting them to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" already existing vertices that form a "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-clique."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Artem wants to count the number of spanning trees in this graph modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ min(n, 5)"},{"kind":"text","text":") — the total size of the graph and the size of the initial clique, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n - k"},{"kind":"text","text":" lines describe "},{"kind":"math_inline","text":"k + 1"},{"kind":"text","text":"-th, "},{"kind":"math_inline","text":"k + 2"},{"kind":"text","text":"-th, ..., "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th, ..., "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th vertices by listing "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" distinct vertex indices "},{"kind":"math_inline","text":"1 ≤ aij < i"},{"kind":"text","text":" it is connected to. It is guaranteed that those vertices form a k-clique."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the number of spanning trees in the given graph modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"16\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index"