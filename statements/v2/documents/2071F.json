{"assets":[],"contentKind":"statement","contestId":"2071","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Towering Arrays"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"6 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"An array $$$b = [b_1, b_2, \\ldots, b_m]$$$ of length $$$m$$$ is called $$$p$$$-"},{"children":[{"kind":"text","text":"towering"}],"kind":"container"},{"kind":"text","text":" if there exists an index $$$i$$$ ($$$1\\le i\\le m$$$) such that for every index $$$j$$$ ($$$1 \\le j \\le m$$$), the following condition holds: $$$$$$b_j \\ge p - |i - j|.$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given an array $$$a = [a_1, a_2, \\ldots, a_n]$$$ of length $$$n$$$, you can remove at most $$$k$$$ elements from it. Determine the maximum value of $$$p$$$ for which the remaining array can be made $$$p$$$-"},{"children":[{"kind":"text","text":"towering"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ and $$$k$$$ ($$$0 \\le k \\lt n \\le 2 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer — the maximum value of $$$p$$$ for which the remaining array can be made $$$p$$$-"},{"children":[{"kind":"text","text":"towering"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n5 0\n2 1 4 5 2\n5 3\n2 1 4 5 2\n6 1\n1 2 3 4 5 1\n11 6\n6 3 8 5 8 3 2 1 2 7 1\n14 3\n3 2 3 5 5 2 6 7 4 8 10 1 8 9\n2 0\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n5\n5\n7\n9\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, you cannot delete any element. The array remains $$$[2, 1, 4, \\color{red}{5}, 2]$$$ and is "},{"children":[{"kind":"text","text":"p-towering"}],"kind":"container"},{"kind":"text","text":" for $$$p = 3$$$ by picking $$$i = 4$$$:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a_1 = 2 \\ge p - |i - 1| = 3 - |4 - 1| = 0$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_2 = 1 \\ge p - |i - 2| = 3 - |4 - 2| = 1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_3 = 4 \\ge p - |i - 3| = 3 - |4 - 3| = 2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_4 = 5 \\ge p - |i - 4| = 3 - |4 - 4| = 3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_5 = 2 \\ge p - |i - 5| = 3 - |4 - 5| = 2$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the second test case, you can remove the first, second, and fifth elements to obtain the array $$$[4, \\color{red}{5}]$$$. Clearly, the obtained array is "},{"children":[{"kind":"text","text":"p-towering"}],"kind":"container"},{"kind":"text","text":" for $$$p = 5$$$ by picking $$$i = 2$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"2071F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2071/problem/F"}