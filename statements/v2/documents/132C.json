{"assets":[],"contentKind":"statement","contestId":"132","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Logo Turtle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A lot of people associate Logo programming language with turtle graphics. In this case the turtle moves along the straight line and accepts commands \""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\" (\"turn around\") and \""},{"children":[{"kind":"text","text":"F"}],"kind":"container"},{"kind":"text","text":"\" (\"move 1 unit forward\")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a list of commands that will be given to the turtle. You have to change exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" commands from the list (one command can be changed several times). How far from the starting point can the turtle move after it follows "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" the commands of the modified list?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a string "},{"kind":"math_inline","text":"commands"},{"kind":"text","text":" — the original list of commands. The string "},{"kind":"math_inline","text":"commands"},{"kind":"text","text":" contains between 1 and 100 characters, inclusive, and contains only characters \""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"F"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50"},{"kind":"text","text":") — the number of commands you have to change in the list."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the maximum distance from the starting point to the ending point of the turtle's path. The ending point of the turtle's path is turtle's coordinate after it follows "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" the commands of the modified list."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"FT\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"FFFTFFF\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the best option is to change the second command (\""},{"children":[{"kind":"text","text":"T"}],"kind":"container"},{"kind":"text","text":"\") to \""},{"children":[{"kind":"text","text":"F"}],"kind":"container"},{"kind":"text","text":"\" — this way the turtle will cover a distance of 2 units."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example you have to change two commands. One of the ways to cover maximal distance of 6 units is to change the fourth command and first or last one."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"132C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/132/problem/C"}