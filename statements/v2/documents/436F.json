{"assets":["/statement-assets/ac1871eeb06610c67042be691539bb6375844bbd04a1867f5f45d53d1e3b3d94.png"],"contentKind":"statement","contestId":"436","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Banners"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"All modern mobile applications are divided into free and paid. Even a single application developers often release two versions: a paid version without ads and a free version with ads."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ac1871eeb06610c67042be691539bb6375844bbd04a1867f5f45d53d1e3b3d94.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Suppose that a paid version of the app costs "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is an integer) rubles, and the free version of the application contains "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" ad banners. Each user can be described by two integers: "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" — the number of rubles this user is willing to pay for the paid version of the application, and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" — the number of banners he is willing to tolerate in the free version."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The behavior of each member shall be considered strictly deterministic:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if for user "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", value "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is at least "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", then he uses the free version, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" otherwise, if value "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is at least "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", then he buys the paid version without advertising, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" otherwise the user simply does not use the application. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Each user of the free version brings the profit of "},{"kind":"math_inline","text":"c × w"},{"kind":"text","text":" rubles. Each user of the paid version brings the profit of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" rubles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to help the application developers to select the optimal parameters "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":". Namely, knowing all the characteristics of users, for each value of "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(max bi) + 1"},{"kind":"text","text":" you need to determine the maximum profit from the application and the corresponding parameter "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"w"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105; 1 ≤ w ≤ 105)"},{"kind":"text","text":" — the number of users and the profit from a single banner. Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"math_inline","text":"(0 ≤ ai, bi ≤ 105)"},{"kind":"text","text":" — the characteristics of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th user."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"(max bi) + 2"},{"kind":"text","text":" lines, in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print two integers: "},{"kind":"math_inline","text":"pay"},{"kind":"text","text":" — the maximum gained profit at "},{"kind":"math_inline","text":"c = i - 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p"},{"kind":"math_inline","text":"(0 ≤ p ≤ 109)"},{"kind":"text","text":" — the corresponding optimal app cost. If there are multiple optimal solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n2 0\n0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 3\n3 2\n4 2\n2 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n3 1\n2 2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 4\n3 4\n7 3\n7 2\n4 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"436F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/436/problem/F"}