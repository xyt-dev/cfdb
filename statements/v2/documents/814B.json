{"assets":[],"contentKind":"statement","contestId":"814","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. An express train to reveries"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sengoku still remembers the mysterious \"colourful meteoroids\" she discovered with Lala-chan when they were little. In particular, one of the nights impressed her deeply, giving her the illusion that all her fancies would be realized."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On that night, Sengoku constructed a permutation "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" of integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" inclusive, with each integer representing a colour, wishing for the colours to see in the coming meteor outburst. Two incredible outbursts then arrived, each with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" meteorids, colours of which being integer sequences "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" respectively. Meteoroids' colours were also between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" inclusive, and the two sequences were not identical, that is, at least one "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") exists, such that "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":" holds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Well, she almost had it all — each of the sequences "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" matched exactly "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" elements in Sengoku's permutation. In other words, there is exactly one "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") such that "},{"kind":"math_inline","text":"ai ≠ pi"},{"kind":"text","text":", and exactly one "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j ≤ n"},{"kind":"text","text":") such that "},{"kind":"math_inline","text":"bj ≠ pj"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For now, Sengoku is able to recover the actual colour sequences "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" through astronomical records, but her wishes have been long forgotten. You are to reconstruct any possible permutation Sengoku could have had on that night."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 1 000"},{"kind":"text","text":") — the length of Sengoku's permutation, being the length of both meteor outbursts at the same time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ n"},{"kind":"text","text":") — the sequence of colours in the first meteor outburst."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ n"},{"kind":"text","text":") — the sequence of colours in the second meteor outburst. At least one "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") exists, such that "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":" holds."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":", denoting a possible permutation Sengoku could have had. If there are more than one possible answer, output any one of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Input guarantees that such permutation exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 4 3\n1 2 5 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 5 4 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n4 4 2 3 1\n5 4 5 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5 4 2 3 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1 3 4\n1 4 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 3 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, both "},{"kind":"math_inline","text":"1, 2, 5, 4, 3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1, 2, 3, 4, 5"},{"kind":"text","text":" are acceptable outputs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, "},{"kind":"math_inline","text":"5, 4, 2, 3, 1"},{"kind":"text","text":" is the only permutation to satisfy the constraints."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"814B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/814/problem/B"}