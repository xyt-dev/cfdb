{"assets":["/statement-assets/4d90ec05db7e36e53472bf417a0495b4dc20bc085f8799bc9d6bcb1868e68105.png"],"contentKind":"statement","contestId":"109","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Lucky Probability"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Petya loves lucky numbers. We all know that lucky numbers are the positive integers whose decimal representations contain only the lucky digits "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":". For example, numbers "},{"children":[{"kind":"text","text":"47"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"744"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" are lucky and "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"17"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"467"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya and his friend Vasya play an interesting game. Petya randomly chooses an integer "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" from the interval "},{"kind":"math_inline","text":"[pl, pr]"},{"kind":"text","text":" and Vasya chooses an integer "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" from the interval "},{"kind":"math_inline","text":"[vl, vr]"},{"kind":"text","text":" (also randomly). Both players choose their integers equiprobably. Find the probability that the interval "},{"kind":"math_inline","text":"[min(v, p), max(v, p)]"},{"kind":"text","text":" contains exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lucky numbers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The single line contains five integers "},{"kind":"math_inline","text":"pl"},{"kind":"text","text":", "},{"kind":"math_inline","text":"pr"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vl"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vr"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pl ≤ pr ≤ 109, 1 ≤ vl ≤ vr ≤ 109, 1 ≤ k ≤ 1000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the single line print the result with an absolute error of no more than "},{"kind":"math_inline","text":"10 - 9"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 10 1 10 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0.320000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6 8 10 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.000000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider that "},{"kind":"math_inline","text":"[a, b]"},{"kind":"text","text":" denotes an interval of integers; this interval "},{"children":[{"kind":"text","text":"includes"}],"kind":"container"},{"kind":"text","text":" the boundaries. That is, "},{"attrs":{"alt":"","src":"/statement-assets/4d90ec05db7e36e53472bf417a0495b4dc20bc085f8799bc9d6bcb1868e68105.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In first case there are "},{"kind":"math_inline","text":"32"},{"kind":"text","text":" suitable pairs: "},{"kind":"math_inline","text":"(1, 7), (1, 8), (1, 9), (1, 10), (2, 7), (2, 8), (2, 9), (2, 10), (3, 7), (3, 8), (3, 9), (3, 10), (4, 7), (4, 8), (4, 9), (4, 10), (7, 1), (7, 2), (7, 3), (7, 4), (8, 1), (8, 2), (8, 3), (8, 4), (9, 1), (9, 2), (9, 3), (9, 4), (10, 1), (10, 2), (10, 3), (10, 4)"},{"kind":"text","text":". Total number of possible pairs is "},{"kind":"math_inline","text":"10·10 = 100"},{"kind":"text","text":", so answer is "},{"kind":"math_inline","text":"32 / 100"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In second case Petya always get number less than Vasya and the only lucky "},{"kind":"math_inline","text":"7"},{"kind":"text","text":" is between this numbers, so there will be always "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" lucky number."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"109B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/109/problem/B"}