{"assets":["/statement-assets/79d6a07f0b0b840f0c222c15bcad089d767eae71e1c6da72b3e995b15d638500.png","/statement-assets/c74d715721ceca68e29ab13ff6479d2be57c91beb4e0edac30ad1a24cb9530c1.png","/statement-assets/29e0de1aff37d1abab9acf04d03ce7804ef922c1529cb4e4b3a6417bc9f5708e.png"],"contentKind":"statement","contestId":"902","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Visiting a Friend"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pig is visiting a friend."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pig's house is located at point "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", and his friend's house is located at point "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" on an axis."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pig can use teleports to move along the axis."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To use a teleport, Pig should come to a certain point (where the teleport is located) and choose where to move: for each teleport there is the rightmost point it can move Pig to, this point is known as the limit of the teleport."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, a teleport located at point "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" with limit "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" can move Pig from point "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to any point within the segment "},{"kind":"math_inline","text":"[x; y]"},{"kind":"text","text":", including the bounds."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/79d6a07f0b0b840f0c222c15bcad089d767eae71e1c6da72b3e995b15d638500.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Determine if Pig can visit the friend using teleports only, or he should use his car."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100, 1 ≤ m ≤ 100"},{"kind":"text","text":") — the number of teleports and the location of the friend's house."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain information about teleports."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of these lines contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ bi ≤ m"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the location of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th teleport, and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is its limit."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"It is guaranteed that "},{"kind":"math_inline","text":"ai ≥ ai - 1"},{"kind":"text","text":" for every "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ i ≤ n"},{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if there is a path from Pig's house to his friend's house that uses only teleports, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print each letter in arbitrary case (upper or lower)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n0 2\n2 4\n3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 7\n0 4\n2 5\n6 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first example is shown on the picture below:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c74d715721ceca68e29ab13ff6479d2be57c91beb4e0edac30ad1a24cb9530c1.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Pig can use the first teleport from his house (point "},{"kind":"math_inline","text":"0"},{"kind":"text","text":") to reach point "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", then using the second teleport go from point "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to point "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", then using the third teleport go from point "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" to point "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", where his friend lives."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second example is shown on the picture below:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/29e0de1aff37d1abab9acf04d03ce7804ef922c1529cb4e4b3a6417bc9f5708e.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"You can see that there is no path from Pig's house to his friend's house that uses only teleports."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"902A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/902/problem/A"}