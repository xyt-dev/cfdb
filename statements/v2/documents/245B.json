{"assets":[],"contentKind":"statement","contestId":"245","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Internet Address"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya is an active Internet user. One day he came across an Internet resource he liked, so he wrote its address in the notebook. We know that the address of the written resource has format:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"<protocol>://<domain>.ru[/<context>]"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"where:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"<protocol>"}],"kind":"container"},{"kind":"text","text":" can equal either \""},{"children":[{"kind":"text","text":"http"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) or \""},{"children":[{"kind":"text","text":"ftp"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes), "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"<domain>"}],"kind":"container"},{"kind":"text","text":" is a non-empty string, consisting of lowercase English letters, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the "},{"children":[{"kind":"text","text":"/<context>"}],"kind":"container"},{"kind":"text","text":" part may not be present. If it is present, then "},{"children":[{"kind":"text","text":"<context>"}],"kind":"container"},{"kind":"text","text":" is a non-empty string, consisting of lowercase English letters. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If string "},{"children":[{"kind":"text","text":"<context>"}],"kind":"container"},{"kind":"text","text":" isn't present in the address, then the additional character \""},{"children":[{"kind":"text","text":"/"}],"kind":"container"},{"kind":"text","text":"\" isn't written. Thus, the address has either two characters \""},{"children":[{"kind":"text","text":"/"}],"kind":"container"},{"kind":"text","text":"\" (the ones that go before the domain), or three (an extra one in front of the context)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When the boy came home, he found out that the address he wrote in his notebook had no punctuation marks. Vasya must have been in a lot of hurry and didn't write characters \""},{"children":[{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"/"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Vasya to restore the possible address of the recorded Internet resource."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a non-empty string that Vasya wrote out in his notebook. This line consists of lowercase English letters only. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given string contains at most 50 letters. It is guaranteed that the given string can be obtained from some correct Internet resource address, described above."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single line — the address of the Internet resource that Vasya liked. If there are several addresses that meet the problem limitations, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"httpsunrux\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"http://sun.ru/x\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ftphttprururu\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"ftp://http.ru/ruru\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the second sample there are two more possible answers: \""},{"children":[{"kind":"text","text":"ftp://httpruru.ru"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"ftp://httpru.ru/ru"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"245B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/245/problem/B"}