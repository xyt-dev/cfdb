{"assets":[],"contentKind":"statement","contestId":"439","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Devu and Partitioning of the Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Devu being a small kid, likes to play a lot, but he only likes to play with arrays. While playing he came up with an interesting question which he could not solve, can you please solve it for him?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given an array consisting of distinct integers. Is it possible to partition the whole array into "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" disjoint non-empty parts such that "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" of the parts have even sum (each of them must have even sum) and remaining "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" - "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" have odd sum? (note that parts need not to be continuous)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it is possible to partition the array, also give any possible way of valid partitioning."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line will contain three space separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 105; 0 ≤ p ≤ k"},{"kind":"text","text":"). The next line will contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated distinct integers representing the content of array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":": "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) if it is possible to partition the array in the required way. Otherwise print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the required partition exists, print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines after the first line. The "},{"kind":"math_inline","text":"ith"},{"kind":"text","text":" of them should contain the content of the "},{"kind":"math_inline","text":"ith"},{"kind":"text","text":" part. Print the content of the part in the line in the following way: firstly print the number of elements of the part, then print all the elements of the part in arbitrary order. There must be exactly "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" parts with even sum, each of the remaining "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" - "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" parts must have odd sum."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As there can be multiple partitions, you are allowed to print any valid partition."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5 3\n2 6 10 5 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1 9\n1 5\n1 10\n1 6\n1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5 3\n7 14 2 9 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3 1\n1 2 3 7 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n3 5 1 3\n1 7\n1 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"439C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/439/problem/C"}