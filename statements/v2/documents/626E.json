{"assets":["/statement-assets/5ccea2da45685282a7b56968c73bda6d3c01da531df836becae8a4795f8f3e25.png","/statement-assets/b958cde43ec5e986beae89769e86ccbf48372b870fdb553e829072afb0978b65.png"],"contentKind":"statement","contestId":"626","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Simple Skewness"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Define the "},{"children":[{"kind":"text","text":"simple skewness"}],"kind":"container"},{"kind":"text","text":" of a collection of numbers to be the collection's mean minus its median. You are given a list of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" (not necessarily distinct) integers. Find the non-empty subset (with repetition) with the maximum simple skewness."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The mean of a collection is the average of its elements. The median of a collection is its middle element when all of its elements are sorted, or the average of its two middle elements if it has even size."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000"},{"kind":"text","text":") — the number of elements in the list."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ xi ≤ 1 000 000"},{"kind":"text","text":") — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th element of the list."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, print a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the size of the subset."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line, print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers — the elements of the subset in any order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple optimal subsets, print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 3 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 12 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 2 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first case, the optimal subset is "},{"attrs":{"alt":"","src":"/statement-assets/5ccea2da45685282a7b56968c73bda6d3c01da531df836becae8a4795f8f3e25.png"},"kind":"image"},{"kind":"text","text":", which has mean "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", median "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", and simple skewness of "},{"kind":"math_inline","text":"5 - 2 = 3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second case, the optimal subset is "},{"attrs":{"alt":"","src":"/statement-assets/b958cde43ec5e986beae89769e86ccbf48372b870fdb553e829072afb0978b65.png"},"kind":"image"},{"kind":"text","text":". Note that repetition is allowed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the last case, any subset has the same median and mean, so all have simple skewness of "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"626E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/626/problem/E"}