{"assets":[],"contentKind":"statement","contestId":"123","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Brackets"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A two dimensional array is called a "},{"children":[{"kind":"text","text":"bracket"}],"kind":"container"},{"kind":"text","text":" array if each grid contains one of the two possible brackets — \"(\" or \")\". A path through the two dimensional array cells is called "},{"children":[{"kind":"text","text":"monotonous"}],"kind":"container"},{"kind":"text","text":" if any two consecutive cells in the path are side-adjacent and each cell of the path is located below or to the right from the previous one. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A two dimensional array whose size equals "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" is called a "},{"children":[{"kind":"text","text":"correct bracket"}],"kind":"container"},{"kind":"text","text":" array, if any string formed by writing out the brackets on some monotonous way from cell "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" to cell "},{"kind":"math_inline","text":"(n, m)"},{"kind":"text","text":" forms a correct bracket sequence. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define the operation of comparing two correct bracket arrays of equal size ("},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":") like that. Let's consider a given two dimensional array of priorities ("},{"kind":"math_inline","text":"c"},{"kind":"text","text":") — a two dimensional array of same size, containing different integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"nm"},{"kind":"text","text":". Let's find such position "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" in the two dimensional array, that "},{"kind":"math_inline","text":"ai, j ≠ bi, j"},{"kind":"text","text":". If there are several such positions, let's choose the one where number "},{"kind":"math_inline","text":"ci, j"},{"kind":"text","text":" is minimum. If "},{"kind":"math_inline","text":"ai, j = "},{"kind":"text","text":"\"(\", then "},{"kind":"math_inline","text":"a < b"},{"kind":"text","text":", otherwise "},{"kind":"math_inline","text":"a > b"},{"kind":"text","text":". If the position "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" is not found, then the arrays are considered equal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find a "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th two dimensional correct bracket array. It is guaranteed that for the given sizes of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" there will be no less than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" two dimensional correct bracket arrays."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the sizes of the array and the number of the sought correct bracket array ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 1018"},{"kind":"text","text":"). Then an array of priorities is given, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each containing "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" numbers, number "},{"kind":"math_inline","text":"pi, j"},{"kind":"text","text":" shows the priority of character "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" in line "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi, j ≤ nm"},{"kind":"text","text":", all "},{"kind":"math_inline","text":"pi, j"},{"kind":"text","text":" are different)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the %lld specificator to read or write 64-bit integers in С++. It is preferred to use the cin, cout streams or the %I64d specificator."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th two dimensional correct bracket array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2 1\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"()\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 1\n1 2 3\n4 5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"(()\n())\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 2\n3 6\n1 4\n2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"()\n)(\n()\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample exists only one correct two-dimensional bracket array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second and in the third samples two arrays exist."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A bracket sequence is called regular if it is possible to obtain correct arithmetic expression by inserting characters «"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"» and «"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"» into this sequence. For example, sequences «"},{"children":[{"kind":"text","text":"(())()"}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":"» and «"},{"children":[{"kind":"text","text":"(()(()))"}],"kind":"container"},{"kind":"text","text":"» are regular, while «"},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"», «"},{"children":[{"kind":"text","text":"(()"}],"kind":"container"},{"kind":"text","text":"» and «"},{"children":[{"kind":"text","text":"(()))("}],"kind":"container"},{"kind":"text","text":"» are not."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"123C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/123/problem/C"}