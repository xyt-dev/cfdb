{"assets":[],"contentKind":"statement","contestId":"273","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Dima and Figure"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dima loves making pictures on a piece of squared paper. And yet more than that Dima loves the pictures that depict one of his favorite figures. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A piece of squared paper of size "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" is represented by a table, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" columns. All squares are white on blank squared paper. Dima defines a "},{"children":[{"kind":"text","text":"picture"}],"kind":"container"},{"kind":"text","text":" as an image on a blank piece of paper, obtained by painting some squares black."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The picture portrays one of Dima's favorite figures, if the following conditions hold:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The picture contains at least one painted cell; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" All painted cells form a connected set, that is, you can get from any painted cell to any other one (you can move from one cell to a side-adjacent one); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The minimum number of moves needed to go from the painted cell at coordinates "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":" to the painted cell at coordinates "},{"kind":"math_inline","text":"(x2, y2)"},{"kind":"text","text":", moving only through the colored cells, equals "},{"kind":"math_inline","text":"|x1 - x2| + |y1 - y2|"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Now Dima is wondering: how many paintings are on an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" piece of paper, that depict one of his favorite figures? Count this number modulo "},{"kind":"math_inline","text":"1000000007 (109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the sizes of the piece of paper "},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 150)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print the remainder after dividing the answer to the problem by number "},{"kind":"math_inline","text":"1000000007 (109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"571\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"273D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/273/problem/D"}