{"assets":["/statement-assets/1af50a662a0f00ba81eaf04ea990ae373b8973728f3c8ad771949e8a66c7ea63.png","/statement-assets/366c3e2859d39662a52c61a45aa16ac2a1083c410f456b8906748cae02025260.png","/statement-assets/2c771aafbe8f06230ca5283d5ac748c589f0ac70736459ec10b0ce2764e99e9e.png"],"contentKind":"statement","contestId":"768","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. The Winds of Winter"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Given a rooted tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes. The Night King removes exactly one node from the tree and all the edges associated with it. Doing this splits the tree and forms a forest. The node which is removed is not a part of the forest."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The root of a tree in the forest is the node in that tree which does not have a parent. We define the strength of the forest as the size of largest tree in forest."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Jon Snow wants to minimize the strength of the forest. To do this he can perform the following operation at most once."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"He removes the edge between a node and its parent and inserts a new edge between this node and any other node in forest such that the total number of trees in forest remain same."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each node "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" you need to find the minimum value of strength of the forest formed when node "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is removed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤  n  ≤  105"},{"kind":"text","text":") — the number of vertices in the tree. Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains a pair of vertex indices "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤  ui,  vi  ≤  n"},{"kind":"text","text":") where "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" is the parent of "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":". If "},{"kind":"math_inline","text":"ui = 0"},{"kind":"text","text":" then "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" is the root."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" line each containing a single integer. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should be equal to minimum value of strength of forest formed when "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th node is removed and Jon Snow performs the operation described above at most once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n0 1\n1 2\n1 3\n1 4\n2 5\n2 6\n3 7\n4 8\n4 9\n5 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n4\n5\n5\n5\n9\n9\n9\n9\n9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 1\n0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The tree for first test case is depicted below. "},{"attrs":{"alt":"","src":"/statement-assets/1af50a662a0f00ba81eaf04ea990ae373b8973728f3c8ad771949e8a66c7ea63.png"},"kind":"image"},{"kind":"text","text":" When you remove the first node, the tree splits to form the following forest. The strength of this forest is "},{"kind":"math_inline","text":"4"},{"kind":"text","text":". "},{"attrs":{"alt":"","src":"/statement-assets/366c3e2859d39662a52c61a45aa16ac2a1083c410f456b8906748cae02025260.png"},"kind":"image"},{"kind":"text","text":" Jon Snow now changes the parent of vertex "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". The strength of forest now becomes "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". "},{"attrs":{"alt":"","src":"/statement-assets/2c771aafbe8f06230ca5283d5ac748c589f0ac70736459ec10b0ce2764e99e9e.png"},"kind":"image"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"768G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/768/problem/G"}