{"assets":[],"contentKind":"statement","contestId":"1267","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Balls of Buma"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Balph is learning to play a game called Buma. In this game, he is given a row of colored balls. He has to choose the color of one new ball and the place to insert it (between two balls, or to the left of all the balls, or to the right of all the balls)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When the ball is inserted the following happens repeatedly: if some segment of balls of the same color became longer as a result of a previous action and its length became at least $$$3$$$, then all the balls of this segment are eliminated. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider, for example, a row of balls '"},{"children":[{"kind":"text","text":"AAABBBWWBB"}],"kind":"container"},{"kind":"text","text":"'. Suppose Balph chooses a ball of color '"},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"' and the place to insert it after the sixth ball, i. e. to the left of the two '"},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"'s. After Balph inserts this ball, the balls of color '"},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":"' are eliminated, since this segment was made longer and has length $$$3$$$ now, so the row becomes '"},{"children":[{"kind":"text","text":"AAABBBBB"}],"kind":"container"},{"kind":"text","text":"'. The balls of color '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' are eliminated now, because the segment of balls of color '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"' became longer and has length $$$5$$$ now. Thus, the row becomes '"},{"children":[{"kind":"text","text":"AAA"}],"kind":"container"},{"kind":"text","text":"'. However, none of the balls are eliminated now, because there is no elongated segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Balph count the number of possible ways to choose a color of a new ball and a place to insert it that leads to the elimination of all the balls."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains a non-empty string of uppercase English letters of length at most $$$3 \\cdot 10^5$$$. Each letter represents a ball with the corresponding color."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the number of ways to choose a color and a position of a new ball in order to eliminate all the balls."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nBBWWBB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nBWWB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nBBWBB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nOOOWWW\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\nWWWOOOOOOWWW\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1267B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1267/problem/B"}