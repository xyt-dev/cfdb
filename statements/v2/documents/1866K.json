{"assets":["/statement-assets/0a921787bb93a4d8bbf59598f3b0524da37284c8fccec8f11f21144b7634ea5f.png","/statement-assets/2315fc562f7a596526d050a051c1694cb9b86d9b38067790db424d60c9b8c5c0.png","/statement-assets/91e6f0162165fe29fcc7d4a2e7ada4d61072d34e0b85ac85be59cd83216cff0a.png"],"contentKind":"statement","contestId":"1866","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"K. Keen Tree Calculation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a tree of $$$N$$$ vertices and $$$N-1$$$ edges. The $$$i$$$-th edge connects vertices $$$U_i$$$ and $$$V_i$$$ and has a length of $$$W_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Chaneka, the owner of the tree, asks you $$$Q$$$ times. For the $$$j$$$-th question, the following is the question format: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$X_j$$$ $$$K_j$$$ – If each edge that contains vertex $$$X_j$$$ has its length multiplied by $$$K_j$$$, what is the diameter of the tree? "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Notes: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Each of Chaneka's question is "},{"children":[{"kind":"text","text":"independent"}],"kind":"container"},{"kind":"text","text":", which means the changes in edge length do not influence the next questions. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The diameter of a tree is the maximum possible distance between two different vertices in the tree. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$N$$$ ($$$2\\leq N\\leq10^5$$$) — the number of vertices in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the next $$$N-1$$$ lines contains three integers $$$U_i$$$, $$$V_i$$$, and $$$W_i$$$ ($$$1 \\leq U_i,V_i \\leq N$$$; $$$1\\leq W_i\\leq10^9$$$) — an edge that connects vertices $$$U_i$$$ and $$$V_i$$$ with a length of $$$W_i$$$. The edges form a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$(N+1)$$$-th line contains a single integer $$$Q$$$ ($$$1\\leq Q\\leq10^5$$$) — the number of questions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$j$$$-th of the next $$$Q$$$ lines contains two integers $$$X_j$$$ and $$$K_j$$$ as described ($$$1 \\leq X_j \\leq N$$$; $$$1 \\leq K_j \\leq 10^9$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output $$$Q$$$ lines with an integer in each line. The integer in the $$$j$$$-th line represents the diameter of the tree on the $$$j$$$-th question."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n5 1 2\n1 4 2\n3 4 1\n2 5 3\n6 1 6\n4 7 2\n2\n4 3\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n18\n11\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 2 1000000000\n2 3 1000000000\n1\n2 1000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2000000000000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the following is the tree without any changes."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0a921787bb93a4d8bbf59598f3b0524da37284c8fccec8f11f21144b7634ea5f.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following is the tree on the $$$1$$$-st question."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/2315fc562f7a596526d050a051c1694cb9b86d9b38067790db424d60c9b8c5c0.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The maximum distance is between vertices $$$6$$$ and $$$7$$$, which is $$$6+6+6=18$$$, so the diameter is $$$18$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following is the tree on the $$$2$$$-nd question."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/91e6f0162165fe29fcc7d4a2e7ada4d61072d34e0b85ac85be59cd83216cff0a.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The maximum distance is between vertices $$$2$$$ and $$$6$$$, which is $$$3+2+6=11$$$, so the diameter is $$$11$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"K","problemCode":"1866K","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1866/problem/K"}