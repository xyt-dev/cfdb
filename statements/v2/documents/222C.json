{"assets":[],"contentKind":"statement","contestId":"222","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Reducing Fractions"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"To confuse the opponents, the Galactic Empire represents fractions in an unusual format. The fractions are represented as two sets of integers. The product of numbers from the first set gives the fraction numerator, the product of numbers from the second set gives the fraction denominator. However, it turned out that the programs that work with fractions in this representations aren't complete, they lack supporting the operation of reducing fractions. Implement this operation and the Empire won't forget you."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":") that show how many numbers the first set (the numerator) and the second set (the denominator) contain, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers: "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 107"},{"kind":"text","text":") — the numbers that are multiplied to produce the numerator."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space-separated integers: "},{"kind":"math_inline","text":"b1, b2, ..., bm"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ 107"},{"kind":"text","text":") — the numbers that are multiplied to produce the denominator."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the answer to the problem in the form, similar to the form of the input data. The number of values in the sets you print "},{"kind":"math_inline","text":"nout, mout"},{"kind":"text","text":" must satisfy the inequality "},{"kind":"math_inline","text":"1 ≤ nout, mout ≤ 105"},{"kind":"text","text":", and the actual values in the sets "},{"kind":"math_inline","text":"aout, i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bout, i"},{"kind":"text","text":" must satisfy the inequality "},{"kind":"math_inline","text":"1 ≤ aout, i, bout, i ≤ 107"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Separate the values in the lines by spaces. The printed fraction must be reduced, that is, there mustn't be such integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"x > 1"},{"kind":"text","text":"), that the numerator and the denominator of the printed fraction are divisible by "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". If there are several matching answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n100 5 2\n50 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n2 1\n1 1 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n2 5 10 20\n100 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n20\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test sample the numerator equals 1000, the denominator equals 500. If we reduce fraction 1000/500 by the greatest common divisor of the numerator and the denominator (by 500), we obtain fraction 2/1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test sample the numerator equals 2000, the denominator equals 300. If we reduce fraction 2000/300 by the greatest common divisor of the numerator and the denominator (by 100), we obtain fraction 20/3."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"222C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/222/problem/C"}