{"assets":[],"contentKind":"statement","contestId":"875","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Classroom Watch"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Eighth-grader Vova is on duty today in the class. After classes, he went into the office to wash the board, and found on it the number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". He asked what is this number and the teacher of mathematics Inna Petrovna answered Vova that "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the answer to the arithmetic task for first-graders. In the textbook, a certain "},{"children":[{"kind":"text","text":"positive integer"}],"kind":"container"},{"kind":"math_inline","text":"x"},{"kind":"text","text":" was given. The task was to add "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to the sum of the digits of the number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" written in decimal numeral system."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since the number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" on the board was small, Vova quickly guessed which "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" could be in the textbook. Now he wants to get a program which will search for arbitrary values of the number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" for all suitable values of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" or determine that such "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" does not exist. Write such a program for Vova."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print one integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — number of different values of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" satisfying the condition. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines print these values in ascending order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"21\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n15\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"20\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case "},{"kind":"math_inline","text":"x = 15"},{"kind":"text","text":" there is only one variant: "},{"kind":"math_inline","text":"15 + 1 + 5 = 21"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case there are no such "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"875A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/875/problem/A"}