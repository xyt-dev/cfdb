{"assets":[],"contentKind":"statement","contestId":"486","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. LIS of Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The next \"Data Structures and Algorithms\" lesson will be about Longest Increasing Subsequence (LIS for short) of a sequence. For better understanding, Nam decided to learn it a few days before the lesson."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nam created a sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") elements "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 105"},{"kind":"text","text":"). A subsequence "},{"kind":"math_inline","text":"ai1, ai2, ..., aik"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"1 ≤ i1 < i2 < ... < ik ≤ n"},{"kind":"text","text":" is called increasing if "},{"kind":"math_inline","text":"ai1 < ai2 < ai3 < ... < aik"},{"kind":"text","text":". An increasing subsequence is called longest if it has maximum length among all increasing subsequences. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nam realizes that a sequence may have several longest increasing subsequences. Hence, he divides all indexes "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":"), into three groups:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" group of all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" belongs to no longest increasing subsequences."}],"kind":"list_item"},{"children":[{"kind":"text","text":" group of all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" belongs to at least one "},{"children":[{"kind":"text","text":"but not every"}],"kind":"container"},{"kind":"text","text":" longest increasing subsequence."}],"kind":"list_item"},{"children":[{"kind":"text","text":" group of all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" belongs to every longest increasing subsequence. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Since the number of longest increasing subsequences of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" may be very large, categorizing process is very difficult. Your task is to help him finish this job."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") denoting the number of elements of sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a string consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character should be '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"3"}],"kind":"container"},{"kind":"text","text":"' depending on which group among listed above index "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" belongs to."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 3 2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3223\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"chi