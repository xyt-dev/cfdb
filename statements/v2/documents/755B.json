{"assets":[],"contentKind":"statement","contestId":"755","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. PolandBall and Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"PolandBall is playing a game with EnemyBall. The rules are simple. Players have to say words in turns. You cannot say a word which was already said. PolandBall starts. The Ball which can't say a new word loses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You're given two lists of words familiar to PolandBall and EnemyBall. Can you determine who wins the game, if both play optimally?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 103"},{"kind":"text","text":") — number of words PolandBall and EnemyBall know, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" strings follow, one per line — words familiar to PolandBall."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" strings follow, one per line — words familiar to EnemyBall."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that one Ball "},{"children":[{"kind":"text","text":"cannot"}],"kind":"container"},{"kind":"text","text":" know a word more than once (strings are unique), but some words "},{"children":[{"kind":"text","text":"can"}],"kind":"container"},{"kind":"text","text":" be known by both players."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each word is non-empty and consists of no more than "},{"kind":"math_inline","text":"500"},{"kind":"text","text":" lowercase English alphabet letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line of print the answer — \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if PolandBall wins and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise. Both Balls play optimally."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1\npolandball\nis\na\ncool\ncharacter\nnope\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\nkremowka\nwadowicka\nkremowka\nwiedenska\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 2\na\na\nb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example PolandBall knows much more words and wins effortlessly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example if PolandBall says "},{"children":[{"kind":"text","text":"kremowka"}],"kind":"container"},{"kind":"text","text":" first, then EnemyBall cannot use that word anymore. EnemyBall can only say "},{"children":[{"kind":"text","text":"wiedenska"}],"kind":"container"},{"kind":"text","text":". PolandBall says "},{"children":[{"kind":"text","text":"wadowicka"}],"kind":"container"},{"kind":"text","text":" and wins."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"755B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/755/problem/B"}