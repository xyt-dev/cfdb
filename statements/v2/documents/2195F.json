{"assets":["/statement-assets/457a8edd36db1176433c57a1e1f78d0d5d339f9af9b4c1fd490e5efb2cfb2b65.png"],"contentKind":"statement","contestId":"2195","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Parabola Independence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a set of $$$n$$$ "},{"children":[{"kind":"text","text":"quadratic"}],"kind":"container"},{"kind":"text","text":" functions $$$F=\\{f_1,f_2,\\ldots,f_n \\}$$$, where $$$f_i(x)=a_i x^2 + b_i x + c_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two functions $$$f$$$ and $$$g$$$ are called "},{"children":[{"kind":"text","text":"independent"}],"kind":"container"},{"kind":"text","text":" if $$$f(x) \\neq g(x)$$$ for all $$$x \\in \\mathbb{R}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also, a set of functions $$$G=\\{g_1,g_2,\\ldots,g_k\\}$$$ is called "},{"children":[{"kind":"text","text":"organized"}],"kind":"container"},{"kind":"text","text":" if the two functions $$$g_i$$$ and $$$g_j$$$ are independent for all $$$1 \\le i \\lt j \\le |G|$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each $$$i=1,2,\\ldots,n$$$, please find the size of the largest organized subset of $$$F$$$ that contains $$$f_i$$$ as an element."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 3000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the $$$n$$$ following lines contains three integers $$$a_i$$$, $$$b_i$$$, $$$c_i$$$ denoting the function $$$f_i$$$ ($$$-10^6 \\le a_i, b_i, c_i \\le 10^6$$$, $$$a_i \\neq 0$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the functions in one test case are pairwise distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n^2$$$ over all test cases does not exceed $$$3000^2$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output $$$n$$$ integers $$$s_1,s_2,\\ldots,s_n$$$, where $$$s_i$$$ is the size of the largest organized subset that contains $$$f_i$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n4\n1 2 -1\n-3 0 -3\n-1 4 -5\n1 2 -4\n5\n3 0 0\n1 0 -5\n-3 0 0\n-1 0 10\n1 0 -10\n5\n884 -667 497\n680 -973 213\n23 -548 -412\n826 359 -333\n773 212 218\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3 2 3 3\n3 3 2 2 3\n3 3 3 1 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the functions are as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$f_1(x)=x^2+2x-1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$f_2(x)=-3x^2-3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$f_3(x)=-x^2+4x-5$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$f_4(x)=x^2+2x-4$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The functions' graphs are as shown below:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/457a8edd36db1176433c57a1e1f78d0d5d339f9af9b4c1fd490e5efb2cfb2b65.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The largest organized subsets of $$$F$$$ containing each function are as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$\\{f_1,f_3,f_4\\}$$$ is the largest organized subset that contains $$$f_1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\{f_1,f_2\\}$$$ is the largest organized subset that contains $$$f_2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\{f_1,f_3,f_4\\}$$$ is the largest organized subset that contains $$$f_3$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$\\{f_1,f_3,f_4\\}$$$ is the largest organized subset that contains $$$f_4$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"2195F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2195/problem/F"}