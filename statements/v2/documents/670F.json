{"assets":[],"contentKind":"statement","contestId":"670","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Restore a Number"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya decided to pass a very large integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" to Kate. First, he wrote that number as a string, then he appended to the right integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of digits in "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Magically, all the numbers were shuffled in arbitrary order while this note was passed to Kate. The only thing that Vasya remembers, is a non-empty substring of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" (a substring of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is a sequence of consecutive digits of the number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya knows that there may be more than one way to restore the number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Your task is to find the smallest possible initial integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Note that decimal representation of number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" contained no leading zeroes, except the case the integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" was equal to zero itself (in this case a single digit "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" was used)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains the string received by Kate. The number of digits in this string does not exceed "},{"kind":"math_inline","text":"1 000 000"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the substring of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" which Vasya remembers. This string can contain leading zeroes. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the input data is correct, and the answer always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the smalles integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" which Vasya could pass to Kate."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"003512\n021\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"30021\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"199966633300\n63\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3036366999\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"670F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/670/problem/F"}