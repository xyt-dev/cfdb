{"assets":[],"contentKind":"statement","contestId":"1968","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Maximize?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an integer $$$x$$$. Your task is to find any integer $$$y$$$ $$$(1\\le y \\lt x)$$$ such that $$$\\gcd(x,y)+y$$$ is maximum possible."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note that if there is more than one $$$y$$$ which satisfies the statement, you are allowed to find any."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\gcd(a,b)$$$ is the Greatest Common Divisor of $$$a$$$ and $$$b$$$. For example, $$$\\gcd(6,4)=2$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following $$$t$$$ lines contains a single integer $$$x$$$ ($$$2 \\le x \\le 1000$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output any $$$y$$$ ($$$1 \\le y \\lt x$$$), which satisfies the statement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n10\n7\n21\n100\n2\n1000\n6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n6\n18\n98\n1\n750\n3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1968A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1968/problem/A"}