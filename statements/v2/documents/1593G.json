{"assets":[],"contentKind":"statement","contestId":"1593","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Changing Brackets"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A sequence of round and square brackets is given. You can change the sequence by performing the following operations:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" change the direction of a bracket from opening to closing and vice versa without changing the form of the bracket: i.e. you can change '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"'; you can change '"},{"children":[{"kind":"text","text":"["}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"]"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"]"}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"["}],"kind":"container"},{"kind":"text","text":"'. The operation costs $$$0$$$ burles."}],"kind":"list_item"},{"children":[{"kind":"text","text":" change any "},{"children":[{"kind":"text","text":"square"}],"kind":"container"},{"kind":"text","text":" bracket to "},{"children":[{"kind":"text","text":"round"}],"kind":"container"},{"kind":"text","text":" bracket having the same direction: i.e. you can change '"},{"children":[{"kind":"text","text":"["}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' but "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" from '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"["}],"kind":"container"},{"kind":"text","text":"'; similarly, you can change '"},{"children":[{"kind":"text","text":"]"}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"' but "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" from '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"' to '"},{"children":[{"kind":"text","text":"]"}],"kind":"container"},{"kind":"text","text":"'. The operation costs $$$1$$$ burle. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The operations can be performed in any order any number of times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string $$$s$$$ of the length $$$n$$$ and $$$q$$$ queries of the type \""},{"children":[{"kind":"text","text":"l r"}],"kind":"container"},{"kind":"text","text":"\" where $$$1 \\le l \\lt r \\le n$$$. For every substring $$$s[l \\dots r]$$$, find the minimum cost to pay to make it a correct bracket sequence. It is guaranteed that the substring $$$s[l \\dots r]$$$ has an even length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The queries must be processed independently, i.e. the changes made in the string for the answer to a question $$$i$$$ don't affect the queries $$$j$$$ ($$$j \\gt i$$$). In other words, for every query, the substring $$$s[l \\dots r]$$$ is given from the initially given string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A correct bracket sequence is a sequence that can be built according the following rules:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" an empty sequence is a correct bracket sequence; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if \""},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":"\" is a correct bracket sequence, the sequences \""},{"children":[{"kind":"text","text":"(s)"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"[s]"}],"kind":"container"},{"kind":"text","text":"\" are correct bracket sequences. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if \""},{"children":[{"kind":"text","text":"s"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"t"}],"kind":"container"},{"kind":"text","text":"\" are correct bracket sequences, the sequence \""},{"children":[{"kind":"text","text":"st"}],"kind":"container"},{"kind":"text","text":"\" (the concatenation of the sequences) is a correct bracket sequence. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"E.g. the sequences \""},{"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"(()[])"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"[()()]()"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(())()"}],"kind":"container"},{"kind":"text","text":"\" are correct bracket sequences whereas \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"[(])"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")))"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 100$$$) — the number of test cases. Then $$$t$$$ test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each test case, the first line contains a non-empty string $$$s$$$ containing only round ('"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"') and square ('"},{"children":[{"kind":"text","text":"["}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"]"}],"kind":"container"},{"kind":"text","text":"') brackets. The length of the string doesn't exceed $$$10^6$$$. The string contains at least $$$2$$$ characters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains one integer $$$q$$$ ($$$1 \\le q \\le 2 \\cdot 10^5$$$) — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$q$$$ lines follow, each of them contains two integers $$$l$$$ and $$$r$$$ ($$$1 \\le l \\lt r \\le n$$$ where $$$n$$$ is the length of $$$s$$$). It is guaranteed that the substring $$$s[l \\dots r]$$$ has even length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of the lengths of all strings given in all test cases doesn't exceed $$$10^6$$$. The sum of all $$$q$$$ given in all test cases doesn't exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case output in a separate line for each query one integer $$$x$$$ ($$$x \\ge 0$$$) — the minimum cost to pay to make the given substring a correct bracket sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n([))[)()][]]\n3\n1 12\n4 9\n3 6\n))))))\n2\n2 3\n1 4\n[]\n1\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n2\n1\n0\n0\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first test case. The first query describes the whole given string, the string can be turned into the following correct bracket sequence: \""},{"children":[{"kind":"text","text":"([()])()[[]]"}],"kind":"container"},{"kind":"text","text":"\". The forms of the brackets aren't changed so the cost of changing is $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second query describes the substring \""},{"children":[{"kind":"text","text":")[)()]"}],"kind":"container"},{"kind":"text","text":"\". It may be turned into \""},{"children":[{"kind":"text","text":"(()())"}],"kind":"container"},{"kind":"text","text":"\", the cost is equal to $$$2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third query describes the substring \""},{"children":[{"kind":"text","text":"))[)"}],"kind":"container"},{"kind":"text","text":"\". It may be turned into \""},{"children":[{"kind":"text","text":"()()"}],"kind":"container"},{"kind":"text","text":"\", the cost is equal to $$$1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The substrings of the second test case contain only round brackets. It's possible to prove that any sequence of round brackets having an even length may be turned into a correct bracket sequence for the cost of $$$0$$$ burles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, the single query describes the string \""},{"children":[{"kind":"text","text":"[]"}],"kind":"container"},{"kind":"text","text":"\" that is already a correct bracket sequence."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"1593G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1593/problem/G"}