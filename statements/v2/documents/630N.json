{"assets":[],"contentKind":"statement","contestId":"630","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"N. Forecast"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"0.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Department of economic development of IT City created a model of city development till year 2100."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To prepare report about growth perspectives it is required to get growth estimates from the model."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To get the growth estimates it is required to solve a quadratic equation. Since the Department of economic development of IT City creates realistic models only, that quadratic equation has a solution, moreover there are exactly two different real roots."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The greater of these roots corresponds to the optimistic scenario, the smaller one corresponds to the pessimistic one. Help to get these estimates, first the optimistic, then the pessimistic one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains three integers "},{"kind":"math_inline","text":"a, b, c"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 1000 ≤ a, b, c ≤ 1000"},{"kind":"text","text":") — the coefficients of "},{"kind":"math_inline","text":"ax2 + bx + c = 0"},{"kind":"text","text":" equation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line output the greater of the equation roots, in the second line output the smaller one. Absolute or relative error should not be greater than "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 30 200\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-10.000000000000000\n-20.000000000000000"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"N","problemCode":"630N","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/630/problem/N"}