{"assets":[],"contentKind":"statement","contestId":"1017","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. The Neutral Zone"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"16 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Notice: unusual memory limit!"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the war, destroyed cities in the neutral zone were restored. And children went back to school."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The war changed the world, as well as education. In those hard days, a new math concept was created."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As we all know, logarithm function can be described as: $$$$$$ \\log(p_1^{a_1}p_2^{a_2}...p_k^{a_2}) = a_1 \\log p_1 + a_2 \\log p_2 + ... + a_k \\log p_k $$$$$$ Where $$$p_1^{a_1}p_2^{a_2}...p_k^{a_2}$$$ is the prime factorization of a integer. A problem is that the function uses itself in the definition. That is why it is hard to calculate."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, the mathematicians from the neutral zone invented this: $$$$$$ \\text{exlog}_f(p_1^{a_1}p_2^{a_2}...p_k^{a_2}) = a_1 f(p_1) + a_2 f(p_2) + ... + a_k f(p_k) $$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Notice that $$$\\text{exlog}_f(1)$$$ is always equal to $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"This concept for any function $$$f$$$ was too hard for children. So teachers told them that $$$f$$$ can only be a polynomial of degree no more than $$$3$$$ in daily uses (i.e., $$$f(x) = Ax^3+Bx^2+Cx+D$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"\"Class is over! Don't forget to do your homework!\" Here it is: $$$$$$ \\sum_{i=1}^n \\text{exlog}_f(i) $$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help children to do their homework. Since the value can be very big, you need to find the answer modulo $$$2^{32}$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains five integers $$$n$$$, $$$A$$$, $$$B$$$, $$$C$$$, and $$$D$$$ ($$$1 \\le n \\le 3 \\cdot 10^8$$$, $$$0 \\le A,B,C,D \\le 10^6$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the answer modulo $$$2^{32}$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"12 0 0 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"63\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1 2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"136\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{exlog}_f(1) = 0$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{exlog}_f(2) = 2$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{exlog}_f(3) = 3$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{exlog}_f(4) = 2 + 2 = 4$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{exlog}_f(5) = 5$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{exlog}_f(6) = 2 + 3 = 5$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{exlog}_f(7) = 7$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{exlog}_f(8) = 2 + 2 + 2 = 6$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{exlog}_f(9) = 3 + 3 = 6$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{exlog}_f(10) = 2 + 5 = 7$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{exlog}_f(11) = 11$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{exlog}_f(12) = 2 + 2 + 3 = 7$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$ \\sum_{i=1}^{12} \\text{exlog}_f(i)=63 $$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{exlog}_f(1) = 0$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{exlog}_f(2) = (1 \\times 2^3 + 2 \\times 2^2 + 3 \\times 2 + 4) = 26$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{exlog}_f(3) = (1 \\times 3^3 + 2 \\times 3^2 + 3 \\times 3 + 4) = 58$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\text{exlog}_f(4) = 2 \\times \\text{exlog}_f(2) = 52$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$ \\sum_{i=1}^4 \\text{exlog}_f(i)=0+26+58+52=136 $$$"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1017F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1017/problem/F"}