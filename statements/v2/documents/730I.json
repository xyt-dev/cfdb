{"assets":[],"contentKind":"statement","contestId":"730","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"I. Olympiad in Programming and Sports"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students at Berland State University. Every student has two skills, each measured as a number: "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" — the programming skill and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" — the sports skill."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is announced that an Olympiad in programming and sports will be held soon. That's why Berland State University should choose two teams: one to take part in the programming track and one to take part in the sports track."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There should be exactly "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" students in the programming team and exactly "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" students in the sports team. A student can't be a member of both teams."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The university management considers that the strength of the university on the Olympiad is equal to the sum of two values: the programming team strength and the sports team strength. The strength of a team is the sum of skills of its members in the corresponding area, so the strength of the programming team is the sum of all "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and the strength of the sports team is the sum of all "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" over corresponding team members."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Berland State University to compose two teams to maximize the total strength of the university on the Olympiad."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three positive integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 3000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p + s ≤ n"},{"kind":"text","text":") — the number of students, the size of the programming team and the size of the sports team."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 3000"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the programming skill of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th student."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ 3000"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" is the sports skill of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th student."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, print the the maximum strength of the university on the Olympiad. In the second line, print "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" numbers — the members of the programming team. In the third line, print "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" numbers — the members of the sports team."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The students are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" as they are given in the input. All numbers printed in the second and in the third lines should be distinct and can be printed in arbitrary order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 2\n1 3 4 5 2\n5 3 2 1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"18\n3 4 \n1 5 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 2\n10 8 8 3\n10 7 9 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"31\n1 2 \n3 4 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3 1\n5 2 5 1 7\n6 3 1 6 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"23\n1 3 5 \n4 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"I","problemCode":"730I","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/730/problem/I"}