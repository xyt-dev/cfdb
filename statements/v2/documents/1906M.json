{"assets":["/statement-assets/afdd603bbc7d6f1cadca2883fe03b8e885f049867b4f6d16cd0f0a003b5e12bd.png","/statement-assets/b6b28572f4140eced1fd871c1a6c50957cf27b2988cad0dd888b2ab04e21c706.png","/statement-assets/dab1d8ca008c94de33d79d6e13ecde0a695ab23ad1c4afe4f0154fa6a9c6da4a.png"],"contentKind":"statement","contestId":"1906","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"M. Triangle Construction"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a regular $$$N$$$-sided polygon. Label one arbitrary side as side $$$1$$$, then label the next sides in clockwise order as side $$$2$$$, $$$3$$$, $$$\\dots$$$, $$$N$$$. There are $$$A_i$$$ special points on side $$$i$$$. These points are positioned such that side $$$i$$$ is divided into $$$A_i + 1$$$ segments with equal length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For instance, suppose that you have a regular $$$4$$$-sided polygon, i.e., a square. The following illustration shows how the special points are located within each side when $$$A = [3, 1, 4, 6]$$$. The uppermost side is labelled as side $$$1$$$."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/afdd603bbc7d6f1cadca2883fe03b8e885f049867b4f6d16cd0f0a003b5e12bd.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"You want to create as many "},{"children":[{"kind":"text","text":"non-degenerate triangles"}],"kind":"container"},{"kind":"text","text":" as possible while satisfying the following requirements. Each triangle consists of $$$3$$$ distinct special points (not necessarily from different sides) as its corners. Each special point can only become the corner of at most $$$1$$$ triangle. All triangles must not intersect with each other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the maximum number of non-degenerate triangles that you can create."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A triangle is "},{"children":[{"kind":"text","text":"non-degenerate"}],"kind":"container"},{"kind":"text","text":" if it has a positive area."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line consists of an integer $$$N$$$ ($$$3 \\leq N \\leq 200\\,000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following line consists of $$$N$$$ integers $$$A_i$$$ ($$$1 \\leq A_i \\leq 2 \\cdot 10^9$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer representing the maximum number of non-degenerate triangles that you can create."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n3 1 4 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n1 2 1 2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Explanation for the sample input/output #1"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One possible construction which achieves maximum number of non-degenerate triangles can be seen in the following illustration. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b6b28572f4140eced1fd871c1a6c50957cf27b2988cad0dd888b2ab04e21c706.png"},"kind":"image"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"Explanation for the sample input/output #2"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One possible construction which achieves maximum number of non-degenerate triangles can be seen in the following illustration. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/dab1d8ca008c94de33d79d6e13ecde0a695ab23ad1c4afe4f0154fa6a9c6da4a.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"M","problemCode":"1906M","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1906/problem/M"}