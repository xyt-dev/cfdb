{"assets":[],"contentKind":"statement","contestId":"846","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Chemistry in Berland"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Igor is a post-graduate student of chemistry faculty in Berland State University (BerSU). He needs to conduct a complicated experiment to write his thesis, but laboratory of BerSU doesn't contain all the materials required for this experiment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Fortunately, chemical laws allow material transformations (yes, chemistry in Berland differs from ours). But the rules of transformation are a bit strange."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Berland chemists are aware of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" materials, numbered in the order they were discovered. Each material can be transformed into some other material (or vice versa). Formally, for each "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(2 ≤ i ≤ n)"},{"kind":"text","text":" there exist two numbers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" that denote a possible transformation: "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" kilograms of material "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" can be transformed into "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" kilogram of material "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" kilogram of material "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" can be transformed into "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" kilogram of material "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". Chemical processing equipment in BerSU allows only such transformation that the amount of resulting material is "},{"children":[{"kind":"text","text":"always an integer number of kilograms"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":") Igor knows that the experiment requires "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" kilograms of material "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", and the laboratory contains "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" kilograms of this material. Is it possible to conduct an experiment after transforming some materials (or none)?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of materials discovered by Berland chemists."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"b1, b2... bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ 1012"},{"kind":"text","text":") — supplies of BerSU laboratory."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"a1, a2... an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 1012"},{"kind":"text","text":") — the amounts required for the experiment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines follow. "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th of them contains two numbers "},{"kind":"math_inline","text":"xj + 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"kj + 1"},{"kind":"text","text":" that denote transformation of "},{"kind":"math_inline","text":"(j + 1)"},{"kind":"text","text":"-th material ("},{"kind":"math_inline","text":"1 ≤ xj + 1 ≤ j, 1 ≤ kj + 1 ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" if it is possible to conduct an experiment. Otherwise print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n3 2 1\n1 1\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 2 1\n1 2 3\n1 1\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"846E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/846/problem/E"}