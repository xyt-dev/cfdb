{"assets":[],"contentKind":"statement","contestId":"813","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Two Melodies"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Alice is a beginner composer and now she is ready to create another masterpiece. And not even the single one but two at the same time! "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Alice has a sheet with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" notes written on it. She wants to take two such non-empty non-intersecting subsequences that both of them form a "},{"children":[{"kind":"text","text":"melody"}],"kind":"container"},{"kind":"text","text":" and sum of their lengths is maximal."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Subsequence is a sequence that can be derived from another sequence by deleting some elements without changing the order of the remaining elements."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Subsequence forms a melody when each two adjacent notes either differs by "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" or are congruent modulo "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You should write a program which will calculate maximum sum of lengths of such two non-empty non-intersecting subsequences that both of them form a melody."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 5000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 105"},{"kind":"text","text":") — notes written on a sheet."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print maximum sum of lengths of such two non-empty non-intersecting subsequences that both of them form a melody."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n62 22 60 61 48 49\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example subsequences "},{"kind":"math_inline","text":"[1, 2]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"[4, 5]"},{"kind":"text","text":" give length "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" in total."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example subsequences "},{"kind":"math_inline","text":"[62, 48, 49]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"[60, 61]"},{"kind":"text","text":" give length "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":" in total. If you choose subsequence "},{"kind":"math_inline","text":"[62, 61]"},{"kind":"text","text":" in the first place then the second melody will have maximum length "},{"children":[{"kind":"text","text":"2"}],"kind":"container"},{"kind":"text","text":", that gives the result of "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":", which is not maximal."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"813D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/813/problem/D"}