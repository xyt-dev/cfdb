{"assets":[],"contentKind":"statement","contestId":"413","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Spyke Chatting"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The R2 company has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" employees working for it. The work involves constant exchange of ideas, sharing the stories of success and upcoming challenging. For that, R2 uses a famous instant messaging program Spyke."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"R2 has "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" Spyke chats just to discuss all sorts of issues. In each chat, some group of employees exchanges messages daily. An employee can simultaneously talk in multiple chats. If some employee is in the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th chat, he can write messages to this chat and receive notifications about messages from this chat. If an employee writes a message in the chat, all other participants of the chat receive a message notification."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The R2 company is conducting an audit. Now the specialists study effective communication between the employees. For this purpose, they have a chat log and the description of chat structure. You, as one of audit specialists, are commissioned to write a program that will use this data to determine the total number of message notifications received by each employee."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(2 ≤ n ≤ 2·104; 1 ≤ m ≤ 10; 1 ≤ k ≤ 2·105)"},{"kind":"text","text":" — the number of the employees, the number of chats and the number of events in the log, correspondingly. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain matrix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":", consisting of numbers zero and one. The element of this matrix, recorded in the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line, (let's denote it as "},{"kind":"math_inline","text":"aij"},{"kind":"text","text":") equals "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th employee is the participant of the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th chat, otherwise the element equals "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". Assume that the employees are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and the chats are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contain the description of the log events. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two space-separated integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"math_inline","text":"(1 ≤ xi ≤ n; 1 ≤ yi ≤ m)"},{"kind":"text","text":" which mean that the employee number "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" sent one message to chat number "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":". It is guaranteed that employee number "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" is a participant of chat "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":". It is guaranteed that each chat contains at least two employees."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print in the single line "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers, where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th integer shows the number of message notifications the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th employee receives."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4 5\n1 1 1 1\n1 0 1 1\n1 1 0 0\n1 1\n3 1\n1 3\n2 4\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 3 1 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 4\n0 1 1\n1 0 1\n1 1 1\n0 0 0\n1 2\n2 1\n3 1\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 2 3 0 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"413B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/413/problem/B"}