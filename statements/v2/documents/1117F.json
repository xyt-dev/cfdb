{"assets":[],"contentKind":"statement","contestId":"1117","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Crisp String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string of length $$$n$$$. Each character is one of the first $$$p$$$ lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are also given a matrix $$$A$$$ with binary values of size $$$p \\times p$$$. This matrix is symmetric ($$$A_{ij} = A_{ji}$$$). $$$A_{ij} = 1$$$ means that the string can have the $$$i$$$-th and $$$j$$$-th letters of Latin alphabet adjacent."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call the string "},{"children":[{"kind":"text","text":"crisp"}],"kind":"container"},{"kind":"text","text":" if "},{"children":[{"kind":"text","text":"all of the adjacent characters"}],"kind":"container"},{"kind":"text","text":" in it can be adjacent (have 1 in the corresponding cell of matrix $$$A$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are allowed to do the following move. Choose any letter, remove "},{"children":[{"kind":"text","text":"all its occurrences"}],"kind":"container"},{"kind":"text","text":" and join the remaining parts of the string without changing their order. For example, removing letter 'a' from \"abacaba\" will yield \"bcb\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The string you are given is "},{"children":[{"kind":"text","text":"crisp"}],"kind":"container"},{"kind":"text","text":". The string should remain "},{"children":[{"kind":"text","text":"crisp"}],"kind":"container"},{"children":[{"kind":"text","text":"after every move you make"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are allowed to do arbitrary number of moves (possible zero). What is the shortest resulting string you can obtain?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$p$$$ ($$$1 \\le n \\le 10^5$$$, $$$1 \\le p \\le 17$$$) — the length of the initial string and the length of the allowed prefix of Latin alphabet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the initial string. It is guaranteed that it contains only first $$$p$$$ lowercase Latin letters and that is it "},{"children":[{"kind":"text","text":"crisp"}],"kind":"container"},{"kind":"text","text":". Some of these $$$p$$$ first Latin letters might not be present in the string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$p$$$ lines contains $$$p$$$ integer numbers — the matrix $$$A$$$ ($$$0 \\le A_{ij} \\le 1$$$, $$$A_{ij} = A_{ji}$$$). $$$A_{ij} = 1$$$ means that the string can have the $$$i$$$-th and $$$j$$$-th letters of Latin alphabet adjacent."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the length of the shortest string after you make arbitrary number of moves (possible zero)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7 3\nabacaba\n0 1 1\n1 0 0\n1 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7 3\nabacaba\n1 1 1\n1 0 0\n1 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7 4\nbacadab\n0 1 1 1\n1 0 0 0\n1 0 0 0\n1 0 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 3\ncbc\n0 0 0\n0 0 1\n0 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example no letter can be removed from the initial string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example you can remove letters in order: 'b', 'c', 'a'. The strings on the intermediate steps will be: \"abacaba\" $$$\\rightarrow$$$ \"aacaa\" $$$\\rightarrow$$$ \"aaaa\" $$$\\rightarrow$$$ \"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example you can remove letter 'b' and that's it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example you can remove letters in order 'c', 'b', but not in the order 'b', 'c' because two letters 'c' can't be adjacent."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1117F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1117/problem/F"}