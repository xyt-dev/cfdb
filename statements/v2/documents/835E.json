{"assets":["/statement-assets/a5f2995c9a7202975e4664399d2ead51b2a9b9aefedf2652fd187ff84d252503.png"],"contentKind":"statement","contestId":"835","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. The penguin's game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Pay attention: this problem is interactive."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Penguin Xoriy came up with a new game recently. He has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" icicles numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Each icicle has a temperature — an integer from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"109"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"Exactly two"}],"kind":"container"},{"kind":"text","text":" of these icicles are special: their temperature is "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", while a temperature of all the others is "},{"kind":"math_inline","text":"x ≠ y"},{"kind":"text","text":". You have to find those special icicles. You can choose a "},{"children":[{"kind":"text","text":"non-empty"}],"kind":"container"},{"kind":"text","text":" subset of icicles and ask the penguin what is the bitwise exclusive OR ("},{"children":[{"kind":"text","text":"XOR"}],"kind":"container"},{"kind":"text","text":") of the temperatures of the icicles in this subset. Note that you can't ask more than "},{"children":[{"kind":"text","text":"19"}],"kind":"container"},{"kind":"text","text":" questions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are to find the special icicles."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 1000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ x, y ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x ≠ y"},{"kind":"text","text":") — the number of icicles, the temperature of non-special icicles and the temperature of the special icicles."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"To give your answer to the penguin you have to print character \"!\" (without quotes), then print two integers "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"p1 < p2"},{"kind":"text","text":") — the indexes of the special icicles "},{"children":[{"kind":"text","text":"in ascending order"}],"kind":"container"},{"kind":"text","text":". Note that \"!\" and "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":" should be separated by a space; the indexes should be separated by a space too. After you gave the answer your program should terminate immediately."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom","title":"Interaction"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Interaction"}],"kind":"heading"},{"children":[{"kind":"text","text":"To ask a question print character \"?\" (without quotes), an integer "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ c ≤ n"},{"kind":"text","text":"), and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"pc"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":") — the indexes of icicles that you want to know about. Note that \"?\" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" should be separated by a space; the indexes should be separated by a space too."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After you asked the question, read a single integer — the answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that you can't ask more than "},{"children":[{"kind":"text","text":"19"}],"kind":"container"},{"kind":"text","text":" questions. If you ask more than 19 questions or at least one incorrect question, your solution will get \""},{"children":[{"kind":"text","text":"Wrong answer"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If at some moment your program reads "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":" as an answer, it should immediately exit (for example, by calling exit(0)). You will get \""},{"children":[{"kind":"text","text":"Wrong answer"}],"kind":"container"},{"kind":"text","text":"\" in this case, it means that you asked more than 19 questions, or asked an invalid question. If you ignore this, you can get other verdicts since your program will continue to read from a closed stream."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your solution will get \""},{"children":[{"kind":"text","text":"Idleness Limit Exceeded"}],"kind":"container"},{"kind":"text","text":"\", if you don't print anything or forget to flush the output, including for the final answer ."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To flush you can use (just after printing): "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"fflush(stdout)"}],"kind":"container"},{"kind":"text","text":" in C++; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"System.out.flush()"}],"kind":"container"},{"kind":"text","text":" in Java; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"stdout.flush()"}],"kind":"container"},{"kind":"text","text":" in Python; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"flush(output)"}],"kind":"container"},{"kind":"text","text":" in Pascal; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For other languages see the documentation. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"Hacking"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For hacking use the following format:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"y"},{"kind":"math_inline","text":"p1"},{"kind":"math_inline","text":"p2"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here "},{"kind":"math_inline","text":"1 ≤ p1 < p2 ≤ n"},{"kind":"text","text":" are the indexes of the special icicles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Contestant programs will not be able to see this input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 1\n2\n1\n1"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"? 3 1 2 3\n? 1 1\n? 1 3\n! 1 3"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The answer for the first question is "},{"attrs":{"alt":"","src":"/statement-assets/a5f2995c9a7202975e4664399d2ead51b2a9b9aefedf2652fd187ff84d252503.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer for the second and the third questions is 1, therefore, special icicles are indexes 1 and 3."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can read more about bitwise "},{"children":[{"kind":"text","text":"XOR"}],"kind":"container"},{"kind":"text","text":" operation here: "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"835E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/835/problem/E"}