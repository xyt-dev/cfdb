{"assets":[],"contentKind":"statement","contestId":"1852","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Rivalries"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ntarsis has an array $$$a$$$ of length $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"power"}],"kind":"container"},{"kind":"text","text":" of a subarray $$$a_l \\dots a_r$$$ ($$$1 \\leq l \\leq r \\leq n$$$) is defined as: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The largest value $$$x$$$ such that $$$a_l \\dots a_r$$$ contains $$$x$$$ and neither $$$a_1 \\dots a_{l-1}$$$ nor $$$a_{r+1} \\dots a_n$$$ contains $$$x$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If no such $$$x$$$ exists, the power is $$$0$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Call an array $$$b$$$ a "},{"children":[{"kind":"text","text":"rival"}],"kind":"container"},{"kind":"text","text":" to $$$a$$$ if the following holds: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The length of both $$$a$$$ and $$$b$$$ are equal to some $$$n$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Over all $$$l, r$$$ where $$$1 \\leq l \\leq r \\leq n$$$, the power of $$$a_l \\dots a_r$$$ equals the power of $$$b_l \\dots b_r$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The elements of $$$b$$$ are positive. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Ntarsis wants you to find a rival $$$b$$$ to $$$a$$$ such that the sum of $$$b_i$$$ over $$$1 \\leq i \\leq n$$$ is maximized. Help him with this task!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^5$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case has a single integer $$$n$$$ ($$$1 \\leq n \\leq 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\leq a_i \\leq 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ across all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output $$$n$$$ integers $$$b_1, b_2, \\ldots, b_n$$$ — a valid rival to $$$a$$$ such that $$$b_1 + b_2 + \\cdots + b_n$$$ is maximal. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there exist multiple rivals with the maximum sum, output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n5\n1 4 1 3 3\n5\n1 4 1 8 8\n5\n2 1 1 1 2\n8\n3 2 3 5 2 2 5 3\n8\n1 1 1 1 4 3 3 3\n10\n1 9 5 9 8 1 5 8 9 1\n16\n1 1 1 1 5 5 5 5 9 9 9 9 7 7 7 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2 4 2 3 3\n3 4 3 8 8\n2 1 2 1 2\n4 2 4 5 5 2 5 4\n1 2 2 1 4 3 2 3\n7 9 5 9 8 9 5 8 9 7\n1 8 8 1 5 8 8 5 9 9 9 9 7 8 8 7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first test case, one rival with the maximal sum is $$$[2, 4, 2, 3, 3]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$[2, 4, 2, 3, 3]$$$ can be shown to be a rival to $$$[1, 4, 1, 3, 3]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All possible subarrays of $$$a$$$ and $$$b$$$ and their corresponding powers are listed below: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The power of $$$a[1:1] = [1] = 0$$$, the power of $$$b[1:1] = [2] = 0$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The power of $$$a[1:2] = [1, 4] = 4$$$, the power of $$$b[1:2] = [2, 4] = 4$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The power of $$$a[1:3] = [1, 4, 1] = 4$$$, the power of $$$b[1:3] = [2, 4, 2] = 4$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The power of $$$a[1:4] = [1, 4, 1, 3] = 4$$$, the power of $$$b[1:4] = [2, 4, 2, 3] = 4$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The power of $$$a[1:5] = [1, 4, 1, 3, 3] = 4$$$, the power of $$$b[1:5] = [2, 4, 2, 3, 3] = 4$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The power of $$$a[2:2] = [4] = 4$$$, the power of $$$b[2:2] = [4] = 4$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The power of $$$a[2:3] = [4, 1] = 4$$$, the power of $$$b[2:3] = [4, 2] = 4$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The power of $$$a[2:4] = [4, 1, 3] = 4$$$, the power of $$$b[2:4] = [4, 2, 3] = 4$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The power of $$$a[2:5] = [4, 1, 3, 3] = 4$$$, the power of $$$b[2:5] = [4, 2, 3, 3] = 4$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The power of $$$a[3:3] = [1] = 0$$$, the power of $$$b[3:3] = [2] = 0$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The power of $$$a[3:4] = [1, 3] = 0$$$, the power of $$$b[3:4] = [2, 3] = 0$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The power of $$$a[3:5] = [1, 3, 3] = 3$$$, the power of $$$b[3:5] = [2, 3, 3] = 3$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The power of $$$a[4:4] = [3] = 0$$$, the power of $$$b[4:4] = [3] = 0$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The power of $$$a[4:5] = [3, 3] = 3$$$, the power of $$$b[4:5] = [3, 3] = 3$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The power of $$$a[5:5] = [3] = 0$$$, the power of $$$b[5:5] = [3] = 0$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It can be shown there exists no rival with a greater sum than $$$2 + 4 + 2 + 3 + 3 = 14$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1852E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1852/problem/E"}