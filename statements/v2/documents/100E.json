{"assets":[],"contentKind":"statement","contestId":"100","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Lamps in a Line"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lamps in a line. The lamps are numbered "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right. There are also "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" keys. When key number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is pressed, all lamps number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"i|x"},{"kind":"text","text":" change their state."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For two integer numbers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", we say "},{"kind":"math_inline","text":"a|b"},{"kind":"text","text":" if and only if there exists an integer "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"a × c = b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Amirali likes to play with the keys. He randomly pressed "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" keys and wants to know the final state of the lamps. Help him by writing a "},{"children":[{"kind":"text","text":"Pike"}],"kind":"container"},{"kind":"text","text":" piece of code to solve this task."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", the number of lamps ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" words. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th word describes the initial state of lamp number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" (see samples for details)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following line contains a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 104"},{"kind":"text","text":"), the number of times a key is pressed. Then in the next line come "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers in range "},{"kind":"math_inline","text":"[1, n]"},{"kind":"text","text":" which are the numbers of the pressed keys."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Write "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" words to output. Describe the final state of the lamps. See samples for more details."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sam