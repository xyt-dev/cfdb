{"assets":[],"contentKind":"statement","contestId":"440","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Berland Federalization"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recently, Berland faces federalization requests more and more often. The proponents propose to divide the country into separate states. Moreover, they demand that there is a state which includes exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" towns."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Currently, Berland has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" towns, some pairs of them are connected by bilateral roads. Berland has only "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" roads. You can reach any city from the capital, that is, the road network forms a "},{"children":[{"kind":"text","text":"tree"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The Ministry of Roads fears that after the reform those roads that will connect the towns of different states will bring a lot of trouble."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to come up with a plan to divide the country into states such that:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" each state is connected, i.e. for each state it is possible to get from any town to any other using its roads (that is, the roads that connect the state towns), "}],"kind":"list_item"},{"children":[{"kind":"text","text":" there is a state that consisted of exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" cities, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the number of roads that connect different states is minimum. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 400"},{"kind":"text","text":"). Then follow "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines, each of them describes a road in Berland. The roads are given as pairs of integers "},{"kind":"math_inline","text":"xi, yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ n; xi ≠ yi"},{"kind":"text","text":") — the numbers of towns connected by the road. Assume that the towns are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The the first line print the required minimum number of \"problem\" roads "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Then print a sequence of "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" integers — their indices in the found division. The roads are numbered starting from 1 in the order they follow in the input. If there are multiple possible solutions, print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the solution shows that there are no \"problem\" roads at all, print a single integer "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and either leave the second line empty or do not print it at all."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n1 2\n2 3\n3 4\n4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n1 2\n1 3\n1 4\n1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n3 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"440D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/440/problem/D"}