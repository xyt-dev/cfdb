{"assets":[],"contentKind":"statement","contestId":"648","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Собачки и миски"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"ограничение по времени на тест"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 секунды"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"ограничение по памяти на тест"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 мегабайт"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"На координатной прямой сидит "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" собачек, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-я собачка находится в точке "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". Кроме того, на прямой есть "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" мисок с едой, для каждой известна её координата на прямой "},{"kind":"math_inline","text":"uj"},{"kind":"text","text":" и время "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":", через которое еда в миске остынет и станет невкусной. Это значит, что если собачка прибежит к миске в момент времени, строго больший "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":", то еда уже остынет, и собачка кушать её не станет."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Считая, что каждая собачка бежит со скоростью "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", найдите максимальное количество собачек, которые смогут покушать. Считайте, что собачки побегут к тем мискам, на которые вы им укажете. Из одной миски не могут кушать две или более собачки."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Собачки могут обгонять друг друга, то есть, если одна из них остановится покушать, другая может пройти мимо неё, чтобы попасть к другой миске."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Входные данные"}],"kind":"heading"},{"children":[{"kind":"text","text":"В первой строке находится пара целых чисел "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" и "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 200 000"},{"kind":"text","text":") — количество собачек и мисок соответственно."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Во второй строке находятся "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" целых чисел "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ xi ≤ 109"},{"kind":"text","text":") — координата "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-й собачки."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"В следующих "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" строках находятся пары целых чисел "},{"kind":"math_inline","text":"uj"},{"kind":"text","text":" и "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ uj ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ tj ≤ 109"},{"kind":"text","text":") — координата "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-й миски и время, когда остынет еда в ней, соответственно."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Гарантируется, что никакие две собачки не находятся в одной точке. Никакие две миски также не могут находиться в одной точке."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Выходные данные"}],"kind":"heading"},{"children":[{"kind":"text","text":"Выведите одно целое число "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" — максимальное количество собачек, которые смогут покушать."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Примеры"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Входные данные"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n-2 0 4 8 13\n-1 1\n4 3\n6 3\n11 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Выходные данные"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Входные данные"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n-1 3 7\n1 1\n4 1\n7 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Выходные данные"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Входные данные"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n20 1 10 30\n1 1\n2 5\n22 2\n40 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Выходные данные"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Примечание"}],"kind":"heading"},{"children":[{"kind":"text","text":"В первом примере первая собачка побежит направо к первой миске, третья собачка сразу начнёт есть из второй миски, четвёртая собачка побежит влево к третьей миске, а пятая собачка побежит влево к четвёртой миске."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"648D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/648/problem/D"}