{"assets":["/statement-assets/726a762c87090938e624c11be08cfb885d6e28ce1a6a31a5ae270bee8a70f048.png","/statement-assets/bae470416b2d4c1bdcca806a615bde794e912c8e8af4a13b097d9cad45e71c81.png","/statement-assets/4e3524f9122d2917cf4db006141b2a473dbe7d12c301fd2b32726a0b742a9e3d.png"],"contentKind":"statement","contestId":"959","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Mahmoud and Ehab and the xor-MST"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ehab is interested in the bitwise-xor operation and the special graphs. Mahmoud gave him a problem that combines both. He has a complete graph consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices numbered from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":". For all "},{"kind":"math_inline","text":"0 ≤ u < v < n"},{"kind":"text","text":", vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" are connected with an undirected edge that has weight "},{"attrs":{"alt":"","src":"/statement-assets/726a762c87090938e624c11be08cfb885d6e28ce1a6a31a5ae270bee8a70f048.png"},"kind":"image"},{"kind":"text","text":" (where "},{"attrs":{"alt":"","src":"/statement-assets/bae470416b2d4c1bdcca806a615bde794e912c8e8af4a13b097d9cad45e71c81.png"},"kind":"image"},{"kind":"text","text":" is the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise-xor operation"}],"kind":"link"},{"kind":"text","text":"). Can you find the weight of the minimum spanning tree of that graph?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can read about complete graphs in "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Complete_graph"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Complete_graph"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can read about the minimum spanning tree in "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Minimum_spanning_tree"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Minimum_spanning_tree"}],"kind":"link"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The weight of the minimum spanning tree is the sum of the weights on the edges included in it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(2 ≤ n ≤ 1012)"},{"kind":"text","text":", the number of vertices in the graph."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains an integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", the weight of the graph's minimum spanning tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample: "},{"attrs":{"alt":"","src":"/statement-assets/4e3524f9122d2917cf4db006141b2a473dbe7d12c301fd2b32726a0b742a9e3d.png"},"kind":"image"},{"kind":"text","text":" The weight of the minimum spanning tree is 1+2+1=4."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"959E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/959/problem/E"}