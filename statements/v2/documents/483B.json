{"assets":[],"contentKind":"statement","contestId":"483","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Friends and Presents"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have two friends. You want to present each of them several positive integers. You want to present "},{"kind":"math_inline","text":"cnt1"},{"kind":"text","text":" numbers to the first friend and "},{"kind":"math_inline","text":"cnt2"},{"kind":"text","text":" numbers to the second friend. Moreover, you want all presented numbers to be distinct, that also means that no number should be presented to both friends."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In addition, the first friend does not like the numbers that are divisible without remainder by prime number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". The second one does not like the numbers that are divisible without remainder by prime number "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". Of course, you're not going to present your friends numbers they don't like."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find such minimum number "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", that you can form presents using numbers from a set "},{"kind":"math_inline","text":"1, 2, ..., v"},{"kind":"text","text":". Of course you may choose not to present some numbers at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A positive integer number greater than 1 is called "},{"children":[{"kind":"text","text":"prime"}],"kind":"container"},{"kind":"text","text":" if it has no positive divisors other than 1 and itself."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains four positive integers "},{"kind":"math_inline","text":"cnt1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"cnt2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ cnt1, cnt2 < 109"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"cnt1 + cnt2 ≤ 109"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"2 ≤ x < y ≤ 3·104"},{"kind":"text","text":") — the numbers that are described in the statement. It is guaranteed that numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" are prime."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 3 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample you give the set of numbers "},{"kind":"math_inline","text":"{1, 3, 5}"},{"kind":"text","text":" to the first friend and the set of numbers "},{"kind":"math_inline","text":"{2}"},{"kind":"text","text":" to the second friend. Note that if you give set "},{"kind":"math_inline","text":"{1, 3, 5}"},{"kind":"text","text":" to the first friend, then we cannot give any of the numbers "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" to the second friend. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample you give the set of numbers "},{"kind":"math_inline","text":"{3}"},{"kind":"text","text":" to the first friend, and the set of numbers "},{"kind":"math_inline","text":"{1, 2, 4}"},{"kind":"text","text":" to the second friend. Thus, the answer to the problem is "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"483B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/483/problem/B"}