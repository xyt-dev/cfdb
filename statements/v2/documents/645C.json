{"assets":[],"contentKind":"statement","contestId":"645","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Enduring Exodus"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In an attempt to escape the Mischievous Mess Makers' antics, Farmer John has abandoned his farm and is traveling to the other side of Bovinia. During the journey, he and his "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" cows have decided to stay at the luxurious Grand Moo-dapest Hotel. The hotel consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rooms located in a row, some of which are occupied."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Farmer John wants to book a set of "},{"kind":"math_inline","text":"k + 1"},{"kind":"text","text":" currently unoccupied rooms for him and his cows. He wants his cows to stay as safe as possible, so he wishes to minimize the maximum distance from his room to the room of his cow. The distance between rooms "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" is defined as "},{"kind":"math_inline","text":"|j - i|"},{"kind":"text","text":". Help Farmer John protect his cows by calculating this minimum possible distance."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k < n ≤ 100 000"},{"kind":"text","text":") — the number of rooms in the hotel and the number of cows travelling with Farmer John."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" describing the rooms. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character of the string will be '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"' if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th room is free, and '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"' if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th room is occupied. It is guaranteed that at least "},{"kind":"math_inline","text":"k + 1"},{"kind":"text","text":" characters of this string are '"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"', so there exists at least one possible choice of "},{"kind":"math_inline","text":"k + 1"},{"kind":"text","text":" rooms for Farmer John and his cows to stay in."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum possible distance between Farmer John's room and his farthest cow."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 2\n0100100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1\n01010\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Farmer John can book room "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" for himself, and rooms "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" for his cows. The distance to the farthest cow is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Note that it is impossible to make this distance "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", as there is no block of three consecutive unoccupied rooms."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, Farmer John can book room "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" for himself and room "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" for his single cow. The distance between him and his cow is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, Farmer John books all three available rooms, taking the middle room for himself so that both cows are next to him. His distance from the farthest cow is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"645C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/645/problem/C"}