{"assets":[],"contentKind":"statement","contestId":"1492","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Maximum width"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Your classmate, whom you do not like because he is boring, but whom you respect for his intellect, has two strings: $$$s$$$ of length $$$n$$$ and $$$t$$$ of length $$$m$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A sequence $$$p_1, p_2, \\ldots, p_m$$$, where $$$1 \\leq p_1 \\lt p_2 \\lt \\ldots \\lt p_m \\leq n$$$, is called "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":", if $$$s_{p_i} = t_i$$$ for all $$$i$$$ from $$$1$$$ to $$$m$$$. The "},{"children":[{"kind":"text","text":"width"}],"kind":"container"},{"kind":"text","text":" of a sequence is defined as $$$\\max\\limits_{1 \\le i \\lt m} \\left(p_{i + 1} - p_i\\right)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please help your classmate to identify the beautiful sequence with the "},{"children":[{"kind":"text","text":"maximum width"}],"kind":"container"},{"kind":"text","text":". Your classmate promised you that for the given strings $$$s$$$ and $$$t$$$ there is at least one beautiful sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains two integers $$$n$$$ and $$$m$$$ ($$$2 \\leq m \\leq n \\leq 2 \\cdot 10^5$$$) — the lengths of the strings $$$s$$$ and $$$t$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following line contains a single string $$$s$$$ of length $$$n$$$, consisting of lowercase letters of the Latin alphabet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line contains a single string $$$t$$$ of length $$$m$$$, consisting of lowercase letters of the Latin alphabet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there is at least one beautiful sequence for the given strings."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output one integer — the maximum width of a beautiful sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 3\nabbbc\nabc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 2\naaaaa\naa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 5\nabcdf\nabcdf\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 2\nab\nab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example there are two beautiful sequences of width $$$3$$$: they are $$$\\{1, 2, 5\\}$$$ and $$$\\{1, 4, 5\\}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the beautiful sequence with the maximum width is $$$\\{1, 5\\}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example there is exactly one beautiful sequence — it is $$$\\{1, 2, 3, 4, 5\\}$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example there is exactly one beautiful sequence — it is $$$\\{1, 2\\}$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1492C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1492/problem/C"}