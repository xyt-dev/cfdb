{"assets":[],"contentKind":"statement","contestId":"2125","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Count Good Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A prime number is a positive integer that has exactly two divisors: $$$1$$$ and itself. The first several prime numbers are $$$2, 3, 5, 7, 11, \\dots$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Prime factorization of a positive integer is representing it as a product of prime numbers. For example:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the prime factorization of $$$111$$$ is $$$3 \\cdot 37$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the prime factorization of $$$43$$$ is $$$43$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the prime factorization of $$$12$$$ is $$$2 \\cdot 2 \\cdot 3$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For every positive integer, its prime factorization is unique (if you don't consider the order of primes in the product)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We call a positive integer "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if "},{"children":[{"kind":"text","text":"all"}],"kind":"container"},{"kind":"text","text":" primes in its factorization consist of at least two digits. For example:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$343 = 7 \\cdot 7 \\cdot 7$$$ is not good; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$111 = 3 \\cdot 37$$$ is not good; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$1111 = 11 \\cdot 101$$$ is good; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$43 = 43$$$ is good. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You have to calculate the number of good integers from $$$l$$$ to $$$r$$$ (endpoints included)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 10^3$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of one line containing two integers $$$l$$$ and $$$r$$$ ($$$2 \\le l \\le r \\le 10^{18}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer — the number of good integers from $$$l$$$ to $$$r$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n2 100\n2 1000\n13 37\n2 1000000000000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n21\n227\n7\n228571428571428570\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"2125C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2125/problem/C"}