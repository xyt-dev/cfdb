{"assets":["/statement-assets/bbc62b51d5b0054c6e5bfc92a53b81a11e21e85da81d3fb1b35e680d7b89d3a4.png","/statement-assets/fb822c616310bc9704e56bef8fddd04a863a86ffcb5a23ae947dbe2eafd1759e.png"],"contentKind":"statement","contestId":"433","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Kuriyama Mirai's Stones"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Kuriyama Mirai has killed many monsters and got many (namely "},{"kind":"math_inline","text":"n"},{"kind":"text","text":") stones. She numbers the stones from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The cost of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th stone is "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":". Kuriyama Mirai wants to know something about these stones so she will ask you two kinds of questions:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" She will tell you two numbers, "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r (1 ≤ l ≤ r ≤ n)"},{"kind":"text","text":", and you should tell her "},{"attrs":{"alt":"","src":"/statement-assets/bbc62b51d5b0054c6e5bfc92a53b81a11e21e85da81d3fb1b35e680d7b89d3a4.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Let "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" be the cost of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th cheapest stone (the cost that will be on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th place if we arrange all the stone costs in non-decreasing order). This time she will tell you two numbers, "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r (1 ≤ l ≤ r ≤ n)"},{"kind":"text","text":", and you should tell her "},{"attrs":{"alt":"","src":"/statement-assets/fb822c616310bc9704e56bef8fddd04a863a86ffcb5a23ae947dbe2eafd1759e.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For every question you should give the correct answer, or Kuriyama Mirai will say \"fuyukai desu\" and then become unhappy."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n (1 ≤ n ≤ 105)"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"v1, v2, ..., vn (1 ≤ vi ≤ 109)"},{"kind":"text","text":" — costs of the stones. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains an integer "},{"kind":"math_inline","text":"m (1 ≤ m ≤ 105)"},{"kind":"text","text":" — the number of Kuriyama Mirai's questions. Then follow "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines, each line contains three integers "},{"kind":"math_inline","text":"type"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r (1 ≤ l ≤ r ≤ n; 1 ≤ type ≤ 2)"},{"kind":"text","text":", describing a question. If "},{"kind":"math_inline","text":"type"},{"kind":"text","text":" equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", then you should output the answer for the first question, else you should output the answer for the second one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines. Each line must contain an integer — the answer to Kuriyama Mirai's question. Print the answers to the questions in the order of input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n6 4 2 7 2 7\n3\n2 3 6\n1 3 4\n1 1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"24\n9\n28\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n5 5 2 3\n10\n1 2 4\n2 1 4\n1 1 1\n2 1 4\n2 1 2\n1 1 1\n1 3 3\n1 1 3\n1 4 4\n1 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n15\n5\n15\n5\n5\n2\n12\n3\n5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Please note that the answers to the questions may overflow 32-bit integer type."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"433B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/433/problem/B"}