{"assets":[],"contentKind":"statement","contestId":"1155","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Beautiful Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array $$$a$$$ consisting of $$$n$$$ integers. Beauty of array is the maximum sum of some "},{"children":[{"kind":"text","text":"consecutive subarray"}],"kind":"container"},{"kind":"text","text":" of this array (this subarray may be empty). For example, the beauty of the array "},{"children":[{"kind":"text","text":"[10, -5, 10, -4, 1]"}],"kind":"container"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"15"}],"kind":"container"},{"kind":"text","text":", and the beauty of the array "},{"children":[{"kind":"text","text":"[-3, -5, -1]"}],"kind":"container"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may choose "},{"children":[{"kind":"text","text":"at most one consecutive subarray"}],"kind":"container"},{"kind":"text","text":" of $$$a$$$ and multiply all values contained in this subarray by $$$x$$$. You want to maximize the beauty of array after applying at most one such operation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$x$$$ ($$$1 \\le n \\le 3 \\cdot 10^5, -100 \\le x \\le 100$$$) — the length of array $$$a$$$ and the integer $$$x$$$ respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$-10^9 \\le a_i \\le 10^9$$$) — the array $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the maximum possible beauty of array $$$a$$$ after multiplying all values belonging to some consecutive subarray $$$x$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 -2\n-3 8 -2 1 -6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n22\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n12 -3\n1 3 3 7 1 3 3 7 1 3 3 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n42\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 10\n-1 -2 -3 -4 -5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case we need to multiply the subarray "},{"children":[{"kind":"text","text":"[-2, 1, -6]"}],"kind":"container"},{"kind":"text","text":", and the array becomes "},{"children":[{"kind":"text","text":"[-3, 8, 4, -2, 12]"}],"kind":"container"},{"kind":"text","text":" with beauty "},{"children":[{"kind":"text","text":"22"}],"kind":"container"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"[-3, "},{"children":[{"kind":"text","text":"8, 4, -2, 12"}],"kind":"container"},{"kind":"text","text":"]"}],"kind":"container"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case we don't need to multiply any subarray at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case no matter which subarray we multiply, the beauty of array will be equal to "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1155D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1155/problem/D"}