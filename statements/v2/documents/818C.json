{"assets":[],"contentKind":"statement","contestId":"818","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Sofa Thief"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Yet another round on DecoForces is coming! Grandpa Maks wanted to participate in it but someone has stolen his precious sofa! And how can one perform well with such a major loss?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Fortunately, the thief had left a note for Grandpa Maks. This note got Maks to the sofa storehouse. Still he had no idea which sofa belongs to him as they all looked the same!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The storehouse is represented as matrix "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":". Every sofa takes two neighbouring by some side cells. No cell is covered by more than one sofa. There can be empty cells."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sofa "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is standing to the left of sofa "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" if there exist two such cells "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" that "},{"children":[{"kind":"math_inline","text":"xa < xb"}],"kind":"container"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is covered by "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is covered by "},{"kind":"math_inline","text":"B"},{"kind":"text","text":". Sofa "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is standing to the top of sofa "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" if there exist two such cells "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" that "},{"children":[{"kind":"math_inline","text":"ya < yb"}],"kind":"container"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is covered by "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is covered by "},{"kind":"math_inline","text":"B"},{"kind":"text","text":". Right and bottom conditions are declared the same way. "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note that in all conditions "},{"kind":"math_inline","text":"A ≠ B"},{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" Also some sofa "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" can be both to the top of another sofa "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" and to the bottom of it. The same is for left and right conditions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The note also stated that there are "},{"kind":"math_inline","text":"cntl"},{"kind":"text","text":" sofas to the left of Grandpa Maks's sofa, "},{"kind":"math_inline","text":"cntr"},{"kind":"text","text":" — to the right, "},{"kind":"math_inline","text":"cntt"},{"kind":"text","text":" — to the top and "},{"kind":"math_inline","text":"cntb"},{"kind":"text","text":" — to the bottom."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Grandpa Maks asks you to help him to identify his sofa. It is guaranteed that there is no more than one sofa of given conditions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Output the number of Grandpa Maks's sofa. If there is no such sofa that all the conditions are met for it then output "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer number "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ d ≤ 105"},{"kind":"text","text":") — the number of sofas in the storehouse."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains two integer numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":") — the size of the storehouse."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" lines contains four integer numbers "},{"kind":"math_inline","text":"x1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x1, x2 ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ y1, y2 ≤ m"},{"kind":"text","text":") — coordinates of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th sofa. It is guaranteed that cells ("},{"kind":"math_inline","text":"x1, y1"},{"kind":"text","text":") and ("},{"kind":"math_inline","text":"x2, y2"},{"kind":"text","text":") have common side, ("},{"kind":"math_inline","text":"x1, y1"},{"kind":"text","text":") "},{"kind":"math_inline","text":" ≠ "},{"kind":"text","text":" ("