 "},{"kind":"math_inline","text":"cntb = 0"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The third sofa has "},{"kind":"math_inline","text":"cntl = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"cntr = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"cntt = 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"cntb = 1"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"So the second one corresponds to the given conditions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The first sofa has "},{"kind":"math_inline","text":"cntl = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"cntr = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"cntt = 0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"cntb = 1"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The second sofa has "},{"kind":"math_inline","text":"cntl = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"cntr = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"cntt = 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"cntb = 0"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"And there is no sofa with the set "},{"kind":"math_inline","text":"(1, 0, 0, 0)"},{"kind":"text","text":" so the answer is "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"818C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/818/problem/C"}