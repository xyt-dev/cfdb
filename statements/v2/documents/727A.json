{"assets":[],"contentKind":"statement","contestId":"727","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Transformation: from A to B"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasily has a number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", which he wants to turn into a number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". For this purpose, he can do two types of operations:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" multiply the current number by "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" (that is, replace the number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"2·x"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" append the digit "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to the right of current number (that is, replace the number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"10·x + 1"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You need to help Vasily to transform the number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" into the number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" using only the operations described above, or find that it is impossible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that in this task you are not required to minimize the number of operations. It suffices to find any way to transform "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two positive integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a < b ≤ 109"},{"kind":"text","text":") — the number which Vasily has and the number he wants to have."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no way to get "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print three lines. On the first line print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes). The second line should contain single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the length of the transformation sequence. On the third line print the sequence of transformations "},{"kind":"math_inline","text":"x1, x2, ..., xk"},{"kind":"text","text":", where:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"x1"},{"kind":"text","text":" should be equal to "},{"kind":"math_inline","text":"a"},{"kind":"te