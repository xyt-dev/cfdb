{"assets":["/statement-assets/42bcde3b4633e8390bd01a4c2a518b6248d3e04f9e01e03d5c38e21bfcf73e8d.png"],"contentKind":"statement","contestId":"380","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Sereja and Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sereja adores trees. Today he came up with a revolutionary new type of binary root trees."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"His new tree consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" levels, each vertex is indexed by two integers: the number of the level and the number of the vertex on the current level. The tree root is at level "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", its index is "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":". Here is a pseudo code of tree construction."}],"kind":"paragraph"},{"kind":"code_block","text":"\n//the global data are integer arrays cnt[], left[][], right[][]\n\ncnt[1] = 1;\nfill arrays left[][], right[][] with values -1;\nfor(level = 1; level < n; level = level + 1){\n    cnt[level + 1] = 0;\n    for(position = 1; position <= cnt[level]; position = position + 1){\n        if(the value of position is a power of two){ // that is, 1, 2, 4, 8...\n            left[level][position] = cnt[level + 1] + 1;\n            right[level][position] = cnt[level + 1] + 2;\n            cnt[level + 1] = cnt[level + 1] + 2;            \n        }else{\n            right[level][position] = cnt[level + 1] + 1;\n            cnt[level + 1] = cnt[level + 1] + 1;\n        }\n    }\n}\n"},{"children":[{"kind":"text","text":"After the pseudo code is run, cell "},{"children":[{"kind":"text","text":"cnt[level]"}],"kind":"container"},{"kind":"text","text":" contains the number of vertices on level "},{"kind":"math_inline","text":"level"},{"kind":"text","text":". Cell "},{"children":[{"kind":"text","text":"left[level][position]"}],"kind":"container"},{"kind":"text","text":" contains the number of the vertex on the level "},{"kind":"math_inline","text":"level + 1"},{"kind":"text","text":", which is the left child of the vertex with index "},{"kind":"math_inline","text":"(level, position)"},{"kind":"text","text":", or it contains -1, if the vertex doesn't have a left child. Similarly, cell "},{"children":[{"kind":"text","text":"right[level][position]"}],"kind":"container"},{"kind":"text","text":" is responsible for the right child. You can see how the tree with "},{"kind":"math_inline","text":"n = 4"},{"kind":"text","text":" looks like in the notes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Serja loves to make things complicated, so he first made a tree and then added an empty set "},{"kind":"math_inline","text":"A(level, position)"},{"kind":"text","text":" for each vertex. Then Sereja executes "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" operations. Each operation is of one of the two following types:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The format of the operation is \""},{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"l"},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"x"},{"kind":"text","text":"\". For all vertices "},{"kind":"math_inline","text":"level, position"},{"kind":"math_inline","text":"(level = t; l ≤ position ≤ r)"},{"kind":"text","text":" add value "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to set "},{"kind":"math_inline","text":"A(level, position)"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The format of the operation is \""},{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"v"},{"kind":"text","text":"\". For vertex "},{"kind":"math_inline","text":"level, position"},{"kind":"math_inline","text":"(level = t, position = v)"},{"kind":"text","text":", find the union of all sets of vertices that are in the subtree of vertex "},{"kind":"math_inline","text":"(level, position)"},{"kind":"text","text":". Print the size of the union of these sets. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Sereja execute the operations. In this problem a set contains only distinct values like std::set in C++."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 7000)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the descriptions of the operations. The operation of the first type is given by five integers: "},{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"l"},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"(1 ≤ t ≤ n; 1 ≤ l ≤ r ≤ cnt[t]; 1 ≤ x ≤ 106)"},{"kind":"text","text":". The operation of the second type is given by three integers: "},{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"v"},{"kind":"math_inline","text":"(1 ≤ t ≤ n; 1 ≤ v ≤ cnt[t])"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each operation of the second type, print the answer on a single line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n1 4 4 7 1\n1 3 1 2 2\n2 1 1\n2 4 1\n2 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n0\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"You can find the definitions that are used while working with root trees by this link: http://en.wikipedia.org/wiki/Tree_(graph_theory)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can see an example of a constructed tree at "},{"kind":"math_inline","text":"n = 4"},{"kind":"text","text":" below."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/42bcde3b4633e8390bd01a4c2a518b6248d3e04f9e01e03d5c38e21bfcf73e8d.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"380B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/380/problem/B"}