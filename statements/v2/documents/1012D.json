input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 2·105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |t| ≤ 2·105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"|t|"},{"kind":"text","text":" denote the lengths of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", respectively. It is guaranteed that at least one of the strings contains at least one "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" letter and at least one of the strings contains at least one "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":" letter."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line should contain a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ n ≤ 5·105"},{"kind":"text","text":") — the number of operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines should contain two space-separated integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" — the lengths of prefixes of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" to swap, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple possible solutions, you can print any of them. It's guaranteed that a solution with given constraints exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"bab\nbb\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 0\n1 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"bbbb\naaa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, you can solve the problem in two operations:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Swap the prefix of the first string with length "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and the prefix of the second string with length "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". After this swap, you'll have strings "},{"children":[{"kind":"te