{"assets":["/statement-assets/e7f7a2213c2edc9f22f7ea970d6ab4771d52b7bc7cb123f784fc864bce947511.png","/statement-assets/5c50b45bf3716cd9750341d84b8c78d44f82d33d67338b8f6babc7b2f823d098.png"],"contentKind":"statement","contestId":"873","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Chores"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Luba has to do "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" chores today. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th chore takes "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" units of time to complete. It is guaranteed that for every "},{"attrs":{"alt":"","src":"/statement-assets/e7f7a2213c2edc9f22f7ea970d6ab4771d52b7bc7cb123f784fc864bce947511.png"},"kind":"image"},{"kind":"text","text":" the condition "},{"kind":"math_inline","text":"ai ≥ ai - 1"},{"kind":"text","text":" is met, so the sequence is sorted."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Also Luba can work really hard on some chores. She can choose not more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" any chores and do each of them in "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" units of time instead of "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/5c50b45bf3716cd9750341d84b8c78d44f82d33d67338b8f6babc7b2f823d098.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Luba is very responsible, so she has to do all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" chores, and now she wants to know the minimum time she needs to do everything. Luba cannot do two chores simultaneously."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n, k, x (1 ≤ k ≤ n ≤ 100, 1 ≤ x ≤ 99"},{"kind":"text","text":") — the number of chores Luba has to do, the number of chores she can do in "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" units of time, and the number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" itself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer numbers "},{"kind":"math_inline","text":"ai (2 ≤ ai ≤ 100)"},{"kind":"text","text":" — the time Luba has to spend to do "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th chore."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that "},{"attrs":{"alt":"","src":"/statement-assets/5c50b45bf3716cd9750341d84b8c78d44f82d33d67338b8f6babc7b2f823d098.png"},"kind":"image"},{"kind":"text","text":", and for each "},{"attrs":{"alt":"","src":"/statement-assets/e7f7a2213c2edc9f22f7ea970d6ab4771d52b7bc7cb123f784fc864bce947511.png"},"kind":"image"},{"kind":"math_inline","text":"ai ≥ ai - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one number — minimum time Luba needs to do all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" chores."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 2\n3 6 7 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"13\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 1\n100 100 100 100 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"302\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the best option would be to do the third and the fourth chore, spending "},{"kind":"math_inline","text":"x = 2"},{"kind":"text","text":" time on each instead of "},{"kind":"math_inline","text":"a3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a4"},{"kind":"text","text":", respectively. Then the answer is "},{"kind":"math_inline","text":"3 + 6 + 2 + 2 = 13"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example Luba can choose any two chores to spend "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" time on them instead of "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". So the answer is "},{"kind":"math_inline","text":"100·3 + 2·1 = 302"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"873A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/873/problem/A"}