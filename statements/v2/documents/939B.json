{"assets":[],"contentKind":"statement","contestId":"939","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Hamster Farm"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dima has a hamsters farm. Soon "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" hamsters will grow up on it and Dima will sell them in a city nearby."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Hamsters should be transported in boxes. If some box is not completely full, the hamsters in it are bored, that's why each box should be completely full with hamsters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Dima can buy boxes at a factory. The factory produces boxes of "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" kinds, boxes of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th kind can contain in themselves "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" hamsters. Dima can buy any amount of boxes, but he should buy boxes of only one kind to get a wholesale discount."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Of course, Dima would buy boxes in such a way that each box can be completely filled with hamsters and transported to the city. If there is no place for some hamsters, Dima will leave them on the farm."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find out how many boxes and of which type should Dima buy to transport maximum number of hamsters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ N ≤ 1018"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ K ≤ 105"},{"kind":"text","text":") — the number of hamsters that will grow up on Dima's farm and the number of types of boxes that the factory produces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"aK"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 1018"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":") — the capacities of boxes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output two integers: the type of boxes that Dima should buy and the number of boxes of that type Dima should buy. Types of boxes are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" in the order they are given in input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are many correct answers, output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":