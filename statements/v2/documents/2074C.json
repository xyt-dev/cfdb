{"assets":[],"contentKind":"statement","contestId":"2074","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. XOR and Triangle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"This time, the pink soldiers have given you an integer $$$x$$$ ($$$x \\ge 2$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please determine if there exists a "},{"children":[{"kind":"text","text":"positive"}],"kind":"container"},{"kind":"text","text":" integer $$$y$$$ that satisfies the following conditions."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$y$$$ is "},{"children":[{"kind":"text","text":"strictly"}],"kind":"container"},{"kind":"text","text":" less than $$$x$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There exists a "},{"children":[{"kind":"text","text":"non-degenerate triangle"}],"kind":"container"},{"kind":"text","text":"$$$^{\\text{∗}}$$$ with side lengths $$$x$$$, $$$y$$$, $$$x \\oplus y$$$. Here, $$$\\oplus$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise XOR operation"}],"kind":"link"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Additionally, if there exists such an integer $$$y$$$, output any."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$A triangle with side lengths $$$a$$$, $$$b$$$, $$$c$$$ is non-degenerate when $$$a+b \\gt c$$$, $$$a+c \\gt b$$$, $$$b+c \\gt a$$$."}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 2000$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a single integer $$$x$$$ ($$$2 \\le x \\le 10^9$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer on a separate line. The integer you must output is as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If there exists an integer $$$y$$$ satisfying the conditions, output the value of $$$y$$$ ($$$1 \\le y \\lt x$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Otherwise, output $$$-1$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there exist multiple integers that satisfy the conditions, you may output any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n5\n2\n6\n3\n69\n4\n420\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n-1\n5\n-1\n66\n-1\n320\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, there exists a non-degenerate triangle with side lengths $$$3$$$, $$$5$$$, and $$$3 \\oplus 5 = 6$$$. Therefore, $$$y=3$$$ is a valid answer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, $$$1$$$ is the only possible candidate for $$$y$$$, but it cannot make a non-degenerate triangle. Therefore, the answer is $$$-1$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"2074C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2074/problem/C"}