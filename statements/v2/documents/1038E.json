{"assets":[],"contentKind":"statement","contestId":"1038","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Maximum Matching"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given $$$n$$$ blocks, each of them is of the form "},{"children":[{"kind":"text","text":"[color$$$_1$$$|value|color$$$_2$$$]"}],"kind":"container"},{"kind":"text","text":", where the block can also be flipped to get "},{"children":[{"kind":"text","text":"[color$$$_2$$$|value|color$$$_1$$$]"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A sequence of blocks is called "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" if the touching endpoints of neighboring blocks have the same color. For example, the sequence of three blocks A, B and C is valid if the left color of the B is the same as the right color of the A and the right color of the B is the same as the left color of C."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The value of the sequence is defined as the sum of the values of the blocks in this sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the maximum possible value of the valid sequence that can be constructed from the subset of the given blocks. The blocks from the subset can be reordered and flipped if necessary. Each block can be used at most once in the sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer $$$n$$$ ($$$1 \\le n \\le 100$$$) — the number of given blocks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following $$$n$$$ lines describes corresponding block and consists of $$$\\mathrm{color}_{1,i}$$$, $$$\\mathrm{value}_i$$$ and $$$\\mathrm{color}_{2,i}$$$ ($$$1 \\le \\mathrm{color}_{1,i}, \\mathrm{color}_{2,i} \\le 4$$$, $$$1 \\le \\mathrm{value}_i \\le 100\\,000$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print exactly one integer — the maximum total value of the subset of blocks, which makes a valid sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n2 1 4\n1 2 4\n3 4 4\n2 8 3\n3 16 3\n1 32 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"63"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 100000 1\n1 100000 2\n1 100000 2\n4 50000 3\n3 50000 4\n4 50000 4\n3 50000 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"300000"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1000 1\n2 500 2\n3 250 3\n4 125 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1000"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, it is possible to form a valid sequence from all blocks."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One of the valid sequences is the following:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"[4|2|1]"}],"kind":"container"},{"children":[{"kind":"text","text":"[1|32|2]"}],"kind":"container"},{"children":[{"kind":"text","text":"[2|8|3]"}],"kind":"container"},{"children":[{"kind":"text","text":"[3|16|3]"}],"kind":"container"},{"children":[{"kind":"text","text":"[3|4|4]"}],"kind":"container"},{"children":[{"kind":"text","text":"[4|1|2]"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first block from the input ("},{"children":[{"kind":"text","text":"[2|1|4]"}],"kind":"container"},{"kind":"text","text":" $$$\\to$$$ "},{"children":[{"kind":"text","text":"[4|1|2]"}],"kind":"container"},{"kind":"text","text":") and second ("},{"children":[{"kind":"text","text":"[1|2|4]"}],"kind":"container"},{"kind":"text","text":" $$$\\to$$$ "},{"children":[{"kind":"text","text":"[4|2|1]"}],"kind":"container"},{"kind":"text","text":") are flipped."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, the optimal answers can be formed from the first three blocks as in the following (the second or the third block from the input is flipped):"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"[2|100000|1]"}],"kind":"container"},{"children":[{"kind":"text","text":"[1|100000|1]"}],"kind":"container"},{"children":[{"kind":"text","text":"[1|100000|2]"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, it is not possible to form a valid sequence of two or more blocks, so the answer is a sequence consisting only of the first block since it is the block with the largest value."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1038E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1038/problem/E"}