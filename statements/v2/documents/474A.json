{"assets":[],"contentKind":"statement","contestId":"474","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Keyboard"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Our good friend Mole is trying to code a big message. He is typing on an unusual keyboard with characters arranged in following way:"}],"kind":"paragraph"},{"kind":"code_block","text":"\nqwertyuiop\nasdfghjkl;\nzxcvbnm,./\n"},{"children":[{"kind":"text","text":"Unfortunately Mole is blind, so sometimes it is problem for him to put his hands accurately. He accidentally moved both his hands with one position to the left or to the right. That means that now he presses not a button he wants, but one neighboring button (left or right, as specified in input)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We have a sequence of characters he has typed and we want to find the original message."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of the input contains one letter describing direction of shifting ("},{"children":[{"kind":"text","text":"'L'"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"'R'"}],"kind":"container"},{"kind":"text","text":" respectively for left or right)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second line contains a sequence of characters written by Mole. The size of this sequence will be no more than "},{"kind":"math_inline","text":"100"},{"kind":"text","text":". Sequence contains only symbols that appear on Mole's keyboard. It doesn't contain spaces as there is no space on Mole's keyboard."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that even though Mole hands are moved, he is still pressing buttons on keyboard and not hitting outside it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a line that contains the original message."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"R\ns;;upimrrfod;pbr\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"allyouneedislove\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"474A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/474/problem/A"}