{"assets":[],"contentKind":"statement","contestId":"766","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Mahmoud and a Triangle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Mahmoud has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" line segments, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them has length "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". Ehab challenged him to use "},{"children":[{"kind":"text","text":"exactly "},{"kind":"math_inline","text":"3"}],"kind":"container"},{"kind":"text","text":" line segments to form a non-degenerate triangle. Mahmoud doesn't accept challenges unless he is sure he can win, so he asked you to tell him if he should accept the challenge. Given the lengths of the line segments, check if he can choose exactly "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" of them to form a non-degenerate triangle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Mahmoud should use exactly "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" line segments, he can't concatenate two line segments or change any length. A non-degenerate triangle is a triangle with positive area."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"m