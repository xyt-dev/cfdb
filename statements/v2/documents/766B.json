ng"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first example, he can use line segments with lengths "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" to form a non-degenerate triangle."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"766B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/766/problem/B"}