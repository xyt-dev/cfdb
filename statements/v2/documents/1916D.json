{"assets":[],"contentKind":"statement","contestId":"1916","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Mathematical Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The mathematicians of the 31st lyceum were given the following task:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an "},{"children":[{"kind":"text","text":"odd"}],"kind":"container"},{"kind":"text","text":" number $$$n$$$, and you need to find $$$n$$$ different numbers that are squares of integers. But it's not that simple. Each number should have a length of $$$n$$$ (and should not have leading zeros), and the multiset of digits of all the numbers should be the same. For example, for $$$\\mathtt{234}$$$ and $$$\\mathtt{432}$$$, and $$$\\mathtt{11223}$$$ and $$$\\mathtt{32211}$$$, the multisets of digits are the same, but for $$$\\mathtt{123}$$$ and $$$\\mathtt{112233}$$$, they are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The mathematicians couldn't solve this problem. Can you?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\leq t \\leq 100$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following $$$t$$$ lines contain one "},{"children":[{"kind":"text","text":"odd"}],"kind":"container"},{"kind":"text","text":" integer $$$n$$$ ($$$1 \\leq n \\leq 99$$$) — the number of numbers to be found and their length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the solution exists within the given constraints."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n^2$$$ does not exceed $$$10^5$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The numbers can be output in any order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, you need to output $$$n$$$ numbers of length $$$n$$$ — the answer to the problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1\n3\n5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n169\n196\n961\n16384\n31684\n36481\n38416\n43681\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Below are the squares of the numbers that are the answers for the second test case:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\mathtt{169}$$$ = $$$\\mathtt{13}^2$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$\\mathtt{196}$$$ = $$$\\mathtt{14}^2$$$"}],"kind":