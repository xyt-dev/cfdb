{"assets":[],"contentKind":"statement","contestId":"1734","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Rectangular Congruence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a "},{"children":[{"kind":"text","text":"prime"}],"kind":"container"},{"kind":"text","text":" number $$$n$$$, and an array of $$$n$$$ integers $$$b_1,b_2,\\ldots, b_n$$$, where $$$0 \\leq b_i \\lt n$$$ for each $$$1 \\le i \\leq n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to find a matrix $$$a$$$ of size $$$n \\times n$$$ such that all of the following requirements hold:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$0 \\le a_{i,j} \\lt n$$$ for all $$$1 \\le i, j \\le n$$$."},{"kind":"paragraph"}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_{r_1, c_1} + a_{r_2, c_2} \\not\\equiv a_{r_1, c_2} + a_{r_2, c_1} \\pmod n$$$ for all positive integers $$$r_1$$$, $$$r_2$$$, $$$c_1$$$, and $$$c_2$$$ such that $$$1 \\le r_1 \\lt r_2 \\le n$$$ and $$$1 \\le c_1 \\lt c_2 \\le n$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_{i,i} = b_i$$$ for all $$$1 \\le i \\leq n$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Here $$$x \\not \\equiv y \\pmod m$$$ denotes that $$$x$$$ and $$$y$$$ give different remainders when divided by $$$m$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, output any. It can be shown that such a matrix always exists under the given constraints."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single positive integer $$$n$$$ ($$$2 \\le n \\lt 350$$$). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$b_1, b_2, \\ldots, b_n$$$ ($$$0 \\le b_i \\lt n$$$) — the required values on the main diagonal of the matrix."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that $$$n$$$ is "},{"children":[{"kind":"text","text":"prime"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print $$$n$$$ lines. On the $$$i$$$-th line, print $$$n$$$ integers $$$a_{i, 1}, a_{i, 2}, \\ldots, a_{i, n}$$$, each separated with a space."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, output any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0 1 \n0 0"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 2 2\n1 1 0\n1 0 1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 4 1 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 0 1 3 4\n1 4 3 1 0\n2 4 1 0 2\n1 2 2 2 2\n2 2 0 1 4"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the answer is valid because all entries are non-negative integers less than $$$n = 2$$$, and $$$a_{1,1}+a_{2,2} \\not\\equiv a_{1,2}+a_{2,1} \\pmod 2$$$ (because $$$a_{1,1}+a_{2,2} = 0 + 0 \\equiv 0 \\pmod 2$$$ and $$$a_{1,2}+a_{2,1} = 1 + 0 \\equiv 1 \\pmod 2 $$$). Moreover, the values on the main diagonals are equal to $$$0,0$$$ as required."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, the answer is correct because all entries are non-negative integers less than $$$n = 3$$$, and the second condition is satisfied for all quadruplets $$$(r_1, r_2, c_1, c_2)$$$. For example: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" When $$$r_1=1$$$, $$$r_2=2$$$, $$$c_1=1$$$ and $$$c_2=2$$$, $$$a_{1,1}+a_{2,2} \\not\\equiv a_{1,2}+a_{2,1} \\pmod 3$$$ because $$$a_{1,1}+a_{2,2} = 1 + 1 \\equiv 2 \\pmod 3$$$ and $$$a_{1,2}+a_{2,1} = 2 + 1 \\equiv 0 \\pmod 3 $$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" When $$$r_1=2$$$, $$$r_2=3$$$, $$$c_1=1$$$, and $$$c_2=3$$$, $$$a_{2,1}+a_{3,3} \\not\\equiv a_{2,3}+a_{3,1} \\pmod 3$$$ because $$$a_{2,1}+a_{3,3} = 1 + 1 \\equiv 2 \\pmod 3$$$ and $$$a_{2,3}+a_{3,1} = 0 + 1 \\equiv 1 \\pmod 3 $$$. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" Moreover, the values on the main diagonal are equal to $$$1,1,1$$$ as required."}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1734E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1734/problem/E"}