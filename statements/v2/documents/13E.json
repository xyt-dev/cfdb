{"assets":[],"contentKind":"statement","contestId":"13","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Holes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Petya likes to play a lot. Most of all he likes to play a game «Holes». This is a game for one person with following rules:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" holes located in a single row and numbered from left to right with numbers from 1 to "},{"kind":"math_inline","text":"N"},{"kind":"text","text":". Each hole has it's own power (hole number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has the power "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"). If you throw a ball into hole "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" it will immediately jump to hole "},{"kind":"math_inline","text":"i + ai"},{"kind":"text","text":", then it will jump out of it and so on. If there is no hole with such number, the ball will just jump out of the row. On each of the "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" moves the player can perform one of two actions: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Set the power of the hole "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to value "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Throw a ball into the hole "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and count the number of jumps of a ball before it jump out of the row and also write down the number of the hole from which it jumped out just before leaving the row. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Petya is not good at math, so, as you have already guessed, you are to perform all computations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ N ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ M ≤ 105"},{"kind":"text","text":") — the number of holes in a row and the number of moves. The second line contains "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" positive integers not exceeding "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" — initial values of holes power. The following "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" lines describe moves made by Petya. Each of these line can be one of the two types: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"0"},{"kind":"math_inline","text":"a"},{"kind":"math_inline","text":"b"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"a"}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" Type "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" means that it is required to set the power of hole "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", and type "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" means that it is required to throw a ball into the "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"-th hole. Numbers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" are positive integers do not exceeding "},{"kind":"math_inline","text":"N"},{"kind":"text","text":"."}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each move of the type "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" output two space-separated numbers on a separate line — the number of the last hole the ball visited before leaving the row and the number of jumps it made."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 5\n1 1 1 1 1 2 8 2\n1 1\n0 1 3\n1 1\n0 3 4\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8 7\n8 5\n7 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"13E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/13/problem/E"}