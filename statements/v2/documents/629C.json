{"assets":[],"contentKind":"statement","contestId":"629","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Famil Door and Brackets"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As Famil Door’s birthday is coming, some of his friends (like Gabi) decided to buy a present for him. His friends are going to buy a string consisted of round brackets since Famil Door loves string of brackets of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" more than any other strings!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sequence of round brackets is called "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" if and only if: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" the total number of opening brackets is equal to the total number of closing brackets; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for any prefix of the sequence, the number of opening brackets is greater or equal than the number of closing brackets. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Gabi bought a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"m ≤ n"},{"kind":"text","text":") and want to complete it to obtain a valid sequence of brackets of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". He is going to pick some strings "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" consisting of round brackets and merge them in a string "},{"kind":"math_inline","text":"p + s + q"},{"kind":"text","text":", that is add the string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" at the beginning of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and string "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" at the end of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now he wonders, how many "},{"children":[{"kind":"text","text":"pairs"}],"kind":"container"},{"kind":"text","text":" of strings "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" exists, such that the string "},{"kind":"math_inline","text":"p + s + q"},{"kind":"text","text":" is a valid sequence of round brackets. As this number may be pretty large, he wants to calculate it modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ n ≤ 100 000, n - m ≤ 2000"},{"kind":"text","text":") — the desired length of the string and the length of the string bought by Gabi, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" consisting of characters '"},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"' only."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of pairs of string "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"p + s + q"},{"kind":"text","text":" is a valid sequence of round brackets modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n(\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n(())\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block