{"assets":["/statement-assets/ae76cfdbbba355c4500e6a1b026cce0deb0ee6e4a4675fccba82423e56ff6493.png","/statement-assets/95f83c4c6af588f7a63284d06509e944f3aa789d743b2ecb954ec694f90768ec.png","/statement-assets/daf3fc4b167f8ef7a8f43559ff7610a864cc300ac5068e7a6482ac152ed8dbe9.png","/statement-assets/01b1f72735866a23c71d894b181b5a815f8e4b31a811f1e3e3bdc649a3726045.png"],"contentKind":"statement","contestId":"1513","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. GCD and MST"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array $$$a$$$ of $$$n$$$ ($$$n \\geq 2$$$) positive integers and an integer $$$p$$$. Consider an undirected weighted graph of $$$n$$$ vertices numbered from $$$1$$$ to $$$n$$$ for which the edges between the vertices $$$i$$$ and $$$j$$$ ($$$i \\lt j$$$) are added in the following manner:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If $$$gcd(a_i, a_{i+1}, a_{i+2}, \\dots, a_{j}) = min(a_i, a_{i+1}, a_{i+2}, \\dots, a_j)$$$, then there is an edge of weight $$$min(a_i, a_{i+1}, a_{i+2}, \\dots, a_j)$$$ between $$$i$$$ and $$$j$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If $$$i+1=j$$$, then there is an edge of weight $$$p$$$ between $$$i$$$ and $$$j$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Here $$$gcd(x, y, \\ldots)$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Greatest_common_divisor"},"children":[{"kind":"text","text":"greatest common divisor (GCD)"}],"kind":"link"},{"kind":"text","text":" of integers $$$x$$$, $$$y$$$, ...."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that there could be multiple edges between $$$i$$$ and $$$j$$$ if both of the above conditions are true, and if both the conditions fail for $$$i$$$ and $$$j$$$, then there is no edge between these vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The goal is to find the weight of the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Minimum_spanning_tree"},"children":[{"kind":"text","text":"minimum spanning tree"}],"kind":"link"},{"kind":"text","text":" of this graph."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ ($$$2 \\leq n \\leq 2 \\cdot 10^5$$$) and $$$p$$$ ($$$1 \\leq p \\leq 10^9$$$) — the number of nodes and the parameter $$$p$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, a_3, \\dots, a_n$$$ ($$$1 \\leq a_i \\leq 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output $$$t$$$ lines. For each test case print the weight of the corresponding graph."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n2 5\n10 10\n2 5\n3 3\n4 5\n5 2 4 9\n8 8\n5 3 3 6 10 100 9 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n3\n12\n46\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here are the graphs for the four test cases of the example (the edges of a possible MST of the graphs are marked pink):"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"For test case 1"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/ae76cfdbbba355c4500e6a1b026cce0deb0ee6e4a4675fccba82423e56ff6493.png"},"kind":"image"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"For test case 2"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/95f83c4c6af588f7a63284d06509e944f3aa789d743b2ecb954ec694f90768ec.png"},"kind":"image"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"For test case 3"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/daf3fc4b167f8ef7a8f43559ff7610a864cc300ac5068e7a6482ac152ed8dbe9.png"},"kind":"image"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"For test case 4"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/01b1f72735866a23c71d894b181b5a815f8e4b31a811f1e3e3bdc649a3726045.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1513D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1513/problem/D"}