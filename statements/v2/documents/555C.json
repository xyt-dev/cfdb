{"assets":["/statement-assets/825dd89bb3cce3e5c3035b89cc6cdbf2560bf00b645a1cc807615e40c865c37a.png"],"contentKind":"statement","contestId":"555","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Case of Chocolate"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Andrewid the Android is a galaxy-known detective. Now he does not investigate any case and is eating chocolate out of boredom."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A bar of chocolate can be presented as an "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" table, where each cell represents one piece of chocolate. The columns of the table are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right and the rows are numbered from top to bottom. Let's call the anti-diagonal to be a diagonal that goes the lower left corner to the upper right corner of the table. First Andrewid eats all the pieces lying below the anti-diagonal. Then he performs the following "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" actions with the remaining triangular part: first, he chooses a piece on the anti-diagonal and either direction 'up' or 'left', and then he begins to eat all the pieces starting from the selected cell, moving in the selected direction until he reaches the already eaten piece or chocolate bar edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After each action, he wants to know how many pieces he ate as a result of this action."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 109"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 2·105"},{"kind":"text","text":") — the size of the chocolate bar and the number of actions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain the descriptions of the actions: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains numbers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"xi + yi = n + 1"},{"kind":"text","text":") — the numbers of the column and row of the chosen cell and the character that represents the direction ("},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":" — left, "},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":" — up)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should contain the number of eaten pieces as a result of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th action."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 5\n3 4 U\n6 1 L\n2 5 L\n1 6 U\n4 3 U\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n3\n2\n1\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 6\n2 9 U\n10 1 U\n1 10 U\n8 3 L\n10 1 L\n6 5 U\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n1\n10\n6\n0\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Pictures to the sample tests:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/825dd89bb3cce3e5c3035b89cc6cdbf2560bf00b645a1cc807615e40c865c37a.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The pieces that were eaten in the same action are painted the same color. The pieces lying on the anti-diagonal contain the numbers of the action as a result of which these pieces were eaten."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test the Andrewid tries to start eating chocolate for the second time during his fifth action, starting from the cell at the intersection of the 10-th column and the 1-st row, but this cell is already empty, so he does not eat anything."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"555C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/555/problem/C"}