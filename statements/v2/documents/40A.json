{"assets":["/statement-assets/5cd6bffb70bd2fbcda150ea773576f1680b46eb6a7522d28dd5fe05fc68c0977.png"],"contentKind":"statement","contestId":"40","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Find Color"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Not so long ago as a result of combat operations the main Berland place of interest — the magic clock — was damaged. The cannon's balls made several holes in the clock, that's why the residents are concerned about the repair. The magic clock can be represented as an "},{"children":[{"kind":"text","text":"infinite"}],"kind":"container"},{"kind":"text","text":" Cartesian plane, where the origin corresponds to the clock center. The clock was painted two colors as is shown in the picture:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/5cd6bffb70bd2fbcda150ea773576f1680b46eb6a7522d28dd5fe05fc68c0977.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The picture shows only the central part of the clock. This coloring naturally extends to infinity."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The balls can be taken to be points on the plane. Your task is to find the color of the area, damaged by the given ball."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the points located on the border of one of the areas have to be considered painted black."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and single line contains two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" — the coordinates of the hole made in the clock by the ball. Each of the numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" has an absolute value that does not exceed "},{"kind":"math_inline","text":"1000"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Find the required color."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the points between which and the origin of coordinates the distance is integral-value are painted black."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"-2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"white\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"black\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"black\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"40A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/40/problem/A"}