{"assets":["/statement-assets/2ac23593f5b5ccaac8fd0243cb562ebaaf4546a695ab54c4beae9906716329c1.png","/statement-assets/d15e24e2aed5727d5b4d653e2889f8fa9ea5bd8aa9197d98b1f7b5bcf8180103.png"],"contentKind":"statement","contestId":"1548","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D2. Gregor and the Odd Cows (Hard)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"6 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is the hard version of the problem. The only difference from the easy version is that in this version the coordinates can be "},{"children":[{"kind":"text","text":"both"}],"kind":"container"},{"kind":"text","text":" odd and even."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are $$$n$$$ fence-posts at distinct coordinates on a plane. It is guaranteed that no three fence posts lie on the same line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are an infinite number of cows on the plane, one at every point with integer coordinates."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Gregor is a member of the Illuminati, and wants to build a triangular fence, connecting $$$3$$$ distinct existing fence posts. A cow "},{"children":[{"kind":"text","text":"strictly"}],"kind":"container"},{"kind":"text","text":" inside the fence is said to be "},{"children":[{"kind":"text","text":"enclosed"}],"kind":"container"},{"kind":"text","text":". If there are an "},{"children":[{"kind":"text","text":"odd"}],"kind":"container"},{"kind":"text","text":" number of enclosed cows and the area of the fence is an "},{"children":[{"kind":"text","text":"integer"}],"kind":"container"},{"kind":"text","text":", the fence is said to be "},{"children":[{"kind":"text","text":"interesting"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the number of interesting fences."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the integer $$$n$$$ ($$$3 \\le n \\le 6000$$$), the number of fence posts which Gregor can choose to form the vertices of a fence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n$$$ line contains two integers $$$x$$$ and $$$y$$$ ($$$0 \\le x,y \\le 10^7$$$, where $$$(x,y)$$$ is the coordinate of a fence post. All fence posts lie at distinct coordinates. No three fence posts are on the same line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer, the number of interesting fences. Two fences are considered different if they are constructed with a different set of three fence posts."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n0 0\n2 0\n0 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 8\n0 6\n5 2\n5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n10\n170 59\n129 54\n5 98\n129 37\n58 193\n154 58\n24 3\n13 138\n136 144\n174 150\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n29\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, there is only $$$1$$$ fence. That fence is interesting since its area is $$$4$$$ and there is $$$1$$$ enclosed cow, marked in red."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/2ac23593f5b5ccaac8fd0243cb562ebaaf4546a695ab54c4beae9906716329c1.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second example, there are $$$4$$$ possible fences. Only one of them is interesting however. That fence has an area of $$$8$$$ and $$$5$$$ enclosed cows."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d15e24e2aed5727d5b4d653e2889f8fa9ea5bd8aa9197d98b1f7b5bcf8180103.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D2","problemCode":"1548D2","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1548/problem/D2"}