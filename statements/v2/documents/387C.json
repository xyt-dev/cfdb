{"assets":[],"contentKind":"statement","contestId":"387","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. George and Number"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"George is a cat, so he really likes to play. Most of all he likes to play with his array of positive integers "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". During the game, George modifies the array by using special changes. Let's mark George's current array as "},{"kind":"math_inline","text":"b1, b2, ..., b|b|"},{"kind":"text","text":" (record "},{"kind":"math_inline","text":"|b|"},{"kind":"text","text":" denotes the current length of the array). Then one change is a sequence of actions: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose two distinct indexes "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"math_inline","text":"(1 ≤ i, j ≤ |b|; i ≠ j)"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"bi ≥ bj"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Get number "},{"kind":"math_inline","text":"v = concat(bi, bj)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"concat(x, y)"},{"kind":"text","text":" is a number obtained by adding number "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" to the end of the decimal record of number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". For example, "},{"kind":"math_inline","text":"concat(500, 10) = 50010"},{"kind":"text","text":", "},{"kind":"math_inline","text":"concat(2, 2) = 22"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Add number "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to the end of the array. The length of the array will increase by one. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Remove from the array numbers with indexes "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":". The length of the array will decrease by two, and elements of the array will become re-numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to current length of the array. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"George played for a long time with his array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and received from array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" an array consisting of exactly one number "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". Now George wants to know: what is the maximum number of elements array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" could contain originally? Help him find this number. Note that originally the array could contain only "},{"children":[{"kind":"text","text":"positive"}],"kind":"container"},{"kind":"text","text":" integers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ p < 10100000"},{"kind":"text","text":"). It is guaranteed that number "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" doesn't contain any leading zeroes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print an integer — the maximum number of elements array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" could contain originally."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9555\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10000000005\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"800101\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"45\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1000000000000001223300003342220044555\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"17"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"19992000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"310200\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let's consider the test examples: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Originally array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" can be equal to "},{"kind":"math_inline","text":"{5, 9, 5, 5}"},{"kind":"text","text":". The sequence of George's changes could have been: "},{"kind":"math_inline","text":"{5, 9, 5, 5} → {5, 5, 95} → {95, 55} → {9555}"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Originally array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" could be equal to "},{"kind":"math_inline","text":"{1000000000, 5}"},{"kind":"text","text":". Please note that the array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" cannot contain zeros. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Originally array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" could be equal to "},{"kind":"math_inline","text":"{800, 10, 1}"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Originally array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" could be equal to "},{"kind":"math_inline","text":"{45}"},{"kind":"text","text":". It cannot be equal to "},{"kind":"math_inline","text":"{4, 5}"},{"kind":"text","text":", because George can get only array "},{"kind":"math_inline","text":"{54}"},{"kind":"text","text":" from this array in one operation. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that the numbers can be very large."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"387C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/387/problem/C"}