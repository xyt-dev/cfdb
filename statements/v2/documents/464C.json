{"assets":[],"contentKind":"statement","contestId":"464","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Substitutes in Number"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Andrew and Eugene are playing a game. Initially, Andrew has string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of digits. Eugene sends Andrew multiple queries of type \""},{"kind":"math_inline","text":"di → ti"},{"kind":"text","text":"\", that means \"replace all digits "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" in string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" with substrings equal to "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":"\". For example, if "},{"kind":"math_inline","text":"s = 123123"},{"kind":"text","text":", then query \""},{"kind":"math_inline","text":"2 → 00"},{"kind":"text","text":"\" transforms "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"10031003"},{"kind":"text","text":", and query \""},{"kind":"math_inline","text":"3 → "},{"kind":"text","text":"\" (\"replace 3 by an empty string\") transforms it to "},{"kind":"math_inline","text":"s = 1212"},{"kind":"text","text":". After all the queries Eugene asks Andrew to find the remainder after division of number with decimal representation equal to "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"1000000007 (109 + 7)"},{"kind":"text","text":". When you represent "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" as a decimal number, please ignore the leading zeroes; also if "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is an empty string, then it's assumed that the number equals to zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Andrew got tired of processing Eugene's requests manually and he asked you to write a program for that. Help him!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 105"},{"kind":"text","text":"), consisting of digits — the string before processing all the requests."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ n ≤ 105"},{"kind":"text","text":") — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the descriptions of the queries. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query is described by string \""},{"kind":"math_inline","text":"di"},{"children":[{"kind":"text","text":"->"}],"kind":"container"},{"kind":"math_inline","text":"ti"},{"kind":"text","text":"\", where "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" is exactly one digit (from 0 to 9), "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" is a string consisting of digits ("},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" can be an empty string). The sum of lengths of "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" for all queries doesn't exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":". The queries are written in the order in which they need to be performed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — remainder of division of the resulting number by "},{"kind":"math_inline","text":"1000000007 (109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"123123\n1\n2->00\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10031003\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"123123\n1\n3->\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1212\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"222\n2\n2->0\n0->7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"777\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1000000008\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Note that the leading zeroes are not removed from string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" after the replacement (you can see it in the third sample)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"464C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/464/problem/C"}