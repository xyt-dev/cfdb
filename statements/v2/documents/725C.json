{"assets":[],"contentKind":"statement","contestId":"725","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Hidden Word"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let’s define a grid to be a set of tiles with "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"13"},{"kind":"text","text":" columns. Each tile has an English letter written in it. The letters don't have to be unique: there might be two or more tiles with the same letter written on them. Here is an example of a grid:"}],"kind":"paragraph"},{"children":[{"kind":"code_block","text":"ABCDEFGHIJKLM\nNOPQRSTUVWXYZ"}],"kind":"container"},{"children":[{"kind":"text","text":"We say that two tiles are adjacent if they share a side or a corner. In the example grid above, the tile with the letter '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"' is adjacent only to the tiles with letters '"},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"N"}],"kind":"container"},{"kind":"text","text":"', and '"},{"children":[{"kind":"text","text":"O"}],"kind":"container"},{"kind":"text","text":"'. A tile is not adjacent to itself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A sequence of tiles is called a path if each tile in the sequence is adjacent to the tile which follows it (except for the last tile in the sequence, which of course has no successor). In this example, \""},{"children":[{"kind":"text","text":"ABC"}],"kind":"container"},{"kind":"text","text":"\" is a path, and so is \""},{"children":[{"kind":"text","text":"KXWIHIJK"}],"kind":"container"},{"kind":"text","text":"\". \""},{"children":[{"kind":"text","text":"MAB"}],"kind":"container"},{"kind":"text","text":"\" is not a path because '"},{"children":[{"kind":"text","text":"M"}],"kind":"container"},{"kind":"text","text":"' is not adjacent to '"},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":"'. A single tile can be used more than once by a path (though the tile cannot occupy two consecutive places in the path because no tile is adjacent to itself)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You’re given a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" which consists of "},{"kind":"math_inline","text":"27"},{"kind":"text","text":" upper-case English letters. Each English letter "},{"children":[{"kind":"text","text":"occurs at least once"}],"kind":"container"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". Find a grid that contains a path whose tiles, viewed in the order that the path visits them, form the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". If there’s no solution, print \""},{"children":[{"kind":"text","text":"Impossible"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"27"},{"kind":"text","text":" upper-case English letters. Each English letter occurs at least once in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output two lines, each consisting of "},{"kind":"math_inline","text":"13"},{"kind":"text","text":" upper-case English characters, representing the rows of the grid. If there are multiple solutions, print any of them. If there is no solution print \""},{"children":[{"kind":"text","text":"Impossible"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"ABCDEFGHIJKLMNOPQRSGTUVWXYZ\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YXWVUTGHIJKLM\nZABCDEFSRQPON\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"BUVTYZFQSNRIWOXXGJLKACPEMDH\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Impossible\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"725C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/725/problem/C"}