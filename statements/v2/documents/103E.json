{"assets":["/statement-assets/d6e49cdf2bec4959b83c2599ece3869512786d8190f397894f2076e95e8f7b13.png"],"contentKind":"statement","contestId":"103","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Buying Sets"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Hexadecimal virus loves playing with number sets — intersecting them, uniting them. One beautiful day she was surprised to find out that Scuzzy, her spherical pet cat, united all sets in one and ate the result! Something had to be done quickly and Hexadecimal rushed to the market."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The market has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sets of numbers on sale. The virus wants to buy the following collection of sets: the number of sets in the collection should be exactly the same as the number of numbers in the union of all bought sets. Moreover, Hexadecimal wants to buy the cheapest suitable collection of set."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Yet nothing's so easy! As Mainframe is a kingdom of pure rivalry markets, we know that the union of any "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" sets contains no less than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" distinct numbers (for every positive integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help the virus choose the suitable collection of sets. The collection can be empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the only number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 300"},{"kind":"text","text":") — the number of sets available in the market."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines describe the goods: first we are given "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ mi ≤ n"},{"kind":"text","text":") — the number of distinct numbers in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th set, then follow "},{"kind":"math_inline","text":"mi"},{"kind":"text","text":" numbers — the set's elements. We know that the set's elements are distinct positive integers and they do not exceed "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers whose absolute values do not exceed "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" — the price of each set."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the minimum price the virus will have to pay for such a collection of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" sets that union of the collection's sets would have exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" distinct numbers ("},{"attrs":{"alt":"","src":"/statement-assets/d6e49cdf2bec4959b83c2599ece3869512786d8190f397894f2076e95e8f7b13.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1\n2 2 3\n1 3\n10 20 -3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2 1 2\n2 2 3\n2 3 4\n2 4 5\n2 5 1\n1 -1 1 -1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2 1 2\n2 2 3\n2 3 4\n2 4 5\n2 5 1\n-1 1 -1 1 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"103E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/103/problem/E"}