{"assets":[],"contentKind":"statement","contestId":"522","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Reposts"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day Polycarp published a funny picture in a social network making a poll about the color of his handle. Many of his friends started reposting Polycarp's joke to their news feed. Some of them reposted the reposts and so on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"These events are given as a sequence of strings \""},{"children":[{"kind":"text","text":"name1"}],"kind":"container"},{"children":[{"kind":"text","text":"reposted"}],"kind":"container"},{"children":[{"kind":"text","text":"name2"}],"kind":"container"},{"kind":"text","text":"\", where "},{"children":[{"kind":"text","text":"name1"}],"kind":"container"},{"kind":"text","text":" is the name of the person who reposted the joke, and "},{"children":[{"kind":"text","text":"name2"}],"kind":"container"},{"kind":"text","text":" is the name of the person from whose news feed the joke was reposted. It is guaranteed that for each string \""},{"children":[{"kind":"text","text":"name1"}],"kind":"container"},{"children":[{"kind":"text","text":"reposted"}],"kind":"container"},{"children":[{"kind":"text","text":"name2"}],"kind":"container"},{"kind":"text","text":"\" user \""},{"children":[{"kind":"text","text":"name1"}],"kind":"container"},{"kind":"text","text":"\" didn't have the joke in his feed yet, and \""},{"children":[{"kind":"text","text":"name2"}],"kind":"container"},{"kind":"text","text":"\" already had it in his feed by the moment of repost. Polycarp was registered as \""},{"children":[{"kind":"text","text":"Polycarp"}],"kind":"container"},{"kind":"text","text":"\" and initially the joke was only in his feed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp measures the popularity of the joke as the length of the largest repost chain. Print the popularity of Polycarp's joke."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200"},{"kind":"text","text":") — the number of reposts. Next follow the reposts in the order they were made. Each of them is written on a single line and looks as \""},{"children":[{"kind":"text","text":"name1"}],"kind":"container"},{"children":[{"kind":"text","text":"reposted"}],"kind":"container"},{"children":[{"kind":"text","text":"name2"}],"kind":"container"},{"kind":"text","text":"\". All the names in the input consist of lowercase or uppercase English letters and/or digits and have lengths from 2 to 24 characters, inclusive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We know that the user names are case-insensitive, that is, two names that only differ in the letter case correspond to the same social network user."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maximum length of a repost chain."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\ntourist reposted Polycarp\nPetr reposted Tourist\nWJMZBMR reposted Petr\nsdya reposted wjmzbmr\nvepifanov reposted sdya\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\nMike reposted Polycarp\nMax reposted Polycarp\nEveryOne reposted Polycarp\n111 reposted Polycarp\nVkCup reposted Polycarp\nCodeforces reposted Polycarp\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\nSoMeStRaNgEgUe reposted PoLyCaRp\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"522A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/522/problem/A"}