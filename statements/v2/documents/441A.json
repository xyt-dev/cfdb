{"assets":[],"contentKind":"statement","contestId":"441","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Valera and Antique Items"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Valera is a collector. Once he wanted to expand his collection with exactly one antique item."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valera knows "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sellers of antiques, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them auctioned "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" items. Currently the auction price of the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th object of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th seller is "},{"kind":"math_inline","text":"sij"},{"kind":"text","text":". Valera gets on well with each of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sellers. He is perfectly sure that if he outbids the current price of one of the items in the auction (in other words, offers the seller the money that is strictly greater than the current price of the item at the auction), the seller of the object will immediately sign a contract with him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, Valera has only "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" units of money. Help him to determine which of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sellers he can make a deal with."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n, v"},{"kind":"math_inline","text":"(1 ≤ n ≤ 50; 104 ≤ v ≤ 106)"},{"kind":"text","text":" — the number of sellers and the units of money the Valera has."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line first contains integer "},{"kind":"math_inline","text":"ki"},{"kind":"math_inline","text":"(1 ≤ ki ≤ 50)"},{"kind":"text","text":" the number of items of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th seller. Then go "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"si1, si2, ..., siki"},{"kind":"math_inline","text":"(104 ≤ sij ≤ 106)"},{"kind":"text","text":" — the current prices of the items of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th seller. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, print integer "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" — the number of sellers with who Valera can make a deal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"q1, q2, ..., qp"},{"kind":"math_inline","text":"(1 ≤ qi ≤ n)"},{"kind":"text","text":" — the numbers of the sellers with who Valera can make a deal. Print the numbers of the sellers "},{"children":[{"kind":"text","text":"in the increasing order"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 50000\n1 40000\n2 20000 60000\n3 10000 70000 190000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 50000\n1 50000\n3 100000 120000 110000\n3 120000 110000 120000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Valera can bargain with each of the sellers. He can outbid the following items: a "},{"kind":"math_inline","text":"40000"},{"kind":"text","text":" item from the first seller, a "},{"kind":"math_inline","text":"20000"},{"kind":"text","text":" item from the second seller, and a "},{"kind":"math_inline","text":"10000"},{"kind":"text","text":" item from the third seller."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample Valera can not make a deal with any of the sellers, as the prices of all items in the auction too big for him."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"441A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/441/problem/A"}