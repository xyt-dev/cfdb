{"assets":[],"contentKind":"statement","contestId":"54","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Presents"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The Hedgehog likes to give presents to his friend, but no less he likes to receive them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Having received another present today, the Hedgehog suddenly understood that he has no place to put it as there was no room left on the special shelf in the cupboard. He will have to choose another shelf, but which one should he choose, how large should it be?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In order to get to know this, the Hedgehog asks you to write him a program that will count the estimated number of presents that he will receive during the following "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" days. Besides, he is guided by the principle: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" on each holiday day the Hedgehog will necessarily receive a present, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" he receives presents at least every "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" days (i.e., if he received a present on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day, he will receive the next present no later than on the "},{"kind":"math_inline","text":"i + K"},{"kind":"text","text":"-th day). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For the given "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"K"},{"kind":"text","text":", as well as the list of holidays among the following "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" days count the minimal number of presents that could be given to the Hedgehog. The number of today's day is zero, and you should regard today's present as already given (i.e., you shouldn't count it in the answer)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"K"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ N ≤ 365"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ K ≤ N"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a number "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" which represents the number of holidays ("},{"kind":"math_inline","text":"0 ≤ C ≤ N"},{"kind":"text","text":"). Then in the same line follow "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" numbers ranging from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" which are the numbers of holiday days. The numbers are given in the increasing order, without repeating numbers among them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the minimal number of presents the Hedgehog will receive over the following "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" days."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 1\n3 6 7 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"54A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/54/problem/A"}