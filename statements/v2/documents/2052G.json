{"assets":[],"contentKind":"statement","contestId":"2052","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Geometric Balance"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Peter's little brother Ivan likes to play with a turtle. The turtle is a special toy that lives on the plane and can execute three commands: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Rotate $$$a$$$ degrees counterclockwise. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Draw $$$d$$$ units in the direction it is facing while dispensing ink. No segment of the plane will be covered by ink more than once. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Move $$$d$$$ units in the direction it is facing without drawing. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Ivan just learned about the compass, so he will only rotate his turtle so it faces one of eight cardinal or ordinal directions (angles $$$a$$$ in rotate commands are always divisible by 45). Also, he will perform at least one draw command."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Peter has noted all the commands Ivan has given to his turtle. He thinks that the image drawn by the turtle is adorable. Now Peter wonders about the smallest positive angle $$$b$$$ such that he can perform the following operations: move the turtle to a point of his choosing, rotate it by $$$b$$$ degrees, and execute all the commands in the same order. These operations should produce the same image as the original one. Can you help Peter?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note, two images are considered "},{"children":[{"kind":"text","text":"the same"}],"kind":"container"},{"kind":"text","text":" if the sets of points covered by ink on the plane are the same in both of the images."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer $$$n\\;(1 \\le n \\le 50000)$$$ — the number of commands Ivan has given."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n$$$ lines contain commands. Each command is one of:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"rotate"}],"kind":"container"},{"kind":"text","text":" $$$a$$$\" ($$$45 \\le a \\le 360$$$) where $$$a$$$ is divisible by $$$45$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"draw"}],"kind":"container"},{"kind":"text","text":" $$$d$$$\" ($$$1 \\le d \\le 10^9$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"move"}],"kind":"container"},{"kind":"text","text":" $$$d$$$\" ($$$1 \\le d \\le 10^9$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"At least one and "},{"children":[{"kind":"text","text":"at most 2000"}],"kind":"container"},{"kind":"text","text":" of the commands are "},{"children":[{"kind":"text","text":"draw"}],"kind":"container"},{"kind":"text","text":". It is guaranteed that no segment of the plane will be covered by ink more than once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single number, the answer to the question. The answer always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n1\ndraw 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n180\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\ndraw 1\nrotate 90\ndraw 1\nrotate 90\ndraw 1\nrotate 90\ndraw 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n90\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\ndraw 1\nmove 1\ndraw 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n360\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"2052G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2052/problem/G"}