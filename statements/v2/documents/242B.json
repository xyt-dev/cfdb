{"assets":[],"contentKind":"statement","contestId":"242","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Big Segment"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A coordinate line has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" segments, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th segment starts at the position "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and ends at the position "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":". We will denote such a segment as "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have suggested that one of the defined segments covers all others. In other words, there is such segment in the given set, which contains all other ones. Now you want to test your assumption. Find in the given set the segment which covers all other segments, and print its number. If such a segment doesn't exist, print -1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally we will assume that segment "},{"kind":"math_inline","text":"[a, b]"},{"kind":"text","text":" covers segment "},{"kind":"math_inline","text":"[c, d]"},{"kind":"text","text":", if they meet this condition "},{"kind":"math_inline","text":"a ≤ c ≤ d ≤ b"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of segments. Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the descriptions of the segments. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two space-separated integers "},{"kind":"math_inline","text":"li, ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ 109"},{"kind":"text","text":") — the borders of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th segment."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that no two segments coincide."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of the segment that covers all other segments in the set. If there's no solution, print -1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The segments are numbered starting from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" in the order in which they appear in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1\n2 2\n3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 5\n2 3\n1 10\n7 10\n7 7\n10 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"242B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/242/problem/B"}