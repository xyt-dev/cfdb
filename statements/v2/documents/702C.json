{"assets":[],"contentKind":"statement","contestId":"702","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Cellular Network"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" points on the straight line — the positions ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-coordinates) of the cities and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" points on the same line — the positions ("},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-coordinates) of the cellular towers. All towers work in the same way — they provide cellular network for all cities, which are located at the distance which is no more than "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" from this tower."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find minimal "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" that each city has been provided by cellular network, i.e. for each city there is at least one cellular tower at the distance which is no more than "},{"kind":"math_inline","text":"r"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If "},{"kind":"math_inline","text":"r = 0"},{"kind":"text","text":" then a tower provides cellular network only for the point where it is located. One tower can provide cellular network for any number of cities, but all these cities must be at the distance which is no more than "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" from this tower."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":") — the number of cities and the number of cellular towers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ ai ≤ 109"},{"kind":"text","text":") — the coordinates of cities. It is allowed that there are any number of cities in the same point. All coordinates "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" are given in non-decreasing order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a sequence of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"b1, b2, ..., bm"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ bj ≤ 109"},{"kind":"text","text":") — the coordinates of cellular towers. It is allowed that there are any number of towers in the same point. All coordinates "},{"kind":"math_inline","text":"bj"},{"kind":"text","text":" are given in non-decreasing order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print minimal "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" so that each city will be covered by cellular network."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n-2 2 4\n-3 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n1 5 10 14 17\n4 11 15\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"702C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/702/problem/C"}