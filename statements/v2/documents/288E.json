{"assets":[],"contentKind":"statement","contestId":"288","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Polo the Penguin and Lucky Numbers"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Everybody knows that lucky numbers are positive integers that contain only lucky digits 4 and 7 in their decimal representation. For example, numbers 47, 744, 4 are lucky and 5, 17, 467 are not."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polo the Penguin have two positive integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"(l < r)"},{"kind":"text","text":", both of them are lucky numbers. Moreover, their lengths (that is, the number of digits in the decimal representation without the leading zeroes) are equal to each other."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's assume that "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the number of distinct lucky numbers, each of them cannot be greater than "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" or less than "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th (in increasing order) number of them. Find "},{"kind":"math_inline","text":"a1·a2 + a2·a3 + ... + an - 1·an"},{"kind":"text","text":". As the answer can be rather large, print the remainder after dividing it by "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a positive integer "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", and the second line contains a positive integer "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l < r ≤ 10100000"},{"kind":"text","text":"). The numbers are given without any leading zeroes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the lengths of the given numbers are equal to each other and that both of them are lucky numbers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the single line print a single integer — the answer to the problem modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"28\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"474\n777\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2316330\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"288E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/288/problem/E"}