{"assets":[],"contentKind":"statement","contestId":"263","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Beautiful Matrix"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got a "},{"kind":"math_inline","text":"5 × 5"},{"kind":"text","text":" matrix, consisting of "},{"kind":"math_inline","text":"24"},{"kind":"text","text":" zeroes and a single number one. Let's index the matrix rows by numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" from top to bottom, let's index the matrix columns by numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" from left to right. In one move, you are allowed to apply one of the two following transformations to the matrix:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Swap two neighboring matrix rows, that is, rows with indexes "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" for some integer "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i < 5)"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Swap two neighboring matrix columns, that is, columns with indexes "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" and "},{"kind":"math_inline",