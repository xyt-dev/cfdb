{"assets":["/statement-assets/55c492e51324032b057a63db6e2635d7b3d7aeaa3303bd7a11da5ac4bf002605.png","/statement-assets/a73c873bfce9256050b174f698b862e42e13d9b4b929897b6c8e12cba81195d3.png","/statement-assets/481962960bb374e777aa2b93ae8db3e1f1896d0409142ef501a9017b24e69dd9.png","/statement-assets/8ac3602a86a356b07b5f224ad5d8f919706d7324a8c2ce2d29d210ec98863319.png","/statement-assets/a057b62f5f1b63e92f4d33343e17ad5129317ec4f8e1b43f7ffbe5407df73d1d.png","/statement-assets/9946e87c8ed23348941374b2d0d256d444656649dafbda39bd9e933203902970.png","/statement-assets/f6651a61b855bb6a74dfec560d04c6e0b26b58537698be6bc29fa93c29614bb2.png","/statement-assets/437d67c5177af68444953883de31ef90dd3078a0d6aabc57f052049006f53e86.png","/statement-assets/b50c12a6839ba1876bc4977db608dc34a335295db40146e797c24c3abc5163f0.png","/statement-assets/485bf313bece6fe30ee8229a9e178fe658d6f1b64cf75d3b40db44f5a90b5dad.png"],"contentKind":"statement","contestId":"902","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Coloring a Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a rooted tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. The vertices are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", the root is the vertex number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each vertex has a color, let's denote the color of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"cv"},{"kind":"text","text":". Initially "},{"kind":"math_inline","text":"cv = 0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to color the tree into the given colors using the smallest possible number of steps. On each step you can choose a vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and a color "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", and then color all vectices in the subtree of "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" (including "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" itself) in color "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". In other words, for every vertex "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", such that the path from root to "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" passes through "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", set "},{"kind":"math_inline","text":"cu = x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that you have to color each vertex in a color different from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can learn what a rooted tree is using the link: "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Tree_(graph_theory)"},"children":[{"kind":"text","text":"https://en.wikipedia.org/wiki/Tree_(graph_theory)"}],"kind":"link"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 104"},{"kind":"text","text":") — the number of vertices in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"p2, p3, ..., pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi < i"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" means that there is an edge between vertices "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci ≤ n"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" is the color you should color the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex into."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given graph is a tree. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum number of steps you have to perform to color the tree into given colors."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 2 2 1 5\n2 1 1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 1 2 3 1 4\n3 3 1 1 1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The tree from the first sample is shown on the picture (numbers are vetices' indices):"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/55c492e51324032b057a63db6e2635d7b3d7aeaa3303bd7a11da5ac4bf002605.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On first step we color all vertices in the subtree of vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" into color "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" (numbers are colors):"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/a73c873bfce9256050b174f698b862e42e13d9b4b929897b6c8e12cba81195d3.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On seond step we color all vertices in the subtree of vertex "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" into color "},{"kind":"math_inline","text":"1"},{"kind":"text","text":":"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/481962960bb374e777aa2b93ae8db3e1f1896d0409142ef501a9017b24e69dd9.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On third 