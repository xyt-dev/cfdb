{"assets":[],"contentKind":"statement","contestId":"403","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Two Rooted Trees"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have two rooted undirected trees, each contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. Let's number the vertices of each tree with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The root of each tree is at vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". The edges of the first tree are painted blue, the edges of the second one are painted red. For simplicity, let's say that the first tree is blue and the second tree is red."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Edge "},{"kind":"math_inline","text":"{x, y}"},{"kind":"text","text":" is called bad for edge "},{"kind":"math_inline","text":"{p, q}"},{"kind":"text","text":" if two conditions are fulfilled: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The color of edge "},{"kind":"math_inline","text":"{x, y}"},{"kind":"text","text":" is different from the color of edge "},{"kind":"math_inline","text":"{p, q}"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Let's consider the tree of the same color that edge "},{"kind":"math_inline","text":"{p, q}"},{"kind":"text","text":" is. Exactly one of vertices "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" lies both in the subtree of vertex "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and in the subtree of vertex "},{"kind":"math_inline","text":"q"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In this problem, your task is to simulate the process described below. The process consists of several stages:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" On each stage edges of exactly one color are deleted. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" On the first stage, exactly one blue edge is deleted. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Let's assume that at the stage "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" we've deleted edges "},{"kind":"math_inline","text":"{u1, v1}"},{"kind":"text","text":", "},{"kind":"math_inline","text":"{u2, v2}"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"{uk, vk}"},{"kind":"text","text":". At the stage "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" we will delete all undeleted bad edges for edge "},{"kind":"math_inline","text":"{u1, v1}"},{"kind":"text","text":", then we will delete all undeleted bad edges for edge "},{"kind":"math_inline","text":"{u2, v2}"},{"kind":"text","text":" and so on until we reach edge "},{"kind":"math_inline","text":"{uk, vk}"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For each stage of deleting edges determine what edges will be removed on the stage. Note that the definition of a bad edge always considers the initial tree before it had any edges removed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2·105"},{"kind":"text","text":") — the number of vertices in each tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"a2, a3, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ n; ai ≠ i"},{"kind":"text","text":") — the description of edges of the first tree. Number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" means that the first tree has an edge connecting vertex "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"b2, b3, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ n; bi ≠ i"},{"kind":"text","text":") — the description of the edges of the second tree. Number "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" means that the second tree has an edge connecting vertex "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" and vertex "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains integer "},{"kind":"math_inline","text":"idx"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ idx < n"},{"kind":"text","text":") — the index of the blue edge that was removed on the first stage. Assume that the edges of each tree are numbered with numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" in the order in which they are given in the input. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each stage of removing edges print its description. Each description must consist of exactly two lines. If this is the stage when blue edges are deleted, then the first line of the description must contain word "},{"kind":"math_inline","text":"Blue"},{"kind":"text","text":", otherwise — word "},{"kind":"math_inline","text":"Red"},{"kind":"text","text":". In the second line print the indexes of the edges that will be deleted on this stage in the increasing order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 1 1 1\n4 2 1 1\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Blue\n3\nRed\n1 3\nBlue\n1 2\nRed\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For simplicity let's assume that all edges of the root tree received some direction, so that all vertices are reachable from vertex "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Then a "},{"children":[{"kind":"text","text":"subtree"}],"kind":"container"},{"kind":"text","text":" of vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is a set of vertices reachable from vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" in the resulting directed graph (vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is also included in the set)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"403E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/403/problem/E"}