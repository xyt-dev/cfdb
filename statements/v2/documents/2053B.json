{"assets":[],"contentKind":"statement","contestId":"2053","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Outstanding Impressionist"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"children":[{"kind":"text","text":"If it was so, then let's make it a deal..."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"— MayDay, "},{"attrs":{"href":"https://www.youtube.com/watch?v=mtAc_bMYBsM&list=PLj6NQzHFCvkHKIm0Vnk9LH3odqTIBRZ1Q&index=15"},"children":[{"children":[{"kind":"text","text":"Gentleness"}],"kind":"container"}],"kind":"link"}],"kind":"container"}],"kind":"container"},{"children":[{"children":[{"kind":"text","text":"Even after copying the paintings from famous artists for ten years, unfortunately, Eric is still unable to become a skillful impressionist painter. He wants to forget something, but the white bear phenomenon just keeps hanging over him."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Eric still remembers $$$n$$$ pieces of impressions in the form of an integer array. He records them as $$$w_1, w_2, \\ldots, w_n$$$. However, he has a poor memory of the impressions. For each $$$1 \\leq i \\leq n$$$, he can only remember that $$$l_i \\leq w_i \\leq r_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Eric believes that impression $$$i$$$ is "},{"children":[{"kind":"text","text":"unique"}],"kind":"container"},{"kind":"text","text":" if and only if there exists a possible array $$$w_1, w_2, \\ldots, w_n$$$ such that $$$w_i \\neq w_j$$$ holds for all $$$1 \\leq j \\leq n$$$ with $$$j \\neq i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please help Eric determine whether impression $$$i$$$ is "},{"children":[{"kind":"text","text":"unique"}],"kind":"container"},{"kind":"text","text":" for every $$$1 \\leq i \\leq n$$$, "},{"children":[{"kind":"text","text":"independently"}],"kind":"container"},{"kind":"text","text":" for each $$$i$$$. Perhaps your judgment can help rewrite the final story."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line of the input contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 10^4$$$) — the number of test cases. The description of test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\leq n \\leq 2\\cdot 10^5$$$) — the number of impressions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$n$$$ lines follow, the $$$i$$$-th containing two integers $$$l_i$$$ and $$$r_i$$$ ($$$1 \\leq l_i \\leq r_i \\leq 2\\cdot n$$$) — the minimum possible value and the maximum possible value of $$$w_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2\\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a binary string $$$s$$$ of length $$$n$$$: for each $$$1 \\leq i \\leq n$$$, if impression $$$i$$$ is "},{"children":[{"kind":"text","text":"unique"}],"kind":"container"},{"kind":"text","text":", $$$s_i=\\texttt{1}$$$; otherwise, $$$s_i=\\texttt{0}$$$. Do "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" output spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n2\n1 1\n1 1\n4\n1 3\n1 3\n1 3\n1 3\n6\n3 6\n2 2\n1 2\n1 1\n3 4\n2 2\n7\n3 4\n4 4\n4 4\n1 3\n2 5\n1 4\n2 2\n3\n4 5\n4 4\n5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n00\n1111\n100110\n1001111\n011\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the only possible array $$$w$$$ is $$$[1, 1]$$$, making neither impression $$$1$$$ nor $$$2$$$ "},{"children":[{"kind":"text","text":"unique"}],"kind":"container"},{"kind":"text","text":" (since $$$w_1 = w_2$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, all impressions can be made "},{"children":[{"kind":"text","text":"unique"}],"kind":"container"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" For $$$i = 1$$$, we can set $$$w$$$ to $$$[1, 3, 2, 3]$$$, in which $$$w_1 \\neq w_2$$$, $$$w_1 \\neq w_3$$$, and $$$w_1 \\neq w_4$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$i = 2$$$, we can set $$$w$$$ to $$$[2, 3, 1, 2]$$$, in which $$$w_2 \\neq w_1$$$, $$$w_2 \\neq w_3$$$, and $$$w_2 \\neq w_4$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$i = 3$$$, we can set $$$w$$$ to $$$[1, 1, 3, 1]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For $$$i = 4$$$, we can set $$$w$$$ to $$$[2, 3, 3, 1]$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the third test case, for $$$i = 4$$$, we can set $$$w$$$ to $$$[3, 2, 2, 1, 3, 2]$$$. Thus, impression $$$4$$$ is "},{"children":[{"kind":"text","text":"unique"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"2053B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2053/problem/B"}