{"assets":["/statement-assets/3e8181bf913d6b14a1e97f76f7eed88712bd25725beeb4d07dc321ab91e77051.png","/statement-assets/971bbf58ce1c38cf53f14e27273cc7f4fee0968d0d7522ae62f0830df615299f.png","/statement-assets/20b2b4a8f956e1ee95c0c7f2df0d4bd7fc35b82c6d8a70cbcd6ad3ce2873d4cc.png","/statement-assets/b1cff6afc1ccd1b23cc2fd822f4af1730bc7b8b654e67c67d691ba07d52eb0c9.png","/statement-assets/c63d1789e70977a819e66f08e5c735f2101b17c216618e5eb6cd69224831fd32.png"],"contentKind":"statement","contestId":"336","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Vasily the Bear and Fly"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One beautiful day Vasily the bear painted "},{"kind":"math_inline","text":"2m"},{"kind":"text","text":" circles of the same radius "},{"kind":"math_inline","text":"R"},{"kind":"text","text":" on a coordinate plane. Circles with numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" had centers at points "},{"kind":"math_inline","text":"(2R - R, 0)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(4R - R, 0)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2Rm - R, 0)"},{"kind":"text","text":", respectively. Circles with numbers from "},{"kind":"math_inline","text":"m + 1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"2m"},{"kind":"text","text":" had centers at points "},{"kind":"math_inline","text":"(2R - R, 2R)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(4R - R, 2R)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2Rm - R, 2R)"},{"kind":"text","text":", respectively. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Naturally, the bear painted the circles for a simple experiment with a fly. The experiment continued for "},{"kind":"math_inline","text":"m2"},{"kind":"text","text":" days. Each day of the experiment got its own unique number from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m2 - 1"},{"kind":"text","text":", inclusive. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the day number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" the following things happened: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The fly arrived at the coordinate plane at the center of the circle with number "},{"attrs":{"alt":"","src":"/statement-assets/3e8181bf913d6b14a1e97f76f7eed88712bd25725beeb4d07dc321ab91e77051.png"},"kind":"image"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/971bbf58ce1c38cf53f14e27273cc7f4fee0968d0d7522ae62f0830df615299f.png"},"kind":"image"},{"kind":"text","text":" is the result of dividing number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by number "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", rounded down to an integer). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The fly went along the coordinate plane to the center of the circle number "},{"attrs":{"alt":"","src":"/statement-assets/20b2b4a8f956e1ee95c0c7f2df0d4bd7fc35b82c6d8a70cbcd6ad3ce2873d4cc.png"},"kind":"image"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/b1cff6afc1ccd1b23cc2fd822f4af1730bc7b8b654e67c67d691ba07d52eb0c9.png"},"kind":"image"},{"kind":"text","text":" is the remainder after dividing number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by number "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"). The bear noticed that the fly went from the center of circle "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to the center of circle "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" along the shortest path with all points lying on the border or inside at least one of the "},{"kind":"math_inline","text":"2m"},{"kind":"text","text":" circles. After the fly reached the center of circle "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", it flew away in an unknown direction. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Vasily, count the average distance the fly went along the coordinate plane during each of these "},{"kind":"math_inline","text":"m2"},{"kind":"text","text":" days."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"m, R"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ R ≤ 10"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print a single real number — the answer to the problem. The answer will be considered correct if its absolute or relative error doesn't exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2.0000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5.4142135624\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c63d1789e70977a819e66f08e5c735f2101b17c216618e5eb6cd69224831fd32.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Figure to the second sample"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"336B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/336/problem/B"}