{"assets":[],"contentKind":"statement","contestId":"2085","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Serval and The Formula"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given two positive integers $$$x$$$ and $$$y$$$ ($$$1\\le x, y\\le 10^9$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find a "},{"children":[{"kind":"text","text":"non-negative"}],"kind":"container"},{"kind":"text","text":" integer $$$k\\le 10^{18}$$$, such that $$$(x+k) + (y+k) = (x+k)\\oplus (y+k)$$$ holds$$$^{\\text{∗}}$$$, or determine that such an integer does not exist."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$$$$\\oplus$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise XOR operation"}],"kind":"link"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains two integers $$$x$$$ and $$$y$$$ ($$$1\\le x, y\\le 10^9$$$) — the given integers."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output a single integer $$$k$$$ ($$$0\\le k\\le 10^{18}$$$) — the integer you found. Print $$$-1$$$ if it is impossible to find such an integer."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, you may print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n2 5\n6 6\n19 10\n1024 4096\n1198372 599188\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n-1\n1\n1024\n28\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, since $$$(2 + 0) + (5 + 0) = (2 + 0) \\oplus (5 + 0) = 7$$$, $$$k=0$$$ is a possible answer. Note that $$$k=4$$$ is also a possible answer because $$$(2 + 4) + (5 + 4) = (2 + 4) \\oplus (5 + 4) = 15$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, $$$(x+k)\\oplus (y+k) = (6+k)\\oplus (6+k) = 0$$$. However, $$$(x+k)+(y+k) \\gt 0$$$ holds for every $$$k \\ge 0$$$, implying that such an integer $$$k$$$ does not exist."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"2085C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2085/problem/C"}