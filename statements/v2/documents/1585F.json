{"assets":[],"contentKind":"statement","contestId":"1585","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Non-equal Neighbours"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array of $$$n$$$ positive integers $$$a_1, a_2, \\ldots, a_n$$$. Your task is to calculate the number of arrays of $$$n$$$ positive integers $$$b_1, b_2, \\ldots, b_n$$$ such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1 \\le b_i \\le a_i$$$ for every $$$i$$$ ($$$1 \\le i \\le n$$$), and "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$b_i \\neq b_{i+1}$$$ for every $$$i$$$ ($$$1 \\le i \\le n - 1$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The number of such arrays can be very large, so print it modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the length of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind"