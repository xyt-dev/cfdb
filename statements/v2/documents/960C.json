{"assets":[],"contentKind":"statement","contestId":"960","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Subsequence Counting"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pikachu had an array with him. He wrote down all the non-empty subsequences of the array on paper. Note that an array of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" has "},{"kind":"math_inline","text":"2n - 1"},{"kind":"text","text":" non-empty subsequences in it. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pikachu being mischievous as he always is, removed all the subsequences in which "},{"children":[{"kind":"text","text":"Maximum_element_of_the_subsequence"}],"kind":"container"},{"kind":"math_inline","text":" - "},{"children":[{"kind":"text","text":"Minimum_element_of_subsequence"}],"kind":"container"},{"kind":"math_inline","text":" ≥ d"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pikachu was finally left with "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" subsequences. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, he lost the initial array he had, and now is in serious trouble. He still remembers the numbers "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". He now wants you to construct any such array which will satisfy the above conditions. All the numbers in the final array should be positive integers less than "},{"kind":"math_inline","text":"1018"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note the number of elements in the output array should not be more than "},{"kind":"math_inline","text":"104"},{"kind":"text","text":". If no answer is possible, print "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of input consists of two space separated integers "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ X, d ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output should consist of two lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"First line should contain a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10 000"},{"kind":"text","text":")— the number of integers in the final array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Second line should consist of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space separated integers — "},{"kind":"math_inline","text":"a1, a2, ... , an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai < 1018"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is no answer, print a single integer "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n5 50 7 15 6 100"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n10 100 1000 10000"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the output of the first example case, the remaining subsequences after removing those with "},{"children":[{"kind":"text","text":"Maximum_element_of_the_subsequence"}],"kind":"container"},{"kind":"math_inline","text":" - "},{"children":[{"kind":"text","text":"Minimum_element_of_subsequence"}],"kind":"container"},{"kind":"math_inline","text":" ≥ 5"},{"kind":"text","text":" are "},{"kind":"math_inline","text":"[5], [5, 7], [5, 6], [5, 7, 6], [50], [7], [7, 6], [15], [6], [100]"},{"kind":"text","text":". There are "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" of them. Hence, the array "},{"kind":"math_inline","text":"[5, 50, 7, 15, 6, 100]"},{"kind":"text","text":" is valid."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Similarly, in the output of the second example case, the remain