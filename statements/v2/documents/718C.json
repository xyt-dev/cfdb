{"assets":["/statement-assets/2faf8e98720b71480cac3fd68dc1b9060e26b9e431194346f3675644898de285.png"],"contentKind":"statement","contestId":"718","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Sasha and Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sasha has an array of integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". You have to perform "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries. There might be queries of two types:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"children":[{"kind":"text","text":"1 l r x"}],"kind":"container"},{"kind":"text","text":" — increase all integers on the segment from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" by values "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"2 l r"}],"kind":"container"},{"kind":"text","text":" — find "},{"attrs":{"alt":"","src":"/statement-assets/2faf8e98720b71480cac3fd68dc1b9060e26b9e431194346f3675644898de285.png"},"kind":"image"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"f(x)"},{"kind":"text","text":" is the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-th Fibonacci number. As this number may be large, you only have to find it modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In this problem we define Fibonacci numbers as follows: "},{"kind":"math_inline","text":"f(1) = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f(2) = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f(x) = f(x - 1) + f(x - 2)"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"x > 2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Sasha is a very talented boy and he managed to perform all queries in five seconds. Will you be able to write the program that performs as well as Sasha?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 100 000"},{"kind":"text","text":") — the number of elements in the array and the number of queries respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines with queries descriptions. Each of them contains integers "},{"kind":"math_inline","text":"tpi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and may be "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ tpi ≤ 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ xi ≤ 109"},{"kind":"text","text":"). Here "},{"kind":"math_inline","text":"tpi = 1"},{"kind":"text","text":" corresponds to the queries of the first type and "},{"kind":"math_inline","text":"tpi"},{"kind":"text","text":" corresponds to the queries of the second type."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the input will contains at least one query of the second type."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the second type print the answer modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n1 1 2 1 1\n2 1 5\n1 2 4 2\n2 2 4\n2 1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n7\n9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Initially, array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer for the first query of the second type is "},{"kind":"math_inline","text":"f(1) + f(1) + f(2) + f(1) + f(1) = 1 + 1 + 1 + 1 + 1 = 5"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the query "},{"children":[{"kind":"text","text":"1 2 4 2"}],"kind":"container"},{"kind":"text","text":" array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer for the second query of the second type is "},{"kind":"math_inline","text":"f(3) + f(4) + f(3) = 2 + 3 + 2 = 7"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The answer for the third query of the second type is "},{"kind":"math_inline","text":"f(1) + f(3) + f(4) + f(3) + f(1) = 1 + 2 + 3 + 2 + 1 = 9"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"718C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/718/problem/C"}