{"assets":["/statement-assets/09f0bc3bd5c884e4930326c74d3cd8010ba915e94b1863cded3fcd40f6d644d5.png"],"contentKind":"statement","contestId":"193","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Cutting Figure"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've gotten an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" sheet of squared paper. Some of its squares are painted. Let's mark the set of all painted squares as "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". Set "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is connected. Your task is to find the minimum number of squares that we can delete from set "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" to make it not connected."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A set of painted squares is called "},{"children":[{"kind":"text","text":"connected"}],"kind":"container"},{"kind":"text","text":", if for every two squares "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" from this set there is a sequence of squares from the set, beginning in "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and ending in "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", such that in this sequence any square, except for the last one, shares a common side with the square that follows next in the sequence. An empty set and a set consisting of exactly one square are connected by definition."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 50"},{"kind":"text","text":") — the sizes of the sheet of paper. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters — the description of the sheet of paper: the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th character of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line equals either \"#\", if the corresponding square is painted (belongs to set "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"), or equals \".\" if the corresponding square is not painted (does not belong to set "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"). It is guaranteed that the set of all painted squares "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" is connected and isn't empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first line print the minimum number of squares that need to be deleted to make set "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" not connected. If it is impossible, print -1. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n####\n#..#\n#..#\n#..#\n####\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n#####\n#...#\n#####\n#...#\n#####\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample you can delete any two squares that do not share a side. After that the set of painted squares is not connected anymore."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The note to the second sample is shown on the figure below. To the left there is a picture of the initial set of squares. To the right there is a set with deleted squares. The deleted squares are marked with crosses. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/09f0bc3bd5c884e4930326c74d3cd8010ba915e94b1863cded3fcd40f6d644d5.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"193A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/193/problem/A"}