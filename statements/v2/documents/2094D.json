{"assets":[],"contentKind":"statement","contestId":"2094","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Tung Tung Sahur"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have two drums in front of you: a left drum and a right drum. A hit on the left can be recorded as \""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\", and a hit on the right as \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The strange forces that rule this world are fickle: sometimes, a blow sounds once, and sometimes it sounds twice. Therefore, a hit on the left drum could have sounded as either \""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"LL"}],"kind":"container"},{"kind":"text","text":"\", and a hit on the right drum could have sounded as either \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"RR"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sequence of hits made is recorded in the string $$$p$$$, and the sounds heard are in the string $$$s$$$. Given $$$p$$$ and $$$s$$$, determine whether it is true that the string $$$s$$$ could have been the result of the hits from the string $$$p$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if $$$p=$$$\""},{"children":[{"kind":"text","text":"LR"}],"kind":"container"},{"kind":"text","text":"\", then the result of the hits could be any of the strings \""},{"children":[{"kind":"text","text":"LR"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"LRR"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"LLR"}],"kind":"container"},{"kind":"text","text":"\", and \""},{"children":[{"kind":"text","text":"LLRR"}],"kind":"container"},{"kind":"text","text":"\", but the strings \""},{"children":[{"kind":"text","text":"LLLR"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"LRL"}],"kind":"container"},{"kind":"text","text":"\" cannot."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$t$$$ ($$$1 \\leq t \\leq 10^4$$$) – the number of independent test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains the string $$$p$$$ ($$$1 \\le |p| \\le 2 \\cdot 10^5$$$) consisting only of the characters \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\", where $$$|p|$$$ denotes the length of the string $$$p$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains the string $$$s$$$ ($$$1 \\le |p| \\le |s| \\le 2 \\cdot 10^5$$$) consisting only of the characters \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$|s|$$$ does not exceed $$$2\\cdot 10^5$$$ across all test cases."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each set of input data, output \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if $$$s$$$ can be the heard sound, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise. You may output in any case."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\nR\nRR\nLRLR\nLRLR\nLR\nLLLR\nLLLLLRL\nLLLLRRLL\nLLRLRLRRL\nLLLRLRRLLRRRL\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nYES\nNO\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"2094D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2094/problem/D"}