{"assets":["/statement-assets/65da69a0a4a098b4c517bd91c6570c22fc1d687a061b7291d2a38db38fe8b34c.png"],"contentKind":"statement","contestId":"955","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Feed the cat"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After waking up at "},{"kind":"math_inline","text":"hh"},{"kind":"text","text":":"},{"kind":"math_inline","text":"mm"},{"kind":"text","text":", Andrew realised that he had forgotten to feed his only cat for yet another time (guess why there's only one cat). The cat's current hunger level is "},{"kind":"math_inline","text":"H"},{"kind":"text","text":" points, moreover each minute without food increases his hunger by "},{"kind":"math_inline","text":"D"},{"kind":"text","text":" points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At any time Andrew can visit the store where tasty buns are sold (you can assume that is doesn't take time to get to the store and back). One such bun costs "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" roubles and decreases hunger by "},{"kind":"math_inline","text":"N"},{"kind":"text","text":" points. Since the demand for bakery drops heavily in the evening, there is a special "},{"kind":"math_inline","text":"20%"},{"kind":"text","text":" discount for buns starting from "},{"kind":"math_inline","text":"20"},{"kind":"text","text":":"},{"kind":"math_inline","text":"00"},{"kind":"text","text":" (note that the cost might become rational). Of course, buns cannot be sold by parts."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the minimum amount of money Andrew has to spend in order to feed his cat. The cat is considered fed if its hunger level is less than or equal to zero."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"hh"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"mm"},{"kind":"math_inline","text":"(00 ≤ hh ≤ 23, 00 ≤ mm ≤ 59)"},{"kind":"text","text":" — the time of Andrew's awakening."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains four integers "},{"kind":"math_inline","text":"H"},{"kind":"text","text":", "},{"kind":"math_inline","text":"D"},{"kind":"text","text":", "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"N"},{"kind":"math_inline","text":"(1 ≤ H ≤ 105, 1 ≤ D, C, N ≤ 102)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the minimum amount of money to within three decimal digits. You answer is considered correct, if its absolute or relative error does not exceed "},{"kind":"math_inline","text":"10 - 4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, let your answer be "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and the jury's answer be "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Your answer is considered correct if "},{"attrs":{"alt":"","src":"/statement-assets/65da69a0a4a098b4c517bd91c6570c22fc1d687a061b7291d2a38db38fe8b34c.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"19 00\n255 1 100 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"25200.0000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"17 41\n1000 6 15 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1365.0000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Andrew can visit the store at exactly "},{"kind":"math_inline","text":"20"},{"kind":"text","text":":"},{"kind":"math_inline","text":"00"},{"kind":"text","text":". The cat's hunger will be equal to "},{"kind":"math_inline","text":"315"},{"kind":"text","text":", hence it will be necessary to purchase "},{"kind":"math_inline","text":"315"},{"kind":"text","text":" buns. The discount makes the final answer "},{"kind":"math_inline","text":"25200"},{"kind":"text","text":" roubles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample it's optimal to visit the store right after he wakes up. Then he'll have to buy "},{"kind":"math_inline","text":"91"},{"kind":"text","text":" bins per "},{"kind":"math_inline","text":"15"},{"kind":"text","text":" roubles each and spend a total of "},{"kind":"math_inline","text":"1365"},{"kind":"text","text":" roubles."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"955A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/955/problem/A"}