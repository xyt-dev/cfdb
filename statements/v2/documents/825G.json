{"assets":[],"contentKind":"statement","contestId":"825","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Tree Queries"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a tree consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices (numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"). Initially all vertices are white. You have to process "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries of two different types:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"x"},{"kind":"text","text":" — change the color of vertex "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to black. It is guaranteed that the first query will be of this type. "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"x"},{"kind":"text","text":" — for the vertex "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", find the minimum index "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" such that the vertex with index "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" belongs to the simple path from "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to some black vertex (a simple path never visits any vertex more than once). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For each query of type "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" print the answer to it."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note that the queries are given in modified way"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n, q ≤ 106"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines follow, each line containing two numbers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi < yi ≤ n"},{"kind":"text","text":") and representing the edge between vertices "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that these edges form a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines follow. Each line contains two integers "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"zi"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" is the type of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th query, and "},{"kind":"math_inline","text":"zi"},{"kind":"text","text":" can be used to restore "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" for this query in this way: you have to keep track of the answer to the last query of type "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" (let's call this answer "},{"kind":"math_inline","text":"last"},{"kind":"text","text":", and initially "},{"kind":"math_inline","text":"last = 0"},{"kind":"text","text":"); then "},{"kind":"math_inline","text":"xi = (zi + last) mod n + 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the first query is of type "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", and there is at least one query of type "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of type "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" output the answer to it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 6\n1 2\n2 3\n3 4\n1 2\n1 2\n2 2\n1 3\n2 2\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n2\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"825G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/825/problem/G"}