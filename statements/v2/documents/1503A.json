{"assets":[],"contentKind":"statement","contestId":"1503","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Balance the Bits"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A sequence of brackets is called balanced if one can turn it into a valid math expression by adding characters '"},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"'. For example, sequences '"},{"children":[{"kind":"text","text":"(())()"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"()"}],"kind":"container"},{"kind":"text","text":"', and '"},{"children":[{"kind":"text","text":"(()(()))"}],"kind":"container"},{"kind":"text","text":"' are balanced, while '"},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"(()"}],"kind":"container"},{"kind":"text","text":"', and '"},{"children":[{"kind":"text","text":"(()))("}],"kind":"container"},{"kind":"text","text":"' are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a binary string $$$s$$$ of length $$$n$$$. Construct two balanced bracket sequences $$$a$$$ and $$$b$$$ of length $$$n$$$ such that for all $$$1\\le i\\le n$$$: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if $$$s_i=1$$$, then $$$a_i=b_i$$$ "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if