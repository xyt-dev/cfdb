f there are multiple solutions, you may print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n6\n101101\n10\n1001101101\n4\n1100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n()()()\n((()))\nYES\n()()((()))\n(())()()()\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, $$$a=$$$\""},{"children":[{"kind":"text","text":"()()()"}],"kind":"container"},{"kind":"text","text":"\" and $$$b=$$$\""},{"children":[{"kind":"text","text":"((()))"}],"kind":"container"},{"kind":"text","text":"\". The characters are equal in positions $$$1$$$, $$$3$$$, $$$4$$$, and $$$6$$$, which are the exact same positions where $$$s_i=1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, $$$a=$$$\""},{"children":[{"kind":"text","text":"()()((()))"}],"kind":"container"},{"kind":"text","text":"\" and $$$b=$$$\""},{"children":[{"kind":"text","text":"(())()()()"}],"kind":"container"},{"kind":"text","text":"\". The characters are equal in positions $$$1$$$, $$$4$$$, $$$5$$$, $$$7$$$, $$$8$$$, $$$10$$$, which are the exact same positions where $$$s_i=1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, there is no solution."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1503A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/