{"assets":["/statement-assets/5bcd196da347ef4c54024c7ee4afecef121d9ba9eb4b6c9a5a0599e01fec427c.png"],"contentKind":"statement","contestId":"543","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Listening to Music"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"7 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Please note that the memory limit differs from the standard."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You really love to listen to music. During the each of next "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" days you will listen to exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" songs from the playlist that consists of exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" songs. Let's number the songs from the playlist with numbers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", inclusive. The quality of song number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day you choose some integer "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"li ≤ v ≤ ri"},{"kind":"text","text":") and listen to songs number "},{"kind":"math_inline","text":"v, v + 1, ..., v + m - 1"},{"kind":"text","text":". On the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day listening to one song with quality less than "},{"kind":"math_inline","text":"qi"},{"kind":"text","text":" increases your displeasure by exactly one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine what minimum displeasure you can get on each of the "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" next days. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ n ≤ 2·105"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai < 230"},{"kind":"text","text":") — the description of songs from the playlist. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains a single number "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ s ≤ 2·105"},{"kind":"text","text":") — the number of days that you consider."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" lines contain three integers each "},{"kind":"math_inline","text":"li, ri, xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n - m + 1"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"0 ≤ xi < 230"},{"kind":"text","text":") — the description of the parameters for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day. In order to calculate value "},{"kind":"math_inline","text":"qi"},{"kind":"text","text":", you need to use formula: "},{"attrs":{"alt":"","src":"/statement-assets/5bcd196da347ef4c54024c7ee4afecef121d9ba9eb4b6c9a5a0599e01fec427c.png"},"kind":"image"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ansi"},{"kind":"text","text":" is the answer to the problem for day "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". Assume that "},{"kind":"math_inline","text":"ans0 = 0"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print exactly "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ans1, ans2, ..., anss"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ansi"},{"kind":"text","text":" is the minimum displeasure that you can get on day "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3\n1 2 1 2 3\n5\n1 1 2\n1 3 2\n1 3 3\n1 3 5\n1 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n0\n2\n3\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"543E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/543/problem/E"}