{"assets":[],"contentKind":"statement","contestId":"348","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Pilgrims"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A long time ago there was a land called Dudeland. Dudeland consisted of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" towns connected with "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" bidirectonal roads. The towns are indexed from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and one can reach any city from any other city if he moves along the roads of the country. There are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" monasteries in Dudeland located in "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" different towns. In each monastery lives a pilgrim."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"At the beginning of the year, each pilgrim writes down which monastery is the farthest from the monastery he is living in. If there is more than one farthest monastery, he lists all of them. On the Big Lebowski day each pilgrim picks one town from his paper at random and starts walking to that town. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Walter hates pilgrims and wants to make as many of them unhappy as possible by preventing them from finishing their journey. He plans to destroy exactly one town that does not contain a monastery. A pilgrim becomes unhappy if all monasteries in his list become unreachable from the monastery he is living in. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to find the maximum number of pilgrims Walter can make unhappy. Also find the number of ways he can make this maximal number of pilgrims unhappy: the number of possible towns he can destroy."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 105"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ m < n"},{"kind":"text","text":"). The next line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" distinct integers representing indices of towns that contain monasteries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain three integers each, "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":", indicating that there is an edge between towns "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n, 1 ≤ ci ≤ 1000, ai ≠ bi"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output two integers: the maximum number of pilgrims Walter can make unhappy and the number of ways in which he can make his plan come true."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 5\n7 2 5 4 8\n1 2 1\n2 3 2\n1 4 1\n4 5 2\n1 6 1\n6 7 8\n6 8 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"348E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/348/problem/E"}