{"assets":["/statement-assets/8db3eecbe966415d47844f55c8c559c7a8ab7e28a3e5815953f86f024264edee.png","/statement-assets/6f681486c9e0cc1a7389780c074af43e42fe120b2b244b50c7a972b90bda159f.png","/statement-assets/33eee2dc1c597ed096ba5a808d820b053e91775575440a2eccabf67b7c1e7042.png","/statement-assets/dfddc7f97acbe52128af6d6566455e649d802319f8f2f132bc3be06c9f08dcd7.png","/statement-assets/deee4239e6925c01060922fb5464145bb1605f388b0ddd24b1e08b6d8ec439bb.png","/statement-assets/0855f2567849dede773cf959a8673b5ad088be8987d598a476a605be7323a8e2.png"],"contentKind":"statement","contestId":"2068","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Urban Planning"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are responsible for planning a new city! The city will be represented by a rectangular grid, where each cell is either a park or a built-up area."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The residents will naturally want to go for walks in the city parks. In particular, a "},{"children":[{"kind":"text","text":"rectangular walk"}],"kind":"container"},{"kind":"text","text":" is a rectangle consisting of the grid cells, which is at least 2 cells long both horizontally and vertically, such that all cells on the boundary of the rectangle are parks. Note that the cells inside the rectangle can be arbitrary."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/8db3eecbe966415d47844f55c8c559c7a8ab7e28a3e5815953f86f024264edee.png"},"kind":"image"},{"kind":"text","text":" An example rectangular walk (cells with dark background). "}],"kind":"container"},{"children":[{"kind":"text","text":"Your favourite number is $$$k$$$. To leave a long-lasting signature, you want to design the city in such a way that it has exactly $$$k$$$ rectangular walks."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input contains a single integer $$$k$$$ ($$$0 \\le k \\le 4.194\\cdot 10^{12}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first line, print two integers $$$h$$$ and $$$w$$$ ($$$1 \\le h, w \\le 2025$$$), the height and width of the grid. On the next $$$h$$$ lines, print a string with $$$w$$$ characters each, with each character being "},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":", denoting a park, or "},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":", denoting a built-up area."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that for any value of $$$k$$$ within the given limits, there exists a solution with height and width within the given limits. Any city within the given limits and with exactly $$$k$$$ rectangular walks will be accepted."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3 4\n####\n#.##\n####\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the "},{"children":[{"kind":"text","text":"sample"}],"kind":"container"},{"kind":"text","text":", here are the five possible rectangular walks:"}],"kind":"paragraph"},{"kind":"paragraph"},{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/6f681486c9e0cc1a7389780c074af43e42fe120b2b244b50c7a972b90bda159f.png"},"kind":"image"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/33eee2dc1c597ed096ba5a808d820b053e91775575440a2eccabf67b7c1e7042.png"},"kind":"image"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/dfddc7f97acbe52128af6d6566455e649d802319f8f2f132bc3be06c9f08dcd7.png"},"kind":"image"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/deee4239e6925c01060922fb5464145bb1605f388b0ddd24b1e08b6d8ec439bb.png"},"kind":"image"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/0855f2567849dede773cf959a8673b5ad088be8987d598a476a605be7323a8e2.png"},"kind":"image"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"2068B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2068/problem/B"}