{"assets":[],"contentKind":"statement","contestId":"886","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Restoration of string"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A substring of some string is called the most frequent, if the number of its occurrences is not less than number of occurrences of any other substring."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a set of strings. A string (not necessarily from this set) is called good if all elements of the set are the most frequent substrings of this string. Restore the non-empty good string with minimum length. If several such strings exist, restore lexicographically minimum string. If there are no good strings, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A substring of a string is a contiguous subsequence of letters in the string. For example, \""},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\" are substrings of string \""},{"children":[{"kind":"text","text":"abc"}],"kind":"container"},{"kind":"text","text":"\", while \""},{"children":[{"kind":"text","text":"ac"}],"kind":"container"},{"kind":"text","text":"\" is not a substring of that string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The number of occurrences of a substring in a string is the number of starting positions in the string where the substring occurs. These occurrences could overlap."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"String "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is lexicographically smaller than string "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is a prefix of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", or "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" has a smaller letter at the first position where "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" differ."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of strings in the set."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains a non-empty string consisting of lowercase English letters. It is guaranteed that the strings are distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The total length of the strings doesn't exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the non-empty good string with minimum length. If several good strings exist, print lexicographically minimum among them. Print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if there are no good strings."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nmail\nai\nlru\ncf\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"cfmailru\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nkek\npreceq\ncheburek\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"One can show that in the first sample only two good strings with minimum length exist: \""},{"children":[{"kind":"text","text":"cfmailru"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"mailrucf"}],"kind":"container"},{"kind":"text","text":"\". The first string is lexicographically minimum."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"886D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/886/problem/D"}