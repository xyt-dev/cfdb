{"assets":[],"contentKind":"statement","contestId":"238","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Meeting Her"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Urpal lives in a big city. He has planned to meet his lover tonight. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The city has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" junctions numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". The junctions are connected by "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" directed streets, all the roads have equal length. Urpal lives in junction "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and the date is planned in a restaurant in junction "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". He wants to use public transportation to get to junction "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". There are "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" bus transportation companies. At the beginning of every second, a bus from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th company chooses a random shortest path between junction "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" and junction "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" and passes through it. There might be no path from "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":". In that case no bus will leave from "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":". If a bus passes through a junction where Urpal stands, he can get on the bus. He can also get off the bus at any junction along the path. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Urpal wants to know if it's possible to go to the date using public transportation in a finite amount of time (the time of travel is the sum of length of the traveled roads) and what is the minimum number of buses he should take in the worst case."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"At any moment Urpal knows only his own position and the place where the date will be. When he gets on the bus he knows only the index of the company of this bus. Of course Urpal knows the city map and the the pairs "},{"kind":"math_inline","text":"(si, ti)"},{"kind":"text","text":" for each company."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that Urpal doesn't know buses velocity. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom"},"kind":"section"},{"attrs":{"role":"custom"},"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of the input contains four integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"math_inline","text":"(2 ≤ n ≤ 100; 0 ≤ m ≤ n·(n - 1); 1 ≤ a, b ≤ n; a ≠ b)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain two integers each "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"math_inline","text":"(1 ≤ ui, vi ≤ n; ui ≠ vi)"},{"kind":"text","text":" describing a directed road from junction "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" to junction "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":". All roads in the input will be distinct. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains an integer "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(0 ≤ k ≤ 100)"},{"kind":"text","text":". There will be "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines after this, each containing two integers "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ti"},{"kind":"math_inline","text":"(1 ≤ si, ti ≤ n; si ≠ ti)"},{"kind":"text","text":" saying there is a bus route starting at "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" and ending at "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":". Please note that there might be no path from "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", this case is described in the problem statement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom"},"kind":"section"},{"attrs":{"role":"custom"},"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"paragraph"},{"children":[{"kind":"text","text":"In the only line of output print the minimum number of buses Urpal should get on on his way in the worst case. If it's not possible to reach the destination in the worst case print -1."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom"},"kind":"section"},{"attrs":{"role":"custom"},"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"kind":"paragraph"},{"kind":"paragraph"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 8 1 7\n1 2\n1 3\n2 4\n3 4\n4 6\n4 5\n6 7\n5 7\n3\n2 7\n1 4\n5 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4 1 2\n1 2\n1 3\n2 4\n3 4\n1\n1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"238E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/238/problem/E"}