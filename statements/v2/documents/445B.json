{"assets":["/statement-assets/bd340253a41f3b2041d33fc674af7bb9f8203933679bc6922dadb5491c4781fd.png"],"contentKind":"statement","contestId":"445","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. DZY Loves Chemistry"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"DZY loves chemistry, and he enjoys mixing chemicals."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"DZY has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" chemicals, and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" pairs of them will react. He wants to pour these chemicals into a test tube, and he needs to pour them in one by one, in any order. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's consider the danger of a test tube. Danger of an empty test tube is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". And every time when DZY pours a chemical, if there are already one or more chemicals in the test tube that can react with it, the danger of the test tube will be multiplied by "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Otherwise the danger remains as it is."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the maximum possible danger after pouring all the chemicals one by one in optimal order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"attrs":{"alt":"","src":"/statement-assets/bd340253a41f3b2041d33fc674af7bb9f8203933679bc6922dadb5491c4781fd.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two space-separated integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"math_inline","text":"(1 ≤ xi < yi ≤ n)"},{"kind":"text","text":". These integers mean that the chemical "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" will react with the chemical "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":". Each pair of chemicals will appear at most once in the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider all the chemicals numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in some order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maximum possible danger."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, there's only one way to pour, and the danger won't increase."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, no matter we pour the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"st chemical first, or pour the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"nd chemical first, the answer is always "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, there are four ways to achieve the maximum possible danger: 2-1-3, 2-3-1, 1-2-3 and 3-2-1 (that is the numbers of the chemicals in order of pouring)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"445B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/445/problem/B"}