{"assets":[],"contentKind":"statement","contestId":"845","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Guards In The Storehouse"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp owns a shop in the capital of Berland. Recently the criminal activity in the capital increased, so Polycarp is thinking about establishing some better security in the storehouse of his shop."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The storehouse can be represented as a matrix with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" columns. Each element of the matrix is either "},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" (an empty space) or "},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":" (a wall)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp wants to hire some guards (possibly zero) to watch for the storehouse. Each guard will be in some cell of matrix and will protect every cell to the right of his own cell and every cell to the bottom of his own cell, until the nearest wall. More formally, if the guard is standing in the cell "},{"kind":"math_inline","text":"(x0, y0)"},{"kind":"text","text":", then he protects cell "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":" if all these conditions are met:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":" is an empty cell; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" either "},{"kind":"math_inline","text":"x0 = x1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y0 ≤ y1"},{"kind":"text","text":", or "},{"kind":"math_inline","text":"x0 ≤ x1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y0 = y1"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" there are no walls between cells "},{"kind":"math_inline","text":"(x0, y0)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(x1, y1)"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"There can be a guard between these cells, guards can look through each other."}],"kind":"container"}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Guards can be placed only in empty cells (and can protect only empty cells). The "},{"children":[{"kind":"text","text":"plan"}],"kind":"container"},{"kind":"text","text":" of placing the guards is some set of cells where guards will be placed (of course, two plans are different if there exists at least one cell that is included in the first plan, but not included in the second plan, or vice versa). Polycarp calls a plan "},{"children":[{"kind":"text","text":"suitable"}],"kind":"container"},{"kind":"text","text":" if there is "},{"children":[{"kind":"text","text":"not more than one"}],"kind":"container"},{"kind":"text","text":" empty cell that is not protected."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp wants to know the number of suitable plans. Since it can be very large, you have to output it modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" — the length and the width of the storehouse ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 250"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ nm ≤ 250"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th line contains a string consisting of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters — "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th row of the matrix representing the storehouse. Each character is either "},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the number of suitable plans modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 3\n.x.\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\nxx\nxx\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n..\n..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\nx\n.\nx\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example you have to put at least one guard, so there are three possible arrangements: one guard in the cell "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":", one guard in the cell "},{"kind":"math_inline","text":"(1, 3)"},{"kind":"text","text":", and two guards in both these cells."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"845F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/845/problem/F"}