{"assets":["/statement-assets/996ebbe44ac2515e67fba3c7c779356a52215f646595ff95350ca65e9c4f9490.png"],"contentKind":"statement","contestId":"819","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Mister B and PR Shifts"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Some time ago Mister B detected a strange signal from the space, which he started to study."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After some transformation the signal turned out to be a permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" or its cyclic shift. For the further investigation Mister B need some basis, that's why he decided to choose cyclic shift of this permutation which has the minimum possible deviation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's define the deviation of a permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" as "},{"attrs":{"alt":"","src":"/statement-assets/996ebbe44ac2515e67fba3c7c779356a52215f646595ff95350ca65e9c4f9490.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find a cyclic shift of permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" with minimum possible deviation. If there are multiple solutions, print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's denote id "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ k < n"},{"kind":"text","text":") of a cyclic shift of permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" as the number of right shifts needed to reach this shift, for example:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"k = 0"},{"kind":"text","text":": shift "},{"kind":"math_inline","text":"p1, p2, ... pn"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":": shift "},{"kind":"math_inline","text":"pn, p1, ... pn - 1"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"kind":"text","text":" ..., "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"k = n - 1"},{"kind":"text","text":": shift "},{"kind":"math_inline","text":"p2, p3, ... pn, p1"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 106"},{"kind":"text","text":") — the length of the permutation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":") — the elements of the permutation. It is guaranteed that all elements are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two integers: the minimum deviation of cyclic shifts of permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and the id of such shift. If there are multiple solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n2 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test the given permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is the identity permutation, that's why its deviation equals to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", the shift id equals to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" as well."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test the deviation of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" equals to "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", the deviation of the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st cyclic shift "},{"kind":"math_inline","text":"(1, 2, 3)"},{"kind":"text","text":" equals to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", the deviation of the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd cyclic shift "},{"kind":"math_inline","text":"(3, 1, 2)"},{"kind":"text","text":" equals to "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", the optimal is the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st cyclic shift."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample test the deviation of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" equals to "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", the deviation of the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st cyclic shift "},{"kind":"math_inline","text":"(1, 3, 2)"},{"kind":"text","text":" equals to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", the deviation of the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd cyclic shift "},{"kind":"math_inline","text":"(2, 1, 3)"},{"kind":"text","text":" also equals to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", so the optimal are both "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd cyclic shifts."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"819B","schema":2,"sourceKind":"html","sourceUrl":"https:/