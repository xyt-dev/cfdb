{"assets":[],"contentKind":"statement","contestId":"1837","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Comparison String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ of length $$$n$$$, where each character is either "},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An array $$$a$$$ consisting of $$$n+1$$$ elements is compatible with the string $$$s$$$ if, for every $$$i$$$ from $$$1$$$ to $$$n$$$, the character $$$s_i$$$ represents the result of comparing $$$a_i$$$ and $$$a_{i+1}$$$, i. e.:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$s_i$$$ is "},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":" if and only if $$$a_i \\lt a_{i+1}$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$s_i$$$ is "},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":" if and only if $$$a_i \\gt a_{i+1}$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, the array $$$[1, 2, 5, 4, 2]$$$ is compatible with the string "},{"children":[{"kind":"text","text":"<<>>"}],"kind":"container"},{"kind":"text","text":". There are other arrays with are compatible with that string, for example, $$$[13, 37, 42, 37, 13]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" of the array is the number of different elements in it. For example, the cost of $$$[1, 2, 5, 4, 2]$$$ is $$$4$$$; the cost of $$$[13, 37, 42, 37, 13]$$$ is $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to calculate the minimum cost among all arrays which are compatible with the given string $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 500$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two lines: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the first line contains one integer $$$n$$$ ($$$1 \\le n \\le 100$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the second line contains the string $$$s$$$, consisting of $$$n$$$ characters. Each character of $$$s$$$ is either "},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer — the minimum cost among all arrays which are compatible with the given string $$$s$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n4\n<<>>\n4\n>><<\n5\n>>>>>\n7\n<><><><\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n3\n6\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case of the example, the array can be $$$[13, 37, 42, 37, 13]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case of the example, the array can be $$$[42, 37, 13, 37, 42]$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1837B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1837/problem/B"}