{"assets":["/statement-assets/e380f1d3f4e5bad24da4040c956672c63bb5c6515a1a759b18a2ad9b077a977b.png"],"contentKind":"statement","contestId":"924","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Wardrobe"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Olya wants to buy a custom wardrobe. It should have "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" boxes with heights "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":", stacked one on another in some order. In other words, we can represent each box as a vertical segment of length "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", and all these segments should form a single segment from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"attrs":{"alt":"","src":"/statement-assets/e380f1d3f4e5bad24da4040c956672c63bb5c6515a1a759b18a2ad9b077a977b.png"},"kind":"image"},{"kind":"text","text":" without any overlaps."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Some of the boxes are important (in this case "},{"kind":"math_inline","text":"bi = 1"},{"kind":"text","text":"), others are not (then "},{"kind":"math_inline","text":"bi = 0"},{"kind":"text","text":"). Olya defines the "},{"children":[{"kind":"text","text":"convenience"}],"kind":"container"},{"kind":"text","text":" of the wardrobe as the number of important boxes such that their bottom edge is located between the heights "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", inclusive."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given information about heights of the boxes and their importance. Compute the maximum possible convenience of the wardrobe if you can reorder the boxes arbitrarily."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ l ≤ r ≤ 10 000"},{"kind":"text","text":") — the number of boxes, the lowest and the highest heights for a bottom edge of an important box to be counted in convenience."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 10 000"},{"kind":"text","text":") — the heights of the boxes. It is guaranteed that the sum of height of all boxes (i. e. the height of the wardrobe) does not exceed "},{"kind":"math_inline","text":"10 000"},{"kind":"text","text":": Olya is not very tall and will not be able to reach any higher."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ bi ≤ 1"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" equals "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th box is important, and "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the maximum possible convenience of the wardrobe."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 3 6\n3 2 5 1 2\n1 1 0 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 5\n3 6\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example you can, for example, first put an unimportant box of height "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", then put an important boxes of sizes "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", in this order, and then the remaining unimportant boxes. The convenience is equal to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", because the bottom edges of important boxes of sizes "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" fall into the range "},{"kind":"math_inline","text":"[3, 6]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example you have to put the short box under the tall box."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"924E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/924/problem/E"}