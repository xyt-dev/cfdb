{"assets":[],"contentKind":"statement","contestId":"978","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. File Name"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You can not just take the file and send it. When Polycarp trying to send a file in the social network \"Codehorses\", he encountered an unexpected problem. If the name of the file contains three or more \""},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":"\" (lowercase Latin letters \""},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":"\") in a row, the system considers that the file content does not correspond to the social network topic. In this case, the file is not sent and an error message is displayed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the minimum number of characters to remove from the file name so after that the name does not contain \""},{"children":[{"kind":"text","text":"xxx"}],"kind":"container"},{"kind":"text","text":"\" as a substring. Print "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" if the file name does not initially contain a forbidden substring \""},{"children":[{"kind":"text","text":"xxx"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can delete characters in arbitrary positions (not necessarily consecutive). If you delete a character, then the length of a string is reduced by $$$1$$$. For example, if you delete the character in the position $$$2$$$ from the string \""},{"children":[{"kind":"text","text":"exxxii"}],"kind":"container"},{"kind":"text","text":"\", then the resulting string is \""},{"children":[{"kind":"text","text":"exxii"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer $$$n$$$ $$$(3 \\le n \\le 100)$$$ — the length of the file name."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a string of length $$$n$$$ consisting of lowercase Latin letters only — the file name."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of characters to remove from the file name so after that the name does not contain \""},{"children":[{"kind":"text","text":"xxx"}],"kind":"container"},{"kind":"text","text":"\" as a substring. If initially the file name dost not contain a forbidden substring \""},{"children":[{"kind":"text","text":"xxx"}],"kind":"container"},{"kind":"text","text":"\", print "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\nxxxiii\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nxxoxx\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\nxxxxxxxxxx\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example Polycarp tried to send a file with name contains number $$$33$$$, written in Roman numerals. But he can not just send the file, because it name contains three letters \""},{"children":[{"kind":"text","text":"x"}],"kind":"container"},{"kind":"text","text":"\" in a row. To send the file he needs to remove any one of this letters."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"978B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/978/problem/B"}