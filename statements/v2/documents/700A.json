{"assets":[],"contentKind":"statement","contestId":"700","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. As Fast As Possible"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"On vacations "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pupils decided to go on excursion and gather all together. They need to overcome the path with the length "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" meters. Each of the pupils will go with the speed equal to "},{"kind":"math_inline","text":"v1"},{"kind":"text","text":". To get to the excursion quickly, it was decided to rent a bus, which has seats for "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" people (it means that it can't fit more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" people at the same time) and the speed equal to "},{"kind":"math_inline","text":"v2"},{"kind":"text","text":". In order to avoid seasick, each of the pupils want to get into the bus "},{"children":[{"kind":"text","text":"no more than once"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine the minimum time required for all "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pupils to reach the place of excursion. Consider that the embarkation and disembarkation of passengers, as well as the reversal of the bus, take place immediately and this time can be neglected. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains five positive integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ l ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ v1 < v2 ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":") — the number of pupils, the distance from meeting to the place of excursion, the speed of each pupil, the speed of bus and the number of seats in the bus. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the real number — the minimum time in which all pupils can reach the place of excursion. Your answer will be considered correct if its absolute or relative error won't exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 10 1 2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5.0000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6 1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4.7142857143\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample we should immediately put all five pupils to the bus. The speed of the bus equals "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and the distance is equal to "},{"kind":"math_inline","text":"10"},{"kind":"text","text":", so the pupils will reach the place of excursion in time "},{"kind":"math_inline","text":"10 / 2 = 5"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"700A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/700/problem/A"}