{"assets":[],"contentKind":"statement","contestId":"496","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Tennis Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya and Gena love playing table tennis. A single match is played according to the following rules: a match consists of multiple sets, each set consists of multiple serves. Each serve is won by one of the players, this player scores one point. As soon as one of the players scores "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" points, he wins the set; then the next set starts and scores of both players are being set to 0. As soon as one of the players wins the total of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" sets, he wins the match and the match is over. Here "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" are some positive integer numbers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To spice it up, Petya and Gena choose new numbers "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" before every match. Besides, for the sake of history they keep a record of each match: that is, for each serve they write down the winner. Serve winners are recorded in the chronological order. In a record the set is over as soon as one of the players scores "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" points and the match is over as soon as one of the players wins "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" sets."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya and Gena have found a record of an old match. Unfortunately, the sequence of serves in the record isn't divided into sets and numbers "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" for the given match are also lost. The players now wonder what values of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" might be. Can you determine all the possible options?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" — the length of the sequence of games ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". If "},{"kind":"math_inline","text":"ai = 1"},{"kind":"text","text":", then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th serve was won by Petya, if "},{"kind":"math_inline","text":"ai = 2"},{"kind":"text","text":", then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th serve was won by Gena."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"It is not guaranteed"}],"kind":"container"},{"kind":"text","text":" that at least one option for numbers "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" corresponds to the given record."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of options for numbers "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In each of the following "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines print two integers "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" — the option for numbers "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Print the options in the order of increasing "},{"kind":"math_inline","text":"si"},{"kind":"text","text":", and for equal "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" — in the order of increasing "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 1 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 3\n3 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 4\n2 2\n4 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n2 1 2 1 1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 6\n2 3\n6 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"496D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/496/problem/D"}