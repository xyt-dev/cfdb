{"assets":[],"contentKind":"statement","contestId":"427","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Prison Transfer"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The prison of your city has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" prisoners. As the prison can't accommodate all of them, the city mayor has decided to transfer "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" of the prisoners to a prison located in another city."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For this reason, he made the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" prisoners to stand in a line, with a number written on their chests. The number is the severity of the crime he/she has committed. The greater the number, the more severe his/her crime was."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then, the mayor told you to choose the "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" prisoners, who will be transferred to the other prison. He also imposed two conditions. They are,"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" The chosen "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" prisoners has to form a contiguous segment of prisoners. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Any of the chosen prisoner's crime level should not be greater then "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Because, that will make the prisoner a severe criminal and the mayor doesn't want to take the risk of his running away during the transfer. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Find the number of ways you can choose the "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" prisoners."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input will contain three space separated integers "},{"kind":"math_inline","text":"n (1 ≤ n ≤ 2·105)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"t (0 ≤ t ≤ 109)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c (1 ≤ c ≤ n)"},{"kind":"text","text":". The next line will contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space separated integers, the "},{"kind":"math_inline","text":"ith"},{"kind":"text","text":" integer is the severity "},{"kind":"math_inline","text":"ith"},{"kind":"text","text":" prisoner's crime. The value of crime severities will be non-negative and will not exceed "},{"kind":"math_inline","text":"109"},{"kind":"text","text":". "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of ways you can choose the "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" prisoners."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3 3\n2 3 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1 1\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11 4 2\n2 2 0 7 3 2 2 4 9 1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"427B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/427/problem/B"}