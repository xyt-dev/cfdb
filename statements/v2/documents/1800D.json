{"assets":[],"contentKind":"statement","contestId":"1800","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Remove Two Letters"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Dmitry has a string $$$s$$$, consisting of lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Dmitry decided to remove two "},{"children":[{"kind":"text","text":"consecutive"}],"kind":"container"},{"kind":"text","text":" characters from the string $$$s$$$ and you are wondering how many different strings can be obtained after such an operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, Dmitry has a string \""},{"children":[{"kind":"text","text":"aaabcc"}],"kind":"container"},{"kind":"text","text":"\". You can get the following different strings: \""},{"children":[{"kind":"text","text":"abcc"}],"kind":"container"},{"kind":"text","text":"\"(by deleting the first two or second and third characters), \""},{"children":[{"kind":"text","text":"aacc"}],"kind":"container"},{"kind":"text","text":"\"(by deleting the third and fourth characters),\""},{"children":[{"kind":"text","text":"aaac"}],"kind":"container"},{"kind":"text","text":"\"(by deleting the fourth and the fifth character) and \""},{"children":[{"kind":"text","text":"aaab"}],"kind":"container"},{"kind":"text","text":"\" (by deleting the last two)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input data contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — number of test cases. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The descriptions of the test cases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of the description of each test case contains an integer $$$n$$$ ($$$3 \\le n \\le 2 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the description of each test case contains a string $$$s$$$ of length $$$n$$$ consisting of lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ for all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print one integer — the number of distinct strings that can be obtained by removing two consecutive letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n6\naaabcc\n10\naaaaaaaaaa\n6\nabcdef\n7\nabacaba\n6\ncccfff\n4\nabba\n5\nababa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1\n5\n3\n3\n3\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first example is explained in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, the following strings are obtained: \""},{"children":[{"kind":"text","text":"cdef"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"adef"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abef"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abcf"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"abcd"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the seventh example, any deletion will result in the string \""},{"children":[{"kind":"text","text":"aba"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1800D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1800/problem/D"}