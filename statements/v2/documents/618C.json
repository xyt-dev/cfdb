{"assets":["/statement-assets/8f4e900bf24e270f40a77589f9024e1dc0fcfe23faaf6ff6261b2fb610433268.png"],"contentKind":"statement","contestId":"618","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Constellation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Cat Noku has obtained a map of the night sky. On this map, he found a constellation with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" stars numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". For each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th star is located at coordinates "},{"kind":"math_inline","text":"(xi, yi)"},{"kind":"text","text":". No two stars are located at the same position."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the evening Noku is going to take a look at the night sky. He would like to find three distinct stars and form a triangle. The triangle must have positive area. In addition, all other stars must lie strictly outside of this triangle. He is having trouble finding the answer and would like your help. Your job is to find the indices of three stars that would form a triangle that satisfies all the conditions. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there is no line such that all stars lie on that line. It can be proven that if the previous condition is satisfied, there exists a solution to this problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 100 000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ xi, yi ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that no two stars lie at the same point, and there does not exist a line such that all stars lie on that line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print three distinct integers on a single line — the indices of the three points that form a triangle that satisfies the conditions stated in the problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple possible answers, you may print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n0 1\n1 0\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 0\n0 2\n2 0\n2 2\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, we can print the three indices in any order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, we have the following picture. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/8f4e900bf24e270f40a77589f9024e1dc0fcfe23faaf6ff6261b2fb610433268.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Note that the triangle formed by starts "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" doesn't satisfy the conditions stated in the problem, as point "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" is not strictly outside of this triangle (it lies on it's border)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"618C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/618/problem/C"}