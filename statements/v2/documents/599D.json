{"assets":["/statement-assets/44466695056278a7d9d6dd7f3e1f232916c4a17eff5e1930ad687b773c7916c1.png","/statement-assets/d22385210b4421c9113b1736469985b1857870d33cd906d5a8f70368407b66be.png"],"contentKind":"statement","contestId":"599","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Spongebob and Squares"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Spongebob is already tired trying to reason his weird actions and calculations, so he simply asked you to find all pairs of n and m, such that there are exactly "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" distinct squares in the table consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" columns. For example, in a "},{"kind":"math_inline","text":"3 × 5"},{"kind":"text","text":" table there are "},{"kind":"math_inline","text":"15"},{"kind":"text","text":" squares with side one, "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" squares with side two and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" squares with side three. The total number of distinct squares in a "},{"kind":"math_inline","text":"3 × 5"},{"kind":"text","text":" table is "},{"kind":"math_inline","text":"15 + 8 + 3 = 26"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x ≤ 1018"},{"kind":"text","text":") — the number of squares inside the tables Spongebob is interested in."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"First print a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of tables with exactly "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" distinct squares inside."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" pairs of integers describing the tables. Print the pairs in the order of increasing "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", and in case of equality — in the order of increasing "},{"kind":"math_inline","text":"m"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"26\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 26\n2 9\n3 5\n5 3\n9 2\n26 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n2 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 8\n2 3\n3 2\n8 1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a "},{"kind":"math_inline","text":"1 × 2"},{"kind":"text","text":" table there are "},{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"1 × 1"},{"kind":"text","text":" squares. So, "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" distinct squares in total."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/44466695056278a7d9d6dd7f3e1f232916c4a17eff5e1930ad687b773c7916c1.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In a "},{"kind":"math_inline","text":"2 × 3"},{"kind":"text","text":" table there are "},{"kind":"math_inline","text":"6"},{"kind":"math_inline","text":"1 × 1"},{"kind":"text","text":" squares and "},{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"2 × 2"},{"kind":"text","text":" squares. That is equal to "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" squares in total."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d22385210b4421c9113b1736469985b1857870d33cd906d5a8f70368407b66be.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"599D","schema":2,"sourceKind"