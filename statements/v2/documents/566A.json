{"assets":["/statement-assets/ea4a58ffaf3102487ba5109121067c21544710a5035b01a6ab5aab1e60e3260a.png"],"contentKind":"statement","contestId":"566","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Matching Names"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Teachers of one programming summer school decided to make a surprise for the students by giving them names in the style of the \"Hobbit\" movie. Each student must get a pseudonym maximally similar to his own name. The pseudonym must be a name of some character of the popular saga and now the teachers are busy matching pseudonyms to student names."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students in a summer school. Teachers chose exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pseudonyms for them. Each student must get exactly one pseudonym corresponding to him. Let us determine the relevance of a pseudonym "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" to a student with name "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" as the length of the largest common prefix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". We will represent such value as "},{"attrs":{"alt":"","src":"/statement-assets/ea4a58ffaf3102487ba5109121067c21544710a5035b01a6ab5aab1e60e3260a.png"},"kind":"image"},{"kind":"text","text":". Then we can determine the "},{"children":[{"kind":"text","text":"quality"}],"kind":"container"},{"kind":"text","text":" of matching of the pseudonyms to students as a sum of relevances of all pseudonyms to the corresponding students."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find the matching between students and pseudonyms with the maximum "},{"children":[{"kind":"text","text":"quality"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of students in the summer school."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the name of the students. Each name is a non-empty word consisting of lowercase English letters. Some names can be repeating."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the given pseudonyms. Each pseudonym is a non-empty word consisting of small English letters. Some pseudonyms can be repeating."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The total length of all the names and pseudonyms doesn't exceed "},{"kind":"math_inline","text":"800 000"},{"kind":"text","text":" characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the maximum possible "},{"children":[{"kind":"text","text":"quality"}],"kind":"container"},{"kind":"text","text":" of matching pseudonyms to students."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines describe the optimal matching. Each line must have the form "},{"kind":"math_inline","text":"a"},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ n"},{"kind":"text","text":"), that means that the student who was number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" in the input, must match to the pseudonym number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" in the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The matching should be a one-to-one correspondence, that is, each student and each pseudonym should occur exactly once in your output. If there are several optimal answers, output any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\ngennady\ngalya\nboris\nbill\ntoshik\nbilbo\ntorin\ngendalf\nsmaug\ngaladriel\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n4 1\n2 5\n1 3\n5 2\n3 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test from the statement the match looks as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"bil"}],"kind":"container"},{"kind":"text","text":"l "},{"kind":"math_inline","text":" → "},{"children":[{"kind":"text","text":"bil"}],"kind":"container"},{"kind":"text","text":"bo (lcp = 3) "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"gal"}],"kind":"container"},{"kind":"text","text":"ya "},{"kind":"math_inline","text":" → "},{"children":[{"kind":"text","text":"gal"}],"kind":"container"},{"kind":"text","text":"adriel (lcp = 3) "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"gen"}],"kind":"container"},{"kind":"text","text":"nady "},{"kind":"math_inline","text":" → "},{"children":[{"kind":"text","text":"gen"}],"kind":"container"},{"kind":"text","text":"dalf (lcp = 3) "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"to"}],"kind":"container"},{"kind":"text","text":"shik "},{"kind":"math_inline","text":" → "},{"children":[{"kind":"text","text":"to"}],"kind":"container"},{"kind":"text","text":"rin (lcp = 2) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" boris "},{"kind":"math_inline","text":" → "},{"kind":"text","text":" smaug (lcp = 0) "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"566A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/566/problem/A"}