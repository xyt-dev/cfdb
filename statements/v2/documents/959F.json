{"assets":[],"contentKind":"statement","contestId":"959","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Mahmoud and Ehab and yet another xor task"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ehab has an array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. He likes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise-xor operation"}],"kind":"link"},{"kind":"text","text":" and he likes to bother Mahmoud so he came up with a problem. He gave Mahmoud "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries. In each of them, he gave Mahmoud 2 integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", and asked him to find the number of subsequences of the first "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" elements of the array such that their bitwise-xor sum is "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". Can you help Mahmoud answer the queries?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A subsequence can contain elements that are not neighboring."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"math_inline","text":"(1 ≤ n, q ≤ 105)"},{"kind":"text","text":", the number of elements in the array and the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"an"},{"kind":"math_inline","text":"(0 ≤ ai < 220)"},{"kind":"text","text":", the elements of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines, each contains integers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"(1 ≤ l ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ x < 220)"},{"kind":"text","text":", representing the queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query, output its answer modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":" in a newline."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n0 1 2 3 4\n4 3\n2 0\n3 7\n5 7\n5 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n2\n0\n4\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n1 1 1\n3 1\n2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The bitwise-xor sum of the empty set is 0 and the bitwise-xor sum of a set containing one element is that element itself."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"959F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/959/problem/F"}