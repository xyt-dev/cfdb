{"assets":[],"contentKind":"statement","contestId":"576","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Invariance of Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A tree of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is an undirected connected graph consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices without cycles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider some tree with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. We call a tree "},{"children":[{"kind":"text","text":"invariant"}],"kind":"container"},{"kind":"text","text":" relative to permutation "},{"kind":"math_inline","text":"p = p1p2... pn"},{"kind":"text","text":", if for any two vertices of the tree "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" the condition holds: \"vertices "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" are connected by an edge if and only if vertices "},{"kind":"math_inline","text":"pu"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"pv"},{"kind":"text","text":" are connected by an edge\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" of size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Find some tree size "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", invariant relative to the given permutation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the size of the permutation (also equal to the size of the sought tree)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains permutation "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the sought tree does not exist, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\", and then print "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines, each of which contains two integers — the numbers of vertices connected by an edge of the tree you found. The vertices are numbered from 1, the order of the edges and the order of the vertices within the edges does not matter."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n4 3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n4 1\n4 2\n1 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test a permutation transforms edge (4, 1) into edge (1, 4), edge (4, 2) into edge (1, 3) and edge (1, 3) into edge (4, 2). These edges all appear in the resulting tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It can be shown that in the second sample test no tree satisfies the given condition."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"576B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/576/problem/B"}