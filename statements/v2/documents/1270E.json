{"assets":[],"contentKind":"statement","contestId":"1270","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Divide Points"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a set of $$$n\\ge 2$$$ "},{"children":[{"kind":"text","text":"pairwise different"}],"kind":"container"},{"kind":"text","text":" points with integer coordinates. Your task is to partition these points into two "},{"children":[{"kind":"text","text":"nonempty"}],"kind":"container"},{"kind":"text","text":" groups $$$A$$$ and $$$B$$$, such that the following condition holds:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For every two points $$$P$$$ and $$$Q$$$, write the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Euclidean_distance"},"children":[{"kind":"text","text":"Euclidean distance"}],"kind":"link"},{"kind":"text","text":" between them on the blackboard: if they belong to the "},{"children":[{"kind":"text","text":"same"}],"kind":"container"},{"kind":"text","text":" group — with a "},{"children":[{"kind":"text","text":"yellow"}],"kind":"container"},{"kind":"text","text":" pen, and if they belong to "},{"children":[{"kind":"text","text":"different"}],"kind":"container"},{"kind":"text","text":" groups — with a "},{"children":[{"kind":"text","text":"blue"}],"kind":"container"},{"kind":"text","text":" pen. "},{"children":[{"kind":"text","text":"Then no yellow number is equal to any blue number"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that such a partition exists for any possible input. If there exist multiple partitions, you are allowed to output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ $$$(2 \\le n \\le 10^3)$$$ — the number of points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th of the next $$$n$$$ lines contains two integers $$$x_i$$$ and $$$y_i$$$ ($$$-10^6 \\le x_i, y_i \\le 10^6$$$) — the coordinates of the $$$i$$$-th point. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that all $$$n$$$ points are pairwise different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, output $$$a$$$ ($$$1 \\le a \\le n-1$$$) — the number of points in a group $$$A$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line, output $$$a$$$ integers — the indexes of points that you include into group $$$A$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n0 0\n0 1\n1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":