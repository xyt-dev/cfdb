{"assets":[],"contentKind":"statement","contestId":"625","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Frog Fights"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ostap Bender recently visited frog farm and was inspired to create his own frog game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Number of frogs are places on a cyclic gameboard, divided into "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" cells. Cells are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":", but the board is cyclic, so cell number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" goes right after the cell number "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" in the direction of movement. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th frog during its turn can jump for "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" cells."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Frogs move in turns, game starts with a move by frog "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". On its turn "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th frog moves "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" cells forward, knocking out all the frogs on its way. If there is a frog in the last cell of the path of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th frog, that frog is also knocked out. After this the value "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is decreased by the number of frogs that were knocked out during this turn. If "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is zero or goes negative, then "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th frog doesn't make moves anymore."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After frog number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" finishes its turn, frog number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" starts to move, then frog number "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and so on. After the frog number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" makes its move, frog "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" starts to move again, then frog "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and so on this process goes forever. If some frog was already knocked out from the board, we consider that it skips all its moves."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Ostap to identify, what frogs will stay on the board at the end of a game?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100000, 1 ≤ m ≤ 109, n ≤ m"},{"kind":"text","text":") — number of frogs and gameboard size, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains frogs descriptions — two integers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi, ai ≤ m"},{"kind":"text","text":") — the number of cell occupied by "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th frog initially and initial jump length. All "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" are guaranteed to be distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line output number of frogs on the final gameboard. In the second line output their numbers in any order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 5\n2 1\n5 3\n4 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n3 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6\n1 2\n3 4\n2 5\n5 1\n6 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 4 "}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample first frog jumps "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" cell and finishes in cell number "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". Second frog jumps for "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" cells and finishes on cell number "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", knocking out frog number "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Current jump length for frog number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" is now "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Third frog jumps to cell "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", then second frog jumps to cell "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". Third frog in turn finishes in cell "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" and removes frog "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" from the gameboard. Now, it's the only remaining frog in the game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample first frog jumps "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" cells and knocks out frogs in cells "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". Its value "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is now "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". Then fourth frog jumps and knocks out fifth frog and its "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is now "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" too. These two frogs will remains on the gameboard forever."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"625E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/625/problem/E"}