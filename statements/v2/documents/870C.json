{"assets":[],"contentKind":"statement","contestId":"870","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Maximum splitting"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given several queries. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query you are given a single positive integer "},{"kind":"math_inline","text":"ni"},{"kind":"text","text":". You are to represent "},{"kind":"math_inline","text":"ni"},{"kind":"text","text":" as a sum of maximum possible number of composite summands and print this maximum number, or print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":", if there are no such splittings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An integer greater than "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is composite, if it is not prime, i.e. if it has positive divisors not equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and the integer itself."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 105"},{"kind":"text","text":") — the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines follow. The ("},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":")-th line contains single integer "},{"kind":"math_inline","text":"ni"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ni ≤ 109"},{"kind":"text","text":") — the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query print the maximum possible number of summands in a valid splitting to composite summands, or "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":", if there are no such splittings."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n6\n8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1\n2\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n-1\n-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"math_inline","text":"12 = 4 + 4 + 4 = 4 + 8 = 6 + 6 = 12"},{"kind":"text","text":", but the first splitting has the maximum possible number of summands."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"8 = 4 + 4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" can't be split into several composite summands."}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"1, 2, 3"},{"kind":"text","text":" are less than any composite number, so they do not have valid splittings."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"870C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/870/problem/C"}