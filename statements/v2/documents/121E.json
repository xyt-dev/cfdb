{"assets":[],"contentKind":"statement","contestId":"121","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Lucky Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Petya loves lucky numbers. Everybody knows that lucky numbers are positive integers whose decimal representation contains only the lucky digits "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"7"}],"kind":"container"},{"kind":"text","text":". For example, numbers "},{"children":[{"kind":"text","text":"47"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"744"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"4"}],"kind":"container"},{"kind":"text","text":" are lucky and "},{"children":[{"kind":"text","text":"5"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"17"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"467"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya has an array consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" numbers. He wants to perform "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" operations of two types: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"add "},{"kind":"math_inline","text":"l"},{"kind":"math_inline","text":"r"},{"kind":"math_inline","text":"d"}],"kind":"container"},{"kind":"text","text":" — add an integer "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" to all elements whose indexes belong to the interval from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":", inclusive "},{"kind":"math_inline","text":"(1 ≤ l ≤ r ≤ n, 1 ≤ d ≤ 104)"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"count "},{"kind":"math_inline","text":"l"},{"kind":"math_inline","text":"r"}],"kind":"container"},{"kind":"text","text":" — find and print on the screen how many lucky numbers there are among elements with indexes that belong to the interval from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" inclusive "},{"kind":"math_inline","text":"(1 ≤ l ≤ r ≤ n)"},{"kind":"text","text":". Each lucky number should be counted as many times as it appears in the interval. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Petya has a list of all operations. The operations are such that after all additions the array won't have numbers that would exceed "},{"kind":"math_inline","text":"104"},{"kind":"text","text":". Help Petya write a program that would perform these operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":") — the number of numbers in the array and the number of operations correspondingly. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers, none of which exceeds "},{"kind":"math_inline","text":"104"},{"kind":"text","text":" — those are the array numbers. Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain operations, one per line. They correspond to the description given in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that after all operations are fulfilled each number in the array will not exceed "},{"kind":"math_inline","text":"104"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each operation of the second type print the single number on the single line — the number of lucky numbers in the corresponding interval."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6\n2 3 4\ncount 1 3\ncount 1 2\nadd 1 3 2\ncount 1 3\nadd 2 3 3\ncount 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n0\n1\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 5\n4 4 4 4\ncount 1 4\nadd 1 4 3\ncount 1 4\nadd 2 3 40\ncount 1 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n4\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample after the first addition the array will look in the following manner:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"4 5 6"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the second addition:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"4 8 9"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second sample after the first addition:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"7 7 7 7"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After the second addition:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"7 47 47 7"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"121E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/121/problem/E"}