\,244\\,353$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$$$$\\large S = \\sum_{m=3}^{n+1} \\sum_{k=0}^{n-1} a_{m,k}x^{mn+k}\\phantom{0}.$$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Output a single line with an integer: $$$S$$$ modulo $$$1\\,000\\,000\\,007$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that using two different modulos is intentional. We want you to calculate all the $$$a_{m,k}$$$ modulo $$$998\\,244\\,353$$$, then treat them like integers in the range $$$[0, 998\\,244\\,352]$$$, and hash them modulo $$$1\\,000\\,000\\,007$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n77824\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 1000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n30984329\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8 327869541\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"O