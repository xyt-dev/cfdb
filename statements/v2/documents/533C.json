{"assets":[],"contentKind":"statement","contestId":"533","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Board Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp and Vasiliy love simple logical games. Today they play a game with infinite chessboard and one pawn for each player. Polycarp and Vasiliy move in turns, Polycarp starts. In each turn Polycarp can move his pawn from cell "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(x - 1, y)"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"(x, y - 1)"},{"kind":"text","text":". Vasiliy can move his pawn from "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" to one of cells: "},{"kind":"math_inline","text":"(x - 1, y), (x - 1, y - 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(x, y - 1)"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"Both players"}],"kind":"container"},{"kind":"text","text":" are also allowed to skip move. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are some additional restrictions — a player is forbidden to move his pawn to a cell with negative "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-coordinate or "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"-coordinate or to the cell containing opponent's pawn The winner is the first person to reach cell "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the starting coordinates of both pawns. Determine who will win if both of them play optimally well."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains four integers: "},{"kind":"math_inline","text":"xp, yp, xv, yv"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ xp, yp, xv, yv ≤ 105)"},{"kind":"text","text":" — Polycarp's and Vasiliy's starting coordinates."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that in the beginning the pawns are in different cells and none of them is in the cell "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the name of the winner: \""},{"children":[{"kind":"text","text":"Polycarp"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"Vasiliy"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Polycarp\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 7 7 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Vasiliy\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test Polycarp starts in "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":" and will move to "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":" in the first turn. No matter what his opponent is doing, in the second turn Polycarp can move to "},{"kind":"math_inline","text":"(1, 0)"},{"kind":"text","text":" and finally to "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":" in the third turn."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"533C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/533/problem/C"}