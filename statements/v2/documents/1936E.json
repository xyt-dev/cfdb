{"assets":[],"contentKind":"statement","contestId":"1936","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Yet Yet Another Permutation Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a permutation $$$p$$$ of length $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please count the number of permutations $$$q$$$ of length $$$n$$$ which satisfy the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" for each $$$1 \\le i \\lt n$$$, $$$\\max(q_1,\\ldots,q_i) \\neq \\max(p_1,\\ldots,p_i)$$$."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Since the answer may be large, output the answer modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 10^4$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$2 \\le n \\le 2 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains $$$n$$$ integers $$$p_1, p_2, \\ldots, p_n$$$ ($$$1 \\le p_i \\le n$$$). It is guaranteed that $$$p$$$ is a permutation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single integer — the answer modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n2\n2 1\n3\n1 2 3\n3\n3 1 2\n4\n2 4 1 3\n5\n3 5 1 4 2\n15\n6 13 2 8 7 11 1 3 9 15 4 5 12 10 14\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n3\n2\n4\n18\n424488915\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, $$$p = [2, 1]$$$. The only suitable $$$q$$$ is $$$[1, 2]$$$. Indeed, we need to satisfy the inequality $$$q_1 \\neq p_1$$$. It only holds for $$$q = [1, 2]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, $$$p = [1, 2, 3]$$$. So $$$q$$$ has to satisfy two inequalities: $$$q_1 \\neq p_1$$$ and $$$\\max(q_1, q_2) \\neq \\max(1, 2) = 2$$$. One can prove that this only holds for the following $$$3$$$ permutations:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$q = [2, 3, 1]$$$: in this case $$$q_1 = 2 \\neq 1$$$ and $$$\\max(q_1, q_2) = 3 \\neq 2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$q = [3, 1, 2]$$$: in this case $$$q_1 = 3 \\neq 1$$$ and $$$\\max(q_1, q_2) = 3 \\neq 2$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$q = [3, 2, 1]$$$: in this case $$$q_1 = 3 \\neq 1$$$ and $$$\\max(q_1, q_2) = 3 \\neq 2$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1936E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1936/problem/E"}