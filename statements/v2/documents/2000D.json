{"assets":[],"contentKind":"statement","contestId":"2000","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Right Left Wrong"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vlad found a strip of $$$n$$$ cells, numbered from left to right from $$$1$$$ to $$$n$$$. In the $$$i$$$-th cell, there is a positive integer $$$a_i$$$ and a letter $$$s_i$$$, where all $$$s_i$$$ are either '"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"' or '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vlad invites you to try to score the maximum possible points by performing any (possibly zero) number of operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one operation, you can choose two indices $$$l$$$ and $$$r$$$ ($$$1 \\le l \\lt r \\le n$$$) such that $$$s_l$$$ = '"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"' and $$$s_r$$$ = '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"' and do the following:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" add $$$a_l + a_{l + 1} + \\dots + a_{r - 1} + a_r$$$ points to the current score; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" replace $$$s_i$$$ with '"},{"children":[{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":"' for all $$$l \\le i \\le r$$$, meaning you can no longer choose these indices. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, consider the following strip:"}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$3$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$5$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$1$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$4$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$3$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$2$$$"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"L"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"R"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"L"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"L"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"L"}],"kind":"container"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"children":[{"kind":"text","text":"R"}],"kind":"container"}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"}],"kind":"container"},{"children":[{"kind":"text","text":"You can first choose $$$l = 1$$$, $$$r = 2$$$ and add $$$3 + 5 = 8$$$ to your score."}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$3$$$"}],"kind":"table_cell"},{"attrs":{"header":false},"children":[{"kind":"text","text":"$$$5$$$"}],"k