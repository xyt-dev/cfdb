{"assets":["/statement-assets/185d702225be881398a4ff0a4474ab5ea5e182c7e415e4abf056fc0e54cb02c5.png"],"contentKind":"statement","contestId":"707","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Persistent Bookcase "}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Recently in school Alina has learned what are the "},{"children":[{"kind":"text","text":"persistent data structures"}],"kind":"container"},{"kind":"text","text":": they are data structures that always preserves the previous version of itself and access to it when it is modified."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After reaching home Alina decided to invent her own persistent data structure. Inventing didn't take long: there is a bookcase right behind her bed. Alina thinks that the bookcase is a good choice for a persistent data structure. Initially the bookcase is empty, thus there is no book at any position at any shelf."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The bookcase consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" shelves, and each shelf has exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" positions for books at it. Alina enumerates shelves by integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and positions at shelves — from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". Initially the bookcase is empty, thus there is no book at any position at any shelf in it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Alina wrote down "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" operations, which will be consecutively applied to the bookcase. Each of the operations has one of four types:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"j"},{"kind":"text","text":" — Place a book at position "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" at shelf "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" if there is no book at it."}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"j"},{"kind":"text","text":" — Remove the book from position "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" at shelf "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" if there is a book at it."}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"3"},{"kind":"math_inline","text":"i"},{"kind":"text","text":" — Invert book placing at shelf "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". This means that from every position at shelf "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" which has a book at it, the book should be removed, and at every position at shelf "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" which has not book at it, a book should be placed."}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"4"},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — Return the books in the bookcase in a state they were after applying "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th operation. In particular, "},{"kind":"math_inline","text":"k = 0"},{"kind":"text","text":" means that the bookcase should be in initial state, thus every book in the bookcase should be removed from its position."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"After applying each of operation Alina is interested in the number of books in the bookcase. Alina got 'A' in the school and had no problem finding this values. Will you do so?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 103"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ q ≤ 105"},{"kind":"text","text":") — the bookcase dimensions and the number of operations respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines describes operations in chronological order — "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them describes "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th operation in one of the four formats described in the statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that shelf indices and position indices are correct, and in each of fourth-type operation the number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" corresponds to some operation before it or equals to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each operation, print the number of books in the bookcase after applying it in a separate line. The answers should be printed in chronological order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3 3\n1 1 1\n3 2\n4 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n4\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2 6\n3 2\n2 2 2\n3 3\n3 2\n2 2 2\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n3\n3\n2\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 2\n3 2\n2 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/185d702225be881398a4ff0a4474ab5ea5e182c7e415e4abf056fc0e54cb02c5.png"},"kind":"image"},{"children":[{"kind":"text","text":"This image illustrates the second sample case."}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"707D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/707/problem/D"}