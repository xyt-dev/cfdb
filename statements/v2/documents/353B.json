{"assets":[],"contentKind":"statement","contestId":"353","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Two Heaps"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Valera has "},{"kind":"math_inline","text":"2·n"},{"kind":"text","text":" cubes, each cube contains an integer from "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"99"},{"kind":"text","text":". He arbitrarily chooses "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cubes and puts them in the first heap. The remaining cubes form the second heap. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valera decided to play with cubes. During the game he takes a cube from the first heap and writes down the number it has. Then he takes a cube from the second heap and write out its two digits near two digits he had written (to the right of them). In the end he obtained a single fourdigit integer — the first two digits of it is written on the cube from the first heap, and the second two digits of it is written on the second cube from the second heap."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valera knows arithmetic very well. So, he can easily count the number of distinct fourdigit numbers he can get in the game. The other question is: how to split cubes into two heaps so that this number (the number of distinct fourdigit integers Valera can get) will be as large as possible?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 100)"},{"kind":"text","text":". The second line contains "},{"kind":"math_inline","text":"2·n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"ai"},{"kind":"math_inline","text":"(10 ≤ ai ≤ 99)"},{"kind":"text","text":", denoting the numbers on the cubes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single number — the maximum possible number of distinct four-digit numbers Valera can obtain. In the second line print "},{"kind":"math_inline","text":"2·n"},{"kind":"text","text":" numbers "},{"kind":"math_inline","text":"bi"},{"kind":"math_inline","text":"(1 ≤ bi ≤ 2)"},{"kind":"text","text":". The numbers mean: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th cube belongs to the "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":"-th heap in your division."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple optimal ways to split the cubes into the heaps, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n10 99\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2 1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n13 24 13 45\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 2 1 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case Valera can put the first cube in the first heap, and second cube — in second heap. In this case he obtain number "},{"kind":"math_inline","text":"1099"},{"kind":"text","text":". If he put the second cube in the first heap, and the first cube in the second heap, then he can obtain number "},{"kind":"math_inline","text":"9910"},{"kind":"text","text":". In both cases the maximum number of distinct integers is equal to one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case Valera can obtain numbers "},{"kind":"math_inline","text":"1313, 1345, 2413, 2445"},{"kind":"text","text":". Note, that if he put the first and the third cubes in the first heap, he can obtain only two numbers "},{"kind":"math_inline","text":"1324"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1345"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"353B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/353/problem/B"}