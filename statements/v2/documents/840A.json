{"assets":["/statement-assets/f5c349324da7506affd7f96688217593bae51409628c607856d93961d2eae502.png"],"contentKind":"statement","contestId":"840","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Leha and Function"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Leha like all kinds of strange things. Recently he liked the function "},{"kind":"math_inline","text":"F(n, k)"},{"kind":"text","text":". Consider all possible "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-element subsets of the set "},{"kind":"math_inline","text":"[1, 2, ..., n]"},{"kind":"text","text":". For subset find minimal element in it. "},{"kind":"math_inline","text":"F(n, k)"},{"kind":"text","text":" — mathematical expectation of the minimal element among all "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-element subsets."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But only function does not interest him. He wants to do interesting things with it. Mom brought him two arrays "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":", each consists of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers. For all "},{"kind":"math_inline","text":"i, j"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"1 ≤ i, j ≤ m"},{"kind":"text","text":" the condition "},{"kind":"math_inline","text":"Ai ≥ Bj"},{"kind":"text","text":" holds. Help Leha rearrange the numbers in the array "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" so that the sum "},{"attrs":{"alt":"","src":"/statement-assets/f5c349324da7506affd7f96688217593bae51409628c607856d93961d2eae502.png"},"kind":"image"},{"kind":"text","text":" is maximally possible, where "},{"kind":"math_inline","text":"A'"},{"kind":"text","text":" is already rearranged array."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of input data contains single integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 2·105"},{"kind":"text","text":") — length of arrays "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"B"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., am"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — array "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"b1, b2, ..., bm"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ 109"},{"kind":"text","text":") — array "},{"kind":"math_inline","text":"B"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a'1, a'2, ..., a'm"},{"kind":"text","text":" — array "},{"kind":"math_inline","text":"A'"},{"kind":"text","text":" which is permutation of the array "},{"kind":"math_inline","text":"A"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n7 3 5 3 4\n2 1 3 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 7 3 5 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n4 6 5 8 8 2 6\n2 1 2 2 1 1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 6 4 5 8 8 6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"840A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/840/problem/A"}