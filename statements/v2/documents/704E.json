{"assets":["/statement-assets/dce5a165489d0f163cded6acd7bca6ecc1056bf1d6af982a0ba9c4545178ebf1.png"],"contentKind":"statement","contestId":"704","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Iron Man"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Tony Stark is playing a game with his suits (they have auto-pilot now). He lives in Malibu. Malibu has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" junctions numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", connected with "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" roads. One can get from a junction to any other junction using these roads (graph of Malibu forms a tree)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Tony has "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" suits. There's a special plan for each suit. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th suit will appear at the moment of time "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" in the junction "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", and will move to junction "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" using the shortest path between "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" with the speed "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" roads per second (passing a junctions takes no time), and vanishing immediately when arriving at "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" (if it reaches "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" in time "},{"kind":"math_inline","text":"q"},{"kind":"text","text":", it's available there at moment "},{"kind":"math_inline","text":"q"},{"kind":"text","text":", but not in further moments). Also, suits move continuously (for example if "},{"kind":"math_inline","text":"vi ≠ ui"},{"kind":"text","text":", at time "},{"attrs":{"alt":"","src":"/statement-assets/dce5a165489d0f163cded6acd7bca6ecc1056bf1d6af982a0ba9c4545178ebf1.png"},"kind":"image"},{"kind":"text","text":" it's in the middle of a road. Please note that if "},{"kind":"math_inline","text":"vi = ui"},{"kind":"text","text":" it means the suit will be at junction number "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" only at moment "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" and then it vanishes. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An explosion happens if at any moment of time two suits share the same exact location (it may be in a junction or somewhere on a road; while appearing, vanishing or moving)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to tell Tony the moment of the the first explosion (if there will be any)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100 000"},{"kind":"text","text":") — the number of junctions and the number of suits respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain the roads descriptions. Each line contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" — endpoints of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai ≠ bi"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the suit descriptions. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them contains four integers "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ti ≤ 10 000, 1 ≤ ci ≤ 10 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ vi, ui ≤ n"},{"kind":"text","text":"), meaning the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th suit will appear at moment of time "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" at the junction "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and will move to the junction "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" with a speed "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" roads per second."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there would be no explosions at all, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" in the first and only line of output."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print the moment of the first explosion."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your answer will be considered correct if its relative or absolute error doesn't exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 4\n2 5\n6 5\n3 6\n4 6\n4 1\n27 6 1 3\n9 5 1 6\n27 4 3 4\n11 29 2 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"27.3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 4\n3 1\n4 5\n6 4\n6 1\n2 6\n16 4 4 5\n13 20 6 2\n3 16 4 5\n28 5 3 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"704E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/704/problem/E"}