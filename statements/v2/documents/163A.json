{"assets":[],"contentKind":"statement","contestId":"163","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Substring and Subsequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day Polycarpus got hold of two non-empty strings "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", consisting of lowercase Latin letters. Polycarpus is quite good with strings, so he immediately wondered, how many different pairs of \""},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"y"},{"kind":"text","text":"\" are there, such that "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is a substring of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is a subsequence of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", and the content of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is the same. Two pairs are considered different, if they contain different substrings of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" or different subsequences of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". Read the whole statement to understand the definition of different substrings and subsequences."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"length"}],"kind":"container"},{"kind":"text","text":" of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is the number of characters in it. If we denote the length of the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"|s|"},{"kind":"text","text":", we can write the string as "},{"kind":"math_inline","text":"s = s1s2... s|s|"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a non-empty string "},{"kind":"math_inline","text":"x = s[a... b] = sasa + 1... sb"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a ≤ b ≤ |s|"},{"kind":"text","text":"). For example, \""},{"children":[{"kind":"text","text":"code"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"force"}],"kind":"container"},{"kind":"text","text":"\" are substrings or \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\", while \""},{"children":[{"kind":"text","text":"coders"}],"kind":"container"},{"kind":"text","text":"\" is not. Two substrings "},{"kind":"math_inline","text":"s[a... b]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s[c... d]"},{"kind":"text","text":" are considered to be "},{"children":[{"kind":"text","text":"different"}],"kind":"container"},{"kind":"text","text":" if "},{"kind":"math_inline","text":"a ≠ c"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"b ≠ d"},{"kind":"text","text":". For example, if "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"=\""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\", "},{"kind":"math_inline","text":"s[2...2]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"s[6...6]"},{"kind":"text","text":" are different, though their content is the same."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"subsequence"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is a non-empty string "},{"kind":"math_inline","text":"y = s[p1p2... p|y|] = sp1sp2... sp|y|"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ p1 < p2 < ... < p|y| ≤ |s|"},{"kind":"text","text":"). For example, \""},{"children":[{"kind":"text","text":"coders"}],"kind":"container"},{"kind":"text","text":"\" is a subsequence of \""},{"children":[{"kind":"text","text":"codeforces"}],"kind":"container"},{"kind":"text","text":"\". Two subsequences "},{"kind":"math_inline","text":"u = s[p1p2... p|u|]"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v = s[q1q2... q|v|]"},{"kind":"text","text":" are considered "},{"children":[{"kind":"text","text":"different"}],"kind":"container"},{"kind":"text","text":" if the sequences "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" are different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of two lines. The first of them contains "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 5000"},{"kind":"text","text":"), and the second one contains "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |t| ≤ 5000"},{"kind":"text","text":"). Both strings consist of lowercase Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the number of different pairs \""},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"y"},{"kind":"text","text":"\" such that "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is a substring of string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is a subsequence of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", and the content of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" is the same. As the answer can be rather large, print it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"aa\naa\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"codeforces\nforceofcode\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"60\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}