{"assets":[],"contentKind":"statement","contestId":"1998","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Find K Distinct Points with Fixed Center"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"children":[{"kind":"text","text":"I couldn't think of a good title for this problem, so I decided to learn from LeetCode."}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"— Sun Tzu, "},{"children":[{"kind":"text","text":"The Art of War"}],"kind":"container"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"You are given three integers $$$x_c$$$, $$$y_c$$$, and $$$k$$$ ($$$-100 \\leq x_c, y_c \\leq 100$$$, $$$1 \\leq k \\leq 1000$$$). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to find $$$k$$$ "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" points ($$$x_1, y_1$$$), ($$$x_2, y_2$$$), $$$\\ldots$$$, ($$$x_k, y_k$$$), having integer coordinates, on the 2D coordinate plane such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" their center$$$^{\\text{∗}}$$$ is ($$$x_c, y_c$$$) "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$-10^9 \\leq x_i, y_i \\leq 10^9$$$ for all $$$i$$$ from $$$1$$$ to $$$k$$$ "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It can be proven that at least one set of $$$k$$$ distinct points always exists that satisfies these conditions."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"$$$^{\\text{∗}}$$$The center of $$$k$$$ points ($$$x_1, y_1$$$), ($$$x_2, y_2$$$), $$$\\ldots$$$, ($$$x_k, y_k$$$) is $$$\\left( \\frac{x_1 + x_2 + \\ldots + x_k}{k}, \\frac{y_1 + y_2 + \\ldots + y_k}{k} \\right)$$$."}],"kind":"paragraph"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains $$$t$$$ ($$$1 \\leq t \\leq 100$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case contains three integers $$$x_c$$$, $$$y_c$$$, and $$$k$$$ ($$$-100 \\leq x_c, y_c \\leq 100$$$, $$$1 \\leq k \\leq 1000$$$) — the coordinates of the center and the number of distinct points you must output."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$k$$$ over all test cases does not exceed $$$1000$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output $$$k$$$ lines, the $$$i$$$-th line containing two space separated integers, $$$x_i$$$ and $$$y_i$$$, ($$$-10^9 \\leq x_i, y_i \\leq 10^9$$$) — denoting the position of the $$$i$$$-th point."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any of them. It can be shown that a solution always exists under the given constraints."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n10 10 1\n0 0 3\n-5 -8 8\n4 -5 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n10 10\n-1 -1\n5 -1\n-4 2\n-6 -7\n-5 -7\n-4 -7\n-4 -8\n-4 -9\n-5 -9\n-6 -9\n-6 -8\n1000 -1000\n-996 995\n8 -10"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first test case, $$$\\left( \\frac{10}{1}, \\frac{10}{1} \\right) = (10, 10)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second test case, $$$\\left( \\frac{-1 + 5 - 4}{3}, \\frac{-1 -1 + 2}{3} \\right) = (0, 0)$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1998A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1998/problem/A"}