{"assets":[],"contentKind":"statement","contestId":"1537","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E1. Erase and Extend (Easy Version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is the easy version of the problem. The only difference is the constraints on $$$n$$$ and $$$k$$$. You can make hacks only if all versions of the problem are solved."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have a string $$$s$$$, and you can do two types of operations on it: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Delete the last character of the string. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Duplicate the string: $$$s:=s+s$$$, where $$$+$$$ denotes concatenation. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You can use each operation any number of times (possibly none)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the lexicographically smallest string of length exactly $$$k$$$ that can be obtained by doing these operations on string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string $$$a$$$ is lexicographically smaller than a string $$$b$$$ if and only if one of the following holds:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a$$$ is a prefix of $$$b$$$, but $$$a\\ne b$$$; 