{"assets":[],"contentKind":"statement","contestId":"394","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Dominoes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"During the break, we decided to relax and play dominoes. Our box with Domino was empty, so we decided to borrow the teacher's dominoes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The teacher responded instantly at our request. He put "},{"kind":"math_inline","text":"nm"},{"kind":"text","text":" dominoes on the table as an "},{"kind":"math_inline","text":"n × 2m"},{"kind":"text","text":" rectangle so that each of the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows contained "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" dominoes arranged horizontally. Each half of each domino contained number (0 or 1)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We were taken aback, and the teacher smiled and said: \"Consider some arrangement of dominoes in an "},{"kind":"math_inline","text":"n × 2m"},{"kind":"text","text":" matrix. Let's count for each column of the matrix the sum of numbers in this column. Then among all such sums find the maximum one. Can you rearrange the dominoes in the matrix in such a way that the maximum sum will be minimum possible? Note that it is prohibited to change the orientation of the dominoes, they all need to stay horizontal, nevertheless dominoes are allowed to rotate by 180 degrees. As a reward I will give you all my dominoes\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We got even more taken aback. And while we are wondering what was going on, help us make an optimal matrix of dominoes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 103"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next lines there is a description of the teachers' matrix. Each of next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" dominoes. The description of one domino is two integers (0 or 1), written without a space — the digits on the left and right half of the domino."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the resulting matrix of dominoes in the format: "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each of them contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space-separated dominoes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple optimal solutions, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n01 11 00\n00 01 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11 11 10\n00 00 01\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n11\n10\n01\n00\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n10\n01\n00\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the answer for the first sample. There, the maximum sum among all columns equals "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" (the number of columns is "},{"kind":"math_inline","text":"6"},{"kind":"text","text":", and not "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"). Obviously, this maximum can't be less than "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", then such matrix is optimal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the dominoes can be rotated by "},{"kind":"math_inline","text":"180"},{"kind":"text","text":" degrees."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"394C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/394/problem/C"}