{"assets":[],"contentKind":"statement","contestId":"818","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Level Generation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ivan is developing his own computer game. Now he tries to create some levels for his game. But firstly for each level he needs to draw a graph representing the structure of the level."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ivan decided that there should be exactly "},{"kind":"math_inline","text":"ni"},{"kind":"text","text":" vertices in the graph representing level "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", and the edges have to be bidirectional. When constructing the graph, Ivan is interested in special edges called "},{"children":[{"kind":"text","text":"bridges"}],"kind":"container"},{"kind":"text","text":". An edge between two vertices "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is called a "},{"children":[{"kind":"text","text":"bridge"}],"kind":"container"},{"kind":"text","text":" if this edge belongs to every path between "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" (and these vertices will belong to different connected components if we delete this edge). For each level Ivan wants to construct a graph where at least half of the edges are "},{"children":[{"kind":"text","text":"bridges"}],"kind":"container"},{"kind":"text","text":". He also wants to maximize the number of edges in each constructed graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So the task Ivan gave you is: given "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" numbers "},{"kind":"math_inline","text":"n1, n2, ..., nq"},{"kind":"text","text":", for each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" tell the maximum number of edges in a graph with "},{"kind":"math_inline","text":"ni"},{"kind":"text","text":" vertices, if at least half of the edges are "},{"children":[{"kind":"text","text":"bridges"}],"kind":"container"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"Note that the graphs cannot contain multiple edges or self-loops"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input file contains a positive integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ q ≤ 100 000"},{"kind":"text","text":") — the number of graphs Ivan needs to construct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines follow, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains one positive integer "},{"kind":"math_inline","text":"ni"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ni ≤ 2·109"},{"kind":"text","text":") — the number of vertices in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th graph."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Note that in hacks you have to use "},{"kind":"math_inline","text":"q = 1"},{"kind":"text","text":"."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" numbers, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them must be equal to the maximum number of edges in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th graph."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3\n4\n6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n3\n6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example it is possible to construct these graphs:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"1 - 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 - 3"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1 - 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 - 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 - 4"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1 - 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 - 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"2 - 3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 - 4"},