{"assets":[],"contentKind":"statement","contestId":"1864","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Increasing and Decreasing"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given three integers $$$x$$$, $$$y$$$, and $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to construct an array $$$a$$$ consisting of $$$n$$$ integers which satisfies the following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" $$$a_1=x$$$, $$$a_n=y$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a$$$ is "},{"children":[{"kind":"text","text":"strictly"}],"kind":"container"},{"kind":"text","text":" increasing (i.e. $$$a_1 \\lt a_2 \\lt \\ldots \\lt a_n$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if we denote $$$b_i=a_{i+1}-a_{i}$$$ for $$$1 \\leq i \\leq n-1$$$, then $$$b$$$ is "},{"children":[{"kind":"text","text":"strictly"}],"kind":"container"},{"kind":"text","text":" decreasing (i.e. $$$b_1 \\gt b_2 \\gt \\ldots \\gt b_{n-1}$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there is no such array $$$a$$$, print a single integer $$$-1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 1000$$$). The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains three integers $$$x$$$, $$$y$$$, $$$n$$$ ($$$1 \\le x \\lt y \\le 1000,3 \\le n \\le 1000$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output $$$n$$$ integers $$$a_1,a_2,\\ldots,a_n$$$. If there are multiple solutions, print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is no solution, print a single integer $$$-1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 4 3\n1 3 3\n100 200 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 3 4\n-1\n100 150 180 200\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, $$$a=[1,3,4]$$$, which is strictly increasing. Next, $$$b_1=a_2-a_1=3-1=2$$$, $$$b_2=a_3-a_2=4-3=1$$$, thus $$$b=[2,1]$$$, which is strictly decreasing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, there is no array $$$a$$$ that satisfies all the conditions above."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1864A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1864/problem/A"}