{"assets":["/statement-assets/82d5d2810cd3d95dc4daf32ad02c7cb456cf184af438cedaf0c375aa75dcfef0.png"],"contentKind":"statement","contestId":"715","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Complete the Permutations"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"ZS the Coder is given two permutations "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"{1, 2, ..., n}"},{"kind":"text","text":", but some of their elements are replaced with "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". The "},{"children":[{"kind":"text","text":"distance"}],"kind":"container"},{"kind":"text","text":" between two permutations "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" is defined as the minimum number of moves required to turn "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"q"},{"kind":"text","text":". A move consists of swapping exactly "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" elements of "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"ZS the Coder wants to determine the number of ways to replace the zeros with positive integers from the set "},{"kind":"math_inline","text":"{1, 2, ..., n}"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" are permutations of "},{"kind":"math_inline","text":"{1, 2, ..., n}"},{"kind":"text","text":" and the distance between "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" is exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"ZS the Coder wants to find the answer for all "},{"kind":"math_inline","text":"0 ≤ k ≤ n - 1"},{"kind":"text","text":". Can you help him?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 250"},{"kind":"text","text":") — the number of elements in the permutations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ pi ≤ n"},{"kind":"text","text":") — the permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":". It is guaranteed that there is at least one way to replace zeros such that "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is a permutation of "},{"kind":"math_inline","text":"{1, 2, ..., n}"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, "},{"kind":"math_inline","text":"q1, q2, ..., qn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ qi ≤ n"},{"kind":"text","text":") — the permutation "},{"kind":"math_inline","text":"q"},{"kind":"text","text":". It is guaranteed that there is at least one way to replace zeros such that "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" is a permutation of "},{"kind":"math_inline","text":"{1, 2, ..., n}"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should denote the answer for "},{"kind":"math_inline","text":"k = i - 1"},{"kind":"text","text":". Since the answer may be quite large, and ZS the Coder loves weird primes, print them modulo "},{"kind":"math_inline","text":"998244353 = 223·7·17 + 1"},{"kind":"text","text":", which is a prime."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 0 0\n0 2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 0 0 3\n0 0 0 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 2 6 4 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n1 3 2 5 4 6\n6 4 5 1 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 0 0 0 1 1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 3 4\n2 3 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 0 0 1 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case, there is the only way to replace zeros so that it takes "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" swaps to convert "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"q"},{"kind":"text","text":", namely "},{"kind":"math_inline","text":"p = (1, 2, 3), q = (1, 2, 3)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are two ways to replace zeros so that it takes "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" swap to turn "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"q"},{"kind":"text","text":". One of these ways is "},{"kind":"math_inline","text":"p = (1, 2, 3), q = (3, 2, 1)"},{"kind":"text","text":", then swapping "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" transform it into "},{"kind":"math_inline","text":"q"},{"kind":"text","text":". The other way is "},{"kind":"math_inline","text":"p = (1, 3, 2), q = (1, 2, 3)"},{"kind":"text","text":". Swapping "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" works in this case."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Finally, there is one way to replace zeros so that it takes "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" swaps to turn "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"q"},{"kind":"text","text":", namely "},{"kind":"math_inline","text":"p = (1, 3, 2), q = (3, 2, 1)"},{"kind":"text","text":". Then, we can transform "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" into "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" like following: "},{"attrs":{"alt":"","src":"/statement-assets/82d5d2810cd3d95dc4daf32ad02c7cb456cf184af438cedaf0c375aa75dcfef0.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"715E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/715/problem/E"}