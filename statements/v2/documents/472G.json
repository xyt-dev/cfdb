{"assets":[],"contentKind":"statement","contestId":"472","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Design Tutorial: Increase the Constraints"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"7 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a simple way to create hard tasks: take one simple problem as the query, and try to find an algorithm that can solve it faster than bruteforce. This kind of tasks usually appears in OI contest, and usually involves data structures."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's try to create a task, for example, we take the \"Hamming distance problem\": for two binary strings "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" with the same length, the Hamming distance between them is the number of positions at which the corresponding symbols are different. For example, the Hamming distance between \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"01"},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"1\" and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"01"},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"1\" is 2 (the different symbols are marked with bold)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We use the Hamming distance problem as a query in the following way: you are given two strings "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and several queries. Each query will be: what is the Hamming distance between two strings "},{"kind":"math_inline","text":"ap1ap1 + 1...ap1 + len - 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bp2bp2 + 1...bp2 + len - 1"},{"kind":"text","text":"?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note, that in this problem the strings are "},{"children":[{"kind":"text","text":"zero-based"}],"kind":"container"},{"kind":"text","text":", that is "},{"kind":"math_inline","text":"s = s0s1... s|s| - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a string "},{"kind":"math_inline","text":"a"},{"kind":"math_inline","text":"(1 ≤ |a| ≤ 200000)"},{"kind":"text","text":". The second line contains a string "},{"kind":"math_inline","text":"b"},{"kind":"math_inline","text":"(1 ≤ |b| ≤ 200000)"},{"kind":"text","text":". Each character of both strings is either \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains an integer "},{"kind":"math_inline","text":"q"},{"kind":"math_inline","text":"(1 ≤ q ≤ 400000)"},{"kind":"text","text":" — the number of queries. Each of the following "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains three integers: "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"len"},{"kind":"math_inline","text":"(0 ≤ p1 ≤ |a| - len; 0 ≤ p2 ≤ |b| - len)"},{"kind":"text","text":", these numbers denote the parameters of the current query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" integers — the answers for the queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"101010\n11110000\n3\n0 0 3\n2 3 4\n5 7 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10001010101011001010100101010011010\n101010100101001010100100101010\n5\n0 0 12\n3 9 7\n6 4 15\n12 15 10\n13 3 20\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n4\n3\n5\n13\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"472G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/472/problem/G"}