{"assets":[],"contentKind":"statement","contestId":"346","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Lucky Common Subsequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In mathematics, a "},{"children":[{"kind":"text","text":"subsequence"}],"kind":"container"},{"kind":"text","text":" is a sequence that can be derived from another sequence by deleting some elements without changing the order of the remaining elements. For example, the sequence "},{"children":[{"kind":"text","text":"BDF"}],"kind":"container"},{"kind":"text","text":" is a subsequence of "},{"children":[{"kind":"text","text":"ABCDEF"}],"kind":"container"},{"kind":"text","text":". A "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":" of a string is a continuous subsequence of the string. For example, "},{"children":[{"kind":"text","text":"BCD"}],"kind":"container"},{"kind":"text","text":" is a substring of "},{"children":[{"kind":"text","text":"ABCDEF"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given two strings "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"s2"},{"kind":"text","text":" and another string called "},{"kind":"math_inline","text":"virus"},{"kind":"text","text":". Your task is to find the longest common subsequence of "},{"kind":"math_inline","text":"s1"},{"kind":"text","text":" and "},{"kind":"math_i