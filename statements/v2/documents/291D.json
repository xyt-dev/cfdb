{"assets":[],"contentKind":"statement","contestId":"291","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Parallel Programming"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarpus has a computer with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" processors. Also, his computer has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" memory cells. We'll consider the processors numbered by integers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and that the memory cells are consecutively numbered by integers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarpus needs to come up with a parallel program model. For each memory cell number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" this program must record the value "},{"kind":"math_inline","text":"n - i"},{"kind":"text","text":" to this cell. In other words, for each cell you've got to find the distance to cell "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's denote the value that is written in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th cell as "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". Initially, "},{"kind":"math_inline","text":"ai = 1"},{"kind":"math_inline","text":"(1 ≤ i < n)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"an = 0"},{"kind":"text","text":". We will consider that only processor "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" can write values in the memory cell number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". All processors can read an information from some cell (several processors can read an information from some cell simultaneously)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The parallel program is executed in several steps. During each step we execute the "},{"children":[{"kind":"text","text":"parallel version of the increment operation"}],"kind":"container"},{"kind":"text","text":". Executing the parallel version of the increment operation goes as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Each processor independently of the other ones chooses some memory cell. Let's say that processor "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has chosen a cell with number "},{"kind":"math_inline","text":"ci"},{"kind":"math_inline","text":"(1 ≤ ci ≤ n)"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" All processors "},{"children":[{"kind":"text","text":"simultaneously"}],"kind":"container"},{"kind":"text","text":" execute operation "},{"kind":"math_inline","text":"ai = ai + aci"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Polycarpus come up with the parallel program model that is executed in exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" steps. Calculate the operations that need to be executed. Note that after "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" steps for all "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"'s value "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" must be equal "},{"kind":"math_inline","text":"n - i"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n ≤ 104, 1 ≤ k ≤ 20)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that at the given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" the required sequence of operations exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print exactly "},{"kind":"math_inline","text":"n·k"},{"kind":"text","text":" integers in "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines. In the first line print numbers "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"math_inline","text":"(1 ≤ ci ≤ n)"},{"kind":"text","text":" for the first increment operation. In the second line print the numbers for the second increment operation. In the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th line print the numbers for the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"-th increment operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As a result of the printed operations for any "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" value "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" must equal "},{"kind":"math_inline","text":"n - i"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 3 3\n3 3 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"291D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/291/problem/D"}