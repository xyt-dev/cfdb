{"assets":[],"contentKind":"statement","contestId":"166","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Shoe Store"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The warehouse in your shop has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" shoe pairs. Each pair is characterized by two integers: its price "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" and its size "},{"kind":"math_inline","text":"si"},{"kind":"text","text":". We know that on this very day all numbers "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" are different, that is, there is no more than one pair of each size."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The shop has "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" customers who came at the same time. The customer number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" money and the size of his feet equals "},{"kind":"math_inline","text":"li"},{"kind":"text","text":". The customer number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" can buy the pair number "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", if "},{"kind":"math_inline","text":"cj ≤ di"},{"kind":"text","text":", and also if "},{"kind":"math_inline","text":"li = sj"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"li = sj - 1"},{"kind":"text","text":"; that is, it is necessary that he has enough money to pay for the shoes. It is also necessary that the size of his feet equals to or is less by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" than the size of the shoes he chooses."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to sell some customers pairs of shoes (a pair per person) so as to maximize the sum of the sold pairs "},{"kind":"math_inline","text":"cj"},{"kind":"text","text":" that is, the profit. It is guaranteed that each customer buys no more than one pair and each pair will be bought by no more than one customer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains the only integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of shoe pairs in the warehouse. Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the descriptions of pairs of shoes as two integers "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci, si ≤ 109"},{"kind":"text","text":"), the numbers are separated by a space. It is guaranteed that all numbers "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" are different."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains an integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 105"},{"kind":"text","text":") — the number of customers in the shop. Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the customers' descriptions as two integers "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ di, li ≤ 109"},{"kind":"text","text":"), the numbers are separated by a space."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print the only integer — the maximum profit you can get from selling shoes. In the second line print an integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of shoe pairs you will sell. In the following "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines print the descriptions of the sold pairs — two space-separated integers where the first number is the customer's number and the second number is the number of the shoes the customer will buy."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can print pairs of numbers \"the customer's number and the shoes' number\" in any order, the customers and the pairs of shoes are numbered starting from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" in the order in which they are given in the input. If there are several optimal answers, you are allowed to print any of them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please do not use the %lld specificator to read or write 64-bit numbers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the %I64d specificator instead."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n10 1\n30 2\n20 3\n2\n20 1\n20 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"30\n2\n2 3\n1 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n10 4\n20 5\n30 6\n2\n70 4\n50 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"50\n2\n2 3\n1 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"166D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/166/problem/D"}