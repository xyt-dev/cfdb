racters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line of the input contains one string $$$t$$$ of length $$$2$$$ consisting of characters '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' and '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"'."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is impossible to find the suitable string, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" on the first line. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" on the first line and string $$$res$$$ on the second line. $$$res$$$ should consist of $$$3n$$$ characters, $$$n$$$ characters should be '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"', $$$n$$$ characters should be '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' and $$$n$$$ characters should be '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"' and $$$s$$$ and $$$t$$$ should not occur in $$$res$$$ as substrings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"chi