{"assets":[],"contentKind":"statement","contestId":"67","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Partial Teacher"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A teacher decides to give toffees to his students. He asks "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" students to stand in a queue. Since the teacher is very partial, he follows the following rule to distribute toffees."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He looks at the first two students and gives more toffees to the student having higher marks than the other one. If they have the same marks they get the same number of toffees. The same procedure is followed for each pair of adjacent students starting from the first one to the last one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is given that each student receives at least one toffee. You have to find the number of toffees given to each student by the teacher such that the total number of toffees is minimum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains the number of students "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 1000"},{"kind":"text","text":"). The second line gives ("},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":") characters consisting of \""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"="}],"kind":"container"},{"kind":"text","text":"\". For each pair of adjacent students \""},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"\" means that the left student has higher marks, \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\" means that the right student has higher marks and \""},{"children":[{"kind":"text","text":"="}],"kind":"container"},{"kind":"text","text":"\" means that both have equal marks. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers separated by a space representing the number of toffees each student receives in the queue starting from the first one to the last one."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nLRLR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1 2 1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n=RRR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 1 2 3 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"67A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/67/problem/A"}