{"assets":[],"contentKind":"statement","contestId":"387","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. George and Sleep"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"George woke up and saw the current time "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" on the digital clock. Besides, George knows that he has slept for time "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help George! Write a program that will, given time "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", determine the time "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" when George went to bed. Note that George could have gone to bed yesterday relatively to the current time (see the second test sample). "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains current time "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" as a string in the format \""},{"children":[{"kind":"text","text":"hh:mm"}],"kind":"container"},{"kind":"text","text":"\". The second line contains time "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in the format \""},{"children":[{"kind":"text","text":"hh:mm"}],"kind":"container"},{"kind":"text","text":"\" — the duration of George's sleep. It is guaranteed that the input contains the correct time in the 24-hour format, that is, "},{"kind":"math_inline","text":"00 ≤ hh ≤ 23"},{"kind":"text","text":", "},{"kind":"math_inline","text":"00 ≤ mm ≤ 59"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the single line print time "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" — the time George went to bed in the format similar to the format of the time in the input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"05:50\n05:44\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"00:06\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"00:00\n01:00\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"23:00\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"00:01\n00:00\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"00:01\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample George went to bed at \""},{"children":[{"kind":"text","text":"00:06"}],"kind":"container"},{"kind":"text","text":"\". Note that you should print the time only in the format \""},{"children":[{"kind":"text","text":"00:06"}],"kind":"container"},{"kind":"text","text":"\". That's why answers \""},{"children":[{"kind":"text","text":"0:06"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"00:6"}],"kind":"container"},{"kind":"text","text":"\" and others will be considered incorrect. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, George went to bed yesterday."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, George didn't do to bed at all."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"387A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/387/problem/A"}