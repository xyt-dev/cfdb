{"assets":[],"contentKind":"statement","contestId":"1600","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"J. Robot Factory"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have received data from a Bubble bot. You know your task is to make factory facilities, but before you even start, you need to know how big the factory is and how many rooms it has. When you look at the data you see that you have the dimensions of the construction, which is in rectangle shape: N x M. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then in the next N lines you have M numbers. These numbers represent factory tiles and they can go from 0 to 15. Each of these numbers should be looked in its binary form. Because from each number you know on which side the tile has walls. For example number 10 in it's binary form is 1010, which means that it has a wall from the "},{"children":[{"kind":"text","text":"North"}],"kind":"container"},{"kind":"text","text":" side, it doesn't have a wall from the "},{"children":[{"kind":"text","text":"East"}],"kind":"container"},{"kind":"text","text":", it has a wall on the "},{"children":[{"kind":"text","text":"South"}],"kind":"container"},{"kind":"text","text":" side and it doesn't have a wall on the "},{"children":[{"kind":"text","text":"West"}],"kind":"container"},{"kind":"text","text":" side. So it goes North, East, South, West. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the construction always has walls on it's edges. The input will be correct. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to print the size of the rooms from biggest to smallest. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line has two numbers which are N and M, the size of the construction. Both are integers: "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$n$$$ ($$$1 \\leq n \\leq 10^3$$$)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$m$$$ ($$$1 \\leq m \\leq 10^3$$$)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next N x M numbers represent each tile of construction."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Once you finish processing the data your output consists of one line sorted from "},{"children":[{"kind":"text","text":"biggest"}],"kind":"container"},{"kind":"text","text":" to "},{"children":[{"kind":"text","text":"smallest"}],"kind":"container"},{"kind":"text","text":" room sizes. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4 5\n9 14 11 12 13\n5 15 11 6 7\n5 9 14 9 14\n3 2 14 3 14\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n9 4 4 2 1 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"J","problemCode":"1600J","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1600/problem/J"}