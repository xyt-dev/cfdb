{"assets":["/statement-assets/3c5c4befc2406670b97489c3ab0d9368779e1de8e52466a6e9a5d2acb234a057.png","/statement-assets/19911c8bfc3291e5bbbfd0c8a8238fd7c9c79bb272ee3cfad5ceaffa487309cb.png"],"contentKind":"statement","contestId":"2206","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Subtree Removal Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1024 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a "},{"children":[{"kind":"text","text":"rooted tree"}],"kind":"container"},{"kind":"text","text":" with $$$n$$$ nodes, numbered from $$$1$$$ to $$$n$$$, rooted at node $$$1$$$. For each node $$$i$$$ ($$$2 \\le i \\le n$$$), its parent is node $$$p_i$$$. For each node $$$i$$$, if it is a "},{"children":[{"kind":"text","text":"leaf"}],"kind":"container"},{"kind":"text","text":" (a node having no children), the integer $$$i$$$ is written on it. Otherwise, nothing is written."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Node $$$u$$$ is a "},{"children":[{"kind":"text","text":"descendant"}],"kind":"container"},{"kind":"text","text":" of node $$$v$$$ if $$$u = v$$$, or $$$u$$$ is not the root and the parent of $$$u$$$ is a descendant of $$$v$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now, you and your friend play a game on this tree, taking turns alternately: You move first, then your friend, and so on. On each turn, the current player must choose a node $$$v$$$ and then remove the entire subtree of $$$v$$$ (i.e., all descendants of $$$v$$$, including $$$v$$$ itself). The move is allowed only if, "},{"children":[{"kind":"text","text":"after"}],"kind":"container"},{"kind":"text","text":" the removal, at least one node with an integer written on it remains in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The game ends when no further moves are possible. At that point, exactly one node with an integer written on it remains; the "},{"children":[{"kind":"text","text":"score"}],"kind":"container"},{"kind":"text","text":" of the game is the integer on that node."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You aim to minimize the score, while your friend aims to maximize it. Assuming you and your friend play optimally, determine the score of the game."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains an integer $$$n$$$ ($$$2 \\le n \\le 500\\,000$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n-1$$$ integers $$$p_2, p_3, \\ldots, p_n$$$ ($$$1 \\le p_i \\lt i$$$ for all $$$2 \\le i \\le n$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the score of the game assuming you and your friend play optimally."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n1 2 2 1 5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n1 1 3 2 5 4 5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"children":[{"kind":"text","text":"Explanation for the sample input/output #1"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The given tree is illustrated in Figure B.1 (a)."}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/3c5c4befc2406670b97489c3ab0d9368779e1de8e52466a6e9a5d2acb234a057.png"},"kind":"image"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"Figure B.1: Illustration of Sample Input #1."}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"}],"kind":"container"},{"children":[{"kind":"text","text":"The only optimal moves for both players are as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" You choose node $$$5$$$. Then nodes $$$5$$$, $$$6$$$, and $$$7$$$ are removed (Figure B.1 (b)). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Your friend chooses node $$$3$$$. Then only node $$$3$$$ is removed (Figure B.1 (c)). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" You cannot make any moves, and the game ends. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" After these moves, only one node with an integer written on it, node $$$4$$$, remains. The score of this game is $$$4$$$."},{"children":[{"children":[{"kind":"text","text":"Explanation for the sample input/output #2"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The given tree is illustrated in Figure B.2. One of the optimal moves for you is to choose node $$$2$$$. The game ends after that, and the score is $$$7$$$."}],"kind":"paragraph"},{"children":[{"children":[{"children":[{"children":[{"attrs":{"header":false},"children":[{"attrs":{"alt":"","src":"/statement-assets/19911c8bfc3291e5bbbfd0c8a8238fd7c9c79bb272ee3cfad5ceaffa487309cb.png"},"kind":"image"}],"kind":"table_cell"}],"kind":"table_row"},{"children":[{"attrs":{"header":false},"children":[{"kind":"text","text":"Figure B.2: Illustration of Sample Input #2."}],"kind":"table_cell"}],"kind":"table_row"}],"kind":"table_body"}],"kind":"table"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"2206B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2206/problem/B"}