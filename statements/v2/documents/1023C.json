{"assets":[],"contentKind":"statement","contestId":"1023","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Bracket Subsequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A bracket sequence is a string containing only characters \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\". A regular bracket sequence is a bracket sequence that can be transformed into a correct arithmetic expression by inserting characters \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" between the original characters of the sequence. For example, bracket sequences \""},{"children":[{"kind":"text","text":"()()"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"(())"}],"kind":"container"},{"kind":"text","text":"\" are regular (the resulting expressions are: \""},{"children":[{"kind":"text","text":"(1)+(1)"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"((1+1)+1)"}],"kind":"container"},{"kind":"text","text":"\"), and \""},{"children":[{"kind":"text","text":")("}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"("}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":")"}],"kind":"container"},{"kind":"text","text":"\" are not."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Subsequence is a sequence that can be derived from another sequence by deleting some elements without changing the order of the remaining elements."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a regular bracket sequence $$$s$$$ and an integer number $$$k$$$. Your task is to find a regular bracket sequence of length exactly $$$k$$$ such that it is also a subsequence of $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that such sequence always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$k$$$ ($$$2 \\le k \\le n \\le 2 \\cdot 10^5$$$, both $$$n$$$ and $$$k$$$ are even) — the length of $$$s$$$ and the length of the sequence you are asked to find."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line is a string $$$s$$$ — regular bracket sequence of length $$$n$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single string — a regular bracket sequence of length exactly $$$k$$$ such that it is also a subsequence of $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that such sequence always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children