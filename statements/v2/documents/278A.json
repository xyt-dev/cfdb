{"assets":[],"contentKind":"statement","contestId":"278","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Circle Line"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The circle line of the Berland subway has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" stations. We know the distances between all pairs of neighboring stations:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"d1"},{"kind":"text","text":" is the distance between the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st and the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd station;"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"d2"},{"kind":"text","text":" is the distance between the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-nd and the "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-rd station;"},{"children":[{"kind":"text","text":"..."}],"kind":"paragraph"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"dn - 1"},{"kind":"text","text":" is the distance between the "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":"-th and the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th station;"}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"dn"},{"kind":"text","text":" is the distance between the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th and the "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"-st station."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The trains go along the circle line in both directions. Find the shortest distance between stations with numbers "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 100"},{"kind":"text","text":") — the number of stations on the circle line. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"d1, d2, ..., dn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ di ≤ 100"},{"kind":"text","text":") — the distances between pairs of neighboring stations. The third line contains two integers "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ s, t ≤ n"},{"kind":"text","text":") — the numbers of stations, between which you need to find the shortest distance. These numbers can be the same."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The numbers in the lines are separated by single spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the length of the shortest path between stations number "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n2 3 4 9\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n5 8 2 100\n4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"15\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 1\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n31 41 59\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the length of path "},{"kind":"math_inline","text":"1 → 2 → 3"},{"kind":"text","text":" equals 5, the length of path "},{"kind":"math_inline","text":"1 → 4 → 3"},{"kind":"text","text":" equals 13."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample the length of path "},{"kind":"math_inline","text":"4 → 1"},{"kind":"text","text":" is 100, the length of path "},{"kind":"math_inline","text":"4 → 3 → 2 → 1"},{"kind":"text","text":" is 15."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample the length of path "},{"kind":"math_inline","text":"3 → 1"},{"kind":"text","text":" is 1, the length of path "},{"kind":"math_inline","text":"3 → 2 → 1"},{"kind":"text","text":" is 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth sample the numbers of stations are the same, so the shortest distance equals 0."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"278A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/278/problem/A"}