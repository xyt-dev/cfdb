nd":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You should find two vectors from the set and determine which of their coordinates should be multiplied by "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" so that the absolute value of the sum of the resulting vectors was minimally possible. More formally, you should choose two vectors "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i, j ≤ n, i ≠ j"},{"kind":"text","text":") and two numbers "},{"kind":"math_inline","text":"k1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"k2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k1, k2 ≤ 4"},{"kind":"text","text":"), so that the value of the expression "},{"kind":"math_inline","text":"|vik1 + vjk2|"},{"kind":"text","text":" were minimum."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":"). Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain vectors as pairs of integers \""},{"kind":"math_inline","text":"xi"},{"kind":"math_inline","text":"yi"},{"kind":"text","text":"\" ("},{"kind":"math_inline","text":" - 10000 ≤ xi, yi ≤ 10000"},{"kind":"text","text":"), one pair per line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print on the first line four space-separated numbers \""},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"k1"},{"kind":"math_inline","text":"j"},{"kind":"math_inline","text":"k2"},{"kind":"text","text":"\" — the answer to the problem. If there are several variants the absolute value of whose sums is minimum, you can print any of them. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n-7 -3\n9 0\n-8 6\n7 -8\n4 -5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 2 4 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n3 2\n-4 7\n-6 0\n-8 4\n5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3 4 5 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A sum of two vectors "},{"kind":"math_inline","text":"v = (xv, yv)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u = (xu, yu)"},{"kind":"text","text":" is vector "},{"kind":"math_inline","text":"s = v + u = (xv + xu, yv + yu)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"An absolute value of vector "},{"kind":"math_inline","text":"v = (x, y)"},{"kind":"text","text":" is number "},{"attrs":{"alt":"","src":"/statement-assets/62e725084cb541b19a04221ed1dc6107040231fa4cc3478727ffa61e90412897.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample there are several valid answers, such as:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"(3 1 4 2), (3 1 4 4), (3 4 4 1), (3 4 4 3), (4 1 3 2), (4 1 3 4), (4 2 3 1)."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"J","problemCode":"120J","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/120/problem/J"}