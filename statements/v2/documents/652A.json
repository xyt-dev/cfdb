{"assets":[],"contentKind":"statement","contestId":"652","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Gabriel and Caterpillar"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"9"},{"kind":"text","text":"-th grade student Gabriel noticed a caterpillar on a tree when walking around in a forest after the classes. The caterpillar was on the height "},{"kind":"math_inline","text":"h1"},{"kind":"text","text":" cm from the ground. On the height "},{"kind":"math_inline","text":"h2"},{"kind":"text","text":" cm ("},{"kind":"math_inline","text":"h2 > h1"},{"kind":"text","text":") on the same tree hung an apple and the caterpillar was crawling to the apple."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Gabriel is interested when the caterpillar gets the apple. He noted that the caterpillar goes up by "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" cm per hour by day and slips down by "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" cm per hour by night."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In how many days Gabriel should return to the forest to see the caterpillar get the apple. You can consider that the day starts at "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" am and finishes at "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" pm. Gabriel's classes finish at "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" pm. You can consider that Gabriel noticed the caterpillar just after the classes at "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" pm."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the forest is magic so the caterpillar can slip down under the ground and then lift to the apple."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"h1, h2"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ h1 < h2 ≤ 105"},{"kind":"text","text":") — the heights of the position of the caterpillar and the apple in centimeters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains two integers "},{"kind":"math_inline","text":"a, b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ 105"},{"kind":"text","text":") — the distance the caterpillar goes up by day and slips down by night, in centimeters per hour."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of days Gabriel should wait to return to the forest and see the caterpillar getting the apple."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the caterpillar can't get the apple print the only integer "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 30\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 13\n1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 19\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 50\n5 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example at "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" pm of the first day the caterpillar gets the height "},{"kind":"math_inline","text":"26"},{"kind":"text","text":". At "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" am of the next day it slips down to the height "},{"kind":"math_inline","text":"14"},{"kind":"text","text":". And finally at "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" pm of the same day the caterpillar gets the apple."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that in the last example the caterpillar was slipping down under the ground and getting the apple on the next day."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"652A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/652/problem/A"}