{"assets":["/statement-assets/47afe18719d76f8601a34fa48908e2974593ad0ec9c852ccb28150968f5ebe6b.png","/statement-assets/e318b36a88369b2eb3e95c107a6d178488936625e3d38dee2051b45e22d511e5.png"],"contentKind":"statement","contestId":"364","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Beautiful Set"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"We'll call a set of positive integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" beautiful if the following condition fulfills: for any prime "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", if "},{"attrs":{"alt":"","src":"/statement-assets/47afe18719d76f8601a34fa48908e2974593ad0ec9c852ccb28150968f5ebe6b.png"},"kind":"image"},{"kind":"text","text":", then "},{"attrs":{"alt":"","src":"/statement-assets/e318b36a88369b2eb3e95c107a6d178488936625e3d38dee2051b45e22d511e5.png"},"kind":"image"},{"kind":"text","text":". In other words, if one number from the set is divisible by prime "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", then at least half of numbers from the set is divisible by "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find any beautiful set, where the number of elements is equal to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and each element doesn't exceed "},{"kind":"math_inline","text":"2k2"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"10 ≤ k ≤ 5000"},{"kind":"text","text":") that shows how many numbers the required beautiful set should have."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" space-separated integers that are a beautiful set. If there are multiple such sets, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"16 18 24 27 36 48 54 72 108 144 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"364C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/364/problem/C"}