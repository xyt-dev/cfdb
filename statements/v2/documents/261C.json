{"assets":["/statement-assets/fead36777bfb50be746c29cf61029d4480a52a51755600febc921743c63794ee.png"],"contentKind":"statement","contestId":"261","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Maxim and Matrix"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Maxim loves to fill in a matrix in a special manner. Here is a pseudocode of filling in a matrix of size "},{"kind":"math_inline","text":"(m + 1) × (m + 1)"},{"kind":"text","text":":"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/fead36777bfb50be746c29cf61029d4480a52a51755600febc921743c63794ee.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Maxim asks you to count, how many numbers "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ m ≤ n)"},{"kind":"text","text":" are there, such that the sum of values in the cells in the row number "},{"kind":"math_inline","text":"m + 1"},{"kind":"text","text":" of the resulting matrix equals "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Expression ("},{"kind":"math_inline","text":"x"},{"kind":"math_inline","text":"xor"},{"kind":"math_inline","text":"y"},{"kind":"text","text":") means applying the operation of bitwise excluding \"OR\" to numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". The given operation exists in all modern programming languages. For example, in languages "},{"children":[{"kind":"text","text":"C++"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"Java"}],"kind":"container"},{"kind":"text","text":" it is represented by character \""},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":"\", in "},{"children":[{"kind":"text","text":"Pascal"}],"kind":"container"},{"kind":"text","text":" — by \""},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"A single line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"(1 ≤ n, t ≤ 1012, t ≤ n + 1)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in "},{"children":[{"kind":"text","text":"C++"}],"kind":"container"},{"kind":"text","text":". It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In a single line print a single integer — the answer to the problem. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"childr