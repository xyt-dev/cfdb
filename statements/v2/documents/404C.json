{"assets":[],"contentKind":"statement","contestId":"404","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Restore Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Valera had an undirected connected graph without self-loops and multiple edges consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. The graph had an interesting property: there were at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" edges adjacent to each of its vertices. For convenience, we will assume that the graph vertices were indexed by integers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One day Valera counted the shortest distances from one of the graph vertices to all other ones and wrote them out in array "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". Thus, element "},{"kind":"math_inline","text":"d[i]"},{"kind":"text","text":" of the array shows the shortest distance from the vertex Valera chose to vertex number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then something irreparable terrible happened. Valera lost the initial graph. However, he still has the array "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". Help him restore the lost graph."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ k < n ≤ 105)"},{"kind":"text","text":". Number "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" shows the number of vertices in the original graph. Number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" shows that at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" edges were adjacent to each vertex in the original graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains space-separated integers "},{"kind":"math_inline","text":"d[1], d[2], ..., d[n]"},{"kind":"math_inline","text":"(0 ≤ d[i] < n)"},{"kind":"text","text":". Number "},{"kind":"math_inline","text":"d[i]"},{"kind":"text","text":" shows the shortest distance from the vertex Valera chose to the vertex number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If Valera made a mistake in his notes and the required graph doesn't exist, print in the first line number -1. Otherwise, in the first line print integer "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(0 ≤ m ≤ 106)"},{"kind":"text","text":" — the number of edges in the found graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines print two space-separated integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"math_inline","text":"(1 ≤ ai, bi ≤ n; ai ≠ bi)"},{"kind":"text","text":", denoting the edge that connects vertices with numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". The graph shouldn't contain self-loops and multiple edges. If there are multiple possible answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n0 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n1 3\n3 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n2 0 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 3\n1 4\n2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n0 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"404C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/404/problem/C"}