{"assets":["/statement-assets/4c21fc9ed15104ec96aea9587860dd5aa5e51af6c17eba6653adf97c20f4879a.png","/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"],"contentKind":"statement","contestId":"242","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. XOR on Segment"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got an array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". You are allowed to perform two operations on this array:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Calculate the sum of current array elements on the segment "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":", that is, count value "},{"kind":"math_inline","text":"al + al + 1 + ... + ar"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Apply the xor operation with a given number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to each array element on the segment "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":", that is, execute "},{"attrs":{"alt":"","src":"/statement-assets/4c21fc9ed15104ec96aea9587860dd5aa5e51af6c17eba6653adf97c20f4879a.png"},"kind":"image"},{"kind":"text","text":". This operation changes exactly "},{"kind":"math_inline","text":"r - l + 1"},{"kind":"text","text":" array elements. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Expression "},{"attrs":{"alt":"","src":"/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"},"kind":"image"},{"kind":"text","text":" means applying bitwise xor operation to numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". The given operation exists in all modern programming languages, for example in language "},{"children":[{"kind":"text","text":"C++"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"Java"}],"kind":"container"},{"kind":"text","text":" it is marked as \""},{"children":[{"kind":"text","text":"^"}],"kind":"container"},{"kind":"text","text":"\", in "},{"children":[{"kind":"text","text":"Pascal"}],"kind":"container"},{"kind":"text","text":" — as \""},{"children":[{"kind":"text","text":"xor"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You've got a list of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" operations of the indicated type. Your task is to perform all given operations, for each sum query you should print the result you get."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the size of the array. The second line contains space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 106"},{"kind":"text","text":") — the original array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 5·104"},{"kind":"text","text":") — the number of operations with the array. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines first contains an integer "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ti ≤ 2"},{"kind":"text","text":") — the type of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query. If "},{"kind":"math_inline","text":"ti = 1"},{"kind":"text","text":", then this is the query of the sum, if "},{"kind":"math_inline","text":"ti = 2"},{"kind":"text","text":", then this is the query to change array elements. If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th operation is of type "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", then next follow two integers "},{"kind":"math_inline","text":"li, ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":"). If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th operation is of type "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", then next follow three integers "},{"kind":"math_inline","text":"li, ri, xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n, 1 ≤ xi ≤ 106"},{"kind":"text","text":"). The numbers on the lines are separated by single spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of type "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" print in a single line the sum of numbers on the given segment. Print the answers to the queries in the order in which the queries go in the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams, or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n4 10 3 13 7\n8\n1 2 4\n2 1 3 3\n1 2 4\n1 3 3\n2 2 5 5\n1 1 5\n2 1 2 10\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"26\n22\n0\n34\n11\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n4 7 4 0 7 3\n5\n2 2 3 8\n1 1 5\n2 3 5 1\n2 4 5 6\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"38\n28\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"242E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/242/problem/E"}