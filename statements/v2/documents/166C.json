{"assets":["/statement-assets/145ab4144072ddcf0491e95bf3d59aad93b7da8fb042d20dfb58a55622dbd347.png","/statement-assets/e7e529d90db5fa3f10f6939ff01c73968b010a20a732a17b9a0eadbec259c229.png","/statement-assets/0d458acf089c5edab6db0b80b0180dcbe2b4458c66e0dd4d3f247b3c20d5a3ff.png"],"contentKind":"statement","contestId":"166","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Median"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"median"}],"kind":"container"},{"kind":"text","text":" in an array with the length of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is an element which occupies position number "},{"attrs":{"alt":"","src":"/statement-assets/145ab4144072ddcf0491e95bf3d59aad93b7da8fb042d20dfb58a55622dbd347.png"},"kind":"image"},{"kind":"text","text":" after we sort the elements in the non-decreasing order (the array elements are numbered starting with "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"). A median of an array "},{"kind":"math_inline","text":"(2, 6, 1, 2, 3)"},{"kind":"text","text":" is the number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", and a median of array "},{"kind":"math_inline","text":"(0, 96, 17, 23)"},{"kind":"text","text":" — the number "},{"kind":"math_inline","text":"17"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We define an expression "},{"attrs":{"alt":"","src":"/statement-assets/e7e529d90db5fa3f10f6939ff01c73968b010a20a732a17b9a0eadbec259c229.png"},"kind":"image"},{"kind":"text","text":" as the integer part of dividing number "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" by number "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One day Vasya showed Petya an array consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers and suggested finding the array's median. Petya didn't even look at the array and said that it equals "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". Petya is a very honest boy, so he decided to add several numbers to the given array so that the median of the resulting array would be equal to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Petya can add any integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"105"},{"kind":"text","text":" to the array, including the same numbers. Of course, he can add nothing to the array. If a number is added multiple times, then we should consider it the number of times it occurs. It is not allowed to delete of change initial numbers of the array. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"While Petya is busy distracting Vasya, your task is to find the minimum number of elements he will need."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 500"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ x ≤ 105"},{"kind":"text","text":") — the initial array's length and the required median's value. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated numbers — the initial array. The elements of the array are integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"105"},{"kind":"text","text":". The array elements are not necessarily different."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the only integer — the minimum number of elements Petya needs to add to the array so that its median equals "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 10\n10 20 30\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample we can add number "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" to array "},{"kind":"math_inline","text":"(10, 20, 30)"},{"kind":"text","text":". The resulting array "},{"kind":"math_inline","text":"(9, 10, 20, 30)"},{"kind":"text","text":" will have a median in position "},{"attrs":{"alt":"","src":"/statement-assets/0d458acf089c5edab6db0b80b0180dcbe2b4458c66e0dd4d3f247b3c20d5a3ff.png"},"kind":"image"},{"kind":"text","text":", that is, "},{"kind":"math_inline","text":"10"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample you should add numbers "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":". The resulting array has median equal to "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"166C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/166/problem/C"}