{"assets":[],"contentKind":"statement","contestId":"997","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Convert to Ones"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got a string $$$a_1, a_2, \\dots, a_n$$$, consisting of zeros and ones."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call a sequence of consecutive elements $$$a_i, a_{i + 1}, \\ldots, a_j$$$ ($$$1\\leq i\\leq j\\leq n$$$) a "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":" of string $$$a$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can apply the following operations any number of times:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose some substring of string $$$a$$$ (for example, you can choose entire string) and reverse it, paying $$$x$$$ coins for it (for example, «"},{"children":[{"kind":"text","text":"01"},{"children":[{"kind":"text","text":"011"}],"kind":"container"},{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":"» $$$\\to$$$ «"},{"children":[{"kind":"text","text":"01"},{"children":[{"kind":"text","text":"110"}],"kind":"container"},{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":"»); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Choose some substring of string $$$a$$$ (for example, you can choose entire string or just one symbol) and replace each symbol to the opposite one (zeros are replaced by ones, and ones — by zeros), paying $$$y$$$ coins for it (for example, «"},{"children":[{"kind":"text","text":"01"},{"children":[{"kind":"text","text":"011"}],"kind":"container"},{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":"» $$$\\to$$$ «"},{"children":[{"kind":"text","text":"01"},{"children":[{"kind":"text","text":"100"}],"kind":"container"},{"kind":"text","text":"01"}],"kind":"container"},{"kind":"text","text":"»). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You can apply these operations in any order. It is allowed to apply the operations multiple times to the same substring."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of coins you need to spend to get a string consisting only of ones?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains integers $$$n$$$, $$$x$$$ and $$$y$$$ ($$$1 \\leq n \\leq 300\\,000, 0 \\leq x, y \\leq 10^9$$$) — length of the string, cost of the first operation (substring reverse) and cost of the second operation (inverting all elements of substring)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string $$$a$$$ of length $$$n$$$, consisting of zeros and ones."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum total cost of operations you need to spend to get a string consisting only of ones. Print $$$0$$$, if you do not need to perform any operations."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1 10\n01000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 10 1\n01000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 2 3\n1111111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, at first you need to reverse substring $$$[1 \\dots 2]$$$, and then you need to invert substring $$$[2 \\dots 5]$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then the string was changed as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"«"},{"children":[{"kind":"text","text":"01000"}],"kind":"container"},{"kind":"text","text":"» $$$\\to$$$ «"},{"children":[{"kind":"text","text":"10000"}],"kind":"container"},{"kind":"text","text":"» $$$\\to$$$ «"},{"children":[{"kind":"text","text":"11111"}],"kind":"container"},{"kind":"text","text":"»."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The total cost of operations is $$$1 + 10 = 11$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, at first you need to invert substring $$$[1 \\dots 1]$$$, and then you need to invert substring $$$[3 \\dots 5]$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then the string was changed as follows:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"«"},{"children":[{"kind":"text","text":"01000"}],"kind":"container"},{"kind":"text","text":"» $$$\\to$$$ «"},{"children":[{"kind":"text","text":"11000"}],"kind":"container"},{"kind":"text","text":"» $$$\\to$$$ «"},{"children":[{"kind":"text","text":"11111"}],"kind":"container"},{"kind":"text","text":"»."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The overall cost is $$$1 + 1 = 2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, string already consists only of ones, so the answer is $$$0$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"997A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/997/problem/A"}