{"assets":[],"contentKind":"statement","contestId":"1363","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Subsequence Hate"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Shubham has a binary string $$$s$$$. A binary string is a string containing only characters \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He can perform the following operation on the string any amount of times: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Select an index of the string, and flip the character at that index. This means, if the character was \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\", it becomes \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\", and vice versa. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A string is called good if it does not contain \""},{"children":[{"kind":"text","text":"010"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"101"}],"kind":"container"},{"kind":"text","text":"\" as a subsequence  — for instance, \""},{"children":[{"kind":"text","text":"1001"}],"kind":"container"},{"kind":"text","text":"\" contains \""},{"children":[{"kind":"text","text":"101"}],"kind":"container"},{"kind":"text","text":"\" as a subsequence, hence it is not a good string, while \""},{"children":[{"kind":"text","text":"1000"}],"kind":"container"},{"kind":"text","text":"\" doesn't contain neither \""},{"children":[{"kind":"text","text":"010"}],"kind":"container"},{"kind":"text","text":"\" nor \""},{"children":[{"kind":"text","text":"101"}],"kind":"container"},{"kind":"text","text":"\" as subsequences, so it is a good string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of operations he will have to perform, so that the string becomes good? It can be shown that with these operations we can make any string good."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A string $$$a$$$ is a subsequence of a string $$$b$$$ if $$$a$$$ can be obtained from $$$b$$$ by deletion of several (possibly, zero or all) characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer $$$t$$$ $$$(1\\le t \\le 100)$$$ — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$t$$$ lines contains a binary string $$$s$$$ $$$(1 \\le |s| \\le 1000)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For every string, output the minimum number of operations required to make it good."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n001\n100\n101\n010\n0\n1\n001100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n0\n1\n1\n0\n0\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In test cases $$$1$$$, $$$2$$$, $$$5$$$, $$$6$$$ no operations are required since they are already good strings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the $$$3$$$rd test case: \""},{"children":[{"kind":"text","text":"001"}],"kind":"container"},{"kind":"text","text":"\" can be achieved by flipping the first character  — and is one of the possible ways to get a good string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the $$$4$$$th test case: \""},{"children":[{"kind":"text","text":"000"}],"kind":"container"},{"kind":"text","text":"\" can be achieved by flipping the second character  — and is one of the possible ways to get a good string."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the $$$7$$$th test case: \""},{"children":[{"kind":"text","text":"000000"}],"kind":"container"},{"kind":"text","text":"\" can be achieved by flipping the third and fourth characters  — and is one of the possible ways to get a good string."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1363B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1363/problem/B"}