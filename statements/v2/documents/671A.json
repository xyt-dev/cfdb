{"assets":["/statement-assets/7400ce840a2dd7f70d5f7169f546af9aec8b1b7c0c18043b50670a606baf03d2.png","/statement-assets/2bc1ee36bb23e7126ef0849dd04b0a8a5667428cc41e48040231e5b0c0af31fa.png","/statement-assets/c7490645459c70dad5e9b3c5d0ef245ce7bd0a2918d56d49b52261205754ad17.png","/statement-assets/eaf61f0038ae747fa8dc3c586b2b4ae1d77e7e11bd4cdf0de2775d6175892208.png","/statement-assets/cc30a40f53f35f3ed75604fa74645fa01c0bd70492c186e8a511a36296836d1f.png"],"contentKind":"statement","contestId":"671","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Recycling Bottles"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"It was recycling day in Kekoland. To celebrate it Adil and Bera went to Central Perk where they can take bottles from the ground and put them into a recycling bin."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We can think Central Perk as coordinate plane. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" bottles on the ground, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th bottle is located at position "},{"kind":"math_inline","text":"(xi, yi)"},{"kind":"text","text":". Both Adil and Bera can carry only one bottle at once each. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For both Adil and Bera the process looks as follows: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Choose to stop or to continue to collect bottles. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If the choice was to continue then choose some bottle and walk towards it. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Pick this bottle and walk to the recycling bin. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Go to step "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Adil and Bera may move independently. They are allowed to pick bottles simultaneously, all bottles may be picked by any of the two, it's allowed that one of them stays still while the other one continues to pick bottles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"They want to organize the process such that the total distance they walk (the sum of distance walked by Adil and distance walked by Bera) is minimum possible. Of course, at the end all bottles should lie in the recycling bin."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of the input contains six integers "},{"kind":"math_inline","text":"ax"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ay"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bx"},{"kind":"text","text":", "},{"kind":"math_inline","text":"by"},{"kind":"text","text":", "},{"kind":"math_inline","text":"tx"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ty"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ax, ay, bx, by, tx, ty ≤ 109"},{"kind":"text","text":") — initial positions of Adil, Bera and recycling bin respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the number of bottles on the ground."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, each of them contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ xi, yi ≤ 109"},{"kind":"text","text":") — position of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th bottle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that positions of Adil, Bera, recycling bin and all bottles are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one real number — the minimum possible total distance Adil and Bera need to walk in order to put all bottles into recycling bin. Your answer will be considered correct if its absolute or relative error does not exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Namely: let's assume that your answer is "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and the answer of the jury is "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The checker program will consider your answer correct if "},{"attrs":{"alt":"","src":"/statement-assets/7400ce840a2dd7f70d5f7169f546af9aec8b1b7c0c18043b50670a606baf03d2.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 1 2 0 0\n3\n1 1\n2 1\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11.084259940083\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 0 4 2 2 0\n5\n5 2\n3 0\n5 5\n3 5\n3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"33.121375178000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first sample."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Adil will use the following path: "},{"attrs":{"alt":"","src":"/statement-assets/2bc1ee36bb23e7126ef0849dd04b0a8a5667428cc41e48040231e5b0c0af31fa.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Bera will use the following path: "},{"attrs":{"alt":"","src":"/statement-assets/c7490645459c70dad5e9b3c5d0ef245ce7bd0a2918d56d49b52261205754ad17.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Adil's path will be "},{"attrs":{"alt":"","src":"/statement-assets/eaf61f0038ae747fa8dc3c586b2b4ae1d77e7e11bd4cdf0de2775d6175892208.png"},"kind":"image"},{"kind":"text","text":" units long, while Bera's path will be "},{"attrs":{"alt":"","src":"/statement-assets/cc30a40f53f35f3ed75604fa74645fa01c0bd70492c186e8a511a36296836d1f.png"},"kind":"image"},{"kind":"text","text":" units long."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"671A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/671/problem/A"}