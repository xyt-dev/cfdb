{"assets":[],"contentKind":"statement","contestId":"407","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Long Path"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day, little Vasya found himself in a maze consisting of "},{"kind":"math_inline","text":"(n + 1)"},{"kind":"text","text":" rooms, numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"(n + 1)"},{"kind":"text","text":". Initially, Vasya is at the first room and to get out of the maze, he needs to get to the "},{"kind":"math_inline","text":"(n + 1)"},{"kind":"text","text":"-th one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The maze is organized as follows. Each room of the maze has two one-way portals. Let's consider room number "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ n)"},{"kind":"text","text":", someone can use the first portal to move from it to room number "},{"kind":"math_inline","text":"(i + 1)"},{"kind":"text","text":", also someone can use the second portal to move from it to room number "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"1 ≤ pi ≤ i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In order not to get lost, Vasya decided to act as follows. "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Each time Vasya enters some room, he paints a cross on its ceiling. Initially, Vasya paints a cross at the ceiling of room "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Let's assume that Vasya is in room "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and has already painted a cross on its ceiling. Then, if the ceiling now contains an odd number of crosses, Vasya uses the second portal (it leads to room "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":"), otherwise Vasya uses the first portal. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Vasya determine the number of times he needs to use portals to get to room "},{"kind":"math_inline","text":"(n + 1)"},{"kind":"text","text":" in the end."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 103"},{"kind":"text","text":") — the number of rooms. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ i"},{"kind":"text","text":"). Each "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" denotes the number of the room, that someone can reach, if he will use the second portal in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th room."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the number of portal moves the boy needs to go out of the maze. As the number can be rather large, print it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"math_inline","text":"(109 + 7)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"62\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"407B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/407/problem/B"}