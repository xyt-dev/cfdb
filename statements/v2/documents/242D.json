{"assets":[],"contentKind":"statement","contestId":"242","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Dispute"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Valera has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" counters numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Some of them are connected by wires, and each of the counters has a special button."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially, all the counters contain number "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". When you press a button on a certain counter, the value it has increases by one. Also, the values recorded in all the counters, directly connected to it by a wire, increase by one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valera and Ignat started having a dispute, the dispute is as follows. Ignat thought of a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". Valera should choose some set of distinct counters and press buttons on each of them exactly once (on other counters the buttons won't be pressed). If after that there is a counter with the number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", which has value "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", then Valera loses the dispute, otherwise he wins the dispute."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Valera to determine on which counters he needs to press a button to win the dispute."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 105)"},{"kind":"text","text":", that denote the number of counters Valera has and the number of pairs of counters connected by wires."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two space-separated integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"math_inline","text":"(1 ≤ ui, vi ≤ n, ui ≠ vi)"},{"kind":"text","text":", that mean that counters with numbers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" are connected by a wire. It is guaranteed that each pair of connected counters occurs exactly once in the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(0 ≤ ai ≤ 105)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the value that Ignat choose for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th counter."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If Valera can't win the dispute print in the first line -1."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print in the first line integer "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(0 ≤ k ≤ n)"},{"kind":"text","text":". In the second line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" distinct space-separated integers — the numbers of the counters, where Valera should push buttons to win the dispute, in arbitrary order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there exists multiple answers, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\n2 3\n4 1\n1 5\n5 3\n2 1\n1 1 2 0 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n1 2\n3 4\n0 0 0 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 3 4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"242D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/242/problem/D"}