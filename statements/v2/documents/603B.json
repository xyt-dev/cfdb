{"assets":["/statement-assets/0bd9dd07f3514f5199bed893f92540a066ad69346616ac7ac1283bcb94aedf74.png","/statement-assets/9c9d797ca8e344e17d218645facb109cd5b91fd20f6363e40b497359ee329bf7.png"],"contentKind":"statement","contestId":"603","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Moodular Arithmetic"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As behooves any intelligent schoolboy, Kevin Sun is studying psycowlogy, cowculus, and cryptcowgraphy at the Bovinia State University (BGU) under Farmer Ivan. During his Mathematics of Olympiads (MoO) class, Kevin was confronted with a weird functional equation and needs your help. For two fixed integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is an odd prime number, the functional equation states that "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/0bd9dd07f3514f5199bed893f92540a066ad69346616ac7ac1283bcb94aedf74.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"for some function "},{"attrs":{"alt":"","src":"/statement-assets/9c9d797ca8e344e17d218645facb109cd5b91fd20f6363e40b497359ee329bf7.png"},"kind":"image"},{"kind":"text","text":". (This equation should hold for any integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" in the range "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"p - 1"},{"kind":"text","text":", inclusive.)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It turns out that "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" can actually be many different functions. Instead of finding a solution, Kevin wants you to count the number of distinct functions "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" that satisfy this equation. Since the answer may be very large, you should print your result modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of two space-separated integers "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ p ≤ 1 000 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ k ≤ p - 1"},{"kind":"text","text":") on a single line. It is guaranteed that "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is an odd prime number."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer, the number of distinct functions "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"25\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, "},{"kind":"math_inline","text":"p = 3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":". The following functions work: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"f(0) = 0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f(1) = 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f(2) = 2"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"f(0) = 0"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f(1) = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"f(2) = 1"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"f(0) = f(1) = f(2) = 0"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"603B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/603/problem/B"}