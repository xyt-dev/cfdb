{"assets":["/statement-assets/77d371ca4428b4c1988beb54808c8cddc1c6f03eb578baf8a67974633b2a5378.png"],"contentKind":"statement","contestId":"286","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Main Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As you know, Vova has recently become a new shaman in the city of Ultima Thule. So, he has received the shaman knowledge about the correct bracket sequences. The shamans of Ultima Thule have been using lots of different types of brackets since prehistoric times. A bracket type is a positive integer. The shamans define a correct bracket sequence as follows:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" An empty sequence is a correct bracket sequence. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"{a1, a2, ..., al}"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"{b1, b2, ..., bk}"},{"kind":"text","text":" are correct bracket sequences, then sequence "},{"kind":"math_inline","text":"{a1, a2, ..., al, b1, b2, ..., bk}"},{"kind":"text","text":" (their concatenation) also is a correct bracket sequence. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"{a1, a2, ..., al}"},{"kind":"text","text":" — is a correct bracket sequence, then sequence "},{"attrs":{"alt":"","src":"/statement-assets/77d371ca4428b4c1988beb54808c8cddc1c6f03eb578baf8a67974633b2a5378.png"},"kind":"image"},{"kind":"text","text":" also is a correct bracket sequence, where "},{"kind":"math_inline","text":"v"},{"kind":"math_inline","text":"(v > 0)"},{"kind":"text","text":" is an integer. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, sequences "},{"kind":"math_inline","text":"{1, 1,  - 1, 2,  - 2,  - 1}"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"{3,  - 3}"},{"kind":"text","text":" are correct bracket sequences, and "},{"kind":"math_inline","text":"{2,  - 3}"},{"kind":"text","text":" is not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Moreover, after Vova became a shaman, he learned the "},{"children":[{"kind":"text","text":"most important"}],"kind":"container"},{"kind":"text","text":" correct bracket sequence "},{"kind":"math_inline","text":"{x1, x2, ..., xn}"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. As sequence "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is the most important, Vova decided to encrypt it just in case."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Encrypting consists of two sequences. The first sequence "},{"kind":"math_inline","text":"{p1, p2, ..., pn}"},{"kind":"text","text":" contains types of brackets, that is, "},{"kind":"math_inline","text":"pi = |xi|"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ i ≤ n"},{"kind":"text","text":"). The second sequence "},{"kind":"math_inline","text":"{q1, q2, ..., qt}"},{"kind":"text","text":" contains "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" integers — "},{"children":[{"kind":"text","text":"some positions"}],"kind":"container"},{"kind":"text","text":" (possibly, not all of them), which had negative numbers in sequence "},{"kind":"math_inline","text":"{x1, x2, ..., xn}"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, Vova forgot the main sequence. But he was lucky enough to keep the encryption: sequences "},{"kind":"math_inline","text":"{p1, p2, ..., pn}"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"{q1, q2, ..., qt}"},{"kind":"text","text":". Help Vova restore sequence "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" by the encryption. If there are multiple sequences that correspond to the encryption, restore any of them. If there are no such sequences, you should tell so."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 106"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"p1, p2, ..., pn"},{"kind":"math_inline","text":"(1 ≤ pi ≤ 109)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ t ≤ n"},{"kind":"text","text":"), followed by "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"q1, q2, ..., qt"},{"kind":"math_inline","text":"(1 ≤ qi ≤ n)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The numbers in each line are separated by spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single string \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) if Vova is mistaken and a suitable sequence "},{"kind":"math_inline","text":"{x1, x2, ..., xn}"},{"kind":"text","text":" doesn't exist."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, in the first line print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without the quotes) and in the second line print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"math_inline","text":"(|xi| = pi; xqj < 0)"},{"kind":"text","text":". If there are multiple sequences that correspond to the encrypting, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1 -1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1 1 1\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1 1 -1 -1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 1\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 2 1\n2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n1 2 -2 -1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"286C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/286/problem/C"}