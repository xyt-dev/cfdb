{"assets":[],"contentKind":"statement","contestId":"868","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Huge Strings"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" strings "},{"kind":"math_inline","text":"s1, s2, ..., sn"},{"kind":"text","text":" consisting of characters "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" operations are performed, on each of them you concatenate two existing strings into a new one. On the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th operation the concatenation "},{"kind":"math_inline","text":"saisbi"},{"kind":"text","text":" is saved into a new string "},{"kind":"math_inline","text":"sn + i"},{"kind":"text","text":" (the operations are numbered starting from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"). After each operation you need to find the maximum positive integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" such that all possible strings consisting of "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" (there are "},{"kind":"math_inline","text":"2k"},{"kind":"text","text":" such strings) are substrings of the new string. If there is no such "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", print "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100"},{"kind":"text","text":") — the number of strings. The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain strings "},{"kind":"math_inline","text":"s1, s2, ..., sn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |si| ≤ 100"},{"kind":"text","text":"), one per line. The total length of strings is not greater than "},{"kind":"math_inline","text":"100"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains single integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 100"},{"kind":"text","text":") — the number of operations. "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follow, each of them contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" abd "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ n + i - 1"},{"kind":"text","text":") — the number of strings that are concatenated to form "},{"kind":"math_inline","text":"sn + i"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines, each should contain one integer — the answer to the question after the corresponding operation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n01\n10\n101\n11111\n0\n3\n1 2\n6 5\n4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first operation, a new string \""},{"children":[{"kind":"text","text":"0110"}],"kind":"container"},{"kind":"text","text":"\" is created. For "},{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":" the two possible binary strings of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" are \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\", they are substrings of the new string. For "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":" and greater there exist strings of length "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" that do not appear in this string (for "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":" such string is \""},{"children":[{"kind":"text","text":"00"}],"kind":"container"},{"kind":"text","text":"\"). So the answer is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"On the second operation the string \""},{"children":[{"kind":"text","text":"0110