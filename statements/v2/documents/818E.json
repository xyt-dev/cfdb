{"assets":[],"contentKind":"statement","contestId":"818","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Card Game Again"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vova again tries to play some computer card game."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The rules of deck creation in this game are simple. Vova is given an existing deck of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cards and a magic number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". The order of the cards in the deck is fixed. Each card has a number written on it; number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is written on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th card in the deck."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After receiving the deck and the magic number, Vova removes "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" (possibly "},{"kind":"math_inline","text":"x = 0"},{"kind":"text","text":") cards from the top of the deck, "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" (possibly "},{"kind":"math_inline","text":"y = 0"},{"kind":"text","text":") cards from the bottom of the deck, and the rest of the deck is his new deck (Vova has to leave at least one card in the deck after removing cards). So Vova's new deck actually contains cards "},{"kind":"math_inline","text":"x + 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x + 2"},{"kind":"text","text":", ... "},{"kind":"math_inline","text":"n - y - 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"n - y"},{"kind":"text","text":" from the original deck."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vova's new deck is considered "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" iff the product of all numbers written on the cards in his new deck is divisible by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". So Vova received a deck (possibly not a "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" one) and a number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", and now he wonders, how many ways are there to choose "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" so the deck he will get after removing "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" cards from the top and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" cards from the bottom is "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":"?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ k ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":") — the numbers written on the cards."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of ways to choose "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" so the resulting deck is "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4\n6 2 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 6\n9 1 14\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the possible values of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":" are:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"math_inline","text":"x = 0, y = 0"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"x = 1, y = 0"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"x = 2, y = 0"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"x = 0, y = 1"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"818E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/818/problem/E"}