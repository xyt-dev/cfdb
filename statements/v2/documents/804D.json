{"assets":["/statement-assets/f4b0564dbed370e4da872a1377ed39026d7b3a2a76b140a861972920004cef22.png","/statement-assets/6d35405fc6fe0fc74ce1f864b4df0e23c4be10b28d0c08713db6dbc369aab3f7.png","/statement-assets/af572790d886b5de9e6a69678560f5b9ffb802b8d91d49716b2f7199c5afce2c.png","/statement-assets/1c6a1b226aa16a8dd3caee7e95f3f51df0fe81a0498678092b22421b390182cd.png"],"contentKind":"statement","contestId":"804","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Expected diameter of a tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pasha is a good student and one of MoJaK's best friends. He always have a problem to think about. Today they had a talk about the following problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We have a forest (acyclic undirected graph) with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges. There are "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries we should answer. In each query two vertices "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" are given. Let "},{"kind":"math_inline","text":"V"},{"kind":"text","text":" be the set of vertices in the connected component of the graph that contains "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"U"},{"kind":"text","text":" be the set of vertices in the connected component of the graph that contains "},{"kind":"math_inline","text":"u"},{"kind":"text","text":". Let's add an edge between some vertex "},{"attrs":{"alt":"","src":"/statement-assets/f4b0564dbed370e4da872a1377ed39026d7b3a2a76b140a861972920004cef22.png"},"kind":"image"},{"kind":"text","text":" and some vertex in "},{"attrs":{"alt":"","src":"/statement-assets/6d35405fc6fe0fc74ce1f864b4df0e23c4be10b28d0c08713db6dbc369aab3f7.png"},"kind":"image"},{"kind":"text","text":" and compute the value "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" of the resulting component. If the resulting component is a tree, the value "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" is the "},{"children":[{"kind":"text","text":"diameter"}],"kind":"container"},{"kind":"text","text":" of the component, and it is equal to "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" otherwise. What is the expected value of "},{"kind":"math_inline","text":"d"},{"kind":"text","text":", if we choose vertices "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" from the sets uniformly at random?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Can you help Pasha to solve this problem?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"diameter"}],"kind":"container"},{"kind":"text","text":" of the component is the maximum "},{"children":[{"kind":"text","text":"distance"}],"kind":"container"},{"kind":"text","text":" among some pair of vertices in the component. The "},{"children":[{"kind":"text","text":"distance"}],"kind":"container"},{"kind":"text","text":" between two vertices is the minimum number of edges on some path between the two vertices."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that queries don't add edges to the initial forest. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":"("},{"kind":"math_inline","text":"1 ≤ n, m, q ≤ 105"},{"kind":"text","text":") — the number of vertices, the number of edges in the graph and the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":"), that means there is an edge between vertices "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given graph is a forest."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n"},{"kind":"text","text":") — the vertices given in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query print the expected value of "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" as described in the problem statement."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your answer will be considered correct if its absolute or relative error does not exceed "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":". Let's assume that your answer is "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", and the jury's answer is "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". The checker program will consider your answer correct, if "},{"attrs":{"alt":"","src":"/statement-assets/af572790d886b5de9e6a69678560f5b9ffb802b8d91d49716b2f7199c5afce2c.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1 2\n1 3\n3 1\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n2.0000000000\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 3\n2 4\n4 3\n4 2\n4 1\n2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n2.6666666667\n2.6666666667\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example the vertices "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" are in the same component, so the answer for the first query is "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". For the second query there are two options to add the edge: one option is to add the edge "},{"kind":"math_inline","text":"1 - 2"},{"kind":"text","text":", the other one is "},{"kind":"math_inline","text":"2 - 3"},{"kind":"text","text":". In both ways the resulting diameter is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", so the answer is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example the answer for the first query is obviously "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". The answer for the second query is the average of three cases: for added edges "},{"kind":"math_inline","text":"1 - 2"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"1 - 3"},{"kind":"text","text":" the diameter is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", and for added edge "},{"kind":"math_inline","text":"1 - 4"},{"kind":"text","text":" the diameter is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":". Thus, the answer is "},{"attrs":{"alt":"","src":"/statement-assets/1c6a1b226aa16a8dd3caee7e95f3f51df0fe81a0498678092b22421b390182cd.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"804D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/804/problem/D"}