{"assets":[],"contentKind":"statement","contestId":"713","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Sonya and Problem Without a Legend"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sonya was unable to think of a story for this problem, so here comes the formal description."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the array containing "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers. At one turn you can pick any element and increase or decrease it by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". The goal is the make the array strictly increasing by making the minimum possible number of operations. You are allowed to change elements in any way, they can become negative or equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 3000"},{"kind":"text","text":") — the length of the array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integer "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum number of operation required to make the array strictly increasing."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n2 1 5 11 5 9 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n5 4 3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the array is going to look as follows:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"3"},{"kind":"math_inline","text":"5"},{"kind":"math_inline","text":"6"},{"kind":"math_inline","text":"7"},{"kind":"math_inline","text":"9"},{"kind":"math_inline","text":"11"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"|2 - 2| + |1 - 3| + |5 - 5| + |11 - 6| + |5 - 7| + |9 - 9| + |11 - 11| = 9"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"And for the second sample:"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":"2"},{"kind":"math_inline","text":"3"},{"kind":"math_inline","text":"4"},{"kind":"math_inline","text":"5"}],"kind":"paragraph"},{"children":[{"kind":"math_inline","text":"|5 - 1| + |4 - 2| + |3 - 3| + |2 - 4| + |1 - 5| = 12"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"713C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/713/problem/C"}