{"assets":[],"contentKind":"statement","contestId":"243","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Cubes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One day Petya got a set of wooden cubes as a present from his mom. Petya immediately built a whole city from these cubes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The base of the city is an "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" square, divided into unit squares. The square's sides are parallel to the coordinate axes, the square's opposite corners have coordinates "},{"kind":"math_inline","text":"(0, 0)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(n, n)"},{"kind":"text","text":". On each of the unit squares Petya built a tower of wooden cubes. The side of a wooden cube also has a unit length."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After that Petya went an infinitely large distance away from his masterpiece and looked at it in the direction of vector "},{"kind":"math_inline","text":"v = (vx, vy, 0)"},{"kind":"text","text":". Petya wonders, how many distinct cubes are visible from this position. Help him, find this number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each cube includes the border. We think that a cube is visible if there is a ray emanating from some point "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", belonging to the cube, in the direction of vector "},{"kind":"math_inline","text":" - v"},{"kind":"text","text":", that doesn't contain any points, belonging to other cubes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vx"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vy"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 103"},{"kind":"text","text":", "},{"kind":"math_inline","text":"|vx|, |vy| ≤ |104|"},{"kind":"text","text":", "},{"kind":"math_inline","text":"|vx| + |vy| > 0"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers each: the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th integer in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line "},{"kind":"math_inline","text":"aij"},{"kind":"math_inline","text":"(0 ≤ aij ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ i, j ≤ n)"},{"kind":"text","text":" represents the height of the cube tower that stands on the unit square with opposite corners at points "},{"kind":"math_inline","text":"(i - 1, j - 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of visible cubes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please, do not use the "},{"children":[{"kind":"text","text":"%lld"}],"kind":"container"},{"kind":"text","text":" specifier to read or write 64-bit integers in С++. It is preferred to use the "},{"children":[{"kind":"text","text":"cin"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cout"}],"kind":"container"},{"kind":"text","text":" streams or the "},{"children":[{"kind":"text","text":"%I64d"}],"kind":"container"},{"kind":"text","text":" specifier."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 -1 2\n5 0 0 0 1\n0 0 0 0 2\n0 0 0 1 2\n0 0 0 0 2\n2 2 2 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"20"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1 -2\n5 0 0 0 1\n0 0 0 0 2\n0 0 0 1 2\n0 0 0 0 2\n2 2 2 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"15"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"243D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/243/problem/D"}