{"assets":[],"contentKind":"statement","contestId":"32","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Constellation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A star map in Berland is a checked field "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" squares. In each square there is or there is not a star. The favourite constellation of all Berland's astronomers is the constellation of the Cross. This constellation can be formed by any 5 stars so, that for some integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"radius of the constellation"}],"kind":"container"},{"kind":"text","text":") the following is true: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the 2nd is on the same vertical line as the 1st, but "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" squares up "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the 3rd is on the same vertical line as the 1st, but "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" squares down "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the 4th is on the same horizontal line as the 1st, but "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" squares left "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the 5th is on the same horizontal line as the 1st, but "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" squares right "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Such constellations can be very numerous, that's why they are numbered with integers from 1 on the following principle: when two constellations are compared, the one with a smaller radius gets a smaller index; if their radii are equal — the one, whose central star if higher than the central star of the other one; if their central stars are at the same level — the one, whose central star is to the left of the central star of the other one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the constellation with index "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" by the given Berland's star map."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 300, 1 ≤ k ≤ 3·107"},{"kind":"text","text":") — height and width of the map and index of the required constellation respectively. The upper-left corner has coordinates "},{"kind":"math_inline","text":"(1, 1)"},{"kind":"text","text":", and the lower-right — "},{"kind":"math_inline","text":"(n, m)"},{"kind":"text","text":". Then there follow "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters each — description of the map. "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th character in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line is «*», if there is a star in the corresponding square, and «.» if this square is empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If the number of the constellations is less than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", output "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":". Otherwise output 5 lines, two integers each — coordinates of the required constellation. Output the stars in the following order: central, upper, lower, left, right."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6 1\n....*.\n...***\n....*.\n..*...\n.***..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 5\n1 5\n3 5\n2 4\n2 6\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6 2\n....*.\n...***\n....*.\n..*...\n.***..\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 7 2\n...*...\n.......\n...*...\n*.***.*\n...*...\n.......\n...*...\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n1 4\n7 4\n4 1\n4 7\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"32D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/32/problem/D"}