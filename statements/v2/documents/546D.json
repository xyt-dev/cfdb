{"assets":[],"contentKind":"statement","contestId":"546","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Soldier and Number Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Two soldiers are playing a game. At the beginning first of them chooses a positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and gives it to the second soldier. Then the second one tries to make maximum possible number of rounds. Each round consists of choosing a positive integer "},{"kind":"math_inline","text":"x > 1"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is divisible by "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and replacing "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"n / x"},{"kind":"text","text":". When "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" becomes equal to "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and there is no more possible valid moves the game is over and the score of the second soldier is equal to the number of rounds he performed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To make the game more interesting, first soldier chooses "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" of form "},{"kind":"math_inline","text":"a! / b!"},{"kind":"text","text":" for some positive integer "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"a ≥ b"},{"kind":"text","text":"). Here by "},{"kind":"math_inline","text":"k!"},{"kind":"text","text":" we denote the "},{"children":[{"kind":"text","text":"factorial"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" that is defined as a product of all positive integers not large than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the maximum possible score of the second soldier?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of input consists of single integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ t ≤ 1 000 000"},{"kind":"text","text":") denoting number of games soldiers play."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines, each contains pair of integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ b ≤ a ≤ 5 000 000"},{"kind":"text","text":") defining the value of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" for a game."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each game output a maximum score that the second soldier can get."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"samp