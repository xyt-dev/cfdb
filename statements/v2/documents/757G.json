{"assets":["/statement-assets/d3d79b464f788376aa44ab62f4426d90193de1b14fcdc2acca107dba3755cffe.png","/statement-assets/f81dffea71fed96549d498b0657cd3c6a305bbf1eb6e1de6d2197b18717e153a.png","/statement-assets/b76ee35aca6401d865a01ef1b0d49a4b4bc97d7a9ee797949208980d5744e7d7.png","/statement-assets/55afa553b67dcb388703cf22239657158e57a4497a04f13c65990b68be63f419.png","/statement-assets/7bb7da16efa45595c266eff0722fcb248ee7197bc5b97ea741b1616666638fba.png","/statement-assets/bae470416b2d4c1bdcca806a615bde794e912c8e8af4a13b097d9cad45e71c81.png"],"contentKind":"statement","contestId":"757","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Can Bash Save the Day?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"768 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Whoa! You did a great job helping Team Rocket who managed to capture all the Pokemons sent by Bash. Meowth, part of Team Rocket, having already mastered the human language, now wants to become a master in programming as well. He agrees to free the Pokemons if Bash can answer his questions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially, Meowth gives Bash a weighted tree containing "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" nodes and a sequence "},{"kind":"math_inline","text":"a1, a2..., an"},{"kind":"text","text":" which is a permutation of "},{"kind":"math_inline","text":"1, 2, ..., n"},{"kind":"text","text":". Now, Mewoth makes "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" queries of one of the following forms:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"1 l r v"}],"kind":"container"},{"kind":"text","text":": meaning Bash should report "},{"attrs":{"alt":"","src":"/statement-assets/d3d79b464f788376aa44ab62f4426d90193de1b14fcdc2acca107dba3755cffe.png"},"kind":"image"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"dist(a, b)"},{"kind":"text","text":" is the length of the shortest path from node "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" to node "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" in the given tree. "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"2 x"}],"kind":"container"},{"kind":"text","text":": meaning Bash should swap "},{"kind":"math_inline","text":"ax"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ax + 1"},{"kind":"text","text":" in the given sequence. This new sequence is used for later queries. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Bash to answer the questions!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ q ≤ 2·105"},{"kind":"text","text":") — the number of nodes in the tree and the number of queries, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers — the sequence "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" which is a permutation of "},{"kind":"math_inline","text":"1, 2, ..., n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines contain three space-separated integers "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"w"},{"kind":"text","text":" denoting that there exists an undirected edge between node "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" and node "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" of weight "},{"kind":"math_inline","text":"w"},{"kind":"text","text":", ("},{"kind":"math_inline","text":"1 ≤ u, v ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"u ≠ v"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ w ≤ 106"},{"kind":"text","text":"). It is guaranteed that the given graph is a tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each query consists of two lines. First line contains single integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", indicating the type of the query. Next line contains the description of the query: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"t = 1"}],"kind":"container"},{"kind":"text","text":": Second line contains three integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b, c < 230"},{"kind":"text","text":") using which "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" can be generated using the formula given below: "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f81dffea71fed96549d498b0657cd3c6a305bbf1eb6e1de6d2197b18717e153a.png"},"kind":"image"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b76ee35aca6401d865a01ef1b0d49a4b4bc97d7a9ee797949208980d5744e7d7.png"},"kind":"image"},{"kind":"text","text":", "}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/55afa553b67dcb388703cf22239657158e57a4497a04f13c65990b68be63f419.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"t = 2"}],"kind":"container"},{"kind":"text","text":": Second line contains single integer "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a < 230"},{"kind":"text","text":") using which "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" can be generated using the formula given below: "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/7bb7da16efa45595c266eff0722fcb248ee7197bc5b97ea741b1616666638fba.png"},"kind":"image"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"ansi"},{"kind":"text","text":" is the answer for the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query, assume that "},{"kind":"math_inline","text":"ans0 = 0"},{"kind":"text","text":". If the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query is of type 2 then "},{"kind":"math_inline","text":"ansi"},{"kind":"text","text":" = "},{"kind":"math_inline","text":"ansi - 1"},{"kind":"text","text":". It is guaranteed that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"for each query of type 1"}],"kind":"container"},{"kind":"text","text":": "},{"kind":"math_inlin