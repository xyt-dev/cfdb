{"assets":["/statement-assets/a5f126b07f6bd38dc5fb94a59f4ba66b8095ec6b09ef2aa4fec486e615ea01a9.png"],"contentKind":"statement","contestId":"297","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Splitting the Uniqueness"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polar bears like "},{"children":[{"kind":"text","text":"unique arrays"}],"kind":"container"},{"kind":"text","text":" — that is, arrays without repeated elements."}],"kind":"paragraph"},{"children":[{"kind":"text","text":" You have got a unique array "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" with length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" containing non-negative integers. Since you are good friends with Alice and Bob, you decide to split the array in two. Precisely, you need to construct two arrays "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" that are also of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", with the following conditions for all "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ n)"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"ai, bi"},{"kind":"text","text":" are non-negative integers; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"si = ai + bi"},{"kind":"text","text":" . "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Ideally, "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" should also be unique arrays. However, life in the Arctic is hard and this is not always possible. Fortunately, Alice and Bob are still happy if their arrays are "},{"children":[{"kind":"text","text":"almost unique"}],"kind":"container"},{"kind":"text","text":". We define an array of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" to be almost unique, if and only if it can be turned into a unique array by removing no more than "},{"attrs":{"alt":"","src":"/statement-assets/a5f126b07f6bd38dc5fb94a59f4ba66b8095ec6b09ef2aa4fec486e615ea01a9.png"},"kind":"image"},{"kind":"text","text":" entries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the array "},{"kind":"math_inline","text":"[1, 2, 1, 3, 2]"},{"kind":"text","text":" is almost unique because after removing the first two entries, it becomes "},{"kind":"math_inline","text":"[1, 3, 2]"},{"kind":"text","text":". The array "},{"kind":"math_inline","text":"[1, 2, 1, 3, 1, 2]"},{"kind":"text","text":" is not almost unique because we need to remove at least "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" entries to turn it into a unique array."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, your task is to split the given unique array "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" into two almost unique arrays "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(1 ≤ n ≤ 105)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"s1, s2, ... sn"},{"kind":"math_inline","text":"(0 ≤ si ≤ 109)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is possible to make Alice and Bob happy (if you can split the given array), print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in the first line. In the second line, print the array "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". In the third line, print the array "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". There may be more than one solution. Any of them will be accepted."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If it is impossible to split "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" into almost unique arrays "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) in the first line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n12 5 8 3 11 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n6 2 6 0 2 4\n6 3 2 3 9 5"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the sample, we can remove the first two entries from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and the second entry from "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" to make them both unique."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"297C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/297/problem/C"}