{"assets":[],"contentKind":"statement","contestId":"669","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Little Artem and Presents"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Artem got "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" stones on his birthday and now wants to give some of them to Masha. He knows that Masha cares more about the fact of receiving the present, rather than the value of that present, so he wants to give her stones as many times as possible. However, Masha remembers the last present she received, so Artem can't give her the same number of stones twice in a row. For example, he can give her "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" stones, then "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" stone, then again "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" stones, but he can't give her "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" stones and then again "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" stones right after that."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"How many times can Artem give presents to Masha?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains a single integer "},{"kind":"math_inline","text":"n"},