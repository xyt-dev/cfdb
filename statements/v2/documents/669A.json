ind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Artem can only give "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" stone to Masha."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, Atrem can give Masha "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" stones, though he can't give her "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" stone two times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, Atrem can first give Masha "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" stones, a then "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" more stone."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth sample, Atrem can first give Masha "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" stone, then "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" stones, and finally "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" stone again."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"669A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/669/problem/A"}