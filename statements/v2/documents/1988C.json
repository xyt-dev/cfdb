{"assets":[],"contentKind":"statement","contestId":"1988","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Increasing Sequence with Fixed OR"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a positive integer $$$n$$$. Find the "},{"children":[{"kind":"text","text":"longest"}],"kind":"container"},{"kind":"text","text":" sequence of positive integers $$$a=[a_1,a_2,\\ldots,a_k]$$$ that satisfies the following conditions, and print the sequence:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$a_i\\le n$$$ for all $$$1\\le i\\le k$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a$$$ is strictly increasing. That is, $$$a_i \\gt a_{i-1}$$$ for all $$$2\\le i\\le k$$$. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$a_i\\,|\\,a_{i-1}=n$$$ for all $$$2\\le i\\le k$$$, where $$$|$$$ denotes the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#OR"},"children":[{"kind":"text","text":"bitwise OR operation"}],"kind":"link"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 1000$$$). Description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains one integer $$$n$$$ ($$$1\\le n\\le 10^{18}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the sum of lengths of the longest valid sequences does not exceed $$$5\\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase, print two lines. In the first line, print the length of your constructed sequence, $$$k$$$. In the second line, print $$$k$$$ positive integers, denoting the sequence. If there are multiple longest sequences, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1\n3\n14\n23\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n1\n3\n1 2 3\n4\n4 10 12 14\n5\n7 18 21 22 23"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1988C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1988/problem/C"}