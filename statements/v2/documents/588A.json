{"assets":["/statement-assets/556ce214564315373f03cace27896bd2e9aab3357751479aac472f1e857897f8.png"],"contentKind":"statement","contestId":"588","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Duff and Meat"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Duff is addicted to meat! Malek wants to keep her happy for "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days. In order to be happy in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day, she needs to eat exactly "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" kilograms of meat."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/556ce214564315373f03cace27896bd2e9aab3357751479aac472f1e857897f8.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"There is a big shop uptown and Malek wants to buy meat for her from there. In "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day, they sell meat for "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" dollars per kilogram. Malek knows all numbers "},{"kind":"math_inline","text":"a1, ..., an"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p1, ..., pn"},{"kind":"text","text":". In each day, he can buy arbitrary amount of meat, also he can keep some meat he has for the future."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Malek is a little tired from cooking meat, so he asked for your help. Help him to minimize the total money he spends to keep Duff happy for "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":"), the number of days."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, pi ≤ 100"},{"kind":"text","text":"), the amount of meat Duff needs and the cost of meat in that day."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum money needed to keep Duff happy for "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days, in one line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 3\n2 2\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 3\n2 1\n3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample case: An optimal way would be to buy 1 kg on the first day, 2 kg on the second day and 3 kg on the third day."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample case: An optimal way would be to buy 1 kg on the first day and 5 kg (needed meat for the second and third day) on the second day."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"588A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/588/problem/A"}