{"assets":[],"contentKind":"statement","contestId":"378","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Semifinals"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Two semifinals have just been in the running tournament. Each semifinal had "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" participants. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" participants advancing to the finals, they are chosen as follows: from each semifinal, we choose "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" people ("},{"kind":"math_inline","text":"0 ≤ 2k ≤ n"},{"kind":"text","text":") who showed the best result in their semifinals and all other places in the finals go to the people who haven't ranked in the top "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" in their semifinal but got to the "},{"kind":"math_inline","text":"n - 2k"},{"kind":"text","text":" of the best among the others."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The tournament organizers hasn't yet determined the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" value, so the participants want to know who else has any chance to get to the finals and who can go home."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of participants in each semifinal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai, bi ≤ 109"},{"kind":"text","text":") — the results of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th participant (the number of milliseconds he needs to cover the semifinals distance) of the first and second semifinals, correspondingly. All results are distinct. Sequences "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"an"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"bn"},{"kind":"text","text":" are sorted in ascending order, i.e. in the order the participants finished in the corresponding semifinal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two strings consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters, each equals either \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\". The first line should correspond to the participants of the first semifinal, the second line should correspond to the participants of the second semifinal. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character in the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th line should equal \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" if the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th participant of the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th semifinal has any chances to advance to the finals, otherwise it should equal a \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n9840 9920\n9860 9980\n9930 10020\n10040 10090\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1110\n1100\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n9900 9850\n9940 9930\n10000 10020\n10060 10110\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1100\n1100\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Consider the first sample. Each semifinal has 4 participants. The results of the first semifinal are 9840, 9860, 9930, 10040. The results of the second semifinal are 9920, 9980, 10020, 10090."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"k = 0"},{"kind":"text","text":", the finalists are determined by the time only, so players 9840, 9860, 9920 and 9930 advance to the finals. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":", the winners from both semifinals move to the finals (with results 9840 and 9920), and the other places are determined by the time (these places go to the sportsmen who run the distance in 9860 and 9930 milliseconds). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":", then first and second places advance from each seminfial, these are participants with results 9840, 9860, 9920 and 9980 milliseconds. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"378B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/378/problem/B"}