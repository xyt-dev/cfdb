{"assets":[],"contentKind":"statement","contestId":"404","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Valera and X"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Valera is a little boy. Yesterday he got a huge Math hometask at school, so Valera didn't have enough time to properly learn the English alphabet for his English lesson. Unfortunately, the English teacher decided to have a test on alphabet today. At the test Valera got a square piece of squared paper. The length of the side equals "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" squares ("},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is an odd number) and each unit square contains some small letter of the English alphabet."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valera needs to know if the letters written on the square piece of paper form letter \""},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"\". Valera's teacher thinks that the letters on the piece of paper form an \""},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"\", if:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" on both diagonals of the square paper all letters are the same; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" all other squares of the paper (they are not on the diagonals) contain the same letter that is different from the letters on the diagonals. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Valera, write the program that completes the described task for him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n < 300"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is odd). Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" small English letters — the description of Valera's paper."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print string \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\", if the letters on the paper form letter \""},{"children":[{"kind":"text","text":"X"}],"kind":"container"},{"kind":"text","text":"\". Otherwise, print string \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\". Print the strings without quotes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\nxooox\noxoxo\nsoxoo\noxoxo\nxooox\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nwsw\nsws\nwsw\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nxpx\npxp\nxpe\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"404A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/404/problem/A"}