{"assets":["/statement-assets/af572790d886b5de9e6a69678560f5b9ffb802b8d91d49716b2f7199c5afce2c.png"],"contentKind":"statement","contestId":"706","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Beru-taxi"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasiliy lives at point "},{"kind":"math_inline","text":"(a, b)"},{"kind":"text","text":" of the coordinate plane. He is hurrying up to work so he wants to get out of his house as soon as possible. New app suggested "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" available Beru-taxi nearby. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th taxi is located at point "},{"kind":"math_inline","text":"(xi, yi)"},{"kind":"text","text":" and moves with a speed "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Consider that each of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" drivers will move directly to Vasiliy and with a maximum possible speed. Compute the minimum time when Vasiliy will get in any of Beru-taxi cars."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text"