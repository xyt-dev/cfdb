{"assets":[],"contentKind":"statement","contestId":"271","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Prime Matrix"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got an "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" matrix. The matrix consists of integers. In one move, you can apply a single transformation to the matrix: choose an arbitrary element of the matrix and increase it by "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". Each element can be increased an arbitrary number of times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are really curious about prime numbers. Let us remind you that a "},{"children":[{"kind":"text","text":"prime number"}],"kind":"container"},{"kind":"text","text":" is a positive integer that has exactly two distinct positive integer divisors: itself and number one. For example, numbers 2, 3, 5 are prime and numbers 1, 4, 6 are not. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A matrix is "},{"children":[{"kind":"text","text":"prime"}],"kind":"container"},{"kind":"text","text":" if at least one of the two following conditions fulfills:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the matrix has a row with prime numbers only; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the matrix has a column with prime numbers only; "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is to count the minimum number of moves needed to get a prime matrix from the one you've got."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n, m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 500)"},{"kind":"text","text":" — the number of rows and columns in the matrix, correspondingly."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the following "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers — the initial matrix. All matrix elements are positive integers. All numbers in the initial matrix do not exceed "},{"kind":"math_inline","text":"105"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The numbers in the lines are separated by single spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum number of moves needed to get a prime matrix from the one you've got. If you've got a prime matrix, print 0."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2 3\n5 6 1\n4 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n4 8 8\n9 2 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n1 3\n4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample you need to increase number 1 in cell (1, 1). Thus, the first row will consist of prime numbers: 2, 2, 3."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample you need to increase number 8 in cell (1, 2) three times. Thus, the second column will consist of prime numbers: 11, 2."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample you don't have to do anything as the second column already consists of prime numbers: 3, 2. "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"271B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/271/problem/B"}