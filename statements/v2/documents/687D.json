{"assets":["/statement-assets/627729e5b18c58efd1a1a95b48f1c7b0fb85dcf2716a98d5939734e50ac90b08.png"],"contentKind":"statement","contestId":"687","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Dividing Kingdom II"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"6 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Long time ago, there was a great kingdom and it was being ruled by The Great Arya and Pari The Great. These two had some problems about the numbers they like, so they decided to divide the great kingdom between themselves."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The great kingdom consisted of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" bidirectional roads between these cities, numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road had length equal to "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":". The Great Arya and Pari The Great were discussing about destructing some prefix (all road with numbers less than some "},{"kind":"math_inline","text":"x"},{"kind":"text","text":") and suffix (all roads with numbers greater than some "},{"kind":"math_inline","text":"x"},{"kind":"text","text":") of the roads so there will remain only the roads with numbers "},{"kind":"math_inline","text":"l, l + 1, ..., r - 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After that they will divide the great kingdom into two pieces (with each city belonging to exactly one piece) such that the "},{"children":[{"kind":"text","text":"hardness"}],"kind":"container"},{"kind":"text","text":" of the division is "},{"children":[{"kind":"text","text":"minimized"}],"kind":"container"},{"kind":"text","text":". The hardness of a division is the "},{"children":[{"kind":"text","text":"maximum length"}],"kind":"container"},{"kind":"text","text":" of a road such that its both endpoints are in the same piece of the kingdom. In case there is no such road, the hardness of the division is considered to be equal to "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Historians found the map of the great kingdom, and they have "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" guesses about the "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" chosen by those great rulers. Given these data, for each guess "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" print the minimum possible hardness of the division of the kingdom."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, q ≤ 1000"},{"kind":"text","text":", "},{"attrs":{"alt":"","src":"/statement-assets/627729e5b18c58efd1a1a95b48f1c7b0fb85dcf2716a98d5939734e50ac90b08.png"},"kind":"image"},{"kind":"text","text":") — the number of cities and roads in the great kingdom, and the number of guesses, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line of the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains three integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":", "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤  ui,  vi  ≤  n, 0 ≤ wi ≤ 109"},{"kind":"text","text":"), denoting the road number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" connects cities "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and its length is equal "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":". It's guaranteed that no road connects the city to itself and no pair of cities is connected by more than one road."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contains a pair of integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤ li ≤ ri ≤ m"},{"kind":"text","text":") — a guess from the historians about the remaining roads in the kingdom."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each guess print the minimum possible hardness of the division in described scenario."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6 5\n5 4 86\n5 1 0\n1 3 38\n2 1 33\n2 4 28\n2 3 40\n3 5\n2 6\n1 3\n2 3\n1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n33\n-1\n-1\n33\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"687D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/687/problem/D"}