{"assets":["/statement-assets/f1c9f9fc3059687e626a483548dddc9436c7320e5ac5fd0ab06c04cc0f2ab1d1.png"],"contentKind":"statement","contestId":"895","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Pizza Separation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Students Vasya and Petya are studying at the BSU (Byteland State University). At one of the breaks they decided to order a pizza. In this problem pizza is a circle of some radius. The pizza was delivered already cut into "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pieces. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th piece is a sector of angle equal to "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":". Vasya and Petya want to divide all pieces of pizza into two "},{"children":[{"kind":"text","text":"continuous"}],"kind":"container"},{"kind":"text","text":" sectors in such way that the difference between angles of these sectors is minimal. Sector angle is sum of angles of all pieces in it. Pay attention, that one of sectors can be empty."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 360"},{"kind":"text","text":")  — the number of pieces into which the delivered pizza was cut."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 360"},{"kind":"text","text":")  — the angles of the sectors into which the pizza was cut. The sum of all "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is 360."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer  — the minimal difference between angles of sectors that will go to Vasya and Petya."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n90 90 90 90\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n100 100 160\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"40\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\n360\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"360\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n170 30 150 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In first sample Vasya can take "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" pieces, Petya can take "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" pieces. Then the answer is "},{"kind":"math_inline","text":"|(90 + 90) - (90 + 90)| = 0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In third sample there is only one piece of pizza that can be taken by only one from Vasya and Petya. So the answer is "},{"kind":"math_inline","text":"|360 - 0| = 360"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In fourth sample Vasya can take "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" pieces, then Petya will take "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" pieces. So the answer is "},{"kind":"math_inline","text":"|(170 + 10) - (30 + 150)| = 0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Picture explaning fourth sample:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/f1c9f9fc3059687e626a483548dddc9436c7320e5ac5fd0ab06c04cc0f2ab1d1.png"},"kind":"image"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Both red and green sectors consist of two adjacent pieces of pizza. So Vasya can take green sector, then Petya will take red sector."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"895A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/895/problem/A"}