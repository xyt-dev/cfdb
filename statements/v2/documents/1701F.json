{"assets":[],"contentKind":"statement","contestId":"1701","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Points"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"6.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A triple of points $$$i$$$, $$$j$$$ and $$$k$$$ on a coordinate line is called "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if $$$i \\lt j \\lt k$$$ and $$$k - i \\le d$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a set of points on a coordinate line, initially empty. You have to process queries of three types:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" add a point; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" remove a point; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" calculate the number of beautiful triples consisting of points belonging to the set. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$q$$$ and $$$d$$$ ($$$1 \\le q, d \\le 2 \\cdot 10^5$$$) — the number of queries and the parameter for defining if a triple is beautiful, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$q$$$ integers $$$a_1, a_2, \\dots, a_q$$$ ($$$1 \\le a_i \\le 2 \\cdot 10^5$$$) denoting the queries. The integer $$$a_i$$$ denotes the $$$i$$$-th query in the following way:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if the point $$$a_i$$$ belongs to the set, remove it; otherwise, add it; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" after adding or removing the point, print the number of beautiful triples. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query, print one integer — the number of beautiful triples after processing the respective query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7 5\n8 5 3 2 1 5 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n0\n1\n2\n5\n1\n5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1701F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1701/problem/F"}