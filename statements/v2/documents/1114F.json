{"assets":[],"contentKind":"statement","contestId":"1114","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Please, another Queries on Array?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"5.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array $$$a_1, a_2, \\ldots, a_n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You need to perform $$$q$$$ queries of the following two types:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"MULTIPLY l r x"}],"kind":"container"},{"kind":"text","text":"\" — for every $$$i$$$ ($$$l \\le i \\le r$$$) multiply $$$a_i$$$ by $$$x$$$."}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"TOTIENT l r"}],"kind":"container"},{"kind":"text","text":"\" — print $$$\\varphi(\\prod \\limits_{i=l}^{r} a_i)$$$ taken modulo $$$10^9+7$$$, where $$$\\varphi$$$ denotes Euler's totient function. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The "},{"attrs":{"href":"http://gg.gg/euler_totient"},"children":[{"kind":"text","text":"Euler's totient function"}],"kind":"link"},{"kind":"text","text":" of a positive integer $$$n$$$ (denoted as $$$\\varphi(n)$$$) is the number of integers $$$x$$$ ($$$1 \\le x \\le n$$$) such that $$$\\gcd(n,x) = 1$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$q$$$ ($$$1 \\le n \\le 4 \\cdot 10^5$$$, $$$1 \\le q \\le 2 \\cdot 10^5$$$) — the number of elements in array $$$a$$$ and the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\ldots, a_n$$$ ($$$1 \\le a_i \\le 300$$$) — the elements of array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then $$$q$$$ lines follow, describing queries in the format given in the statement."}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"MULTIPLY l r x"}],"kind":"container"},{"kind":"text","text":"\" ($$$1 \\le l \\le r \\le n$$$, $$$1 \\le x \\le 300$$$) — denotes a multiplication query."}],"kind":"list_item"},{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"TOTIENT l r"}],"kind":"container"},{"kind":"text","text":"\" ($$$1 \\le l \\le r \\le n$$$) — denotes a query on the value of Euler's totient function. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"It is guaranteed that there is at least one \""},{"children":[{"kind":"text","text":"TOTIENT"}],"kind":"container"},{"kind":"text","text":"\" query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each \""},{"children":[{"kind":"text","text":"TOTIENT"}],"kind":"container"},{"kind":"text","text":"\" query, print the answer to it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n5 9 1 2\nTOTIENT 3 3\nTOTIENT 3 4\nMULTIPLY 4 4 3\nTOTIENT 4 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, $$$\\varphi(1) = 1$$$ for the first query, $$$\\varphi(2) = 1$$$ for the second query and $$$\\varphi(6) = 2$$$ for the third one."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1114F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1114/problem/F"}