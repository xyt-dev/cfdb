{"assets":[],"contentKind":"statement","contestId":"1750","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Maximum Substring"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A binary string is a string consisting only of the characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":". You are given a binary string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For some non-empty substring$$$^\\dagger$$$ $$$t$$$ of string $$$s$$$ containing $$$x$$$ characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":" and $$$y$$$ characters "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":", define its "},{"children":[{"kind":"text","text":"cost"}],"kind":"container"},{"kind":"text","text":" as:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$x \\cdot y$$$, if $$$x \\gt 0$$$ and $$$y \\gt 0$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$x^2$$$, if $$$x \\gt 0$$$ and $$$y = 0$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$y^2$$$, if $$$x = 0$$$ and $$$y \\gt 0$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Given a binary string $$$s$$$ of length $$$n$$$, find the maximum cost across all its non-empty substrings."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$^\\dagger$$$ A string $$$a$$$ is a substring of a string $$$b$$$ if $$$a$$$ can be obtained from $$$b$$$ by deletion of several (possibly, zero or all) characters from the beginning and several (possibly, zero or all) characters from the end."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test consists of multiple test cases. The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 10^5$$$) — the number of test cases. The description of test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains a single integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the length of the string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains a binary string $$$s$$$ of length $$$n$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single integer — the maximum cost across all substrings."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n5\n11100\n7\n1100110\n6\n011110\n7\n1001010\n4\n1000\n1\n0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n9\n12\n16\n12\n9\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, we can take a substring $$$111$$$. It contains $$$3$$$ characters "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" and $$$0$$$ characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":". So $$$a = 3$$$, $$$b = 0$$$ and its cost is $$$3^2 = 9$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, we can take the whole string. It contains $$$4$$$ characters "},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":" and $$$3$$$ characters "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":". So $$$a = 4$$$, $$$b = 3$$$ and its cost is $$$4 \\cdot 3 = 12$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, we can can take a substring $$$1111$$$ and its cost is $$$4^2 = 16$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, we can take the whole string and cost is $$$4 \\cdot 3 = 12$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fifth test case, we can take a substring $$$000$$$ and its cost is $$$3 \\cdot 3 = 9$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the sixth test case, we can only take the substring $$$0$$$ and its cost is $$$1 \\cdot 1 = 1$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1750B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1750/problem/B"}