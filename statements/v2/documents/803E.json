{"assets":[],"contentKind":"statement","contestId":"803","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Roma and Poker"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Each evening Roma plays online poker on his favourite website. The rules of poker on this website are a bit strange: there are always two players in a hand, there are no bets, and the winner takes "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" virtual bourle from the loser."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Last evening Roma started to play poker. He decided to spend no more than "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" virtual bourles — he will stop immediately if the number of his loses exceeds the number of his wins by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Also Roma will leave the game if he wins enough money for the evening, i.e. if the number of wins exceeds the number of loses by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next morning Roma found a piece of paper with a sequence on it representing his results. Roma doesn't remember the results exactly, and some characters in the sequence are written in a way such that it's impossible to recognize this character, so Roma can't recall whether he won "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" bourles or he lost."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sequence written by Roma is a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of characters "},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":" (Roma won the corresponding hand), "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":" (Roma lost), "},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":" (draw) and "},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":" (unknown result). Roma wants to restore any "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" sequence by changing all "},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":" characters to "},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":". The sequence is called "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" if all these conditions are met: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" In the end the absolute difference between the number of wins and loses is equal to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There is no hand such that the absolute difference before this hand was equal to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Roma to restore any such sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two numbers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" (the length of Roma's sequence) and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, k ≤ 1000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the sequence "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consisting of characters "},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":". There are exactly "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters in this sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no "},{"children":[{"kind":"text","text":"valid"}],"kind":"container"},{"kind":"text","text":" sequence that can be obtained from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" by replacing all "},{"children":[{"kind":"text","text":"?"}],"kind":"container"},{"kind":"text","text":" characters by "},{"children":[{"kind":"text","text":"W"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":", print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise print this sequence. If there are multiple answers, print any of them."}],"kind":"paragraph"