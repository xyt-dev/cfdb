{"assets":["/statement-assets/e30e4d351304eaa88f5cee0679e1481ba7e4f5e0304a8ac50ff6dab3a58bce01.png"],"contentKind":"statement","contestId":"475","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Bayan Bus"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The final round of Bayan Programming Contest will be held in Tehran, and the participants will be carried around with a yellow bus. The bus has 34 passenger seats: 4 seats in the last row and 3 seats in remaining rows. "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e30e4d351304eaa88f5cee0679e1481ba7e4f5e0304a8ac50ff6dab3a58bce01.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"The event coordinator has a list of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" participants who should be picked up at the airport. When a participant gets on the bus, he will sit in the last row with an empty seat. If there is more than one empty seat in that row, he will take the leftmost one. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In order to keep track of the people who are on the bus, the event coordinator needs a figure showing which seats are going to be taken by "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" participants. Your task is to draw the figure representing occupied seats."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of input contains integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(0 ≤ k ≤ 34)"},{"kind":"text","text":", denoting the number of participants."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the figure of a bus with "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" passengers as described in sample tests. Character '"},{"children":[{"kind":"text","text":"#"}],"kind":"container"},{"kind":"text","text":"' denotes an empty seat, while '"},{"children":[{"kind":"text","text":"O"}],"kind":"container"},{"kind":"text","text":"' denotes a taken seat. '"},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"' is the bus driver and other characters in the output are for the purpose of beautifying the figure. Strictly follow the sample test cases output format. Print exactly six lines. Do not output extra space or other characters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"+------------------------+\n|O.O.O.#.#.#.#.#.#.#.#.|D|)\n|O.O.O.#.#.#.#.#.#.#.#.|.|\n|O.......................|\n|O.O.#.#.#.#.#.#.#.#.#.|.|)\n+------------------------+\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"20\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"+------------------------+\n|O.O.O.O.O.O.O.#.#.#.#.|D|)\n|O.O.O.O.O.O.#.#.#.#.#.|.|\n|O.......................|\n|O.O.O.O.O.O.#.#.#.#.#.|.|)\n+------------------------+\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"475A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/475/problem/A"}