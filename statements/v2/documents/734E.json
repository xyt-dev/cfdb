{"assets":["/statement-assets/301b3d031b8c68efd740d53b860a279d5dbb8408aed506933427a761dc5e0d96.png","/statement-assets/df65ee9bc15a64801a198fa07a035ea474af83ea95586452f524c764e4648b25.png"],"contentKind":"statement","contestId":"734","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Anton and Tree"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Anton is growing a tree in his garden. In case you forgot, the tree is a connected acyclic undirected graph."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices in the tree, each of them is painted black or white. Anton doesn't like multicolored trees, so he wants to change the tree such that all vertices have the same color (black or white)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To change the colors Anton can use only operations of one type. We denote it as "},{"kind":"math_inline","text":"paint(v)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" is some vertex of the tree. This operation changes the color of all vertices "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" such that all vertices on the shortest path from "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" have the same color (including "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":"). For example, consider the tree"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/301b3d031b8c68efd740d53b860a279d5dbb8408aed506933427a761dc5e0d96.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"and apply operation "},{"kind":"math_inline","text":"paint(3)"},{"kind":"text","text":" to get the following:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/df65ee9bc15a64801a198fa07a035ea474af83ea95586452f524c764e4648b25.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Anton is interested in the minimum number of operation he needs to perform in order to make the colors of all vertices equal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000"},{"kind":"text","text":") — the number of vertices in the tree."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"colori"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ colori ≤ 1"},{"kind":"text","text":") — colors of the vertices. "},{"kind":"math_inline","text":"colori = 0"},{"kind":"text","text":" means that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex is initially painted white, while "},{"kind":"math_inline","text":"colori = 1"},{"kind":"text","text":" means it's initially painted black."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then follow "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" line, each of them contains a pair of integers "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ui, vi ≤ n, ui ≠ vi"},{"kind":"text","text":") — indices of vertices connected by the corresponding edge. It's guaranteed that all pairs "},{"kind":"math_inline","text":"(ui, vi)"},{"kind":"text","text":" are distinct, i.e. there are no multiple edges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the minimum number of operations Anton has to apply in order to make all vertices of the tree black or all vertices of the tree white."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"11\n0 0 0 1 1 0 1 0 0 1 1\n1 2\n1 3\n2 4\n2 5\n5 6\n5 7\n3 8\n3 9\n3 10\n9 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n0 0 0 0\n1 2\n2 3\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the tree is the same as on the picture. If we first apply operation "},{"kind":"math_inline","text":"paint(3)"},{"kind":"text","text":" and then apply "},{"kind":"math_inline","text":"paint(6)"},{"kind":"text","text":", the tree will become completely black, so the answer is "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the tree is already white, so there is no need to apply any operations and the answer is "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"734E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/734/problem/E"}