{"assets":["/statement-assets/856fec9864e5e25705f22f4c2f5479bab326ac67878f5734f1b599844c8b3015.png","/statement-assets/11b8de5ddd25d9b95a3f41e274604c849545a17d82c19a5e08d33317daae5f27.png","/statement-assets/7dfdfb717a54bc85b81044a147f16c872f1ac25dcc481fb83bf6417ed376f088.png"],"contentKind":"statement","contestId":"520","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. DNA Alignment"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya became interested in bioinformatics. He's going to write an article about similar cyclic DNA sequences, so he invented a new method for determining the similarity of cyclic sequences."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's assume that strings "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" have the same length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", then the function "},{"kind":"math_inline","text":"h(s, t)"},{"kind":"text","text":" is defined as the number of positions in which the respective symbols of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" are "},{"children":[{"kind":"text","text":"the same"}],"kind":"container"},{"kind":"text","text":". Function "},{"kind":"math_inline","text":"h(s, t)"},{"kind":"text","text":" can be used to define the function of Vasya distance "},{"kind":"math_inline","text":"ρ(s, t)"},{"kind":"text","text":": "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/856fec9864e5e25705f22f4c2f5479bab326ac67878f5734f1b599844c8b3015.png"},"kind":"image"}],"kind":"container"},{"kind":"text","text":" where "},{"attrs":{"alt":"","src":"/statement-assets/11b8de5ddd25d9b95a3f41e274604c849545a17d82c19a5e08d33317daae5f27.png"},"kind":"image"},{"kind":"text","text":" is obtained from string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":", by applying left circular shift "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" times. For example, "},{"children":[{"kind":"math_inline","text":"ρ(\"AGC\", \"CGT\") = "}],"kind":"container"},{"children":[{"kind":"math_inline","text":"h(\"AGC\", \"CGT\") + h(\"AGC\", \"GTC\") + h(\"AGC\", \"TCG\") + "}],"kind":"container"},{"children":[{"kind":"math_inline","text":"h(\"GCA\", \"CGT\") + h(\"GCA\", \"GTC\") + h(\"GCA\", \"TCG\") + "}],"kind":"container"},{"children":[{"kind":"math_inline","text":"h(\"CAG\", \"CGT\") + h(\"CAG\", \"GTC\") + h(\"CAG\", \"TCG\") = "}],"kind":"container"},{"children":[{"kind":"math_inline","text":"1 + 1 + 0 + 0 + 1 + 1 + 1 + 0 + 1 = 6"}],"kind":"container"},{"children":[{"kind":"text","text":"Vasya found a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" on the Internet. Now he wants to count how many strings "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" there are such that the Vasya distance from the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" attains maximum possible value. Formally speaking, "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" must satisfy the equation: "},{"attrs":{"alt":"","src":"/statement-assets/7dfdfb717a54bc85b81044a147f16c872f1ac25dcc481fb83bf6417ed376f088.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya could not try all possible strings to find an answer, so he needs your help. As the answer may be very large, count the number of such strings modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains a single string of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", consisting of characters "},{"children":[{"kind":"text","text":"\"ACGT\""}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single number — the answer modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1\nC\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\nAG\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\nTTT\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Please note that if for two distinct strings "},{"kind":"math_inline","text":"t1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"t2"},{"kind":"text","text":" values "},{"kind":"math_inline","text":"ρ(s, t1)"},{"kind":"text","text":" и "},{"kind":"math_inline","text":"ρ(s, t2)"},{"kind":"text","text":" are maximum among all possible "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", then both strings must be taken into account in the answer even if one of them can be obtained by a circular shift of another one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample, there is "},{"kind":"math_inline","text":"ρ(\"C\", \"C\") = 1"},{"kind":"text","text":", for the remaining strings "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" of length 1 the value of "},{"kind":"math_inline","text":"ρ(s, t)"},{"kind":"text","text":" is 0."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, "},{"kind":"math_inline","text":"ρ(\"AG\", \"AG\") = ρ(\"AG\", \"GA\") = ρ(\"AG\", \"AA\") = ρ(\"AG\", \"GG\") = 4"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, "},{"kind":"math_inline","text":"ρ(\"TTT\", \"TTT\") = 27"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"520C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/520/problem/C"}