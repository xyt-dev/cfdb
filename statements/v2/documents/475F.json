{"assets":["/statement-assets/7caf5efe5cfed3bed33cd894fe1b29fd6c9cd42931649d310b9458ef948e600a.png"],"contentKind":"statement","contestId":"475","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Meta-universe"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider infinite grid of unit cells. Some of those cells are "},{"children":[{"kind":"text","text":"planets"}],"kind":"container"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Meta-universe"}],"kind":"container"},{"kind":"math_inline","text":"M = {p1, p2, ..., pk}"},{"kind":"text","text":" is a set of planets. Suppose there is an infinite row or column with following two properties: 1) it doesn't contain any planet "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" of meta-universe "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" on it; 2) there are planets of "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" located on both sides from this row or column. In this case we can turn the meta-universe "},{"kind":"math_inline","text":"M"},{"kind":"text","text":" into two non-empty meta-universes "},{"kind":"math_inline","text":"M1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"M2"},{"kind":"text","text":" containing planets that are located on respective sides of this row or column. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A meta-universe which can't be split using operation above is called a "},{"children":[{"kind":"text","text":"universe"}],"kind":"container"},{"kind":"text","text":". We perform such operations until all meta-universes turn to universes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given positions of the planets in the original meta-universe, find the number of universes that are result of described process. It can be proved that each universe is uniquely identified not depending from order of splitting."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":"), denoting the number of planets in the meta-universe."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each contain integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":", ("},{"kind":"math_inline","text":" - 109 ≤ xi, yi ≤ 109"},{"kind":"text","text":"), denoting the coordinates of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th planet. All planets are located in different cells."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of resulting universes."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 0\n0 2\n2 0\n2 1\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n0 0\n1 0\n0 2\n0 3\n3 0\n3 1\n2 3\n3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The following figure describes the first test case:"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/7caf5efe5cfed3bed33cd894fe1b29fd6c9cd42931649d310b9458ef948e600a.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"475F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/475/problem/F"}