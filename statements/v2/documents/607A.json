{"assets":[],"contentKind":"statement","contestId":"607","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Chain Reaction"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" beacons located at distinct positions on a number line. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th beacon has position "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and power level "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". When the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th beacon is activated, it destroys all beacons to its left (direction of decreasing coordinates) within distance "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" inclusive. The beacon itself is not destroyed however. Saitama will activate the beacons one at a time from right to left. If a beacon is destroyed, it cannot be activated."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Saitama wants Genos to add a beacon "},{"children":[{"kind":"text","text":"strictly to the right"}],"kind":"container"},{"kind":"text","text":" of all the existing beacons, with any position and any power level, such that the least possible number of beacons are destroyed. Note that Genos's placement of the beacon means it will be the first beacon activated. Help Genos by finding the minimum number of beacons that could be destroyed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100 000"},{"kind":"text","text":") — the initial number of beacons."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ 1 000 000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ bi ≤ 1 000 000"},{"kind":"text","text":") — the position and power level of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th beacon respectively. No two beacons will have the same position, so "},{"kind":"math_inline","text":"ai ≠ aj"},{"kind":"text","text":" if "},{"kind":"math_inline","text":"i ≠ j"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the minimum number of beacons that could be destroyed if exactly one beacon is added."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 9\n3 1\n6 1\n7 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\n1 1\n2 1\n3 1\n4 1\n5 1\n6 1\n7 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample case, the minimum number of beacons destroyed is "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". One way to achieve this is to place a beacon at position "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" with power level "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second sample case, the minimum number of beacons destroyed is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". One way to achieve this is to place a beacon at position "},{"kind":"math_inline","text":"1337"},{"kind":"text","text":" with power level "},{"kind":"math_inline","text":"42"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"607A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/607/problem/A"}