{"assets":[],"contentKind":"statement","contestId":"472","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Design Tutorial: Learn from Life"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"One way to create a task is to learn from life. You can choose some experience in real life, formalize it and then you will get a new task."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's think about a scene in real life: there are lots of people waiting in front of the elevator, each person wants to go to a certain floor. We can formalize it in the following way. We have "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people standing on the first floor, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th person wants to go to the "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":"-th floor. Unfortunately, there is only one elevator and its capacity equal to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" (that is at most "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" people can use it simultaneously). Initially the elevator is located on the first floor. The elevator needs "},{"kind":"math_inline","text":"|a - b|"},{"kind":"text","text":" seconds to move from the "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"-th floor to the "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"-th floor (we don't count the time the people need to get on and off the elevator)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimal number of seconds that is needed to transport all the people to the corresponding floors and then return the elevator to the first floor?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ n, k ≤ 2000)"},{"kind":"text","text":" — the number of people and the maximal capacity of the elevator."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers: "},{"kind":"math_inline","text":"f1, f2, ..., fn"},{"kind":"math_inline","text":"(2 ≤ fi ≤ 2000)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":" denotes the target floor of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th person."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer — the minimal time needed to achieve the goal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n50 100 50 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"296\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 3\n2 2 2 2 2 2 2 2 2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In first sample, an optimal solution is: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" The elevator takes up person #1 and person #2. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" It goes to the 2nd floor. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Both people go out of the elevator. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The elevator goes back to the 1st floor. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then the elevator takes up person #3. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" And it goes to the 2nd floor. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" It picks up person #2. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then it goes to the 3rd floor. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Person #2 goes out. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Then it goes to the 4th floor, where person #3 goes out. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The elevator goes back to the 1st floor. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"472B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/472/problem/B"}