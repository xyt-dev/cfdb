{"assets":[],"contentKind":"statement","contestId":"369","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Valera and Elections"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The city Valera lives in is going to hold elections to the city Parliament."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The city has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" districts and "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" bidirectional roads. We know that from any district there is a path along the roads to any other district. Let's enumerate all districts in some way by integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", inclusive. Furthermore, for each road the residents decided if it is the problem road or not. "},{"children":[{"kind":"text","text":"A problem road"}],"kind":"container"},{"kind":"text","text":" is a road that needs to be repaired."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" candidates running the elections. Let's enumerate all candidates in some way by integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", inclusive. If the candidate number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" will be elected in the city Parliament, he will perform exactly one promise — to repair all problem roads on the way from the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th district to the district "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", where the city Parliament is located."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Valera and determine the subset of candidates such that if all candidates from the subset will be elected to the city Parliament, all problem roads in the city will be repaired. If there are several such subsets, you should choose the subset consisting of the minimum number of candidates."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 105"},{"kind":"text","text":") — the number of districts in the city."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" lines follow. Each line contains the description of a city road as three positive integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ti ≤ 2"},{"kind":"text","text":") — the districts connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th bidirectional road and the road type. If "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" equals to one, then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road isn't the problem road; if "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" equals to two, then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road is the problem road."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that the graph structure of the city is a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print a single non-negative number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the minimum size of the required subset of candidates. Then on the second line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ... ak"},{"kind":"text","text":" — the numbers of the candidates that form the required subset. If there are multiple solutions, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 2\n2 3 2\n3 4 2\n4 5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n5 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 1\n2 3 2\n2 4 1\n4 5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n3 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 2\n1 3 2\n1 4 2\n1 5 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n5 4 3 2 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"369C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/369/problem/C"}