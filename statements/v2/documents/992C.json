{"assets":[],"contentKind":"statement","contestId":"992","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Nastya and a Wardrobe"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Nastya received a gift on New Year — a magic wardrobe. It is magic because in the end of each month the number of dresses in it doubles (i.e. the number of dresses becomes twice as large as it is in the beginning of the month)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, right after the doubling the wardrobe eats one of the dresses (if any) with the "},{"kind":"math_inline","text":"50%"},{"kind":"text","text":" probability. It happens every month except the last one in the year. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nastya owns "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" dresses now, so she became interested in the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Expected_value"},"children":[{"kind":"text","text":"expected number"}],"kind":"link"},{"kind":"text","text":" of dresses she will have in one year. Nastya lives in Byteland, so the year lasts for "},{"kind":"math_inline","text":"k + 1"},{"kind":"text","text":" months."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nastya is really busy, so she wants you to solve this problem. You are the programmer, after all. Also, you should find the answer modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":", because it is easy to see that it is always integer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains two integers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ x, k ≤ 1018"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is the initial number of dresses and "},{"kind":"math_inline","text":"k + 1"},{"kind":"text","text":" is the number of months in a year in Byteland."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the only line print a single integer — the expected number of dresses Nastya will own one year later modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"21\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example a year consists on only one month, so the wardrobe does not eat dresses at all."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example after the first month there are "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" dresses with "},{"kind":"math_inline","text":"50%"},{"kind":"text","text":" probability and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" dresses with "},{"kind":"math_inline","text":"50%"},{"kind":"text","text":" probability. Thus, in the end of the year there are "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" dresses with "},{"kind":"math_inline","text":"50%"},{"kind":"text","text":" probability and "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" dresses with "},{"kind":"math_inline","text":"50%"},{"kind":"text","text":" probability. This way the answer for this test is "},{"kind":"math_inline","text":"(6 + 8) / 2 = 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"992C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/992/problem/C"}