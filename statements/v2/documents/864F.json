{"assets":[],"contentKind":"statement","contestId":"864","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Cities Excursions"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities in Berland. Some pairs of them are connected with "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" directed roads. One can use only these roads to move from one city to another. There are no roads that connect a city to itself. For each pair of cities "},{"kind":"math_inline","text":"(x, y)"},{"kind":"text","text":" there is at most one road from "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"y"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A path from city "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is a sequence of cities "},{"kind":"math_inline","text":"p1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p2"},{"kind":"text","text":", ... , "},{"kind":"math_inline","text":"pk"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"p1 = s"},{"kind":"text","text":", "},{"kind":"math_inline","text":"pk = t"},{"kind":"text","text":", and there is a road from city "},{"kind":"math_inline","text":"pi"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"pi + 1"},{"kind":"text","text":" for each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k - 1"},{"kind":"text","text":". The path can pass multiple times through each city except "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". It can't pass through "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" more than once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A path "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"ideal"}],"kind":"container"},{"kind":"text","text":" if it is the lexicographically minimal such path. In other words, "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" is "},{"children":[{"kind":"text","text":"ideal"}],"kind":"container"},{"kind":"text","text":" path from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" if for any other path "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"t"},{"kind":"math_inline","text":"pi < qi"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is the minimum integer such that "},{"kind":"math_inline","text":"pi ≠ qi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is a tourist agency in the country that offers "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" unusual excursions: the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th excursion starts at city "},{"kind":"math_inline","text":"sj"},{"kind":"text","text":" and ends in city "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each pair "},{"kind":"math_inline","text":"sj"},{"kind":"text","text":", "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":" help the agency to study the ideal path from "},{"kind":"math_inline","text":"sj"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":". Note that it is possible that there is no ideal path from "},{"kind":"math_inline","text":"sj"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":". This is possible due to two reasons: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" there is no path from "},{"kind":"math_inline","text":"sj"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" there are paths from "},{"kind":"math_inline","text":"sj"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":", but for every such path "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" there is another path "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" from "},{"kind":"math_inline","text":"sj"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"pi > qi"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is the minimum integer for which "},{"kind":"math_inline","text":"pi ≠ qi"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The agency would like to know for the ideal path from "},{"kind":"math_inline","text":"sj"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":" the "},{"kind":"math_inline","text":"kj"},{"kind":"text","text":"-th city in that path (on the way from "},{"kind":"math_inline","text":"sj"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each triple "},{"kind":"math_inline","text":"sj"},{"kind":"text","text":", "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":", "},{"kind":"math_inline","text":"kj"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ j ≤ q"},{"kind":"text","text":") find if there is an ideal path from "},{"kind":"math_inline","text":"sj"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":" and print the "},{"kind":"math_inline","text":"kj"},{"kind":"text","text":"-th city in that path, if there is any."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 3000"},{"kind":"text","text":","},{"kind":"math_inline","text":"0 ≤ m ≤ 3000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ q ≤ 4·105"},{"kind":"text","text":") — the number of cities, the number of roads and the number of excursions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ xi, yi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"xi ≠ yi"},{"kind":"text","text":"), denoting that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road goes from city "},{"kind":"math_inline","text":"xi"},{"k