{"assets":[],"contentKind":"statement","contestId":"1174","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Ehab and the Expected XOR Problem"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Given two integers $$$n$$$ and $$$x$$$, construct an array that satisfies the following conditions: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" for any element $$$a_i$$$ in the array, $$$1 \\le a_i \\lt 2^n$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" there is no "},{"children":[{"kind":"text","text":"non-empty"}],"kind":"container"},{"kind":"text","text":" subsegment with "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Bitwise_operation#XOR"},"children":[{"kind":"text","text":"bitwise XOR"}],"kind":"link"},{"kind":"text","text":" equal to $$$0$$$ or $$$x$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" its length $$$l$$$ should be maximized. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"A sequence $$$b$$$ is a subsegment of a sequence $$$a$$$ if $$$b$$$ can be obtained from $$$a$$$ by deletion of several (possibly, zero or all) elements from the beginning and several (possibly, zero or all) elements from the end."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line co