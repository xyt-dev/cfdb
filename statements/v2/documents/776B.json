{"assets":[],"contentKind":"statement","contestId":"776","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Sherlock and his girlfriend"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sherlock has a new girlfriend (so unlike him!). Valentine's day is coming and he wants to gift her some jewelry."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He bought "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pieces of jewelry. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th piece has price equal to "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":", that is, the prices of the jewelry are "},{"kind":"math_inline","text":"2, 3, 4, ... n + 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Watson gave Sherlock a challenge to color these jewelry pieces such that two pieces don't have the same color if the price of one piece is a prime divisor of the price of the other piece. Also, Watson asked him to minimize the number of different colors used."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Sherlock complete this trivial task."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 100000"},{"kind":"text","text":") — the number of jewelry pieces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of output should contain a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", the minimum number of colors that can be used to color the pieces of jewelry with the given constraints."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line should consist of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers (between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":") that specify the color of each piece in the order of increasing price."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple ways to color the pieces using "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" colors, you can output any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 1 2 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2 1 1 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first input, the colors for first, second and third pieces of jewelry having respective prices "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" are "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this case, as "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" is a prime divisor of "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", colors of jewelry having prices "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" must be distinct."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"776B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/776/problem/B"}