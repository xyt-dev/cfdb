{"assets":[],"contentKind":"statement","contestId":"1851","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Parity Sort"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have an array of integers $$$a$$$ of length $$$n$$$. You can apply the following operation to the given array: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Swap two elements $$$a_i$$$ and $$$a_j$$$ such that $$$i \\neq j$$$, $$$a_i$$$ and $$$a_j$$$ are either "},{"children":[{"kind":"text","text":"both"}],"kind":"container"},{"kind":"text","text":" even or "},{"children":[{"kind":"text","text":"both"}],"kind":"container"},{"kind":"text","text":" odd. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":" Determine whether it is possible to sort the array in non-decreasing order by performing the operation any number of times (possibly zero)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, let $$$a$$$ = [$$$7, 10, 1, 3, 2$$$]. Then we can perform $$$3$$$ operations to sort the array: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Swap $$$a_3 = 1$$$ and $$$a_1 = 7$$$, since $$$1$$$ and $$$7$$$ are odd. We get $$$a$$$ = [$$$1, 10, 7, 3, 2$$$]; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Swap $$$a_2 = 10$$$ and $$$a_5 = 2$$$, since $$$10$$$ and $$$2$$$ are even. We get $$$a$$$ = [$$$1, 2, 7, 3, 10$$$]; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Swap $$$a_4 = 3$$$ and $$$a_3 = 7$$$, since $$$3$$$ and $$$7$$$ are odd. We get $$$a$$$ = [$$$1, 2, 3, 7, 10$$$]. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input data contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains one integer $$$n$$$ ($$$1 \\le n \\le 2 \\cdot 10^5$$$) — the length of array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains exactly $$$n$$$ positive integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$) — the elements of array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ over all test cases does not exceed $$$2 \\cdot 10^5$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output on a separate line: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" if the array can be sorted by applying the operation to it some number of times; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" otherwise. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You can output "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" in any case (for example, strings "},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" will be recognized as positive response)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n5\n7 10 1 3 2\n4\n11 9 3 5\n5\n11 3 15 3 2\n6\n10 7 8 1 2 3\n1\n10\n5\n6 6 4 1 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nYES\nNO\nNO\nYES\nNO"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first test case is explained in the problem statement."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1851B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1851/problem/B"}