{"assets":[],"contentKind":"statement","contestId":"1761","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Carry Bit"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let $$$f(x,y)$$$ be the number of "},{"children":[{"kind":"text","text":"carries"}],"kind":"container"},{"kind":"text","text":" of $$$x+y$$$ in binary (i. e. $$$f(x,y)=g(x)+g(y)-g(x+y)$$$, where $$$g(x)$$$ is the number of ones in the binary representation of $$$x$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given two integers $$$n$$$ and $$$k$$$, find the number of ordered pairs $$$(a,b)$$$ such that $$$0 \\leq a,b \\lt 2^n$$$, and $$$f(a,b)$$$ equals $$$k$$$. Note that for $$$a\\ne b$$$, $$$(a,b)$$$ and $$$(b,a)$$$ are considered as two different pairs. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As this number may be large, output it modulo $$$10^9+7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of each test contains two integers $$$n$$$ and $$$k$$$ ($$$0\\leq k \\lt n\\leq 10^6$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer  — the answer modulo $$$10^9+7$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n15\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n27\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n998 244\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n573035660\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here are some examples for understanding "},{"children":[{"kind":"text","text":"carries"}],"kind":"container"},{"kind":"text","text":":"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$$$$ \\begin{aligned} &\\begin{array}{r} 1_{\\ \\ }1_{\\ \\ }1\\\\ +\\ _{1}1_{\\ \\ }0_{\\ \\ }0\\\\ \\hline \\ 1_{\\ \\ }0_{\\ \\ }1_{\\ \\ }1 \\end{array} &\\begin{array}{r} \\ 1_{\\ \\ }0_{\\ \\ }1\\\\ +\\ _{\\ \\ }0_{\\ \\ }0_{1}1\\\\ \\hline \\ 0_{\\ \\ }1_{\\ \\ }1_{\\ \\ }0 \\end{array} & &\\begin{array}{r} \\ 1_{\\ \\ }0_{\\ \\ }1\\\\ +\\ _{1}0_{1}1_{1}1\\\\ \\hline \\ 1_{\\ \\ }0_{\\ \\ }0_{\\ \\ }0 \\end{array} \\end{aligned} $$$$$$"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So $$$f(7,4)=1$$$, $$$f(5,1)=1$$$ and $$$f(5,3)=3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first test case, all the pairs meeting the constraints are $$$(1,1),(1,5),(2,2),(2,3),(3,2),(4,4),(4,5),(4,6),(4,7),(5,1),(5,4),(5,6),(6,4),(6,5),(7,4)$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1761D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1761/problem/D"}