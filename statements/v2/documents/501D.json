{"assets":["/statement-assets/79d6d9cbc840e78e7e944caa5e360a1b62a2dbec35e15126f28311f6950790e7.png","/statement-assets/96ba97856eaac7bd8112d2054a84c3e16783348feec2ab4a1057ee8a1d8b5ac7.png","/statement-assets/26073b9130c7cc5813e362a32969649f4f741d1914d67c4be7144170072284c1.png","/statement-assets/98cb7180fa1198030b4c9f42ac375853d0536f0236ecd4cfccb4659dfb7d0ffb.png"],"contentKind":"statement","contestId":"501","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Misha and Permutations Summation"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Let's define the sum of two permutations "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" of numbers "},{"kind":"math_inline","text":"0, 1, ..., (n - 1)"},{"kind":"text","text":" as permutation "},{"attrs":{"alt":"","src":"/statement-assets/79d6d9cbc840e78e7e944caa5e360a1b62a2dbec35e15126f28311f6950790e7.png"},"kind":"image"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"Perm(x)"},{"kind":"text","text":" is the "},{"kind":"math_inline","text":"x"},{"kind":"text","text":"-th lexicographically permutation of numbers "},{"kind":"math_inline","text":"0, 1, ..., (n - 1)"},{"kind":"text","text":" (counting from zero), and "},{"kind":"math_inline","text":"Ord(p)"},{"kind":"text","text":" is the number of permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" in the lexicographical order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, "},{"kind":"math_inline","text":"Perm(0) = (0, 1, ..., n - 2, n - 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"Perm(n! - 1) = (n - 1, n - 2, ..., 1, 0)"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Misha has two permutations, "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":". Your task is to find their sum."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Permutation "},{"kind":"math_inline","text":"a = (a0, a1, ..., an - 1)"},{"kind":"text","text":" is called to be lexicographically smaller than permutation "},{"kind":"math_inline","text":"b = (b0, b1, ..., bn - 1)"},{"kind":"text","text":", if for some "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" following conditions hold: "},{"kind":"math_inline","text":"a0 = b0, a1 = b1, ..., ak - 1 = bk - 1, ak < bk"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200 000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":", separated by a space, forming permutation "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":", separated by spaces, forming permutation "},{"kind":"math_inline","text":"q"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers from "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":", forming the sum of the given permutations. Separate the numbers by spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n0 1\n0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n0 1\n1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 0\n2 1 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 0 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Permutations of numbers from 0 to 1 in the lexicographical order: "},{"kind":"math_inline","text":"(0, 1), (1, 0)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample "},{"kind":"math_inline","text":"Ord(p) = 0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Ord(q) = 0"},{"kind":"text","text":", so the answer is "},{"attrs":{"alt":"","src":"/statement-assets/96ba97856eaac7bd8112d2054a84c3e16783348feec2ab4a1057ee8a1d8b5ac7.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample "},{"kind":"math_inline","text":"Ord(p) = 0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Ord(q) = 1"},{"kind":"text","text":", so the answer is "},{"attrs":{"alt":"","src":"/statement-assets/26073b9130c7cc5813e362a32969649f4f741d1914d67c4be7144170072284c1.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Permutations of numbers from 0 to 2 in the lexicographical order: "},{"kind":"math_inline","text":"(0, 1, 2), (0, 2, 1), (1, 0, 2), (1, 2, 0), (2, 0, 1), (2, 1, 0)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample "},{"kind":"math_inline","text":"Ord(p) = 3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Ord(q) = 5"},{"kind":"text","text":", so the answer is "},{"attrs":{"alt":"","src":"/statement-assets/98cb7180fa1198030b4c9f42ac375853d0536f0236ecd4cfccb4659dfb7d0ffb.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","prob