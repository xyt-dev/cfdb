{"assets":[],"contentKind":"statement","contestId":"160","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Buses and People"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The main Bertown street is represented by a straight line. There are "},{"kind":"math_inline","text":"109"},{"kind":"text","text":" bus stops located on the line. The stops are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"109"},{"kind":"text","text":" in the order in which they follow on the road. The city has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" buses. Every day the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th bus drives from stop number "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" to stop number "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"si < fi"},{"kind":"text","text":"), it stops on all intermediate stops and returns only at night. The bus starts driving at time "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" and drives so fast that it finishes driving also at time "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":". The time "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" is different for all buses. The buses have infinite capacity."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Bertown has "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" citizens. Today the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th person should get from stop number "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to stop number "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"li < ri"},{"kind":"text","text":"); the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th citizen comes to his initial stop ("},{"kind":"math_inline","text":"li"},{"kind":"text","text":") at time "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". Each person, on the one hand, wants to get to the destination point as quickly as possible, and on the other hand, definitely does not want to change the buses as he rides. More formally: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th person chooses bus "},{"kind":"math_inline","text":"j"},{"kind":"text","text":", with minimum time "},{"kind":"math_inline","text":"tj"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"sj ≤ li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri ≤ fj"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"bi ≤ tj"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine for each citizen whether he can ride to the destination point today and if he can, find the number of the bus on which the citizen will ride."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":") — the number of buses and the number of people. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, each of them contains three integers: "},{"kind":"math_inline","text":"si"},{"kind":"text","text":", "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ si, fi, ti ≤ 109, si < fi"},{"kind":"text","text":") — the description of the buses. It is guaranteed that all "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":"-s are different."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follow, each of them contains three integers: "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li, ri, bi ≤ 109, li < ri"},{"kind":"text","text":") — the Bertown citizens' description. Some "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":"-s could coincide."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" space-separated integers: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th number should be equal either to -1, if the person number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" can't get to the destination point, or to the number of the bus that will ride the person number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". The buses are numbered with integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in the input order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n1 10 10\n5 6 2\n6 7 3\n5 7 4\n5 7 1\n1 2 1\n1 10 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 1 -1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n1 1000000000 1000000000\n1 1000000000 1000000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"160E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/160/problem/E"}