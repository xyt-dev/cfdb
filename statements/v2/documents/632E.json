{"assets":[],"contentKind":"statement","contestId":"632","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Thief in a Shop"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A thief made his way to a shop."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As usual he has his lucky knapsack with him. The knapsack can contain "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" objects. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" kinds of products in the shop and an infinite number of products of each kind. The cost of one product of kind "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The thief is greedy, so he will take exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" products (it's possible for some kinds to take several products of that kind)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find all the possible total costs of products the thief can nick into his knapsack."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text"