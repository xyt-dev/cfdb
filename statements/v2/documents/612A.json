{"assets":[],"contentKind":"statement","contestId":"612","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. The Text Splitting"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of length "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and the numbers "},{"kind":"math_inline","text":"p, q"},{"kind":"text","text":". Split the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to pieces of length "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, the string \""},{"children":[{"kind":"text","text":"Hello"}],"kind":"container"},{"kind":"text","text":"\" for "},{"kind":"math_inline","text":"p = 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"q = 3"},{"kind":"text","text":" can be split to the two strings \""},{"children":[{"kind":"text","text":"Hel"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"lo"}],"kind":"container"},{"kind":"text","text":"\" or to the two strings \""},{"children":[{"kind":"text","text":"He"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"llo"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note it is allowed to split the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to the strings only of length "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" or to the strings only of length "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" (see the second sample test)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three positive integers "},{"kind":"math_inline","text":"n, p, q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ p, q ≤ n ≤ 100"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" consists of lowercase and uppercase latin letters and digits."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it's impossible to split the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" to the strings of length "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" print the only number \""},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise in the first line print integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the number of strings in partition of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines should contain the strings in partition. Each string should be of the length "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"q"},{"kind":"text","text":". The string should be in order of their appearing in string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" — from left to right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several solutions print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 3\nHello\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\nHe\nllo\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 9 5\nCodeforces\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\nCodef\norces\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 4 5\nPrivet\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"-1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","tex