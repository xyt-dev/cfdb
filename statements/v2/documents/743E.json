{"assets":["/statement-assets/ad0066be06a76723f626eb1db7d8f55f25c94675a2151cdb9c61977035309cee.png"],"contentKind":"statement","contestId":"743","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Vladik and cards"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vladik was bored on his way home and decided to play the following game. He took "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cards and put them in a row in front of himself. Every card has a positive integer number not exceeding "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" written on it. He decided to find the longest subsequence of cards which satisfies the following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the number of occurrences of each number from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" in the subsequence doesn't differ by more then "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" from the number of occurrences of any other number. Formally, if there are "},{"kind":"math_inline","text":"ck"},{"kind":"text","text":" cards with number "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" on them in the subsequence, than for all pairs of integers "},{"attrs":{"alt":"","src":"/statement-assets/ad0066be06a76723f626eb1db7d8f55f25c94675a2151cdb9c61977035309cee.png"},"kind":"image"},{"kind":"text","text":" the condition "},{"kind":"math_inline","text":"|ci - cj| ≤ 1"},{"kind":"text","text":" must hold. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if there is at least one card with number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" on it in the subsequence, then all cards with number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" in this subsequence must form a continuous segment in it ("},{"children":[{"kind":"text","text":"but not necessarily a continuous segment in the original sequence"}],"kind":"container"},{"kind":"text","text":"). For example, the subsequence "},{"kind":"math_inline","text":"[1, 1, 2, 2]"},{"kind":"text","text":" satisfies this condition while the subsequence "},{"kind":"math_inline","text":"[1, 2, 2, 1]"},{"kind":"text","text":" doesn't. Note that "},{"kind":"math_inline","text":"[1, 1, 2, 2]"},{"kind":"text","text":" doesn't satisfy the first condition. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Please help Vladik to find the length of the longest subsequence that satisfies both conditions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":") — the number of cards in Vladik's sequence."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains the sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers not exceeding "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" — the description of Vladik's sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print single integer — the length of the longest subsequence of Vladik's sequence that satisfies both conditions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n8 7 6 5 4 3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"24\n1 8 1 2 8 2 3 8 3 4 8 4 5 8 5 6 8 6 7 8 7 8 8 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"17"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample all the numbers written on the cards are equal, so you can't take more than one card, otherwise you'll violate the first condition."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"743E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/743/problem/E"}