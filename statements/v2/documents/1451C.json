{"assets":[],"contentKind":"statement","contestId":"1451","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. String Equality"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Ashish has two strings $$$a$$$ and $$$b$$$, each of length $$$n$$$, and an integer $$$k$$$. The strings only contain lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He wants to convert string $$$a$$$ into string $$$b$$$ by performing some (possibly zero) operations on $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one move, he can either "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" choose an index $$$i$$$ ($$$1 \\leq i\\leq n-1$$$) and swap $$$a_i$$$ and $$$a_{i+1}$$$, or "}],"kind":"list_item"},{"children":[{"kind":"text","text":" choose an index $$$i$$$ ($$$1 \\leq i \\leq n-k+1$$$) and if $$$a_i, a_{i+1}, \\ldots, a_{i+k-1}$$$ are "},{"children":[{"kind":"text","text":"all equal"}],"kind":"container"},{"kind":"text","text":" to some character $$$c$$$ ($$$c \\neq$$$ '"},{"children":[{"kind":"text","text":"z"}],"kind":"container"},{"kind":"text","text":"'), replace each one with the next character $$$(c+1)$$$, that is, '"},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"' is replaced by '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"' is replaced by '"},{"children":[{"kind":"text","text":"c"}],"kind":"container"},{"kind":"text","text":"' and so on. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that he can perform any number of operations, and the operations can only be performed on string $$$a$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Ashish determine if it is possible to convert string $$$a$$$ into $$$b$$$ after performing some (possibly zero) operations on it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\leq t \\leq 10^5$$$) — the number of test cases. The description of each test case is as follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of each test case contains two integers $$$n$$$ ($$$2 \\leq n \\leq 10^6$$$) and $$$k$$$ ($$$1 \\leq k \\leq n$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of each test case contains the string $$$a$$$ of length $$$n$$$ consisting of lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line of each test case contains the string $$$b$$$ of length $$$n$$$ consisting of lowercase English letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of values $$$n$$$ among all test cases does not exceed $$$10^6$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print \""},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":"\" if Ashish can convert $$$a$$$ into $$$b$$$ after some moves, else print \""},{"children":[{"kind":"text","text":"No"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may print the letters of the answer in any case (upper or lower)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n3 3\nabc\nbcd\n4 2\nabba\nazza\n2 1\nzz\naa\n6 2\naaabba\nddddcc\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nNo\nYes\nNo\nYes\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case it can be shown that it is impossible to convert $$$a$$$ into $$$b$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case,"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"a"},{"children":[{"kind":"text","text":"bb"}],"kind":"container"},{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" $$$\\xrightarrow{\\text{inc}}$$$ \""},{"children":[{"kind":"text","text":"a"},{"children":[{"kind":"text","text":"cc"}],"kind":"container"},{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"\" $$$\\xrightarrow{\\text{inc}}$$$ $$$\\ldots$$$ $$$\\xrightarrow{\\text{inc}}$$$ \""},{"children":[{"kind":"text","text":"azza"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Here \"swap\" denotes an operation of the first type, and \"inc\" denotes an operation of the seco