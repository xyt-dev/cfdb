{"assets":[],"contentKind":"statement","contestId":"611","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. New Year and Ancient Prophecy"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Limak is a little polar bear. In the snow he found a scroll with the ancient prophecy. Limak doesn't know any ancient languages and thus is unable to understand the prophecy. But he knows digits!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"One fragment of the prophecy is a sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" digits. The first digit isn't zero. Limak thinks that it's a list of some special years. It's hard to see any commas or spaces, so maybe ancient people didn't use them. Now Limak wonders what years are listed there."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Limak assumes three things:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Years are listed in the "},{"children":[{"kind":"text","text":"strictly"}],"kind":"container"},{"kind":"text","text":" increasing order; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Every year is a positive integer number; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" There are no leading zeros. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Limak is going to consider all possible ways to split a sequence into numbers (years), satisfying the conditions abo