{"assets":[],"contentKind":"statement","contestId":"633","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Spy Syndrome 2"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"After observing the results of Spy Syndrome, Yash realised the errors of his ways. He now believes that a super spy such as Siddhant can't use a cipher as basic and ancient as Caesar cipher. After many weeks of observation of Siddhant’s sentences, Yash determined a new cipher technique."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a given sentence, the cipher is processed as: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Convert all letters of the sentence to lowercase. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Reverse each of the words of the sentence individually. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Remove all the spaces in the sentence. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For example, when this cipher is applied to the sentence"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Kira is childish and he hates losing"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"the resulting string is"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"ariksihsidlihcdnaehsetahgnisol"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Yash is given some ciphered string and a list of words. Help him to find out any original sentence composed using only words from the list. Note, that any of the given words could be used in the sentence multiple times."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 10 000"},{"kind":"text","text":") — the length of the ciphered text. The second line consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lowercase English letters — the ciphered text "},{"kind":"math_inline","text":"t"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains a single integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 100 000"},{"kind":"text","text":") — the number of words which will be considered while deciphering the text. Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains a non-empty word "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|wi| ≤ 1 000"},{"kind":"text","text":") consisting of uppercase and lowercase English letters only. It's guaranteed that the total length of all words doesn't exceed "},{"kind":"math_inline","text":"1 000 000"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one line — the original sentence. It is guaranteed that at least one solution exists. If there are multiple solutions, you may output any of those."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"30\nariksihsidlihcdnaehsetahgnisol\n10\nKira\nhates\nis\nhe\nlosing\ndeath\nchildish\nL\nand\nNote\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Kira is childish and he hates losing \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"12\niherehtolleh\n5\nHI\nHo\nthere\nHeLLo\nhello\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"HI there HeLLo \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In sample case 2 there may be multiple accepted outputs, \"HI there HeLLo\" and \"HI there hello\" you may output any of them. "}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"633C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/633/problem/C"}