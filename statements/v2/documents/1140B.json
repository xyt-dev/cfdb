{"assets":[],"contentKind":"statement","contestId":"1140","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Good String"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have a string $$$s$$$ of length $$$n$$$ consisting of only characters "},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":". You may do some operations with this string, for each operation you have to choose some character that still remains in the string. If you choose a character "},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":", the character that comes right after it is deleted (if the character you chose was the last one, nothing happens). If you choose a character "},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":", the character that comes right before it is deleted (if the character you chose was the first one, nothing happens)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if we choose character "},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":" in string "},{"children":[{"kind":"text","text":"> "},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":" < >"}],"kind":"container"},{"kind":"text","text":", the string will become to "},{"children":[{"kind":"text","text":"> > >"}],"kind":"container"},{"kind":"text","text":". And if we choose character "},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":" in string "},{"children":[{"kind":"text","text":"> "},{"children":[{"kind":"text","text":"<"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":", the string will become to "},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The string is good if there is a sequence of operations such that after performing it only one character will remain in the string. For example, the strings "},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"> >"}],"kind":"container"},{"kind":"text","text":" are good. "}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Before applying the operations"}],"kind":"container"},{"kind":"text","text":", you may remove any number of characters from the given string (possibly none, possibly up to $$$n - 1$$$, but not the whole string). You need to calculate the minimum number of characters to be deleted from string $$$s$$$ so that it becomes good."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 100$$$) – the number of test cases. Each test case is represented by two lines."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line of $$$i$$$-th test case contains one integer $$$n$$$ ($$$1 \\le n \\le 100$$$) – the length of string $$$s$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of $$$i$$$-th test case contains string $$$s$$$, consisting of only characters "},{"children":[{"kind":"text","text":">"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case print one line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For $$$i$$$-th test case print the minimum number of characters to be deleted from string $$$s$$$ so that it becomes good."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n2\n<>\n3\n><<\n1\n>\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n0\n0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case we can delete any character in string "},{"children":[{"kind":"text","text":"<>"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case we don't need to delete any characters. The string "},{"children":[{"kind":"text","text":"> < <"}],"kind":"container"},{"kind":"text","text":" is good, because we can perform the following sequence of operations: "},{"children":[{"kind":"text","text":"> "},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":" <"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"< "},{"children":[{"kind":"text","text":"<"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"<"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1140B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1140/problem/B"}