{"assets":[],"contentKind":"statement","contestId":"762","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Radio stations"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In the lattice points of the coordinate line there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" radio stations, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of which is described by three integers:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"xi"},{"kind":"text","text":" — the coordinate of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th station on the line, "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ri"},{"kind":"text","text":" — the broadcasting range of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th station, "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"fi"},{"kind":"text","text":" — the broadcasting frequency of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th station. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"We will say that two radio stations with numbers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" reach each other, if the broadcasting range of each of them is more or equal to the distance between them. In other words "},{"kind":"math_inline","text":"min(r