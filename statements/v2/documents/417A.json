{"assets":[],"contentKind":"statement","contestId":"417","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Elimination"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The finalists of the \"Russian Code Cup\" competition in 2214 will be the participants who win in one of the elimination rounds."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The elimination rounds are divided into main and additional. Each of the main elimination rounds consists of "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" problems, the winners of the round are the first "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" people in the rating list. Each of the additional elimination rounds consists of "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" problems. The winner of the additional round is one person. Besides, "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" winners of the past finals are invited to the finals without elimination."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As a result of all elimination rounds at least "},{"kind":"math_inline","text":"n·m"},{"kind":"text","text":" people should go to the finals. You need to organize elimination rounds in such a way, that at least "},{"kind":"math_inline","text":"n·m"},{"kind":"text","text":" people go to the finals, and the total amount of used problems in all rounds is as small as possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ c, d ≤ 100"},{"kind":"text","text":") — the number of problems in the main and additional rounds, correspondingly. The second line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 100"},{"kind":"text","text":"). Finally, the third line contains an integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 100"},{"kind":"text","text":") — the number of the pre-chosen winners. "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line, print a single integer — the minimum number of problems the jury needs to prepare."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 10\n7 2\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n2 1\n2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"417A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/417/problem/A"}