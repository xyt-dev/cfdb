{"assets":["/statement-assets/6b03066d35f6151accb03937569acb0e7ea54bc905fc8615974fcb59cc74cab7.png"],"contentKind":"statement","contestId":"897","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Chtholly's request"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"children":[{"kind":"text","text":" — Thanks a lot for today."},{"children":[{"kind":"text","text":"— I experienced so many great things."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"— You gave me memories like dreams... But I have to leave now..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"— One last request, can you..."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"— Help me solve a Codeforces problem?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"— ......"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"— What?"}],"kind":"paragraph"}],"kind":"container"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Chtholly has been thinking about a problem for days:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If a number is "},{"children":[{"kind":"text","text":"palindrome"}],"kind":"container"},{"kind":"text","text":" and length of its decimal representation without leading zeros is even, we call it a zcy number. A number is "},{"children":[{"kind":"text","text":"palindrome"}],"kind":"container"},{"kind":"text","text":" means when written in decimal representation, it contains no leading zeros and reads the same forwards and backwards. For example "},{"children":[{"kind":"text","text":"12321"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"1221"}],"kind":"container"},{"kind":"text","text":" are palindromes and "},{"children":[{"kind":"text","text":"123"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"12451"}],"kind":"container"},{"kind":"text","text":" are not. Moreover, "},{"children":[{"kind":"text","text":"1221"}],"kind":"container"},{"kind":"text","text":" is zcy number and "},{"children":[{"kind":"text","text":"12321"}],"kind":"container"},{"kind":"text","text":" is not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Given integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", calculate the sum of the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" smallest zcy numbers and output this sum modulo "},{"kind":"math_inline","text":"p"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Unfortunately, Willem isn't good at solving this kind of problems, so he asks you for help!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"p"},{"kind":"math_inline","text":"(1 ≤ k ≤ 105, 1 ≤ p ≤ 109)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output single integer — answer to the problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"33\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 30\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"15\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the smallest zcy number is "},{"kind":"math_inline","text":"11"},{"kind":"text","text":", and the second smallest zcy number is "},{"kind":"math_inline","text":"22"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, "},{"attrs":{"alt":"","src":"/statement-assets/6b03066d35f6151accb03937569acb0e7ea54bc905fc8615974fcb59cc74cab7.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"897B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/897/problem/B"}