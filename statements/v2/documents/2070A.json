{"assets":[],"contentKind":"statement","contestId":"2070","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. FizzBuzz Remixed"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"FizzBuzz is one of the most well-known problems from coding interviews. In this problem, we will consider a remixed version of FizzBuzz:"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Given an integer $$$n$$$, process all integers from $$$0$$$ to $$$n$$$. For every integer such that its remainders modulo $$$3$$$ and modulo $$$5$$$ are the same (so, for every integer $$$i$$$ such that $$$i \\bmod 3 = i \\bmod 5$$$), print"}],"kind":"container"},{"children":[{"kind":"text","text":"FizzBuzz"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"However, you don't have to solve it. Instead, given the integer $$$n$$$, you have to report how many times the correct solution to that problem will print "},{"children":[{"kind":"text","text":"FizzBuzz"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case contains one line consisting of one integer $$$n$$$ ($$$0 \\le n \\le 10^9$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer — the number of times the correct solution will print "},{"children":[{"kind":"text","text":"FizzBuzz"}],"kind":"container"},{"kind":"text","text":" with the given value of $$$n$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n0\n5\n15\n42\n1337\n17101997\n998244353\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n3\n4\n9\n270\n3420402\n199648872\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the solution will print "},{"children":[{"kind":"text","text":"FizzBuzz"}],"kind":"container"},{"kind":"text","text":" for the integer $$$0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the solution will print "},{"children":[{"kind":"text","text":"FizzBuzz"}],"kind":"container"},{"kind":"text","text":" for the integers $$$0, 1, 2$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, the solution will print "},{"children":[{"kind":"text","text":"FizzBuzz"}],"kind":"container"},{"kind":"text","text":" for the integers $$$0, 1, 2, 15$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2070A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2070/problem/A"}