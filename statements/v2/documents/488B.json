{"assets":["/statement-assets/40c5fa6a0ee04b6fef5ac44690af960590fda197184290c357ad4129d2c22321.png","/statement-assets/37fe93ad1181813d40b83bea52c0e5ea4e58b1ad27772b29b26992697da87288.png"],"contentKind":"statement","contestId":"488","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Candy Boxes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is an old tradition of keeping "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" boxes of candies in the house in Cyberland. The numbers of candies are "},{"children":[{"kind":"text","text":"special"}],"kind":"container"},{"kind":"text","text":" if their "},{"children":[{"kind":"text","text":"arithmetic mean"}],"kind":"container"},{"kind":"text","text":", their "},{"children":[{"kind":"text","text":"median"}],"kind":"container"},{"kind":"text","text":" and their "},{"children":[{"kind":"text","text":"range"}],"kind":"container"},{"kind":"text","text":" are all equal. By definition, for a set "},{"kind":"math_inline","text":"{x1, x2, x3, x4}"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"x1 ≤ x2 ≤ x3 ≤ x4"},{"kind":"text","text":") "},{"children":[{"kind":"text","text":"arithmetic mean"}],"kind":"container"},{"kind":"text","text":" is "},{"attrs":{"alt":"","src":"/statement-assets/40c5fa6a0ee04b6fef5ac44690af960590fda197184290c357ad4129d2c22321.png"},"kind":"image"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"median"}],"kind":"container"},{"kind":"text","text":" is "},{"attrs":{"alt":"","src":"/statement-assets/37fe93ad1181813d40b83bea52c0e5ea4e58b1ad27772b29b26992697da87288.png"},"kind":"image"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"range"}],"kind":"container"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"x4 - x1"},{"kind":"text","text":". "},{"children":[{"kind":"text","text":"The arithmetic mean and median are not necessary integer."}],"kind":"container"},{"kind":"text","text":" It is well-known that if those three numbers are same, boxes will create a \"debugging field\" and codes in the field will have no bugs."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, "},{"kind":"math_inline","text":"1, 1, 3, 3"},{"kind":"text","text":" is the example of "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" numbers meeting the condition because their mean, median and range are all equal to "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Jeff has "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" special boxes of candies. However, something bad has happened! Some of the boxes could have been lost and now there are only "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ n ≤ 4"},{"kind":"text","text":") boxes remaining. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th remaining box contains "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" candies."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Now Jeff wants to know: is there a possible way to find the number of candies of the "},{"kind":"math_inline","text":"4 - n"},{"kind":"text","text":" missing boxes, meeting the condition above (the mean, median and range are equal)?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains an only integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ n ≤ 4"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", denoting the number of candies in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th box ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 500"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first output line, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if a solution exists, or print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" if there is no solution."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If a solution exists, you should output "},{"kind":"math_inline","text":"4 - n"},{"kind":"text","text":" more lines, each line containing an integer "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", denoting the number of candies in a missing box."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All your numbers "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" must satisfy inequality "},{"kind":"math_inline","text":"1 ≤ b ≤ 106"},{"kind":"text","text":". It is guaranteed that if there exists a positive integer solution, you can always find such "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"'s meeting the condition. If there are multiple answers, you are allowed to print any of them."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Given numbers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" may follow in any order in the input, not necessary in non-decreasing."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"math_inline","text":"ai"},{"kind":"text","text":" may have stood at any positions in the original set, not necessary on lowest "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" first positions"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n3\n3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1\n1\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1\n2\n2\n3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"For the first sample, the numbers of candies in "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" boxes can be "},{"kind":"math_inline","text":"1, 1, 3, 3"},{"kind":"text","text":". The arithmetic mean, the median and the range of them are all "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For the second sample, it's impossible to find the missing number of candies."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example no box has been lost and numbers satisfy the condition."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"You may output "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" in any order."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"488B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/488/problem/B"}