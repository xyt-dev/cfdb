{"assets":[],"contentKind":"statement","contestId":"1772","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Different Differences"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"An array $$$a$$$ consisting of $$$k$$$ integers is "},{"children":[{"kind":"text","text":"strictly increasing"}],"kind":"container"},{"kind":"text","text":" if $$$a_1 \\lt a_2 \\lt \\dots \\lt a_k$$$. For example, the arrays $$$[1, 3, 5]$$$, $$$[1, 2, 3, 4]$$$, $$$[3, 5, 6]$$$ are strictly increasing; the arrays $$$[2, 2]$$$, $$$[3, 7, 5]$$$, $$$[7, 4, 3]$$$, $$$[1, 2, 2, 3]$$$ are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For a strictly increasing array $$$a$$$ of $$$k$$$ elements, let's denote the "},{"children":[{"kind":"text","text":"characteristic"}],"kind":"container"},{"kind":"text","text":" as the number of different elements in the array $$$[a_2 - a_1, a_3 - a_2, \\dots, a_k - a_{k-1}]$$$. For example, the characteristic of the array $$$[1, 3, 4, 7, 8]$$$ is $$$3$$$ since the array $$$[2, 1, 3, 1]$$$ contains $$$3$$$ different elements: $$$2$$$, $$$1$$$ and $$$3$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given two integers $$$k$$$ and $$$n$$$ ($$$k \\le n$$$). Construct an increasing array of $$$k$$$ integers from $$$1$$$ to $$$n$$$ with "},{"children":[{"kind":"text","text":"maximum possible"}],"kind":"container"},{"kind":"text","text":" characteristic."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 819$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of one line containing two integers $$$k$$$ and $$$n$$$ ($$$2 \\le k \\le n \\le 40$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print $$$k$$$ integers — the elements of the strictly increasing array $$$a$$$ with the maximum possible characteristic. If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n5 9\n4 12\n3 3\n3 4\n4 4\n4 6\n8 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1 3 4 7 8\n2 4 7 12\n1 2 3\n1 3 4\n1 2 3 4\n2 4 5 6\n1 2 3 5 6 7 8 11\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1772C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1772/problem/C"}