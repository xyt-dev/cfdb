{"assets":[],"contentKind":"statement","contestId":"180","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Divisibility Rules"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Vasya studies divisibility rules at school. Here are some of them:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"Divisibility by "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" A number is divisible by "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" if and only if its last digit is divisible by "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" or in other words, is even."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Divisibility by "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" A number is divisible by "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" if and only if the sum of its digits is divisible by "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Divisibility by "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" A number is divisible by "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" if and only if its last two digits form a number that is divisible by "},{"kind":"math_inline","text":"4"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Divisibility by "},{"kind":"math_inline","text":"5"},{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" A number is divisible by "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" if and only if its last digit equals "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" or "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Divisibility by "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" A number is divisible by "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" if and only if it is divisible by "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" simultaneously (that is, if the last digit is even and the sum of all digits is divisible by "},{"kind":"math_inline","text":"3"},{"kind":"text","text":")."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Divisibility by "},{"kind":"math_inline","text":"7"},{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" Vasya doesn't know such divisibility rule."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Divisibility by "},{"kind":"math_inline","text":"8"},{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" A number is divisible by "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" if and only if its last three digits form a number that is divisible by "},{"kind":"math_inline","text":"8"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Divisibility by "},{"kind":"math_inline","text":"9"},{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" A number is divisible by "},{"kind":"math_inline","text":"9"},{"kind":"text","text":" if and only if the sum of its digits is divisible by "},{"kind":"math_inline","text":"9"},{"kind":"text","text":"."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Divisibility by "},{"kind":"math_inline","text":"10"},{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" A number is divisible by "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" if and only if its last digit is a zero."}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"Divisibility by "},{"kind":"math_inline","text":"11"},{"kind":"text","text":"."}],"kind":"container"},{"kind":"text","text":" A number is divisible by "},{"kind":"math_inline","text":"11"},{"kind":"text","text":" if and only if the sum of digits on its odd positions either equals to the sum of digits on the even positions, or they differ in a number that is divisible by "},{"kind":"math_inline","text":"11"},{"kind":"text","text":"."}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Vasya got interested by the fact that some divisibility rules resemble each other. In fact, to check a number's divisibility by "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", "},{"kind":"math_inline","text":"8"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"10"},{"kind":"text","text":" it is enough to check fulfiling some condition for one or several last digits. Vasya calls such rules the "},{"children":[{"kind":"math_inline","text":"2"},{"kind":"text","text":"-type"}],"kind":"container"},{"kind":"text","text":" rules."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If checking divisibility means finding a sum of digits and checking whether the sum is divisible by the given number, then Vasya calls this rule the "},{"children":[{"kind":"math_inline","text":"3"},{"kind":"text","text":"-type"}],"kind":"container"},{"kind":"text","text":" rule (because it works for numbers "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"9"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If we need to find the difference between the sum of digits on odd and even positions and check whether the difference is divisible by the given divisor, this rule is called the "},{"children":[{"kind":"math_inline","text":"11"},{"kind":"text","text":"-type"}],"kind":"container"},{"kind":"text","text":" rule (it works for number "},{"kind":"math_inline","text":"11"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In some cases we should divide the divisor into several factors and check whether rules of different types ("},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-type, "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-type or "},{"kind":"math_inline","text":"11"},{"kind":"text","text":"-type) work there. For example, for number "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" we check "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-type and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-type rules, for number "},{"kind":"math_inline","text":"66"},{"kind":"text","text":" we check all three types. Such mixed divisibility rules are called "},{"children":[{"kind":"math_inline","text":"6"},{"kind":"text","text":"-type"}],"kind":"container"},{"kind":"text","text":" rules. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"And finally, there are some numbers for which no rule works: neither "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-type, nor "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-type, nor "},{"kind":"math_inline","text":"11"},{"kind":"text","text":"-type, nor "},{"kind":"math_inline","text":"6"},{"kind":"text","text":"-type. The least such number is number "},{"kind":"math_inline","text":"7"},{"kind":"text","text":", so we'll say that in such cases the mysterious "},{"children":[{"kind":"math_inline","text":"7"},{"kind":"text","text":"-type"}],"kind":"container"},{"kind":"text","text":" rule works, the one that Vasya hasn't discovered yet. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Vasya's dream is finding divisibility rules for all possible numbers. He isn't going to stop on the decimal numbers only. As there are quite many numbers, ha can't do it all by himself. Vasya asked you to write a program that determines the divisibility rule type in the "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"-based notation for the given divisor "},{"kind":"math_inline","text":"d"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains two integers "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ b, d ≤ 100"},{"kind":"text","text":") — the notation system base and the divisor. Both numbers are given in the decimal notation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first output line print the type of the rule in the "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"-based notation system, where the divisor is "},{"kind":"math_inline","text":"d"},{"kind":"text","text":": \""},{"children":[{"kind":"text","text":"2-type"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"3-type"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"11-type"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"6-type"}],"kind":"container"},{"kind":"text","text":"\" or \""},{"children":[{"kind":"text","text":"7-type"}],"kind":"container"},{"kind":"text","text":"\". If there are several such types, print the one that goes earlier in the given sequence. If a number belongs to the "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"-type, print on the second line the least number of the last "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"-based digits that we will need to use to check the divisibility."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2-type\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"11-type\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The divisibility rule for number "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" in binary notation looks as follows: \"A number is divisible by "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" if and only if the sum of its digits that occupy the even places differs from the sum of digits that occupy the odd places, in a number that is divisible by "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"\". That's an "},{"kind":"math_inline","text":"11"},{"kind":"text","text":"-type rule. For example, "},{"kind":"math_inline","text":"2110 = 101012"},{"kind":"text","text":". For it the sum of digits on odd positions equals "},{"kind":"math_inline","text":"1 + 1 + 1 = 3"},{"kind":"text","text":", an on even positions — "},{"kind":"math_inline","text":"0 + 0 = 0"},{"kind":"text","text":". The rule works and the number is divisible by "},{"kind":"math_inline","text":"3"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In some notations a number can fit into the "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"-type rule and the "},{"kind":"math_inline","text":"11"},{"kind":"text","text":"-type rule. In this case the correct answer is \""},{"children":[{"kind":"text","text":"3-type"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"180B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/180/problem/B"}