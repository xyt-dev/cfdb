{"assets":[],"contentKind":"statement","contestId":"231","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Cactus"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A connected undirected graph is called a "},{"children":[{"kind":"text","text":"vertex cactus"}],"kind":"container"},{"kind":"text","text":", if each vertex of this graph belongs to at most one simple cycle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"simple cycle"}],"kind":"container"},{"kind":"text","text":" in a undirected graph is a sequence of distinct vertices "},{"kind":"math_inline","text":"v1, v2, ..., vt"},{"kind":"math_inline","text":"(t > 2)"},{"kind":"text","text":", such that for any "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i < t)"},{"kind":"text","text":" exists an edge between vertices "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi + 1"},{"kind":"text","text":", and also exists an edge between vertices "},{"kind":"math_inline","text":"v1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vt"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"simple path"}],"kind":"container"},{"kind":"text","text":" in a undirected graph is a sequence of not necessarily distinct vertices "},{"kind":"math_inline","text":"v1, v2, ..., vt"},{"kind":"math_inline","text":"(t > 0)"},{"kind":"text","text":", such that for any "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i < t)"},{"kind":"text","text":" exists an edge between vertices "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"vi + 1"},{"kind":"text","text":" and furthermore each "},{"children":[{"kind":"text","text":"edge occurs no more than once"}],"kind":"container"},{"kind":"text","text":". We'll say that a simple path "},{"kind":"math_inline","text":"v1, v2, ..., vt"},{"kind":"text","text":" starts at vertex "},{"kind":"math_inline","text":"v1"},{"kind":"text","text":" and ends at vertex "},{"kind":"math_inline","text":"vt"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You've got a graph consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges, that is a vertex cactus. Also, you've got a list of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" pairs of interesting vertices "},{"kind":"math_inline","text":"xi, yi"},{"kind":"text","text":", for which you want to know the following information — the number of distinct simple paths that start at vertex "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and end at vertex "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":". We will consider two simple paths distinct if the sets of edges of the paths are distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For each pair of interesting vertices count the number of distinct simple paths between them. As this number can be rather large, you should calculate it modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"). "}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n, m"},{"kind":"math_inline","text":"(2 ≤ n ≤ 105; 1 ≤ m ≤ 105)"},{"kind":"text","text":" — the number of vertices and edges in the graph, correspondingly. Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the description of the edges: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two space-separated integers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"math_inline","text":"(1 ≤ ai, bi ≤ n)"},{"kind":"text","text":" — the indexes of the vertices connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains a single integer "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(1 ≤ k ≤ 105)"},{"kind":"text","text":" — the number of pairs of interesting vertices. Next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contain the list of pairs of interesting vertices: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two space-separated numbers "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yi"},{"kind":"math_inline","text":"(1 ≤ xi, yi ≤ n; xi ≠ yi)"},{"kind":"text","text":" — the indexes of interesting vertices in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th pair."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given graph is a vertex cactus. It is guaranteed that the graph contains no loops or multiple edges. Consider the graph vertices are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines: in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print a single integer — the number of distinct simple ways, starting at "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and ending at "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":", modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 11\n1 2\n2 3\n3 4\n1 4\n3 5\n5 6\n8 6\n8 7\n7 6\n7 9\n9 10\n6\n1 2\n3 5\n6 9\n9 2\n9 3\n9 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n2\n2\n4\n4\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"231E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/231/problem/E"}