{"assets":[],"contentKind":"statement","contestId":"265","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Colorful Stones (Simplified Edition)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"There is a sequence of colorful stones. The color of each stone is one of red, green, or blue. You are given a string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th (1-based) character of "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" represents the color of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th stone. If the character is \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"\", or \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\", the color of the corresponding stone is red, green, or blue, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Initially Squirrel Liss is standing on the first stone. You perform instructions one or more times."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each instruction is one of the three types: \""},{"children":[{"kind":"text","text":"RED"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"GREEN"}],"kind":"container"},{"kind":"text","text":"\", or \""},{"children":[{"kind":"text","text":"BLUE"}],"kind":"container"},{"kind":"text","text":"\". After an instruction "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", if Liss is standing on a stone whose colors is "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", Liss will move one stone forward, else she will not move."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":". The number of instructions is equal to the length of "},{"kind":"math_inline","text":"t"},{"kind":"text","text":", and the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th character of "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" represents the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th instruction."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Calculate the final position of Liss (the number of the stone she is going to stand on in the end) after performing all the instructions, and print its 1-based position. It is guaranteed that Liss don't move out of the sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input contains two lines. The first line contains the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 50"},{"kind":"text","text":"). The second line contains the string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |t| ≤ 50"},{"kind":"text","text":"). The characters of each string will be one of \""},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"\", \""},{"children":[{"kind":"text","text":"G"}],"kind":"container"},{"kind":"text","text":"\", or \""},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":"\". It is guaranteed that Liss don't move out of the sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the final 1-based position of Liss in a single line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"RGB\nRRR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"RRRBGBRBBB\nBBBRR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"BRRBGBRGRBGRGRRGGBGBGBRGBRGRGGGRBRRRBRBBBGRRRGGBBB\nBBRBGGRGRGBBBRBGRBRBBBBRBRRRBGBBGBBRRBBGGRBRRBRGRB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"15\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"265A",