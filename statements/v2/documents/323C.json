{"assets":[],"contentKind":"statement","contestId":"323","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Two permutations"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"6 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two permutations "},{"kind":"math_inline","text":"p"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" elements, and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" queries of the form: "},{"kind":"math_inline","text":"l1, r1, l2, r2"},{"kind":"math_inline","text":"(l1 ≤ r1; l2 ≤ r2)"},{"kind":"text","text":". The response for the query is the number of such integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", that their position in the first permutation is in segment "},{"kind":"math_inline","text":"[l1, r1]"},{"kind":"text","text":" (borders included), and position in the second permutation is in segment "},{"kind":"math_inline","text":"[l2, r2]"},{"kind":"text","text":" (borders included too)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A "},{"children":[{"kind":"text","text":"permutation"}],"kind":"container"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" elements is the sequence of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers, each not less than "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and not greater than "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Position"}],"kind":"container"},{"kind":"text","text":" of number "},{"kind":"math_inline","text":"v"},{"kind":"math_inline","text":"(1 ≤ v ≤ n)"},{"kind":"text","text":" in permutation "},{"kind":"math_inline","text":"g1, g2, ..., gn"},{"kind":"text","text":" is such number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"gi = v"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer "},{"kind":"math_inline","text":"n (1 ≤ n ≤ 106)"},{"kind":"text","text":", the number of elements in both permutations. The following line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers, separated with spaces: "},{"kind":"math_inline","text":"p1, p2, ..., pn (1 ≤ pi ≤ n)"},{"kind":"text","text":". These are elements of the first permutation. The next line contains the second permutation "},{"kind":"math_inline","text":"q1, q2, ..., qn"},{"kind":"text","text":" in same format."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following line contains an integer "},{"kind":"math_inline","text":"m (1 ≤ m ≤ 2·105)"},{"kind":"text","text":", that is the number of queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain descriptions of queries one in a line. The description of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query consists of four integers: "},{"kind":"math_inline","text":"a, b, c, d (1 ≤ a, b, c, d ≤ n)"},{"kind":"text","text":". Query parameters "},{"kind":"math_inline","text":"l1, r1, l2, r2"},{"kind":"text","text":" are obtained from the numbers "},{"kind":"math_inline","text":"a, b, c, d"},{"kind":"text","text":" using the following algorithm: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Introduce variable "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". If it is the first query, then the variable equals "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", else it equals the response for the previous query plus one. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Introduce function "},{"kind":"math_inline","text":"f(z) = ((z - 1 + x) mod n) + 1"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Suppose "},{"kind":"math_inline","text":"l1 = min(f(a), f(b)), r1 = max(f(a), f(b)), l2 = min(f(c), f(d)), r2 = max(f(c), f(d))"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a response for each query in a separate line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n3 1 2\n3 2 1\n1\n1 2 3 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n4 3 2 1\n2 3 4 1\n3\n1 2 3 4\n1 3 2 1\n1 4 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"323C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/323/problem/C"}