{"assets":[],"contentKind":"statement","contestId":"1398","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Substring Removal Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Alice and Bob play a game. They have a binary string $$$s$$$ (a string such that each character in it is either $$$0$$$ or $$$1$$$). Alice moves first, then Bob, then Alice again, and so on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"During their move, the player can choose any number (not less than one) of "},{"children":[{"kind":"text","text":"consecutive equal characters"}],"kind":"container"},{"kind":"text","text":" in $$$s$$$ and delete them."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if the string is $$$10110$$$, there are $$$6$$$ possible moves (deleted characters are bold):"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" $$$\\textbf{1}0110 \\to 0110$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$1\\textbf{0}110 \\to 1110$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$10\\textbf{1}10 \\to 1010$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$101\\textbf{1}0 \\to 1010$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$10\\textbf{11}0 \\to 100$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$1011\\textbf{0} \\to 1011$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"After the characters are removed, the characters to the left and to the right of the removed block become adjacent. I. e. the following sequence of moves is valid: $$$10\\textbf{11}0 \\to 1\\textbf{00} \\to 1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The game ends when the string becomes empty, and the score of each player is "},{"children":[{"kind":"text","text":"the number of $$$1$$$-characters deleted by them"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each player wants to maximize their score. Calculate the resulting score of Alice."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$T$$$ ($$$1 \\le T \\le 500$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case contains exactly one line containing a binary string $$$s$$$ ($$$1 \\le |s| \\le 100$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print one integer — the resulting score of Alice (the number of $$$1$$$-characters deleted by her)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n01111001\n0000\n111111\n101010101\n011011110111\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n0\n6\n3\n6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Questions about the optimal strategy will be ignored."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1398B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1398/problem/B"}