{"assets":[],"contentKind":"statement","contestId":"1687","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Cute number"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Ran is especially skilled in computation and mathematics. It is said that she can do unimaginable calculation work in an instant."}],"kind":"container"},{"children":[{"kind":"text","text":"—"},{"children":[{"kind":"text","text":"Perfect Memento in Strict Sense"}],"kind":"container"}],"kind":"container"}],"kind":"container"},{"children":[{"kind":"text","text":"Ran Yakumo is a cute girl who loves creating cute Maths problems."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$f(x)$$$ be the minimal "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Square_number"},"children":[{"kind":"text","text":"square number"}],"kind":"link"},{"children":[{"kind":"text","text":"strictly"}],"kind":"container"},{"kind":"text","text":" greater than $$$x$$$, and $$$g(x)$$$ be the maximal square number less than or equal to $$$x$$$. For example, $$$f(1)=f(2)=g(4)=g(8)=4$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A positive integer $$$x$$$ is "},{"children":[{"kind":"text","text":"cute"}],"kind":"container"},{"kind":"text","text":" if $$$x-g(x) \\lt f(x)-x$$$. For example, $$$1,5,11$$$ are cute integers, while $$$3,8,15$$$ are not. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Ran gives you an array $$$a$$$ of length $$$n$$$. She wants you to find the smallest non-negative integer $$$k$$$ such that $$$a_i + k$$$ is a cute number for any element of $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$1 \\leq n \\leq 10^6$$$) — the length of $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ intergers $$$a_1,a_2,\\ldots,a_n$$$ ($$$1 \\leq a_1 \\leq a_2 \\leq \\ldots \\leq a_n \\leq 2\\cdot 10^6$$$) — the array $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single interger $$$k$$$ — the answer."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 3 8 10\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n2 3 8 9 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n8\n1 2 3 4 5 6 7 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n48\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Test case 1:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$3$$$ is not cute integer, so $$$k\\ne 0$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"$$$2,4,9,11$$$ are cute integers, so $$$k=1$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1687D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1687/problem/D"}