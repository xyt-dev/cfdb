{"assets":[],"contentKind":"statement","contestId":"169","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Chores"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya and Vasya are brothers. Today is a special day for them as their parents left them home alone and commissioned them to do "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" chores. Each chore is characterized by a single parameter — its complexity. The complexity of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th chore equals "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As Petya is older, he wants to take the chores with complexity larger than some value "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"hi > x"},{"kind":"text","text":") to leave to Vasya the chores with complexity less than or equal to "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"hi ≤ x"},{"kind":"text","text":"). The brothers have already decided that Petya will do exactly "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" chores and Vasya will do exactly "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" chores ("},{"kind":"math_inline","text":"a + b = n"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In how many ways can they choose an integer "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" so that Petya got exactly "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" chores and Vasya got exactly "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" chores?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first input line contains three integers "},{"kind":"math_inline","text":"n, a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2000"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"a, b ≥ 1"},{"kind":"text","text":"; "},{"kind":"math_inline","text":"a + b = n"},{"kind":"text","text":") — the total number of chores, the number of Petya's chores and the number of Vasya's chores."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains a sequence of integers "},{"kind":"math_inline","text":"h1, h2, ..., hn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ hi ≤ 109"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"hi"},{"kind":"text","text":" is the complexity of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th chore. The numbers in the given sequence are not necessarily different."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All numbers on the lines are separated by single spaces."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the required number of ways to choose an integer value of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". If there are no such ways, print "},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2 3\n6 2 3 100 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 3 4\n1 1 9 1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample the possible values of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" are 3, 4 or 5."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample it is impossible to find such "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", that Petya got 3 chores and Vasya got 4."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"169A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/169/problem/A"}