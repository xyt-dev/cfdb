{"assets":[],"contentKind":"statement","contestId":"1671","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Preorder"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a rooted tree of $$$2^n - 1$$$ vertices. Every vertex of this tree has either $$$0$$$ children, or $$$2$$$ children. All leaves of this tree have the same distance from the root, and for every non-leaf vertex, one of its children is the left one, and the other child is the right one. Formally, you are given a "},{"children":[{"kind":"text","text":"perfect binary tree"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The vertices of the tree are numbered in the following order:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the root has index $$$1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if a vertex has index $$$x$$$, then its left child has index $$$2x$$$, and its right child has index $$$2x+1$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Every vertex of the tree has a letter written on it, either "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":". Let's define the character on the vertex $$$x$$$ as $$$s_x$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let the "},{"children":[{"kind":"text","text":"preorder string"}],"kind":"container"},{"kind":"text","text":" of some vertex $$$x$$$ be defined in the following way:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if the vertex $$$x$$$ is a leaf, then the "},{"children":[{"kind":"text","text":"preorder string"}],"kind":"container"},{"kind":"text","text":" of $$$x$$$ be consisting of only one character $$$s_x$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" otherwise, the "},{"children":[{"kind":"text","text":"preorder string"}],"kind":"container"},{"kind":"text","text":" of $$$x$$$ is $$$s_x + f(l_x) + f(r_x)$$$, where $$$+$$$ operator defines concatenation of strings, $$$f(l_x)$$$ is the "},{"children":[{"kind":"text","text":"preorder string"}],"kind":"container"},{"kind":"text","text":" of the left child of $$$x$$$, and $$$f(r_x)$$$ is the "},{"children":[{"kind":"text","text":"preorder string"}],"kind":"container"},{"kind":"text","text":" of the right child of $$$x$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"preorder string"}],"kind":"container"},{"kind":"text","text":" of the tree is the "},{"children":[{"kind":"text","text":"preorder string"}],"kind":"container"},{"kind":"text","text":" of its root."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Now, for the problem itself..."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to calculate the number of different strings that can be obtained as the "},{"children":[{"kind":"text","text":"preorder string"}],"kind":"container"},{"kind":"text","text":" of the given tree, if you are allowed to perform the following operation any number of times before constructing the "},{"children":[{"kind":"text","text":"preorder string"}],"kind":"container"},{"kind":"text","text":" of the tree:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" choose any non-leaf vertex $$$x$$$, and swap its children (so, the left child becomes the right one, and vice versa). "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$n$$$ ($$$2 \\le n \\le 18$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains a sequence of $$$2^n-1$$$ characters $$$s_1, s_2, \\dots, s_{2^n-1}$$$. Each character is either "},{"children":[{"kind":"text","text":"A"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"B"}],"kind":"container"},{"kind":"text","text":". The characters are "},{"children":[{"kind":"text","text":"not separated"}],"kind":"container"},{"kind":"text","text":" by spaces or anything else."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the number of different strings that can be obtained as the "},{"children":[{"kind":"text","text":"preorder string"}],"kind":"container"},{"kind":"text","text":" of the given tree, if you can apply any number of operations described in the statement. Since it can be very large, print it modulo $$$998244353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nBAAAAAAAABBABAB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n16\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\nBAA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\nABA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\nAAB\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\nAAA\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1671E","schema":2,"sourceKind":"html","sourceUrl":"https://co