{"assets":[],"contentKind":"statement","contestId":"128","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Games with Rectangle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In this task Anna and Maria play the following game. Initially they have a checkered piece of paper with a painted "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":" rectangle (only the border, no filling). Anna and Maria move in turns and Anna starts. During each move one should paint inside the last-painted rectangle a new lesser rectangle (along the grid lines). The new rectangle should have no common points with the previous one. Note that when we paint a rectangle, we always paint only the border, the rectangles aren't filled."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Nobody wins the game — Anna and Maria simply play until they have done "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" moves in total. Count the number of different ways to play this game."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first and only line contains three integers: "},{"kind":"math_inline","text":"n, m, k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m, k ≤ 1000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the single number — the number of the ways to play the game. As this number can be very big, print the value modulo "},{"kind":"math_inline","text":"1000000007"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"9\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 7 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"75\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Two ways to play the game are considered different if the final pictures are different. In other words, if one way contains a rectangle that is not contained in the other way."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the first sample Anna, who performs her first and only move, has only one possible action plan — insert a "},{"kind":"math_inline","text":"1 × 1"},{"kind":"text","text":" square inside the given "},{"kind":"math_inline","text":"3 × 3"},{"kind":"text","text":" square."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample Anna has as much as 9 variants: 4 ways to paint a "},{"kind":"math_inline","text":"1 × 1"},{"kind":"text","text":" square, 2 ways to insert a "},{"kind":"math_inline","text":"1 × 2"},{"kind":"text","text":" rectangle vertically, 2 more ways to insert it horizontally and one more way is to insert a "},{"kind":"math_inline","text":"2 × 2"},{"kind":"text","text":" square."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"128C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/128/problem/C"}