{"assets":[],"contentKind":"statement","contestId":"915","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Physical Education Lessons"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"This year Alex has finished school, and now he is a first-year student of Berland State University. For him it was a total surprise that even though he studies programming, he still has to attend physical education lessons. The end of the term is very soon, but, unfortunately, Alex still hasn't attended a single lesson!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Since Alex doesn't want to get expelled, he wants to know the number of working days left until the end of the term, so he can attend physical education lessons during these days. But in BSU calculating the number of working days is a complicated matter:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days left before the end of the term (numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"), and initially all of them are working days. Then the university staff sequentially publishes "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" orders, one after another. Each order is characterised by three numbers "},{"kind":"math_inline","text":"l"},{"kind":"text","text":", "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"k = 1"},{"kind":"text","text":", then all days from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" (inclusive) become non-working days. If some of these days are made working days by some previous order, then these days still become non-working days; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If "},{"kind":"math_inline","text":"k = 2"},{"kind":"text","text":", then all days from "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" (inclusive) become working days. If some of these days are made non-working days by some previous order, then these days still become working days. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Alex to determine the number of working days left after each order!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", and the second line — one integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 109"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ q ≤ 3·105"},{"kind":"text","text":") — the number of days left before the end of the term, and the number of orders, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines follow, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line containing three integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" representing "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th order ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ki ≤ 2"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" integers. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them must be equal to the number of working days left until the end of the term after the first "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" orders are published."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n6\n1 2 1\n3 4 1\n2 3 2\n1 3 2\n2 4 1\n1 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n0\n2\n3\n1\n4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"915E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/915/problem/E"}