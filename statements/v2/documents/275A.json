{"assets":[],"contentKind":"statement","contestId":"275","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Lights Out"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Lenny is playing a game on a "},{"kind":"math_inline","text":"3 × 3"},{"kind":"text","text":" grid of lights. In the beginning of the game all lights are switched on. Pressing any of the lights will toggle it and all side-adjacent lights. The goal of the game is to switch all the lights off. We consider the toggling as follows: if the light was switched on then it will be switched off, if it was switched off then it will be switched on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Lenny has spent some time playing with the grid and by now he has pressed each light a certain number of times. Given the number of times each light is pressed, you have to print the current state of each light."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The input consists of three rows. Each row contains three integers each between 0 to 100 inclusive. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th number in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row is the number of times the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th light of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row of the grid is pressed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print three lines, each containing three characters. The "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th character of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line is \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\" if and only if the corresponding light is switched on, otherwise it's \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 0 0\n0 0 0\n0 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"001\n010\n100\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 0 1\n8 8 8\n2 0 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"010\n011\n100\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"275A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/275/problem/A"}