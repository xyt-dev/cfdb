{"assets":[],"contentKind":"statement","contestId":"198","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Cube Snake"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got an "},{"kind":"math_inline","text":"n × n × n"},{"kind":"text","text":" cube, split into unit cubes. Your task is to number all unit cubes in this cube with positive integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n3"},{"kind":"text","text":" so that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" each number was used as a cube's number exactly once; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for each "},{"kind":"math_inline","text":"1 ≤ i < n3"},{"kind":"text","text":", unit cubes with numbers "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" were neighbouring (that is, shared a side); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for each "},{"kind":"math_inline","text":"1 ≤ i < n"},{"kind":"text","text":" there were at least two different subcubes with sizes "},{"kind":"math_inline","text":"i × i × i"},{"kind":"text","text":", made from unit cubes, which are numbered with consecutive numbers. That is, there are such two numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", that the unit cubes of the first subcube are numbered by numbers "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"x + 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"x + i3 - 1"},{"kind":"text","text":", and the unit cubes of the second subcube are numbered by numbers "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", "},{"kind":"math_inline","text":"y + 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"y + i3 - 1"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Find and print the required numeration of unit cubes of the cube."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50"},{"kind":"text","text":") — the size of the cube, whose unit cubes need to be numbered."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print all layers of the cube as "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" matrices. Separate them with new lines. Print the layers in the order in which they follow in the cube. See the samples for clarifications. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there always is a solution that meets the conditions given in the problem statement."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 4 17 \n2 3 18 \n27 26 19 \n\n8 5 16 \n7 6 15 \n24 25 20 \n\n9 12 13 \n10 11 14 \n23 22 21 \n\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the sample the cubes with sizes "},{"kind":"math_inline","text":"2 × 2 × 2"},{"kind":"text","text":" are numbered with integers "},{"kind":"math_inline","text":"1, ..., 8"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"5, ..., 12"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"198D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/198/problem/D"}