{"assets":["/statement-assets/d8f6ec224f651061084611db61e7f58d51bc08fc5ccdbfecb7f08683f5cae831.png"],"contentKind":"statement","contestId":"1494","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Berland Crossword"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Berland crossword is a puzzle that is solved on a square grid with $$$n$$$ rows and $$$n$$$ columns. Initially all the cells are white."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To solve the puzzle one has to color some cells on the border of the grid black in such a way that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" exactly $$$U$$$ cells in the top row are black; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" exactly $$$R$$$ cells in the rightmost column are black; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" exactly $$$D$$$ cells in the bottom row are black; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" exactly $$$L$$$ cells in the leftmost column are black. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that you can color zero cells black and leave every cell white."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to check if there exists a solution to the given puzzle."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of testcases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then the descriptions of $$$t$$$ testcases follow."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each testcase contains $$$5$$$ integers $$$n, U, R, D, L$$$ ($$$2 \\le n \\le 100$$$; $$$0 \\le U, R, D, L \\le n$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each testcase print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" if the solution exists and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may print every letter in any case you want (so, for example, the strings "},{"children":[{"kind":"text","text":"yEs"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"yes"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"Yes"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" are all recognized as positive answer)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n5 2 5 3 1\n3 0 0 0 0\n4 4 1 4 0\n2 1 1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nYES\nNO\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Here are possible solutions to testcases $$$1$$$, $$$2$$$ and $$$4$$$: "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/d8f6ec224f651061084611db61e7f58d51bc08fc5ccdbfecb7f08683f5cae831.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1494B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1494/problem/B"}