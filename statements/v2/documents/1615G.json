{"assets":[],"contentKind":"statement","contestId":"1615","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Maximum Adjacent Pairs"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array $$$a$$$ consisting of $$$n$$$ non-negative integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to replace each $$$0$$$ in $$$a$$$ with an integer from $$$1$$$ to $$$n$$$ (different elements equal to $$$0$$$ can be replaced by different integers)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"children":[{"kind":"text","text":"value"}],"kind":"container"},{"kind":"text","text":" of the array you obtain is the number of integers $$$k$$$ from $$$1$$$ to $$$n$$$ such that the following condition holds: there exist a pair of adjacent elements equal to $$$k$$$ (i. e. there exists some $$$i \\in [1, n - 1]$$$ such that $$$a_i = a_{i + 1} = k$$$). If there are multiple such pairs for some integer $$$k$$$, this integer is counted in the "},{"children":[{"kind":"text","text":"value"}],"kind":"container"},{"kind":"text","text":" only once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to obtain the array with the maximum possible "},{"children":[{"kind":"text","text":"value"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"hea