{"assets":[],"contentKind":"statement","contestId":"1463","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Find The Array"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array $$$[a_1, a_2, \\dots, a_n]$$$ such that $$$1 \\le a_i \\le 10^9$$$. Let $$$S$$$ be the sum of all elements of the array $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call an array $$$b$$$ of $$$n$$$ integers "},{"children":[{"kind":"text","text":"beautiful"}],"kind":"container"},{"kind":"text","text":" if:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1 \\le b_i \\le 10^9$$$ for each $$$i$$$ from $$$1$$$ to $$$n$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" for every pair of adjacent integers from the array $$$(b_i, b_{i + 1})$$$, either $$$b_i$$$ divides $$$b_{i + 1}$$$, or $$$b_{i + 1}$$$ divides $$$b_i$$$ (or both); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$2 \\sum \\limits_{i = 1}^{n} |a_i - b_i| \\le S$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Your task is to find any beautiful array. It can be shown that at least one beautiful array always exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two lines. The first line contains one integer $$$n$$$ ($$$2 \\le n \\le 50$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$1 \\le a_i \\le 10^9$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the beautiful array $$$b_1, b_2, \\dots, b_n$$$ ($$$1 \\le b_i \\le 10^9$$$) on a separate line. It can be shown that at least one beautiful array exists under these circumstances. If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n5\n1 2 3 4 5\n2\n4 6\n2\n1 1000000000\n6\n3 4 8 1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3 3 3 3 3\n3 6\n1 1000000000\n4 4 8 1 3 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1463B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1463/problem/B"}