{"assets":["/statement-assets/257b69ed12b8fdede7f22c55dd7398014491119ba07c41ac051aa49a43ee7f24.png","/statement-assets/cc3b8d9ab84b22c66a9e5a058f3d57a13096be3ffccc05ef4703e562ea383f1a.png","/statement-assets/85060d08b00d54d630a16f3ec288c2c09bc1d809605b0c91bb605deecc57510f.png","/statement-assets/b1f043dfbf858d495877a3cf438a4529c2d5f1e1193a3584e7c0b3c14d1926cd.png"],"contentKind":"statement","contestId":"528","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Triangles 3000"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a set "},{"kind":"math_inline","text":"L = {l1, l2, ..., ln}"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" pairwise non-parallel lines on the Euclidean plane. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line is given by an equation in the form of "},{"kind":"math_inline","text":"aix + biy = ci"},{"kind":"text","text":". "},{"kind":"math_inline","text":"L"},{"kind":"text","text":" doesn't contain three lines coming through the same point. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A subset of three distinct lines is chosen equiprobably. Determine the expected value of the area of the triangle formed by the three lines."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 3000"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next lines contains three integers "},{"kind":"math_inline","text":"ai, bi, ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 100 ≤ ai, bi ≤ 100"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ai2 + bi2 > 0"},{"kind":"text","text":", "},{"kind":"math_inline","text":" - 10 000 ≤ ci ≤ 10 000"},{"kind":"text","text":") — the coefficients defining the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that no two lines are parallel. Besides, any two lines intersect at angle at least "},{"kind":"math_inline","text":"10 - 4"},{"kind":"text","text":" radians. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If we assume that "},{"kind":"math_inline","text":"I"},{"kind":"text","text":" is a set of points of pairwise intersection of the lines (i. e. "},{"attrs":{"alt":"","src":"/statement-assets/257b69ed12b8fdede7f22c55dd7398014491119ba07c41ac051aa49a43ee7f24.png"},"kind":"image"},{"kind":"text","text":"), then for any point "},{"attrs":{"alt":"","src":"/statement-assets/cc3b8d9ab84b22c66a9e5a058f3d57a13096be3ffccc05ef4703e562ea383f1a.png"},"kind":"image"},{"kind":"text","text":" it is true that the coordinates of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" do not exceed "},{"kind":"math_inline","text":"106"},{"kind":"text","text":" by their absolute values. Also, for any two distinct points "},{"attrs":{"alt":"","src":"/statement-assets/85060d08b00d54d630a16f3ec288c2c09bc1d809605b0c91bb605deecc57510f.png"},"kind":"image"},{"kind":"text","text":" the distance between "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is no less than "},{"kind":"math_inline","text":"10 - 5"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single real number equal to the sought expected value. Your answer will be checked with the absolute or relative error "},{"kind":"math_inline","text":"10 - 4"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 0 0\n0 1 0\n1 1 2\n-1 1 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1.25"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"A sample from the statement is shown below. There are four triangles on the plane, their areas are "},{"kind":"math_inline","text":"0.25, 0.5, 2, 2.25"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b1f043dfbf858d495877a3cf438a4529c2d5f1e1193a3584e7c0b3c14d1926cd.png"},"kind":"image"}],"kind":"container"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"528E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/528/problem/E"}