{"assets":["/statement-assets/74526521453fe5486f65489b1eafc9206b0a98ca44cd77c089b6609bad0cc145.png","/statement-assets/7b983f7b916015c062c19824a754bd1069a87cf1f5e100b569c9a86ad8603302.png","/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"],"contentKind":"statement","contestId":"460","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Little Victor and Set"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Little Victor adores the sets theory. Let us remind you that a set is a group of numbers where all numbers are pairwise distinct. Today Victor wants to find a set of integers "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" that has the following properties:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" for all "},{"kind":"math_inline","text":"x"},{"attrs":{"alt":"","src":"/statement-assets/74526521453fe5486f65489b1eafc9206b0a98ca44cd77c089b6609bad0cc145.png"},"kind":"image"},{"kind":"text","text":" the following inequality holds "},{"kind":"math_inline","text":"l ≤ x ≤ r"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"1 ≤ |S| ≤ k"},{"kind":"text","text":"; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" lets denote the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th element of the set "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" as "},{"kind":"math_inline","text":"si"},{"kind":"text","text":"; value "},{"attrs":{"alt":"","src":"/statement-assets/7b983f7b916015c062c19824a754bd1069a87cf1f5e100b569c9a86ad8603302.png"},"kind":"image"},{"kind":"text","text":" must be as small as possible. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Victor find the described set."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three space-separated integers "},{"kind":"math_inline","text":"l, r, k"},{"kind":"math_inline","text":"(1 ≤ l ≤ r ≤ 1012; 1 ≤ k ≤ min(106, r - l + 1))"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum possible value of "},{"kind":"math_inline","text":"f(S)"},{"kind":"text","text":". Then print the cardinality of set "},{"kind":"math_inline","text":"|S|"},{"kind":"text","text":". Then print the elements of the set in any order."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple optimal sets, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 15 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n10 11\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 30 7\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n5\n14 9 28 11 16\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"Operation "},{"attrs":{"alt":"","src":"/statement-assets/6894c188dd94ebc29f4ee06df91088a04e5a1bf83c1b5515d31e628ade9fdb60.png"},"kind":"image"},{"kind":"text","text":" represents the operation of bitwise exclusive OR. In other words, it is the XOR operation."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"460D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/460/problem/D"}