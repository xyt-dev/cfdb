{"assets":[],"contentKind":"statement","contestId":"339","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Three Swaps"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Xenia the horse breeder has "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(n > 1)"},{"kind":"text","text":" horses that stand in a row. Each horse has its own unique number. Initially, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th left horse has number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". That is, the sequence of numbers of horses in a row looks as follows (from left to right): 1, 2, 3, "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Xenia trains horses before the performance. During the practice sessions, she consistently gives them commands. Each command is a pair of numbers "},{"kind":"math_inline","text":"l, r"},{"kind":"math_inline","text":"(1 ≤ l < r ≤ n)"},{"kind":"text","text":". The command "},{"kind":"math_inline","text":"l, r"},{"kind":"text","text":" means that the horses that are on the "},{"kind":"math_inline","text":"l"},{"kind":"text","text":"-th, "},{"kind":"math_inline","text":"(l + 1)"},{"kind":"text","text":"-th, "},{"kind":"math_inline","text":"(l + 2)"},{"kind":"text","text":"-th, "},{"kind":"math_inline","text":"..."},{"kind":"text","text":", "},{"kind":"math_inline","text":"r"},{"kind":"text","text":"-th places from the left must be rearranged. The horses that initially stand on the "},{"kind":"math_inline","text":"l"},{"kind":"text","text":"-th and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":"-th places will swap. The horses on the "},{"kind":"math_inline","text":"(l + 1)"},{"kind":"text","text":"-th and "},{"kind":"math_inline","text":"(r - 1)"},{"kind":"text","text":"-th places will swap. The horses on the "},{"kind":"math_inline","text":"(l + 2)"},{"kind":"text","text":"-th and "},{"kind":"math_inline","text":"(r - 2)"},{"kind":"text","text":"-th places will swap and so on. In other words, the horses that were on the segment "},{"kind":"math_inline","text":"[l, r]"},{"kind":"text","text":" change their order to the reverse one."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, if Xenia commanded "},{"kind":"math_inline","text":"l = 2, r = 5"},{"kind":"text","text":", and the sequence of numbers of horses before the command looked as (2, 1, 3, 4, 5, 6), then after the command the sequence will be (2, 5, 4, 3, 1, 6)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We know that during the practice Xenia gave at most three commands of the described form. You have got the final sequence of numbers of horses by the end of the practice. Find what commands Xenia gave during the practice. Note that you do not need to minimize the number of commands in the solution, find any valid sequence of at most three commands."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(2 ≤ n ≤ 1000)"},{"kind":"text","text":" — the number of horses in the row. The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"math_inline","text":"(1 ≤ ai ≤ n)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the number of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th left horse in the row after the practice."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line should contain integer "},{"kind":"math_inline","text":"k"},{"kind":"math_inline","text":"(0 ≤ k ≤ 3)"},{"kind":"text","text":" — the number of commads Xenia gave during the practice. In each of the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines print two integers. In the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line print numbers "},{"kind":"math_inline","text":"li, ri"},{"kind":"math_inline","text":"(1 ≤ li < ri ≤ n)"},{"kind":"text","text":" — Xenia's "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th command during the practice."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that a solution exists. If there are several solutions, you are allowed to print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 4 3 2 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n2 1 4 3 6 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n3 4\n5 6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"339E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/339/problem/E"}