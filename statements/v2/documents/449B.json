{"assets":[],"contentKind":"statement","contestId":"449","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Jzzhu and Cities"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Jzzhu is the president of country A. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" in his country. City "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" is the capital of A. Also there are "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" roads connecting the cities. One can go from city "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" (and vise versa) using the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th road, the length of this road is "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". Finally, there are "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" train routes in the country. One can use the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th train route to go from capital of the country to city "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" (and vise versa), the length of this route is "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Jzzhu doesn't want to waste the money of the country, so he is going to close some of the train routes. Please tell Jzzhu the maximum number of the train routes which can be closed under the following condition: the length of the shortest path from every city to the capital mustn't change."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n, m, k"},{"kind":"math_inline","text":"(2 ≤ n ≤ 105; 1 ≤ m ≤ 3·105; 1 ≤ k ≤ 105)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains three integers "},{"kind":"math_inline","text":"ui, vi, xi"},{"kind":"math_inline","text":"(1 ≤ ui, vi ≤ n; ui ≠ vi; 1 ≤ xi ≤ 109)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yi"},{"kind":"math_inline","text":"(2 ≤ si ≤ n; 1 ≤ yi ≤ 109)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that there is at least one way from every city to the capital. Note, that there can be multiple roads between two cities. Also, there can be multiple routes going to the same city from the capital."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer representing the maximum number of the train routes which can be closed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5 3\n1 2 1\n2 3 2\n1 3 3\n3 4 4\n1 5 5\n3 5\n4 5\n5 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2 3\n1 2 2\n2 1 3\n2 1\n2 2\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"449B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/449/problem/B"}