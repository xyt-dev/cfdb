{"assets":[],"contentKind":"statement","contestId":"1144","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Parity Alternated Deletions"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp has an array $$$a$$$ consisting of $$$n$$$ integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He wants to play a game with this array. The game consists of several moves. On the first move he chooses any element and deletes it (after the first move the array contains $$$n-1$$$ elements). For each of the next moves he chooses any element with the only restriction: its parity should differ from the parity of the element deleted on the previous move. In other words, he alternates parities (even-odd-even-odd-... or odd-even-odd-even-...) of the removed elements. Polycarp stops if he can't make a move."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If it is the first move, he chooses any element and deletes it; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If it is the second or any next move: "},{"attrs":{"ordered":false},"kind":"list"}],"kind":"list_item"},{"children":[{"kind":"text","text":" if the last deleted element was "},{"children":[{"kind":"text","text":"odd"}],"kind":"container"},{"kind":"text","text":", Polycarp chooses any "},{"children":[{"kind":"text","text":"even"}],"kind":"container"},{"kind":"text","text":" element and deletes it; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if the last deleted element was "},{"children":[{"kind":"text","text":"even"}],"kind":"container"},{"kind":"text","text":", Polycarp chooses any "},{"children":[{"kind":"text","text":"odd"}],"kind":"container"},{"kind":"text","text":" element and deletes it. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":" If after some move Polycarp cannot make a move, the game ends. "}],"kind":"list_item"},{"children":[{"kind":"text","text":"Polycarp's goal is to "},{"children":[{"kind":"text","text":"minimize"}],"kind":"container"},{"kind":"text","text":" the sum of "},{"children":[{"kind":"text","text":"non-deleted"}],"kind":"container"},{"kind":"text","text":" elements of the array after end of the game. If Polycarp can delete the whole array, then the sum of "},{"children":[{"kind":"text","text":"non-deleted"}],"kind":"container"},{"kind":"text","text":" elements is zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Help Polycarp find this value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains one integer $$$n$$$ ($$$1 \\le n \\le 2000$$$) — the number of elements of $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line of the input contains $$$n$$$ integers $$$a_1, a_2, \\dots, a_n$$$ ($$$0 \\le a_i \\le 10^6$$$), where $$$a_i$$$ is the $$$i$$$-th element of $$$a$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the "},{"children":[{"kind":"text","text":"minimum"}],"kind":"container"},{"kind":"text","text":" possible sum of "},{"children":[{"kind":"text","text":"non-deleted"}],"kind":"container"},{"kind":"text","text":" elements of the array after end of the game."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5\n1 5 7 8 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6\n5 1 2 4 6 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n1000000 1000000\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n1000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"1144B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1144/problem/B"}