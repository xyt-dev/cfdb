{"assets":["/statement-assets/1ec5bd237767aaedf896475992cf9f21480f994c1ef1b275c23f0e7568f737ac.png","/statement-assets/a72ac663c82c4f004aa7fde704d76f50836d09a1d771db9e5e3a632e08089cc8.png"],"contentKind":"statement","contestId":"938","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Buy a Ticket"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Musicians of a popular band \"Flayer\" have announced that they are going to \"make their exit\" with a world tour. Of course, they will visit Berland as well."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cities in Berland. People can travel between cities using two-directional train routes; there are exactly "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" routes, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th route can be used to go from city "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" (and from "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":"), and it costs "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" coins to use this route."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each city will be visited by \"Flayer\", and the cost of the concert ticket in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th city is "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" coins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have friends in every city of Berland, and they, knowing about your programming skills, asked you to calculate the minimum possible number of coins they have to pay to visit the concert. For every city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" you have to compute the minimum number of coins a person from city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has to spend to travel to some city "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" (or possibly stay in city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"), attend a concert there, and return to city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" (if "},{"kind":"math_inline","text":"j ≠ i"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, for every "},{"attrs":{"alt":"","src":"/statement-assets/1ec5bd237767aaedf896475992cf9f21480f994c1ef1b275c23f0e7568f737ac.png"},"kind":"image"},{"kind":"text","text":" you have to calculate "},{"attrs":{"alt":"","src":"/statement-assets/a72ac663c82c4f004aa7fde704d76f50836d09a1d771db9e5e3a632e08089cc8.png"},"kind":"image"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"d(i, j)"},{"kind":"text","text":" is the minimum number of coins you have to spend to travel from city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to city "},{"kind":"math_inline","text":"j"},{"kind":"text","text":". If there is no way to reach city "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" from city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", then we consider "},{"kind":"math_inline","text":"d(i, j)"},{"kind":"text","text":" to be infinitely large."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2·105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ m ≤ 2·105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines follow, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th contains three integers "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ui"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"wi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ vi, ui ≤ n, vi ≠ ui"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ wi ≤ 1012"},{"kind":"text","text":") denoting "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th train route. There are no multiple train routes connecting the same pair of cities, that is, for each "},{"kind":"math_inline","text":"(v, u)"},{"kind":"text","text":" neither extra "},{"kind":"math_inline","text":"(v, u)"},{"kind":"text","text":" nor "},{"kind":"math_inline","text":"(u, v)"},{"kind":"text","text":" present in input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ... ak"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 1012"},{"kind":"text","text":") — price to attend the concert in "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th city."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them must be equal to the minimum number of coins a person from city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has to spend to travel to some city "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" (or possibly stay in city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"), attend a concert there, and return to city "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" (if "},{"kind":"math_inline","text":"j ≠ i"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n1 2 4\n2 3 7\n6 20 1 25\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6 14 1 25 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 3\n1 2 1\n2 3 1\n1 3 1\n30 10 20\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12 10 12 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"938D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/938/problem/D"}