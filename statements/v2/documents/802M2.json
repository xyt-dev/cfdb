{"assets":["/statement-assets/5cf14ac3259d525ba71b99147fcd9633e8df1c1a88c07e5c0ce9d2f9f5774c5f.png","/statement-assets/179bd68b53847f7132961e2e556d0c4610298bad0deb7bfcc58f0c5da696d044.png"],"contentKind":"statement","contestId":"802","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"M2. April Fools' Problem (medium)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"The marmots need to prepare "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" problems for HC"},{"kind":"math_inline","text":"2"},{"kind":"text","text":" over "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" days. Each problem, once prepared, also has to be printed."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The preparation of a problem on day "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" (at most one per day) costs "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" CHF, and the printing of a problem on day "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" (also at most one per day) costs "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" CHF. Of course, a problem cannot be printed before it has been prepared (but doing both on the same day is fine)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum cost of preparation and printing?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains two space-separated integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 2200"},{"kind":"text","text":"). The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, ..., an"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/5cf14ac3259d525ba71b99147fcd9633e8df1c1a88c07e5c0ce9d2f9f5774c5f.png"},"kind":"image"},{"kind":"text","text":") — the preparation costs. The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"b1, ..., bn"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/179bd68b53847f7132961e2e556d0c4610298bad0deb7bfcc58f0c5da696d044.png"},"kind":"image"},{"kind":"text","text":") — the printing costs."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the minimum cost of preparation and printing "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" problems — that is, the minimum possible sum "},{"kind":"math_inline","text":"ai1 + ai2 + ... + aik + bj1 + bj2 + ... + bjk"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"1 ≤ i1 < i2 < ... < ik ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ j1 < j2 < ... < jk ≤ n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"i1 ≤ j1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"i2 ≤ j2"},{"kind":"text","text":", ..., "},{"kind":"math_inline","text":"ik ≤ jk"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 4\n3 8 7 9 9 4 6 8\n2 5 9 4 3 8 9 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"32"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the sample testcase, one optimum solution is to prepare the first problem on day "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and print it on day "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", prepare the second problem on day "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and print it on day "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", prepare the third problem on day "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and print it on day "},{"kind":"math_inline","text":"5"},{"kind":"text","text":", and prepare the fourth problem on day "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" and print it on day "},{"kind":"math_inline","text":"8"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"M2","problemCode":"802M2","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/802/problem/M2"}