{"assets":[],"contentKind":"statement","contestId":"819","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Mister B and Flight to the Moon"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"In order to fly to the Moon Mister B just needs to solve the following problem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is a complete indirected graph with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices. You need to cover it with several simple cycles of length "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" so that each edge is in exactly "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" cycles."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We are sure that Mister B will solve the problem soon and will fly to the Moon. Will you?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 300"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there is no answer, print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, in the first line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n2"},{"kind":"text","text":") — the number of cycles in your solution."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In each of the next "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines print description of one cycle in the following format: first print integer "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ m ≤ 4"},{"kind":"text","text":") — the length of the cycle, then print "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"v1, v2, ..., vm"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ vi ≤ n"},{"kind":"text","text":") — the vertices in the cycle in the traverse order. Each edge should be in exactly two cycles."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n3 1 2 3\n3 1 2 3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6\n3 5 4 2\n3 3 1 5\n4 4 5 2 3\n4 4 3 2 1\n3 4 2 1\n3 3 1 5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"819E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/819/problem/E"}