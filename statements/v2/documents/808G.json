{"assets":[],"contentKind":"statement","contestId":"808","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Anthem of Berland"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Berland has a long and glorious history. To increase awareness about it among younger citizens, King of Berland decided to compose an anthem."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Though there are lots and lots of victories in history of Berland, there is the one that stand out the most. King wants to mention it in the anthem as many times as possible."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He has already composed major part of the anthem and now just needs to fill in some letters. King asked you to help him with this work."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The anthem is the string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" of no more than "},{"kind":"math_inline","text":"105"},{"kind":"text","text":" small Latin letters and question marks. The most glorious victory is the string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" of no more than "},{"kind":"math_inline","text":"105"},{"kind":"text","text":" small Latin letters. You should replace all the question marks with small Latin letters in such a way that the number of occurrences of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" is maximal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that the occurrences of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" in "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" can overlap. Check the third example for clarification."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains string of small Latin letters and question marks "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |s| ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains string of small Latin letters "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ |t| ≤ 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Product of lengths of strings "},{"kind":"math_inline","text":"|s|·|t|"},{"kind":"text","text":" won't exceed "},{"kind":"math_inline","text":"107"},{"kind":"text","text":"."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the maximum number of occurrences of string "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" you can achieve by replacing all the question marks in string "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" with small Latin letters."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","te