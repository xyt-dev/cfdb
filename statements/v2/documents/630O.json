{"assets":["/statement-assets/c72c3116aba94ae9cc7a80af3ee75c1e9a4c6b9bb8a79e8bbb8721c7c17f1f85.png"],"contentKind":"statement","contestId":"630","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"O. Arrow"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"0.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"64 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Petya has recently started working as a programmer in the IT city company that develops computer games."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Besides game mechanics implementation to create a game it is necessary to create tool programs that can be used by game designers to create game levels. Petya's first assignment is to create a tool that allows to paint different arrows on the screen."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A user of this tool will choose a point on the screen, specify a vector (the arrow direction) and vary several parameters to get the required graphical effect. In the first version of the program Petya decided to limit parameters of the arrow by the following: a point with coordinates "},{"kind":"math_inline","text":"(px, py)"},{"kind":"text","text":", a nonzero vector with coordinates "},{"kind":"math_inline","text":"(vx, vy)"},{"kind":"text","text":", positive scalars "},{"kind":"math_inline","text":"a, b, c, d, a > c"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The produced arrow should have the following properties. The arrow consists of a triangle and a rectangle. The triangle is isosceles with base of length "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and altitude of length "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" perpendicular to the base. The rectangle sides lengths are "},{"kind":"math_inline","text":"c"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":". Point "},{"kind":"math_inline","text":"(px, py)"},{"kind":"text","text":" is situated in the middle of the triangle base and in the middle of side of rectangle that has length "},{"kind":"math_inline","text":"c"},{"kind":"text","text":". Area of intersection of the triangle and the rectangle is zero. The direction from "},{"kind":"math_inline","text":"(px, py)"},{"kind":"text","text":" point to the triangle vertex opposite to base containing the point coincides with direction of "},{"kind":"math_inline","text":"(vx, vy)"},{"kind":"text","text":" vector."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Enumerate the arrow points coordinates in counter-clockwise order starting from the tip."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/c72c3116aba94ae9cc7a80af3ee75c1e9a4c6b9bb8a79e8bbb8721c7c17f1f85.png"},"kind":"image"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line of the input contains eight integers "},{"kind":"math_inline","text":"px, py, vx, vy"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 1000 ≤ px, py, vx, vy ≤ 1000, vx2 + vy2 > 0"},{"kind":"text","text":"), "},{"kind":"math_inline","text":"a, b, c, d"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b, c, d ≤ 1000, a > c"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output coordinates of the arrow points in counter-clockwise order. Each line should contain two coordinates, first "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"y"},{"kind":"text","text":". Relative or absolute error should not be greater than "},{"kind":"math_inline","text":"10 - 9"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8 8 0 2 8 3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"8.000000000000 11.000000000000\n4.000000000000 8.000000000000\n6.000000000000 8.000000000000\n6.000000000000 3.000000000000\n10.000000000000 3.000000000000\n10.000000000000 8.000000000000\n12.000000000000 8.000000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"O","problemCode":"630O","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/630/problem/O"}