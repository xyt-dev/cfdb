{"assets":[],"contentKind":"statement","contestId":"75","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Modified GCD"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Well, here is another math class task. In mathematics, GCD is the greatest common divisor, and it's an easy task to calculate the GCD between two positive integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A common divisor for two positive numbers is a number which both numbers are divisible by."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"But your teacher wants to give you a harder task, in this task you have to find the greatest common divisor "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" between two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" that is in a given range from "},{"kind":"math_inline","text":"low"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"high"},{"kind":"text","text":" (inclusive), i.e. "},{"kind":"math_inline","text":"low ≤ d ≤ high"},{"kind":"text","text":". It is possible that there is no common divisor in the given range."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You will be given the two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" queries. Each query is a range from "},{"kind":"math_inline","text":"low"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"high"},{"kind":"text","text":" and you have to answer each query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", the two integers as described above ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ 109"},{"kind":"text","text":"). The second line contains one integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", the number of queries ("},{"kind":"math_inline","text":"1 ≤ n ≤ 104"},{"kind":"text","text":"). Then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines follow, each line contains one query consisting of two integers, "},{"kind":"math_inline","text":"low"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"high"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ low ≤ high ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should contain the result of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th query in the input. If there is no common divisor in the given range for any query, you should print "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" as a result for this query."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"9 27\n3\n1 5\n10 11\n9 11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n-1\n9\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"75C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/75/problem/C"}