{"assets":[],"contentKind":"statement","contestId":"2069","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Was there an Array?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"For an array of integers $$$a_1, a_2, \\dots, a_n$$$, we define its "},{"children":[{"kind":"text","text":"equality characteristic"}],"kind":"container"},{"kind":"text","text":" as the array $$$b_2, b_3, \\dots, b_{n-1}$$$, where $$$b_i = 1$$$ if the $$$i$$$-th element of the array $$$a$$$ is equal to both of its neighbors, and $$$b_i = 0$$$ if the $$$i$$$-th element of the array $$$a$$$ is not equal to at least one of its neighbors."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For example, for the array $$$[1, 2, 2, 2, 3, 3, 4, 4, 4, 4]$$$, the equality characteristic will be $$$[0, 1, 0, 0, 0, 0, 1, 1]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given the array $$$b_2, b_3, \\dots, b_{n-1}$$$. Your task is to determine whether there exists such an array $$$a$$$ for which the given array is the equality characteristic."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains one integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case consists of two lines:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the first line contains one integer $$$n$$$ ($$$3 \\le n \\le 100$$$); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the second line contains $$$n-2$$$ integers $$$b_2, b_3, \\dots, b_{n-1}$$$ ($$$0 \\le b_i \\le 1$$$). "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, output "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" if the array $$$a$$$ exists, or "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" if such an array does not exist. Each letter can be printed in any case."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n10\n0 1 0 0 0 0 1 1\n3\n1\n10\n0 1 0 1 1 0 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\nYES\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, the array $$$a = [1, 2, 2, 2, 3, 3, 4, 4, 4, 4]$$$ is suitable."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, the array $$$a = [7, 7, 7]$$$ is suitable."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"2069A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2069/problem/A"}