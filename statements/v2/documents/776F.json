{"assets":[],"contentKind":"statement","contestId":"776","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Sherlock's bet to Moriarty"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Sherlock met Moriarty for a final battle of wits. He gave him a regular "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" sided convex polygon. In addition to it, he gave him certain diagonals to form regions on the polygon. It was guaranteed that the diagonals did not intersect in interior points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He took each of the region and calculated its importance value. Importance value for a region formed by vertices "},{"kind":"math_inline","text":"a1, a2, ... , ax"},{"kind":"text","text":" of the polygon will be given by "},{"kind":"math_inline","text":"2a1 + 2a2 + ... + 2ax"},{"kind":"text","text":". Then, he sorted these regions on the basis of their importance value in ascending order. After that he assigned each region an index from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is the number of regions, and index of region is its position in the sorted array calculated above."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He wants Moriarty to color the regions using not more than "},{"kind":"math_inline","text":"20"},{"kind":"text","text":" colors, such that two regions have same color only if all the simple paths between these two regions have at least one region with color value less than the color value assigned to these regions. Simple path between two regions "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"h"},{"kind":"text","text":" is a sequence of regions "},{"kind":"math_inline","text":"r1, r2, ... rt"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"r1 = f"},{"kind":"text","text":", "},{"kind":"math_inline","text":"rt = h"},{"kind":"text","text":", for each "},{"kind":"math_inline","text":"1 ≤ i < t"},{"kind":"text","text":" regions "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri + 1"},{"kind":"text","text":" share an edge, and "},{"kind":"math_inline","text":"ri = rj"},{"kind":"text","text":" if and only if "},{"kind":"math_inline","text":"i = j"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Moriarty couldn't answer and asks Sherlock to solve it himself. Help Sherlock in doing so."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"3 ≤ n ≤ 100000"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ m ≤ n - 3"},{"kind":"text","text":"), the number of vertices in the polygon and the number of diagonals added."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a, b ≤ n"},{"kind":"text","text":"), describing a diagonal between vertices "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". It is guaranteed that the diagonals are correct, i. e. "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" don't coincide and are not neighboring. It is guaranteed that the diagonals do not intersect."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Let the number of regions be "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Output "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" space-separated integers, each between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"20"},{"kind":"text","text":", representing the colors of the regions in the order of increasing importance."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any of them. It can be shown that at least one answer exists."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 1\n1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 3\n1 3\n1 4\n1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2 1 2 3\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In 2nd input, regions formed in order after sorting will be "},{"kind":"math_inline","text":"(1, 2, 3)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 3, 4)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 4, 5)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(1, 5, 6)"},{"kind":"text","text":", i.e, region "},{"kind":"math_inline","text":"(1, 2, 3)"},{"kind":"text","text":" is first region followed by region "},{"kind":"math_inline","text":"(1, 3, 4)"},{"kind":"text","text":" and so on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"So, we can color regions "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" with same color, as region number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" is on the path from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and it has color "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" which is less than color of "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", i.e., color number "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"776F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/776/problem/F"}