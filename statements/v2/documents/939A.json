{"assets":[],"contentKind":"statement","contestId":"939","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Love Triangle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"As you could know there are no male planes nor female planes. However, each plane on Earth likes some other plane. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" planes on Earth, numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", and the plane with number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" likes the plane with number "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"1 ≤ fi ≤ n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"fi ≠ i"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We call a love triangle a situation in which plane "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" likes plane "},{"kind":"math_inline","text":"B"},{"kind":"text","text":", plane "},{"kind":"math_inline","text":"B"},{"kind":"text","text":" likes plane "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" and plane "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" likes plane "},{"kind":"math_inline","text":"A"},{"kind":"text","text":". Find out if there is any love triangle on Earth."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 5000"},{"kind":"text","text":") — the number of planes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"f1, f2, ..., fn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ fi ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"fi ≠ i"},{"kind":"text","text":"), meaning that the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th plane likes the "},{"kind":"math_inline","text":"fi"},{"kind":"text","text":"-th."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output «"},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"» if there is a love triangle consisting of planes on Earth. Otherwise, output «"},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"»."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can output any letter in lower case or in upper case."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n2 4 5 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n5 5 5 5 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In first example plane "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" likes plane "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", plane "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" likes plane "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", plane "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" likes plane "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and that is a love triangle."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In second example there are no love triangles."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"939A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/939/problem/A"}