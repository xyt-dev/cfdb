{"assets":["/statement-assets/52a2b30bcb99a9121344206f9abc87e6fcfd906c7ec8cc29dd5771816c8684e8.png","/statement-assets/9642438766f1af18adc5d32744e5781651540db15a3b2c40a6d5824c61574ee7.png","/statement-assets/9cd5564e72f0d2631295783b38029f1a92a4eed33bd099c2d58b232370bf546c.png"],"contentKind":"statement","contestId":"547","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Mike and Friends"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"What-The-Fatherland is a strange country! All phone numbers there are strings consisting of lowercase English letters. What is double strange that a phone number can be associated with several bears!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In that country there is a rock band called CF consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" bears (including Mike) numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/52a2b30bcb99a9121344206f9abc87e6fcfd906c7ec8cc29dd5771816c8684e8.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"Phone number of "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th member of CF is "},{"kind":"math_inline","text":"si"},{"kind":"text","text":". May 17th is a holiday named Phone Calls day. In the last Phone Calls day, everyone called all the numbers that are substrings of his/her number (one may call some number several times). In particular, everyone called himself (that was really strange country)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Denote as "},{"kind":"math_inline","text":"call(i, j)"},{"kind":"text","text":" the number of times that "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th member of CF called the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th member of CF. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The geek Mike has "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" questions that he wants to ask you. In each question he gives you numbers "},{"kind":"math_inline","text":"l, r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and you should tell him the number "}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/9642438766f1af18adc5d32744e5781651540db15a3b2c40a6d5824c61574ee7.png"},"kind":"image"}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2 × 105"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 ≤ q ≤ 5 × 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the phone numbers, "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains a string "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" consisting of lowercase English letters ("},{"attrs":{"alt":"","src":"/statement-assets/9cd5564e72f0d2631295783b38029f1a92a4eed33bd099c2d58b232370bf546c.png"},"kind":"image"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines contain the information about the questions, each of them contains integers "},{"kind":"math_inline","text":"l, r"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ l ≤ r ≤ n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the answer for each question in a separate line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 5\na\nab\nabab\nababab\nb\n1 5 1\n3 5 1\n1 5 2\n1 5 3\n1 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7\n5\n6\n3\n6\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"547E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/547/problem/E"}