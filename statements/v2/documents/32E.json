{"assets":[],"contentKind":"statement","contestId":"32","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Hide-and-Seek"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Victor and Peter are playing hide-and-seek. Peter has hidden, and Victor is to find him. In the room where they are playing, there is only one non-transparent wall and one double-sided mirror. Victor and Peter are points with coordinates "},{"kind":"math_inline","text":"(xv, yv)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(xp, yp)"},{"kind":"text","text":" respectively. The wall is a segment joining points with coordinates "},{"kind":"math_inline","text":"(xw, 1, yw, 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(xw, 2, yw, 2)"},{"kind":"text","text":", the mirror — a segment joining points "},{"kind":"math_inline","text":"(xm, 1, ym, 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(xm, 2, ym, 2)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If an obstacle has a common point with a line of vision, it's considered, that the boys can't see each other with this line of vision. If the mirror has a common point with the line of vision, it's considered, that the boys can see each other in the mirror, i.e. reflection takes place. The reflection process is governed by laws of physics — the angle of incidence is equal to the angle of reflection. The incident ray is in the same half-plane as the reflected ray, relative to the mirror. I.e. to see each other Victor and Peter should be to the same side of the line, containing the mirror (see example 1). If the line of vision is parallel to the mirror, reflection doesn't take place, and the mirror isn't regarded as an obstacle (see example 4)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Victor got interested if he can see Peter, while standing at the same spot. Help him solve this problem."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two numbers "},{"kind":"math_inline","text":"xv"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yv"},{"kind":"text","text":" — coordinates of Victor."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains two numbers "},{"kind":"math_inline","text":"xp"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"yp"},{"kind":"text","text":" — coordinates of Peter."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains 4 numbers "},{"kind":"math_inline","text":"xw, 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yw, 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"xw, 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"yw, 2"},{"kind":"text","text":" — coordinates of the wall."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The forth line contains 4 numbers "},{"kind":"math_inline","text":"xm, 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ym, 1"},{"kind":"text","text":", "},{"kind":"math_inline","text":"xm, 2"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ym, 2"},{"kind":"text","text":" — coordinates of the mirror."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"All the coordinates are integer numbers, and don't exceed "},{"kind":"math_inline","text":"104"},{"kind":"text","text":" in absolute value. It's guaranteed, that the segments don't have common points, Victor and Peter are not on any of the segments, coordinates of Victor and Peter aren't the same, the segments don't degenerate into points."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":", if Victor can see Peter without leaving the initial spot. Otherwise output "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"-1 3\n1 3\n0 2 0 4\n0 0 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 0\n1 1\n0 1 1 0\n-100 -100 -101 -101\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 0\n1 1\n0 1 1 0\n-1 1 1 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"0 0\n10 0\n100 100 101 101\n1 0 3 0\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"32E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/32/problem/E"}