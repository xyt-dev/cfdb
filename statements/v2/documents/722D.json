{"assets":[],"contentKind":"statement","contestId":"722","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Generating Sets"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a set "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"n"},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"y1, y2, ..., yn"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Set "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" of "},{"kind":"math_inline","text":"n"},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":" is said to "},{"children":[{"kind":"text","text":"generate"}],"kind":"container"},{"kind":"text","text":" set "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" if one can transform "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" by applying some number of the following two operation to integers in "},{"kind":"math_inline","text":"X"},{"kind":"text","text":":"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Take any integer "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" and multiply it by two, i.e. replace "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"2·xi"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Take any integer "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":", multiply it by two and add one, i.e. replace "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"2·xi + 1"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Note that integers in "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" are not required to be distinct after each operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two sets of distinct integers "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" are equal if they are equal as sets. In other words, if we write elements of the sets in the array in the increasing order, these arrays would be equal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note, that any set of integers (or its permutation) generates itself."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a set "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" and have to find a set "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" that generates "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" and the "},{"children":[{"kind":"text","text":"maximum element of "},{"kind":"math_inline","text":"X"},{"kind":"text","text":" is mininum possible"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 50 000"},{"kind":"text","text":") — the number of elements in "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"y1, ..., yn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ yi ≤ 109"},{"kind":"text","text":"), that are guaranteed to be distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers — set of distinct integers that generate "},{"kind":"math_inline","text":"Y"},{"kind":"text","text":" and the maximum element of which is minimum possible. If there are several such sets, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 4 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4 5 2 3 1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\n15 14 3 13 1 12\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_