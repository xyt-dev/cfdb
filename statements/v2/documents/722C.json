"text":"3"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Last element is destroyed. At this moment there are no valid nonempty segments left in this array, so the answer is equal to "},{"kind":"math_inline","text":"0"},{"kind":"text","text":". "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"722C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/722/problem/C"}