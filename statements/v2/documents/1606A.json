{"assets":[],"contentKind":"statement","contestId":"1606","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. AB Balance"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ of length $$$n$$$ consisting of characters "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let $$$\\operatorname{AB}(s)$$$ be the number of occurrences of string "},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":" in $$$s$$$ as a "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":". Analogically, $$$\\operatorname{BA}(s)$$$ is the number of occurrences of "},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":" in $$$s$$$ as a "},{"children":[{"kind":"text","text":"substring"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one step, you can choose any index $$$i$$$ and replace $$$s_i$$$ with character "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum number of steps you need to make to achieve $$$\\operatorname{AB}(s) = \\operatorname{BA}(s)$$$?"}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"Reminder:"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The number of occurrences of string $$$d$$$ in $$$s$$$ as substring is the number of indices $$$i$$$ ($$$1 \\le i \\le |s| - |d| + 1$$$) such that substring $$$s_i s_{i + 1} \\dots s_{i + |d| - 1}$$$ is equal to $$$d$$$. For example, $$$\\operatorname{AB}($$$"},{"children":[{"kind":"text","text":"aabbbabaa"}],"kind":"container"},{"kind":"text","text":"$$$) = 2$$$ since there are two indices $$$i$$$: $$$i = 2$$$ where "},{"children":[{"kind":"text","text":"a"},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"bbabaa"}],"kind":"container"},{"kind":"text","text":" and $$$i = 6$$$ where "},{"children":[{"kind":"text","text":"aabbb"},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":"aa"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"Each test contains multiple test cases. The first line contains the number of test cases $$$t$$$ ($$$1 \\le t \\le 1000$$$). Description of the test cases follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first and only line of each test case contains a single string $$$s$$$ ($$$1 \\le |s| \\le 100$$$, where $$$|s|$$$ is the length of the string $$$s$$$), consisting only of characters "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" and/or "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print the resulting string $$$s$$$ with $$$\\operatorname{AB}(s) = \\operatorname{BA}(s)$$$ you'll get making the minimum number of steps."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nb\naabbbabaa\nabbb\nabbaab\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nb\naabbbabaa\nbbbb\nabbaaa"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, both $$$\\operatorname{AB}(s) = 0$$$ and $$$\\operatorname{BA}(s) = 0$$$ (there are no occurrences of "},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":" ("},{"children":[{"kind":"text","text":"ba"}],"kind":"container"},{"kind":"text","text":") in "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":"), so can leave $$$s$$$ untouched."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, $$$\\operatorname{AB}(s) = 2$$$ and $$$\\operatorname{BA}(s) = 2$$$, so you can leave $$$s$$$ untouched. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third test case, $$$\\operatorname{AB}(s) = 1$$$ and $$$\\operatorname{BA}(s) = 0$$$. For example, we can change $$$s_1$$$ to "},{"children":[{"kind":"text","text":"b"}],"kind":"container"},{"kind":"text","text":" and make both values zero."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth test case, $$$\\operatorname{AB}(s) = 2$$$ and $$$\\operatorname{BA}(s) = 1$$$. For example, we can change $$$s_6$$$ to "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" and make both values equal to $$$1$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1606A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1606/problem/A"}