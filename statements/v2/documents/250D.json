"},{"kind":"math_inline","text":"b"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 < a < b < 106"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers in the ascending order: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th integer determines the coordinate of point "},{"kind":"math_inline","text":"Ai"},{"kind":"text","text":" and equals "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|yi| ≤ 106"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers in the ascending order: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th integer determines the coordinate of point "},{"kind":"math_inline","text":"Bi"},{"kind":"text","text":" and equals "},{"kind":"math_inline","text":"y'i"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"|y'i| ≤ 106"},{"kind":"text","text":"). "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fourth line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" more integers: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them determines the length of the path that connects the eastern village and point "},{"kind":"math_inline","text":"Bi"},{"kind":"text","text":", and equals "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ 106"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed, that there is such a point "},{"kind":"math_inline","text":"C"},{"kind":"text","text":" with abscissa at least "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"|BiC| ≤ li"},{"kind":"text","text":" for all "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i ≤ m)"},{"kind":"text","text":". It is guaranteed that no two points "},{"kind":"math_inline","text":"Ai"},{"kind":"text","text":" coincide. It is guaranteed that no two points "},{"kind":"math_inline","text":"Bi"},{"kind":"text","text":" coincide."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print two integers — the numbers of points on the left (west) and right (east) banks, respectively, between which you need to build a bridge. You can assume that the points on the west bank are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", in the order in which they are given in the input. Similarly, the points on the east bank are numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" in the order in which they are given in the input."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple solutions, print any of them. The solution will be accepted if the final length of the path will differ from the answer of the jury by no more than "},{"kind":"math_inline","text":"10 - 6"},{"kind":"text","text":" in absolute or relative value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 2 3 5\n-2 -1 4\n-1 2\n7 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},