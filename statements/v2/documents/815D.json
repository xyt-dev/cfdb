{"assets":["/statement-assets/3798d9fb4c073a7093ec332e0be36db172feb7206fe98e8a562bedc091be3b7f.png"],"contentKind":"statement","contestId":"815","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Karen and Cards"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Karen just got home from the supermarket, and is getting ready to go to sleep."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/3798d9fb4c073a7093ec332e0be36db172feb7206fe98e8a562bedc091be3b7f.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"After taking a shower and changing into her pajamas, she looked at her shelf and saw an album. Curious, she opened it and saw a trading card collection."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"She recalled that she used to play with those cards as a child, and, although she is now grown-up, she still wonders a few things about it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each card has three characteristics: "},{"children":[{"kind":"text","text":"strength"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"defense"}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"speed"}],"kind":"container"},{"kind":"text","text":". The values of all characteristics of all cards are positive integers. The maximum possible strength any card can have is "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", the maximum possible defense is "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" and the maximum possible speed is "},{"kind":"math_inline","text":"r"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" cards in her collection. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th card has a strength "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", defense "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" and speed "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":", respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A card "},{"children":[{"kind":"text","text":"beats"}],"kind":"container"},{"kind":"text","text":" another card if at least two of its characteristics are "},{"children":[{"kind":"text","text":"strictly greater"}],"kind":"container"},{"kind":"text","text":" than the corresponding characteristics of the other card."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"She now wonders how many different cards can beat all the cards in her collection. Two cards are considered different if at least one of their characteristics have different values."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains four integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"p"},{"kind":"text","text":", "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, p, q, r ≤ 500000"},{"kind":"text","text":"), the number of cards in the collection, the maximum possible strength, the maximum possible defense, and the maximum possible speed, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each contain three integers. In particular, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ p"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ bi ≤ q"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ ci ≤ r"},{"kind":"text","text":"), the strength, defense and speed of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th collection card, respectively."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single integer on a line by itself, the number of different cards that can beat all the cards in her collection."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 4 4 5\n2 2 5\n1 3 4\n4 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"10\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 10 10 10\n1 1 1\n1 1 1\n