{"assets":[],"contentKind":"statement","contestId":"509","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Progress Monitoring"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Programming teacher Dmitry Olegovich is going to propose the following task for one of his tests for students:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given a tree "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices, specified by its adjacency matrix "},{"kind":"math_inline","text":"a[1... n, 1... n]"},{"kind":"text","text":". What is the output of the following pseudocode?"}],"kind":"paragraph"},{"kind":"code_block","text":"\nused[1 ... n] = {0, ..., 0};\n\nprocedure dfs(v):\n    print v;\n    used[v] = 1;\n    for i = 1, 2, ..., n:\n        if (a[v][i] == 1 and used[i] == 0):\n            dfs(i);\n\ndfs(1);\n"},{"children":[{"kind":"text","text":"In order to simplify the test results checking procedure, Dmitry Olegovich decided to create a tree "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" such that the result is his favorite sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". On the other hand, Dmitry Olegovich doesn't want to provide students with same trees as input, otherwise they might cheat. That's why Dmitry Olegovich is trying to find out the number of different trees "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" such that the result of running the above pseudocode with "},{"kind":"math_inline","text":"T"},{"kind":"text","text":" as input is exactly the sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Can you help him?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Two trees with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices are called different if their adjacency matrices "},{"kind":"math_inline","text":"a1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a2"},{"kind":"text","text":" are different, i. e. there exists a pair "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":", such that "},{"kind":"math_inline","text":"1 ≤ i, j ≤ n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"a1[i][j] ≠ a2[i][j]"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains the positive integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 500"},{"kind":"text","text":") — the length of sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" positive integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ bi ≤ n"},{"kind":"text","text":"). It is guaranteed that "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" is a permutation, or in other words, each of the numbers "},{"kind":"math_inline","text":"1, 2, ..., n"},{"kind":"text","text":" appears exactly once in the sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":". Also it is guaranteed that "},{"kind":"math_inline","text":"b1 = 1"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output the number of trees satisfying the conditions above modulo "},{"kind":"math_inline","text":"109 + 7"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 3 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"509F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/509/problem/F"}