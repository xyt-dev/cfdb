{"assets":[],"contentKind":"statement","contestId":"2039","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Shohag Loves Pebae"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"768 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Shohag has a tree with $$$n$$$ nodes."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Pebae has an integer $$$m$$$. She wants to assign each node a value — an integer from $$$1$$$ to $$$m$$$. So she asks Shohag to count the number, modulo $$$998\\,244\\,353$$$, of assignments such that following conditions are satisfied:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" For each pair $$$1 \\le u \\lt v \\le n$$$, the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Least_common_multiple"},"children":[{"kind":"text","text":"least common multiple (LCM)"}],"kind":"link"},{"kind":"text","text":" of the values of the nodes in the unique simple path from $$$u$$$ to $$$v$$$ is "},{"children":[{"kind":"text","text":"not"}],"kind":"container"},{"kind":"text","text":" divisible by the number of nodes in the path. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Greatest_common_divisor"},"children":[{"kind":"text","text":"greatest common divisor (GCD)"}],"kind":"link"},{"kind":"text","text":" of the values of all nodes from $$$1$$$ to $$$n$$$ is $$$1$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"But this problem is too hard for Shohag to solve. As Shohag loves Pebae, he has to solve the problem. Please save Shohag!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers $$$n$$$ and $$$m$$$ ($$$2 \\le n \\le 10^6$$$, $$$1 \\le m \\le 10^{9}$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next $$$n - 1$$$ lines contains two integers $$$u$$$ and $$$v$$$ ($$$1 \\le u, v \\le n$$$) indicating there is an edge between vertices $$$u$$$ and $$$v$$$. It is guaranteed that the given edges form a tree."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of valid ways to assign each vertex a value, modulo $$$998\\,244\\,353$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6 6\n1 2\n2 3\n3 4\n4 5\n3 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 5\n1 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n12 69\n3 5\n1 4\n2 3\n4 5\n5 6\n8 9\n7 3\n4 8\n9 10\n1 11\n12 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n444144548\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, the valid assignments are $$$[1, 1, 1, 1, 1, 1]$$$ and $$$[1, 1, 1, 1, 1, 5]$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the valid assignments are $$$[1, 1]$$$, $$$[1, 3]$$$, $$$[1, 5]$$$, $$$[3, 1]$$$, $$$[3, 5]$$$, $$$[5, 1]$$$ and $$$[5, 3]$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"2039G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2039/problem/G"}