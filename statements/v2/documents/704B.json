{"assets":["/statement-assets/2a7ac6c1a35b67ad04f032af8f222b2ed96c19b1f5cb12e6a00a2515f0db9316.png"],"contentKind":"statement","contestId":"704","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Ant Man"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Scott Lang is at war with Darren Cross. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" chairs in a hall where they are, numbered with "},{"kind":"math_inline","text":"1, 2, ..., n"},{"kind":"text","text":" from left to right. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th chair is located at coordinate "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". Scott is on chair number "},{"kind":"math_inline","text":"s"},{"kind":"text","text":" and Cross is on chair number "},{"kind":"math_inline","text":"e"},{"kind":"text","text":". Scott can jump to all other chairs (not only neighboring chairs). He wants to start at his position (chair number "},{"kind":"math_inline","text":"s"},{"kind":"text","text":"), visit each chair "},{"children":[{"kind":"text","text":"exactly once"}],"kind":"container"},{"kind":"text","text":" and end up on chair number "},{"kind":"math_inline","text":"e"},{"kind":"text","text":" with Cross. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As we all know, Scott can shrink or grow big (grow big only to his normal size), so at any moment of time he can be either small or large (normal). The thing is, he can only shrink or grow big while being on a chair (not in the air while jumping to another chair). Jumping takes time, but shrinking and growing big takes no time. Jumping from chair number "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" to chair number "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" takes "},{"kind":"math_inline","text":"|xi - xj|"},{"kind":"text","text":" seconds. Also, jumping off a chair and landing on a chair takes extra amount of time. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If Scott wants to jump to a chair on his left, he can only be small, and if he wants to jump to a chair on his right he should be large."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Jumping off the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th chair takes:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"ci"},{"kind":"text","text":" extra seconds if he's small. "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"di"},{"kind":"text","text":" extra seconds otherwise (he's large). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Also, landing on "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th chair takes:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"bi"},{"kind":"text","text":" extra seconds if he's small. "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"ai"},{"kind":"text","text":" extra seconds otherwise (he's large). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In simpler words, jumping from "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th chair to "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th chair takes exactly:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"|xi - xj| + ci + bj"},{"kind":"text","text":" seconds if "},{"kind":"math_inline","text":"j < i"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"|xi - xj| + di + aj"},{"kind":"text","text":" seconds otherwise ("},{"kind":"math_inline","text":"j > i"},{"kind":"text","text":"). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Given values of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", "},{"kind":"math_inline","text":"b"},{"kind":"text","text":", "},{"kind":"math_inline","text":"c"},{"kind":"text","text":", "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" find the minimum time Scott can get to Cross, assuming he wants to visit each chair exactly once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains three integers "},{"kind":"math_inline","text":"n, s"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"e"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 5000, 1 ≤ s, e ≤ n, s ≠ e"},{"kind":"text","text":") — the total number of chairs, starting and ending positions of Scott."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"x1, x2, ..., xn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ x1 < x2 < ... < xn ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ a1, a2, ..., an ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fourth line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ b1, b2, ..., bn ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The fifth line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ c1, c2, ..., cn ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The sixth line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"d1, d2, ..., dn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ d1, d2, ..., dn ≤ 109"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the minimum amount of time Scott needs to get to the Cross while visiting each chair exactly once."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7 4 3\n8 11 12 16 17 18 20\n17 16 20 2 20 5 13\n17 8 8 16 12 15 13\n12 4 16 4 15 7 6\n8 14 2 11 17 12 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"139\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the sample testcase, an optimal solution would be "},{"attrs":{"alt":"","src":"/statement-assets/2a7ac6c1a35b67ad04f032af8f222b2ed96c19b1f5cb12e6a00a2515f0db9316.png"},"kind":"image"},{"kind":"text","text":". Spent time would be "},{"kind":"math_inline","text":"17 + 24 + 23 + 20 + 33 + 22 = 139"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"704B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/704/problem/B"}