":". They found it a bit easy, so Dr. Evil made their task harder. He will give them "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" update queries. During each update they should add an integer "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" to all elements in "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" in range "},{"kind":"math_inline","text":"[li;ri]"},{"kind":"text","text":" i.e. they should add "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ali, ali + 1, ... , ari"},{"kind":"text","text":" and then they should calculate the minimum value of "},{"kind":"math_inline","text":"f(j)"},{"kind":"text","text":" for all valid "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Please help Mahmoud and Ehab."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains three integers "},{"kind":"math_inline","text":"n, m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ m ≤ 105"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ q ≤ 105"},{"kind":"text","text":") — number of elements in "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", number of elements in "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" and number of queries, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":". ("},{"kind":"math_inline","text":" - 109 ≤ ai ≤ 109"},{"kind":"text","text":") — elements of "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"b1, b2, ..., bm"},{"kind":"text","text":". ("},{"kind":"math_inline","text":" - 109 ≤ bi ≤ 109"},{"kind":"text","text":") — elements of "},{"kind":"math_inline","text":"b"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines follow describing the queries. Each of them contains three integers "},{"kind":"math_inline","text":"li"},{"kind":"math_inline","text":"ri"},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":" - 109 ≤ x ≤ 109"},{"kind":"text","text":") — range to be updated and added value."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line should contain the minimum value of the function "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" before any update."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Then output "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them should contain the minimum value of the function "},{"kind":"math_inline","text":"f"},{"kind":"text","text":" after performing the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th update ."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"