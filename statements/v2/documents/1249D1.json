{"assets":[],"contentKind":"statement","contestId":"1249","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D1. Too Many Segments (easy version)"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"The only difference between easy and hard versions is constraints"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given $$$n$$$ segments on the coordinate axis $$$OX$$$. Segments can intersect, lie inside each other and even coincide. The $$$i$$$-th segment is $$$[l_i; r_i]$$$ ($$$l_i \\le r_i$$$) and it covers all integer points $$$j$$$ such that $$$l_i \\le j \\le r_i$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The integer point is called "},{"children":[{"kind":"text","text":"bad"}],"kind":"container"},{"kind":"text","text":" if it is covered by "},{"children":[{"kind":"text","text":"strictly more"}],"kind":"container"},{"kind":"text","text":" than $$$k$$$ segments."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to remove the minimum number of segments so that there are no "},{"children":[{"kind":"text","text":"bad"}],"kind":"container"},{"kind":"text","text":" points at all."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\le k \\le n \\le 200$$$) — the number of segments and the maximum number of segments by which each integer point can be covered."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next $$$n$$$ lines contain segments. The $$$i$$$-th line contains two integers $$$l_i$$$ and $$$r_i$$$ ($$$1 \\le l_i \\le r_i \\le 200$$$) — the endpoints of the $$$i$$$-th segment."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print one integer $$$m$$$ ($$$0 \\le m \\le n$$$) — the minimum number of segments you need to remove so that there are no "},{"children":[{"kind":"text","text":"bad"}],"kind":"container"},{"kind":"text","text":" points."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print $$$m$$$ "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" integers $$$p_1, p_2, \\dots, p_m$$$ ($$$1 \\le p_i \\le n$$$) — indices of segments you remove in any order. If there are multiple answers, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n7 2\n11 11\n9 11\n7 8\n8 9\n7 8\n9 11\n7 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 4 7 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 1\n29 30\n30 30\n29 29\n28 30\n30 30\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n1 2 4 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n6 1\n2 3\n3 3\n2 3\n2 2\n2 3\n2 3\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n1 3 5 6 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D1","problemCode":"1249D1","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1249/problem/D1"}