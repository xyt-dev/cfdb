{"assets":[],"contentKind":"statement","contestId":"626","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Robot Sequence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Calvin the robot lies in an infinite rectangular grid. Calvin's source code contains a list of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" commands, each either '"},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"', or '"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"' — instructions to move a single square up, right, down, or left, respectively. How many ways can Calvin execute a non-empty contiguous substrings of commands and return to the same square he starts in? Two substrings are considered different if they have different starting or ending indices."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains a single positive integer, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 200"},{"kind":"text","text":") — the number of commands."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" characters, each either '"},{"children":[{"kind":"text","text":"U"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"R"}],"kind":"container"},{"kind":"text","text":"', '"},{"children":[{"kind":"text","text":"D"}],"kind":"container"},{"kind":"text","text":"', or '"},{"children":[{"kind":"text","text":"L"}],"kind":"container"},{"kind":"text","text":"' — Calvin's source code."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the number of contiguous substrings that Calvin can execute and return to his starting square."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\nURLLDR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\nDLUU\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"0\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"7\nRLRLRLR\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first case, the entire source code works, as well as the \""},{"children":[{"kind":"text","text":"RL"}],"kind":"container"},{"kind":"text","text":"\" substring in the second and third characters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Note that, in the third case, the substring \""},{"children":[{"kind":"text","text":"LR"}],"kind":"container"},{"kind":"text","text":"\" appears three times, and is therefore counted three times to the total result."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"626A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/626/problem/A"}