{"assets":[],"contentKind":"statement","contestId":"350","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Resort"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Valera's finally decided to go on holiday! He packed up and headed for a ski resort."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valera's fancied a ski trip but he soon realized that he could get lost in this new place. Somebody gave him a useful hint: the resort has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" objects (we will consider the objects indexed in some way by integers from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"), each object is either a hotel or a mountain."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valera has also found out that the ski resort had multiple ski tracks. Specifically, for each object "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", the resort has at most one object "},{"kind":"math_inline","text":"u"},{"kind":"text","text":", such that there is a ski track built from object "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" to object "},{"kind":"math_inline","text":"v"},{"kind":"text","text":". We also know that no hotel has got a ski track leading from the hotel to some object."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Valera is afraid of getting lost on the resort. So he wants you to come up with a path he would walk along. The path must consist of objects "},{"kind":"math_inline","text":"v1, v2, ..., vk"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"k ≥ 1"},{"kind":"text","text":") and meet the following conditions:"}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"kind":"text","text":" Objects with numbers "},{"kind":"math_inline","text":"v1, v2, ..., vk - 1"},{"kind":"text","text":" are mountains and the object with number "},{"kind":"math_inline","text":"vk"},{"kind":"text","text":" is the hotel. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" For any integer "},{"kind":"math_inline","text":"i"},{"kind":"math_inline","text":"(1 ≤ i < k)"},{"kind":"text","text":", there is "},{"children":[{"kind":"text","text":"exactly one"}],"kind":"container"},{"kind":"text","text":" ski track leading from object "},{"kind":"math_inline","text":"vi"},{"kind":"text","text":". This track goes to object "},{"kind":"math_inline","text":"vi + 1"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The path contains as many objects as possible ("},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is maximal). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Help Valera. Find such path that meets all the criteria of our hero!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 105"},{"kind":"text","text":") — the number of objects."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"type1, type2, ..., typen"},{"kind":"text","text":" — the types of the objects. If "},{"kind":"math_inline","text":"typei"},{"kind":"text","text":" equals zero, then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th object is the mountain. If "},{"kind":"math_inline","text":"typei"},{"kind":"text","text":" equals one, then the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th object is the hotel. It is guaranteed that at least one object is a hotel."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line of the input contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ n"},{"kind":"text","text":") — the description of the ski tracks. If number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" equals zero, then there is no such object "},{"kind":"math_inline","text":"v"},{"kind":"text","text":", that has a ski track built from "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". If number "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" doesn't equal zero, that means that there is a track built from object "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" to object "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" — the maximum possible path length for Valera. In the second line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"v1, v2, ..., vk"},{"kind":"text","text":" — the path. If there are multiple solutions, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 0 0 0 1\n0 1 2 3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n1 2 3 4 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5\n0 0 1 0 1\n0 1 2 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n4 5\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 0 0 0\n2 3 4 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n1\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"350B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/350/problem/B"}