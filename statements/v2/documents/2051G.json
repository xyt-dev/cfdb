{"assets":[],"contentKind":"statement","contestId":"2051","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"G. Snakes"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Suppose you play a game where the game field looks like a strip of $$$1 \\times 10^9$$$ square cells, numbered from $$$1$$$ to $$$10^9$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have $$$n$$$ snakes (numbered from $$$1$$$ to $$$n$$$) you need to place into some cells. Initially, each snake occupies exactly one cell, and you can't place more than one snake into one cell. After that, the game starts."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The game lasts for $$$q$$$ seconds. There are two types of events that may happen each second: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" snake $$$s_i$$$ "},{"children":[{"kind":"text","text":"enlarges"}],"kind":"container"},{"kind":"text","text":": if snake $$$s_i$$$ occupied cells $$$[l, r]$$$, it enlarges to a segment $$$[l, r + 1]$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" snake $$$s_i$$$ "},{"children":[{"kind":"text","text":"shrinks"}],"kind":"container"},{"kind":"text","text":": if snake $$$s_i$$$ occupied cells $$$[l, r]$$$, it shrinks to a segment $$$[l + 1, r]$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Each second, exactly one of the events happens."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If at any moment of time, any snake runs into some obstacle (either another snake or the end of the strip), you lose. Otherwise, you win with the score equal to the maximum cell occupied by any snake so far."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"What is the minimum possible score you can achieve?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers $$$n$$$ and $$$q$$$ ($$$1 \\le n \\le 20$$$; $$$1 \\le q \\le 2 \\cdot 10^5$$$) — the number of snakes and the number of events. Next $$$q$$$ lines contain the description of events — one per line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The $$$i$$$-th line contains "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" either \"$$$s_i$$$ "},{"children":[{"kind":"text","text":"+"}],"kind":"container"},{"kind":"text","text":"\" ($$$1 \\le s_i \\le n$$$) meaning that the $$$s_i$$$-th snake enlarges "}],"kind":"list_item"},{"children":[{"kind":"text","text":" or \"$$$s_i$$$ "},{"children":[{"kind":"text","text":"-"}],"kind":"container"},{"kind":"text","text":"\" ($$$1 \\le s_i \\le n$$$) meaning that the $$$s_i$$$-th snake shrinks. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Additional constraint on the input: the given sequence of events is valid, i. e. a snake of length $$$1$$$ never shrinks."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print one integer — the minimum possible score."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3 6\n1 +\n1 -\n3 +\n3 -\n2 +\n2 -\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n5 13\n5 +\n3 +\n5 -\n2 +\n4 +\n3 +\n5 +\n5 -\n2 +\n3 -\n3 +\n3 -\n2 +\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n11\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test, the optimal strategy is to place the second snake at cell $$$1$$$, the third snake — at $$$2$$$, and the first one — at $$$3$$$. The maximum occupied cell is cell $$$4$$$, and it's the minimum possible score."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test, one of the optimal strategies is to place: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" snake $$$2$$$ at position $$$1$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" snake $$$3$$$ at position $$$4$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" snake $$$5$$$ at position $$$6$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" snake $$$1$$$ at position $$$9$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" snake $$$4$$$ at position $$$10$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"}],"kind":"document"},"index":"G","problemCode":"2051G","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2051/problem/G"}