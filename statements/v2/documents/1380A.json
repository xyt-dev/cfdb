{"assets":[],"contentKind":"statement","contestId":"1380","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Three Indices"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a permutation $$$p_1, p_2, \\dots, p_n$$$. Recall that sequence of $$$n$$$ integers is called a "},{"children":[{"kind":"text","text":"permutation"}],"kind":"container"},{"kind":"text","text":" if it contains all integers from $$$1$$$ to $$$n$$$ exactly once."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Find three indices $$$i$$$, $$$j$$$ and $$$k$$$ such that: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" $$$1 \\le i \\lt j \\lt k \\le n$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" $$$p_i \\lt p_j$$$ and $$$p_j \\gt p_k$$$. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" Or say that there are no such indices."}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$T$$$ ($$$1 \\le T \\le 200$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next $$$2T$$$ lines contain test cases — two lines per test case. The first line of each test case contains the single integer $$$n$$$ ($$$3 \\le n \\le 1000$$$) — the length of the permutation $$$p$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$p_1, p_2, \\dots, p_n$$$ ($$$1 \\le p_i \\le n$$$; $$$p_i \\neq p_j$$$ if $$$i \\neq j$$$) — the permutation $$$p$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" if there are such indices $$$i$$$, $$$j$$$ and $$$k$$$, print "},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":" (case insensitive) and the indices themselves; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" if there are no such indices, print "},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":" (case insensitive). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"If there are multiple valid triples of indices, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n3\n4\n2 1 4 3\n6\n4 6 1 2 5 3\n5\n5 3 1 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\nYES\n2 3 4\nYES\n3 5 6\nNO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"1380A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1380/problem/A"}