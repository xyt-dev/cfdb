{"assets":["/statement-assets/57bfe9313f60e304d8b3b1a4a663ed1d5488827f5887fdffb69c1b3d492192a2.png"],"contentKind":"statement","contestId":"535","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Tavas and Pashmaks"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Tavas is a cheerleader in the new sports competition named \"Pashmaks\"."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/57bfe9313f60e304d8b3b1a4a663ed1d5488827f5887fdffb69c1b3d492192a2.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"This competition consists of two part: swimming and then running. People will immediately start running "},{"kind":"math_inline","text":"R"},{"kind":"text","text":" meters after they finished swimming exactly "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" meters. A winner is a such person that nobody else finishes running before him/her (there may be more than one winner)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Before the match starts, Tavas knows that there are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" competitors registered for the match. Also, he knows that "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th person's swimming speed is "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" meters per second and his/her running speed is "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" meters per second. Unfortunately, he doesn't know the values of "},{"kind":"math_inline","text":"R"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"S"},{"kind":"text","text":", but he knows that they are real numbers greater than "},{"kind":"math_inline","text":"0"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"As a cheerleader, Tavas wants to know who to cheer up. So, he wants to know all people that might win. We consider a competitor might win if and only if there are some values of "},{"kind":"math_inline","text":"R"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"S"},{"kind":"text","text":" such that with these values, (s)he will be a winner."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Tavas isn't really familiar with programming, so he asked you to help him."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n ≤ 2 × 105"},{"kind":"text","text":")."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain the details of competitors. "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two integers "},{"kind":"math_inline","text":"si"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ si, ri ≤ 104"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first and the only line of output, print a sequence of numbers of possible winners in increasing order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 3\n2 2\n3 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 2 3 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2\n1 1\n2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"535E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/535/problem/E"}