{"assets":[],"contentKind":"statement","contestId":"1302","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Segment tree or Fenwick?"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2.5 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is an unusual problem in an unusual contest, here is the announcement: "},{"attrs":{"href":"https://codeforces.com/blog/entry/73543"},"children":[{"kind":"text","text":"http://codeforces.com/blog/entry/73543"}],"kind":"link"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You are given an array $$$A$$$ of length $$$n$$$, initially filled with zeros. You need to process $$$q$$$ queries to the array, each of one of the following types: "}],"kind":"paragraph"},{"attrs":{"ordered":true},"children":[{"children":[{"children":[{"kind":"text","text":"1 x y"}],"kind":"container"},{"kind":"text","text":": you need to assign $$$A_x=y$$$; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"2 l r"}],"kind":"container"},{"kind":"text","text":": you need to print $$$\\sum\\limits_{i=l}^r A_i$$$. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" Furthermore, there are $$$T$$$ independent tests you need to process."}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains an integer $$$T$$$ ($$$1 \\leq T \\leq 10^5$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each test case description starts with two integers $$$n, q$$$ ($$$1 \\leq n, q \\leq 10^5$$$) — the length of the array and the number of queries. The following $$$q$$$ lines contain the description of queries: $$$1~x~y$$$ ($$$1 \\leq x \\leq n$$$, $$$0 \\leq y \\leq 10^9$$$) for queries of the first type and $$$2~l~r$$$ ($$$1 \\leq l \\leq r \\leq n$$$) for queries of the second type. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the sum of $$$n$$$ as well as the sum of $$$q$$$ does not exceed $$$10^6$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each query of the second type print its result on a separate line."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n6 5\n2 1 6\n1 3 2\n2 2 4\n1 6 3\n2 1 6\n5 3\n1 3 7\n1 1 4\n2 1 5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n0\n2\n5\n11\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"1302C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1302/problem/C"}