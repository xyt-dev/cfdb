{"assets":[],"contentKind":"statement","contestId":"2069","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Palindrome Shuffle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a string $$$s$$$ consisting of lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You can perform the following operation with the string $$$s$$$: choose a contiguous substring (possibly empty) of $$$s$$$ and shuffle it (reorder the characters in the substring as you wish)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Recall that a palindrome is a string that reads the same way from the first character to the last and from the last character to the first. For example, the strings "},{"children":[{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"bab"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"acca"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"bcabcbacb"}],"kind":"container"},{"kind":"text","text":" are palindromes, but the strings "},{"children":[{"kind":"text","text":"ab"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"abbbaa"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"cccb"}],"kind":"container"},{"kind":"text","text":" are not."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to determine the minimum possible length of the substring on which the aforementioned operation must be performed in order to convert the given string $$$s$$$ into a palindrome."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$t$$$ ($$$1 \\le t \\le 10^4$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only line of each test case contains a string $$$s$$$ ($$$2 \\le |s| \\le 2 \\cdot 10^5$$$), consisting of lowercase Latin letters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Additional constraints on the input: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" the string $$$s$$$ has an even length; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the string $$$s$$$ can always be converted to a palindrome; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" the sum of lengths of $$$s$$$ over all test cases doesn't exceed $$$2 \\cdot 10^5$$$. "}],"kind":"list_item"}],"kind":"list"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test case, print a single integer — the minimum possible length of the substring on which the aforementioned operation must be performed in order to convert the given string $$$s$$$ into a palindrome."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n4\nbaba\ncc\nddaa\nacbacddacbca\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n0\n3\n2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, you can perform the operation as follows: "},{"children":[{"kind":"text","text":"ba"},{"children":[{"kind":"text","text":"ba"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"ba"},{"children":[{"kind":"text","text":"ab"}],"kind":"container"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second example, the string is already a palindrome, so we can shuffle an empty substring."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third example, you can perform the operation as follows: "},{"children":[{"children":[{"kind":"text","text":"dda"}],"kind":"container"},{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"children":[{"kind":"text","text":"add"}],"kind":"container"},{"kind":"text","text":"a"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the fourth example, you can perform the operation as follows: "},{"children":[{"kind":"text","text":"acb"},{"children":[{"kind":"text","text":"ac"}],"kind":"container"},{"kind":"text","text":"ddacbca"}],"kind":"container"},{"kind":"text","text":" $$$\\rightarrow$$$ "},{"children":[{"kind":"text","text":"acb"},{"children":[{"kind":"text","text":"ca"}],"kind":"container"},{"kind":"text","text":"ddacbca"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"2069D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/2069/problem/D"}