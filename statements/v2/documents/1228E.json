{"assets":["/statement-assets/3d42893e0fc6098dc1f483cf3cda24c5e221ee00f2568eb0388f4c06d5194844.png","/statement-assets/1b28f869306fd602ae17bf1251f66b326bf93bd2495117804ee0a83776e81b32.png"],"contentKind":"statement","contestId":"1228","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"E. Another Filling the Grid"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You have $$$n \\times n$$$ square grid and an integer $$$k$$$. Put an integer in each cell while satisfying the conditions below."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" All numbers in the grid should be between $$$1$$$ and $$$k$$$ inclusive. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Minimum number of the $$$i$$$-th row is $$$1$$$ ($$$1 \\le i \\le n$$$). "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Minimum number of the $$$j$$$-th column is $$$1$$$ ($$$1 \\le j \\le n$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Find the number of ways to put integers in the grid. Since the answer can be very large, find the answer modulo $$$(10^{9} + 7)$$$."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/3d42893e0fc6098dc1f483cf3cda24c5e221ee00f2568eb0388f4c06d5194844.png"},"kind":"image"},{"kind":"text","text":" These are the examples of valid and invalid grid when $$$n=k=2$$$. "}],"kind":"container"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The only line contains two integers $$$n$$$ and $$$k$$$ ($$$1 \\le n \\le 250$$$, $$$1 \\le k \\le 10^{9}$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the answer modulo $$$(10^{9} + 7)$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n7\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n123 456789\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n689974806\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example, following $$$7$$$ cases are possible."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/1b28f869306fd602ae17bf1251f66b326bf93bd2495117804ee0a83776e81b32.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second example, make sure you print the answer modulo $$$(10^{9} + 7)$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"E","problemCode":"1228E","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1228/problem/E"}