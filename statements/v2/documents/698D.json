{"assets":["/statement-assets/e6aff4d8835ae52e78998f55a99cef3962be94d995c9cf1f1b290dff58b54611.png"],"contentKind":"statement","contestId":"698","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Limak and Shooting Points"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Bearland is a dangerous place. Limak can’t travel on foot. Instead, he has "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" magic teleportation stones. Each stone can be used "},{"children":[{"kind":"text","text":"at most once"}],"kind":"container"},{"kind":"text","text":". The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th stone allows to teleport to a point "},{"kind":"math_inline","text":"(axi, ayi)"},{"kind":"text","text":". Limak can use stones "},{"children":[{"kind":"text","text":"in any order"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" monsters in Bearland. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them stands at "},{"kind":"math_inline","text":"(mxi, myi)"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The given "},{"kind":"math_inline","text":"k + n"},{"kind":"text","text":" points are pairwise distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After each teleportation, Limak can shoot an arrow in some direction. An arrow will hit the first monster in the chosen direction. Then, both an arrow and a monster disappear. It’s dangerous to stay in one place for long, so Limak can shoot only one arrow from one place."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A monster should be afraid if it’s possible that Limak will hit it. How many monsters should be afraid of Limak?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ 7"},{"kind":"text","text":", "},{"kind":"math_inline","text":"1 ≤ n ≤ 1000"},{"kind":"text","text":") — the number of stones and the number of monsters."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of following "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"axi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ayi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ axi, ayi ≤ 109"},{"kind":"text","text":") — coordinates to which Limak can teleport using the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th stone."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of last "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"mxi"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"myi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ mxi, myi ≤ 109"},{"kind":"text","text":") — coordinates of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th monster."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The given "},{"kind":"math_inline","text":"k + n"},{"kind":"text","text":" points are pairwise distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of monsters which should be afraid of Limak."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 4\n-2 -1\n4 5\n4 2\n2 1\n4 -1\n1 -1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 8\n10 20\n0 0\n20 40\n300 600\n30 60\n170 340\n50 100\n28 56\n90 180\n-4 -8\n-1 -2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"5\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, there are two stones and four monsters. Stones allow to teleport to points "},{"kind":"math_inline","text":"( - 2,  - 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(4, 5)"},{"kind":"text","text":", marked blue in the drawing below. Monsters are at "},{"kind":"math_inline","text":"(4, 2)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(2, 1)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(4,  - 1)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(1,  - 1)"},{"kind":"text","text":", marked red. A monster at "},{"kind":"math_inline","text":"(4,  - 1)"},{"kind":"text","text":" shouldn't be afraid because it's impossible that Limak will hit it with an arrow. Other three monsters can be hit and thus the answer is "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/e6aff4d8835ae52e78998f55a99cef3962be94d995c9cf1f1b290dff58b54611.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"In the second sample, five monsters should be afraid. Safe monsters are those at "},{"kind":"math_inline","text":"(300, 600)"},{"kind":"text","text":", "},{"kind":"math_inline","text":"(170, 340)"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"(90, 180)"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"698D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/698/problem/D"}