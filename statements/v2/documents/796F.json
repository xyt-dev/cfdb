{"assets":["/statement-assets/b96121996d3dfe365226b47ea77e2834b7c17fb45249f67d8515071b96df9abc.png","/statement-assets/c5ccbcf94d1c084bd890b443f6fd462c3ce4a7fe5050ff84708e86b6a109560b.png"],"contentKind":"statement","contestId":"796","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Sequence Recovery"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Zane once had a "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" — but he has lost it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A sequence is said to be "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" if and only if all of its integers are non-negative and do not exceed "},{"kind":"math_inline","text":"109"},{"kind":"text","text":" in value."}],"kind":"paragraph"},{"children":[{"attrs":{"alt":"","src":"/statement-assets/b96121996d3dfe365226b47ea77e2834b7c17fb45249f67d8515071b96df9abc.png"},"kind":"image"}],"kind":"container"},{"children":[{"kind":"text","text":"However, Zane remembers having played around with his sequence by applying "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" operations to it."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There are two types of operations:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1. Find the maximum value of integers with indices "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" such that "},{"kind":"math_inline","text":"l ≤ i ≤ r"},{"kind":"text","text":", given "},{"kind":"math_inline","text":"l"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"r"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2. Assign "},{"kind":"math_inline","text":"d"},{"kind":"text","text":" as the value of the integer with index "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", given "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"d"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After he finished playing, he restored his sequence to the state it was before any operations were applied. That is, sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" was no longer affected by the applied type 2 operations. Then, he lost his sequence at some time between now and then."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Fortunately, Zane remembers all the operations and the order he applied them to his sequence, along with the "},{"children":[{"kind":"text","text":"distinct"}],"kind":"container"},{"kind":"text","text":" results of all type 1 operations. Moreover, among all "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" sequences that would produce the same results when the same operations are applied in the same order, he knows that his sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" has the greatest "},{"children":[{"kind":"text","text":"cuteness"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We define "},{"children":[{"kind":"text","text":"cuteness"}],"kind":"container"},{"kind":"text","text":" of a sequence as the bitwise OR result of all integers in such sequence. For example, the "},{"children":[{"kind":"text","text":"cuteness"}],"kind":"container"},{"kind":"text","text":" of Zane's sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"a1"},{"children":[{"kind":"text","text":"OR"}],"kind":"container"},{"kind":"math_inline","text":"a2"},{"children":[{"kind":"text","text":"OR"}],"kind":"container"},{"kind":"text","text":" ... "},{"children":[{"kind":"text","text":"OR"}],"kind":"container"},{"kind":"math_inline","text":"an"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Zane understands that it might not be possible to recover exactly the lost sequence given his information, so he would be happy to get any "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" sequence "},{"kind":"math_inline","text":"b"},{"kind":"text","text":" consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" that:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"1. would give the same results when the same operations are applied in the same order, and"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"2. has the same "},{"children":[{"kind":"text","text":"cuteness"}],"kind":"container"},{"kind":"text","text":" as that of Zane's original sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there is such a sequence, find it. Otherwise, it means that Zane must have remembered something incorrectly, which is possible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, m ≤ 3·105"},{"kind":"text","text":") — the number of integers in Zane's original sequence and the number of operations that have been applied to the sequence, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of the following "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines starts with one integer "},{"kind":"math_inline","text":"ti"},{"kind":"text","text":" ("},{"attrs":{"alt":"","src":"/statement-assets/c5ccbcf94d1c084bd890b443f6fd462c3ce4a7fe5050ff84708e86b6a109560b.png"},"kind":"image"},{"kind":"text","text":") — the type of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the operation is type 1 ("},{"kind":"math_inline","text":"ti = 1"},{"kind":"text","text":"), then three integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":", "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", and "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" follow ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ xi ≤ 109"},{"kind":"text","text":") — the leftmost index to be considered, the rightmost index to be considered, and the maximum value of all integers with indices between "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", inclusive, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If the operation is type 2 ("},{"kind":"math_inline","text":"ti = 2"},{"kind":"text","text":"), then two integers "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" follow ("},{"kind":"math_inline","text":"1 ≤ ki ≤ n"},{"kind":"text","text":", "},{"kind":"math_inline","text":"0 ≤ di ≤ 109"},{"kind":"text","text":") — meaning that the integer with index "},{"kind":"math_inline","text":"ki"},{"kind":"text","text":" should become "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" after this operation."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that "},{"kind":"math_inline","text":"xi ≠ xj"},{"kind":"text","text":" for all pairs "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"1 ≤ i < j ≤ m"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ti = tj = 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The operations are given in the same order they were applied. That is, the operation that is given first was applied first, the operation that is given second was applied second, and so on."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If there does not exist a valid "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" sequence, print \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotation marks) in the first line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Otherwise, print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotation marks) in the first line, and print "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"b1, b2, ..., bn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ bi ≤ 109"},{"kind":"text","text":") in the second line."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 4\n1 1 5 19\n1 2 5 1\n2 5 100\n1 1 5 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n19 0 0 0 1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n1 1 5 0\n1 1 5 100\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, it is easy to verify that this "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" sequence is valid. In particular, its "},{"children":[{"kind":"text","text":"cuteness"}],"kind":"container"},{"kind":"text","text":" is "},{"kind":"math_inline","text":"19"},{"children":[{"kind":"text","text":"OR"}],"kind":"container"},{"kind":"math_inline","text":"0"},{"children":[{"kind":"text","text":"OR"}],"kind":"container"},{"kind":"math_inline","text":"0"},{"children":[{"kind":"text","text":"OR"}],"kind":"container"},{"kind":"math_inline","text":"0"},{"children":[{"kind":"text","text":"OR"}],"kind":"container"},{"kind":"math_inline","text":"1"},{"kind":"math_inline","text":" = "},{"kind":"math_inline","text":"19"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the two operations clearly contradict, so there is no such "},{"children":[{"kind":"text","text":"good"}],"kind":"container"},{"kind":"text","text":" sequence."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"796F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/796/problem/F"}