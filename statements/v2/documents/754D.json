{"assets":[],"contentKind":"statement","contestId":"754","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Fedor and coupons"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"All our characters have hobbies. The same is true for Fedor. He enjoys shopping in the neighboring supermarket. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The goods in the supermarket have unique integer ids. Also, for every integer there is a product with id equal to this integer. Fedor has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" discount coupons, the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th of them can be used with products with ids ranging from "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":", inclusive. Today Fedor wants to take exactly "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" coupons with him."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Fedor wants to choose the "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" coupons in such a way that the number of such products "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" that all coupons can be used with this product "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" is as large as possible (for better understanding, see examples). Fedor wants to save his time as well, so he asks you to choose coupons for him. Help Fedor!"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ k ≤ n ≤ 3·105"},{"kind":"text","text":") — the number of coupons Fedor has, and the number of coupons he wants to choose."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ li ≤ ri ≤ 109"},{"kind":"text","text":") — the description of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th coupon. The coupons can be equal."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first line print single integer — the maximum number of products with which all the chosen coupons can be used. The products with which at least one coupon cannot be used shouldn't be counted."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second line print "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" distinct integers "},{"kind":"math_inline","text":"p1, p2, ..., pk"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ pi ≤ n"},{"kind":"text","text":") — the ids of the coupons which Fedor should choose."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple answers, print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{