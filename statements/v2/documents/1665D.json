{"assets":[],"contentKind":"statement","contestId":"1665","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. GCD Guess"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is an interactive problem."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"There is a positive integer $$$1 \\le x \\le 10^9$$$ that you have to guess."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one query you can choose two positive integers $$$a \\neq b$$$. As an answer to this query you will get $$$\\gcd(x + a, x + b)$$$, where $$$\\gcd(n, m)$$$ is the "},{"attrs":{"href":"https://en.wikipedia.org/wiki/Greatest common divisor"},"children":[{"kind":"text","text":"greatest common divisor"}],"kind":"link"},{"kind":"text","text":" of the numbers $$$n$$$ and $$$m$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To guess one hidden number $$$x$$$ you are allowed to make no more than $$$30$$$ queries."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains a single integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) denoting the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The integer $$$x$$$ that you have to guess satisfies the constraints: ($$$1 \\le x \\le 10^9$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom","title":"Interaction"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Interaction"}],"kind":"heading"},{"children":[{"kind":"text","text":"The hidden number $$$x$$$ is fixed before the start of the interaction and does not depend on your queries."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To guess each $$$x$$$ you can make no more than $$$30$$$ queries in the following way:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"? a b"}],"kind":"container"},{"kind":"text","text":"\" ($$$1 \\le a, b \\le 2 \\cdot 10^9$$$, $$$a \\neq b$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"For this query you will get $$$\\gcd(x + a, x + b)$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When you know $$$x$$$, print a single line in the following format."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" \""},{"children":[{"kind":"text","text":"! x"}],"kind":"container"},{"kind":"text","text":"\" ($$$1 \\le x \\le 10^9$$$). "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"After that continue to solve the next test case."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If you ask more than $$$30$$$ queries for one $$$x$$$ or make an invalid query, the interactor will terminate immediately and your program will receive verdict "},{"children":[{"kind":"text","text":"Wrong Answer"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After printing each query do not forget to output end of line and flush the output buffer. Otherwise, you will get the "},{"children":[{"kind":"text","text":"Idleness limit exceeded"}],"kind":"container"},{"kind":"text","text":" verdict. To do flush use:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"fflush(stdout)"}],"kind":"container"},{"kind":"text","text":" or "},{"children":[{"kind":"text","text":"cout.flush()"}],"kind":"container"},{"kind":"text","text":" in C++; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"System.out.flush()"}],"kind":"container"},{"kind":"text","text":" in Java; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"flush(output)"}],"kind":"container"},{"kind":"text","text":" in Pascal; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"stdout.flush()"}],"kind":"container"},{"kind":"text","text":" in Python; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Read documentation for other languages. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"Hacks"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To use hacks, use the following format of tests:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first line should contain a single integer $$$t$$$ ($$$1 \\le t \\le 1000$$$) — the number of test cases."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first and only line of each test case should contain a single integer $$$x$$$ ($$$1 \\le x \\le 10^9$$$) denoting the integer $$$x$$$ that should be guessed."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Example"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"\n2\n\n1\n\n8\n\n\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"\n\n? 1 2\n\n? 12 4\n\n! 4\n? 2000000000 1999999999\n\n! 1000000000\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first hidden number is $$$4$$$, that's why the answers for the queries are:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"? 1 2"}],"kind":"container"},{"kind":"text","text":"\" — $$$\\gcd(4 + 1, 4 + 2) = \\gcd(5, 6) = 1$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"? 12 4"}],"kind":"container"},{"kind":"text","text":"\" — $$$\\gcd(4 + 12, 4 + 4) = \\gcd(16, 8) = 8$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second hidden number is $$$10^9$$$, that's why the answer for the query is:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"\""},{"children":[{"kind":"text","text":"? 2000000000 1999999999"}],"kind":"container"},{"kind":"text","text":"\" — $$$\\gcd(3 \\cdot 10^9, 3 \\cdot 10^9 - 1) = 1$$$."}],"kind":"paragraph"},{"children":[{"children":[{"kind":"text","text":"These queries are made only for understanding the interaction and are not enough for finding the true $$$x$$$."}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"1665D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1665/problem/D"}