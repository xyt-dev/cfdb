{"assets":[],"contentKind":"statement","contestId":"1768","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"F. Wonderful Jump"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"4 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"128 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given an array of positive integers $$$a_1,a_2,\\ldots,a_n$$$ of length $$$n$$$. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one operation you can jump from index $$$i$$$ to index $$$j$$$ ($$$1 \\le i \\le j \\le n$$$) by paying $$$\\min(a_i, a_{i + 1}, \\ldots, a_j) \\cdot (j - i)^2$$$ eris."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"For all $$$k$$$ from $$$1$$$ to $$$n$$$, find the minimum number of eris needed to get from index $$$1$$$ to index $$$k$$$."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer $$$n$$$ ($$$2 \\le n \\le 4 \\cdot 10^5$$$)."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains $$$n$$$ integers $$$a_1,a_2,\\ldots a_n$$$ ($$$1 \\le a_i \\le n$$$)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output $$$n$$$ integers — the $$$k$$$-th integer is the minimum number of eris needed to reach index $$$k$$$ if you start from i