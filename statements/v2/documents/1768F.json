hildren":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first example: "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" From $$$1$$$ to $$$1$$$: the cost is $$$0$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" From $$$1$$$ to $$$2$$$: $$$1 \\rightarrow 2$$$ — the cost is $$$\\min(2, 1) \\cdot (2 - 1) ^ 2=1$$$, "}],"kind":"list_item"},{"children":[{"kind":"text","text":" From $$$1$$$ to $$$3$$$: $$$1 \\rightarrow 2 \\rightarrow 3$$$ — the cost is $$$\\min(2, 1) \\cdot (2 - 1) ^ 2 + \\min(1, 3) \\cdot (3 - 2) ^ 2 = 1 + 1 = 2$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"In the fourth example from $$$1$$$ to $$$4$$$: $$$1 \\rightarrow 3 \\rightarrow 4$$$ — the cost is $$$\\min(1, 4, 4) \\cdot (3 - 1) ^ 2 + \\min(4, 4) \\cdot (4 - 3) ^ 2 = 4 + 4 = 8$$$."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"F","problemCode":"1768F","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/1768/problem/F"}