{"assets":[],"contentKind":"statement","contestId":"416","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Art Union"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A well-known art union called \"Kalevich is Alive!\" manufactures objects d'art (pictures). The union consists of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" painters who decided to organize their work as follows."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Each painter uses only the color that was assigned to him. The colors are distinct for all painters. Let's assume that the first painter uses color 1, the second one uses color 2, and so on. Each picture will contain all these "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" colors. Adding the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th color to the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th picture takes the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th painter "},{"kind":"math_inline","text":"tij"},{"kind":"text","text":" units of time."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Order is important everywhere, so the painters' work is ordered by the following rules:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Each picture is first painted by the first painter, then by the second one, and so on. That is, after the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th painter finishes working on the picture, it must go to the "},{"kind":"math_inline","text":"(j + 1)"},{"kind":"text","text":"-th painter (if "},{"kind":"math_inline","text":"j < n"},{"kind":"text","text":"); "}],"kind":"list_item"},{"children":[{"kind":"text","text":" each painter works on the pictures in some order: first, he paints the first picture, then he paints the second picture and so on; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" each painter can simultaneously work on at most one picture. However, the painters don't need any time to have a rest; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" as soon as the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th painter finishes his part of working on the picture, the picture immediately becomes available to the next painter. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"Given that the painters start working at time 0, find for each picture the time when it is ready for sale."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains integers "},{"kind":"math_inline","text":"m, n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 50000, 1 ≤ n ≤ 5"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" is the number of pictures and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" is the number of painters. Then follow the descriptions of the pictures, one per line. Each line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"ti1, ti2, ..., tin"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ tij ≤ 1000"},{"kind":"text","text":"), where "},{"kind":"math_inline","text":"tij"},{"kind":"text","text":" is the time the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th painter needs to work on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th picture."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the sequence of "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"r1, r2, ..., rm"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" is the moment when the "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"-th painter stopped working on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th picture."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 1\n1\n2\n3\n4\n5\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1 3 6 10 15 "}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 2\n2 5\n3 1\n5 3\n10 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"7 8 13 21 "}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"416B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/416/problem/B"}