{"assets":["/statement-assets/e9e0864f234e38fcf2ad0baf87c2f06b0e76704c153da30ae3a38c115704075f.png"],"contentKind":"statement","contestId":"270","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Fancy Fence"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Emuskald needs a fence around his farm, but he is too lazy to build it himself. So he purchased a fence-building robot."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He wants the fence to be a regular polygon. The robot builds the fence along a single path, but it can only make fence corners at a single angle "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Will the robot be able to build the fence Emuskald wants? In other words, is there a regular polygon which angles are equal to "},{"kind":"math_inline","text":"a"},{"kind":"text","text":"?"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input contains an integer "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 < t < 180"},{"kind":"text","text":") — the number of tests. Each of the following "},{"kind":"math_inline","text":"t"},{"kind":"text","text":" lines contains a single integer "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 < a < 180"},{"kind":"text","text":") — the angle the robot can make corners at measured in degrees."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"For each test, output on a single line \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes), if the robot can build a fence Emuskald wants, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" (without quotes), if it is impossible."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n30\n60\n90\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\nYES\nYES\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first test case, it is impossible to build the fence, since there is no regular polygon with angle "},{"attrs":{"alt":"","src":"/statement-assets/e9e0864f234e38fcf2ad0baf87c2f06b0e76704c153da30ae3a38c115704075f.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second test case, the fence is a regular triangle, and in the last test case — a square."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"270A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/270/problem/A"}