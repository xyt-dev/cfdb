{"assets":[],"contentKind":"statement","contestId":"687","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. The Values You Can Make"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Pari wants to buy an expensive chocolate from Arya. She has "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" coins, the value of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th coin is "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":". The price of the chocolate is "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", so Pari will take a subset of her coins with sum equal to "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and give it to Arya."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Looking at her coins, a question came to her mind: after giving the coins to Arya, what values does Arya can make with them? She is jealous and she doesn't want Arya to make a lot of values. So she wants to know all the values "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", such that Arya will be able to make "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" using some subset of coins with the sum "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Formally, Pari wants to know the values "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" such that there exists a subset of coins with the sum "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" such that some subset of this subset has the sum "},{"kind":"math_inline","text":"x"},{"kind":"text","text":", i.e. there is exists some way to pay for the chocolate, such that Arya will be able to make the sum "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" using these coins."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1  ≤  n, k  ≤  500"},{"kind":"text","text":") — the number of coins and the price of the chocolate, respectively."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next line will contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ci ≤ 500"},{"kind":"text","text":") — the values of Pari's coins."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It's guaranteed that one can make value "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" using these coins."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"First line of the output must contain a single integer "},{"kind":"math_inline","text":"q"},{"kind":"text","text":"— the number of suitable values "},{"kind":"math_inline","text":"x"},{"kind":"text","text":". Then print "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" integers in ascending order — the values that Arya can make for some subset of coins of Pari that pays for the chocolate."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 18\n5 6 1 10 12 2\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"16\n0 1 2 3 5 6 7 8 10 11 12 13 15 16 17 18 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 50\n25 25 50\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n0 25 50 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"687C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/687/problem/C"}