{"assets":[],"contentKind":"statement","contestId":"463","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Gargari and Bishops"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Gargari is jealous that his friend Caisa won the game from the previous problem. He wants to prove that he is a genius."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He has a "},{"kind":"math_inline","text":"n × n"},{"kind":"text","text":" chessboard. Each cell of the chessboard has a number written on it. Gargari wants to place two bishops on the chessboard in such a way that there is no cell that is attacked by both of them. Consider a cell with number "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" written on it, if this cell is attacked by one of the bishops Gargari will get "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" dollars for it. Tell Gargari, how to place bishops on the chessboard to get maximum amount of money."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"We assume a cell is attacked by a bishop, if the cell is located on the same diagonal with the bishop (the cell, where the bishop is, also considered attacked by it)."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"math_inline","text":"(2 ≤ n ≤ 2000)"},{"kind":"text","text":". Each of the next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"aij"},{"kind":"math_inline","text":"(0 ≤ aij ≤ 109)"},{"kind":"text","text":" — description of the chessboard."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"On the first line print the maximal number of dollars Gargari will get. On the next line print four integers: "},{"kind":"math_inline","text":"x1, y1, x2, y2"},{"kind":"math_inline","text":"(1 ≤ x1, y1, x2, y2 ≤ n)"},{"kind":"text","text":", where "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" is the number of the row where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th bishop should be placed, "},{"kind":"math_inline","text":"yi"},{"kind":"text","text":" is the number of the column where the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th bishop should be placed. Consider rows are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from top to bottom, and columns are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are several optimal solutions, you can print any of them."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 1 1 1\n2 1 1 0\n1 1 1 0\n1 0 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"12\n2 2 3 2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"463C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/463/problem/C"}