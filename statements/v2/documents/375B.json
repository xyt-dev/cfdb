{"assets":[],"contentKind":"statement","contestId":"375","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Maximum Submatrix 2"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given a matrix consisting of digits zero and one, its size is "},{"kind":"math_inline","text":"n × m"},{"kind":"text","text":". You are allowed to rearrange its rows. What is the maximum area of the submatrix that only consists of ones and can be obtained in the given problem by the described operations?"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's assume that the rows of matrix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" are numbered from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from top to bottom and the columns are numbered from 1 to "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" from left to right. A matrix cell on the intersection of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column can be represented as "},{"kind":"math_inline","text":"(i, j)"},{"kind":"text","text":". Formally, a submatrix of matrix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" is a group of four integers "},{"kind":"math_inline","text":"d, u, l, r"},{"kind":"math_inline","text":"(1 ≤ d ≤ u ≤ n; 1 ≤ l ≤ r ≤ m)"},{"kind":"text","text":". We will assume that the submatrix contains cells "},{"kind":"math_inline","text":"(i, j)"},{"kind":"math_inline","text":"(d ≤ i ≤ u; l ≤ j ≤ r)"},{"kind":"text","text":". The area of the submatrix is the number of cells it contains."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 5000)"},{"kind":"text","text":". Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines contain "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" characters each — matrix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":". Matrix "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" only contains characters: \""},{"children":[{"kind":"text","text":"0"}],"kind":"container"},{"kind":"text","text":"\" and \""},{"children":[{"kind":"text","text":"1"}],"kind":"container"},{"kind":"text","text":"\". Note that the elements of the matrix follow without any spaces in the lines."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print a single integer — the area of the maximum obtained submatrix. If we cannot obtain a matrix of numbers one, print 0."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"1 1\n1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n10\n11\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 3\n100\n011\n000\n101\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"375B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/375/problem/B"}