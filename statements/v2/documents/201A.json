{"assets":["/statement-assets/80be08b90c6552be8cfd3317dbc22eaefc3f9e3fd51f073b75b285575e5908ef.png"],"contentKind":"statement","contestId":"201","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Clear Symmetry"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Consider some square matrix "},{"kind":"math_inline","text":"A"},{"kind":"text","text":" with side "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" consisting of zeros and ones. There are "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" rows numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from top to bottom and "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" columns numbered from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" from left to right in this matrix. We'll denote the element of the matrix which is located at the intersection of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-row and the "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column as "},{"kind":"math_inline","text":"Ai, j"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's call matrix "},{"kind":"math_inline","text":"A"},{"children":[{"kind":"text","text":"clear"}],"kind":"container"},{"kind":"text","text":" if no two cells containing ones have a comm