{"assets":[],"contentKind":"statement","contestId":"567","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"C. Geometric Progression"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"1 second"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Polycarp loves geometric progressions very much. Since he was only three years old, he loves only the progressions of length three. He also has a favorite integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" and a sequence "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"He wants to know how many subsequences of length three can be selected from "},{"kind":"math_inline","text":"a"},{"kind":"text","text":", so that they form a geometric progression with common ratio "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A subsequence of length three is a combination of three such indexes "},{"kind":"math_inline","text":"i1, i2, i3"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"1 ≤ i1 < i2 < i3 ≤ n"},{"kind":"text","text":". That is, a subsequence of length three are such groups of three elements that are not necessarily consecutive in the sequence, but their indexes are strictly increasing."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A geometric progression with common ratio "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" is a sequence of numbers of the form "},{"kind":"math_inline","text":"b·k0, b·k1, ..., b·kr - 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Polycarp is only three years old, so he can not calculate this number himself. Help him to do it."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of the input contains two integers, "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ n, k ≤ 2·105"},{"kind":"text","text":"), showing how many numbers Polycarp's sequence has and his favorite number."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"a1, a2, ..., an"},{"kind":"text","text":" ("},{"kind":"math_inline","text":" - 109 ≤ ai ≤ 109"},{"kind":"text","text":") — elements of the sequence."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Output a single number — the number of ways to choose a subsequence of length three, such that it forms a geometric progression with a common ratio "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 2\n1 1 2 2 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3 1\n1 1 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"10 3\n1 2 6 2 3 6 9 18 3 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"6"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test the answer is four, as any of the two 1s can be chosen as the first element, the second element can be any of the 2s, and the third element of the subsequence must be equal to 4."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"C","problemCode":"567C","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/567/problem/C"}