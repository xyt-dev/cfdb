{"assets":[],"contentKind":"statement","contestId":"916","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Jamie and To-do List"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"512 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"Why I have to finish so many assignments???"}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Jamie is getting very busy with his school life. He starts to forget the assignments that he has to do. He decided to write the things down on a to-do list. He assigns a value "},{"children":[{"kind":"text","text":"priority"}],"kind":"container"},{"kind":"text","text":" for each of his assignment "},{"children":[{"kind":"text","text":"(lower value means more important)"}],"kind":"container"},{"kind":"text","text":" so he can decide which he needs to spend more time on."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"After a few days, Jamie finds out the list is too large that he can't even manage the list by himself! As you are a good friend of Jamie, help him write a program to support the following operations on the to-do list:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"math_inline","text":"set ai xi"},{"kind":"text","text":" — Add assignment "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" to the to-do list if it is not present, and set its "},{"children":[{"kind":"text","text":"priority"}],"kind":"container"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". If assignment "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is already in the to-do list, its "},{"children":[{"kind":"text","text":"priority"}],"kind":"container"},{"children":[{"kind":"text","text":"is changed"}],"kind":"container"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"remove ai"},{"kind":"text","text":" — Remove assignment "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" from the to-do list if it is present in it. "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"query ai"},{"kind":"text","text":" — Output the number of assignments that are more important (have a "},{"children":[{"kind":"text","text":"smaller"}],"kind":"container"},{"children":[{"kind":"text","text":"priority"}],"kind":"container"},{"kind":"text","text":" value) than assignment "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":", so Jamie can decide a better schedule. Output "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":" if "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is not in the to-do list. "}],"kind":"list_item"},{"children":[{"kind":"math_inline","text":"undo di"},{"kind":"text","text":" — Undo all changes that have been made in the previous "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" days (not including the day of this operation) "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"At day "},{"kind":"math_inline","text":"0"},{"kind":"text","text":", the to-do list is empty. In each of the following "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" days, Jamie will do "},{"children":[{"kind":"text","text":"exactly one"}],"kind":"container"},{"kind":"text","text":" out of the four operations. If the operation is a "},{"kind":"math_inline","text":"query"},{"kind":"text","text":", you should "},{"children":[{"kind":"text","text":"output the result of the query before proceeding to the next day"}],"kind":"container"},{"kind":"text","text":", or poor Jamie cannot make appropriate decisions."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line consists of a single integer "},{"kind":"math_inline","text":"q"},{"kind":"math_inline","text":"(1 ≤ q ≤ 105)"},{"kind":"text","text":" — the number of operations."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The following "},{"kind":"math_inline","text":"q"},{"kind":"text","text":" lines consists of the description of the operations. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line consists of the operation that Jamie has done in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th day. The query has the following format:"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The first word in the line indicates the type of operation. It must be one of the following four: "},{"children":[{"kind":"text","text":"set"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"remove"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"query"}],"kind":"container"},{"kind":"text","text":", "},{"children":[{"kind":"text","text":"undo"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" If it is a "},{"children":[{"kind":"text","text":"set"}],"kind":"container"},{"kind":"text","text":" operation, a string "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" and an integer "},{"kind":"math_inline","text":"xi"},{"kind":"text","text":" follows "},{"kind":"math_inline","text":"(1 ≤ xi ≤ 109)"},{"kind":"text","text":". "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the assignment that need to be set to "},{"children":[{"kind":"text","text":"priority"}],"kind":"container"},{"kind":"math_inline","text":"xi"},{"kind":"text","text":". "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If it is a "},{"children":[{"kind":"text","text":"remove"}],"kind":"container"},{"kind":"text","text":" operation, a string "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" follows. "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the assignment that need to be removed. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If it is a "},{"children":[{"kind":"text","text":"query"}],"kind":"container"},{"kind":"text","text":" operation, a string "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" follows. "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" is the assignment that needs to be queried. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" If it is a "},{"children":[{"kind":"text","text":"undo"}],"kind":"container"},{"kind":"text","text":" operation, an integer "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" follows "},{"kind":"math_inline","text":"(0 ≤ di < i)"},{"kind":"text","text":". "},{"kind":"math_inline","text":"di"},{"kind":"text","text":" is the number of days that changes needed to be undone. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"All assignment names "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" only consists of lowercase English letters and have a length "},{"kind":"math_inline","text":"1 ≤ |ai| ≤ 15"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the last operation is a "},{"children":[{"kind":"text","text":"query"}],"kind":"container"},{"kind":"text","text":" operation."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":