{"assets":["/statement-assets/5708b9f2b89991900bc04fdebe86e64754e907545102418d4f8dfd716e10c617.png"],"contentKind":"statement","contestId":"744","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Hongcow's Game"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"children":[{"kind":"text","text":"This is an interactive problem. In the interaction section below you will see the information about flushing the output."}],"kind":"container"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In this problem, you will be playing a game with Hongcow. How lucky of you!"}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Hongcow has a hidden "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" by "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" matrix "},{"kind":"math_inline","text":"M"},{"kind":"text","text":". Let "},{"kind":"math_inline","text":"Mi, j"},{"kind":"text","text":" denote the entry "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row and "},{"kind":"math_inline","text":"j"},{"kind":"text","text":"-th column of the matrix. The rows and columns are labeled from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The matrix entries are between "},{"kind":"math_inline","text":"0"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"109"},{"kind":"text","text":". In addition, "},{"kind":"math_inline","text":"Mi, i = 0"},{"kind":"text","text":" for all valid "},{"kind":"math_inline","text":"i"},{"kind":"text","text":". Your task is to find the minimum value along each row, excluding diagonal elements. Formally, for each "},{"kind":"math_inline","text":"i"},{"kind":"text","text":", you must find "},{"attrs":{"alt":"","src":"/statement-assets/5708b9f2b89991900bc04fdebe86e64754e907545102418d4f8dfd716e10c617.png"},"kind":"image"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To do this, you can ask Hongcow some questions."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"A question consists of giving Hongcow a subset of distinct indices "},{"kind":"math_inline","text":"{w1, w2, ..., wk}"},{"kind":"text","text":", with "},{"kind":"math_inline","text":"1 ≤ k ≤ n"},{"kind":"text","text":". Hongcow will respond with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th integer will contain the minimum value of "},{"kind":"math_inline","text":"min1 ≤ j ≤ kMi, wj"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may only ask Hongcow at most "},{"kind":"math_inline","text":"20"},{"kind":"text","text":" questions — he thinks you only need that many questions answered."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"When you are ready to answer, print out a single integer "},{"kind":"math_inline","text":" - 1"},{"kind":"text","text":" on its own line, then "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers on the next line. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th integer should be the minimum value in the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row of the matrix, excluding the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th element. Do not forget to flush the final answer as well. Printing the answer does not count as asking a question."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You will get "},{"children":[{"kind":"text","text":"Wrong Answer"}],"kind":"container"},{"kind":"text","text":" verdict if "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Your question or answers are not in the format described in this statement. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" You ask strictly more than "},{"kind":"math_inline","text":"20"},{"kind":"text","text":" questions. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Your question contains duplicate indices. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" The value of "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" in your question does not lie in the range from "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":", inclusive. "}],"kind":"list_item"},{"children":[{"kind":"text","text":" Your final answer is not correct. "}],"kind":"list_item"}],"kind":"list"},{"kind":"text","text":" You will get "},{"children":[{"kind":"text","text":"Idleness Limit Exceeded"}],"kind":"container"},{"kind":"text","text":" if you don't print anything or if you forget to flush the output, including for the final answer (more info about flushing output below)."}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line of input will contain a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 1, 000"},{"kind":"text","text":")."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"To print the final answer, print out the string "},{"children":[{"kind":"text","text":"-1"}],"kind":"container"},{"kind":"text","text":" on its own line. Then, the next line should contain "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th integer should be the minimum value of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th row of the matrix, excluding elements on the diagonal. "},{"children":[{"kind":"text","text":"Do not forget to flush your answer!"}],"kind":"container"}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"custom","title":"Interaction"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Interaction"}],"kind":"heading"},{"children":[{"kind":"text","text":"To ask a question, print out a single integer "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" on its own line, denoting the size of your subset. Then, the next line should contain "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" integers "},{"kind":"math_inline","text":"w1, w2, ... wk"},{"kind":"text","text":". Note, you must flush your output to get a response."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Hongcow will respond by printing out a line with "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" integers. The "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th integer in this line represents the minimum value of "},{"kind":"math_inline","text":"Mi, wj"},{"kind":"text","text":" where "},{"kind":"math_inline","text":"j"},{"kind":"text","text":" is between "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"k"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You may only ask a question at most "},{"kind":"math_inline","text":"20"},{"kind":"text","text":" times, otherwise, you will get "},{"children":[{"kind":"text","text":"Wrong Answer"}],"kind":"container"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To flush you can use (just after printing an integer and end-of-line): "}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"children":[{"kind":"text","text":"fflush(stdout)"}],"kind":"container"},{"kind":"text","text":" in C++; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"System.out.flush()"}],"kind":"container"},{"kind":"text","text":" in Java; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"stdout.flush()"}],"kind":"container"},{"kind":"text","text":" in Python; "}],"kind":"list_item"},{"children":[{"children":[{"kind":"text","text":"flush(output)"}],"kind":"container"},{"kind":"text","text":" in Pascal; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" See the documentation for other languages. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"children":[{"kind":"text","text":"Hacking"}],"kind":"container"},{"kind":"text","text":" To hack someone, use the following format "}],"kind":"paragraph"},{"kind":"code_block","text":"\nn\nM_{1,1} M_{1,2} ... M_{1,n}\nM_{2,1} M_{2,2} ... M_{2,n}\n...\nM_{n,1} M_{n,2} ... M_{n,n}\n"},{"children":[{"kind":"text","text":"Of course, contestant programs will not be able to see this input."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n0 0 0\n2 7 0\n0 0 4\n3 0 8\n0 5 4"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 2 3\n1\n3\n2\n1 2\n1\n2\n1\n1\n-1\n2 5 4\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n0 0\n0 0"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"1\n2\n1\n1\n-1\n0 0"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, Hongcow has the hidden matrix "}],"kind":"paragraph"},{"kind":"code_block","text":"\n[\n [0, 3, 2],\n [5, 0, 7],\n [4, 8 ,0],\n]\n"},{"children":[{"kind":"text","text":"Here is a more readable version demonstrating the interaction. The column on the left represents Hongcow, while the column on the right represents the contestant. "}],"kind":"paragraph"},{"kind":"code_block","text":"\n3\n              3\n              1 2 3\n0 0 0\n              1\n              3\n2 7 0\n              2\n              1 2\n0 0 4\n              1\n              2\n3 0 8\n              1\n              1\n0 5 4\n              -1\n              2 5 4\n"},{"children":[{"kind":"text","text":"For the second sample, it is possible for off-diagonal elements of the matrix to be zero."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"744B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/744/problem/B"}