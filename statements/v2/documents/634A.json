{"assets":[],"contentKind":"statement","contestId":"634","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Island Puzzle"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"A remote island chain contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" islands, labeled "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" through "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Bidirectional bridges connect the islands to form a simple cycle — a bridge connects islands "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", islands "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", and so on, and additionally a bridge connects islands "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"1"},{"kind":"text","text":". The center of each island contains an identical pedestal, and all but one of the islands has a fragile, uniquely colored statue currently held on the pedestal. The remaining island holds only an empty pedestal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The islanders want to rearrange the statues in a new order. To do this, they repeat the following process: First, they choose an island directly adjacent to the island containing an empty pedestal. Then, they painstakingly carry the statue on this island across the adjoining bridge and place it on the empty pedestal."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Determine if it is possible for the islanders to arrange the statues in the desired order."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains a single integer "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 200 000"},{"kind":"text","text":") — the total number of islands."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The second line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ ai ≤ n - 1"},{"kind":"text","text":") — the statue currently placed on the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th island. If "},{"kind":"math_inline","text":"ai = 0"},{"kind":"text","text":", then the island has no statue. It is guaranteed that the "},{"kind":"math_inline","text":"ai"},{"kind":"text","text":" are distinct."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The third line contains "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" space-separated integers "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"0 ≤ bi ≤ n - 1"},{"kind":"text","text":") — the desired statues of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"th island. Once again, "},{"kind":"math_inline","text":"bi = 0"},{"kind":"text","text":" indicates the island desires no statue. It is guaranteed that the "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":" are distinct."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print \""},{"children":[{"kind":"text","text":"YES"}],"kind":"container"},{"kind":"text","text":"\" (without quotes) if the rearrangement can be done in the existing network, and \""},{"children":[{"kind":"text","text":"NO"}],"kind":"container"},{"kind":"text","text":"\" otherwise."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"3\n1 0 2\n2 0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2\n1 0\n0 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"YES\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4\n1 2 3 0\n0 3 2 1\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"NO\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, the islanders can first move statue "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" from island "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to island "},{"kind":"math_inline","text":"2"},{"kind":"text","text":", then move statue "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" from island "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" to island "},{"kind":"math_inline","text":"1"},{"kind":"text","text":", and finally move statue "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" from island "},{"kind":"math_inline","text":"2"},{"kind":"text","text":" to island "},{"kind":"math_inline","text":"3"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, the islanders can simply move statue "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" from island "},{"kind":"math_inline","text":"1"},{"kind":"text","text":" to island "},{"kind":"math_inline","text":"2"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the third sample, no sequence of movements results in the desired position."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"A","problemCode":"634A","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/634/problem/A"}