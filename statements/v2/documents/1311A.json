{"assets":[],"contentKind":"statement","contestId":"1311","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"A. Add Odd or Subtract Even"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You are given two positive integers $$$a$$$ and $$$b$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In one move, you can "},{"children":[{"kind":"text","text":"change"}],"kind":"container"},{"kind":"text","text":" $$$a$$$ in the following way:"}],"kind":"paragraph"},{"attrs":{"ordered":false},"children":[{"children":[{"kind":"text","text":" Choose any positive "},{"children":[{"kind":"text","text":"odd"}],"kind":"container"},{"kind":"text","text":" integer $$$x$$$ ($$$x \\gt 0$$$) and replace $$$a$$$ with $$$a+x$$$; "}],"kind":"list_item"},{"children":[{"kind":"text","text":" choose any positive "},{"children":[{"kind":"text","text":"even"}],"kind":"container"},{"kind":"text","text":" integer $$$y$$$ ($$$y \\gt 0$$$) and replace $$$a$$$ with $$$a-y$$$. "}],"kind":"list_item"}],"kind":"list"},{"children":[{"kind":"text","text":"You can perform as many such operations as you want. You can choose the same numbers $$$x$$$ and $$$y$$$ in different moves."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find the minimum number of moves required to obtain $$$b$$$ from $$$a$$$. It is guaranteed that you can always obtain $$$b$$$ from $$$a$$$."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"You have to answer $$$t$$$ independent test cases."}],"kind":"paragraph"}],"kind":"section