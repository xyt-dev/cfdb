tya\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Petya\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample Vasya will choose 1 and win immediately."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample no matter which number Vasya chooses during his first turn, Petya can choose the remaining number and win."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"317D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/317/problem/D"}