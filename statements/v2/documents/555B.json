{"assets":[],"contentKind":"statement","contestId":"555","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"B. Case of Fugitive"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"3 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"Andrewid the Android is a galaxy-famous detective. He is now chasing a criminal hiding on the planet Oxa-5, the planet almost fully covered with water."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The only dry land there is an archipelago of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" narrow islands located in a row. For more comfort let's represent them as non-intersecting segments on a straight line: island "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" has coordinates "},{"kind":"math_inline","text":"[li, ri]"},{"kind":"text","text":", besides, "},{"kind":"math_inline","text":"ri < li + 1"},{"kind":"text","text":" for "},{"kind":"math_inline","text":"1 ≤ i ≤ n - 1"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"To reach the goal, Andrewid needs to place a bridge between each pair of "},{"children":[{"kind":"text","text":"adjacent"}],"kind":"container"},{"kind":"text","text":" islands. A bridge of length "},{"kind":"math_inline","text":"a"},{"kind":"text","text":" can be placed between the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th and the "},{"kind":"math_inline","text":"(i + 1)"},{"kind":"text","text":"-th islads, if there are such coordinates of "},{"kind":"math_inline","text":"x"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y"},{"kind":"text","text":", that "},{"kind":"math_inline","text":"li ≤ x ≤ ri"},{"kind":"text","text":", "},{"kind":"math_inline","text":"li + 1 ≤ y ≤ ri + 1"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"y - x = a"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The detective was supplied with "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" bridges, each bridge can be used at most once. Help him determine whether the bridges he got are enough to connect each pair of adjacent islands."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains integers "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"2 ≤ n ≤ 2·105"},{"kind":"text","text":") and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ m ≤ 2·105"},{"kind":"text","text":") — the number of islands and bridges."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" lines each contain two integers "},{"kind":"math_inline","text":"li"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"ri"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ li ≤ ri ≤ 1018"},{"kind":"text","text":") — the coordinates of the island endpoints."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"The last line contains "},{"kind":"math_inline","text":"m"},{"children":[{"kind":"text","text":"integer"}],"kind":"container"},{"kind":"text","text":" numbers "},{"kind":"math_inline","text":"a1, a2, ..., am"},{"kind":"text","text":" ("},{"kind":"math_inline","text":"1 ≤ ai ≤ 1018"},{"kind":"text","text":") — the lengths of the bridges that Andrewid got."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"If it is impossible to place a bridge between each pair of adjacent islands in the required manner, print on a single line "},{"children":[{"kind":"text","text":"\"No\""}],"kind":"container"},{"kind":"text","text":" (without the quotes), otherwise print in the first line "},{"children":[{"kind":"text","text":"\"Yes\""}],"kind":"container"},{"kind":"text","text":" (without the quotes), and in the second line print "},{"kind":"math_inline","text":"n - 1"},{"kind":"text","text":" numbers "},{"kind":"math_inline","text":"b1, b2, ..., bn - 1"},{"kind":"text","text":", which mean that between islands "},{"kind":"math_inline","text":"i"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"i + 1"},{"kind":"text","text":" there must be used a bridge number "},{"kind":"math_inline","text":"bi"},{"kind":"text","text":". "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"If there are multiple correct answers, print any of them. Note that in this problem it is necessary to print "},{"children":[{"kind":"text","text":"\"Yes\""}],"kind":"container"},{"kind":"text","text":" and "},{"children":[{"kind":"text","text":"\"No\""}],"kind":"container"},{"kind":"text","text":" in correct case."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"4 4\n1 4\n7 8\n9 10\n12 14\n4 5 3 8\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n2 3 1 \n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 2\n11 14\n17 18\n2 9\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"No\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"2 1\n1 1\n1000000000000000000 1000000000000000000\n999999999999999999\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"Yes\n1 \n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample test you can, for example, place the second bridge between points 3 and 8, place the third bridge between points 7 and 10 and place the first bridge between points 10 and 14."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample test the first bridge is too short and the second bridge is too long, so the solution doesn't exist."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"555B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/555/problem/B"}