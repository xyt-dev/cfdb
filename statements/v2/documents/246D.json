{"assets":[],"contentKind":"statement","contestId":"246","diagnostics":[],"document":{"children":[{"attrs":{"level":1,"role":"title"},"children":[{"kind":"text","text":"D. Colorful Graph"}],"kind":"heading"},{"attrs":{"role":"time_limit"},"children":[{"children":[{"kind":"text","text":"time limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"2 seconds"}],"kind":"container"},{"attrs":{"role":"memory_limit"},"children":[{"children":[{"kind":"text","text":"memory limit per test"},{"kind":"text","text":":"}],"kind":"container"},{"kind":"text","text":"256 megabytes"}],"kind":"container"},{"attrs":{"role":"body"},"children":[{"children":[{"kind":"text","text":"You've got an undirected graph, consisting of "},{"kind":"math_inline","text":"n"},{"kind":"text","text":" vertices and "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" edges. We will consider the graph's vertices numbered with integers from 1 to "},{"kind":"math_inline","text":"n"},{"kind":"text","text":". Each vertex of the graph has a color. The color of the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th vertex is an integer "},{"kind":"math_inline","text":"ci"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Let's consider all vertices of the graph, that are painted some color "},{"kind":"math_inline","text":"k"},{"kind":"text","text":". Let's denote a set of such as "},{"kind":"math_inline","text":"V(k)"},{"kind":"text","text":". Let's denote the value of the "},{"children":[{"kind":"text","text":"neighbouring color diversity"}],"kind":"container"},{"kind":"text","text":" for color "},{"kind":"math_inline","text":"k"},{"kind":"text","text":" as the cardinality of the set "},{"kind":"math_inline","text":"Q(k) = {cu :  cu ≠ k"},{"kind":"text","text":" and there is vertex "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" belonging to set "},{"kind":"math_inline","text":"V(k)"},{"kind":"text","text":" such that nodes "},{"kind":"math_inline","text":"v"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"u"},{"kind":"text","text":" are connected by an edge of the graph"},{"kind":"math_inline","text":"}"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Your task is to find such color "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", which makes the cardinality of set "},{"kind":"math_inline","text":"Q(k)"},{"kind":"text","text":" maximum. In other words, you want to find the color that has the most diverse neighbours. Please note, that you want to find such color "},{"kind":"math_inline","text":"k"},{"kind":"text","text":", that the graph has at least one vertex with such color."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"input_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"children":[{"kind":"text","text":"The first line contains two space-separated integers "},{"kind":"math_inline","text":"n, m"},{"kind":"math_inline","text":"(1 ≤ n, m ≤ 105)"},{"kind":"text","text":" — the number of vertices end edges of the graph, correspondingly. The second line contains a sequence of integers "},{"kind":"math_inline","text":"c1, c2, ..., cn"},{"kind":"math_inline","text":"(1 ≤ ci ≤ 105)"},{"kind":"text","text":" — the colors of the graph vertices. The numbers on the line are separated by spaces."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"Next "},{"kind":"math_inline","text":"m"},{"kind":"text","text":" lines contain the description of the edges: the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th line contains two space-separated integers "},{"kind":"math_inline","text":"ai, bi"},{"kind":"math_inline","text":"(1 ≤ ai, bi ≤ n; ai ≠ bi)"},{"kind":"text","text":" — the numbers of the vertices, connected by the "},{"kind":"math_inline","text":"i"},{"kind":"text","text":"-th edge. "}],"kind":"paragraph"},{"children":[{"kind":"text","text":"It is guaranteed that the given graph has no self-loops or multiple edges."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"output_specification"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"children":[{"kind":"text","text":"Print the number of the color which has the set of neighbours with the maximum cardinality. It there are multiple optimal colors, print the color with the minimum number. Please note, that you want to find such color, that the graph has at least one vertex with such color."}],"kind":"paragraph"}],"kind":"section"},{"attrs":{"role":"samples"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Examples"}],"kind":"heading"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6 6\n1 1 2 3 5 8\n1 2\n3 2\n1 4\n4 3\n4 5\n4 6\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"3\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"5 6\n4 2 5 2 4\n1 2\n2 3\n3 1\n5 3\n5 4\n3 4\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"}],"kind":"document"},"index":"D","problemCode":"246D","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/246/problem/D"}