xt","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"2\n"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"sample"},"children":[{"attrs":{"role":"sample_input"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Input"}],"kind":"heading"},{"kind":"code_block","text":"6\nM 128 130\nF 128 131\nF 131 140\nF 131 141\nM 131 200\nM 140 200\n"}],"kind":"section"},{"attrs":{"role":"sample_output"},"children":[{"attrs":{"level":3},"children":[{"kind":"text","text":"Output"}],"kind":"heading"},{"kind":"code_block","text":"4\n"}],"kind":"section"}],"kind":"section"}],"kind":"section"},{"attrs":{"role":"note"},"children":[{"attrs":{"level":2},"children":[{"kind":"text","text":"Note"}],"kind":"heading"},{"children":[{"kind":"text","text":"In the first sample, friends "},{"kind":"math_inline","text":"3"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"4"},{"kind":"text","text":" can come on any day in range "},{"kind":"math_inline","text":"[117, 128]"},{"kind":"text","text":"."}],"kind":"paragraph"},{"children":[{"kind":"text","text":"In the second sample, friends with indices "},{"kind":"math_inline","text":"3"},{"kind":"text","text":", "},{"kind":"math_inline","text":"4"},{"kind":"text","text":", "},{"kind":"math_inline","text":"5"},{"kind":"text","text":" and "},{"kind":"math_inline","text":"6"},{"kind":"text","text":" can come on day "},{"kind":"math_inline","text":"140"},{"kind":"text","text":"."}],"kind":"paragraph"}],"kind":"section"}],"kind":"document"},"index":"B","problemCode":"629B","schema":2,"sourceKind":"html","sourceUrl":"https://codeforces.com/contest/629/problem/B"}